import "staged_parser.ab"
import "package.ab"
import "abla/sys/linux/fs"
import "abla/sys/linux/process"

// Module identity is lexical and deterministic: it does not consult the host
// filesystem or resolve symlinks. This keeps absent generated inputs, caches,
// and watched builds reproducible while collapsing path aliases.
fun bootstrapNormalizeModulePath(value: string): string {
    val absolute = value.size > 0 && value[0] == 47
    var output = if (absolute) "/" else ""
    var index = 0
    while (index < value.size) {
        while (index < value.size && value[index] == 47) index = index + 1
        val begin = index
        while (index < value.size && value[index] != 47) index = index + 1
        if (begin < index) {
            val segment = value.slice(begin, index)
            if (segment == "..") {
                var lastBegin = output.size
                while (lastBegin > 0 && output[lastBegin - 1] != 47) {
                    lastBegin = lastBegin - 1
                }
                val last = output.slice(lastBegin, output.size)
                if (last != "" && last != "..") {
                    var end = lastBegin
                    if (end > 1 && output[end - 1] == 47) end = end - 1
                    if (absolute && end == 0) end = 1
                    output = output.slice(0, end)
                } else if (!absolute) {
                    if (output != "") output = "$output/"
                    output = "${output}.."
                }
            } else if (segment != ".") {
                if (output != "" && output != "/") output = "$output/"
                output = "$output$segment"
            }
        }
    }
    if (output == "") output = "."
    output
}

fun bootstrapResolveImport(importer: string, requested: string): string {
    var result = Path(importer).parent().child(requested).text
    if (requested.size > 0 && requested[0] == 47) result = requested
    if (requested.size >= 5 && requested.slice(0, 5) == "abla/") {
        result = Path(bootstrapStandardLibraryRoot()).child(requested).child(
            "entry.ab"
        ).text
    }
    val package = bootstrapResolvePackageImport(importer, requested)
    if (package != "") result = package
    bootstrapNormalizeModulePath(result)
}

class BootstrapImportEdge(
    val source: string,
    val provider: bool,
    val alias: string,
    val contractOnly: bool,
    val begin: int,
    val end: int
)

class BootstrapImportScan(
    val edges: array<BootstrapImportEdge>,
    val errors: int,
    val diagnostics: string
)

fun bootstrapImportWordAt(source: string, offset: int, word: string): bool {
    var equal = offset + word.size <= source.size &&
        bootstrapRegionEquals(source, offset, offset + word.size, word)
    if (equal && offset > 0 && bootstrapIsAlphaNumeric(source[offset - 1])) {
        equal = false
    }
    if (equal && offset + word.size < source.size &&
        bootstrapIsAlphaNumeric(source[offset + word.size])) equal = false
    equal
}

fun bootstrapImportAliasValid(alias: string): bool {
    var valid = alias.size > 0 && bootstrapIsAlpha(alias[0])
    var index = 1
    while (valid && index < alias.size) {
        valid = bootstrapIsAlphaNumeric(alias[index])
        index = index + 1
    }
    if (valid && bootstrapKeyword(alias, 0, alias.size) != "identifier") {
        valid = false
    }
    if (alias == "as" || alias == "contract" || alias == "import") {
        valid = false
    }
    valid
}

fun bootstrapScanImports(source: string): BootstrapImportScan {
    val edges: array<BootstrapImportEdge> = []
    var errors = 0
    var diagnostics = ""
    var offset = 0
    var sourceQuoted = false
    var lineComment = false
    var blockComment = 0
    var braces = 0
    while (offset < source.size) {
        if (source[offset] == 10 || source[offset] == 13) lineComment = false
        if (!sourceQuoted && !lineComment && blockComment == 0 &&
            source[offset] == 47 &&
            offset + 1 < source.size && source[offset + 1] == 42) {
            blockComment = blockComment + 1
            offset = offset + 2
            continue
        }
        if (blockComment > 0) {
            if (offset + 1 < source.size && source[offset] == 42 &&
                source[offset + 1] == 47) {
                blockComment = blockComment - 1
                offset = offset + 2
            } else offset = offset + 1
            continue
        }
        if (!sourceQuoted && !lineComment && source[offset] == 47 &&
            offset + 1 < source.size && source[offset + 1] == 47) {
            lineComment = true
        }
        if (blockComment == 0 && !lineComment && source[offset] == 34 &&
            (offset == 0 || source[offset - 1] != 92)) {
            sourceQuoted = !sourceQuoted
        }
        if (!sourceQuoted && !lineComment && blockComment == 0) {
            if (source[offset] == 123) braces = braces + 1
            if (source[offset] == 125 && braces > 0) braces = braces - 1
        }
        if (!sourceQuoted && !lineComment && blockComment == 0 &&
            braces == 0 && bootstrapImportWordAt(source, offset, "import")) {
            val importBegin = offset
            var cursor = offset + 6
            while (cursor < source.size &&
                (source[cursor] == 32 || source[cursor] == 9)) {
                cursor = cursor + 1
            }
            var contractOnly = false
            if (bootstrapImportWordAt(source, cursor, "contract")) {
                contractOnly = true
                cursor = cursor + 8
                while (cursor < source.size &&
                    (source[cursor] == 32 || source[cursor] == 9)) {
                    cursor = cursor + 1
                }
            }
            val sourceBegin = cursor
            var sourceEnd = cursor
            var end = cursor
            var provider = true
            var alias = ""
            if (cursor < source.size && source[cursor] == 34) {
                provider = false
                cursor = cursor + 1
                val valueBegin = cursor
                while (cursor < source.size &&
                    (source[cursor] != 34 || source[cursor - 1] == 92)) {
                    cursor = cursor + 1
                }
                sourceEnd = cursor
                if (cursor < source.size) cursor = cursor + 1
                end = cursor
                val requested = source.slice(valueBegin, sourceEnd)
                while (cursor < source.size &&
                    (source[cursor] == 32 || source[cursor] == 9)) {
                    cursor = cursor + 1
                }
                if (bootstrapImportWordAt(source, cursor, "as")) {
                    cursor = cursor + 2
                    while (cursor < source.size &&
                        (source[cursor] == 32 || source[cursor] == 9)) {
                        cursor = cursor + 1
                    }
                    val aliasBegin = cursor
                    while (cursor < source.size &&
                        bootstrapIsAlphaNumeric(source[cursor])) {
                        cursor = cursor + 1
                    }
                    alias = source.slice(aliasBegin, cursor)
                    end = cursor
                }
                if (requested == "" ||
                    (alias != "" && !bootstrapImportAliasValid(alias))) {
                    errors = errors + 1
                    diagnostics =
                        "${diagnostics}error[E_IMPORT_ALIAS_INVALID]: import source and alias must be non-empty valid identifiers\nsource[import]:$importBegin:$end\n"
                } else edges.append(BootstrapImportEdge(
                    requested, provider, alias, contractOnly, importBegin, end
                ))
            } else {
                var depth = 0
                var quoted = false
                var aliasAt = -1
                while (cursor < source.size &&
                    !(!quoted && depth == 0 &&
                      (source[cursor] == 10 || source[cursor] == 13 ||
                       source[cursor] == 59))) {
                    if (source[cursor] == 34 &&
                        (cursor == sourceBegin || source[cursor - 1] != 92)) {
                        quoted = !quoted
                    }
                    if (!quoted && (source[cursor] == 40 ||
                        source[cursor] == 91)) depth = depth + 1
                    if (!quoted && (source[cursor] == 41 ||
                        source[cursor] == 93)) depth = depth - 1
                    if (!quoted && depth == 0 &&
                        bootstrapImportWordAt(source, cursor, "as")) {
                        aliasAt = cursor
                        sourceEnd = cursor
                    }
                    cursor = cursor + 1
                }
                end = cursor
                if (aliasAt >= 0) {
                    val rawAlias = bootstrapPackageTrim(source.slice(
                        aliasAt + 2, end
                    ))
                    alias = rawAlias
                } else sourceEnd = end
                val requested = bootstrapPackageTrim(source.slice(
                    sourceBegin, sourceEnd
                ))
                if (requested == "" ||
                    (alias != "" && !bootstrapImportAliasValid(alias))) {
                    errors = errors + 1
                    diagnostics =
                        "${diagnostics}error[E_IMPORT_ALIAS_INVALID]: import source and alias must be non-empty valid identifiers\nsource[import]:$importBegin:$end\n"
                } else edges.append(BootstrapImportEdge(
                    requested, provider, alias, contractOnly, importBegin, end
                ))
            }
            offset = end
        }
        offset = offset + 1
    }
    BootstrapImportScan(edges, errors, diagnostics)
}

fun bootstrapModuleFingerprint(
    source: string,
    seed: int,
    factor: int,
    modulus: int
): int {
    var hash = seed
    var index = 0
    while (index < source.size) {
        hash = hash * factor + source[index] + 1
        hash = hash - (hash / modulus) * modulus
        index = index + 1
    }
    hash
}

fun bootstrapModuleExpressionIdentity(
    expression: BootstrapExpression
): string {
    var identity = "${expression.kind}:${expression.text}("
    var child = 0
    while (child < expression.children.size) {
        identity = "$identity${bootstrapModuleExpressionIdentity(
            expression.children[child]
        )},"
        child = child + 1
    }
    "$identity)"
}

fun bootstrapModuleInterfaceIdentity(
    parsed: BootstrapParseResult,
    implementationFirst: int,
    implementationSecond: int
): string {
    var identity = ""
    var implementationSensitive = false
    var declaration = 0
    while (declaration < parsed.declarations.size) {
        val found = parsed.declarations[declaration]
        var interfaceKind = found.kind
        if (interfaceKind == "extern" && found.externalLibrary.size >= 9 &&
            found.externalLibrary.slice(0, 9) == "contract:") {
            interfaceKind = "fun"
        }
        identity = "$identity$interfaceKind:${found.name}:${found.extensionOwner}:${found.resultType}:${found.isResource}:${found.isTrusted}:${found.isNoEscape}|"
        var annotation = 0
        while (annotation < found.annotations.size) {
            identity = "$identity@${found.annotations[annotation]},"
            annotation = annotation + 1
        }
        var parameter = 0
        while (parameter < found.parameters.size) {
            var type = "unknown"
            var kind = "parameter"
            if (parameter < found.parameterTypes.size) {
                type = found.parameterTypes[parameter]
            }
            if (parameter < found.parameterKinds.size) {
                kind = found.parameterKinds[parameter]
            }
            identity = "$identity${found.parameters[parameter]}:$kind:$type,"
            if (parameter < found.parameterDefaults.size &&
                found.parameterDefaults[parameter].kind != "missing") {
                identity = "$identity=${bootstrapModuleExpressionIdentity(
                    found.parameterDefaults[parameter]
                )}"
            }
            parameter = parameter + 1
        }
        var method = 0
        while (method < found.methods.size) {
            val member = found.methods[method]
            identity = "$identity method:${member.name}:${member.resultType}("
            annotation = 0
            while (annotation < member.annotations.size) {
                identity = "$identity@${member.annotations[annotation]},"
                annotation = annotation + 1
            }
            parameter = 0
            while (parameter < member.parameters.size) {
                var type = "unknown"
                var kind = "parameter"
                if (parameter < member.parameterTypes.size) {
                    type = member.parameterTypes[parameter]
                }
                if (parameter < member.parameterKinds.size) {
                    kind = member.parameterKinds[parameter]
                }
                identity = "$identity$kind:$type,"
                if (parameter < member.parameterDefaults.size &&
                    member.parameterDefaults[parameter].kind != "missing") {
                    identity =
                        "$identity=${bootstrapModuleExpressionIdentity(
                            member.parameterDefaults[parameter]
                        )}"
                }
                parameter = parameter + 1
            }
            identity = "$identity)"
            method = method + 1
        }
        if (found.kind == "compile.fun" || found.kind == "compile.val" ||
            found.kind == "compile.var") implementationSensitive = true
        declaration = declaration + 1
    }
    var action = 0
    while (action < parsed.actions.size) {
        var expression = parsed.actions[action]
        if (expression.kind == "compile" && expression.children.size == 1) {
            expression = expression.children[0]
        }
        val grant = expression.kind == "call" &&
            expression.text == "compilerGrant"
        val authorization = expression.kind ==
            "compile.capability.authorization"
        if (!grant && !authorization) implementationSensitive = true
        action = action + 1
    }
    if (implementationSensitive) {
        identity = "$identity implementation:$implementationFirst:$implementationSecond"
    }
    identity
}

// A snapshot is the reusable, module-local part of graph loading. Keeping the
// source and import scan together is important: publishing a new source with
// stale dependency edges would make incremental invalidation unsound.
class BootstrapModuleSnapshot(
    val path: string,
    val source: string,
    val importEdges: array<BootstrapImportEdge>,
    val importErrors: int,
    val exists: bool,
    val size: int,
    val revision: int,
    val firstFingerprint: int,
    val secondFingerprint: int,
    val discovery: BootstrapParseResult
)

class BootstrapModuleFrontendSnapshot(
    val path: string,
    val firstFingerprint: int,
    val secondFingerprint: int,
    val dependencyFingerprint: int,
    val parsed: BootstrapParseResult
)

// Compile inputs use provider-qualified identities. Filesystem paths retain
// their lexical spelling; deterministic ambient providers use a reserved
// identity that can be re-observed without persisting the input's value.
fun bootstrapCompileInputContents(identity: string): string {
    val environmentPrefix = "abla-input:environment:"
    var contents = ""
    if (identity.size >= environmentPrefix.size &&
        identity.slice(0, environmentPrefix.size) == environmentPrefix) {
        val observed = linuxEnvironment(identity.slice(
            environmentPrefix.size,
            identity.size
        ))
        if (observed.found) contents = observed.value
    } else contents = Path(identity).readText()
    contents
}

fun bootstrapCompileInputsCurrent(parsed: BootstrapParseResult): bool {
    var current = parsed.compileInputPaths.size ==
        parsed.compileInputContents.size
    var input = 0
    while (current && input < parsed.compileInputPaths.size) {
        current = bootstrapCompileInputContents(
            parsed.compileInputPaths[input]
        ) == parsed.compileInputContents[input]
        input = input + 1
    }
    current
}

fun bootstrapParseRequestsCompileCapability(
    parsed: BootstrapParseResult,
    capability: string
): bool {
    var requested = false
    var action = 0
    while (action < parsed.actions.size) {
        var expression = parsed.actions[action]
        if (expression.kind == "compile" && expression.children.size == 1) {
            expression = expression.children[0]
        }
        if (expression.kind == "call" &&
            expression.text == "compilerGrant" &&
            expression.children.size == 1 &&
            expression.children[0].kind == "string" &&
            expression.children[0].text == capability) requested = true
        action = action + 1
    }
    requested
}

// Long-lived commands retain one state object across compilations. A normal
// one-shot build creates a fresh state, while `serve` reuses it and therefore
// rereads and rescans only files whose stat identity changed.
class BootstrapModuleState(
    val snapshots: array<BootstrapModuleSnapshot>,
    val frontends: array<BootstrapModuleFrontendSnapshot>,
    var reused: int,
    var refreshed: int,
    var reusedParsed: int,
    var refreshedParsed: int
) {
    fun beginBuild(): void {
        this.reused = 0
        this.refreshed = 0
        this.reusedParsed = 0
        this.refreshedParsed = 0
        bootstrapSemanticUnit()
    }

    fun indexOf(modulePath: string): int {
        var result = -1
        var index = 0
        while (index < this.snapshots.size && result < 0) {
            if (this.snapshots[index].path == modulePath) result = index
            index = index + 1
        }
        result
    }

    fun acquire(modulePath: string): BootstrapModuleSnapshot {
        val info = Path(modulePath).info()
        val existing = this.indexOf(modulePath)
        var reusable = false
        if (existing >= 0) {
            val snapshot = this.snapshots[existing]
            reusable = snapshot.exists == info.exists() &&
                snapshot.size == info.size &&
                snapshot.revision == info.revision
        }
        var result = BootstrapModuleSnapshot(
            modulePath,
            "",
            [],
            0,
            false,
            -1,
            0,
            0,
            0,
            BootstrapParseResult([], [], 0, 0, [], [], "")
        )
        if (reusable) {
            result = this.snapshots[existing]
            this.reused = this.reused + 1
        } else {
            val source = Path(modulePath).readText()
            val scan = bootstrapScanImports(source)
            result = BootstrapModuleSnapshot(
                modulePath,
                source,
                scan.edges,
                scan.errors,
                info.exists(),
                info.size,
                info.revision,
                bootstrapModuleFingerprint(
                    source, 17, 257, 1000000007
                ),
                bootstrapModuleFingerprint(
                    source, 97, 263, 1000000009
                ),
                bootstrapParseWithIdentity(source, modulePath)
            )
            if (existing >= 0) {
                this.snapshots[existing] = result
                0
            } else {
                this.snapshots.append(result)
                0
            }
            this.refreshed = this.refreshed + 1
        }
        result
    }

    fun frontendIndex(
        snapshot: BootstrapModuleSnapshot,
        dependencyFingerprint: int
    ): int {
        var result = -1
        var index = 0
        while (index < this.frontends.size && result < 0) {
            val frontend = this.frontends[index]
            if (frontend.path == snapshot.path &&
                frontend.firstFingerprint == snapshot.firstFingerprint &&
                frontend.secondFingerprint == snapshot.secondFingerprint &&
                frontend.dependencyFingerprint == dependencyFingerprint) {
                result = index
            }
            index = index + 1
        }
        result
    }

    fun frontendPathIndex(modulePath: string): int {
        var result = -1
        var index = 0
        while (index < this.frontends.size && result < 0) {
            if (this.frontends[index].path == modulePath) result = index
            index = index + 1
        }
        result
    }

    fun acquireParsed(
        snapshot: BootstrapModuleSnapshot,
        dependencyFingerprint: int,
        declarations: array<BootstrapDeclaration>,
        currentDeclarationBegin: int,
        registry: BootstrapSubparserRegistry,
        allowedCompileEffects: int
    ): BootstrapParseResult {
        var existing = this.frontendIndex(
            snapshot,
            dependencyFingerprint
        )
        if (existing >= 0 && !bootstrapCompileInputsCurrent(
            this.frontends[existing].parsed
        )) existing = -1
        var result = BootstrapParseResult([], [], 0, 0, [], [], "")
        if (existing >= 0) {
            result = this.frontends[existing].parsed
            this.reusedParsed = this.reusedParsed + 1
        } else {
            result = bootstrapParseStagedRegistered(
                snapshot.source,
                snapshot.path,
                declarations,
                currentDeclarationBegin,
                registry,
                allowedCompileEffects
            )
            val replacement = BootstrapModuleFrontendSnapshot(
                snapshot.path,
                snapshot.firstFingerprint,
                snapshot.secondFingerprint,
                dependencyFingerprint,
                result
            )
            val samePath = this.frontendPathIndex(snapshot.path)
            if (samePath >= 0) {
                this.frontends[samePath] = replacement
                0
            } else {
                this.frontends.append(replacement)
                0
            }
            this.refreshedParsed = this.refreshedParsed + 1
        }
        result
    }
}

class BootstrapImportProviderDiscovery(
    val state: BootstrapModuleState,
    val ordered: array<BootstrapModuleSnapshot>,
    val paths: array<string>,
    var errors: int,
    var diagnostics: string
) {
    fun contains(path: string): bool {
        var found = false
        var index = 0
        while (index < this.paths.size) {
            if (this.paths[index] == path) found = true
            index = index + 1
        }
        found
    }

    fun collect(modulePath: string): void {
        val identity = bootstrapNormalizeModulePath(modulePath)
        if (!this.contains(identity)) {
            this.paths.append(identity)
            val snapshot = this.state.acquire(identity)
            this.errors = this.errors + snapshot.importErrors
            this.diagnostics =
                "${this.diagnostics}${bootstrapScanImports(snapshot.source).diagnostics}"
            var index = 0
            while (index < snapshot.importEdges.size) {
                val edge = snapshot.importEdges[index]
                if (!edge.provider) this.collect(bootstrapResolveImport(
                    identity, edge.source
                ))
                index = index + 1
            }
            this.ordered.append(snapshot)
        }
    }
}

fun bootstrapEvaluateImportProvider(
    expression: string,
    ordered: array<BootstrapModuleSnapshot>,
    current: BootstrapParseResult,
    resolve: bool = false,
    resolveEffects: int = 0
): BootstrapImportProviderResult {
    val declarations: array<BootstrapDeclaration> = []
    var moduleIndex = 0
    while (moduleIndex < ordered.size) {
        var declaration = 0
        while (declaration < ordered[moduleIndex].discovery.declarations.size) {
            declarations.append(
                ordered[moduleIndex].discovery.declarations[declaration]
            )
            declaration = declaration + 1
        }
        moduleIndex = moduleIndex + 1
    }
    var declaration = 0
    while (declaration < current.declarations.size) {
        declarations.append(current.declarations[declaration])
        declaration = declaration + 1
    }
    var requestedExpression = expression
    if (resolve) requestedExpression =
        "__ablaResolveImportSource($expression)"
    val parsed = bootstrapParse("#$requestedExpression")
    var errors = parsed.errors
    var diagnostic = ""
    var dependency = BootstrapPackageDependency(
        "", "", "", "", "", "", "", "", []
    )
    if (errors == 0 && parsed.actions.size == 1) {
        // Bit 1024 is private authority to invoke a deferred ImportSource
        // resolver; ordinary compile-time evaluation never receives it.
        val allowedEffects = if (resolve) resolveEffects + 1024 else 0
        val evaluated = bootstrapEvaluateWithEffects(
            parsed.actions[0], declarations, allowedEffects
        )
        errors = errors + evaluated.errors
        diagnostic = evaluated.diagnostics
        if (resolve && evaluated.errors > 0) {
            diagnostic = "${diagnostic}error[E_IMPORT_PROVIDER_EFFECT_DENIED]: deferred resolver failed; authorize any required effects in the root manifest compileCapabilities\n"
        }
        if (evaluated.value.kind == "object" &&
            evaluated.value.owner == "ImportSource") {
            val decoded = bootstrapPackageDependencyFromValue(
                evaluated.value, resolve
            )
            dependency = decoded.dependency
            errors = errors + decoded.errors
            diagnostic = "$diagnostic${decoded.diagnostic}"
        } else {
            errors = errors + 1
            diagnostic = "${diagnostic}error[E_IMPORT_PROVIDER_RESULT]: import provider '$expression' must return ImportSource\n"
        }
    } else {
        errors = errors + 1
        diagnostic = "error[E_IMPORT_PROVIDER_PARSE]: invalid import provider expression '$expression'\n"
    }
    BootstrapImportProviderResult(dependency, errors, diagnostic)
}

fun bootstrapDiscoverImportProviders(
    entry: string,
    resolve: bool = false,
    resolveEffects: int = 0
): BootstrapPackageDependencies {
    val discovery = BootstrapImportProviderDiscovery(
        bootstrapModuleState(), [], [], 0, ""
    )
    discovery.collect(entry)
    val dependencies: array<BootstrapPackageDependency> = []
    var moduleIndex = 0
    while (moduleIndex < discovery.ordered.size) {
        val snapshot = discovery.ordered[moduleIndex]
        var edgeIndex = 0
        while (edgeIndex < snapshot.importEdges.size) {
            val edge = snapshot.importEdges[edgeIndex]
            if (edge.provider) {
                val provider = bootstrapEvaluateImportProvider(
                    edge.source, discovery.ordered,
                    BootstrapParseResult([], [], 0, 0, [], [], ""),
                    resolve, resolveEffects
                )
                discovery.errors = discovery.errors + provider.errors
                discovery.diagnostics =
                    "${discovery.diagnostics}${provider.diagnostic}"
                val existing = bootstrapPackageDependencyIndex(
                    dependencies, provider.dependency.name
                )
                if (provider.errors == 0 && existing < 0) {
                    dependencies.append(provider.dependency)
                }
                if (provider.errors == 0 && existing >= 0 &&
                    (dependencies[existing].source !=
                        provider.dependency.source ||
                     dependencies[existing].selectorKind !=
                        provider.dependency.selectorKind ||
                     dependencies[existing].selector !=
                        provider.dependency.selector)) {
                    discovery.errors = discovery.errors + 1
                    discovery.diagnostics = "${discovery.diagnostics}error[E_PACKAGE_COLLISION]: import providers request incompatible sources or selectors for dependency '${provider.dependency.name}'\n"
                }
            }
            edgeIndex = edgeIndex + 1
        }
        moduleIndex = moduleIndex + 1
    }
    BootstrapPackageDependencies(
        dependencies, discovery.errors, discovery.diagnostics
    )
}

fun bootstrapModuleState(): BootstrapModuleState =
    BootstrapModuleState([], [], 0, 0, 0, 0)

fun bootstrapManifestCompileCapabilities(
    modulePath: string
): array<string> {
    val capabilities: array<string> = []
    var manifestPath = Path(modulePath).parent().child("abla.toml")
    var directory = Path(modulePath).parent()
    var searching = !manifestPath.exists()
    var depth = 0
    while (searching && depth < 128) {
        val parent = directory.parent()
        if (parent.text == directory.text) searching = false
        directory = parent
        val candidate = directory.child("abla.toml")
        if (candidate.exists()) {
            manifestPath = candidate
            searching = false
        }
        depth = depth + 1
    }
    val source = manifestPath.readText()
    var lineBegin = 0
    var arrayCursor = -1
    while (lineBegin < source.size && arrayCursor < 0) {
        var lineEnd = lineBegin
        while (lineEnd < source.size && source[lineEnd] != 10 &&
               source[lineEnd] != 13) lineEnd = lineEnd + 1
        var contentEnd = lineEnd
        var comment = lineBegin
        while (comment < contentEnd && source[comment] != 35) {
            comment = comment + 1
        }
        if (comment < contentEnd) contentEnd = comment
        var equals = lineBegin
        while (equals < contentEnd && source[equals] != 61) {
            equals = equals + 1
        }
        var keyBegin = lineBegin
        while (keyBegin < equals &&
               (source[keyBegin] == 32 || source[keyBegin] == 9)) {
            keyBegin = keyBegin + 1
        }
        var keyEnd = equals
        while (keyEnd > keyBegin &&
               (source[keyEnd - 1] == 32 || source[keyEnd - 1] == 9)) {
            keyEnd = keyEnd - 1
        }
        if (equals < contentEnd &&
            source.slice(keyBegin, keyEnd) == "compileCapabilities") {
            var index = equals + 1
            while (index < contentEnd &&
                   (source[index] == 32 || source[index] == 9)) {
                index = index + 1
            }
            if (index < contentEnd && source[index] == 91) {
                arrayCursor = index + 1
            }
        }
        lineBegin = lineEnd + 1
        if (lineBegin < source.size && source[lineBegin - 1] == 13 &&
            source[lineBegin] == 10) lineBegin = lineBegin + 1
    }
    var complete = false
    while (arrayCursor >= 0 && arrayCursor < source.size && !complete) {
        while (arrayCursor < source.size &&
               (source[arrayCursor] == 32 || source[arrayCursor] == 9 ||
                source[arrayCursor] == 10 || source[arrayCursor] == 13 ||
                source[arrayCursor] == 44)) arrayCursor = arrayCursor + 1
        if (arrayCursor < source.size && source[arrayCursor] == 35) {
            while (arrayCursor < source.size &&
                   source[arrayCursor] != 10 && source[arrayCursor] != 13) {
                arrayCursor = arrayCursor + 1
            }
        } else if (arrayCursor < source.size && source[arrayCursor] == 93) {
            complete = true
        } else if (arrayCursor < source.size && source[arrayCursor] == 34) {
            val begin = arrayCursor + 1
            arrayCursor = begin
            while (arrayCursor < source.size &&
                   source[arrayCursor] != 34 &&
                   source[arrayCursor] != 10 &&
                   source[arrayCursor] != 13) {
                arrayCursor = arrayCursor + 1
            }
            if (arrayCursor < source.size && source[arrayCursor] == 34) {
                val capability = source.slice(begin, arrayCursor)
                if (capabilities.size < 64 &&
                    bootstrapCompileEffectFromName(capability) != 0 &&
                    !bootstrapAffineNamesContain(
                        capabilities,
                        capability
                    )) capabilities.append(capability)
                arrayCursor = arrayCursor + 1
            } else complete = true
        } else complete = true
    }
    capabilities
}

// The bootstrap package reader intentionally accepts a small deterministic
// TOML subset. String fields provide root/package identity and entry selection;
// import providers and lock records use the bounded package scanner.
fun bootstrapTomlStringField(manifestPath: string, key: string): string {
    val source = Path(manifestPath).readText()
    var result = ""
    var lineBegin = 0
    while (lineBegin < source.size && result == "") {
        var lineEnd = lineBegin
        while (lineEnd < source.size && source[lineEnd] != 10 &&
               source[lineEnd] != 13) lineEnd = lineEnd + 1
        var equals = lineBegin
        while (equals < lineEnd && source[equals] != 61) equals = equals + 1
        var keyBegin = lineBegin
        while (keyBegin < equals &&
               (source[keyBegin] == 32 || source[keyBegin] == 9)) {
            keyBegin = keyBegin + 1
        }
        var keyEnd = equals
        while (keyEnd > keyBegin &&
               (source[keyEnd - 1] == 32 || source[keyEnd - 1] == 9)) {
            keyEnd = keyEnd - 1
        }
        if (equals < lineEnd &&
            source.slice(keyBegin, keyEnd) == key) {
            var valueBegin = equals + 1
            while (valueBegin < lineEnd &&
                   (source[valueBegin] == 32 || source[valueBegin] == 9)) {
                valueBegin = valueBegin + 1
            }
            if (valueBegin < lineEnd && source[valueBegin] == 34) {
                val begin = valueBegin + 1
                var end = begin
                while (end < lineEnd && source[end] != 34) end = end + 1
                if (end < lineEnd) result = source.slice(begin, end)
            }
        }
        lineBegin = lineEnd + 1
        if (lineBegin < source.size && source[lineBegin - 1] == 13 &&
            source[lineBegin] == 10) lineBegin = lineBegin + 1
    }
    result
}

class BootstrapProjectDescriptor(
    val root: string,
    val name: string,
    val version: string,
    val entry: string,
    val output: string,
    val valid: bool,
    val diagnostic: string
)

fun bootstrapProjectDescriptor(root: string): BootstrapProjectDescriptor {
    val projectRoot = Path(root)
    val manifest = projectRoot.child("abla.toml")
    var name = bootstrapTomlStringField(manifest.text, "name")
    val version = bootstrapTomlStringField(manifest.text, "version")
    var relativeEntry = bootstrapTomlStringField(manifest.text, "entry")
    if (name == "") name = "abla-out"
    if (relativeEntry == "") relativeEntry = "src/main.ab"
    val entry = projectRoot.child(relativeEntry)
    var valid = manifest.exists()
    var diagnostic = ""
    if (!valid) diagnostic = "missing package manifest: ${manifest.text}"
    if (valid && !bootstrapPackageNameValid(name)) {
        valid = false
        diagnostic = "invalid package name '$name'"
    }
    if (valid && !bootstrapPackageRelativePathValid(relativeEntry)) {
        valid = false
        diagnostic = "package entry must be a safe relative path"
    }
    if (valid && !entry.exists()) {
        valid = false
        diagnostic = "package entry does not exist: ${entry.text}"
    }
    BootstrapProjectDescriptor(
        projectRoot.text,
        name,
        version,
        entry.text,
        projectRoot.child("build").child(name).text,
        valid,
        diagnostic
    )
}

class BootstrapModule(
    val path: string,
    val source: string
)

class BootstrapModuleAlias(
    val importer: string,
    val target: string,
    val alias: string,
    val contractOnly: bool,
    val begin: int,
    val end: int
)

fun bootstrapModuleCanonicalPrefix(modulePath: string): string {
    val digits = "0123456789abcdef"
    var prefix = "__abla_module_"
    var index = 0
    while (index < modulePath.size) {
        val byte = modulePath[index]
        prefix = "$prefix${digits.slice(byte / 16, byte / 16 + 1)}"
        prefix = "$prefix${digits.slice(byte - (byte / 16) * 16,
            byte - (byte / 16) * 16 + 1)}"
        index = index + 1
    }
    "${prefix}__"
}

fun bootstrapModuleAliasTargetPrefix(
    aliases: array<BootstrapModuleAlias>,
    target: string
): string {
    var prefix = ""
    var index = 0
    while (index < aliases.size && prefix == "") {
        if (aliases[index].target == target && aliases[index].alias != "") {
            prefix = bootstrapModuleCanonicalPrefix(target)
        }
        index = index + 1
    }
    prefix
}

fun bootstrapModuleIsContractTarget(
    aliases: array<BootstrapModuleAlias>,
    target: string
): bool {
    var contractOnly = false
    var index = 0
    while (index < aliases.size) {
        if (aliases[index].target == target && aliases[index].contractOnly) {
            contractOnly = true
        }
        index = index + 1
    }
    contractOnly
}

fun bootstrapContractDeclaration(
    declaration: BootstrapDeclaration,
    moduleIdentity: string
): BootstrapDeclaration {
    val annotations: array<string> = []
    var annotation = 0
    while (annotation < declaration.annotations.size) {
        annotations.append(declaration.annotations[annotation])
        annotation = annotation + 1
    }
    val kind = if (declaration.kind == "fun") "extern" else declaration.kind
    val externalLibrary = if (declaration.kind == "fun") {
        "contract:$moduleIdentity"
    } else declaration.externalLibrary
    BootstrapDeclaration(
        kind,
        declaration.name,
        declaration.begin,
        declaration.end,
        BootstrapExpression(
            "missing", "contract", declaration.begin, declaration.end, []
        ),
        declaration.parameters,
        declaration.parameterTypes,
        declaration.resultType,
        [],
        declaration.parameterDefaults,
        externalLibrary,
        declaration.parameterKinds,
        declaration.extensionOwner,
        declaration.isTrusted,
        declaration.isResource,
        declaration.isNoEscape,
        declaration.generatedNamespace,
        declaration.generatedOriginBegin,
        declaration.generatedOriginEnd,
        annotations,
        declaration.annotationBegins,
        declaration.annotationEnds
    )
}

fun bootstrapProjectContract(
    parsed: BootstrapParseResult,
    moduleIdentity: string
): BootstrapParseResult {
    val declarations: array<BootstrapDeclaration> = []
    var index = 0
    while (index < parsed.declarations.size) {
        val declaration = parsed.declarations[index]
        if (declaration.kind == "fun" || declaration.kind == "class" ||
            declaration.kind == "interface") {
            declarations.append(bootstrapContractDeclaration(
                declaration, moduleIdentity
            ))
        }
        index = index + 1
    }
    BootstrapParseResult(
        declarations,
        [],
        parsed.errors,
        parsed.extensionErrors,
        [],
        [],
        parsed.diagnostics
    )
}

fun bootstrapContractTypeMentions(typeName: string, name: string): bool {
    var found = false
    var offset = 0
    while (!found && offset + name.size <= typeName.size) {
        val before = offset == 0 ||
            !bootstrapIsAlphaNumeric(typeName[offset - 1])
        val afterOffset = offset + name.size
        val after = afterOffset == typeName.size ||
            !bootstrapIsAlphaNumeric(typeName[afterOffset])
        if (before && after && bootstrapRegionEquals(
            typeName, offset, afterOffset, name
        )) found = true
        offset = offset + 1
    }
    found
}

fun bootstrapContractShapeMentions(
    parsed: BootstrapParseResult,
    name: string
): bool {
    var found = false
    var declaration = 0
    while (!found && declaration < parsed.declarations.size) {
        val current = parsed.declarations[declaration]
        if (bootstrapContractTypeMentions(current.resultType, name)) {
            found = true
        }
        var parameter = 0
        while (!found && parameter < current.parameterTypes.size) {
            found = bootstrapContractTypeMentions(
                current.parameterTypes[parameter], name
            )
            parameter = parameter + 1
        }
        var method = 0
        while (!found && method < current.methods.size) {
            val member = current.methods[method]
            if (bootstrapContractTypeMentions(member.resultType, name)) {
                found = true
            }
            parameter = 0
            while (!found && parameter < member.parameterTypes.size) {
                found = bootstrapContractTypeMentions(
                    member.parameterTypes[parameter], name
                )
                parameter = parameter + 1
            }
            method = method + 1
        }
        declaration = declaration + 1
    }
    found
}

fun bootstrapContractImportRequired(
    parsed: BootstrapParseResult,
    edge: BootstrapImportEdge,
    imported: BootstrapParseResult
): bool {
    var required = edge.alias != "" &&
        bootstrapContractShapeMentions(parsed, edge.alias)
    var declaration = 0
    while (!required && edge.alias == "" &&
           declaration < imported.declarations.size) {
        val candidate = imported.declarations[declaration]
        if ((candidate.kind == "class" || candidate.kind == "interface") &&
            bootstrapContractShapeMentions(parsed, candidate.name)) {
            required = true
        }
        declaration = declaration + 1
    }
    required
}

fun bootstrapExpressionDeclaresAliasBefore(
    expression: BootstrapExpression,
    alias: string,
    position: int
): bool {
    var found = (expression.kind == "local.val" ||
        expression.kind == "local.var") &&
        expression.text == alias && expression.begin <= position
    var child = 0
    while (child < expression.children.size && !found) {
        found = bootstrapExpressionDeclaresAliasBefore(
            expression.children[child], alias, position
        )
        child = child + 1
    }
    found
}

fun bootstrapAliasShadowedAt(
    parsed: BootstrapParseResult,
    alias: string,
    position: int
): bool {
    var shadowed = false
    var declaration = 0
    while (declaration < parsed.declarations.size && !shadowed) {
        val found = parsed.declarations[declaration]
        if (position >= found.begin && position <= found.end) {
            var parameter = 0
            while (parameter < found.parameters.size && !shadowed) {
                if (found.parameters[parameter] == alias) shadowed = true
                parameter = parameter + 1
            }
            if (!shadowed) shadowed = bootstrapExpressionDeclaresAliasBefore(
                found.expression, alias, position
            )
        }
        declaration = declaration + 1
    }
    shadowed
}

fun bootstrapRewriteModuleSource(
    snapshot: BootstrapModuleSnapshot,
    aliases: array<BootstrapModuleAlias>
): string {
    val names: array<string> = []
    val replacements: array<string> = []
    val ownPrefix = bootstrapModuleAliasTargetPrefix(
        aliases, snapshot.path
    )
    if (ownPrefix != "") {
        var declaration = 0
        while (declaration < snapshot.discovery.declarations.size) {
            val name = snapshot.discovery.declarations[declaration].name
            if (name != "") {
                names.append(name)
                replacements.append("$ownPrefix$name")
            }
            declaration = declaration + 1
        }
    }
    val localAliases: array<string> = []
    val aliasPrefixes: array<string> = []
    var aliasIndex = 0
    while (aliasIndex < aliases.size) {
        val edge = aliases[aliasIndex]
        if (edge.importer == snapshot.path && edge.alias != "") {
            localAliases.append(edge.alias)
            aliasPrefixes.append(bootstrapModuleCanonicalPrefix(edge.target))
        }
        aliasIndex = aliasIndex + 1
    }
    if (names.size == 0 && localAliases.size == 0) snapshot.source
    else {
        val tokens = bootstrapLex(snapshot.source)
        var output = ""
        var cursor = 0
        var tokenIndex = 0
        var inImport = false
        while (tokenIndex < tokens.size) {
            val token = tokens[tokenIndex]
            if (token.kind == "import") inImport = true
            if (token.kind == "newline" || token.kind == ";") {
                inImport = false
            }
            var qualified = -1
            if (!inImport && token.kind == "identifier" &&
                tokenIndex + 2 < tokens.size &&
                tokens[tokenIndex + 1].kind == "." &&
                tokens[tokenIndex + 2].kind == "identifier") {
                val qualifier = bootstrapTokenText(snapshot.source, token)
                var candidate = 0
                while (candidate < localAliases.size && qualified < 0) {
                    if (localAliases[candidate] == qualifier) {
                        qualified = candidate
                    }
                    candidate = candidate + 1
                }
                if (qualified >= 0 && bootstrapAliasShadowedAt(
                    snapshot.discovery, qualifier, token.begin
                )) qualified = -1
            }
            if (qualified >= 0) {
                val member = tokens[tokenIndex + 2]
                output = "$output${snapshot.source.slice(cursor, token.begin)}"
                output = "$output${aliasPrefixes[qualified]}${bootstrapTokenText(
                    snapshot.source, member
                )}"
                cursor = member.end
                tokenIndex = tokenIndex + 3
            } else {
                var replacement = -1
                if (!inImport && token.kind == "identifier" &&
                    (tokenIndex == 0 ||
                     tokens[tokenIndex - 1].kind != ".")) {
                    val text = bootstrapTokenText(snapshot.source, token)
                    var candidate = 0
                    while (candidate < names.size && replacement < 0) {
                        if (names[candidate] == text) replacement = candidate
                        candidate = candidate + 1
                    }
                }
                if (replacement >= 0) {
                    output =
                        "$output${snapshot.source.slice(cursor, token.begin)}${replacements[replacement]}"
                    cursor = token.end
                }
                tokenIndex = tokenIndex + 1
            }
        }
        "$output${snapshot.source.slice(cursor, snapshot.source.size)}"
    }
}

fun bootstrapPrepareModuleSnapshot(
    snapshot: BootstrapModuleSnapshot,
    aliases: array<BootstrapModuleAlias>
): BootstrapModuleSnapshot {
    val source = bootstrapRewriteModuleSource(snapshot, aliases)
    var discovery = bootstrapParseWithIdentity(source, snapshot.path)
    val contractOnly = bootstrapModuleIsContractTarget(aliases, snapshot.path)
    if (contractOnly) {
        discovery = bootstrapProjectContract(discovery, snapshot.path)
    }
    val fingerprintSource = if (contractOnly) {
        bootstrapModuleInterfaceIdentity(discovery, 0, 0)
    } else source
    BootstrapModuleSnapshot(
        snapshot.path,
        source,
        snapshot.importEdges,
        snapshot.importErrors,
        snapshot.exists,
        snapshot.size,
        snapshot.revision,
        bootstrapModuleFingerprint(fingerprintSource, 17, 257, 1000000007),
        bootstrapModuleFingerprint(fingerprintSource, 97, 263, 1000000009),
        discovery
    )
}

fun bootstrapImportAliasExposedTarget(target: string): string {
    var exposed = target
    if (target.size >= 9 &&
        target.slice(target.size - 9, target.size) == "/entry.ab") {
        val source = Path(target).readText()
        val scan = bootstrapScanImports(source)
        val parsed = bootstrapParseWithIdentity(source, target)
        if (parsed.declarations.size == 0 && scan.errors == 0 &&
            scan.edges.size == 1 && !scan.edges[0].provider &&
            scan.edges[0].alias == "") {
            exposed = bootstrapResolveImport(target, scan.edges[0].source)
        }
    }
    exposed
}

class BootstrapImportAliasValidation(
    val errors: int,
    val diagnostics: string
)

fun bootstrapValidateImportAliases(
    aliases: array<BootstrapModuleAlias>,
    state: BootstrapModuleState
): BootstrapImportAliasValidation {
    var errors = 0
    var diagnostics = ""
    var aliasIndex = 0
    while (aliasIndex < aliases.size) {
        val edge = aliases[aliasIndex]
        if (edge.alias != "") {
            val importerIndex = state.indexOf(edge.importer)
            val targetIndex = state.indexOf(edge.target)
            if (importerIndex >= 0 && targetIndex >= 0) {
                val importer = state.snapshots[importerIndex]
                val target = state.snapshots[targetIndex]
                val tokens = bootstrapLex(importer.source)
                var tokenIndex = 0
                var inImport = false
                while (tokenIndex < tokens.size) {
                    val token = tokens[tokenIndex]
                    if (token.kind == "import") inImport = true
                    if (token.kind == "newline" || token.kind == ";") {
                        inImport = false
                    }
                    if (!inImport && token.kind == "identifier" &&
                        bootstrapTokenText(importer.source, token) ==
                            edge.alias &&
                        !bootstrapAliasShadowedAt(
                            importer.discovery, edge.alias, token.begin
                        )) {
                        if (tokenIndex + 2 < tokens.size &&
                            tokens[tokenIndex + 1].kind == "." &&
                            tokens[tokenIndex + 2].kind == "identifier") {
                            val member = bootstrapTokenText(
                                importer.source,
                                tokens[tokenIndex + 2]
                            )
                            var exposed = false
                            var declaration = 0
                            while (declaration <
                                target.discovery.declarations.size) {
                                if (target.discovery.declarations[
                                    declaration
                                ].name == member) exposed = true
                                declaration = declaration + 1
                            }
                            if (!exposed) {
                                errors = errors + 1
                                diagnostics =
                                    "${diagnostics}error[E_IMPORT_ALIAS_MEMBER_UNKNOWN]: module alias `${edge.alias}` has no exposed declaration named `$member`\ncontext[canonical-module]: ${edge.target}\nsource[qualified-import]:${edge.importer}:${token.begin}:${tokens[tokenIndex + 2].end}\n"
                            }
                            tokenIndex = tokenIndex + 2
                        } else {
                            errors = errors + 1
                            diagnostics =
                                "${diagnostics}error[E_IMPORT_ALIAS_USED_AS_VALUE]: module alias `${edge.alias}` is compile-time-only and must qualify a declaration\ncontext[canonical-module]: ${edge.target}\nsource[qualified-import]:${edge.importer}:${token.begin}:${token.end}\n"
                        }
                    }
                    tokenIndex = tokenIndex + 1
                }
            }
        }
        aliasIndex = aliasIndex + 1
    }
    BootstrapImportAliasValidation(errors, diagnostics)
}

class BootstrapModuleGraph(
    val modules: array<BootstrapModule>,
    var errors: int,
    val state: BootstrapModuleState,
    val orderedSnapshots: array<BootstrapModuleSnapshot>,
    val authorizedCompileCapabilities: array<string>,
    var diagnostics: string,
    val aliases: array<BootstrapModuleAlias>
) {
    fun recordImportEdge(
        importer: BootstrapModuleSnapshot,
        edge: BootstrapImportEdge,
        target: string
    ): void {
        var duplicateAlias = false
        var duplicateTarget = false
        var index = 0
        while (index < this.aliases.size) {
            val found = this.aliases[index]
            if (found.importer == importer.path && edge.alias != "" &&
                found.alias == edge.alias) duplicateAlias = true
            if (found.importer == importer.path && found.target == target) {
                duplicateTarget = true
            }
            index = index + 1
        }
        var declarationCollision = false
        index = 0
        while (index < importer.discovery.declarations.size) {
            if (edge.alias != "" &&
                importer.discovery.declarations[index].name == edge.alias) {
                declarationCollision = true
            }
            index = index + 1
        }
        var unqualifiedAmbiguities = 0
        var ambiguityDiagnostics = ""
        if (edge.alias == "") {
            val targetDeclarations = bootstrapParseWithIdentity(
                Path(target).readText(), target
            ).declarations
            index = 0
            while (index < this.aliases.size) {
                val found = this.aliases[index]
                if (found.importer == importer.path && found.alias == "" &&
                    found.target != target) {
                    val foundDeclarations = bootstrapParseWithIdentity(
                        Path(found.target).readText(), found.target
                    ).declarations
                    var targetDeclaration = 0
                    while (targetDeclaration < targetDeclarations.size) {
                        var foundDeclaration = 0
                        while (foundDeclaration < foundDeclarations.size) {
                            val name = targetDeclarations[
                                targetDeclaration
                            ].name
                            if (name != "" &&
                                targetDeclarations[
                                    targetDeclaration
                                ].extensionOwner == "" &&
                                foundDeclarations[
                                    foundDeclaration
                                ].extensionOwner == "" &&
                                name == foundDeclarations[
                                    foundDeclaration
                                ].name) {
                                unqualifiedAmbiguities =
                                    unqualifiedAmbiguities + 1
                                ambiguityDiagnostics =
                                    "${ambiguityDiagnostics}error[E_IMPORT_UNQUALIFIED_AMBIGUOUS]: unqualified declaration `$name` is exposed by both `${found.target}` and `$target`; add explicit aliases\nsource[import]:${importer.path}:${edge.begin}:${edge.end}\n"
                            }
                            foundDeclaration = foundDeclaration + 1
                        }
                        targetDeclaration = targetDeclaration + 1
                    }
                }
                index = index + 1
            }
        }
        if (duplicateAlias) {
            this.errors = this.errors + 1
            this.diagnostics =
                "${this.diagnostics}error[E_IMPORT_ALIAS_DUPLICATE]: import alias `${edge.alias}` is bound more than once in module `${importer.path}`\nsource[import]:${importer.path}:${edge.begin}:${edge.end}\n"
        }
        if (declarationCollision) {
            this.errors = this.errors + 1
            this.diagnostics =
                "${this.diagnostics}error[E_IMPORT_ALIAS_DECLARATION_COLLISION]: import alias `${edge.alias}` collides with a declaration in module `${importer.path}`\nsource[import]:${importer.path}:${edge.begin}:${edge.end}\n"
        }
        if (duplicateTarget) {
            this.errors = this.errors + 1
            this.diagnostics =
                "${this.diagnostics}error[E_IMPORT_ALIAS_TARGET_DUPLICATE]: module `$target` is imported more than once by `${importer.path}`\nsource[import]:${importer.path}:${edge.begin}:${edge.end}\n"
        }
        if (unqualifiedAmbiguities > 0) {
            this.errors = this.errors + unqualifiedAmbiguities
            this.diagnostics =
                "${this.diagnostics}$ambiguityDiagnostics"
        }
        if (!duplicateAlias && !declarationCollision && !duplicateTarget &&
            unqualifiedAmbiguities == 0) {
            this.aliases.append(BootstrapModuleAlias(
                importer.path,
                target,
                edge.alias,
                edge.contractOnly,
                edge.begin,
                edge.end
            ))
        }
        bootstrapSemanticUnit()
    }
    fun contains(modulePath: string): bool {
        val identity = bootstrapNormalizeModulePath(modulePath)
        var found = false
        var index = 0
        while (index < this.modules.size) {
            if (this.modules[index].path == identity) found = true
            index = index + 1
        }
        found
    }

    fun loadContract(modulePath: string): string {
        val identity = bootstrapNormalizeModulePath(modulePath)
        if (!this.contains(identity)) {
            val snapshot = this.state.acquire(identity)
            this.errors = this.errors + snapshot.importErrors
            this.diagnostics =
                "${this.diagnostics}${bootstrapScanImports(snapshot.source).diagnostics}"
            this.modules.append(BootstrapModule(identity, ""))
            var index = 0
            while (index < snapshot.importEdges.size) {
                val edge = snapshot.importEdges[index]
                if (!edge.provider) {
                    val imported = bootstrapResolveImport(identity, edge.source)
                    val exposed = bootstrapImportAliasExposedTarget(imported)
                    val importedSnapshot = this.state.acquire(exposed)
                    if (bootstrapContractImportRequired(
                        snapshot.discovery,
                        edge,
                        importedSnapshot.discovery
                    )) {
                        val contractEdge = BootstrapImportEdge(
                            edge.source,
                            edge.provider,
                            edge.alias,
                            true,
                            edge.begin,
                            edge.end
                        )
                        this.recordImportEdge(snapshot, contractEdge, exposed)
                        this.loadContract(imported)
                    }
                }
                index = index + 1
            }
            this.orderedSnapshots.append(snapshot)
        }
        ""
    }

    fun load(modulePath: string): string {
        val identity = bootstrapNormalizeModulePath(modulePath)
        if (this.modules.size == 0 &&
            this.authorizedCompileCapabilities.size == 0) {
            val capabilities = bootstrapManifestCompileCapabilities(identity)
            var capability = 0
            while (capability < capabilities.size) {
                this.authorizedCompileCapabilities.append(
                    capabilities[capability]
                )
                capability = capability + 1
            }
        }
        var output = ""
        if (!this.contains(identity)) {
            val snapshot = this.state.acquire(identity)
            this.errors = this.errors + snapshot.importErrors
            this.diagnostics =
                "${this.diagnostics}${bootstrapScanImports(snapshot.source).diagnostics}"
            this.modules.append(BootstrapModule(identity, snapshot.source))
            var index = 0
            while (index < snapshot.importEdges.size) {
                val edge = snapshot.importEdges[index]
                if (!edge.provider) {
                    val imported = bootstrapResolveImport(
                        identity,
                        edge.source
                    )
                    this.recordImportEdge(
                        snapshot,
                        edge,
                        bootstrapImportAliasExposedTarget(imported)
                    )
                    if (edge.contractOnly) {
                        output = "$output${this.loadContract(imported)}\n"
                    } else output = "$output${this.load(imported)}\n"
                } else {
                    val provider = bootstrapEvaluateImportProvider(
                        edge.source, this.orderedSnapshots,
                        snapshot.discovery
                    )
                    if (provider.errors == 0) {
                        val imported = bootstrapResolvePackageImport(
                            identity, "package/${provider.dependency.name}"
                        )
                        if (imported != "") {
                            this.recordImportEdge(
                                snapshot,
                                edge,
                                bootstrapImportAliasExposedTarget(imported)
                            )
                            if (edge.contractOnly) {
                                output =
                                    "$output${this.loadContract(imported)}\n"
                            } else output = "$output${this.load(imported)}\n"
                        } else {
                            this.errors = this.errors + 1
                            this.diagnostics =
                                "${this.diagnostics}error[E_PACKAGE_IMPORT]: locked package `${provider.dependency.name}` could not be resolved from module `$identity`\n"
                        }
                    } else {
                        this.errors = this.errors + provider.errors
                        this.diagnostics =
                            "${this.diagnostics}${provider.diagnostic}"
                    }
                }
                index = index + 1
            }
            this.orderedSnapshots.append(snapshot)
            output = "$output${snapshot.source}\n"
        }
        output
    }

    fun parse(): BootstrapParseResult {
        val declarations: array<BootstrapDeclaration> = []
        val actions: array<BootstrapExpression> = []
        val compileInputPaths: array<string> = []
        val compileInputContents: array<string> = []
        val handlerDeclarations: array<BootstrapDeclaration> = []
        val importedRegistrations: array<BootstrapSubparserRegistration> = []
        val preparedSnapshots: array<BootstrapModuleSnapshot> = []
        var preparedIndex = 0
        while (preparedIndex < this.orderedSnapshots.size) {
            preparedSnapshots.append(bootstrapPrepareModuleSnapshot(
                this.orderedSnapshots[preparedIndex],
                this.aliases
            ))
            preparedIndex = preparedIndex + 1
        }
        val aliasValidation = bootstrapValidateImportAliases(
            this.aliases, this.state
        )
        var parseErrors = this.errors + aliasValidation.errors
        var extensionErrors = 0
        var parseDiagnostics =
            "${this.diagnostics}${aliasValidation.diagnostics}"
        var dependencyFingerprint = 29
        var authorizedEffects = 0
        var authorized = 0
        while (authorized < this.authorizedCompileCapabilities.size) {
            authorizedEffects = bootstrapCompileEffectMerge(
                authorizedEffects,
                bootstrapCompileEffectFromName(
                    this.authorizedCompileCapabilities[authorized]
                )
            )
            authorized = authorized + 1
        }
        var requestedEffects = 0
        val completeDeclarations: array<BootstrapDeclaration> = []
        var completeDeclarationFingerprint = 41
        var requestedModule = 0
        while (requestedModule < preparedSnapshots.size) {
            val requestedSnapshot = preparedSnapshots[requestedModule]
            requestedEffects = bootstrapCompileEffectMerge(
                requestedEffects,
                bootstrapBuildCompileEffectRequests(
                    requestedSnapshot.discovery
                )
            )
            var completeDeclaration = 0
            while (completeDeclaration <
                    requestedSnapshot.discovery.declarations.size) {
                completeDeclarations.append(
                    requestedSnapshot.discovery.declarations[completeDeclaration]
                )
                completeDeclaration = completeDeclaration + 1
            }
            val completeInterface = bootstrapModuleInterfaceIdentity(
                requestedSnapshot.discovery,
                requestedSnapshot.firstFingerprint,
                requestedSnapshot.secondFingerprint
            )
            completeDeclarationFingerprint =
                completeDeclarationFingerprint * 277 +
                bootstrapModuleFingerprint(
                    completeInterface, 79, 281, 1000000007
                )
            completeDeclarationFingerprint =
                completeDeclarationFingerprint -
                (completeDeclarationFingerprint / 1000000007) *
                    1000000007
            requestedModule = requestedModule + 1
        }
        val allowedCompileEffects = bootstrapBuildCompileEffectGrants(
            requestedEffects,
            authorizedEffects
        )
        dependencyFingerprint = dependencyFingerprint + allowedCompileEffects +
            completeDeclarationFingerprint
        var moduleIndex = 0
        var currentDeclarationBegin = 0
        while (moduleIndex < preparedSnapshots.size) {
            val snapshot = preparedSnapshots[moduleIndex]
            val visibleDeclarations: array<BootstrapDeclaration> = []
            var declarationIndex = 0
            while (declarationIndex < handlerDeclarations.size) {
                visibleDeclarations.append(
                    handlerDeclarations[declarationIndex]
                )
                declarationIndex = declarationIndex + 1
            }
            declarationIndex = 0
            while (declarationIndex < snapshot.discovery.declarations.size) {
                visibleDeclarations.append(
                    snapshot.discovery.declarations[declarationIndex]
                )
                declarationIndex = declarationIndex + 1
            }

            val localRegistry = bootstrapBuildSubparserRegistry(
                BootstrapParseResult(
                    visibleDeclarations,
                    snapshot.discovery.actions,
                    snapshot.discovery.errors,
                    snapshot.discovery.extensionErrors,
                    [],
                    [],
                    snapshot.discovery.diagnostics
                )
            )
            parseErrors = parseErrors + localRegistry.errors
            extensionErrors = extensionErrors + localRegistry.errors
            parseDiagnostics =
                "$parseDiagnostics${localRegistry.diagnostics}"
            val moduleRegistrations: array<BootstrapSubparserRegistration> = []
            var registrationIndex = 0
            while (registrationIndex < importedRegistrations.size) {
                moduleRegistrations.append(
                    importedRegistrations[registrationIndex]
                )
                registrationIndex = registrationIndex + 1
            }
            registrationIndex = 0
            while (registrationIndex < localRegistry.registrations.size) {
                val registration = localRegistry.registrations[registrationIndex]
                var duplicate = false
                var importedIndex = 0
                while (importedIndex < importedRegistrations.size) {
                    if (importedRegistrations[importedIndex].name ==
                        registration.name) duplicate = true
                    importedIndex = importedIndex + 1
                }
                if (duplicate) {
                    parseErrors = parseErrors + 1
                    extensionErrors = extensionErrors + 1
                    parseDiagnostics =
                        "${parseDiagnostics}error[E_EXT_SUBPARSER_COLLISION]: imported subparser `${registration.name}` is registered more than once\nsource[module]:${snapshot.path}:0:0\n"
                    0
                } else {
                    moduleRegistrations.append(registration)
                    importedRegistrations.append(
                        BootstrapSubparserRegistration(
                            registration.name,
                            registration.handler,
                            -1
                        )
                    )
                    0
                }
                registrationIndex = registrationIndex + 1
            }

            val parsed = if (bootstrapModuleIsContractTarget(
                this.aliases, snapshot.path
            )) snapshot.discovery
            else this.state.acquireParsed(
                snapshot,
                dependencyFingerprint,
                completeDeclarations,
                currentDeclarationBegin,
                BootstrapSubparserRegistry(moduleRegistrations, 0, ""),
                allowedCompileEffects
            )
            val interfaceIdentity = bootstrapModuleInterfaceIdentity(
                parsed,
                snapshot.firstFingerprint,
                snapshot.secondFingerprint
            )
            dependencyFingerprint = dependencyFingerprint * 257 +
                bootstrapModuleFingerprint(
                    interfaceIdentity, 31, 269, 1000000007
                )
            dependencyFingerprint = dependencyFingerprint -
                (dependencyFingerprint / 1000000007) * 1000000007
            dependencyFingerprint = dependencyFingerprint * 263 +
                bootstrapModuleFingerprint(
                    interfaceIdentity, 73, 271, 1000000009
                )
            dependencyFingerprint = dependencyFingerprint -
                (dependencyFingerprint / 1000000009) * 1000000009
            parseErrors = parseErrors + parsed.errors
            extensionErrors = extensionErrors + parsed.extensionErrors
            parseDiagnostics = "$parseDiagnostics${parsed.diagnostics}"
            bootstrapMergeCompileInputs(
                compileInputPaths,
                compileInputContents,
                parsed.compileInputPaths,
                parsed.compileInputContents
            )
            declarationIndex = 0
            while (declarationIndex < parsed.declarations.size) {
                declarations.append(parsed.declarations[declarationIndex])
                handlerDeclarations.append(parsed.declarations[declarationIndex])
                declarationIndex = declarationIndex + 1
            }
            var actionIndex = 0
            while (actionIndex < parsed.actions.size) {
                actions.append(parsed.actions[actionIndex])
                actionIndex = actionIndex + 1
            }
            moduleIndex = moduleIndex + 1
            currentDeclarationBegin = currentDeclarationBegin +
                snapshot.discovery.declarations.size
        }
        var capability = 0
        while (capability < this.authorizedCompileCapabilities.size) {
            actions.append(BootstrapExpression(
                "compile.capability.authorization",
                this.authorizedCompileCapabilities[capability],
                0,
                0,
                []
            ))
            capability = capability + 1
        }
        BootstrapParseResult(
            declarations,
            actions,
            parseErrors,
            extensionErrors,
            compileInputPaths,
            compileInputContents,
            parseDiagnostics
        )
    }
}

fun bootstrapBundleWithState(
    modulePath: string,
    var state: BootstrapModuleState
): string {
    state.reused = 0
    state.refreshed = 0
    state.reusedParsed = 0
    state.refreshedParsed = 0
    val modules: array<BootstrapModule> = []
    val ordered: array<BootstrapModuleSnapshot> = []
    BootstrapModuleGraph(modules, 0, state, ordered, [], "", []).load(
        modulePath
    )
}

fun bootstrapBundle(modulePath: string): string {
    val state = bootstrapModuleState()
    bootstrapBundleWithState(modulePath, state)
}

fun bootstrapParseModuleWithState(
    modulePath: string,
    var state: BootstrapModuleState
): BootstrapParseResult {
    state.reused = 0
    state.refreshed = 0
    state.reusedParsed = 0
    state.refreshedParsed = 0
    val graph = BootstrapModuleGraph([], 0, state, [], [], "", [])
    graph.load(modulePath)
    graph.parse()
}

fun bootstrapParseModule(modulePath: string): BootstrapParseResult {
    val state = bootstrapModuleState()
    bootstrapParseModuleWithState(modulePath, state)
}
