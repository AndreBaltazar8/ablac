import "staged_parser.ab"
import "named_arguments.ab"
import "package.ab"
import "module_paths.ab"
import "abla/sys/linux/fs"
import "abla/sys/linux/process"

fun bootstrapFrontendTraceMemory(label: string): void {
    val configured = linuxEnvironment("ABLA_COMPILER_MEMORY_TRACE")
    if (configured.found && configured.value != "") {
        linuxWriteStandardError(
            "abla-frontend-memory $label ${runtimeMemoryLiveBytes()}\n"
        )
    }
}

/** A declaration's kind and name, as one key. */
fun bootstrapModuleDeclarationKey(declaration: BootstrapDeclaration): string =
    "${declaration.kind}\n${declaration.name}"

var bootstrapModuleIndexCheckValue: int = -1

fun bootstrapModuleIndexCheck(): bool {
    if (bootstrapModuleIndexCheckValue < 0) {
        val configured = linuxEnvironment("ABLA_MODULE_INDEX_CHECK")
        bootstrapModuleIndexCheckValue = if (configured.found && configured.value == "1") 1 else 0
    }
    bootstrapModuleIndexCheckValue == 1
}

fun bootstrapActionsRegisterSubparser(
    actions: array<BootstrapExpression>
): bool {
    var found = false
    var index = 0
    while (!found && index < actions.size) {
        var expression = actions[index]
        if (expression.kind == "compile" && expression.children.size == 1) {
            expression = expression.children[0]
        }
        found = expression.kind == "call" &&
            expression.text == "compilerRegisterSubparser"
        index = index + 1
    }
    found
}

fun bootstrapResolveImport(importer: string, requested: string): string {
    var result = Path(importer).parent().child(requested).text
    if (requested.size > 0 && requested[0] == 47) result = requested
    if (requested.size >= 5 && requested.slice(0, 5) == "abla/") {
        result = Path(bootstrapStandardLibraryRoot()).child(requested).child(
            "entry.ab"
        ).text
    }
    val package = bootstrapResolvePackageImport(importer, requested)
    if (package != "") result = package
    bootstrapCanonicalEscapingPath(bootstrapNormalizeModulePath(result))
}

class BootstrapImportEdge(
    val source: string,
    val provider: bool,
    val alias: string,
    val contractOnly: bool,
    val begin: int,
    val end: int,
    // `export import "…"`: in a strict module, its names are its importers' too.
    val exported: bool = false
)

/** Whether the `import` at `offset` is written `export import`. */
fun bootstrapImportExportedAt(source: string, offset: int): bool {
    var cursor = offset
    while (cursor > 0 && (source[cursor - 1] == 32 || source[cursor - 1] == 9)) {
        cursor = cursor - 1
    }
    cursor >= 6 && source.slice(cursor - 6, cursor) == "export" &&
        (cursor == 6 || !bootstrapIsAlphaNumeric(source[cursor - 7]))
}

class BootstrapImportScan(
    val edges: array<BootstrapImportEdge>,
    val errors: int,
    val diagnostics: string
)

fun bootstrapImportWordAt(source: string, offset: int, word: string): bool {
    var equal = offset + word.size <= source.size &&
        bootstrapRegionEquals(source, offset, offset + word.size, word)
    if (equal && offset > 0 && bootstrapIsAlphaNumeric(source[offset - 1])) {
        equal = false
    }
    if (equal && offset + word.size < source.size &&
        bootstrapIsAlphaNumeric(source[offset + word.size])) equal = false
    equal
}

fun bootstrapImportAliasValid(alias: string): bool {
    var valid = alias.size > 0 && bootstrapIsAlpha(alias[0])
    var index = 1
    while (valid && index < alias.size) {
        valid = bootstrapIsAlphaNumeric(alias[index])
        index = index + 1
    }
    if (valid && bootstrapKeyword(alias, 0, alias.size) != "identifier") {
        valid = false
    }
    if (alias == "as" || alias == "contract" || alias == "import") {
        valid = false
    }
    valid
}

fun bootstrapScanImports(source: string): BootstrapImportScan {
    val edges: array<BootstrapImportEdge> = []
    var errors = 0
    var diagnostics = ""
    var offset = 0
    var sourceQuoted = false
    var lineComment = false
    var blockComment = 0
    var braces = 0
    while (offset < source.size) {
        if (source[offset] == 10 || source[offset] == 13) lineComment = false
        if (!sourceQuoted && !lineComment && blockComment == 0 &&
            source[offset] == 47 &&
            offset + 1 < source.size && source[offset + 1] == 42) {
            blockComment = blockComment + 1
            offset = offset + 2
            continue
        }
        if (blockComment > 0) {
            if (offset + 1 < source.size && source[offset] == 42 &&
                source[offset + 1] == 47) {
                blockComment = blockComment - 1
                offset = offset + 2
            } else offset = offset + 1
            continue
        }
        if (!sourceQuoted && !lineComment && source[offset] == 47 &&
            offset + 1 < source.size && source[offset + 1] == 47) {
            lineComment = true
        }
        if (blockComment == 0 && !lineComment && source[offset] == 34 &&
            (offset == 0 || source[offset - 1] != 92)) {
            sourceQuoted = !sourceQuoted
        }
        if (!sourceQuoted && !lineComment && blockComment == 0) {
            if (source[offset] == 123) braces = braces + 1
            if (source[offset] == 125 && braces > 0) braces = braces - 1
        }
        if (!sourceQuoted && !lineComment && blockComment == 0 &&
            braces == 0 && bootstrapImportWordAt(source, offset, "import")) {
            val importBegin = offset
            var cursor = offset + 6
            while (cursor < source.size &&
                (source[cursor] == 32 || source[cursor] == 9)) {
                cursor = cursor + 1
            }
            var contractOnly = false
            if (bootstrapImportWordAt(source, cursor, "contract")) {
                contractOnly = true
                cursor = cursor + 8
                while (cursor < source.size &&
                    (source[cursor] == 32 || source[cursor] == 9)) {
                    cursor = cursor + 1
                }
            }
            val sourceBegin = cursor
            var sourceEnd = cursor
            var end = cursor
            var provider = true
            var alias = ""
            if (cursor < source.size && source[cursor] == 34) {
                provider = false
                cursor = cursor + 1
                val valueBegin = cursor
                while (cursor < source.size &&
                    (source[cursor] != 34 || source[cursor - 1] == 92)) {
                    cursor = cursor + 1
                }
                sourceEnd = cursor
                if (cursor < source.size) cursor = cursor + 1
                end = cursor
                val requested = source.slice(valueBegin, sourceEnd)
                while (cursor < source.size &&
                    (source[cursor] == 32 || source[cursor] == 9)) {
                    cursor = cursor + 1
                }
                if (bootstrapImportWordAt(source, cursor, "as")) {
                    cursor = cursor + 2
                    while (cursor < source.size &&
                        (source[cursor] == 32 || source[cursor] == 9)) {
                        cursor = cursor + 1
                    }
                    val aliasBegin = cursor
                    while (cursor < source.size &&
                        bootstrapIsAlphaNumeric(source[cursor])) {
                        cursor = cursor + 1
                    }
                    alias = source.slice(aliasBegin, cursor)
                    end = cursor
                }
                if (requested == "" ||
                    (alias != "" && !bootstrapImportAliasValid(alias))) {
                    errors = errors + 1
                    diagnostics =
                        "${diagnostics}error[E_IMPORT_ALIAS_INVALID]: import source and alias must be non-empty valid identifiers\nsource[import]:$importBegin:$end\n"
                } else edges.append(BootstrapImportEdge(
                    requested, provider, alias, contractOnly, importBegin, end,
                    bootstrapImportExportedAt(source, importBegin)
                ))
            } else {
                var depth = 0
                var quoted = false
                var aliasAt = -1
                while (cursor < source.size &&
                    !(!quoted && depth == 0 &&
                      (source[cursor] == 10 || source[cursor] == 13 ||
                       source[cursor] == 59))) {
                    if (source[cursor] == 34 &&
                        (cursor == sourceBegin || source[cursor - 1] != 92)) {
                        quoted = !quoted
                    }
                    if (!quoted && (source[cursor] == 40 ||
                        source[cursor] == 91)) depth = depth + 1
                    if (!quoted && (source[cursor] == 41 ||
                        source[cursor] == 93)) depth = depth - 1
                    if (!quoted && depth == 0 &&
                        bootstrapImportWordAt(source, cursor, "as")) {
                        aliasAt = cursor
                        sourceEnd = cursor
                    }
                    cursor = cursor + 1
                }
                end = cursor
                if (aliasAt >= 0) {
                    val rawAlias = bootstrapPackageTrim(source.slice(
                        aliasAt + 2, end
                    ))
                    alias = rawAlias
                } else sourceEnd = end
                val requested = bootstrapPackageTrim(source.slice(
                    sourceBegin, sourceEnd
                ))
                if (requested == "" ||
                    (alias != "" && !bootstrapImportAliasValid(alias))) {
                    errors = errors + 1
                    diagnostics =
                        "${diagnostics}error[E_IMPORT_ALIAS_INVALID]: import source and alias must be non-empty valid identifiers\nsource[import]:$importBegin:$end\n"
                } else edges.append(BootstrapImportEdge(
                    requested, provider, alias, contractOnly, importBegin, end,
                    bootstrapImportExportedAt(source, importBegin)
                ))
            }
            offset = end
        }
        offset = offset + 1
    }
    BootstrapImportScan(edges, errors, diagnostics)
}

/** A fingerprint of `edits`, folded into the cache identity of the modules
 *  parsed after them (their transforms may have read the edited declarations). */
fun bootstrapDeclarationEditFingerprint(edits: array<BootstrapDeclarationEdit>): int {
    var text = ""
    for (edit in edits) {
        text = "$text${edit.kind}\u{1F}${bootstrapEditTargetText(edit)}\u{1F}${edit.payload}\u{1E}"
    }
    bootstrapModuleFingerprint(text, 89, 283, 1000000007)
}

fun bootstrapModuleFingerprint(
    source: string,
    seed: int,
    factor: int,
    modulus: int
): int {
    var hash = seed
    var index = 0
    while (index < source.size) {
        hash = hash * factor + source[index] + 1
        hash = hash - (hash / modulus) * modulus
        index = index + 1
    }
    hash
}

fun bootstrapModuleExpressionIdentity(
    expression: BootstrapExpression
): string {
    var identity = "${expression.kind}:${expression.text}("
    var child = 0
    while (child < expression.children.size) {
        identity = "$identity${bootstrapModuleExpressionIdentity(
            expression.children[child]
        )},"
        child = child + 1
    }
    "$identity)"
}

fun bootstrapModuleInterfaceIdentity(
    parsed: BootstrapParseResult,
    implementationFirst: int,
    implementationSecond: int
): string {
    var identity = ""
    var implementationSensitive = false
    var declaration = 0
    while (declaration < parsed.declarations.size) {
        val found = parsed.declarations[declaration]
        var interfaceKind = found.kind
        if (interfaceKind == "extern" && found.externalLibrary.size >= 9 &&
            found.externalLibrary.slice(0, 9) == "contract:") {
            interfaceKind = "fun"
        }
        identity = "$identity$interfaceKind:${found.name}:${found.extensionOwner}:${found.resultType}:${found.isResource}:${found.isTrusted}:${found.isNoEscape}|"
        if (found.isSealed) identity = "$identity:sealed"
        var conformance = 0
        while (conformance < found.conformances.size) {
            identity = "$identity:${found.conformances[conformance]},"
            conformance = conformance + 1
        }
        var annotation = 0
        while (annotation < found.annotations.size) {
            identity = "$identity@${found.annotations[annotation]},"
            if (annotation < found.annotationArguments.size &&
                found.annotationArguments[annotation].kind != "missing") {
                identity = "$identity(${bootstrapModuleExpressionIdentity(
                    found.annotationArguments[annotation]
                )})"
            }
            annotation = annotation + 1
        }
        var parameter = 0
        while (parameter < found.parameters.size) {
            var type = "unknown"
            var kind = "parameter"
            if (parameter < found.parameterTypes.size) {
                type = found.parameterTypes[parameter]
            }
            if (parameter < found.parameterKinds.size) {
                kind = found.parameterKinds[parameter]
            }
            identity = "$identity${found.parameters[parameter]}:$kind:$type,"
            if (parameter < found.parameterDefaults.size &&
                found.parameterDefaults[parameter].kind != "missing") {
                identity = "$identity=${bootstrapModuleExpressionIdentity(
                    found.parameterDefaults[parameter]
                )}"
            }
            parameter = parameter + 1
        }
        var method = 0
        while (method < found.methods.size) {
            val member = found.methods[method]
            identity = "$identity method:${member.name}:${member.resultType}("
            annotation = 0
            while (annotation < member.annotations.size) {
                identity = "$identity@${member.annotations[annotation]},"
                if (annotation < member.annotationArguments.size &&
                    member.annotationArguments[annotation].kind != "missing") {
                    identity =
                        "$identity(${bootstrapModuleExpressionIdentity(
                            member.annotationArguments[annotation]
                        )})"
                }
                annotation = annotation + 1
            }
            parameter = 0
            while (parameter < member.parameters.size) {
                var type = "unknown"
                var kind = "parameter"
                if (parameter < member.parameterTypes.size) {
                    type = member.parameterTypes[parameter]
                }
                if (parameter < member.parameterKinds.size) {
                    kind = member.parameterKinds[parameter]
                }
                identity = "$identity$kind:$type,"
                if (parameter < member.parameterDefaults.size &&
                    member.parameterDefaults[parameter].kind != "missing") {
                    identity =
                        "$identity=${bootstrapModuleExpressionIdentity(
                            member.parameterDefaults[parameter]
                        )}"
                }
                parameter = parameter + 1
            }
            identity = "$identity)"
            method = method + 1
        }
        if (found.kind == "compile.fun" || found.kind == "compile.val" ||
            found.kind == "compile.var") implementationSensitive = true
        declaration = declaration + 1
    }
    var action = 0
    while (action < parsed.actions.size) {
        var expression = parsed.actions[action]
        if (expression.kind == "compile" && expression.children.size == 1) {
            expression = expression.children[0]
        }
        val grant = expression.kind == "call" &&
            expression.text == "compilerGrant"
        val authorization = expression.kind ==
            "compile.capability.authorization"
        if (!grant && !authorization) implementationSensitive = true
        action = action + 1
    }
    if (implementationSensitive) {
        identity = "$identity implementation:$implementationFirst:$implementationSecond"
    }
    identity
}

// Import discovery needs declaration interfaces, compile-time definitions,
// defaults, annotations, and class member signatures. It does not need to
// retain ordinary runtime function bodies: staged parsing reads each module
// again with the complete visible declaration set before semantic analysis.
// Keeping those bodies in every module snapshot duplicates the dominant AST
// payload for large source-only frameworks such as abla-embedded.
fun bootstrapModuleDiscoveryDeclaration(
    declaration: BootstrapDeclaration
): BootstrapDeclaration {
    val methods: array<BootstrapDeclaration> = []
    var method = 0
    while (method < declaration.methods.size) {
        methods.append(bootstrapModuleDiscoveryDeclaration(
            declaration.methods[method]
        ))
        method = method + 1
    }
    val expression = if (declaration.kind == "fun")
        BootstrapExpression(
            "missing", "", declaration.begin, declaration.begin, []
        )
    else declaration.expression
    return BootstrapDeclaration(
        declaration.kind,
        declaration.name,
        declaration.begin,
        declaration.end,
        expression,
        declaration.parameters,
        declaration.parameterTypes,
        declaration.resultType,
        methods,
        declaration.parameterDefaults,
        declaration.externalLibrary,
        declaration.parameterKinds,
        declaration.extensionOwner,
        declaration.isTrusted,
        declaration.isResource,
        declaration.isNoEscape,
        declaration.generatedNamespace,
        declaration.generatedOriginBegin,
        declaration.generatedOriginEnd,
        declaration.annotations,
        declaration.annotationArguments,
        declaration.annotationBegins,
        declaration.annotationEnds,
        declaration.sourceIdentity,
        declaration.conformances,
        declaration.isSealed,
        declaration.isPrivate,
        declaration.typeParameters
    )
}

fun bootstrapModuleDiscovery(
    source: string,
    sourceIdentity: string
): BootstrapParseResult {
    val parsed = bootstrapParseWithIdentity(source, sourceIdentity)
    val declarations: array<BootstrapDeclaration> = []
    var declaration = 0
    while (declaration < parsed.declarations.size) {
        declarations.append(bootstrapModuleDiscoveryDeclaration(
            parsed.declarations[declaration]
        ))
        declaration = declaration + 1
    }
    return BootstrapParseResult(
        declarations,
        parsed.actions,
        parsed.errors,
        parsed.extensionErrors,
        parsed.compileInputPaths,
        parsed.compileInputContents,
        parsed.diagnostics
    )
}

// A snapshot is the reusable, module-local part of graph loading. Keeping the
// source and import scan together is important: publishing a new source with
// stale dependency edges would make incremental invalidation unsound.
class BootstrapModuleSnapshot(
    val path: string,
    val source: string,
    val importEdges: array<BootstrapImportEdge>,
    val importErrors: int,
    val exists: bool,
    val size: int,
    val revision: int,
    val firstFingerprint: int,
    val secondFingerprint: int,
    val discovery: BootstrapParseResult
)

class BootstrapModuleFrontendSnapshot(
    val path: string,
    val firstFingerprint: int,
    val secondFingerprint: int,
    val dependencyFingerprint: int,
    val parsed: BootstrapParseResult
)

// Compile inputs use provider-qualified identities. Filesystem paths retain
// their lexical spelling; deterministic ambient providers use a reserved
// identity that can be re-observed without persisting the input's value.
fun bootstrapCompileInputContents(identity: string): string {
    val environmentPrefix = "abla-input:environment:"
    var contents = ""
    if (identity.size >= environmentPrefix.size &&
        identity.slice(0, environmentPrefix.size) == environmentPrefix) {
        val observed = linuxEnvironment(identity.slice(
            environmentPrefix.size,
            identity.size
        ))
        if (observed.found) contents = observed.value
    } else if (ctNativeHostInputPrefix(identity) != "") {
        contents = ctNativeHostInputContents(identity)
    } else contents = Path(identity).readText()
    contents
}

fun bootstrapCompileInputsCurrent(parsed: BootstrapParseResult): bool {
    var current = parsed.compileInputPaths.size ==
        parsed.compileInputContents.size
    var input = 0
    while (current && input < parsed.compileInputPaths.size) {
        current = bootstrapCompileInputContents(
            parsed.compileInputPaths[input]
        ) == parsed.compileInputContents[input]
        input = input + 1
    }
    current
}

fun bootstrapParseRequestsCompileCapability(
    parsed: BootstrapParseResult,
    capability: string
): bool {
    var requested = false
    var action = 0
    while (action < parsed.actions.size) {
        var expression = parsed.actions[action]
        if (expression.kind == "compile" && expression.children.size == 1) {
            expression = expression.children[0]
        }
        if (expression.kind == "call" &&
            expression.text == "compilerGrant" &&
            expression.children.size == 1 &&
            expression.children[0].kind == "string" &&
            expression.children[0].text == capability) requested = true
        action = action + 1
    }
    requested
}

// Long-lived commands retain one state object across compilations. A normal
// one-shot build creates a fresh state, while `serve` reuses it and therefore
// rereads and rescans only files whose stat identity changed.
class BootstrapModuleState(
    val snapshots: array<BootstrapModuleSnapshot>,
    val frontends: array<BootstrapModuleFrontendSnapshot>,
    var reused: int,
    var refreshed: int,
    var reusedParsed: int,
    var refreshedParsed: int,
    var build: int,
    val acquiredIn: Map<string, int>,
    // Each snapshot's place in `snapshots`, by module path: a graph acquires a
    // module once per import edge that reaches it.
    val snapshotIndex: Map<string, int> = Map()
) {
    fun beginBuild(): void {
        this.beginCounting()
        bootstrapSemanticUnit()
    }

    // A build counts each module once: the first acquisition stats the file
    // and later ones in the same build (an import's ambiguity check, then its
    // load) return that snapshot, so one build reads one version of a file.
    fun beginCounting(): void {
        this.reused = 0
        this.refreshed = 0
        this.reusedParsed = 0
        this.refreshedParsed = 0
        this.build = this.build + 1
        return
    }

    fun indexOf(modulePath: string): int {
        val found = this.snapshotIndex.get(modulePath)
        if (found != null) found else -1
    }

    fun acquire(modulePath: string): BootstrapModuleSnapshot {
        val existing = this.indexOf(modulePath)
        val acquiredIn = this.acquiredIn.get(modulePath)
        if (existing >= 0 && acquiredIn != null && acquiredIn == this.build) {
            return this.snapshots[existing]
        }
        this.acquiredIn.set(modulePath, this.build)
        val info = Path(modulePath).info()
        var reusable = false
        if (existing >= 0) {
            val snapshot = this.snapshots[existing]
            reusable = snapshot.exists == info.exists() &&
                snapshot.size == info.size &&
                snapshot.revision == info.revision
        }
        var result = BootstrapModuleSnapshot(
            modulePath,
            "",
            [],
            0,
            false,
            -1,
            0,
            0,
            0,
            BootstrapParseResult([], [], 0, 0, [], [], "")
        )
        if (reusable) {
            result = this.snapshots[existing]
            this.reused = this.reused + 1
        } else {
            val source = Path(modulePath).readText()
            val scan = bootstrapScanImports(source)
            result = BootstrapModuleSnapshot(
                modulePath,
                source,
                scan.edges,
                scan.errors,
                info.exists(),
                info.size,
                info.revision,
                bootstrapModuleFingerprint(
                    source, 17, 257, 1000000007
                ),
                bootstrapModuleFingerprint(
                    source, 97, 263, 1000000009
                ),
                bootstrapModuleDiscovery(source, modulePath)
            )
            if (existing >= 0) {
                this.snapshots[existing] = result
                0
            } else {
                this.snapshotIndex.set(modulePath, this.snapshots.size)
                this.snapshots.append(result)
                0
            }
            this.refreshed = this.refreshed + 1
        }
        result
    }

    fun frontendIndex(
        snapshot: BootstrapModuleSnapshot,
        dependencyFingerprint: int
    ): int {
        var result = -1
        var index = 0
        while (index < this.frontends.size && result < 0) {
            val frontend = this.frontends[index]
            if (frontend.path == snapshot.path &&
                frontend.firstFingerprint == snapshot.firstFingerprint &&
                frontend.secondFingerprint == snapshot.secondFingerprint &&
                frontend.dependencyFingerprint == dependencyFingerprint) {
                result = index
            }
            index = index + 1
        }
        result
    }

    fun frontendPathIndex(modulePath: string): int {
        var result = -1
        var index = 0
        while (index < this.frontends.size && result < 0) {
            if (this.frontends[index].path == modulePath) result = index
            index = index + 1
        }
        result
    }

    fun acquireParsed(
        snapshot: BootstrapModuleSnapshot,
        dependencyFingerprint: int,
        declarations: array<BootstrapDeclaration>,
        currentDeclarationBegin: int,
        currentDeclarationCount: int,
        registry: BootstrapSubparserRegistry,
        allowedCompileEffects: int
    ): BootstrapParseResult {
        var existing = this.frontendIndex(
            snapshot,
            dependencyFingerprint
        )
        if (existing >= 0 && !bootstrapCompileInputsCurrent(
            this.frontends[existing].parsed
        )) existing = -1
        var result = BootstrapParseResult([], [], 0, 0, [], [], "")
        if (existing >= 0) {
            result = this.frontends[existing].parsed
            this.reusedParsed = this.reusedParsed + 1
        } else {
            result = bootstrapParseStagedRegistered(
                snapshot.source,
                snapshot.path,
                declarations,
                currentDeclarationBegin,
                currentDeclarationCount,
                registry,
                allowedCompileEffects
            )
            val replacement = BootstrapModuleFrontendSnapshot(
                snapshot.path,
                snapshot.firstFingerprint,
                snapshot.secondFingerprint,
                dependencyFingerprint,
                result
            )
            val samePath = this.frontendPathIndex(snapshot.path)
            if (samePath >= 0) {
                this.frontends[samePath] = replacement
                0
            } else {
                this.frontends.append(replacement)
                0
            }
            this.refreshedParsed = this.refreshedParsed + 1
        }
        result
    }
}

class BootstrapImportProviderDiscovery(
    val state: BootstrapModuleState,
    val ordered: array<BootstrapModuleSnapshot>,
    val paths: array<string>,
    var errors: int,
    var diagnostics: string
) {
    fun contains(path: string): bool {
        var found = false
        var index = 0
        while (index < this.paths.size) {
            if (this.paths[index] == path) found = true
            index = index + 1
        }
        found
    }

    fun collect(modulePath: string): void {
        val identity = bootstrapNormalizeModulePath(modulePath)
        if (!this.contains(identity)) {
            this.paths.append(identity)
            val snapshot = this.state.acquire(identity)
            this.errors = this.errors + snapshot.importErrors
            this.diagnostics =
                "${this.diagnostics}${bootstrapScanImports(snapshot.source).diagnostics}"
            var index = 0
            while (index < snapshot.importEdges.size) {
                val edge = snapshot.importEdges[index]
                if (!edge.provider) this.collect(bootstrapResolveImport(
                    identity, edge.source
                ))
                index = index + 1
            }
            this.ordered.append(snapshot)
        }
    }
}

fun bootstrapEvaluateImportProvider(
    expression: string,
    ordered: array<BootstrapModuleSnapshot>,
    current: BootstrapParseResult,
    resolve: bool = false,
    resolveEffects: int = 0
): BootstrapImportProviderResult {
    val declarations: array<BootstrapDeclaration> = []
    var moduleIndex = 0
    while (moduleIndex < ordered.size) {
        var declaration = 0
        while (declaration < ordered[moduleIndex].discovery.declarations.size) {
            declarations.append(
                ordered[moduleIndex].discovery.declarations[declaration]
            )
            declaration = declaration + 1
        }
        moduleIndex = moduleIndex + 1
    }
    var declaration = 0
    while (declaration < current.declarations.size) {
        declarations.append(current.declarations[declaration])
        declaration = declaration + 1
    }
    var requestedExpression = expression
    if (resolve) requestedExpression =
        "__ablaResolveImportSource($expression)"
    val parsed = bootstrapParse("#$requestedExpression")
    var errors = parsed.errors
    var diagnostic = ""
    var dependency = BootstrapPackageDependency(
        "", "", "", "", "", "", "", "", []
    )
    if (errors == 0 && parsed.actions.size == 1) {
        // Bit 1024 is private authority to invoke a deferred ImportSource
        // resolver; ordinary compile-time evaluation never receives it.
        val allowedEffects = if (resolve) resolveEffects + 1024 else 0
        val evaluated = bootstrapEvaluateWithEffects(
            parsed.actions[0], declarations, allowedEffects
        )
        errors = errors + evaluated.errors
        diagnostic = evaluated.diagnostics
        if (resolve && evaluated.errors > 0) {
            diagnostic = "${diagnostic}error[E_IMPORT_PROVIDER_EFFECT_DENIED]: deferred resolver failed; authorize any required effects in the root manifest compileCapabilities\n"
        }
        if (evaluated.value.kind == "object" &&
            evaluated.value.owner == "ImportSource") {
            val decoded = bootstrapPackageDependencyFromValue(
                evaluated.value, resolve
            )
            dependency = decoded.dependency
            errors = errors + decoded.errors
            diagnostic = "$diagnostic${decoded.diagnostic}"
        } else {
            errors = errors + 1
            diagnostic = "${diagnostic}error[E_IMPORT_PROVIDER_RESULT]: import provider '$expression' must return ImportSource\n"
        }
    } else {
        errors = errors + 1
        diagnostic = "error[E_IMPORT_PROVIDER_PARSE]: invalid import provider expression '$expression'\n"
    }
    BootstrapImportProviderResult(dependency, errors, diagnostic)
}

fun bootstrapDiscoverImportProviders(
    entry: string,
    resolve: bool = false,
    resolveEffects: int = 0
): BootstrapPackageDependencies {
    val discovery = BootstrapImportProviderDiscovery(
        bootstrapModuleState(), [], [], 0, ""
    )
    discovery.collect(entry)
    val dependencies: array<BootstrapPackageDependency> = []
    var moduleIndex = 0
    while (moduleIndex < discovery.ordered.size) {
        val snapshot = discovery.ordered[moduleIndex]
        var edgeIndex = 0
        while (edgeIndex < snapshot.importEdges.size) {
            val edge = snapshot.importEdges[edgeIndex]
            if (edge.provider) {
                val provider = bootstrapEvaluateImportProvider(
                    edge.source, discovery.ordered,
                    BootstrapParseResult([], [], 0, 0, [], [], ""),
                    resolve, resolveEffects
                )
                discovery.errors = discovery.errors + provider.errors
                discovery.diagnostics =
                    "${discovery.diagnostics}${provider.diagnostic}"
                val existing = bootstrapPackageDependencyIndex(
                    dependencies, provider.dependency.name
                )
                if (provider.errors == 0 && existing < 0) {
                    dependencies.append(provider.dependency)
                }
                if (provider.errors == 0 && existing >= 0 &&
                    (dependencies[existing].source !=
                        provider.dependency.source ||
                     dependencies[existing].selectorKind !=
                        provider.dependency.selectorKind ||
                     dependencies[existing].selector !=
                        provider.dependency.selector)) {
                    discovery.errors = discovery.errors + 1
                    discovery.diagnostics = "${discovery.diagnostics}error[E_PACKAGE_COLLISION]: import providers request incompatible sources or selectors for dependency '${provider.dependency.name}'\n"
                }
            }
            edgeIndex = edgeIndex + 1
        }
        moduleIndex = moduleIndex + 1
    }
    BootstrapPackageDependencies(
        dependencies, discovery.errors, discovery.diagnostics
    )
}

fun bootstrapModuleState(): BootstrapModuleState =
    BootstrapModuleState([], [], 0, 0, 0, 0, 0, Map())

fun bootstrapManifestCompileCapabilities(
    modulePath: string
): array<string> {
    val capabilities: array<string> = []
    var manifestPath = Path(modulePath).parent().child("abla.toml")
    var directory = Path(modulePath).parent()
    var searching = !manifestPath.exists()
    var depth = 0
    while (searching && depth < 128) {
        val parent = directory.parent()
        if (parent.text == directory.text) searching = false
        directory = parent
        val candidate = directory.child("abla.toml")
        if (candidate.exists()) {
            manifestPath = candidate
            searching = false
        }
        depth = depth + 1
    }
    val source = manifestPath.readText()
    var lineBegin = 0
    var arrayCursor = -1
    while (lineBegin < source.size && arrayCursor < 0) {
        var lineEnd = lineBegin
        while (lineEnd < source.size && source[lineEnd] != 10 &&
               source[lineEnd] != 13) lineEnd = lineEnd + 1
        var contentEnd = lineEnd
        var comment = lineBegin
        while (comment < contentEnd && source[comment] != 35) {
            comment = comment + 1
        }
        if (comment < contentEnd) contentEnd = comment
        var equals = lineBegin
        while (equals < contentEnd && source[equals] != 61) {
            equals = equals + 1
        }
        var keyBegin = lineBegin
        while (keyBegin < equals &&
               (source[keyBegin] == 32 || source[keyBegin] == 9)) {
            keyBegin = keyBegin + 1
        }
        var keyEnd = equals
        while (keyEnd > keyBegin &&
               (source[keyEnd - 1] == 32 || source[keyEnd - 1] == 9)) {
            keyEnd = keyEnd - 1
        }
        if (equals < contentEnd &&
            source.slice(keyBegin, keyEnd) == "compileCapabilities") {
            var index = equals + 1
            while (index < contentEnd &&
                   (source[index] == 32 || source[index] == 9)) {
                index = index + 1
            }
            if (index < contentEnd && source[index] == 91) {
                arrayCursor = index + 1
            }
        }
        lineBegin = lineEnd + 1
        if (lineBegin < source.size && source[lineBegin - 1] == 13 &&
            source[lineBegin] == 10) lineBegin = lineBegin + 1
    }
    var complete = false
    while (arrayCursor >= 0 && arrayCursor < source.size && !complete) {
        while (arrayCursor < source.size &&
               (source[arrayCursor] == 32 || source[arrayCursor] == 9 ||
                source[arrayCursor] == 10 || source[arrayCursor] == 13 ||
                source[arrayCursor] == 44)) arrayCursor = arrayCursor + 1
        if (arrayCursor < source.size && source[arrayCursor] == 35) {
            while (arrayCursor < source.size &&
                   source[arrayCursor] != 10 && source[arrayCursor] != 13) {
                arrayCursor = arrayCursor + 1
            }
        } else if (arrayCursor < source.size && source[arrayCursor] == 93) {
            complete = true
        } else if (arrayCursor < source.size && source[arrayCursor] == 34) {
            val begin = arrayCursor + 1
            arrayCursor = begin
            while (arrayCursor < source.size &&
                   source[arrayCursor] != 34 &&
                   source[arrayCursor] != 10 &&
                   source[arrayCursor] != 13) {
                arrayCursor = arrayCursor + 1
            }
            if (arrayCursor < source.size && source[arrayCursor] == 34) {
                val capability = source.slice(begin, arrayCursor)
                if (capabilities.size < 64 &&
                    bootstrapCompileEffectFromName(capability) != 0 &&
                    !bootstrapAffineNamesContain(
                        capabilities,
                        capability
                    )) capabilities.append(capability)
                arrayCursor = arrayCursor + 1
            } else complete = true
        } else complete = true
    }
    capabilities
}

// The bootstrap package reader intentionally accepts a small deterministic
// TOML subset. String fields provide root/package identity and entry selection;
// import providers and lock records use the bounded package scanner.
fun bootstrapTomlStringField(manifestPath: string, key: string): string {
    val source = Path(manifestPath).readText()
    var result = ""
    var lineBegin = 0
    while (lineBegin < source.size && result == "") {
        var lineEnd = lineBegin
        while (lineEnd < source.size && source[lineEnd] != 10 &&
               source[lineEnd] != 13) lineEnd = lineEnd + 1
        var equals = lineBegin
        while (equals < lineEnd && source[equals] != 61) equals = equals + 1
        var keyBegin = lineBegin
        while (keyBegin < equals &&
               (source[keyBegin] == 32 || source[keyBegin] == 9)) {
            keyBegin = keyBegin + 1
        }
        var keyEnd = equals
        while (keyEnd > keyBegin &&
               (source[keyEnd - 1] == 32 || source[keyEnd - 1] == 9)) {
            keyEnd = keyEnd - 1
        }
        if (equals < lineEnd &&
            source.slice(keyBegin, keyEnd) == key) {
            var valueBegin = equals + 1
            while (valueBegin < lineEnd &&
                   (source[valueBegin] == 32 || source[valueBegin] == 9)) {
                valueBegin = valueBegin + 1
            }
            if (valueBegin < lineEnd && source[valueBegin] == 34) {
                val begin = valueBegin + 1
                var end = begin
                while (end < lineEnd && source[end] != 34) end = end + 1
                if (end < lineEnd) result = source.slice(begin, end)
            }
        }
        lineBegin = lineEnd + 1
        if (lineBegin < source.size && source[lineBegin - 1] == 13 &&
            source[lineBegin] == 10) lineBegin = lineBegin + 1
    }
    result
}

class BootstrapProjectDescriptor(
    val root: string,
    val name: string,
    val version: string,
    val entry: string,
    val output: string,
    val valid: bool,
    val diagnostic: string
)

fun bootstrapProjectDescriptor(root: string): BootstrapProjectDescriptor {
    val projectRoot = Path(root)
    val manifest = projectRoot.child("abla.toml")
    var name = bootstrapTomlStringField(manifest.text, "name")
    val version = bootstrapTomlStringField(manifest.text, "version")
    var relativeEntry = bootstrapTomlStringField(manifest.text, "entry")
    if (name == "") name = "abla-out"
    if (relativeEntry == "") relativeEntry = "src/main.ab"
    val entry = projectRoot.child(relativeEntry)
    var valid = manifest.exists()
    var diagnostic = ""
    if (!valid) diagnostic = "missing package manifest: ${manifest.text}"
    if (valid && !bootstrapPackageNameValid(name)) {
        valid = false
        diagnostic = "invalid package name '$name'"
    }
    if (valid && !bootstrapPackageRelativePathValid(relativeEntry)) {
        valid = false
        diagnostic = "package entry must be a safe relative path"
    }
    if (valid && !entry.exists()) {
        valid = false
        diagnostic = "package entry does not exist: ${entry.text}"
    }
    BootstrapProjectDescriptor(
        projectRoot.text,
        name,
        version,
        entry.text,
        projectRoot.child("build").child(name).text,
        valid,
        diagnostic
    )
}

class BootstrapModule(
    val path: string,
    val source: string
)

class BootstrapModuleAlias(
    val importer: string,
    val target: string,
    val alias: string,
    val contractOnly: bool,
    val begin: int,
    val end: int,
    val exported: bool = false,
    // The import as written (`abla/fs` resolves to another module).
    val written: string = ""
)

// What a graph's import edges say about each module, looked up instead of
// scanning every edge per module: the modules imported under an alias
// somewhere (their names carry the module prefix) or only for their contract,
// each importer's edges in order (`firstEdge`, then `nextEdge`), and the place
// of each module in the snapshots.
class BootstrapAliasSummary(
    val aliasedTargets: Map<string, int>,
    val contractTargets: Map<string, int>,
    val importers: Map<string, int>,
    val firstEdge: array<int>,
    val lastEdge: array<int>,
    val nextEdge: array<int>,
    val snapshotIndex: Map<string, int>
) {
    fun targetPrefix(target: string): string =
        if (this.aliasedTargets.get(target) != null)
            bootstrapModuleCanonicalPrefix(target) else ""

    fun isContractTarget(target: string): bool =
        this.contractTargets.get(target) != null

    /** The first of `importer`'s edges, or -1; nextEdge gives the next. */
    fun firstEdgeOf(importer: string): int {
        val slot = this.importers.get(importer)
        if (slot != null) this.firstEdge[slot] else -1
    }
}

fun bootstrapAliasSummary(
    aliases: array<BootstrapModuleAlias>,
    snapshots: array<BootstrapModuleSnapshot>
): BootstrapAliasSummary {
    val summary = BootstrapAliasSummary(Map(), Map(), Map(), [], [], [], Map())
    var index = 0
    while (index < aliases.size) {
        val alias = aliases[index]
        if (alias.alias != "") summary.aliasedTargets.set(alias.target, 1)
        if (alias.contractOnly) summary.contractTargets.set(alias.target, 1)
        var slot = summary.firstEdge.size
        val known = summary.importers.get(alias.importer)
        if (known != null) {
            slot = known
            summary.nextEdge[summary.lastEdge[slot]] = index
        } else {
            summary.importers.set(alias.importer, slot)
            summary.firstEdge.append(index)
            summary.lastEdge.append(index)
        }
        summary.lastEdge[slot] = index
        summary.nextEdge.append(-1)
        index = index + 1
    }
    index = 0
    while (index < snapshots.size) {
        summary.snapshotIndex.set(snapshots[index].path, index)
        index = index + 1
    }
    summary
}

fun bootstrapContractDeclaration(
    declaration: BootstrapDeclaration,
    moduleIdentity: string
): BootstrapDeclaration {
    val annotations: array<string> = []
    var annotation = 0
    while (annotation < declaration.annotations.size) {
        annotations.append(declaration.annotations[annotation])
        annotation = annotation + 1
    }
    val kind = if (declaration.kind == "fun") "extern" else declaration.kind
    val externalLibrary = if (declaration.kind == "fun") {
        "contract:$moduleIdentity"
    } else declaration.externalLibrary
    BootstrapDeclaration(
        kind,
        declaration.name,
        declaration.begin,
        declaration.end,
        BootstrapExpression(
            "missing", "contract", declaration.begin, declaration.end, []
        ),
        declaration.parameters,
        declaration.parameterTypes,
        declaration.resultType,
        [],
        declaration.parameterDefaults,
        externalLibrary,
        declaration.parameterKinds,
        declaration.extensionOwner,
        declaration.isTrusted,
        declaration.isResource,
        declaration.isNoEscape,
        declaration.generatedNamespace,
        declaration.generatedOriginBegin,
        declaration.generatedOriginEnd,
        annotations,
        declaration.annotationArguments,
        declaration.annotationBegins,
        declaration.annotationEnds,
        declaration.sourceIdentity,
        declaration.conformances,
        declaration.isSealed,
        declaration.isPrivate,
        declaration.typeParameters
    )
}

fun bootstrapProjectContract(
    parsed: BootstrapParseResult,
    moduleIdentity: string
): BootstrapParseResult {
    val declarations: array<BootstrapDeclaration> = []
    var index = 0
    while (index < parsed.declarations.size) {
        val declaration = parsed.declarations[index]
        if (declaration.kind == "fun" || declaration.kind == "class" ||
            declaration.kind == "interface" || declaration.kind == "extend") {
            declarations.append(bootstrapContractDeclaration(
                declaration, moduleIdentity
            ))
        }
        index = index + 1
    }
    BootstrapParseResult(
        declarations,
        [],
        parsed.errors,
        parsed.extensionErrors,
        [],
        [],
        parsed.diagnostics
    )
}

fun bootstrapContractTypeMentions(typeName: string, name: string): bool {
    var found = false
    var offset = 0
    while (!found && offset + name.size <= typeName.size) {
        val before = offset == 0 ||
            !bootstrapIsAlphaNumeric(typeName[offset - 1])
        val afterOffset = offset + name.size
        val after = afterOffset == typeName.size ||
            !bootstrapIsAlphaNumeric(typeName[afterOffset])
        if (before && after && bootstrapRegionEquals(
            typeName, offset, afterOffset, name
        )) found = true
        offset = offset + 1
    }
    found
}

fun bootstrapContractShapeMentions(
    parsed: BootstrapParseResult,
    name: string
): bool {
    var found = false
    var declaration = 0
    while (!found && declaration < parsed.declarations.size) {
        val current = parsed.declarations[declaration]
        if (bootstrapContractTypeMentions(current.resultType, name)) {
            found = true
        }
        var parameter = 0
        while (!found && parameter < current.parameterTypes.size) {
            found = bootstrapContractTypeMentions(
                current.parameterTypes[parameter], name
            )
            parameter = parameter + 1
        }
        var method = 0
        while (!found && method < current.methods.size) {
            val member = current.methods[method]
            if (bootstrapContractTypeMentions(member.resultType, name)) {
                found = true
            }
            parameter = 0
            while (!found && parameter < member.parameterTypes.size) {
                found = bootstrapContractTypeMentions(
                    member.parameterTypes[parameter], name
                )
                parameter = parameter + 1
            }
            method = method + 1
        }
        declaration = declaration + 1
    }
    found
}

fun bootstrapContractImportRequired(
    parsed: BootstrapParseResult,
    edge: BootstrapImportEdge,
    imported: BootstrapParseResult
): bool {
    var required = edge.alias != "" &&
        bootstrapContractShapeMentions(parsed, edge.alias)
    var declaration = 0
    while (!required && edge.alias == "" &&
           declaration < imported.declarations.size) {
        val candidate = imported.declarations[declaration]
        if ((candidate.kind == "class" || candidate.kind == "interface") &&
            bootstrapContractShapeMentions(parsed, candidate.name)) {
            required = true
        }
        declaration = declaration + 1
    }
    required
}

fun bootstrapExpressionDeclaresAliasBefore(
    expression: BootstrapExpression,
    alias: string,
    position: int
): bool {
    var found = (expression.kind == "local.val" ||
        expression.kind == "local.var") &&
        expression.text == alias && expression.begin <= position
    var child = 0
    while (child < expression.children.size && !found) {
        found = bootstrapExpressionDeclaresAliasBefore(
            expression.children[child], alias, position
        )
        child = child + 1
    }
    found
}

fun bootstrapAliasShadowedAt(
    parsed: BootstrapParseResult,
    alias: string,
    position: int
): bool {
    var shadowed = false
    var declaration = 0
    while (declaration < parsed.declarations.size && !shadowed) {
        val found = parsed.declarations[declaration]
        if (position >= found.begin && position <= found.end) {
            var parameter = 0
            while (parameter < found.parameters.size && !shadowed) {
                if (found.parameters[parameter] == alias) shadowed = true
                parameter = parameter + 1
            }
            if (!shadowed) shadowed = bootstrapExpressionDeclaresAliasBefore(
                found.expression, alias, position
            )
        }
        declaration = declaration + 1
    }
    shadowed
}

// A module's top-level declaration shadows a same-named declaration of a
// module it imports, directly or through others: it carries its module prefix
// in the module and in the modules that import it plainly, so the two are not
// duplicates. A same-named function with other parameters is an overload, not
// a shadow. A runtime platform module's own names (the C externs `malloc`,
// `write`, `pthread_*`) are private the same way, so a program may declare
// them. Two modules that both declare a name and neither imports the other
// stay a duplicate.
class BootstrapModuleShadow(
    val module: string,
    val names: array<string>
)

fun bootstrapModuleShadowIndex(
    shadows: array<BootstrapModuleShadow>,
    module: string
): int {
    var result = -1
    var index = 0
    while (index < shadows.size && result < 0) {
        if (shadows[index].module == module) result = index
        index = index + 1
    }
    result
}

fun bootstrapRuntimePlatformModule(path: string): bool {
    val platform = Path(bootstrapStandardLibraryRoot()).child(
        "abla/runtime/platform"
    )
    path == bootstrapNormalizeModulePath(platform.child("host.ab").text) ||
        path == bootstrapNormalizeModulePath(platform.child("wasm.ab").text)
}

fun bootstrapModuleShadowable(declaration: BootstrapDeclaration): bool =
    declaration.name != "" && declaration.extensionOwner == "" &&
    (declaration.kind == "fun" || declaration.kind == "extern" ||
     declaration.kind == "compile.fun" || declaration.kind == "class" ||
     declaration.kind == "interface" || declaration.kind == "type" ||
     bootstrapDeclarationIsValue(declaration.kind))

fun bootstrapModuleDeclares(
    discovery: BootstrapParseResult,
    name: string
): bool {
    var found = false
    var declaration = 0
    while (declaration < discovery.declarations.size && !found) {
        if (discovery.declarations[declaration].extensionOwner == "" &&
            discovery.declarations[declaration].kind != "extend" &&
            discovery.declarations[declaration].name == name) found = true
        declaration = declaration + 1
    }
    found
}

// Whether module `from` imports module `to`, directly or through others.
fun bootstrapModuleReaches(
    from: int,
    to: int,
    edgeImporters: array<int>,
    edgeTargets: array<int>,
    moduleCount: int
): bool {
    val visited = filledArray(moduleCount, false)
    val pending: array<int> = [from]
    visited[from] = true
    var found = false
    while (pending.size > 0 && !found) {
        val module = pending[pending.size - 1]
        pending.truncate(pending.size - 1)
        var edge = 0
        while (edge < edgeImporters.size) {
            val target = edgeTargets[edge]
            if (edgeImporters[edge] == module && target >= 0 &&
                !visited[target]) {
                if (target == to) found = true
                visited[target] = true
                pending.append(target)
            }
            edge = edge + 1
        }
    }
    found
}

fun bootstrapCollectShadowEntries(
    snapshot: BootstrapModuleSnapshot,
    module: int,
    var shadowModules: array<int>,
    var shadowNames: array<string>,
    var entryModules: array<int>,
    var entryDeclarations: array<int>,
    var entryNames: array<string>
): void {
    val platform = bootstrapRuntimePlatformModule(snapshot.path)
    val program = !bootstrapStandardLibraryModuleSource(snapshot.path)
    var declaration = 0
    while (declaration < snapshot.discovery.declarations.size) {
        val candidate = snapshot.discovery.declarations[declaration]
        val name = candidate.name
        // A private name is its module's alone (bootstrapAppendPrivateNames).
        if (bootstrapModuleShadowable(candidate) && !candidate.isPrivate) {
            // A program's declaration named like a built-in hides it where it
            // is seen; the standard library keeps the built-in.
            if ((platform && !(name.size >= 6 &&
                name.slice(0, 6) == "__abla")) ||
                (program && bootstrapBuiltinCallableName(name))) {
                shadowModules.append(module)
                shadowNames.append(name)
            } else {
                entryModules.append(module)
                entryDeclarations.append(declaration)
                entryNames.append(name)
            }
        }
        declaration = declaration + 1
    }
    return
}

/** The built-ins the compiler recognizes by the name a call or type writes. */
fun bootstrapBuiltinCallableName(name: string): bool =
    name == "Cell" || name == "Shared" || name == "Mutex" || name == "Map" ||
    name == "filledArray" || name == "move"

fun bootstrapAppendShadowNames(
    shadow: BootstrapModuleShadow,
    prefix: string,
    importer: BootstrapParseResult,
    skipDeclared: bool,
    var names: array<string>,
    var replacements: array<string>
): void {
    var index = 0
    while (index < shadow.names.size) {
        val name = shadow.names[index]
        if (!skipDeclared || !bootstrapModuleDeclares(importer, name)) {
            names.append(name)
            replacements.append("$prefix$name")
        }
        index = index + 1
    }
    return
}

fun bootstrapModuleShadows(
    aliases: array<BootstrapModuleAlias>,
    snapshots: array<BootstrapModuleSnapshot>,
    summary: BootstrapAliasSummary
): array<BootstrapModuleShadow> {
    val shadowModules: array<int> = []
    val shadowNames: array<string> = []
    val entryModules: array<int> = []
    val entryDeclarations: array<int> = []
    val entryNames: array<string> = []
    var module = 0
    while (module < snapshots.size) {
        // An aliased module's names all carry its prefix already.
        if (summary.targetPrefix(snapshots[module].path) == "") {
            bootstrapCollectShadowEntries(
                snapshots[module], module, shadowModules, shadowNames,
                entryModules, entryDeclarations, entryNames
            )
        }
        module = module + 1
    }
    // Chain the entries of each name: `heads` holds a name's first entry,
    // `chains` the next entry of the same name.
    var capacity = 8
    while (capacity < entryNames.size * 2 + 1) capacity = capacity * 2
    val heads = filledArray(capacity, -1)
    val chains = filledArray(entryNames.size, -1)
    val shared: array<int> = []
    var entry = 0
    while (entry < entryNames.size) {
        var slot = bootstrapNamedTargetHash(entryNames[entry])
        slot = slot - slot / capacity * capacity
        var placed = false
        while (!placed) {
            val head = heads[slot]
            if (head < 0) {
                heads[slot] = entry
                placed = true
            } else if (entryNames[head] == entryNames[entry]) {
                if (chains[head] < 0) shared.append(head)
                chains[entry] = chains[head]
                chains[head] = entry
                placed = true
            } else {
                slot = slot + 1
                if (slot == capacity) slot = 0
            }
        }
        entry = entry + 1
    }
    if (shared.size > 0) {
        val edgeImporters: array<int> = []
        val edgeTargets: array<int> = []
        var edge = 0
        while (edge < aliases.size) {
            val importer = summary.snapshotIndex.get(aliases[edge].importer)
            val target = summary.snapshotIndex.get(aliases[edge].target)
            edgeImporters.append(if (importer != null) importer else -1)
            edgeTargets.append(if (target != null) target else -1)
            edge = edge + 1
        }
        var group = 0
        while (group < shared.size) {
            var first = shared[group]
            while (first >= 0) {
                val firstDeclaration = snapshots[entryModules[first]]
                    .discovery.declarations[entryDeclarations[first]]
                var shadows = false
                var shadowed = -1
                var second = shared[group]
                while (second >= 0 && !shadows) {
                    if (entryModules[second] != entryModules[first] &&
                        !bootstrapDeclarationsOverload(
                            firstDeclaration,
                            snapshots[entryModules[second]]
                                .discovery.declarations[
                                    entryDeclarations[second]
                                ]
                        ) &&
                        bootstrapModuleReaches(
                            entryModules[first], entryModules[second],
                            edgeImporters, edgeTargets, snapshots.size
                        )) {
                        shadows = true
                        shadowed = second
                    }
                    second = chains[second]
                }
                // The program's entry point keeps its name: an imported
                // module's `main` becomes private to that module instead.
                if (shadows && entryNames[first] == "main") {
                    shadowModules.append(entryModules[shadowed])
                    shadowNames.append(entryNames[shadowed])
                } else if (shadows) {
                    shadowModules.append(entryModules[first])
                    shadowNames.append(entryNames[first])
                }
                first = chains[first]
            }
            group = group + 1
        }
    }
    val result: array<BootstrapModuleShadow> = []
    module = 0
    while (module < snapshots.size) {
        val names: array<string> = []
        var index = 0
        while (index < shadowModules.size) {
            if (shadowModules[index] == module &&
                !bootstrapAffineNamesContain(names, shadowNames[index])) {
                names.append(shadowNames[index])
            }
            index = index + 1
        }
        if (names.size > 0) {
            result.append(BootstrapModuleShadow(snapshots[module].path, names))
        }
        module = module + 1
    }
    result
}

fun bootstrapRewriteModuleSource(
    snapshot: BootstrapModuleSnapshot,
    aliases: array<BootstrapModuleAlias>,
    snapshots: array<BootstrapModuleSnapshot>,
    shadows: array<BootstrapModuleShadow>,
    summary: BootstrapAliasSummary
): string {
    val names: array<string> = []
    val replacements: array<string> = []
    val ownPrefix = summary.targetPrefix(snapshot.path)
    // Each name below carries a prefix except inside a declaration that binds
    // the name itself (a field, method, parameter or local, or a class's
    // member in its body and its extension functions) other than the
    // declaration of that name, and as a named argument.
    if (ownPrefix != "") {
        bootstrapAppendPrefixedNames(
            snapshot.discovery, ownPrefix, names, replacements
        )
    }
    // This module's shadowing declarations, named with its prefix.
    val ownShadows = bootstrapModuleShadowIndex(shadows, snapshot.path)
    if (ownPrefix == "" && ownShadows >= 0) {
        bootstrapAppendShadowNames(
            shadows[ownShadows],
            bootstrapModuleCanonicalPrefix(snapshot.path),
            snapshot.discovery, false, names, replacements
        )
    }
    // This module's private names carry its prefix, here only: no other
    // module's name can reach them.
    if (ownPrefix == "") {
        bootstrapAppendPrivateNames(
            snapshot.discovery,
            bootstrapModuleCanonicalPrefix(snapshot.path),
            names, replacements
        )
    }
    // A module imported plainly here but under an alias elsewhere carries its
    // module prefix everywhere: its bare names in this module mean those,
    // except inside a declaration that binds the name itself (a field,
    // parameter or local), where it is shadowed as it would be unaliased.
    val importedFrom = names.size
    // (This module's own edges, in order.)
    var edgeIndex = summary.firstEdgeOf(snapshot.path)
    while (edgeIndex >= 0) {
        val edge = aliases[edgeIndex]
        val targetPrefix = if (edge.importer == snapshot.path &&
            edge.alias == "") {
            summary.targetPrefix(edge.target)
        } else ""
        val target = summary.snapshotIndex.get(edge.target)
        if (targetPrefix != "" && target != null) {
            bootstrapAppendPrefixedNames(
                snapshots[target].discovery, targetPrefix,
                names, replacements, false
            )
        }
        // A plainly imported module's shadowing declarations, unless this
        // module declares the name itself.
        val targetShadows = if (edge.importer == snapshot.path &&
            edge.alias == "" && targetPrefix == "") {
            bootstrapModuleShadowIndex(shadows, edge.target)
        } else -1
        if (targetShadows >= 0) {
            bootstrapAppendShadowNames(
                shadows[targetShadows],
                bootstrapModuleCanonicalPrefix(edge.target),
                snapshot.discovery, true, names, replacements
            )
        }
        edgeIndex = summary.nextEdge[edgeIndex]
    }
    val declarationBounds = if (names.size > 0) {
        bootstrapDeclarationBoundNames(snapshot.source, snapshot.discovery)
    } else []
    val localAliases: array<string> = []
    val aliasPrefixes: array<string> = []
    var aliasIndex = summary.firstEdgeOf(snapshot.path)
    while (aliasIndex >= 0) {
        val edge = aliases[aliasIndex]
        if (edge.importer == snapshot.path && edge.alias != "") {
            localAliases.append(edge.alias)
            aliasPrefixes.append(bootstrapModuleCanonicalPrefix(edge.target))
        }
        aliasIndex = summary.nextEdge[aliasIndex]
    }
    val rewrittenBegins: array<int> = []
    val rewrittenEnds: array<int> = []
    val originalBegins: array<int> = []
    val originalEnds: array<int> = []
    val rewritten = if (names.size == 0 && localAliases.size == 0) {
        snapshot.source
    } else {
        val tokens = bootstrapLex(snapshot.source)
        var output = ""
        var cursor = 0
        var tokenIndex = 0
        var inImport = false
        while (tokenIndex < tokens.size) {
            val token = tokens[tokenIndex]
            if (token.kind == "import") inImport = true
            if (token.kind == "newline" || token.kind == ";") {
                inImport = false
            }
            var qualified = -1
            if (!inImport && token.kind == "identifier" &&
                tokenIndex + 2 < tokens.size &&
                tokens[tokenIndex + 1].kind == "." &&
                tokens[tokenIndex + 2].kind == "identifier") {
                val qualifier = bootstrapTokenText(snapshot.source, token)
                var candidate = 0
                while (candidate < localAliases.size && qualified < 0) {
                    if (localAliases[candidate] == qualifier) {
                        qualified = candidate
                    }
                    candidate = candidate + 1
                }
                if (qualified >= 0 && bootstrapAliasShadowedAt(
                    snapshot.discovery, qualifier, token.begin
                )) qualified = -1
            }
            if (qualified >= 0) {
                val member = tokens[tokenIndex + 2]
                output = "$output${snapshot.source.slice(cursor, token.begin)}"
                rewrittenBegins.append(output.size)
                output = "$output${aliasPrefixes[qualified]}${bootstrapTokenText(
                    snapshot.source, member
                )}"
                rewrittenEnds.append(output.size)
                originalBegins.append(token.begin)
                originalEnds.append(member.end)
                cursor = member.end
                tokenIndex = tokenIndex + 3
            } else {
                var replacement = -1
                // (`$name` in a string template names it too.)
                if (!inImport && (token.kind == "identifier" ||
                     token.kind == "interpolation-identifier") &&
                    (tokenIndex == 0 ||
                     tokens[tokenIndex - 1].kind != ".")) {
                    val text = bootstrapTokenText(snapshot.source, token)
                    var candidate = 0
                    while (candidate < names.size && replacement < 0) {
                        if (names[candidate] == text) replacement = candidate
                        candidate = candidate + 1
                    }
                }
                // A named argument (`f(name = …)`) names a parameter, which
                // keeps its name.
                if (replacement >= 0 && bootstrapNamedArgumentAt(tokens, tokenIndex)) {
                    replacement = -1
                }
                val enclosing = if (replacement >= 0) {
                    bootstrapDeclarationAt(snapshot.discovery, token.begin)
                } else -1
                // In the shadowing declaration itself the name is that
                // declaration; elsewhere a `fun` of that name is a method.
                val declaring = enclosing >= 0 &&
                    replacement < importedFrom &&
                    snapshot.discovery.declarations[enclosing].name ==
                        names[replacement]
                if (enclosing >= 0 && !declaring &&
                    ((enclosing < declarationBounds.size &&
                      bootstrapAffineNamesContain(
                          declarationBounds[enclosing], names[replacement]
                      )) ||
                     (tokenIndex > 0 &&
                      tokens[tokenIndex - 1].kind == "fun" &&
                      // (`fun Name.member`: the receiver, not a method.)
                      (tokenIndex + 1 >= tokens.size ||
                       tokens[tokenIndex + 1].kind != ".")))) {
                    replacement = -1
                }
                if (replacement >= 0) {
                    output =
                        "$output${snapshot.source.slice(cursor, token.begin)}"
                    rewrittenBegins.append(output.size)
                    output = "$output${replacements[replacement]}"
                    rewrittenEnds.append(output.size)
                    originalBegins.append(token.begin)
                    originalEnds.append(token.end)
                    cursor = token.end
                }
                tokenIndex = tokenIndex + 1
            }
        }
        "$output${snapshot.source.slice(cursor, snapshot.source.size)}"
    }
    bootstrapRecordSourceRewrite(BootstrapSourceRewrite(
        snapshot.path, rewrittenBegins, rewrittenEnds, originalBegins,
        originalEnds
    ))
    rewritten
}

/** Whether the identifier at `index` names an argument: `name =` right after
 *  a call's `(` or `,`. */
fun bootstrapNamedArgumentAt(tokens: array<BootstrapToken>, index: int): bool {
    if (index + 1 >= tokens.size || tokens[index + 1].kind != "=") return false
    var before = index - 1
    while (before >= 0 && tokens[before].kind == "newline") before = before - 1
    before >= 0 && (tokens[before].kind == "(" || tokens[before].kind == ",")
}

fun bootstrapAppendPrefixedNames(
    discovery: BootstrapParseResult,
    prefix: string,
    var names: array<string>,
    var replacements: array<string>,
    // An importer's view leaves the module's private names out.
    includePrivate: bool = true
): void {
    var declaration = 0
    while (declaration < discovery.declarations.size) {
        val name = discovery.declarations[declaration].name
        if (name != "" &&
            (includePrivate || !discovery.declarations[declaration].isPrivate)) {
            names.append(name)
            replacements.append("$prefix$name")
        }
        declaration = declaration + 1
    }
    return
}

/** A module's private top-level names (not extension members, whose names
 *  belong to their receiver), each once, with `prefix`. */
fun bootstrapAppendPrivateNames(
    discovery: BootstrapParseResult,
    prefix: string,
    var names: array<string>,
    var replacements: array<string>
): void {
    for (declaration in discovery.declarations) {
        val name = declaration.name
        if (declaration.isPrivate && declaration.extensionOwner == "" && name != "" &&
            !bootstrapAffineNamesContain(names, name)) {
            names.append(name)
            replacements.append("$prefix$name")
        }
    }
    return
}

/** Whether `discovery` declares `name` privately (and nothing public of it). */
fun bootstrapModuleDeclaresOnlyPrivately(
    discovery: BootstrapParseResult,
    name: string
): bool {
    var found = false
    for (declaration in discovery.declarations) {
        if (declaration.extensionOwner == "" && declaration.name == name) {
            if (!declaration.isPrivate) return false
            found = true
        }
    }
    found
}

fun bootstrapPrepareModuleSnapshot(
    snapshot: BootstrapModuleSnapshot,
    aliases: array<BootstrapModuleAlias>,
    snapshots: array<BootstrapModuleSnapshot>,
    shadows: array<BootstrapModuleShadow>,
    summary: BootstrapAliasSummary
): BootstrapModuleSnapshot {
    val source = bootstrapRewriteModuleSource(
        snapshot, aliases, snapshots, shadows, summary
    )
    val contractOnly = summary.isContractTarget(snapshot.path)
    // The common unaliased module needs no rewritten-source snapshot. Reuse
    // its already compact discovery record instead of parsing and retaining a
    // second interface AST for the duration of the build.
    if (!contractOnly && source == snapshot.source) return snapshot
    var discovery = bootstrapModuleDiscovery(source, snapshot.path)
    if (contractOnly) {
        discovery = bootstrapProjectContract(discovery, snapshot.path)
    }
    val fingerprintSource = if (contractOnly) {
        bootstrapModuleInterfaceIdentity(discovery, 0, 0)
    } else source
    BootstrapModuleSnapshot(
        snapshot.path,
        source,
        snapshot.importEdges,
        snapshot.importErrors,
        snapshot.exists,
        snapshot.size,
        snapshot.revision,
        bootstrapModuleFingerprint(fingerprintSource, 17, 257, 1000000007),
        bootstrapModuleFingerprint(fingerprintSource, 97, 263, 1000000009),
        discovery
    )
}

fun bootstrapImportAliasExposedTarget(target: string): string {
    var exposed = target
    if (target.size >= 9 &&
        target.slice(target.size - 9, target.size) == "/entry.ab") {
        val source = Path(target).readText()
        val scan = bootstrapScanImports(source)
        val parsed = bootstrapParseWithIdentity(source, target)
        if (parsed.declarations.size == 0 && scan.errors == 0 &&
            scan.edges.size == 1 && !scan.edges[0].provider &&
            scan.edges[0].alias == "") {
            exposed = bootstrapResolveImport(target, scan.edges[0].source)
        }
    }
    exposed
}

class BootstrapImportAliasValidation(
    val errors: int,
    val diagnostics: string
)

// Strict imports (`visibility = "imports"` in a package's abla.toml, or
// `--strict-imports` for modules whose package doesn't say): a module sees its
// own declarations, those of the modules it imports without an alias, the
// `export import`s of a strict one, everything a flat one (a package that
// doesn't opt in) reaches, and the runtime and abla/stm, which every program
// has. The standard library is strict when its own abla.toml says so. A name
// a module uses from any other module is E_NAME_NOT_IMPORTED, with the import
// to add. `--visibility-report <path>` writes every such use, in a program's
// module whether it is strict or not and in a strict library module, to
// <path> (module, line, column, name, declaring module, import);
// tools/fix-imports.ab applies it.
var bootstrapStrictImportsRequested: bool = false
var bootstrapVisibilityReportPath: string = ""
var bootstrapVisibilityReportStarted: bool = false

/** The `visibility` of the package `modulePath` belongs to: its nearest
 *  abla.toml's, or "" when that doesn't say (or there is none). */
fun bootstrapModuleManifestVisibility(modulePath: string): string {
    var directory = Path(modulePath).parent()
    var depth = 0
    while (depth < 128) {
        val candidate = directory.child("abla.toml")
        if (candidate.exists()) {
            return bootstrapTomlStringField(candidate.text, "visibility")
        }
        val parent = directory.parent()
        if (parent.text == directory.text) return ""
        directory = parent
        depth = depth + 1
    }
    ""
}

// The standard library's `visibility`, from its own abla.toml (read once per
// root).
var bootstrapStandardLibraryVisibilityRoot: string = ""
var bootstrapStandardLibraryVisibilityValue: string = ""

fun bootstrapStandardLibraryVisibility(): string {
    val root = bootstrapStandardLibraryRoot()
    if (root != bootstrapStandardLibraryVisibilityRoot) {
        val manifest = Path(root).child("abla.toml")
        bootstrapStandardLibraryVisibilityValue = if (manifest.exists())
            bootstrapTomlStringField(manifest.text, "visibility") else ""
        bootstrapStandardLibraryVisibilityRoot = root
    }
    bootstrapStandardLibraryVisibilityValue
}

fun bootstrapModuleStrict(modulePath: string): bool {
    if (modulePath.startsWith("<")) return false
    // The standard library is one package, whose abla.toml says for all of it
    // (`--strict-imports` is for a program's modules).
    if (bootstrapStandardLibraryModuleSource(modulePath)) {
        return bootstrapStandardLibraryVisibility() == "imports"
    }
    val visibility = bootstrapModuleManifestVisibility(modulePath)
    if (visibility == "imports") true
    else if (visibility == "program") false
    else bootstrapStrictImportsRequested
}

/** `target` as an import from `importer`: a standard-library module by its
 *  name (`abla/io`), another file by its path relative to the importer's. */
fun bootstrapImportSpelling(importer: string, target: string): string {
    val root = "${bootstrapCanonicalEscapingPath(
        bootstrapNormalizeModulePath(bootstrapStandardLibraryRoot())
    )}/"
    if (target.startsWith(root)) {
        var name = target.slice(root.size, target.size)
        if (name.endsWith("/entry.ab")) name = name.slice(0, name.size - 9)
        return name
    }
    bootstrapRelativeImportSpelling(importer, target)
}

/** `target` as a standard-library module imports it: another library module
 *  by its name, a file of one (`openssl.ab`) by its relative path. */
fun bootstrapStandardLibraryImportSpelling(importer: string, target: string): string =
    if (target.endsWith("/entry.ab")) bootstrapImportSpelling(importer, target)
    else bootstrapRelativeImportSpelling(importer, target)

/** `target`'s path relative to `importer`'s directory, as an import spells it. */
fun bootstrapRelativeImportSpelling(importer: string, target: string): string {
    val from = bootstrapPathSegments(Path(importer).parent().text)
    val to = bootstrapPathSegments(target)
    var common = 0
    while (common < from.size && common + 1 < to.size && from[common] == to[common]) {
        common = common + 1
    }
    var spelled = ""
    var up = common
    while (up < from.size) {
        spelled = "$spelled../"
        up = up + 1
    }
    if (spelled == "") spelled = "./"
    var down = common
    while (down < to.size) {
        spelled = if (down + 1 < to.size) "$spelled${to[down]}/" else "$spelled${to[down]}"
        down = down + 1
    }
    spelled
}

fun bootstrapValidateStrictImports(
    aliases: array<BootstrapModuleAlias>,
    snapshots: array<BootstrapModuleSnapshot>
): BootstrapImportAliasValidation {
    val report = bootstrapVisibilityReportPath != ""
    val strict: array<bool> = []
    // What the report asks: every module of the program (not the standard
    // library's) as if it were strict.
    val asStrict: array<bool> = []
    var anyStrict = false
    for (snapshot in snapshots) {
        val found = bootstrapModuleStrict(snapshot.path)
        strict.append(found)
        asStrict.append(found || (report &&
            !bootstrapStandardLibraryModuleSource(snapshot.path) &&
            !snapshot.path.startsWith("<")))
        if (found) anyStrict = true
    }
    if (!anyStrict && !report) return BootstrapImportAliasValidation(0, "")
    val strictSummary = bootstrapAliasSummary(aliases, snapshots)
    // Every module's names, as plain references could reach them: not an
    // extension member, private, nor of a module whose names carry its
    // prefix (imported under an alias somewhere).
    val names = bootstrapStringSet()
    val declaring: array<array<int>> = []
    // Each class's members, which code in its body or its extension
    // functions may use without `this.`.
    val classes = bootstrapStringSet()
    val classMembers: array<array<string>> = []
    // The names some module declares as a type, which a type annotation can
    // name (`: never` is the built-in type, whatever values are called).
    val typeNames = bootstrapStringSet()
    var module = 0
    while (module < snapshots.size) {
        val prefixed = strictSummary.targetPrefix(snapshots[module].path) != ""
        for (declaration in snapshots[module].discovery.declarations) {
            if (declaration.kind == "class" || declaration.kind == "interface" ||
                declaration.kind == "type") typeNames.add(declaration.name)
            if (!prefixed && declaration.extensionOwner == "" &&
                !declaration.isPrivate && declaration.name != "" &&
                declaration.kind != "extend") {
                if (!names.contains(declaration.name)) {
                    names.add(declaration.name)
                    declaring.append([])
                }
                declaring[names.indexOf(declaration.name)].append(module)
            }
            if (declaration.kind == "class" || declaration.kind == "interface") {
                if (!classes.contains(declaration.name)) {
                    classes.add(declaration.name)
                    classMembers.append([])
                }
                val owner = classes.indexOf(declaration.name)
                for (parameter in declaration.parameters) {
                    classMembers[owner].append(parameter)
                }
                for (method in declaration.methods) classMembers[owner].append(method.name)
            }
        }
        module = module + 1
    }
    var errors = 0
    var diagnostics = ""
    var lines = ""
    // The standard-library import to suggest for each declaring module, once
    // found ("": the module itself, by its path).
    val suggested = filledArray(snapshots.size, "")
    val suggestedKnown = filledArray(snapshots.size, false)
    module = 0
    while (module < snapshots.size) {
        val snapshot = snapshots[module]
        if (asStrict[module]) {
            val visible = bootstrapStrictVisibleModules(
                module, aliases, snapshots, asStrict
            )
            val findings = bootstrapStrictImportFindings(
                snapshot, names, declaring, classes, classMembers, visible, typeNames
            )
            for (finding in findings) {
                if (!suggestedKnown[finding.declaring]) {
                    suggested[finding.declaring] = bootstrapStrictSuggestedImport(
                        finding.declaring, aliases, snapshots, strict
                    )
                    suggestedKnown[finding.declaring] = true
                }
                // A standard-library module imports the declaring module itself.
                val spelling = if (bootstrapStandardLibraryModuleSource(snapshot.path))
                    bootstrapStandardLibraryImportSpelling(
                        snapshot.path, snapshots[finding.declaring].path
                    )
                    else if (suggested[finding.declaring] != "")
                    suggested[finding.declaring]
                    else bootstrapImportSpelling(
                        snapshot.path, snapshots[finding.declaring].path
                    )
                if (strict[module]) {
                    errors = errors + 1
                    diagnostics =
                        "${diagnostics}error[E_NAME_NOT_IMPORTED]: `${finding.name}` is declared in ${snapshots[finding.declaring].path}, which this module doesn't import\nhelp: add: import \"$spelling\"\nsource[strict-import]:${snapshot.path}:${finding.begin}:${finding.end}\n"
                }
                lines = "$lines${snapshot.path}\t${finding.line}\t${finding.column}\t${finding.name}\t${snapshots[finding.declaring].path}\timport \"$spelling\"\n"
            }
        }
        module = module + 1
    }
    // A build may check its module graph more than once: the first check
    // starts the report, later ones add the lines it doesn't have yet.
    if (report) {
        val reportPath = Path(bootstrapVisibilityReportPath)
        var written = if (bootstrapVisibilityReportStarted) reportPath.readText() else ""
        for (line in lines.split("\n")) {
            if (line != "" && !written.contains("$line\n")) written = "$written$line\n"
        }
        reportPath.writeTextAtomic(written)
        bootstrapVisibilityReportStarted = true
    }
    BootstrapImportAliasValidation(errors, diagnostics)
}

/** The standard-library import to suggest for a name of `declaring`, as the
 *  program writes it: the import some program module resolves to it (`abla/fs`
 *  resolves to `abla/sys/linux/fs`), else the shortest one a program module
 *  writes that reaches it, else its own name. "" for a program module. */
fun bootstrapStrictSuggestedImport(
    declaring: int,
    aliases: array<BootstrapModuleAlias>,
    snapshots: array<BootstrapModuleSnapshot>,
    strict: array<bool>
): string {
    val target = snapshots[declaring].path
    if (!bootstrapStandardLibraryModuleSource(target)) return ""
    var best = ""
    for (edge in aliases) {
        if (edge.alias == "" && edge.written.startsWith("abla/") &&
            !bootstrapStandardLibraryModuleSource(edge.importer)) {
            if (edge.target == target) return edge.written
            val candidate = bootstrapSnapshotIndex(snapshots, edge.target)
            if (candidate >= 0 && (best == "" || edge.written.size < best.size) &&
                bootstrapStrictVisibleModules(
                    candidate, aliases, snapshots, strict
                )[declaring]) best = edge.written
        }
    }
    if (best != "") best else bootstrapImportSpelling("", target)
}

/** The modules whose names `module` sees under strict imports, by index. */
fun bootstrapStrictVisibleModules(
    module: int,
    aliases: array<BootstrapModuleAlias>,
    snapshots: array<BootstrapModuleSnapshot>,
    strict: array<bool>
): array<bool> {
    val visible = filledArray(snapshots.size, false)
    visible[module] = true
    // abla/stm, and the runtime the compiler loads into every program for its
    // target (abla/runtime/self and abla/runtime/platform's host.ab or
    // wasm.ab), which a program has without importing them.
    val transactions = bootstrapImplicitTransactionsPath()
    val runtime = bootstrapNormalizeModulePath(Path(bootstrapStandardLibraryRoot()).child(
        "abla/runtime/self/entry.ab"
    ).text)
    var index = 0
    while (index < snapshots.size) {
        val path = snapshots[index].path
        if (path == transactions || path == runtime ||
            bootstrapRuntimePlatformModule(path)) visible[index] = true
        index = index + 1
    }
    val pending: array<int> = []
    // Its own unaliased imports, then what they pass on.
    for (edge in aliases) {
        if (edge.alias == "" && edge.importer == snapshots[module].path) {
            val target = bootstrapSnapshotIndex(snapshots, edge.target)
            if (target >= 0 && !visible[target]) {
                visible[target] = true
                pending.append(target)
            }
        }
    }
    var next = 0
    while (next < pending.size) {
        val from = pending[next]
        for (edge in aliases) {
            if (edge.alias == "" && edge.importer == snapshots[from].path &&
                (!strict[from] || edge.exported)) {
                val target = bootstrapSnapshotIndex(snapshots, edge.target)
                if (target >= 0 && !visible[target]) {
                    visible[target] = true
                    pending.append(target)
                }
            }
        }
        next = next + 1
    }
    visible
}

fun bootstrapSnapshotIndex(snapshots: array<BootstrapModuleSnapshot>, path: string): int {
    var index = 0
    while (index < snapshots.size) {
        if (snapshots[index].path == path) return index
        index = index + 1
    }
    -1
}

class BootstrapStrictImportFinding(
    val name: string,
    val declaring: int,
    val begin: int,
    val end: int,
    val line: int,
    val column: int
)

/** The plain names `snapshot` uses from modules it doesn't see, each once.
 *  A name its own declarations bind (a parameter, local or field of the
 *  enclosing declaration, or a member of the class it is in or extends), a
 *  named argument and a member after `.` are left alone. */
fun bootstrapStrictImportFindings(
    snapshot: BootstrapModuleSnapshot,
    names: BootstrapStringSet,
    declaring: array<array<int>>,
    classes: BootstrapStringSet,
    classMembers: array<array<string>>,
    visible: array<bool>,
    typeNames: BootstrapStringSet
): array<BootstrapStrictImportFinding> {
    val result: array<BootstrapStrictImportFinding> = []
    val source = snapshot.source
    val discovery = snapshot.discovery
    val own = bootstrapStringSet()
    for (declaration in discovery.declarations) {
        if (declaration.extensionOwner == "") own.add(declaration.name)
    }
    val bounds = bootstrapDeclarationBoundNames(source, discovery)
    val reported = bootstrapStringSet()
    val tokens = bootstrapLex(source)
    var inImport = false
    var depth = 0
    var line = 1
    var lineStart = 0
    var lineCursor = 0
    var index = 0
    while (index < tokens.size) {
        val token = tokens[index]
        if (token.kind == "import") inImport = true
        if (token.kind == "newline" || token.kind == ";") inImport = false
        if (token.kind == "(") depth = depth + 1
        if (token.kind == ")" && depth > 0) depth = depth - 1
        val previous = if (index > 0) tokens[index - 1].kind else ""
        val next = if (index + 1 < tokens.size) tokens[index + 1].kind else ""
        if (!inImport && (token.kind == "identifier" ||
                token.kind == "interpolation-identifier") &&
            previous != "." && previous != "fun" && previous != "@" &&
            !(next == "=" && depth > 0)) {
            val text = bootstrapTokenText(source, token)
            // A type annotation names a type: a value of that name elsewhere
            // isn't what it uses.
            val previousWord = if (previous == "identifier")
                bootstrapTokenText(source, tokens[index - 1]) else ""
            val typePosition = previous == ":" || previousWord == "is" ||
                previousWord == "as" || previous == "as"
            val known = if (typePosition && !typeNames.contains(text)) -1
                else names.indexOf(text)
            if (known >= 0 && !own.contains(text) && !reported.contains(text)) {
                var seen = false
                for (candidate in declaring[known]) {
                    if (visible[candidate]) seen = true
                }
                val enclosing = bootstrapDeclarationAt(discovery, token.begin)
                if (!seen && enclosing >= 0) {
                    if (enclosing < bounds.size &&
                        bootstrapAffineNamesContain(bounds[enclosing], text)) seen = true
                    val declaration = discovery.declarations[enclosing]
                    val owner = if (declaration.kind == "class" ||
                        declaration.kind == "interface") declaration.name
                        else bootstrapNormalizeType(declaration.extensionOwner)
                    val ownerIndex = if (owner != "") classes.indexOf(owner) else -1
                    if (ownerIndex >= 0 &&
                        bootstrapAffineNamesContain(classMembers[ownerIndex], text)) seen = true
                }
                if (!seen) {
                    reported.add(text)
                    while (lineCursor < token.begin) {
                        if (source[lineCursor] == 10) {
                            line = line + 1
                            lineStart = lineCursor + 1
                        }
                        lineCursor = lineCursor + 1
                    }
                    result.append(BootstrapStrictImportFinding(
                        text, declaring[known][0], token.begin, token.end,
                        line, token.begin - lineStart + 1
                    ))
                }
            }
        }
        index = index + 1
    }
    result
}

fun bootstrapValidateImportAliases(
    aliases: array<BootstrapModuleAlias>,
    state: BootstrapModuleState
): BootstrapImportAliasValidation {
    var errors = 0
    // Each importer is lexed once, and its aliases are found by name as its
    // identifiers go by; each aliased edge's diagnostics are still reported
    // edge by edge, in token order.
    val edgeDiagnostics: array<string> = []
    // A use as `alias.member` skips the member's tokens for that alias.
    val skipUntil: array<int> = []
    val importerSlots: Map<string, int> = Map()
    val importerPaths: array<string> = []
    val importerNames: array<Map<string, int>> = []
    val sameName: array<int> = []
    var aliasIndex = 0
    while (aliasIndex < aliases.size) {
        val edge = aliases[aliasIndex]
        edgeDiagnostics.append("")
        skipUntil.append(0)
        sameName.append(-1)
        if (edge.alias != "" && state.indexOf(edge.importer) >= 0 &&
            state.indexOf(edge.target) >= 0) {
            val known = importerSlots.get(edge.importer)
            var slot = importerPaths.size
            if (known != null) {
                slot = known
            } else {
                importerSlots.set(edge.importer, slot)
                importerPaths.append(edge.importer)
                val names: Map<string, int> = Map()
                importerNames.append(names)
            }
            // (Later edges of a name are reached from the first.)
            val first = importerNames[slot].get(edge.alias)
            if (first == null) {
                importerNames[slot].set(edge.alias, aliasIndex)
            } else {
                var last = first
                while (sameName[last] >= 0) last = sameName[last]
                sameName[last] = aliasIndex
            }
        }
        aliasIndex = aliasIndex + 1
    }
    var importerIndex = 0
    while (importerIndex < importerPaths.size) {
        val importer = state.snapshots[state.indexOf(importerPaths[importerIndex])]
        val names = importerNames[importerIndex]
        val tokens = bootstrapLex(importer.source)
        var tokenIndex = 0
        var inImport = false
        while (tokenIndex < tokens.size) {
            val token = tokens[tokenIndex]
            if (token.kind == "import") inImport = true
            if (token.kind == "newline" || token.kind == ";") {
                inImport = false
            }
            val first = if (!inImport && token.kind == "identifier")
                names.get(bootstrapTokenText(importer.source, token)) else null
            var named = if (first != null) first else -1
            while (named >= 0) {
                val edge = aliases[named]
                if (tokenIndex >= skipUntil[named] &&
                    !bootstrapAliasShadowedAt(
                        importer.discovery, edge.alias, token.begin
                    )) {
                    val target = state.snapshots[state.indexOf(edge.target)]
                    if (tokenIndex + 2 < tokens.size &&
                        tokens[tokenIndex + 1].kind == "." &&
                        tokens[tokenIndex + 2].kind == "identifier") {
                        val member = bootstrapTokenText(
                            importer.source,
                            tokens[tokenIndex + 2]
                        )
                        var exposed = false
                        var declaration = 0
                        while (declaration <
                            target.discovery.declarations.size) {
                            if (target.discovery.declarations[
                                declaration
                            ].name == member &&
                                !target.discovery.declarations[
                                    declaration
                                ].isPrivate) exposed = true
                            declaration = declaration + 1
                        }
                        if (!exposed && bootstrapModuleDeclaresOnlyPrivately(
                            target.discovery, member
                        )) {
                            errors = errors + 1
                            edgeDiagnostics[named] =
                                "${edgeDiagnostics[named]}error[E_NAME_PRIVATE]: `$member` is private to ${edge.target}\ncontext[canonical-module]: ${edge.target}\nsource[qualified-import]:${edge.importer}:${token.begin}:${tokens[tokenIndex + 2].end}\n"
                        } else if (!exposed) {
                            errors = errors + 1
                            edgeDiagnostics[named] =
                                "${edgeDiagnostics[named]}error[E_IMPORT_ALIAS_MEMBER_UNKNOWN]: module alias `${edge.alias}` has no exposed declaration named `$member`\ncontext[canonical-module]: ${edge.target}\nsource[qualified-import]:${edge.importer}:${token.begin}:${tokens[tokenIndex + 2].end}\n"
                        }
                        skipUntil[named] = tokenIndex + 3
                    } else {
                        errors = errors + 1
                        edgeDiagnostics[named] =
                            "${edgeDiagnostics[named]}error[E_IMPORT_ALIAS_USED_AS_VALUE]: module alias `${edge.alias}` is compile-time-only and must qualify a declaration\ncontext[canonical-module]: ${edge.target}\nsource[qualified-import]:${edge.importer}:${token.begin}:${token.end}\n"
                    }
                }
                named = sameName[named]
            }
            tokenIndex = tokenIndex + 1
        }
        importerIndex = importerIndex + 1
    }
    var diagnostics = ""
    for (edgeDiagnostic in edgeDiagnostics) diagnostics = "$diagnostics$edgeDiagnostic"
    BootstrapImportAliasValidation(errors, diagnostics)
}

// What a module graph looks its edges and modules up by, instead of scanning
// every edge or module recorded so far. By importing module (its slot, in
// importers): its edges in the graph's `aliases`, first to last (aliasNext links
// each to the module's next one), and the plain names its unqualified imports
// so far expose ("<slot>\n<name>"); and the place of each loaded module.
class BootstrapModuleGraphIndex(
    val importers: Map<string, int>,
    val firstAlias: array<int>,
    val lastAlias: array<int>,
    val aliasNext: array<int>,
    val unqualifiedNames: Map<string, int>,
    val modules: Map<string, int>,
    var indexedModules: int
)

fun bootstrapModuleGraphIndex(): BootstrapModuleGraphIndex =
    BootstrapModuleGraphIndex(Map(), [], [], [], Map(), Map(), 0)

class BootstrapModuleGraph(
    val modules: array<BootstrapModule>,
    var errors: int,
    val state: BootstrapModuleState,
    val orderedSnapshots: array<BootstrapModuleSnapshot>,
    val authorizedCompileCapabilities: array<string>,
    var diagnostics: string,
    val aliases: array<BootstrapModuleAlias>,
    val index: BootstrapModuleGraphIndex
) {
    fun importerSlot(importerPath: string): int {
        val known = this.index.importers.get(importerPath)
        if (known != null) return known
        val slot = this.index.firstAlias.size
        this.index.importers.set(importerPath, slot)
        this.index.firstAlias.append(-1)
        this.index.lastAlias.append(-1)
        slot
    }

    fun recordImportEdge(
        importer: BootstrapModuleSnapshot,
        edge: BootstrapImportEdge,
        target: string
    ): void {
        val slot = this.importerSlot(importer.path)
        var duplicateAlias = false
        var duplicateTarget = false
        var ownEdge = this.index.firstAlias[slot]
        while (ownEdge >= 0) {
            val found = this.aliases[ownEdge]
            if (edge.alias != "" && found.alias == edge.alias) duplicateAlias = true
            if (found.target == target) duplicateTarget = true
            ownEdge = this.index.aliasNext[ownEdge]
        }
        var declarationCollision = false
        var index = 0
        while (index < importer.discovery.declarations.size) {
            if (edge.alias != "" &&
                importer.discovery.declarations[index].name == edge.alias) {
                declarationCollision = true
            }
            index = index + 1
        }
        var unqualifiedAmbiguities = 0
        var ambiguityDiagnostics = ""
        // Import discovery already parsed every module into the shared
        // snapshot. Reuse it here instead of reparsing the target and all
        // preceding imports for every edge.
        var targetDeclarations: array<BootstrapDeclaration> = []
        if (edge.alias == "") {
            targetDeclarations = this.state.acquire(target).discovery.declarations
        }
        // Only an import that shares a plain name with one of the module's
        // earlier unqualified imports can be ambiguous: the others skip the
        // comparison with each of those imports.
        var sharesName = false
        for (declaration in targetDeclarations) {
            if (declaration.name != "" && declaration.extensionOwner == "" &&
                !declaration.isPrivate &&
                this.index.unqualifiedNames.get("$slot\n${declaration.name}") != null) {
                sharesName = true
            }
        }
        if (edge.alias == "" && sharesName) {
            ownEdge = this.index.firstAlias[slot]
            while (ownEdge >= 0) {
                val found = this.aliases[ownEdge]
                ownEdge = this.index.aliasNext[ownEdge]
                if (found.alias == "" && found.target != target) {
                    val foundDeclarations = this.state.acquire(
                        found.target
                    ).discovery.declarations
                    // How many of the found module's plain declarations
                    // bear each name: each one a target declaration shares
                    // is an ambiguity, reported once per declaration pair.
                    val foundNames = bootstrapStringSet()
                    val foundCounts: array<int> = []
                    for (declaration in foundDeclarations) {
                        if (declaration.extensionOwner == "" && !declaration.isPrivate) {
                            val known = foundNames.keys.size
                            foundNames.add(declaration.name)
                            if (foundNames.keys.size > known) foundCounts.append(0)
                            val key = foundNames.indexOf(declaration.name)
                            foundCounts[key] = foundCounts[key] + 1
                        }
                    }
                    for (declaration in targetDeclarations) {
                        val name = declaration.name
                        val key = if (name != "" && declaration.extensionOwner == "" &&
                            !declaration.isPrivate)
                            foundNames.indexOf(name) else -1
                        var shared = if (key >= 0) foundCounts[key] else 0
                        while (shared > 0) {
                            unqualifiedAmbiguities = unqualifiedAmbiguities + 1
                            ambiguityDiagnostics =
                                "${ambiguityDiagnostics}error[E_IMPORT_UNQUALIFIED_AMBIGUOUS]: unqualified declaration `$name` is exposed by both `${found.target}` and `$target`; add explicit aliases\nsource[import]:${importer.path}:${edge.begin}:${edge.end}\n"
                            shared = shared - 1
                        }
                    }
                }
            }
        }
        if (duplicateAlias) {
            this.errors = this.errors + 1
            this.diagnostics =
                "${this.diagnostics}error[E_IMPORT_ALIAS_DUPLICATE]: import alias `${edge.alias}` is bound more than once in module `${importer.path}`\nsource[import]:${importer.path}:${edge.begin}:${edge.end}\n"
        }
        if (declarationCollision) {
            this.errors = this.errors + 1
            this.diagnostics =
                "${this.diagnostics}error[E_IMPORT_ALIAS_DECLARATION_COLLISION]: import alias `${edge.alias}` collides with a declaration in module `${importer.path}`\nsource[import]:${importer.path}:${edge.begin}:${edge.end}\n"
        }
        if (duplicateTarget) {
            this.errors = this.errors + 1
            this.diagnostics =
                "${this.diagnostics}error[E_IMPORT_ALIAS_TARGET_DUPLICATE]: module `$target` is imported more than once by `${importer.path}`\nsource[import]:${importer.path}:${edge.begin}:${edge.end}\n"
        }
        if (unqualifiedAmbiguities > 0) {
            this.errors = this.errors + unqualifiedAmbiguities
            this.diagnostics =
                "${this.diagnostics}$ambiguityDiagnostics"
        }
        if (!duplicateAlias && !declarationCollision && !duplicateTarget &&
            unqualifiedAmbiguities == 0) {
            val added = this.aliases.size
            this.index.aliasNext.append(-1)
            if (this.index.lastAlias[slot] >= 0) {
                this.index.aliasNext[this.index.lastAlias[slot]] = added
            } else this.index.firstAlias[slot] = added
            this.index.lastAlias[slot] = added
            if (edge.alias == "") {
                for (declaration in targetDeclarations) {
                    if (declaration.name != "" && declaration.extensionOwner == "" &&
                        !declaration.isPrivate) {
                        this.index.unqualifiedNames.set("$slot\n${declaration.name}", 1)
                    }
                }
            }
            this.aliases.append(BootstrapModuleAlias(
                importer.path,
                target,
                edge.alias,
                edge.contractOnly,
                edge.begin,
                edge.end,
                edge.exported,
                edge.source
            ))
        }
        bootstrapSemanticUnit()
    }
    fun contains(modulePath: string): bool {
        val identity = bootstrapNormalizeModulePath(modulePath)
        // (Indexes the modules appended since the last lookup.)
        while (this.index.indexedModules < this.modules.size) {
            this.index.modules.set(
                this.modules[this.index.indexedModules].path,
                this.index.indexedModules
            )
            this.index.indexedModules = this.index.indexedModules + 1
        }
        this.index.modules.get(identity) != null
    }

    fun loadContract(modulePath: string): string {
        val identity = bootstrapNormalizeModulePath(modulePath)
        if (!this.contains(identity)) {
            val snapshot = this.state.acquire(identity)
            this.errors = this.errors + snapshot.importErrors
            this.diagnostics =
                "${this.diagnostics}${bootstrapScanImports(snapshot.source).diagnostics}"
            this.modules.append(BootstrapModule(identity, ""))
            var index = 0
            while (index < snapshot.importEdges.size) {
                val edge = snapshot.importEdges[index]
                if (!edge.provider) {
                    val imported = bootstrapResolveImport(identity, edge.source)
                    val exposed = bootstrapImportAliasExposedTarget(imported)
                    val importedSnapshot = this.state.acquire(exposed)
                    if (bootstrapContractImportRequired(
                        snapshot.discovery,
                        edge,
                        importedSnapshot.discovery
                    )) {
                        val contractEdge = BootstrapImportEdge(
                            edge.source,
                            edge.provider,
                            edge.alias,
                            true,
                            edge.begin,
                            edge.end
                        )
                        this.recordImportEdge(snapshot, contractEdge, exposed)
                        this.loadContract(imported)
                    }
                }
                index = index + 1
            }
            this.orderedSnapshots.append(snapshot)
        }
        ""
    }

    fun load(modulePath: string): string {
        val identity = bootstrapNormalizeModulePath(modulePath)
        if (this.modules.size == 0 &&
            this.authorizedCompileCapabilities.size == 0) {
            val capabilities = bootstrapManifestCompileCapabilities(identity)
            ctNativeSetEntry(identity)
            var capability = 0
            while (capability < capabilities.size) {
                this.authorizedCompileCapabilities.append(
                    capabilities[capability]
                )
                capability = capability + 1
            }
        }
        var output = ""
        if (!this.contains(identity)) {
            val snapshot = this.state.acquire(identity)
            bootstrapFrontendTraceMemory("graph.acquire:$identity")
            this.errors = this.errors + snapshot.importErrors
            this.diagnostics =
                "${this.diagnostics}${bootstrapScanImports(snapshot.source).diagnostics}"
            this.modules.append(BootstrapModule(identity, snapshot.source))
            var index = 0
            while (index < snapshot.importEdges.size) {
                val edge = snapshot.importEdges[index]
                if (!edge.provider) {
                    val imported = bootstrapResolveImport(
                        identity,
                        edge.source
                    )
                    this.recordImportEdge(
                        snapshot,
                        edge,
                        bootstrapImportAliasExposedTarget(imported)
                    )
                    // A missing file is an error at its import, not an empty module
                    // whose declarations later fail as unknown names.
                    if (!Path(imported).info().exists()) {
                        this.errors = this.errors + 1
                        this.diagnostics =
                            "${this.diagnostics}error[E_IMPORT_NOT_FOUND]: imported module `${edge.source}` doesn't exist (looked for $imported)\nsource[import]:$identity:${edge.begin}:${edge.end}\n"
                    } else if (edge.contractOnly) {
                        this.loadContract(imported)
                    } else this.load(imported)
                } else {
                    val provider = bootstrapEvaluateImportProvider(
                        edge.source, this.orderedSnapshots,
                        snapshot.discovery
                    )
                    if (provider.errors == 0) {
                        val imported = bootstrapResolvePackageImport(
                            identity, "package/${provider.dependency.name}"
                        )
                        if (imported != "") {
                            this.recordImportEdge(
                                snapshot,
                                edge,
                                bootstrapImportAliasExposedTarget(imported)
                            )
                            if (edge.contractOnly) {
                                this.loadContract(imported)
                            } else this.load(imported)
                        } else {
                            this.errors = this.errors + 1
                            this.diagnostics =
                                "${this.diagnostics}error[E_PACKAGE_IMPORT]: locked package `${provider.dependency.name}` could not be resolved from module `$identity`\n"
                        }
                    } else {
                        this.errors = this.errors + provider.errors
                        this.diagnostics =
                            "${this.diagnostics}${provider.diagnostic}"
                    }
                }
                index = index + 1
            }
            this.orderedSnapshots.append(snapshot)
            // parse() consumes orderedSnapshots. Return only this requested
            // module instead of rebuilding the transitive graph as text at
            // each recursion level.
            output = snapshot.source
        }
        output
    }

    /** abla/stm, for a program whose code names `TVar` or `Transactional`
     *  (which need no import), unless a module of it declares its own
     *  `TVar`: a program without them parses as it did before. */
    fun loadImplicitTransactions(): void {
        val path = bootstrapImplicitTransactionsPath()
        if (this.contains(path)) return
        var named = false
        for (snapshot in this.orderedSnapshots) {
            for (declaration in snapshot.discovery.declarations) {
                if (declaration.extensionOwner == "" && declaration.kind != "extend" &&
                    declaration.name == "TVar") return
            }
            if (!named && !bootstrapRuntimeModuleSource(snapshot.path) &&
                (bootstrapSourceNamesWord(snapshot.source, "TVar") ||
                 bootstrapSourceNamesWord(snapshot.source, "Transactional"))) named = true
        }
        if (named) this.load(path)
        return
    }

    fun parse(): BootstrapParseResult {
        this.loadImplicitTransactions()
        bootstrapFrontendTraceMemory(
            "parse.begin:${this.orderedSnapshots.size}"
        )
        // Clear transactional transform requests once per candidate graph.
        // Ordinary modules now bypass transform processing entirely.
        bootstrapTakeFunctionBodyReplacements()
        bootstrapTakeFunctionAnnotationAdditions()
        val declarations: array<BootstrapDeclaration> = []
        val actions: array<BootstrapExpression> = []
        val compileInputPaths: array<string> = []
        val compileInputContents: array<string> = []
        val handlerDeclarations: array<BootstrapDeclaration> = []
        // What the modules' transforms changed in other modules, in module order.
        val declarationEdits: array<BootstrapDeclarationEdit> = []
        val importedRegistrations: array<BootstrapSubparserRegistration> = []
        val preparedSnapshots: array<BootstrapModuleSnapshot> = []
        val aliasSummary = bootstrapAliasSummary(
            this.aliases, this.orderedSnapshots
        )
        val shadows = bootstrapModuleShadows(
            this.aliases, this.orderedSnapshots, aliasSummary
        )
        var preparedIndex = 0
        while (preparedIndex < this.orderedSnapshots.size) {
            preparedSnapshots.append(bootstrapPrepareModuleSnapshot(
                this.orderedSnapshots[preparedIndex],
                this.aliases,
                this.orderedSnapshots,
                shadows,
                aliasSummary
            ))
            preparedIndex = preparedIndex + 1
        }
        bootstrapFrontendTraceMemory(
            "parse.prepared:${preparedSnapshots.size}"
        )
        val aliasValidation = bootstrapValidateImportAliases(
            this.aliases, this.state
        )
        bootstrapFrontendTraceMemory("parse.aliases")
        val strictValidation = bootstrapValidateStrictImports(
            this.aliases, this.orderedSnapshots
        )
        var parseErrors = this.errors + aliasValidation.errors +
            strictValidation.errors
        var extensionErrors = 0
        var parseDiagnostics =
            "${this.diagnostics}${aliasValidation.diagnostics}${strictValidation.diagnostics}"
        var dependencyFingerprint = 29
        var authorizedEffects = 0
        var authorized = 0
        while (authorized < this.authorizedCompileCapabilities.size) {
            authorizedEffects = bootstrapCompileEffectMerge(
                authorizedEffects,
                bootstrapCompileEffectFromName(
                    this.authorizedCompileCapabilities[authorized]
                )
            )
            authorized = authorized + 1
        }
        var requestedEffects = 0
        val completeDeclarations: array<BootstrapDeclaration> = []
        var completeDeclarationFingerprint = 41
        var requestedModule = 0
        while (requestedModule < preparedSnapshots.size) {
            val requestedSnapshot = preparedSnapshots[requestedModule]
            requestedEffects = bootstrapCompileEffectMerge(
                requestedEffects,
                bootstrapBuildCompileEffectRequests(
                    requestedSnapshot.discovery
                )
            )
            var completeDeclaration = 0
            while (completeDeclaration <
                    requestedSnapshot.discovery.declarations.size) {
                completeDeclarations.append(
                    requestedSnapshot.discovery.declarations[completeDeclaration]
                )
                completeDeclaration = completeDeclaration + 1
            }
            val completeInterface = bootstrapModuleInterfaceIdentity(
                requestedSnapshot.discovery,
                requestedSnapshot.firstFingerprint,
                requestedSnapshot.secondFingerprint
            )
            completeDeclarationFingerprint =
                completeDeclarationFingerprint * 277 +
                bootstrapModuleFingerprint(
                    completeInterface, 79, 281, 1000000007
                )
            completeDeclarationFingerprint =
                completeDeclarationFingerprint -
                (completeDeclarationFingerprint / 1000000007) *
                    1000000007
            requestedModule = requestedModule + 1
        }
        bootstrapFrontendTraceMemory(
            "parse.interfaces:${completeDeclarations.size}"
        )
        val allowedCompileEffects = bootstrapBuildCompileEffectGrants(
            requestedEffects,
            authorizedEffects
        )
        dependencyFingerprint = dependencyFingerprint + allowedCompileEffects +
            completeDeclarationFingerprint
        var moduleIndex = 0
        var currentDeclarationBegin = 0
        while (moduleIndex < preparedSnapshots.size) {
            val snapshot = preparedSnapshots[moduleIndex]
            bootstrapFrontendTraceMemory(
                "parse.module.begin:$moduleIndex:${snapshot.path}"
            )
            var localRegistry = BootstrapSubparserRegistry([], 0, "")
            if (bootstrapActionsRegisterSubparser(
                snapshot.discovery.actions
            )) {
                val visibleDeclarations: array<BootstrapDeclaration> = []
                var visibleDeclaration = 0
                while (visibleDeclaration < handlerDeclarations.size) {
                    visibleDeclarations.append(
                        handlerDeclarations[visibleDeclaration]
                    )
                    visibleDeclaration = visibleDeclaration + 1
                }
                visibleDeclaration = 0
                while (visibleDeclaration <
                    snapshot.discovery.declarations.size) {
                    visibleDeclarations.append(
                        snapshot.discovery.declarations[visibleDeclaration]
                    )
                    visibleDeclaration = visibleDeclaration + 1
                }
                localRegistry = bootstrapBuildSubparserRegistry(
                    BootstrapParseResult(
                        visibleDeclarations,
                        snapshot.discovery.actions,
                        snapshot.discovery.errors,
                        snapshot.discovery.extensionErrors,
                        [],
                        [],
                        snapshot.discovery.diagnostics
                    )
                )
            }
            parseErrors = parseErrors + localRegistry.errors
            extensionErrors = extensionErrors + localRegistry.errors
            parseDiagnostics =
                "$parseDiagnostics${localRegistry.diagnostics}"
            val moduleRegistrations: array<BootstrapSubparserRegistration> = []
            var declarationIndex = 0
            var registrationIndex = 0
            while (registrationIndex < importedRegistrations.size) {
                moduleRegistrations.append(
                    importedRegistrations[registrationIndex]
                )
                registrationIndex = registrationIndex + 1
            }
            registrationIndex = 0
            while (registrationIndex < localRegistry.registrations.size) {
                val registration = localRegistry.registrations[registrationIndex]
                var duplicate = false
                var importedIndex = 0
                while (importedIndex < importedRegistrations.size) {
                    if (importedRegistrations[importedIndex].name ==
                        registration.name) duplicate = true
                    importedIndex = importedIndex + 1
                }
                if (duplicate) {
                    parseErrors = parseErrors + 1
                    extensionErrors = extensionErrors + 1
                    parseDiagnostics =
                        "${parseDiagnostics}error[E_EXT_SUBPARSER_COLLISION]: imported subparser `${registration.name}` is registered more than once\nsource[module]:${snapshot.path}:0:0\n"
                    0
                } else {
                    moduleRegistrations.append(registration)
                    importedRegistrations.append(
                        BootstrapSubparserRegistration(
                            registration.name,
                            registration.handler,
                            -1
                        )
                    )
                    0
                }
                registrationIndex = registrationIndex + 1
            }

            val parsed = if (aliasSummary.isContractTarget(snapshot.path))
                snapshot.discovery
            else this.state.acquireParsed(
                snapshot,
                dependencyFingerprint,
                completeDeclarations,
                currentDeclarationBegin,
                snapshot.discovery.declarations.size,
                BootstrapSubparserRegistry(moduleRegistrations, 0, ""),
                allowedCompileEffects
            )
            bootstrapFrontendTraceMemory(
                "parse.module.end:$moduleIndex:${parsed.declarations.size}"
            )
            val interfaceIdentity = bootstrapModuleInterfaceIdentity(
                parsed,
                snapshot.firstFingerprint,
                snapshot.secondFingerprint
            )
            dependencyFingerprint = dependencyFingerprint * 257 +
                bootstrapModuleFingerprint(
                    interfaceIdentity, 31, 269, 1000000007
                )
            dependencyFingerprint = dependencyFingerprint -
                (dependencyFingerprint / 1000000007) * 1000000007
            dependencyFingerprint = dependencyFingerprint * 263 +
                bootstrapModuleFingerprint(
                    interfaceIdentity, 73, 271, 1000000009
                )
            dependencyFingerprint = dependencyFingerprint -
                (dependencyFingerprint / 1000000009) * 1000000009
            parseErrors = parseErrors + parsed.errors
            extensionErrors = extensionErrors + parsed.extensionErrors
            parseDiagnostics = "$parseDiagnostics${parsed.diagnostics}"
            bootstrapMergeCompileInputs(
                compileInputPaths,
                compileInputContents,
                parsed.compileInputPaths,
                parsed.compileInputContents
            )
            declarationIndex = 0
            while (declarationIndex < parsed.declarations.size) {
                declarations.append(parsed.declarations[declarationIndex])
                handlerDeclarations.append(parsed.declarations[declarationIndex])
                declarationIndex = declarationIndex + 1
            }
            // Later modules may inspect imported function bodies through typed
            // reflection. Replace discovery placeholders with the declarations
            // already parsed here, preserving the discovery slots used by the
            // staged parser even when expansion inserts generated declarations.
            // Each takes the first parsed declaration of its kind and name,
            // found through one index of the module (a scan per placeholder
            // was quadratic in the module's size); ABLA_MODULE_INDEX_CHECK=1
            // checks each against the scan.
            val parsedByName: Map<string, int> = Map()
            var indexed = 0
            while (indexed < parsed.declarations.size) {
                val key = bootstrapModuleDeclarationKey(parsed.declarations[indexed])
                if (!parsedByName.has(key)) parsedByName.set(key, indexed)
                indexed = indexed + 1
            }
            val checkIndex = bootstrapModuleIndexCheck()
            var discovered = 0
            while (discovered < snapshot.discovery.declarations.size) {
                val original = snapshot.discovery.declarations[discovered]
                val resolved = parsedByName.get(bootstrapModuleDeclarationKey(original))
                val at = if (resolved != null) resolved else -1
                if (at >= 0) {
                    completeDeclarations[currentDeclarationBegin + discovered] =
                        parsed.declarations[at]
                }
                if (checkIndex) {
                    var scanned = 0
                    while (scanned < parsed.declarations.size &&
                        !(parsed.declarations[scanned].name == original.name &&
                          parsed.declarations[scanned].kind == original.kind)) {
                        scanned = scanned + 1
                    }
                    if (scanned == parsed.declarations.size) scanned = -1
                    if (scanned != at) linuxWriteStandardError(
                        "error[E_INTERNAL]: module.index-check: `${original.name}` resolved to $at, a scan says $scanned\n"
                    )
                }
                discovered = discovered + 1
            }
            var actionIndex = 0
            while (actionIndex < parsed.actions.size) {
                actions.append(parsed.actions[actionIndex])
                actionIndex = actionIndex + 1
            }
            for (edit in parsed.declarationEdits) declarationEdits.append(edit)
            if (parsed.declarationEdits.size > 0) {
                // The modules parsed after this one see its edits, and their
                // reusable parses are keyed by them.
                val viewed = bootstrapApplyDeclarationEdits(
                    completeDeclarations, parsed.declarationEdits, true
                )
                dependencyFingerprint = dependencyFingerprint * 251 +
                    bootstrapDeclarationEditFingerprint(parsed.declarationEdits)
                dependencyFingerprint = dependencyFingerprint -
                    (dependencyFingerprint / 1000000007) * 1000000007
            }
            moduleIndex = moduleIndex + 1
            currentDeclarationBegin = currentDeclarationBegin +
                snapshot.discovery.declarations.size
        }
        bootstrapFrontendTraceMemory(
            "parse.modules.end:${declarations.size}"
        )
        var capability = 0
        while (capability < this.authorizedCompileCapabilities.size) {
            actions.append(BootstrapExpression(
                "compile.capability.authorization",
                this.authorizedCompileCapabilities[capability],
                0,
                0,
                []
            ))
            capability = capability + 1
        }
        // The modules' changes to each other, on the raw declarations.
        val edited = bootstrapApplyDeclarationEdits(declarations, declarationEdits)
        parseErrors = parseErrors + edited.errors
        extensionErrors = extensionErrors + edited.errors
        parseDiagnostics = "$parseDiagnostics${edited.diagnostics}"
        bootstrapFrontendTraceMemory("parse.normalize.begin")
        // One graph's count: a parse whose result never reached code generation
        // (an analysis-only request) leaves nothing behind for the next one.
        val staleNamedArgumentErrors = bootstrapTakeNamedArgumentErrors()
        val normalized = bootstrapNormalizeNamedArguments(BootstrapParseResult(
            declarations,
            actions,
            parseErrors,
            extensionErrors,
            compileInputPaths,
            compileInputContents,
            parseDiagnostics
        ))
        bootstrapFrontendTraceMemory("parse.normalize.end")
        normalized
    }
}

/** The path of abla/stm, which a program naming `TVar` or `Transactional`
 *  has without importing it (loadImplicitTransactions). */
fun bootstrapImplicitTransactionsPath(): string =
    bootstrapNormalizeModulePath(Path(bootstrapStandardLibraryRoot()).child("abla/stm/entry.ab").text)

/** Whether `source` has the word `word` outside its comments (a string
 *  literal may name it too: at worst the module is loaded for nothing). */
fun bootstrapSourceNamesWord(source: string, word: string): bool {
    var index = 0
    while (index < source.size) {
        val byte = source[index]
        if (byte == 47 && index + 1 < source.size && source[index + 1] == 47) {
            while (index < source.size && source[index] != 10) index = index + 1
        } else if (byte == 47 && index + 1 < source.size && source[index + 1] == 42) {
            index = index + 2
            while (index + 1 < source.size && !(source[index] == 42 && source[index + 1] == 47)) index = index + 1
            index = index + 2
        } else if (bootstrapGenericWordByte(byte)) {
            var end = index
            while (end < source.size && bootstrapGenericWordByte(source[end])) end = end + 1
            if (end - index == word.size && source.slice(index, end) == word) return true
            index = end
        } else index = index + 1
    }
    false
}

fun bootstrapBundleWithState(
    modulePath: string,
    var state: BootstrapModuleState
): string {
    state.beginCounting()
    val modules: array<BootstrapModule> = []
    val ordered: array<BootstrapModuleSnapshot> = []
    BootstrapModuleGraph(modules, 0, state, ordered, [], "", [], bootstrapModuleGraphIndex()).load(
        modulePath
    )
}

fun bootstrapBundle(modulePath: string): string {
    val state = bootstrapModuleState()
    bootstrapBundleWithState(modulePath, state)
}

fun bootstrapParseModuleWithState(
    modulePath: string,
    var state: BootstrapModuleState
): BootstrapParseResult {
    state.beginCounting()
    val graph = BootstrapModuleGraph([], 0, state, [], [], "", [], bootstrapModuleGraphIndex())
    graph.load(modulePath)
    graph.parse()
}

fun bootstrapParseModule(modulePath: string): BootstrapParseResult {
    val state = bootstrapModuleState()
    bootstrapParseModuleWithState(modulePath, state)
}
