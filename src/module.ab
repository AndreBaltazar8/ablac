fun bootstrapFrontendTraceMemory(label: string): void {
    val configured = linuxEnvironment("ABLA_COMPILER_MEMORY_TRACE")
    if (configured.found && configured.value != "") {
        linuxWriteStandardError(
            "abla-frontend-memory $label ${runtimeMemoryLiveBytes()}\n"
        )
    }
}

/** A declaration's kind and name, as one key. */
fun bootstrapModuleDeclarationKey(declaration: BootstrapDeclaration): string =
    "${declaration.kind}\n${declaration.name}"

var bootstrapModuleIndexCheckValue: int = -1

fun bootstrapModuleIndexCheck(): bool {
    if (bootstrapModuleIndexCheckValue < 0) {
        val configured = linuxEnvironment("ABLA_MODULE_INDEX_CHECK")
        bootstrapModuleIndexCheckValue = if (configured.found && configured.value == "1") 1 else 0
    }
    bootstrapModuleIndexCheckValue == 1
}

/** Whether `path` is a module of the standard library. */
fun bootstrapPathIsStandardLibrary(path: string): bool {
    val root = bootstrapNormalizeModulePath(bootstrapStandardLibraryRoot())
    path.startsWith("$root/")
}

/** Whether `source` writes `$name` (as tokens: a comment or a string naming it does not count) for a subparser of `registry`. */
fun bootstrapSourceUsesSubparser(
    source: string, registry: BootstrapSubparserRegistry, hostSource: string = ""
): bool {
    if (registry.registrations.size == 0 || source.indexOf("\$") < 0) return false
    val tokens = if (hostSource == "") bootstrapLexShared(source) else bootstrapRawHostTokens(hostSource)
    for (index in 0 until tokens.size - 1) {
        if (tokens[index].kind == BOOTSTRAP_TOKEN_DOLLAR && tokens[index + 1].kind == BOOTSTRAP_TOKEN_IDENTIFIER) {
            val name = bootstrapTokenText(source, tokens[index + 1])
            for (registration in registry.registrations) {
                if (registration.name == name) return true
            }
        }
    }
    false
}

fun bootstrapActionsRegisterSubparser(
    actions: array<BootstrapExpression>
): bool {
    var found = false
    var index = 0
    while (!found && index < actions.size) {
        var expression = actions[index]
        if (expression.kind == "compile" && expression.children.size == 1) {
            expression = expression.children[0]
        }
        found = expression.kind == "call" &&
            expression.text == "compilerRegisterSubparser"
        index = index + 1
    }
    found
}

fun bootstrapResolveImport(importer: string, requested: string): string {
    var result = Path(importer).parent().child(requested).text
    if (requested.size > 0 && requested[0] == 47) result = requested
    if (requested.size >= 5 && requested.slice(0, 5) == "abla/") {
        result = Path(bootstrapStandardLibraryRoot()).child(requested).child(
            "entry.ab"
        ).text
    }
    val package = bootstrapResolvePackageImport(importer, requested)
    if (package != "") result = package
    bootstrapImportRemapApply(
        importer,
        bootstrapCanonicalEscapingPath(bootstrapNormalizeModulePath(result))
    )
}

class BootstrapImportEdge(
    val source: string,
    val provider: bool,
    val alias: string,
    val contractOnly: bool,
    val begin: int,
    val end: int,
    // `export import "…"`: in a strict module, its names are its importers' too.
    val exported: bool = false
)

/** Whether the `import` at `offset` is written `export import`. */
fun bootstrapImportExportedAt(source: string, offset: int): bool {
    var cursor = offset
    while (cursor > 0 && (source[cursor - 1] == 32 || source[cursor - 1] == 9)) {
        cursor = cursor - 1
    }
    cursor >= 6 && source.slice(cursor - 6, cursor) == "export" &&
        (cursor == 6 || !bootstrapIsAlphaNumeric(source[cursor - 7]))
}

class BootstrapImportScan(
    val edges: array<BootstrapImportEdge>,
    val errors: int,
    val diagnostics: string
)

fun bootstrapImportWordAt(source: string, offset: int, word: string): bool {
    var equal = offset + word.size <= source.size &&
        bootstrapRegionEquals(source, offset, offset + word.size, word)
    if (equal && offset > 0 && bootstrapIsAlphaNumeric(source[offset - 1])) {
        equal = false
    }
    if (equal && offset + word.size < source.size &&
        bootstrapIsAlphaNumeric(source[offset + word.size])) equal = false
    equal
}

fun bootstrapImportAliasValid(alias: string): bool {
    var valid = alias.size > 0 && bootstrapIsAlpha(alias[0])
    var index = 1
    while (valid && index < alias.size) {
        valid = bootstrapIsAlphaNumeric(alias[index])
        index = index + 1
    }
    if (valid && bootstrapKeyword(alias, 0, alias.size) != BOOTSTRAP_TOKEN_IDENTIFIER) {
        valid = false
    }
    if (alias == "as" || alias == "contract" || alias == "import") {
        valid = false
    }
    valid
}

fun bootstrapScanImports(source: string): BootstrapImportScan =
    bootstrapScanImportsWithIdentity(source, "")

fun bootstrapScanImportsWithIdentity(
    source: string, sourceIdentity: string, isolatedImportBegin: int = -1
): BootstrapImportScan {
    val edges: array<BootstrapImportEdge> = []
    var errors = 0
    var diagnostics = ""
    var offset = if (isolatedImportBegin >= 0) isolatedImportBegin else 0
    var lineComment = false
    var blockComment = 0
    var braces = 0
    // Past the last "import" there is nothing to find, and most of a file is past it.
    var scanned = isolatedImportBegin + 1
    if (isolatedImportBegin < 0) {
        scanned = source.size
        while (scanned > 0 && !(source[scanned - 1] == 116 && scanned >= 6 &&
            bootstrapImportWordAt(source, scanned - 6, "import"))) scanned = scanned - 1
    }
    while (offset < scanned) {
        if (source[offset] == 10 || source[offset] == 13) lineComment = false
        // A raw literal is opaque to import discovery, even when it contains
        // quotes, braces, comments, or a line beginning with `import`.
        if (!lineComment && blockComment == 0 &&
            bootstrapAt(source, offset, 34) && bootstrapAt(source, offset + 1, 34) &&
            bootstrapAt(source, offset + 2, 34)) {
            offset = offset + 3
            while (offset < source.size && !(bootstrapAt(source, offset, 34) &&
                bootstrapAt(source, offset + 1, 34) && bootstrapAt(source, offset + 2,
                    34))) offset = offset + 1
            if (offset < source.size) offset = offset + 3
            continue
        }
        // Skip the entire ordinary string, including interpolations. A raw
        // literal inside `${...}` can itself contain quotes and `import`.
        if (!lineComment && blockComment == 0 && source[offset] == 34) {
            offset = offset + 1
            var done = false
            while (offset < source.size && !done) {
                if (source[offset] == 92 && offset + 1 < source.size) offset = offset + 2
                else if (source[offset] == 34) { offset = offset + 1; done = true }
                else if (source[offset] == 36 && bootstrapAt(source, offset + 1, 123)) {
                    val end = bootstrapFindInterpolationEnd(source, offset + 2)
                    offset = if (bootstrapAt(source, end, 125)) end + 1 else end
                } else offset = offset + 1
            }
            continue
        }
        if (!lineComment && blockComment == 0 &&
            source[offset] == 47 &&
            offset + 1 < source.size && source[offset + 1] == 42) {
            blockComment = blockComment + 1
            offset = offset + 2
            continue
        }
        if (blockComment > 0) {
            if (offset + 1 < source.size && source[offset] == 42 &&
                source[offset + 1] == 47) {
                blockComment = blockComment - 1
                offset = offset + 2
            } else offset = offset + 1
            continue
        }
        if (!lineComment && source[offset] == 47 &&
            offset + 1 < source.size && source[offset + 1] == 47) {
            lineComment = true
        }
        if (!lineComment && blockComment == 0) {
            if (source[offset] == 123) braces = braces + 1
            if (source[offset] == 125 && braces > 0) braces = braces - 1
        }
        if (!lineComment && blockComment == 0 &&
            braces == 0 && bootstrapImportWordAt(source, offset, "import")) {
            val importBegin = offset
            var cursor = offset + 6
            while (cursor < source.size &&
                (source[cursor] == 32 || source[cursor] == 9)) {
                cursor = cursor + 1
            }
            var contractOnly = false
            if (bootstrapImportWordAt(source, cursor, "contract")) {
                contractOnly = true
                cursor = cursor + 8
                while (cursor < source.size &&
                    (source[cursor] == 32 || source[cursor] == 9)) {
                    cursor = cursor + 1
                }
            }
            val sourceBegin = cursor
            var sourceEnd = cursor
            var end = cursor
            var provider = true
            var alias = ""
            if (cursor < source.size && source[cursor] == 34) {
                provider = false
                val rawImport = bootstrapAt(source, cursor + 1, 34) && bootstrapAt(source,
                    cursor + 2, 34)
                cursor = cursor + if (rawImport) 3 else 1
                val valueBegin = cursor
                if (rawImport) {
                    while (cursor < source.size && !(bootstrapAt(source, cursor, 34) &&
                        bootstrapAt(source, cursor + 1, 34) && bootstrapAt(source, cursor + 2,
                            34))) cursor = cursor + 1
                } else {
                    while (cursor < source.size &&
                        (source[cursor] != 34 || source[cursor - 1] == 92)) cursor = cursor + 1
                }
                sourceEnd = cursor
                if (cursor < source.size) cursor = cursor + if (rawImport) 3 else 1
                end = cursor
                var requested = source.slice(valueBegin, sourceEnd)
                var invalidRawImport = false
                if (rawImport) {
                    val decoder = BootstrapParser(if (sourceIdentity ==
                        "") "<import>" else sourceIdentity, source, [], [], [], [], 0, 0, "", [],
                        [], 0, -1, 0, "")
                    if (sourceEnd == source.size) {
                        errors = errors + 1
                        val location = if (sourceIdentity ==
                            "") "source[import]:$sourceBegin:$sourceEnd" else "source[parser]:$sourceIdentity:$sourceBegin:$sourceEnd"
                        diagnostics =
                            "${diagnostics}error[E_PARSE_RAW_UNTERMINATED]: unterminated raw string\n$location\n"
                        invalidRawImport = true
                    } else {
                        requested =
                            decoder.decodeRawText(BootstrapToken(BOOTSTRAP_TOKEN_STRING_TEXT,
                                valueBegin, sourceEnd))
                        var multiline = false
                        for (i in valueBegin until sourceEnd) if (source[i] == 10) multiline = true
                        if (multiline) decoder.checkRawClose(
                            BootstrapToken(BOOTSTRAP_TOKEN_STRING_END, sourceEnd, end))
                    }
                    if (decoder.errors > 0) {
                        errors = errors + decoder.errors
                        diagnostics = diagnostics + (if (sourceIdentity == "")
                            decoder.diagnostics.replace("source[parser]:<import>:",
                                "source[import]:") else decoder.diagnostics)
                        invalidRawImport = true
                    }
                }
                while (cursor < source.size &&
                    (source[cursor] == 32 || source[cursor] == 9)) {
                    cursor = cursor + 1
                }
                if (bootstrapImportWordAt(source, cursor, "as")) {
                    cursor = cursor + 2
                    while (cursor < source.size &&
                        (source[cursor] == 32 || source[cursor] == 9)) {
                        cursor = cursor + 1
                    }
                    val aliasBegin = cursor
                    while (cursor < source.size &&
                        bootstrapIsAlphaNumeric(source[cursor])) {
                        cursor = cursor + 1
                    }
                    alias = source.slice(aliasBegin, cursor)
                    end = cursor
                }
                if (invalidRawImport) {
                    // The decoder already reported the offending source span.
                } else if (requested == "" ||
                    (alias != "" && !bootstrapImportAliasValid(alias))) {
                    errors = errors + 1
                    diagnostics =
                        "${diagnostics}error[E_IMPORT_ALIAS_INVALID]: import source and alias must be non-empty valid identifiers\nsource[import]:$importBegin:$end\n"
                } else edges.append(BootstrapImportEdge(
                    requested, provider, alias, contractOnly, importBegin, end,
                    bootstrapImportExportedAt(source, importBegin)
                ))
            } else {
                var depth = 0
                var quoted = false
                var aliasAt = -1
                while (cursor < source.size &&
                    !(!quoted && depth == 0 &&
                      (source[cursor] == 10 || source[cursor] == 13 ||
                       source[cursor] == 59))) {
                    if (source[cursor] == 34 &&
                        (cursor == sourceBegin || source[cursor - 1] != 92)) {
                        quoted = !quoted
                    }
                    if (!quoted && (source[cursor] == 40 ||
                        source[cursor] == 91)) depth = depth + 1
                    if (!quoted && (source[cursor] == 41 ||
                        source[cursor] == 93)) depth = depth - 1
                    if (!quoted && depth == 0 &&
                        bootstrapImportWordAt(source, cursor, "as")) {
                        aliasAt = cursor
                        sourceEnd = cursor
                    }
                    cursor = cursor + 1
                }
                end = cursor
                if (aliasAt >= 0) {
                    val rawAlias = bootstrapPackageTrim(source.slice(
                        aliasAt + 2, end
                    ))
                    alias = rawAlias
                } else sourceEnd = end
                val requested = bootstrapPackageTrim(source.slice(
                    sourceBegin, sourceEnd
                ))
                if (requested == "" ||
                    (alias != "" && !bootstrapImportAliasValid(alias))) {
                    errors = errors + 1
                    diagnostics =
                        "${diagnostics}error[E_IMPORT_ALIAS_INVALID]: import source and alias must be non-empty valid identifiers\nsource[import]:$importBegin:$end\n"
                } else edges.append(BootstrapImportEdge(
                    requested, provider, alias, contractOnly, importBegin, end,
                    bootstrapImportExportedAt(source, importBegin)
                ))
            }
            offset = end
        }
        offset = offset + 1
    }
    BootstrapImportScan(edges, errors, diagnostics)
}

/** A fingerprint of `edits`, folded into the cache identity of the modules
 *  parsed after them (their transforms may have read the edited declarations). */
fun bootstrapDeclarationEditFingerprint(edits: array<BootstrapDeclarationEdit>): int {
    var text = ""
    for (edit in edits) {
        text = "$text${edit.kind}\u{1F}${bootstrapEditTargetText(edit)}\u{1F}${edit.payload}\u{1E}"
    }
    bootstrapModuleFingerprint(text, 89, 283, 1000000007)
}

fun bootstrapModuleFingerprint(
    source: string,
    seed: int,
    factor: int,
    modulus: int
): int {
    var hash = seed
    var index = 0
    while (index < source.size) {
        hash = hash * factor + source[index] + 1
        hash = hash - (hash / modulus) * modulus
        index = index + 1
    }
    hash
}

fun bootstrapModuleExpressionIdentity(
    expression: BootstrapExpression
): string {
    var identity = "${expression.kind}:${expression.text}("
    var child = 0
    while (child < expression.children.size) {
        identity = "$identity${bootstrapModuleExpressionIdentity(
            expression.children[child]
        )},"
        child = child + 1
    }
    "$identity)"
}

fun bootstrapModuleInterfaceIdentity(
    parsed: BootstrapParseResult,
    implementationFirst: int,
    implementationSecond: int
): string {
    var identity = ""
    var implementationSensitive = false
    var declaration = 0
    while (declaration < parsed.declarations.size) {
        val found = parsed.declarations[declaration]
        var interfaceKind = found.kind
        if (interfaceKind == "extern" && found.externalLibrary.size >= 9 &&
            found.externalLibrary.slice(0, 9) == "contract:") {
            interfaceKind = "fun"
        }
        identity =
            "$identity$interfaceKind:${found.name}:${found.extensionOwner}:${found.resultType}:${found.isResource}:${found.isTrusted}:${found.isNoEscape}|"
        if (found.isSealed) identity = "$identity:sealed"
        var conformance = 0
        while (conformance < found.conformances.size) {
            identity = "$identity:${found.conformances[conformance]},"
            conformance = conformance + 1
        }
        var annotation = 0
        while (annotation < found.annotations.size) {
            identity = "$identity@${found.annotations[annotation]},"
            if (annotation < found.annotationArguments.size &&
                found.annotationArguments[annotation].kind != "missing") {
                identity = "$identity(${bootstrapModuleExpressionIdentity(
                    found.annotationArguments[annotation]
                )})"
            }
            annotation = annotation + 1
        }
        var parameter = 0
        while (parameter < found.parameters.size) {
            var type = "unknown"
            var kind = "parameter"
            if (parameter < found.parameterTypes.size) {
                type = found.parameterTypes[parameter]
            }
            if (parameter < found.parameterKinds.size) {
                kind = found.parameterKinds[parameter]
            }
            identity = "$identity${found.parameters[parameter]}:$kind:$type,"
            if (parameter < found.parameterDefaults.size &&
                found.parameterDefaults[parameter].kind != "missing") {
                identity = "$identity=${bootstrapModuleExpressionIdentity(
                    found.parameterDefaults[parameter]
                )}"
            }
            parameter = parameter + 1
        }
        var method = 0
        while (method < found.methods.size) {
            val member = found.methods[method]
            identity = "$identity method:${member.name}:${member.resultType}("
            annotation = 0
            while (annotation < member.annotations.size) {
                identity = "$identity@${member.annotations[annotation]},"
                if (annotation < member.annotationArguments.size &&
                    member.annotationArguments[annotation].kind != "missing") {
                    identity =
                        "$identity(${bootstrapModuleExpressionIdentity(
                            member.annotationArguments[annotation]
                        )})"
                }
                annotation = annotation + 1
            }
            parameter = 0
            while (parameter < member.parameters.size) {
                var type = "unknown"
                var kind = "parameter"
                if (parameter < member.parameterTypes.size) {
                    type = member.parameterTypes[parameter]
                }
                if (parameter < member.parameterKinds.size) {
                    kind = member.parameterKinds[parameter]
                }
                identity = "$identity$kind:$type,"
                if (parameter < member.parameterDefaults.size &&
                    member.parameterDefaults[parameter].kind != "missing") {
                    identity =
                        "$identity=${bootstrapModuleExpressionIdentity(
                            member.parameterDefaults[parameter]
                        )}"
                }
                parameter = parameter + 1
            }
            identity = "$identity)"
            method = method + 1
        }
        if (found.kind == "compile.fun" || found.kind == "compile.val" ||
            found.kind == "compile.var") implementationSensitive = true
        declaration = declaration + 1
    }
    var action = 0
    while (action < parsed.actions.size) {
        var expression = parsed.actions[action]
        if (expression.kind == "compile" && expression.children.size == 1) {
            expression = expression.children[0]
        }
        val grant = expression.kind == "call" &&
            expression.text == "compilerGrant"
        val authorization = expression.kind ==
            "compile.capability.authorization"
        if (!grant && !authorization) implementationSensitive = true
        action = action + 1
    }
    if (implementationSensitive) {
        identity = "$identity implementation:$implementationFirst:$implementationSecond"
    }
    identity
}

// Import discovery needs declaration interfaces, compile-time definitions,
// defaults, annotations, and class member signatures. It does not need to
// retain ordinary runtime function bodies: staged parsing reads each module
// again with the complete visible declaration set before semantic analysis.
// Keeping those bodies in every module snapshot duplicates the dominant AST
// payload for large source-only frameworks such as abla-embedded.
fun bootstrapModuleDiscoveryDeclaration(
    declaration: BootstrapDeclaration
): BootstrapDeclaration {
    val methods: array<BootstrapDeclaration> = []
    var method = 0
    while (method < declaration.methods.size) {
        methods.append(bootstrapModuleDiscoveryDeclaration(
            declaration.methods[method]
        ))
        method = method + 1
    }
    val expression = if (declaration.kind == "fun")
        BootstrapExpression(
            "missing", "", declaration.begin, declaration.begin, []
        )
    else declaration.expression
    return BootstrapDeclaration(
        declaration.kind,
        declaration.name,
        declaration.begin,
        declaration.end,
        expression,
        declaration.parameters,
        declaration.parameterTypes,
        declaration.resultType,
        methods,
        declaration.parameterDefaults,
        declaration.externalLibrary,
        declaration.parameterKinds,
        declaration.extensionOwner,
        declaration.isTrusted,
        declaration.isResource,
        declaration.isNoEscape,
        declaration.generatedNamespace,
        declaration.generatedOriginBegin,
        declaration.generatedOriginEnd,
        declaration.annotations,
        declaration.annotationArguments,
        declaration.annotationBegins,
        declaration.annotationEnds,
        declaration.sourceIdentity,
        declaration.conformances,
        declaration.isSealed,
        declaration.isPrivate,
        declaration.typeParameters
    )
}

fun bootstrapModuleDiscovery(
    source: string,
    sourceIdentity: string,
    hostSource: string = ""
): BootstrapParseResult {
    val parsed = if (hostSource == "") bootstrapParseWithIdentity(source, sourceIdentity)
        else bootstrapParseWithTokens(source, sourceIdentity, bootstrapRawHostTokens(hostSource))
    val declarations: array<BootstrapDeclaration> = []
    var declaration = 0
    while (declaration < parsed.declarations.size) {
        declarations.append(bootstrapModuleDiscoveryDeclaration(
            parsed.declarations[declaration]
        ))
        declaration = declaration + 1
    }
    return BootstrapParseResult(
        declarations,
        parsed.actions,
        parsed.errors,
        parsed.extensionErrors,
        parsed.compileInputPaths,
        parsed.compileInputContents,
        parsed.diagnostics, [], parsed.stackDepthStoppedSources
    )
}

// A snapshot is the reusable, module-local part of graph loading. Keeping the
// source and import scan together is important: publishing a new source with
// stale dependency edges would make incremental invalidation unsound.
// Unsaved source is supplied at its lexical path, never through shadow files.
// Versions are session-local; content fingerprints still key reusable parses.
class BootstrapModuleOverlay(val path: string, val text: string, val version: int)

// Set by the editor's analysis service: its module snapshots live for the whole session and are only read once built
// (every field a `val`), so each is copied into read-only memory the collector does not trace (docs/design/frozen-heap.md).
var bootstrapModuleFreezeSnapshots: bool = false

fun bootstrapModuleSnapshotFrozen(snapshot: BootstrapModuleSnapshot): BootstrapModuleSnapshot =
    if (bootstrapModuleFreezeSnapshots) Frozen(snapshot).get() else snapshot

class BootstrapModuleSnapshot(
    val path: string,
    val source: string,
    val importEdges: array<BootstrapImportEdge>,
    val importErrors: int,
    val exists: bool,
    val size: int,
    val revision: int,
    val firstFingerprint: int,
    val secondFingerprint: int,
    val discovery: BootstrapParseResult,
    val rawChunks: array<BootstrapRawChunk> = [],
    val hostSource: string = "",
    val rawSites: array<BootstrapRawSite> = [],
    val mayUseRawProvider: bool = false
)

fun bootstrapRawHostTokens(source: string): array<BootstrapToken> =
    bootstrapLexWithRawProviders(source, { _, end -> end })

fun bootstrapModuleTokens(snapshot: BootstrapModuleSnapshot): array<BootstrapToken> =
    if (snapshot.hostSource == "") bootstrapLexShared(snapshot.source)
    else bootstrapRawHostTokens(snapshot.hostSource)

class BootstrapModuleFrontendSnapshot(
    val path: string,
    val firstFingerprint: int,
    val secondFingerprint: int,
    val dependencyFingerprint: int,
    val parsed: BootstrapParseResult
)

// Compile inputs use provider-qualified identities. Filesystem paths retain
// their lexical spelling; deterministic ambient providers use a reserved
// identity that can be re-observed without persisting the input's value.
fun bootstrapCompileInputContents(identity: string): string {
    val environmentPrefix = "abla-input:environment:"
    var contents = ""
    if (identity.size >= environmentPrefix.size &&
        identity.slice(0, environmentPrefix.size) == environmentPrefix) {
        val observed = linuxEnvironment(identity.slice(
            environmentPrefix.size,
            identity.size
        ))
        if (observed.found) contents = observed.value
    } else if (ctNativeHostInputPrefix(identity) != "") {
        contents = ctNativeHostInputContents(identity)
    } else contents = Path(identity).readText()
    contents
}

fun bootstrapCompileInputsCurrent(parsed: BootstrapParseResult): bool {
    var current = parsed.compileInputPaths.size ==
        parsed.compileInputContents.size
    var input = 0
    while (current && input < parsed.compileInputPaths.size) {
        current = bootstrapCompileInputContents(
            parsed.compileInputPaths[input]
        ) == parsed.compileInputContents[input]
        input = input + 1
    }
    current
}

// Long-lived commands retain one state object across compilations. A normal
// one-shot build creates a fresh state, while `serve` reuses it and therefore
// rereads and rescans only files whose stat identity changed.
class BootstrapModuleState(
    val snapshots: array<BootstrapModuleSnapshot>,
    val frontends: array<BootstrapModuleFrontendSnapshot>,
    var reused: int,
    var refreshed: int,
    var reusedParsed: int,
    var refreshedParsed: int,
    var build: int,
    val acquiredIn: Map<string, int>,
    // Each snapshot's place in `snapshots`, by module path: a graph acquires a
    // module once per import edge that reaches it.
    val snapshotIndex: Map<string, int> = Map(),
    // What an import of each path exposes (bootstrapImportAliasExposedTarget), and the
    // build that found it: an entry.ab is read and parsed for that once per build, not
    // once per import edge that reaches it.
    val exposedTargets: Map<string, string> = Map(),
    val exposedIn: Map<string, int> = Map(),
    // A one-shot test-discovery handoff continues this same source snapshot,
    // rather than treating it as a later build and trusting file timestamps.
    var discoveryPrepared: bool = false,
    // Explicit per-build policy; ordinary parser/module APIs stay cache-free.
    var discoveryDirectory: string = "",
    var discoveryIdentity: string = "",
    var overlays: array<BootstrapModuleOverlay> = [],
    val overlaySnapshots: Map<string, bool> = Map(),
    var syntaxOnly: bool = false,
    val rawDiscoveredIn: Map<string, int> = Map()
) {
    fun beginBuild(): void {
        if (this.discoveryPrepared) this.discoveryPrepared = false
        else this.beginCounting()
        bootstrapSemanticUnit()
    }

    // A build counts each module once: the first acquisition stats the file
    // and later ones in the same build (an import's ambiguity check, then its
    // load) return that snapshot, so one build reads one version of a file.
    fun beginCounting(): void {
        this.reused = 0
        this.refreshed = 0
        this.reusedParsed = 0
        this.refreshedParsed = 0
        this.build = this.build + 1
        return
    }

    fun indexOf(modulePath: string): int {
        val found = this.snapshotIndex.get(modulePath)
        if (found != null) found else -1
    }

    fun exposedTarget(target: string): string {
        val foundIn = this.exposedIn.get(target)
        if (foundIn != null && foundIn == this.build) {
            val known = this.exposedTargets.get(target)
            if (known != null) return known
        }
        var exposed = target
        if (target.size >= 9 && target.slice(target.size - 9, target.size) == "/entry.ab") {
            // The import's graph load needs this same discovery snapshot.
            // Do not read and parse a second copy merely to classify an entry.
            val snapshot = this.acquire(target)
            if (snapshot.discovery.declarations.size == 0 &&
                snapshot.importErrors == 0 && snapshot.importEdges.size == 1 &&
                !snapshot.importEdges[0].provider && snapshot.importEdges[0].alias == "") {
                exposed = bootstrapResolveImport(target, snapshot.importEdges[0].source)
            }
        }
        this.exposedTargets.set(target, exposed)
        this.exposedIn.set(target, this.build)
        exposed
    }

    fun discover(
        source: string, modulePath: string, importErrors: int,
        first: int, second: int, mayUseRawProvider: bool
    ): BootstrapParseResult {
        var recordPath = ""
        if (this.discoveryDirectory != "" && source.size <= 4194304 && importErrors == 0 &&
            !mayUseRawProvider) {
            val identity = bootstrapDiscoveryHashes(modulePath)
            recordPath =
                "${this.discoveryDirectory}/${source.size}-$first-$second-${identity.first}-${identity.second}.discovery"
            val info = Path(recordPath).info()
            if (info.isFile() && info.size > 0 && info.size <= BOOTSTRAP_DISCOVERY_CODEC_LIMIT) {
                // Read at most the observed size plus one byte. A growing or
                // replaced cache file must not trigger an unbounded allocation.
                val record = linuxReadFile(recordPath, info.size + 1)
                val decoded = bootstrapDiscoveryDecode(
                    source, modulePath, record, this.discoveryIdentity
                )
                if (decoded.valid && bootstrapDiscoveryEligible(decoded.parsed)) {
                    bootstrapFrontendTraceMemory("discovery.hit:$modulePath")
                    return decoded.parsed
                }
            }
        }
        val parsed = bootstrapModuleDiscovery(source, modulePath)
        if (recordPath != "" && bootstrapDiscoveryEligible(parsed)) {
            val record = bootstrapDiscoveryRecord(
                source, modulePath, parsed, this.discoveryIdentity
            )
            if (record != "") Path(recordPath).writeTextAtomic(record)
        }
        parsed
    }

    fun overlayIndex(modulePath: string): int {
        var index = 0
        while (index < this.overlays.size) {
            if (this.overlays[index].path == modulePath) return index
            index = index + 1
        }
        -1
    }

    fun sourceExists(modulePath: string): bool =
        this.overlayIndex(modulePath) >= 0 || Path(modulePath).info().exists()

    fun acquire(modulePath: string): BootstrapModuleSnapshot {
        val existing = this.indexOf(modulePath)
        val acquiredIn = this.acquiredIn.get(modulePath)
        if (existing >= 0 && acquiredIn != null && acquiredIn == this.build) {
            return this.snapshots[existing]
        }
        this.acquiredIn.set(modulePath, this.build)
        val overlay = this.overlayIndex(modulePath)
        if (overlay >= 0) {
            val source = this.overlays[overlay]
            this.overlaySnapshots.set(modulePath, true)
            if (existing >= 0 && this.snapshots[existing].exists &&
                this.snapshots[existing].source == source.text) {
                this.reused = this.reused + 1
                return this.snapshots[existing]
            }
            val scan = bootstrapScanImports(source.text)
            val first = bootstrapModuleFingerprint(source.text, 17, 257, 1000000007)
            val second = bootstrapModuleFingerprint(source.text, 97, 263, 1000000009)
            val mayUseRaw = bootstrapMayUseRawProvider(source.text)
            val discovery = this.discover(source.text, modulePath, scan.errors, first, second, mayUseRaw)
            val snapshot = bootstrapModuleSnapshotFrozen(BootstrapModuleSnapshot(
                modulePath, source.text, scan.edges, scan.errors, true,
                source.text.size, source.version, first, second, discovery,
                [], "", [], mayUseRaw
            ))
            if (existing >= 0) this.snapshots[existing] = snapshot
            else {
                this.snapshotIndex.set(modulePath, this.snapshots.size)
                this.snapshots.append(snapshot)
            }
            this.refreshed = this.refreshed + 1
            return snapshot
        }
        val wasOverlay = this.overlaySnapshots.get(modulePath)
        if (wasOverlay != null && wasOverlay) this.overlaySnapshots.set(modulePath, false)
        val info = Path(modulePath).info()
        var reusable = false
        if (existing >= 0 && !(wasOverlay != null && wasOverlay)) {
            val snapshot = this.snapshots[existing]
            reusable = snapshot.exists == info.exists() &&
                snapshot.size == info.size &&
                snapshot.revision == info.revision
        }
        var result = BootstrapModuleSnapshot(
            modulePath,
            "",
            [],
            0,
            false,
            -1,
            0,
            0,
            0,
            BootstrapParseResult([], [], 0, 0, [], [], "")
        )
        if (reusable) {
            result = this.snapshots[existing]
            this.reused = this.reused + 1
        } else {
            val source = Path(modulePath).readText()
            val scan = bootstrapScanImports(source)
            val first = bootstrapModuleFingerprint(source, 17, 257, 1000000007)
            val second = bootstrapModuleFingerprint(source, 97, 263, 1000000009)
            val mayUseRaw = bootstrapMayUseRawProvider(source)
            val discovery = this.discover(source, modulePath, scan.errors, first, second, mayUseRaw)
            result = bootstrapModuleSnapshotFrozen(BootstrapModuleSnapshot(
                modulePath,
                source,
                scan.edges,
                scan.errors,
                info.exists(),
                info.size,
                info.revision,
                first,
                second,
                discovery,
                [], "", [], mayUseRaw
            ))
            if (existing >= 0) {
                this.snapshots[existing] = result
                0
            } else {
                this.snapshotIndex.set(modulePath, this.snapshots.size)
                this.snapshots.append(result)
                0
            }
            this.refreshed = this.refreshed + 1
        }
        result
    }

    fun replaceRawSnapshot(snapshot: BootstrapModuleSnapshot): BootstrapModuleSnapshot {
        val stored = bootstrapModuleSnapshotFrozen(snapshot)
        this.snapshots[this.indexOf(snapshot.path)] = stored
        stored
    }

    fun frontendIndex(
        snapshot: BootstrapModuleSnapshot,
        dependencyFingerprint: int
    ): int {
        var result = -1
        var index = 0
        while (index < this.frontends.size && result < 0) {
            val frontend = this.frontends[index]
            if (frontend.path == snapshot.path &&
                frontend.firstFingerprint == snapshot.firstFingerprint &&
                frontend.secondFingerprint == snapshot.secondFingerprint &&
                frontend.dependencyFingerprint == dependencyFingerprint) {
                result = index
            }
            index = index + 1
        }
        result
    }

    fun frontendPathIndex(modulePath: string): int {
        var result = -1
        var index = 0
        while (index < this.frontends.size && result < 0) {
            if (this.frontends[index].path == modulePath) result = index
            index = index + 1
        }
        result
    }

    fun acquireParsed(
        snapshot: BootstrapModuleSnapshot,
        dependencyFingerprint: int,
        declarations: array<BootstrapDeclaration>,
        currentDeclarationBegin: int,
        currentDeclarationCount: int,
        registry: BootstrapSubparserRegistry,
        allowedCompileEffects: int
    ): BootstrapParseResult {
        // Editor syntax mode must not touch the staged cache: neither reuse a
        // broader-policy result nor publish an incomplete parse into that cache. A module that uses a subparser of the
        // standard library is expanded (the staged parse, no cache); the others are parsed raw.
        if (this.syntaxOnly) {
            if (!bootstrapSourceUsesSubparser(snapshot.source, registry, snapshot.hostSource)) {
                return bootstrapParseWithTokens(snapshot.source, snapshot.path, bootstrapModuleTokens(snapshot))
            }
            return bootstrapParseStagedRegistered(
                snapshot.source, snapshot.path, declarations, currentDeclarationBegin, currentDeclarationCount, registry,
                allowedCompileEffects, snapshot.hostSource, snapshot.rawSites
            )
        }
        var existing = this.frontendIndex(
            snapshot,
            dependencyFingerprint
        )
        if (existing >= 0 && !bootstrapCompileInputsCurrent(
            this.frontends[existing].parsed
        )) existing = -1
        var result = BootstrapParseResult([], [], 0, 0, [], [], "")
        if (existing >= 0) {
            result = this.frontends[existing].parsed
            this.reusedParsed = this.reusedParsed + 1
        } else {
            result = bootstrapParseStagedRegistered(
                snapshot.source,
                snapshot.path,
                declarations,
                currentDeclarationBegin,
                currentDeclarationCount,
                registry,
                allowedCompileEffects,
                snapshot.hostSource,
                snapshot.rawSites
            )
            val replacement = BootstrapModuleFrontendSnapshot(
                snapshot.path,
                snapshot.firstFingerprint,
                snapshot.secondFingerprint,
                dependencyFingerprint,
                result
            )
            val samePath = this.frontendPathIndex(snapshot.path)
            if (samePath >= 0) {
                this.frontends[samePath] = replacement
                0
            } else {
                this.frontends.append(replacement)
                0
            }
            this.refreshedParsed = this.refreshedParsed + 1
        }
        result
    }
}

class BootstrapImportProviderDiscovery(
    val state: BootstrapModuleState,
    val ordered: array<BootstrapModuleSnapshot>,
    val paths: array<string>,
    var errors: int,
    var diagnostics: string
) {
    fun contains(path: string): bool {
        var found = false
        var index = 0
        while (index < this.paths.size) {
            if (this.paths[index] == path) found = true
            index = index + 1
        }
        found
    }

    fun collect(modulePath: string): void {
        val identity = bootstrapNormalizeModulePath(modulePath)
        if (!this.contains(identity)) {
            this.paths.append(identity)
            val snapshot = this.state.acquire(identity)
            this.errors = this.errors + snapshot.importErrors
            if (snapshot.importErrors > 0) {
                this.diagnostics =
                    "${this.diagnostics}${bootstrapScanImportsWithIdentity(snapshot.source, snapshot.path).diagnostics}"
            }
            var index = 0
            while (index < snapshot.importEdges.size) {
                val edge = snapshot.importEdges[index]
                if (!edge.provider) this.collect(bootstrapResolveImport(
                    identity, edge.source
                ))
                index = index + 1
            }
            this.ordered.append(snapshot)
        }
    }
}

// Literal package descriptors are data, not compile-time programs. Use the
// compiler parser and the evaluator's pure value constructors, never its AST
// dispatcher, user declarations, resolver closures, or native providers.
fun bootstrapLiteralImportValue(expression: BootstrapExpression, depth: int): BootstrapEvalValue {
    if (depth > 8 || expression.kind != "call") return bootstrapEvalNull()
    if (expression.text == "github" && expression.children.size == 1 &&
        expression.children[0].kind == "string" && expression.children[0].text.size <= 16384) {
        return bootstrapGithubImportValue(expression.children[0].text)
    }
    if (expression.text == "gitImportSource" && expression.children.size == 4) {
        for (child in expression.children) {
            if (child.kind != "string" || child.text.size > 16384) return bootstrapEvalNull()
        }
        return bootstrapGitImportValue(bootstrapEvalString(expression.children[0].text),
            bootstrapEvalString(expression.children[1].text),
            bootstrapEvalString(expression.children[2].text),
            bootstrapEvalString(expression.children[3].text))
    }
    if (expression.text == "importSubpath" && expression.children.size == 2 &&
        expression.children[1].kind == "string" && expression.children[1].text.size <= 16384) {
        val source = bootstrapLiteralImportValue(expression.children[0], depth + 1)
        if (source.kind == "object" && source.owner == "ImportSource" && source.elements.size ==
            11) {
            return bootstrapImportSubpathValue(source, expression.children[1].text)
        }
    }
    bootstrapEvalNull()
}

fun bootstrapLiteralImportProvider(
    expression: string, rootManifest: string,
    ordered: array<BootstrapModuleSnapshot>, current: BootstrapParseResult
): BootstrapImportProviderResult {
    val empty = BootstrapPackageDependency("", "", "", "", "", "", "", "", [])
    // A same-spelled callable may shadow the constructor. Keep this case
    // pending rather than pretending that the user's provider is builtin.
    for (snapshot in ordered) {
        for (declaration in snapshot.discovery.declarations) {
            if (declaration.name == "github" || declaration.name == "gitImportSource" ||
                declaration.name == "importSubpath") return BootstrapImportProviderResult(empty, 1,
                    "error[E_ANALYSIS_CT_REQUIRED]: analysis incomplete: shadowed import provider requires evaluation\n")
        }
    }
    for (declaration in current.declarations) {
        if (declaration.name == "github" || declaration.name == "gitImportSource" ||
            declaration.name == "importSubpath") return BootstrapImportProviderResult(empty, 1,
                "error[E_ANALYSIS_CT_REQUIRED]: analysis incomplete: shadowed import provider requires evaluation\n")
    }
    val parsed = bootstrapParse("#$expression")
    var value = bootstrapEvalNull()
    if (parsed.errors == 0 && parsed.actions.size == 1 &&
        parsed.actions[0].kind == "compile" && parsed.actions[0].children.size == 1) {
        value = bootstrapLiteralImportValue(parsed.actions[0].children[0], 0)
    }
    if (value.kind != "object") return BootstrapImportProviderResult(empty, 1,
        "error[E_ANALYSIS_CT_REQUIRED]: analysis incomplete: nonliteral import provider requires evaluation\n")
    val decoded = bootstrapPackageDependencyFromValue(value, false)
    if (decoded.errors != 0) return decoded
    if (rootManifest == "" || rootManifest == "-") return BootstrapImportProviderResult(empty, 1,
        "error[E_PACKAGE_LOCK_DISAGREEMENT]: literal provider requires a project manifest and lock\n")
    val lock = bootstrapPackageReadLock(Path(rootManifest).parent().child("abla.lock").text)
    val index = bootstrapPackageLockIndex(lock.packages, decoded.dependency.name)
    if (!lock.valid || index < 0 || !bootstrapPackageDependencyMatches(decoded.dependency,
        lock.packages[index])) {
        return BootstrapImportProviderResult(empty, 1,
            "error[E_PACKAGE_LOCK_DISAGREEMENT]: literal import provider does not match the root abla.lock; update packages explicitly\n")
    }
    decoded
}

fun bootstrapLiteralImportCurrent(rootManifest: string, dependency: BootstrapPackageDependency,
    imported: string): bool {
    if (rootManifest == "" || rootManifest == "-") return false
    val lock = bootstrapPackageReadLock(Path(rootManifest).parent().child("abla.lock").text)
    val index = bootstrapPackageLockIndex(lock.packages, dependency.name)
    if (!lock.valid || index < 0 || !bootstrapPackageDependencyMatches(dependency,
        lock.packages[index])) return false
    val package = lock.packages[index]
    val wrapper = Path(imported).parent()
    if (wrapper.name() == dependency.name && wrapper.parent().name() == "packages") {
        return wrapper.child("revision").readText() == package.revision &&
            wrapper.child("digest").readText() == package.digest &&
            wrapper.child("source-url").readText() == package.source
    }
    val vendor = bootstrapPackageRootOfEntry(imported, dependency.name)
    vendor != "" && Path(vendor).child(".abla-revision").readText() == package.revision &&
        Path(vendor).child(".abla-digest").readText() == package.digest
}

fun bootstrapEvaluateImportProvider(
    expression: string,
    ordered: array<BootstrapModuleSnapshot>,
    current: BootstrapParseResult,
    resolve: bool = false,
    resolveEffects: int = 0
): BootstrapImportProviderResult {
    val declarations: array<BootstrapDeclaration> = []
    var moduleIndex = 0
    while (moduleIndex < ordered.size) {
        var declaration = 0
        while (declaration < ordered[moduleIndex].discovery.declarations.size) {
            declarations.append(
                ordered[moduleIndex].discovery.declarations[declaration]
            )
            declaration = declaration + 1
        }
        moduleIndex = moduleIndex + 1
    }
    var declaration = 0
    while (declaration < current.declarations.size) {
        declarations.append(current.declarations[declaration])
        declaration = declaration + 1
    }
    var requestedExpression = expression
    if (resolve) requestedExpression =
        "__ablaResolveImportSource($expression)"
    val parsed = bootstrapParse("#$requestedExpression")
    var errors = parsed.errors
    var diagnostic = ""
    var dependency = BootstrapPackageDependency(
        "", "", "", "", "", "", "", "", []
    )
    val unquoted = bootstrapUnquotedImportDiagnostic(expression)
    if (unquoted != "") return BootstrapImportProviderResult(dependency, 1, unquoted)
    if (errors == 0 && parsed.actions.size == 1) {
        // Bit 1024 is private authority to invoke a deferred ImportSource
        // resolver; ordinary compile-time evaluation never receives it.
        val allowedEffects = if (resolve) resolveEffects + 1024 else 0
        val evaluated = bootstrapEvaluateWithEffects(
            parsed.actions[0], declarations, allowedEffects
        )
        errors = errors + evaluated.errors
        diagnostic = evaluated.diagnostics
        if (resolve && evaluated.errors > 0) {
            diagnostic =
                "${diagnostic}error[E_IMPORT_PROVIDER_EFFECT_DENIED]: deferred resolver failed; authorize any required effects in the root manifest compileCapabilities\n"
        }
        if (evaluated.value.kind == "object" &&
            evaluated.value.owner == "ImportSource") {
            val decoded = bootstrapPackageDependencyFromValue(
                evaluated.value, resolve
            )
            dependency = decoded.dependency
            errors = errors + decoded.errors
            diagnostic = "$diagnostic${decoded.diagnostic}"
        } else {
            errors = errors + 1
            diagnostic =
                "${diagnostic}error[E_IMPORT_PROVIDER_RESULT]: import provider '$expression' must return ImportSource\n"
        }
    } else {
        errors = errors + 1
        diagnostic =
            "error[E_IMPORT_PROVIDER_PARSE]: invalid import provider expression '$expression'\n"
    }
    BootstrapImportProviderResult(dependency, errors, diagnostic)
}

fun bootstrapDiscoverImportProviders(
    entry: string,
    resolve: bool = false,
    resolveEffects: int = 0
): BootstrapPackageDependencies {
    val discovery = BootstrapImportProviderDiscovery(
        bootstrapModuleState(), [], [], 0, ""
    )
    discovery.collect(entry)
    val dependencies: array<BootstrapPackageDependency> = []
    var moduleIndex = 0
    while (moduleIndex < discovery.ordered.size) {
        val snapshot = discovery.ordered[moduleIndex]
        var edgeIndex = 0
        while (edgeIndex < snapshot.importEdges.size) {
            val edge = snapshot.importEdges[edgeIndex]
            if (edge.provider) {
                val provider = bootstrapEvaluateImportProvider(
                    edge.source, discovery.ordered,
                    BootstrapParseResult([], [], 0, 0, [], [], ""),
                    resolve, resolveEffects
                )
                discovery.errors = discovery.errors + provider.errors
                discovery.diagnostics =
                    "${discovery.diagnostics}${provider.diagnostic}"
                val existing = bootstrapPackageDependencyIndex(
                    dependencies, provider.dependency.name
                )
                if (provider.errors == 0 && existing < 0) {
                    dependencies.append(provider.dependency)
                }
                if (provider.errors == 0 && existing >= 0) {
                    bootstrapPackageAddSubpaths(dependencies[existing], provider.dependency)
                }
                if (provider.errors == 0 && existing >= 0 &&
                    (dependencies[existing].source !=
                        provider.dependency.source ||
                     dependencies[existing].selectorKind !=
                        provider.dependency.selectorKind ||
                     dependencies[existing].selector !=
                        provider.dependency.selector)) {
                    discovery.errors = discovery.errors + 1
                    discovery.diagnostics =
                        "${discovery.diagnostics}error[E_PACKAGE_COLLISION]: import providers request incompatible sources or selectors for dependency '${provider.dependency.name}'\n"
                }
            }
            edgeIndex = edgeIndex + 1
        }
        moduleIndex = moduleIndex + 1
    }
    BootstrapPackageDependencies(
        dependencies, discovery.errors, discovery.diagnostics
    )
}

fun bootstrapModuleState(): BootstrapModuleState =
    BootstrapModuleState([], [], 0, 0, 0, 0, 0, Map())

fun bootstrapManifestCompileCapabilities(
    modulePath: string
): array<string> {
    val capabilities: array<string> = []
    var manifestPath = Path(modulePath).parent().child("abla.toml")
    var directory = Path(modulePath).parent()
    var searching = !manifestPath.exists()
    var depth = 0
    while (searching && depth < 128) {
        val parent = directory.parent()
        if (parent.text == directory.text) searching = false
        directory = parent
        val candidate = directory.child("abla.toml")
        if (candidate.exists()) {
            manifestPath = candidate
            searching = false
        }
        depth = depth + 1
    }
    val source = manifestPath.readText()
    var lineBegin = 0
    var arrayCursor = -1
    while (lineBegin < source.size && arrayCursor < 0) {
        var lineEnd = lineBegin
        while (lineEnd < source.size && source[lineEnd] != 10 &&
               source[lineEnd] != 13) lineEnd = lineEnd + 1
        var contentEnd = lineEnd
        var comment = lineBegin
        while (comment < contentEnd && source[comment] != 35) {
            comment = comment + 1
        }
        if (comment < contentEnd) contentEnd = comment
        var equals = lineBegin
        while (equals < contentEnd && source[equals] != 61) {
            equals = equals + 1
        }
        var keyBegin = lineBegin
        while (keyBegin < equals &&
               (source[keyBegin] == 32 || source[keyBegin] == 9)) {
            keyBegin = keyBegin + 1
        }
        var keyEnd = equals
        while (keyEnd > keyBegin &&
               (source[keyEnd - 1] == 32 || source[keyEnd - 1] == 9)) {
            keyEnd = keyEnd - 1
        }
        if (equals < contentEnd &&
            source.slice(keyBegin, keyEnd) == "compileCapabilities") {
            var index = equals + 1
            while (index < contentEnd &&
                   (source[index] == 32 || source[index] == 9)) {
                index = index + 1
            }
            if (index < contentEnd && source[index] == 91) {
                arrayCursor = index + 1
            }
        }
        lineBegin = lineEnd + 1
        if (lineBegin < source.size && source[lineBegin - 1] == 13 &&
            source[lineBegin] == 10) lineBegin = lineBegin + 1
    }
    var complete = false
    while (arrayCursor >= 0 && arrayCursor < source.size && !complete) {
        while (arrayCursor < source.size &&
               (source[arrayCursor] == 32 || source[arrayCursor] == 9 ||
                source[arrayCursor] == 10 || source[arrayCursor] == 13 ||
                source[arrayCursor] == 44)) arrayCursor = arrayCursor + 1
        if (arrayCursor < source.size && source[arrayCursor] == 35) {
            while (arrayCursor < source.size &&
                   source[arrayCursor] != 10 && source[arrayCursor] != 13) {
                arrayCursor = arrayCursor + 1
            }
        } else if (arrayCursor < source.size && source[arrayCursor] == 93) {
            complete = true
        } else if (arrayCursor < source.size && source[arrayCursor] == 34) {
            val begin = arrayCursor + 1
            arrayCursor = begin
            while (arrayCursor < source.size &&
                   source[arrayCursor] != 34 &&
                   source[arrayCursor] != 10 &&
                   source[arrayCursor] != 13) {
                arrayCursor = arrayCursor + 1
            }
            if (arrayCursor < source.size && source[arrayCursor] == 34) {
                val capability = source.slice(begin, arrayCursor)
                if (capabilities.size < 64 &&
                    bootstrapCompileEffectFromName(capability) != 0 &&
                    !bootstrapAffineNamesContain(
                        capabilities,
                        capability
                    )) capabilities.append(capability)
                arrayCursor = arrayCursor + 1
            } else complete = true
        } else complete = true
    }
    capabilities
}

// The bootstrap package reader intentionally accepts a small deterministic
// TOML subset. String fields provide root/package identity and entry selection;
// import providers and lock records use the bounded package scanner.
fun bootstrapTomlStringField(manifestPath: string, key: string): string {
    val source = Path(manifestPath).readText()
    var result = ""
    var lineBegin = 0
    while (lineBegin < source.size && result == "") {
        var lineEnd = lineBegin
        while (lineEnd < source.size && source[lineEnd] != 10 &&
               source[lineEnd] != 13) lineEnd = lineEnd + 1
        var equals = lineBegin
        while (equals < lineEnd && source[equals] != 61) equals = equals + 1
        var keyBegin = lineBegin
        while (keyBegin < equals &&
               (source[keyBegin] == 32 || source[keyBegin] == 9)) {
            keyBegin = keyBegin + 1
        }
        var keyEnd = equals
        while (keyEnd > keyBegin &&
               (source[keyEnd - 1] == 32 || source[keyEnd - 1] == 9)) {
            keyEnd = keyEnd - 1
        }
        if (equals < lineEnd &&
            source.slice(keyBegin, keyEnd) == key) {
            var valueBegin = equals + 1
            while (valueBegin < lineEnd &&
                   (source[valueBegin] == 32 || source[valueBegin] == 9)) {
                valueBegin = valueBegin + 1
            }
            if (valueBegin < lineEnd && source[valueBegin] == 34) {
                val begin = valueBegin + 1
                var end = begin
                while (end < lineEnd && source[end] != 34) end = end + 1
                if (end < lineEnd) result = source.slice(begin, end)
            }
        }
        lineBegin = lineEnd + 1
        if (lineBegin < source.size && source[lineBegin - 1] == 13 &&
            source[lineBegin] == 10) lineBegin = lineBegin + 1
    }
    result
}

class BootstrapProjectDescriptor(
    val root: string,
    val name: string,
    val version: string,
    val entry: string,
    val output: string,
    val valid: bool,
    val diagnostic: string
)

fun bootstrapProjectDescriptor(root: string): BootstrapProjectDescriptor {
    val projectRoot = Path(root)
    val manifest = projectRoot.child("abla.toml")
    var name = bootstrapTomlStringField(manifest.text, "name")
    val version = bootstrapTomlStringField(manifest.text, "version")
    var relativeEntry = bootstrapTomlStringField(manifest.text, "entry")
    if (name == "") name = "abla-out"
    if (relativeEntry == "") relativeEntry = "src/main.ab"
    val entry = projectRoot.child(relativeEntry)
    var valid = manifest.exists()
    var diagnostic = ""
    if (!valid) diagnostic = "missing package manifest: ${manifest.text}"
    if (valid && !bootstrapPackageNameValid(name)) {
        valid = false
        diagnostic = "invalid package name '$name'"
    }
    if (valid && !bootstrapPackageRelativePathValid(relativeEntry)) {
        valid = false
        diagnostic = "package entry must be a safe relative path"
    }
    if (valid && !entry.exists()) {
        valid = false
        diagnostic = "package entry does not exist: ${entry.text}"
    }
    BootstrapProjectDescriptor(
        projectRoot.text,
        name,
        version,
        entry.text,
        projectRoot.child("build").child(name).text,
        valid,
        diagnostic
    )
}

class BootstrapModule(
    val path: string,
    val source: string,
    val hostSource: string = ""
)

fun bootstrapParseModuleSurface(module: BootstrapModule): BootstrapParseResult =
    if (module.hostSource == "") bootstrapParseWithIdentity(module.source, module.path)
    else bootstrapParseWithTokens(module.source, module.path, bootstrapRawHostTokens(module.hostSource))

class BootstrapModuleAlias(
    val importer: string,
    val target: string,
    val alias: string,
    val contractOnly: bool,
    val begin: int,
    val end: int,
    val exported: bool = false,
    // The import as written (`abla/fs` resolves to another module).
    val written: string = ""
)

// What a graph's import edges say about each module, looked up instead of
// scanning every edge per module: the modules imported under an alias
// somewhere (their names carry the module prefix) or only for their contract,
// the modules imported as a contract by code of a program that also has their
// implementations (bootstrapContractTwin), each importer's edges in order
// (`firstEdge`, then `nextEdge`), and the place of each module in the snapshots.
class BootstrapAliasSummary(
    val aliasedTargets: Map<string, int>,
    val contractTargets: Map<string, int>,
    val fullModules: Map<string, int>,
    val twinnedTargets: Map<string, int>,
    val importers: Map<string, int>,
    val firstEdge: array<int>,
    val lastEdge: array<int>,
    val nextEdge: array<int>,
    val snapshotIndex: Map<string, int>
) {
    fun targetPrefix(target: string): string =
        if (this.aliasedTargets.get(target) != null)
            bootstrapModuleCanonicalPrefix(target) else ""

    fun isContractTarget(target: string): bool =
        this.contractTargets.get(target) != null

    /** Whether `edge`'s functions mean the target's contract twin. */
    fun isTwinEdge(edge: BootstrapModuleAlias): bool =
        edge.contractOnly && this.fullModules.has(edge.importer) &&
            this.fullModules.has(edge.target)

    /** The first of `importer`'s edges, or -1; nextEdge gives the next. */
    fun firstEdgeOf(importer: string): int {
        val slot = this.importers.get(importer)
        if (slot != null) this.firstEdge[slot] else -1
    }
}

/** `target` and every module its `export import`s pass on, nearest first. */
fun bootstrapAliasReachedModules(
    target: string,
    aliases: array<BootstrapModuleAlias>,
    summary: BootstrapAliasSummary? = null
): array<string> {
    val reached = [target]
    var next = 0
    while (next < reached.size) {
        val from = reached[next]
        var edgeIndex = if (summary == null) 0 else summary.firstEdgeOf(from)
        while (edgeIndex >= 0 && edgeIndex < aliases.size) {
            val edge = aliases[edgeIndex]
            if (edge.exported && edge.alias == "" && edge.importer == from &&
                !bootstrapAffineNamesContain(reached, edge.target)) {
                reached.append(edge.target)
            }
            edgeIndex = if (summary == null) edgeIndex + 1 else summary.nextEdge[edgeIndex]
        }
        next = next + 1
    }
    reached
}

/** The modules an alias of `target` finds `member` in: `target` alone when it
 *  declares it (as a module's own declaration shadows), else each module its
 *  `export import`s pass on that does. */
fun bootstrapAliasMemberModules(
    target: string,
    member: string,
    aliases: array<BootstrapModuleAlias>,
    snapshots: array<BootstrapModuleSnapshot>
): array<string> {
    val found: array<string> = []
    for (module in bootstrapAliasReachedModules(target, aliases)) {
        val snapshot = bootstrapSnapshotIndex(snapshots, module)
        if (snapshot >= 0) {
            var declares = false
            for (declaration in snapshots[snapshot].discovery.declarations) {
                if (declaration.name == member && !declaration.isPrivate) declares = true
            }
            if (declares) {
                if (module == target) return [target]
                found.append(module)
            }
        }
    }
    found
}

fun bootstrapAliasSummary(
    aliases: array<BootstrapModuleAlias>,
    snapshots: array<BootstrapModuleSnapshot>,
    fullModules: Map<string, int>
): BootstrapAliasSummary {
    val summary = BootstrapAliasSummary(Map(), Map(), fullModules, Map(), Map(), [], [], [], Map())
    var index = 0
    while (index < aliases.size) {
        val alias = aliases[index]
        if (alias.alias != "") {
            // What an alias reaches through the module's `export import`s
            // carries its prefix too.
            for (target in bootstrapAliasReachedModules(alias.target, aliases)) {
                summary.aliasedTargets.set(target, 1)
            }
        }
        if (alias.contractOnly && !fullModules.has(alias.target)) {
            summary.contractTargets.set(alias.target, 1)
        }
        if (summary.isTwinEdge(alias)) {
            summary.twinnedTargets.set(alias.target, 1)
            summary.contractTargets.set(bootstrapContractTwinPath(alias.target), 1)
        }
        var slot = summary.firstEdge.size
        val known = summary.importers.get(alias.importer)
        if (known != null) {
            slot = known
            summary.nextEdge[summary.lastEdge[slot]] = index
        } else {
            summary.importers.set(alias.importer, slot)
            summary.firstEdge.append(index)
            summary.lastEdge.append(index)
        }
        summary.lastEdge[slot] = index
        summary.nextEdge.append(-1)
        index = index + 1
    }
    index = 0
    while (index < snapshots.size) {
        summary.snapshotIndex.set(snapshots[index].path, index)
        index = index + 1
    }
    summary
}

fun bootstrapContractDeclaration(
    declaration: BootstrapDeclaration,
    moduleIdentity: string,
    name: string = declaration.name
): BootstrapDeclaration {
    val annotations: array<string> = []
    var annotation = 0
    while (annotation < declaration.annotations.size) {
        annotations.append(declaration.annotations[annotation])
        annotation = annotation + 1
    }
    val kind = if (declaration.kind == "fun") "extern" else declaration.kind
    val externalLibrary = if (declaration.kind == "fun") {
        "contract:$moduleIdentity"
    } else declaration.externalLibrary
    BootstrapDeclaration(
        kind,
        name,
        declaration.begin,
        declaration.end,
        BootstrapExpression(
            "missing", "contract", declaration.begin, declaration.end, []
        ),
        declaration.parameters,
        declaration.parameterTypes,
        declaration.resultType,
        [],
        declaration.parameterDefaults,
        externalLibrary,
        declaration.parameterKinds,
        declaration.extensionOwner,
        declaration.isTrusted,
        declaration.isResource,
        declaration.isNoEscape,
        declaration.generatedNamespace,
        declaration.generatedOriginBegin,
        declaration.generatedOriginEnd,
        annotations,
        declaration.annotationArguments,
        declaration.annotationBegins,
        declaration.annotationEnds,
        declaration.sourceIdentity,
        declaration.conformances,
        declaration.isSealed,
        declaration.isPrivate,
        declaration.typeParameters
    )
}

// Explicit contracts keep their API functions. Ordinary dependencies provide
// type shapes only, never remote externs for implementation helpers.
fun bootstrapProjectContract(
    parsed: BootstrapParseResult,
    moduleIdentity: string,
    typesOnly: bool = false
): BootstrapParseResult {
    val declarations: array<BootstrapDeclaration> = []
    var index = 0
    while (index < parsed.declarations.size) {
        val declaration = parsed.declarations[index]
        if ((!typesOnly && declaration.kind == "fun") || declaration.kind == "class" ||
            declaration.kind == "interface" || declaration.kind == "extend") {
            declarations.append(bootstrapContractDeclaration(
                declaration, moduleIdentity
            ))
        }
        index = index + 1
    }
    BootstrapParseResult(
        declarations,
        [],
        parsed.errors,
        parsed.extensionErrors,
        [],
        [],
        parsed.diagnostics, [], parsed.stackDepthStoppedSources
    )
}

// A program that has a module's implementations can also import it as a
// contract: a web server running its own client code does. The importer's
// calls must stay contract calls, as they are in a client build, so the
// functions also exist as a twin, a pseudo-module of contract functions next to
// the real one. Classes aren't twinned: both sides mean the same types.
fun bootstrapContractTwinPath(modulePath: string): string = "$modulePath#contract"

fun bootstrapIsTwinFunction(declaration: BootstrapDeclaration): bool =
    declaration.kind == "fun" && declaration.extensionOwner == "" &&
        !declaration.isPrivate && declaration.name != ""

/** Declares `snapshot`'s functions (as prepared: their types use final names). */
fun bootstrapContractTwinSnapshot(
    snapshot: BootstrapModuleSnapshot
): BootstrapModuleSnapshot {
    val path = bootstrapContractTwinPath(snapshot.path)
    val prefix = bootstrapModuleCanonicalPrefix(path)
    val declarations: array<BootstrapDeclaration> = []
    for (declaration in snapshot.discovery.declarations) {
        if (bootstrapIsTwinFunction(declaration)) {
            declarations.append(bootstrapContractDeclaration(
                declaration, snapshot.path,
                "$prefix${bootstrapCanonicalDeclarationSourceName(declaration.name)}"
            ))
        }
    }
    val discovery = BootstrapParseResult(
        declarations, [], 0, 0, [], [], ""
    )
    val identity = bootstrapModuleInterfaceIdentity(discovery, 0, 0)
    BootstrapModuleSnapshot(
        path, "", [], 0, true, 0, 0,
        bootstrapModuleFingerprint(identity, 17, 257, 1000000007),
        bootstrapModuleFingerprint(identity, 97, 263, 1000000009),
        discovery
    )
}

fun bootstrapContractTypeMentions(typeName: string, name: string): bool {
    var found = false
    var offset = 0
    while (!found && offset + name.size <= typeName.size) {
        val before = offset == 0 ||
            !bootstrapIsAlphaNumeric(typeName[offset - 1])
        val afterOffset = offset + name.size
        val after = afterOffset == typeName.size ||
            !bootstrapIsAlphaNumeric(typeName[afterOffset])
        if (before && after && bootstrapRegionEquals(
            typeName, offset, afterOffset, name
        )) found = true
        offset = offset + 1
    }
    found
}

fun bootstrapContractShapeMentions(
    parsed: BootstrapParseResult,
    name: string
): bool {
    var found = false
    var declaration = 0
    while (!found && declaration < parsed.declarations.size) {
        val current = parsed.declarations[declaration]
        if (bootstrapContractTypeMentions(current.resultType, name)) {
            found = true
        }
        var parameter = 0
        while (!found && parameter < current.parameterTypes.size) {
            found = bootstrapContractTypeMentions(
                current.parameterTypes[parameter], name
            )
            parameter = parameter + 1
        }
        var method = 0
        while (!found && method < current.methods.size) {
            val member = current.methods[method]
            if (bootstrapContractTypeMentions(member.resultType, name)) {
                found = true
            }
            parameter = 0
            while (!found && parameter < member.parameterTypes.size) {
                found = bootstrapContractTypeMentions(
                    member.parameterTypes[parameter], name
                )
                parameter = parameter + 1
            }
            method = method + 1
        }
        declaration = declaration + 1
    }
    found
}

fun bootstrapContractImportRequired(
    parsed: BootstrapParseResult,
    edge: BootstrapImportEdge,
    imported: BootstrapParseResult
): bool {
    var required = edge.alias != "" &&
        bootstrapContractShapeMentions(parsed, edge.alias)
    var declaration = 0
    while (!required && edge.alias == "" &&
           declaration < imported.declarations.size) {
        val candidate = imported.declarations[declaration]
        if ((candidate.kind == "class" || candidate.kind == "interface") &&
            bootstrapContractShapeMentions(parsed, candidate.name)) {
            required = true
        }
        declaration = declaration + 1
    }
    required
}

fun bootstrapExpressionDeclaresAliasBefore(
    expression: BootstrapExpression,
    alias: string,
    position: int
): bool {
    var found = (expression.kind == "local.val" ||
        expression.kind == "local.var") &&
        expression.text == alias && expression.begin <= position
    var child = 0
    while (child < expression.children.size && !found) {
        found = bootstrapExpressionDeclaresAliasBefore(
            expression.children[child], alias, position
        )
        child = child + 1
    }
    found
}

fun bootstrapAliasShadowedAt(
    parsed: BootstrapParseResult,
    alias: string,
    position: int
): bool {
    var shadowed = false
    var declaration = 0
    while (declaration < parsed.declarations.size && !shadowed) {
        val found = parsed.declarations[declaration]
        if (position >= found.begin && position <= found.end) {
            var parameter = 0
            while (parameter < found.parameters.size && !shadowed) {
                if (found.parameters[parameter] == alias) shadowed = true
                parameter = parameter + 1
            }
            if (!shadowed) shadowed = bootstrapExpressionDeclaresAliasBefore(
                found.expression, alias, position
            )
        }
        declaration = declaration + 1
    }
    shadowed
}

// A module's top-level declaration shadows a same-named declaration of a
// module it imports, directly or through others: it carries its module prefix
// in the module and in the modules that import it plainly, so the two are not
// duplicates. A same-named function with other parameters is an overload, not
// a shadow. A runtime platform module's own names (the C externs `malloc`,
// `write`, `pthread_*`) are private the same way, so a program may declare
// them. Two imported modules that both declare a name and neither imports the
// other (abla/tls/hosted's and abla/tls/pure's TlsConnection) each carry their
// prefix the same way, and a module that reaches only one of them, or one
// nearer than the others, through its plain imports means that one
// (`boundNames`, declared in `boundModules`). The runtime's modules keep their
// names: a program's same-named declaration stays a duplicate.
class BootstrapModuleShadow(
    val module: string,
    val names: array<string>,
    val boundNames: array<string> = [],
    val boundModules: array<string> = []
)

fun bootstrapModuleShadowIndex(
    shadows: array<BootstrapModuleShadow>,
    module: string
): int {
    var result = -1
    var index = 0
    while (index < shadows.size && result < 0) {
        if (shadows[index].module == module) result = index
        index = index + 1
    }
    result
}

fun bootstrapRuntimeSelfModulePath(): string =
    bootstrapNormalizeModulePath(Path(bootstrapStandardLibraryRoot()).child("abla/runtime/self/entry.ab").text)

fun bootstrapRuntimePlatformModule(path: string): bool {
    val platform = Path(bootstrapStandardLibraryRoot()).child(
        "abla/runtime/platform"
    )
    path == bootstrapNormalizeModulePath(platform.child("host.ab").text) ||
        path == bootstrapNormalizeModulePath(platform.child("host_os.ab").text) ||
        path == bootstrapNormalizeModulePath(platform.child("wasm.ab").text)
}

fun bootstrapModuleShadowable(declaration: BootstrapDeclaration): bool =
    declaration.name != "" && declaration.extensionOwner == "" &&
    (declaration.kind == "fun" || declaration.kind == "extern" ||
     declaration.kind == "compile.fun" || declaration.kind == "class" ||
     declaration.kind == "interface" || declaration.kind == "type" ||
     bootstrapDeclarationIsValue(declaration.kind))

fun bootstrapModuleDeclares(
    discovery: BootstrapParseResult,
    name: string
): bool {
    var found = false
    var declaration = 0
    while (declaration < discovery.declarations.size && !found) {
        if (discovery.declarations[declaration].extensionOwner == "" &&
            discovery.declarations[declaration].kind != "extend" &&
            discovery.declarations[declaration].name == name) found = true
        declaration = declaration + 1
    }
    found
}

// Whether module `from` imports module `to`, directly or through others.
fun bootstrapModuleReaches(
    from: int,
    to: int,
    edgeImporters: array<int>,
    edgeTargets: array<int>,
    moduleCount: int
): bool {
    val visited = filledArray(moduleCount, false)
    val pending: array<int> = [from]
    visited[from] = true
    var found = false
    while (pending.size > 0 && !found) {
        val module = pending[pending.size - 1]
        pending.truncate(pending.size - 1)
        var edge = 0
        while (edge < edgeImporters.size) {
            val target = edgeTargets[edge]
            if (edgeImporters[edge] == module && target >= 0 &&
                !visited[target]) {
                if (target == to) found = true
                visited[target] = true
                pending.append(target)
            }
            edge = edge + 1
        }
    }
    found
}

fun bootstrapCollectShadowEntries(
    snapshot: BootstrapModuleSnapshot,
    module: int,
    var shadowModules: array<int>,
    var shadowNames: array<string>,
    var entryModules: array<int>,
    var entryDeclarations: array<int>,
    var entryNames: array<string>
): void {
    val platform = bootstrapRuntimePlatformModule(snapshot.path)
    val program = !bootstrapStandardLibraryModuleSource(snapshot.path)
    var declaration = 0
    while (declaration < snapshot.discovery.declarations.size) {
        val candidate = snapshot.discovery.declarations[declaration]
        val name = candidate.name
        // A private name is its module's alone (bootstrapAppendPrivateNames).
        if (bootstrapModuleShadowable(candidate) && !candidate.isPrivate) {
            // A program's declaration named like a built-in hides it where it
            // is seen; the standard library keeps the built-in.
            if ((platform && !(name.size >= 6 &&
                name.slice(0, 6) == "__abla")) ||
                (program && bootstrapBuiltinCallableName(name))) {
                shadowModules.append(module)
                shadowNames.append(name)
            } else {
                entryModules.append(module)
                entryDeclarations.append(declaration)
                entryNames.append(name)
            }
        }
        declaration = declaration + 1
    }
    return
}

/** The built-ins the compiler recognizes by the name a call or type writes. */
fun bootstrapBuiltinCallableName(name: string): bool =
    name == "Cell" || name == "Shared" || name == "Mutex" || name == "Map" ||
    name == "filledArray" || name == "move"

fun bootstrapAppendShadowNames(
    shadow: BootstrapModuleShadow,
    prefix: string,
    importer: BootstrapParseResult,
    skipDeclared: bool,
    var names: array<string>,
    var replacements: array<string>
): void {
    var index = 0
    while (index < shadow.names.size) {
        val name = shadow.names[index]
        if (!skipDeclared || !bootstrapModuleDeclares(importer, name)) {
            names.append(name)
            replacements.append("$prefix$name")
        }
        index = index + 1
    }
    return
}

fun bootstrapModuleShadows(
    aliases: array<BootstrapModuleAlias>,
    snapshots: array<BootstrapModuleSnapshot>,
    summary: BootstrapAliasSummary
): array<BootstrapModuleShadow> {
    val shadowModules: array<int> = []
    val shadowNames: array<string> = []
    val entryModules: array<int> = []
    val entryDeclarations: array<int> = []
    val entryNames: array<string> = []
    var module = 0
    while (module < snapshots.size) {
        // An aliased module's names all carry its prefix already.
        if (summary.targetPrefix(snapshots[module].path) == "") {
            bootstrapCollectShadowEntries(
                snapshots[module], module, shadowModules, shadowNames,
                entryModules, entryDeclarations, entryNames
            )
        }
        module = module + 1
    }
    // Chain the entries of each name: `heads` holds a name's first entry,
    // `chains` the next entry of the same name.
    var capacity = 8
    while (capacity < entryNames.size * 2 + 1) capacity = capacity * 2
    val heads = filledArray(capacity, -1)
    val chains = filledArray(entryNames.size, -1)
    val shared: array<int> = []
    var entry = 0
    while (entry < entryNames.size) {
        var slot = bootstrapNamedTargetHash(entryNames[entry])
        slot = slot - slot / capacity * capacity
        var placed = false
        while (!placed) {
            val head = heads[slot]
            if (head < 0) {
                heads[slot] = entry
                placed = true
            } else if (entryNames[head] == entryNames[entry]) {
                if (chains[head] < 0) shared.append(head)
                chains[entry] = chains[head]
                chains[head] = entry
                placed = true
            } else {
                slot = slot + 1
                if (slot == capacity) slot = 0
            }
        }
        entry = entry + 1
    }
    // Names that two sibling modules (neither imports the other) declare:
    // each such module's declaration carries its prefix, and every module
    // that only reaches one of them through its imports means that one.
    val siblingNames: array<string> = []
    if (shared.size > 0) {
        val edgeImporters: array<int> = []
        val edgeTargets: array<int> = []
        // Whether a module is imported by another (the root and the modules
        // the build brings in by itself are not), and the plain edges.
        val imported = filledArray(snapshots.size, false)
        var edge = 0
        while (edge < aliases.size) {
            val importer = summary.snapshotIndex.get(aliases[edge].importer)
            val target = summary.snapshotIndex.get(aliases[edge].target)
            edgeImporters.append(if (importer != null) importer else -1)
            edgeTargets.append(if (target != null) target else -1)
            if (target != null) imported[target] = true
            edge = edge + 1
        }
        var group = 0
        while (group < shared.size) {
            var first = shared[group]
            while (first >= 0) {
                val firstDeclaration = snapshots[entryModules[first]]
                    .discovery.declarations[entryDeclarations[first]]
                var shadows = false
                var sibling = false
                var shadowed = -1
                var second = shared[group]
                while (second >= 0 && !shadows && !sibling) {
                    if (entryModules[second] != entryModules[first] &&
                        !bootstrapDeclarationsOverload(
                            firstDeclaration,
                            snapshots[entryModules[second]]
                                .discovery.declarations[
                                    entryDeclarations[second]
                                ]
                        )) {
                        if (bootstrapModuleReaches(
                            entryModules[first], entryModules[second],
                            edgeImporters, edgeTargets, snapshots.size
                        )) {
                            shadows = true
                            shadowed = second
                        } else if (bootstrapModuleSiblingShadowable(
                                snapshots[entryModules[first]].path,
                                imported[entryModules[first]]
                            ) && bootstrapModuleSiblingShadowable(
                                snapshots[entryModules[second]].path,
                                imported[entryModules[second]]
                            ) && !bootstrapModuleReaches(
                                entryModules[second], entryModules[first],
                                edgeImporters, edgeTargets, snapshots.size
                            )) {
                            sibling = true
                        }
                    }
                    second = chains[second]
                }
                // The program's entry point keeps its name: an imported
                // module's `main` becomes private to that module instead.
                if (shadows && entryNames[first] == "main") {
                    shadowModules.append(entryModules[shadowed])
                    shadowNames.append(entryNames[shadowed])
                } else if (shadows || sibling) {
                    shadowModules.append(entryModules[first])
                    shadowNames.append(entryNames[first])
                }
                if (sibling && !bootstrapAffineNamesContain(siblingNames, entryNames[first])) {
                    siblingNames.append(entryNames[first])
                }
                first = chains[first]
            }
            group = group + 1
        }
    }
    val result: array<BootstrapModuleShadow> = []
    module = 0
    while (module < snapshots.size) {
        val names: array<string> = []
        var index = 0
        while (index < shadowModules.size) {
            if (shadowModules[index] == module &&
                !bootstrapAffineNamesContain(names, shadowNames[index])) {
                names.append(shadowNames[index])
            }
            index = index + 1
        }
        val bound = bootstrapSiblingBindings(
            module, siblingNames, aliases, snapshots, summary,
            entryModules, entryNames, shadowModules, shadowNames
        )
        if (names.size > 0 || bound.size > 0) {
            val boundTargets: array<string> = []
            val boundNames: array<string> = []
            index = 0
            while (index + 1 < bound.size) {
                boundNames.append(bound[index])
                boundTargets.append(bound[index + 1])
                index = index + 2
            }
            result.append(BootstrapModuleShadow(
                snapshots[module].path, names, boundNames, boundTargets
            ))
        }
        module = module + 1
    }
    result
}

/** Whether `path`'s declarations may give way to a sibling module's of their
 *  name: an imported module outside the runtime, whose names the backend and
 *  the runtime look up as they are. */
fun bootstrapModuleSiblingShadowable(path: string, imported: bool): bool =
    imported && !bootstrapRuntimeModuleSource(path)

/** For each of `siblingNames` that `module` does not declare, the module its
 *  bare name means there: the declaring module its plain imports reach first,
 *  when that one alone is the nearest and carries its prefix. Name and
 *  module path pairs, flattened. */
fun bootstrapSiblingBindings(
    module: int,
    siblingNames: array<string>,
    aliases: array<BootstrapModuleAlias>,
    snapshots: array<BootstrapModuleSnapshot>,
    summary: BootstrapAliasSummary,
    entryModules: array<int>,
    entryNames: array<string>,
    shadowModules: array<int>,
    shadowNames: array<string>
): array<string> {
    val result: array<string> = []
    if (siblingNames.size == 0) return result
    // Breadth-first over the module's plain imports: each module's distance.
    val distance = filledArray(snapshots.size, -1)
    distance[module] = 0
    val pending: array<int> = [module]
    var next = 0
    while (next < pending.size) {
        val from = pending[next]
        var edgeIndex = summary.firstEdgeOf(snapshots[from].path)
        while (edgeIndex >= 0) {
            val edge = aliases[edgeIndex]
            val target = summary.snapshotIndex.get(edge.target)
            if (edge.alias == "" && target != null && distance[target] < 0) {
                distance[target] = distance[from] + 1
                pending.append(target)
            }
            edgeIndex = summary.nextEdge[edgeIndex]
        }
        next = next + 1
    }
    for (name in siblingNames) {
        if (!bootstrapModuleDeclares(snapshots[module].discovery, name)) {
            var nearest = -1
            var tied = false
            var entry = 0
            while (entry < entryNames.size) {
                val declaring = entryModules[entry]
                if (entryNames[entry] == name && distance[declaring] > 0 &&
                    declaring != nearest) {
                    if (nearest < 0 || distance[declaring] < distance[nearest]) {
                        nearest = declaring
                        tied = false
                    } else if (distance[declaring] == distance[nearest]) {
                        tied = true
                    }
                }
                entry = entry + 1
            }
            var prefixed = false
            var index = 0
            while (index < shadowModules.size) {
                if (shadowModules[index] == nearest && shadowNames[index] == name) prefixed = true
                index = index + 1
            }
            if (nearest >= 0 && !tied && prefixed) {
                result.append(name)
                result.append(snapshots[nearest].path)
            }
        }
    }
    result
}

fun bootstrapRewriteModuleSource(
    snapshot: BootstrapModuleSnapshot,
    aliases: array<BootstrapModuleAlias>,
    snapshots: array<BootstrapModuleSnapshot>,
    shadows: array<BootstrapModuleShadow>,
    summary: BootstrapAliasSummary
): string {
    val names: array<string> = []
    val replacements: array<string> = []
    val ownPrefix = summary.targetPrefix(snapshot.path)
    // Each name below carries a prefix except inside a declaration that binds
    // the name itself (a field, method, parameter or local, or a class's
    // member in its body and its extension functions) other than the
    // declaration of that name, and as a named argument.
    if (ownPrefix != "") {
        bootstrapAppendPrefixedNames(
            snapshot.discovery, ownPrefix, names, replacements
        )
    }
    // This module's shadowing declarations, named with its prefix.
    val ownShadows = bootstrapModuleShadowIndex(shadows, snapshot.path)
    if (ownPrefix == "" && ownShadows >= 0) {
        bootstrapAppendShadowNames(
            shadows[ownShadows],
            bootstrapModuleCanonicalPrefix(snapshot.path),
            snapshot.discovery, false, names, replacements
        )
    }
    // This module's private names carry its prefix, here only: no other
    // module's name can reach them.
    if (ownPrefix == "") {
        bootstrapAppendPrivateNames(
            snapshot.discovery,
            bootstrapModuleCanonicalPrefix(snapshot.path),
            names, replacements
        )
    }
    // A module imported plainly here but under an alias elsewhere carries its
    // module prefix everywhere: its bare names in this module mean those,
    // except inside a declaration that binds the name itself (a field,
    // parameter or local), where it is shadowed as it would be unaliased.
    val importedFrom = names.size
    // (This module's own edges, in order.)
    var edgeIndex = summary.firstEdgeOf(snapshot.path)
    while (edgeIndex >= 0) {
        val edge = aliases[edgeIndex]
        val targetPrefix = if (edge.importer == snapshot.path &&
            edge.alias == "") {
            summary.targetPrefix(edge.target)
        } else ""
        val target = summary.snapshotIndex.get(edge.target)
        // (Before the module's own names: the first match is taken.)
        if (edge.importer == snapshot.path && edge.alias == "" &&
            target != null && summary.isTwinEdge(edge)) {
            val twinPrefix = bootstrapModuleCanonicalPrefix(
                bootstrapContractTwinPath(edge.target)
            )
            for (declaration in snapshots[target].discovery.declarations) {
                if (bootstrapIsTwinFunction(declaration)) {
                    names.append(declaration.name)
                    replacements.append("$twinPrefix${declaration.name}")
                }
            }
        }
        if (targetPrefix != "" && target != null) {
            // A prefixed import exposes its re-exports under each declarer's prefix.
            for (reached in bootstrapAliasReachedModules(edge.target, aliases, summary)) {
                val declaring = summary.snapshotIndex.get(reached)
                if (declaring != null) {
                    bootstrapAppendPrefixedNames(
                        snapshots[declaring].discovery, summary.targetPrefix(reached),
                        names, replacements, false
                    )
                }
            }
        }
        // A plainly imported module's shadowing declarations, unless this
        // module declares the name itself.
        val targetShadows = if (edge.importer == snapshot.path &&
            edge.alias == "" && targetPrefix == "") {
            bootstrapModuleShadowIndex(shadows, edge.target)
        } else -1
        if (targetShadows >= 0) {
            bootstrapAppendShadowNames(
                shadows[targetShadows],
                bootstrapModuleCanonicalPrefix(edge.target),
                snapshot.discovery, true, names, replacements
            )
        }
        edgeIndex = summary.nextEdge[edgeIndex]
    }
    // A sibling module's name this module reaches only through others.
    if (ownShadows >= 0) {
        val own = shadows[ownShadows]
        var bound = 0
        while (bound < own.boundNames.size) {
            names.append(own.boundNames[bound])
            replacements.append(
                "${bootstrapModuleCanonicalPrefix(own.boundModules[bound])}${own.boundNames[bound]}"
            )
            bound = bound + 1
        }
    }
    val declarationBounds = if (names.size > 0) {
        bootstrapDeclarationBoundNamesIn(snapshot.source, snapshot.discovery, bootstrapModuleTokens(snapshot))
    } else []
    val localAliases: array<string> = []
    val aliasPrefixes: array<string> = []
    // The target whose functions are the alias's twin's, or -1.
    val aliasTwins: array<int> = []
    val aliasEdges: array<int> = []
    var aliasIndex = summary.firstEdgeOf(snapshot.path)
    while (aliasIndex >= 0) {
        val edge = aliases[aliasIndex]
        if (edge.importer == snapshot.path && edge.alias != "") {
            localAliases.append(edge.alias)
            aliasPrefixes.append(bootstrapModuleCanonicalPrefix(edge.target))
            aliasEdges.append(aliasIndex)
            val target = summary.snapshotIndex.get(edge.target)
            aliasTwins.append(
                if (target != null && summary.isTwinEdge(edge)) target else -1
            )
        }
        aliasIndex = summary.nextEdge[aliasIndex]
    }
    val rewrittenBegins: array<int> = []
    val rewrittenEnds: array<int> = []
    val originalBegins: array<int> = []
    val originalEnds: array<int> = []
    val rewritten = if (names.size == 0 && localAliases.size == 0) {
        snapshot.source
    } else {
        val tokens = bootstrapModuleTokens(snapshot)
        var output = ""
        var cursor = 0
        var tokenIndex = 0
        var inImport = false
        while (tokenIndex < tokens.size) {
            val token = tokens[tokenIndex]
            if (token.kind == BOOTSTRAP_TOKEN_IMPORT) inImport = true
            if (token.kind == BOOTSTRAP_TOKEN_NEWLINE || token.kind == BOOTSTRAP_TOKEN_SEMICOLON) {
                inImport = false
            }
            var qualified = -1
            if (!inImport && token.kind == BOOTSTRAP_TOKEN_IDENTIFIER &&
                tokenIndex + 2 < tokens.size &&
                tokens[tokenIndex + 1].kind == BOOTSTRAP_TOKEN_DOT &&
                tokens[tokenIndex + 2].kind == BOOTSTRAP_TOKEN_IDENTIFIER) {
                val qualifier = bootstrapTokenText(snapshot.source, token)
                var candidate = 0
                while (candidate < localAliases.size && qualified < 0) {
                    if (localAliases[candidate] == qualifier) {
                        qualified = candidate
                    }
                    candidate = candidate + 1
                }
                if (qualified >= 0 && bootstrapAliasShadowedAt(
                    snapshot.discovery, qualifier, token.begin
                )) qualified = -1
            }
            if (qualified >= 0) {
                val member = tokens[tokenIndex + 2]
                output = "$output${snapshot.source.slice(cursor, token.begin)}"
                rewrittenBegins.append(output.size)
                val memberName = bootstrapTokenText(snapshot.source, member)
                var memberPrefix = aliasPrefixes[qualified]
                val declaring = bootstrapAliasMemberModules(
                    aliases[aliasEdges[qualified]].target, memberName, aliases, snapshots
                )
                if (declaring.size > 0) {
                    memberPrefix = bootstrapModuleCanonicalPrefix(declaring[0])
                }
                if (aliasTwins[qualified] >= 0) {
                    for (declaration in snapshots[aliasTwins[qualified]].discovery.declarations) {
                        if (declaration.name == memberName &&
                            bootstrapIsTwinFunction(declaration)) {
                            memberPrefix = bootstrapModuleCanonicalPrefix(
                                bootstrapContractTwinPath(aliases[aliasEdges[qualified]].target)
                            )
                        }
                    }
                }
                output = "$output$memberPrefix$memberName"
                rewrittenEnds.append(output.size)
                originalBegins.append(token.begin)
                originalEnds.append(member.end)
                cursor = member.end
                tokenIndex = tokenIndex + 3
            } else {
                var replacement = -1
                // (`$name` in a string template names it too.)
                if (!inImport && (token.kind == BOOTSTRAP_TOKEN_IDENTIFIER ||
                     token.kind == BOOTSTRAP_TOKEN_INTERPOLATION_IDENTIFIER) &&
                    (tokenIndex == 0 ||
                     tokens[tokenIndex - 1].kind != BOOTSTRAP_TOKEN_DOT)) {
                    val text = bootstrapTokenText(snapshot.source, token)
                    var candidate = 0
                    while (candidate < names.size && replacement < 0) {
                        if (names[candidate] == text) replacement = candidate
                        candidate = candidate + 1
                    }
                }
                // A named argument (`f(name = …)`) names a parameter, which
                // keeps its name.
                if (replacement >= 0 && bootstrapNamedArgumentAt(tokens, tokenIndex)) {
                    replacement = -1
                }
                val enclosing = if (replacement >= 0) {
                    bootstrapDeclarationAt(snapshot.discovery, token.begin)
                } else -1
                // In the shadowing declaration itself the name is that
                // declaration; elsewhere a `fun` of that name is a method.
                val declaring = enclosing >= 0 &&
                    replacement < importedFrom &&
                    snapshot.discovery.declarations[enclosing].name ==
                        names[replacement]
                if (enclosing >= 0 && !declaring &&
                    ((enclosing < declarationBounds.size &&
                      bootstrapAffineNamesContain(
                          declarationBounds[enclosing], names[replacement]
                      ) &&
                      // A block's local ends with the block: a receiver-less
                      // declaration's later uses name the module's.
                      (snapshot.discovery.declarations[enclosing].extensionOwner != "" ||
                       snapshot.discovery.declarations[enclosing].kind == "class" ||
                       snapshot.discovery.declarations[enclosing].kind == "interface" ||
                       bootstrapNameBoundAt(
                           snapshot.source, tokens,
                           snapshot.discovery.declarations[enclosing], tokenIndex,
                           names[replacement]
                       ))) ||
                     (tokenIndex > 0 &&
                      tokens[tokenIndex - 1].kind == BOOTSTRAP_TOKEN_FUN &&
                      // (`fun Name.member`: the receiver, not a method.)
                      (tokenIndex + 1 >= tokens.size ||
                       tokens[tokenIndex + 1].kind != BOOTSTRAP_TOKEN_DOT)))) {
                    replacement = -1
                }
                if (replacement >= 0) {
                    output =
                        "$output${snapshot.source.slice(cursor, token.begin)}"
                    rewrittenBegins.append(output.size)
                    output = "$output${replacements[replacement]}"
                    rewrittenEnds.append(output.size)
                    originalBegins.append(token.begin)
                    originalEnds.append(token.end)
                    cursor = token.end
                }
                tokenIndex = tokenIndex + 1
            }
        }
        "$output${snapshot.source.slice(cursor, snapshot.source.size)}"
    }
    bootstrapRecordSourceRewrite(BootstrapSourceRewrite(
        snapshot.path, rewrittenBegins, rewrittenEnds, originalBegins,
        originalEnds, snapshot.source, rewritten.size
    ))
    rewritten
}

/** Whether the identifier at `index` names an argument: `name =` right after
 *  a call's `(` or `,`. */
fun bootstrapNamedArgumentAt(tokens: array<BootstrapToken>, index: int): bool {
    if (index + 1 >= tokens.size || tokens[index + 1].kind != BOOTSTRAP_TOKEN_EQUAL) return false
    var before = index - 1
    while (before >= 0 && tokens[before].kind == BOOTSTRAP_TOKEN_NEWLINE) before = before - 1
    before >= 0 && (tokens[before].kind == BOOTSTRAP_TOKEN_LPAREN || tokens[before].kind ==
        BOOTSTRAP_TOKEN_COMMA)
}

/** A word that names a built-in type: a member named so (`fun JsonEncoder.string(...)`) must not make the type written `string` take a module's prefix. */
fun bootstrapIsBuiltinTypeWord(name: string): bool =
    name == "string" || name == "int" || name == "bool" || name == "void" || name == "any" || name == "float" || name == "never" ||
        name == "i8" || name == "i16" || name == "i32" || name == "i64" || name == "u8" || name == "u16" || name == "u32" || name == "u64" ||
        name == "f32" || name == "f64" || name == "char" || name == "unknown"

fun bootstrapAppendPrefixedNames(
    discovery: BootstrapParseResult,
    prefix: string,
    var names: array<string>,
    var replacements: array<string>,
    // An importer's view leaves the module's private names out.
    includePrivate: bool = true
): void {
    var declaration = 0
    while (declaration < discovery.declarations.size) {
        val name = discovery.declarations[declaration].name
        if (name != "" &&
            !(discovery.declarations[declaration].extensionOwner != "" && bootstrapIsBuiltinTypeWord(name)) &&
            (includePrivate || !discovery.declarations[declaration].isPrivate)) {
            names.append(name)
            replacements.append("$prefix$name")
        }
        declaration = declaration + 1
    }
    return
}

/** A module's private top-level names (not extension members, whose names
 *  belong to their receiver), each once, with `prefix`. */
fun bootstrapAppendPrivateNames(
    discovery: BootstrapParseResult,
    prefix: string,
    var names: array<string>,
    var replacements: array<string>
): void {
    for (declaration in discovery.declarations) {
        val name = declaration.name
        if (declaration.isPrivate && declaration.extensionOwner == "" && name != "" &&
            !bootstrapAffineNamesContain(names, name)) {
            names.append(name)
            replacements.append("$prefix$name")
        }
    }
    return
}

/** Whether `discovery` declares `name` privately (and nothing public of it). */
fun bootstrapModuleDeclaresOnlyPrivately(
    discovery: BootstrapParseResult,
    name: string
): bool {
    var found = false
    for (declaration in discovery.declarations) {
        if (declaration.extensionOwner == "" && declaration.name == name) {
            if (!declaration.isPrivate) return false
            found = true
        }
    }
    found
}

fun bootstrapPrepareModuleSnapshot(
    snapshot: BootstrapModuleSnapshot,
    aliases: array<BootstrapModuleAlias>,
    snapshots: array<BootstrapModuleSnapshot>,
    shadows: array<BootstrapModuleShadow>,
    summary: BootstrapAliasSummary,
    typesOnly: bool = false
): BootstrapModuleSnapshot {
    val source = bootstrapRewriteModuleSource(
        snapshot, aliases, snapshots, shadows, summary
    )
    val contractOnly = summary.isContractTarget(snapshot.path)
    // The common unaliased module needs no rewritten-source snapshot. Reuse
    // its already compact discovery record instead of parsing and retaining a
    // second interface AST for the duration of the build.
    if (!contractOnly && source == snapshot.source) return snapshot
    val host = if (snapshot.hostSource != "") bootstrapRawHostSource(
        source, snapshot.rawChunks, bootstrapSourceRewriteOf(snapshot.path)
    ) else ""
    var discovery = bootstrapModuleDiscovery(source, snapshot.path, host)
    if (contractOnly) {
        discovery = bootstrapProjectContract(discovery, snapshot.path, typesOnly)
    }
    val fingerprintSource = if (contractOnly) {
        bootstrapModuleInterfaceIdentity(discovery, 0, 0)
    } else source
    BootstrapModuleSnapshot(
        snapshot.path,
        source,
        snapshot.importEdges,
        snapshot.importErrors,
        snapshot.exists,
        snapshot.size,
        snapshot.revision,
        bootstrapModuleFingerprint(fingerprintSource, 17, 257, 1000000007),
        bootstrapModuleFingerprint(fingerprintSource, 97, 263, 1000000009),
        discovery,
        snapshot.rawChunks,
        host,
        snapshot.rawSites,
        snapshot.mayUseRawProvider
    )
}

fun bootstrapImportAliasExposedTarget(target: string): string {
    var exposed = target
    if (target.size >= 9 &&
        target.slice(target.size - 9, target.size) == "/entry.ab") {
        val source = Path(target).readText()
        val scan = bootstrapScanImports(source)
        val parsed = bootstrapParseWithIdentity(source, target)
        if (parsed.declarations.size == 0 && scan.errors == 0 &&
            scan.edges.size == 1 && !scan.edges[0].provider &&
            scan.edges[0].alias == "") {
            exposed = bootstrapResolveImport(target, scan.edges[0].source)
        }
    }
    exposed
}

class BootstrapImportAliasValidation(
    val errors: int,
    val diagnostics: string
)

// Strict imports (`visibility = "imports"` in a package's abla.toml, or
// `--strict-imports` for modules whose package doesn't say): a module sees its
// own declarations, those of the modules it imports without an alias, the
// `export import`s of a strict one, everything a flat one (a package that
// doesn't opt in) reaches, and the runtime and abla/stm, which every program
// has. The standard library is strict when its own abla.toml says so. A name
// a module uses from any other module is E_NAME_NOT_IMPORTED, with the import
// to add. `--visibility-report <path>` writes every such use, in a program's
// module whether it is strict or not and in a strict library module, to
// <path> (module, line, column, name, declaring module, import);
// tools/fix-imports.ab applies it.
// Strict is the default (decision #66, step 3): a module whose package doesn't set `visibility` is strict unless
// the build says `--flat-imports` (or `--strict-imports=warn`, which builds it flat with warnings).
var bootstrapStrictImportsRequested: bool = true
// No `--strict-imports` or `--flat-imports` given: a module strict only by default gets the way to opt out in
// E_NAME_NOT_IMPORTED's help (bootstrapStrictImportsOptOutHelp).
var bootstrapStrictImportsByDefault: bool = true

/** The `visibility` of the package `modulePath` belongs to: its nearest
 *  abla.toml's, or "" when that doesn't say (or there is none). */
/** `path` from the root: a module path relative to the working directory
 *  (a program built as `ablac build ../main.ab`) resolved against it. */
fun bootstrapAbsoluteModulePath(path: string): string =
    if (path.startsWith("/") || path.startsWith("<")) path
    else bootstrapNormalizeModulePath("${currentDirectory().text}/$path")

fun bootstrapModuleManifestVisibility(modulePath: string): string {
    val manifest = bootstrapModuleManifestPath(modulePath)
    if (manifest == "") "" else bootstrapTomlStringField(manifest, "visibility")
}

/** The nearest abla.toml at or above `modulePath`'s directory, or "" when there is none. */
fun bootstrapModuleManifestPath(modulePath: string): string {
    // (From the root: a relative path's parents end at the working directory.)
    var directory = Path(bootstrapAbsoluteModulePath(modulePath)).parent()
    var depth = 0
    while (depth < 128) {
        val candidate = directory.child("abla.toml")
        if (candidate.exists()) return candidate.text
        val parent = directory.parent()
        if (parent.text == directory.text) return ""
        directory = parent
        depth = depth + 1
    }
    ""
}

// Flat imports are deprecated (decision #66, step 4: strict by default, flat deprecated, then removed). A build
// given `--flat-imports` (orc_main's bootstrapStrictImportsOption), or with a module flat because its manifest says
// `visibility = "flat"` (or `"program"`), gets one W_FLAT_IMPORTS_DEPRECATED warning per place flat came from, on
// standard error: nothing else changes. ABLA_ALLOW_FLAT_IMPORTS=1 silences it, for CI that knowingly builds flat until
// its migration. (`--strict-imports=warn`, the migration aid, builds flat without it.)
val bootstrapFlatImportsWarned: Map<string, int> = Map()

fun bootstrapFlatImportsDeprecationWarning(source: string): void {
    if (bootstrapFlatImportsWarned.has(source)) return
    bootstrapFlatImportsWarned.set(source, 1)
    val allowed = linuxEnvironment("ABLA_ALLOW_FLAT_IMPORTS")
    if (allowed.found && allowed.value != "" && allowed.value != "0") return
    linuxWriteStandardError(
        "warning[W_FLAT_IMPORTS_DEPRECATED]: flat imports ($source) are deprecated and will be removed\n" +
            "help: add the imports with tools/fix-imports.ab, then drop the flat setting (docs/packages.md); " +
            "ABLA_ALLOW_FLAT_IMPORTS=1 silences this\n"
    )
    return
}

/** Warns, once per manifest and build, when `modulePath` (a module bootstrapModuleStrict found flat) is flat because
 *  its manifest says so. */
fun bootstrapWarnDeprecatedFlat(modulePath: string): void {
    if (modulePath.startsWith("<") || bootstrapStandardLibraryModuleSource(modulePath)) return
    val manifest = bootstrapModuleManifestPath(modulePath)
    if (manifest == "") return
    val visibility = bootstrapTomlStringField(manifest, "visibility")
    if (visibility == "flat" || visibility == "program") {
        bootstrapFlatImportsDeprecationWarning("visibility = \"$visibility\" in $manifest")
    }
}

// The standard library's `visibility`, from its own abla.toml (read once per
// root).
var bootstrapStandardLibraryVisibilityRoot: string = ""
var bootstrapStandardLibraryVisibilityValue: string = ""

fun bootstrapStandardLibraryVisibility(): string {
    val root = bootstrapStandardLibraryRoot()
    if (root != bootstrapStandardLibraryVisibilityRoot) {
        val manifest = Path(root).child("abla.toml")
        bootstrapStandardLibraryVisibilityValue = if (manifest.exists())
            bootstrapTomlStringField(manifest.text, "visibility") else ""
        bootstrapStandardLibraryVisibilityRoot = root
    }
    bootstrapStandardLibraryVisibilityValue
}

fun bootstrapModuleStrict(modulePath: string): bool {
    if (modulePath.startsWith("<")) return false
    // The standard library is one package, whose abla.toml says for all of it
    // (`--strict-imports` is for a program's modules).
    if (bootstrapStandardLibraryModuleSource(modulePath)) {
        return bootstrapStandardLibraryVisibility() == "imports"
    }
    val visibility = bootstrapModuleManifestVisibility(modulePath)
    if (visibility == "imports") true
    else if (visibility == "flat" || visibility == "program") false
    else bootstrapStrictImportsRequested
}

/** Whether `modulePath` is strict only because strict is the default: its package doesn't set `visibility`,
 *  and the build named neither mode. Its E_NAME_NOT_IMPORTED then says how to opt out
 *  (bootstrapStrictOptOutHelp). */
fun bootstrapModuleStrictByDefault(modulePath: string): bool =
    bootstrapStrictImportsByDefault && bootstrapStrictImportsRequested && !modulePath.startsWith("<") &&
        !bootstrapStandardLibraryModuleSource(modulePath) && bootstrapModuleManifestVisibility(modulePath) == ""

/** Whether `--strict-imports=warn` covers `modulePath`: a program's module that `--strict-imports` would make strict
 *  (its package doesn't set `visibility`). */
fun bootstrapModuleStrictWarned(modulePath: string): bool =
    bootstrapStrictImportsWarn && !modulePath.startsWith("<") &&
        !bootstrapStandardLibraryModuleSource(modulePath) &&
        bootstrapModuleManifestVisibility(modulePath) == ""

/** `target` as an import from `importer`: a standard-library module by its
 *  name (`abla/io`), another file by its path relative to the importer's. */
fun bootstrapImportSpelling(importer: string, target: string): string {
    val root = "${bootstrapCanonicalEscapingPath(
        bootstrapNormalizeModulePath(bootstrapStandardLibraryRoot())
    )}/"
    if (target.startsWith(root)) {
        var name = target.slice(root.size, target.size)
        if (name.endsWith("/entry.ab")) name = name.slice(0, name.size - 9)
        return name
    }
    bootstrapRelativeImportSpelling(importer, target)
}

/** `target` as a standard-library module imports it: another library module
 *  by its name, a file of one (`openssl.ab`) by its relative path. */
fun bootstrapStandardLibraryImportSpelling(importer: string, target: string): string =
    if (target.endsWith("/entry.ab")) bootstrapImportSpelling(importer, target)
    else bootstrapRelativeImportSpelling(importer, target)

/** `target`'s path relative to `importer`'s directory, as an import spells it. */
fun bootstrapRelativeImportSpelling(importer: string, target: string): string {
    val from = bootstrapPathSegments(
        Path(bootstrapAbsoluteModulePath(importer)).parent().text
    )
    val to = bootstrapPathSegments(bootstrapAbsoluteModulePath(target))
    var common = 0
    while (common < from.size && common + 1 < to.size && from[common] == to[common]) {
        common = common + 1
    }
    var spelled = ""
    var up = common
    while (up < from.size) {
        spelled = "$spelled../"
        up = up + 1
    }
    if (spelled == "") spelled = "./"
    var down = common
    while (down < to.size) {
        spelled = if (down + 1 < to.size) "$spelled${to[down]}/" else "$spelled${to[down]}"
        down = down + 1
    }
    spelled
}

// W_UNUSED_IMPORT: the build's import edges and the modules whose uses were kept (bootstrapValidateStrictImports).
var bootstrapUnusedImportEdges: array<BootstrapModuleAlias> = []
var bootstrapUnusedImportChecked: Map<string, bool> = Map()

/** Whether `importer`'s source invokes a subparser `target` registers (`#compilerRegisterSubparser("json", ...)` and
 *  `$json`). */
fun bootstrapUnusedImportSubparserUsed(importer: string, target: string): bool {
    val registering = Path(target).readText()
    val marker = "#compilerRegisterSubparser(\""
    var at = registering.indexOf(marker)
    if (at < 0) return false
    val source = Path(importer).readText()
    while (at >= 0) {
        val rest = registering.slice(at + marker.size, registering.size)
        val end = rest.indexOf("\"")
        if (end > 0 && source.contains("\$" + rest.slice(0, end))) return true
        val next = rest.indexOf(marker)
        at = if (next < 0) -1 else at + marker.size + next
    }
    false
}

/** Whether an import line of `importer` that names a provider expression (not a string) calls a compile function
 *  `target` declares: the import scan never reads those lines as uses. */
fun bootstrapUnusedImportProviderUsed(importer: string, target: string): bool {
    val providers: array<string> = []
    for (line in Path(importer).readText().split("\n")) {
        val trimmed = line.trim()
        if ((trimmed.startsWith("import ") && !trimmed.startsWith("import \"")) ||
            (trimmed.startsWith("export import ") && !trimmed.startsWith("export import \""))) providers.append(trimmed)
    }
    if (providers.size == 0) return false
    for (line in Path(target).readText().split("\n")) {
        val trimmed = line.trim()
        if (!trimmed.startsWith("compile fun ")) continue
        val rest = trimmed.slice(12, trimmed.size)
        var end = 0
        while (end < rest.size && rest[end] != 40 && rest[end] != 58 && rest[end] != 32) end = end + 1
        if (end == 0) continue
        val call = "${rest.slice(0, end)}("
        for (provider in providers) if (provider.contains(call)) return true
    }
    false
}

/** The names the build's modules look up by a string literal at compile time: `compilerFindFunction("x")`,
 *  `compilerFindType("x")`. */
class BootstrapUnusedImportLookup(val module: string, val name: string)

fun bootstrapUnusedImportLookedUpNames(): array<BootstrapUnusedImportLookup> {
    val names: array<BootstrapUnusedImportLookup> = []
    val read: Map<string, bool> = Map()
    for (edge in bootstrapUnusedImportEdges) {
        for (module in [edge.importer, edge.target]) {
            if (read.has(module)) continue
            read.set(module, true)
            val text = Path(module).readText()
            val origin = bootstrapUnusedImportAbsolute(module)
            for (marker in ["compilerFindFunction(\"", "compilerFindType(\""]) {
                var at = text.indexOf(marker)
                while (at >= 0) {
                    val rest = text.slice(at + marker.size, text.size)
                    val end = rest.indexOf("\"")
                    if (end > 0) names.append(BootstrapUnusedImportLookup(origin, rest.slice(0, end)))
                    val next = rest.indexOf(marker)
                    at = if (next < 0) -1 else at + marker.size + next
                }
            }
        }
    }
    names
}

/** Whether `module` declares one of `names` (a function, class, interface or type of that name). */
fun bootstrapUnusedImportDeclaresLookedUp(module: string, names: array<BootstrapUnusedImportLookup>): bool {
    if (names.size == 0) return false
    val text = Path(module).readText()
    val identity = bootstrapUnusedImportAbsolute(module)
    for (lookup in names) {
        // A module's lookup of its own helper does not make its importers use it.
        // Keep external lookups, including an overloaded name also declared by their caller.
        if (lookup.module == identity) continue
        val name = lookup.name
        for (form in ["fun $name(", "fun $name:", "fun $name ", "class $name(", "class $name ", "class $name\n",
                      "interface $name", "type $name "]) {
            if (text.contains(form)) return true
        }
    }
    false
}

/** One `warning[W_UNUSED_IMPORT]` per import of a checked module through which it uses nothing: not the import's module
 *  nor what that module passes on (`export import`, followed). Not for an import under an alias, an `export import`,
 *  nor one of a module that registers a subparser (`$json` reaches it without a name). Uses are the strict scan's names
 *  and sema's member and operator resolution, so a name a local shadows counts as a use: a missed warning, never a false
 *  one from that. */
fun bootstrapUnusedImportWarnings(): string {
    var output = ""
    val warned: Map<string, bool> = Map()
    val lookedUp = bootstrapUnusedImportLookedUpNames()
    for (edge in bootstrapUnusedImportEdges) {
        val importer = bootstrapGenericSourceFile(edge.importer)
        if (!bootstrapUnusedImportChecked.has(importer) || edge.alias != "" || edge.exported || edge.contractOnly) continue
        val key = "$importer\t${edge.target}"
        if (warned.has(key)) continue
        // The import's module and what it passes on.
        val through: array<string> = [edge.target]
        var scan = 0
        while (scan < through.size) {
            for (other in bootstrapUnusedImportEdges) {
                if (other.exported && other.importer == through[scan]) {
                    var known = false
                    for (seen in through) if (seen == other.target) known = true
                    if (!known) through.append(other.target)
                }
            }
            scan = scan + 1
        }
        var used = false
        for (module in through) {
            if (bootstrapImportUses.has("$importer\t${bootstrapGenericSourceFile(module)}")) used = true
        }
        // A subparser the module (or one it passes on) registers and this one invokes (`$json { ... }`) uses it without
        // a name.
        for (module in through) {
            if (!used) used = bootstrapUnusedImportSubparserUsed(edge.importer, module)
            // A compile function an import line of this one calls (`import importSubpath(oneMobileSource(), "ui")`).
            if (!used) used = bootstrapUnusedImportProviderUsed(edge.importer, module)
            // A name compile code anywhere in the build looks up (`compilerFindFunction("oneServerAnswer")`): the
            // import brings in what that lookup finds, though no file names it.
            if (!used) used = bootstrapUnusedImportDeclaresLookedUp(module, lookedUp)
        }
        // A module that matters by being loaded (an @export function, a top-level `#` action) is never unused.
        if (used || bootstrapUnusedImportLoadMatters(edge.target)) continue
        // A module that runs compile code keeps its imports: what it compiles may read them (a build script whose
        // transform generates a server from an imported module's @rpc functions).
        if (bootstrapUnusedImportRunsCompileCode(edge.importer)) continue
        // A module that defines syntax (registers a subparser) keeps its imports too: the code its parser generates
        // lands in the module that invokes it and may call what this one imports (abla-one's dsl/theme.ab and
        // runtime.ab), which no name here shows.
        if (bootstrapUnusedImportDefinesSyntax(edge.importer)) continue
        // Only the project's own modules: one reached by path from another project is that project's to warn about.
        if (!bootstrapUnusedImportInProject(importer)) continue
        warned.set(key, true)
        val line = bootstrapUnusedImportLine(edge.importer, edge.begin, edge.end, edge.written, edge.target)
        // A package's entry that imports a module it neither uses nor passes on: the package likely means to offer it.
        val message = if (bootstrapUnusedImportIsPackageEntry(edge.importer))
            "`$line` is neither used here nor passed on: `export import` it if the package means to offer it (W_UNUSED_IMPORT entry)"
            else "nothing `$line` declares is used here"
        output = "${output}warning[W_UNUSED_IMPORT]: $importer: $message\nsource[import]:$importer:${edge.begin}:${edge.end}\n"
    }
    output
}

/** One `warning[W_UNUSED_LOCAL]` per `val`/`var` statement of the project's own modules that no lookup of sema found (see
 *  bootstrapUnusedLocalDeclared): the statement's place, for the editor to find the name. */
fun bootstrapUnusedLocalWarnings(): string {
    var output = ""
    for (local in bootstrapUnusedLocalDeclared) {
        if (bootstrapUnusedLocalUsed.has(local.identity)) continue
        val file = bootstrapGenericSourceFile(local.source)
        if (!bootstrapUnusedImportInProject(file)) continue
        // Sema numbers the text after the source rewrites (named arguments, extensions): the answer is in the file's own.
        val rewrite = bootstrapSourceRewriteOf(local.source)
        output = "${output}warning[W_UNUSED_LOCAL]: $file: `${local.name}` is never used\nsource[local]:$file:${rewrite.original(local.begin)}:${rewrite.originalEnd(local.end)}\n"
    }
    output
}

/** One `warning[W_UNUSED_PARAMETER]` per parameter of the project's own functions that no lookup of sema found: the declaration's
 *  place, for the editor to find the name (and the function's name, for the command line). */
fun bootstrapUnusedParameterWarnings(): string {
    var output = ""
    for (parameter in bootstrapUnusedParameterDeclared) {
        if (bootstrapUnusedLocalUsed.has(parameter.identity) || bootstrapFunctionValueUses.has(parameter.function)) continue
        val file = bootstrapGenericSourceFile(parameter.source)
        if (!bootstrapUnusedImportInProject(file)) continue
        val rewrite = bootstrapSourceRewriteOf(parameter.source)
        output = "${output}warning[W_UNUSED_PARAMETER]: $file: parameter `${parameter.name}` is never used\nsource[parameter]:$file:${rewrite.original(parameter.begin)}:${rewrite.originalEnd(parameter.end)}\n"
    }
    output
}

/** The project's .ab files (not hidden or generated directories, no links). */
fun bootstrapUnusedDeclarationFiles(path: Path, var files: array<string>): void {
    if (path.isSymbolicLink()) return
    val info = path.info()
    if (info.isDirectory()) {
        for (entry in path.entries()) {
            val name = entry.name()
            if (!name.startsWith(".") && name != "build" && name != "node_modules") bootstrapUnusedDeclarationFiles(path.child(name), files)
        }
    } else if (info.isFile() && path.extension() == "ab") files.append(path.text)
    return
}

fun bootstrapUnusedDeclarationWordByte(byte: int): bool =
    (byte >= 48 && byte <= 57) || (byte >= 65 && byte <= 90) || byte == 95 || (byte >= 97 && byte <= 122)

/** Each identifier the project's .ab files write, with the file that writes it ("*" for more than one): a function that
 *  another file of the project (a test, another entry, a tool) names is not unused, for this build cannot see that file. */
fun bootstrapUnusedDeclarationNames(root: string): Map<string, string> {
    val names: Map<string, string> = Map()
    val files: array<string> = []
    // The checkout the project is in (its tests and tools sit beside the manifest's directory, as ablac's do), else the project.
    var base = root
    var up = Path(root)
    var steps = 0
    while (root != "" && steps < 6 && up.text != "/" && up.text != "") {
        if (up.child(".git").info().exists()) {
            base = up.text
            break
        }
        up = up.parent()
        steps = steps + 1
    }
    if (root != "") bootstrapUnusedDeclarationFiles(Path(base), files)
    for (file in files) {
        val text = Path(file).readText()
        var index = 0
        while (index < text.size) {
            if (bootstrapUnusedDeclarationWordByte(text[index]) && (text[index] < 48 || text[index] > 57)) {
                val begin = index
                while (index < text.size && bootstrapUnusedDeclarationWordByte(text[index])) index = index + 1
                val name = text.slice(begin, index)
                val known = names.get(name)
                if (known == null) names.set(name, file)
                else if (known != file) names.set(name, "*")
            } else index = index + 1
        }
    }
    names
}

/** Whether the project the build is of declares a package (its abla.toml has a `name`): its public declarations are for the
 *  projects that depend on it, which this build does not see. */
fun bootstrapUnusedDeclarationIsPackage(): bool {
    if (bootstrapUnusedImportEntry == "") return false
    val manifest = bootstrapCompileManifestFor(bootstrapUnusedImportEntry)
    if (manifest == "") return false
    for (line in Path(manifest).readText().split("\n")) {
        val trimmed = line.trim()
        if (trimmed.startsWith("name") && trimmed.slice(4, trimmed.size).trim().startsWith("=")) return true
    }
    false
}

/** One `warning[W_UNUSED_DECLARATION]` per top-level function or value of the project's own modules that nothing refers to (see
 *  unused_declarations.ab), except in a module that defines syntax (what its parser generates calls it) and in tests. */
fun bootstrapUnusedDeclarationWarnings(): string {
    var output = ""
    val package = bootstrapUnusedDeclarationIsPackage()
    val named = bootstrapUnusedDeclarationNames(if (bootstrapUnusedDeclarationList.size > 0) bootstrapUnusedImportProjectRoot() else "")
    for (declaration in bootstrapUnusedDeclarationList) {
        val file = bootstrapGenericSourceFile(declaration.source)
        // What a subparser generates (`<generated:one_remote_0>`) is not the project's own text.
        if (file.startsWith("<") || !bootstrapUnusedImportInProject(file)) continue
        if (package && !declaration.function.startsWith("private ")) continue
        // (A member is `Class.name`: the name another file writes is its last part.)
        val dot = declaration.name.lastIndexOf(".")
        val elsewhere = named.get(if (dot >= 0) declaration.name.slice(dot + 1, declaration.name.size) else declaration.name)
        if (elsewhere != null && elsewhere != bootstrapUnusedImportAbsolute(file)) continue
        if (file.endsWith("_test.ab") || file.indexOf("/tests/") >= 0 || file.indexOf("/test/") >= 0 ||
            bootstrapUnusedImportDefinesSyntax(file)) continue
        val rewrite = bootstrapSourceRewriteOf(declaration.source)
        output = "${output}warning[W_UNUSED_DECLARATION]: $file: ${declaration.function} `${declaration.name}` is never used\nsource[declaration]:$file:${rewrite.original(declaration.begin)}:${rewrite.originalEnd(declaration.end)}\n"
    }
    output
}

fun bootstrapUnusedImportAbsolute(path: string): string =
    bootstrapNormalizeModulePath(if (path.startsWith("/")) path else "${currentDirectory().text}/$path")

/** The directory of the project the build is of, absolute: its abla.toml's directory, else the entry's. */
fun bootstrapUnusedImportProjectRoot(): string {
    if (bootstrapUnusedImportEntry == "") return ""
    val manifest = bootstrapCompileManifestFor(bootstrapUnusedImportEntry)
    bootstrapUnusedImportAbsolute(
        if (manifest != "") Path(manifest).parent().text else Path(bootstrapUnusedImportEntry).parent().text
    )
}

fun bootstrapUnusedImportInProject(module: string): bool {
    val root = bootstrapUnusedImportProjectRoot()
    val absolute = bootstrapUnusedImportAbsolute(module)
    // A package's vendored copy, or another checkout linked in, sits inside the project's directory but isn't its own.
    if (root == "") return !absolute.contains("/.abla/packages/")
    bootstrapProjectOwnsPath(root, absolute)
}

/** Whether `module` does something by being loaded: an `@export` function or a top-level `#` compile action. */
fun bootstrapUnusedImportLoadMatters(module: string): bool {
    for (line in Path(module).readText().split("\n")) {
        // A registered subparser matters only where `$name` is written (bootstrapUnusedImportSubparserUsed), and
        // a grant is the declaring file's own permission.
        if (line.startsWith("#compilerRegisterSubparser") || line.startsWith("#compilerGrant")) continue
        if (line.startsWith("@export") || (line.size > 1 && line[0] == 35 && line[1] != 33)) return true
        // A runtime hook (`fun __abla...`) is bound by its name, by the backend or the runtime, never by an
        // importer: abla/runtime/platform/darwin's `__ablaRuntimeDarwinSyscall`, loaded for its dispatcher.
        if (bootstrapUnusedImportRuntimeHook(line)) return true
    }
    false
}

/** Whether `line` declares a top-level runtime hook: `fun __abla...`, after any of its modifiers. */
fun bootstrapUnusedImportRuntimeHook(line: string): bool {
    var rest = line
    var stripping = true
    while (stripping) {
        stripping = false
        for (modifier in ["trusted ", "inline ", "unsafe ", "export ", "private ", "internal "]) {
            if (rest.startsWith(modifier)) {
                rest = rest.slice(modifier.size, rest.size)
                stripping = true
            }
        }
    }
    rest.startsWith("fun __abla")
}

/** Whether `module` runs compile code: a top-level `#` action (not a grant or a subparser registration) or a `#` expression. */
fun bootstrapUnusedImportRunsCompileCode(module: string): bool {
    for (line in Path(module).readText().split("\n")) {
        val trimmed = line.trim()
        if (trimmed.startsWith("//")) continue
        if (trimmed.startsWith("#compilerGrant") || trimmed.startsWith("#compilerRegisterSubparser")) continue
        if (trimmed.size > 1 && trimmed[0] == 35 && trimmed[1] != 33) return true
        if (trimmed.contains("= #") || trimmed.contains("(#")) return true
    }
    false
}

/** The import as the file writes it (its place in the source): `import "x"` for a path, `import oneMobileSource()` or
 *  `import github("owner/pkg")` for an expression, which quoting the written text would garble. */
fun bootstrapUnusedImportLine(importer: string, begin: int, end: int, written: string, target: string): string {
    val text = Path(importer).readText()
    if (begin >= 0 && end > begin && end <= text.size) {
        val line = text.slice(begin, end)
        if (line.startsWith("import ") && !line.contains("\n")) return line
    }
    if (written != "") "import \"$written\"" else bootstrapStrictImportLine(importer, target)
}

/** Whether `module` defines syntax: a top-level `#compilerRegisterSubparser`. */
fun bootstrapUnusedImportDefinesSyntax(module: string): bool {
    for (line in Path(module).readText().split("\n")) {
        if (line.trim().startsWith("#compilerRegisterSubparser")) return true
    }
    false
}

/** Whether `module` is its package's entry (the governing abla.toml's `entry`). */
fun bootstrapUnusedImportIsPackageEntry(module: string): bool {
    val manifest = bootstrapCompileManifestFor(module)
    if (manifest == "") return false
    var rest = ""
    for (line in Path(manifest).readText().split("\n")) {
        if (rest == "" && line.trim().startsWith("entry")) rest = line
    }
    if (rest == "") return false
    val open = rest.indexOf("\"")
    if (open < 0) return false
    val close = rest.slice(open + 1, rest.size).indexOf("\"")
    if (close < 0) return false
    val entry = Path(manifest).parent().child(rest.slice(open + 1, open + 1 + close)).text
    // A program's entry (it has `main`) is imported by nothing: its imports are its own.
    bootstrapNormalizeModulePath(entry) == bootstrapNormalizeModulePath(module) &&
        !Path(module).readText().contains("\nfun main")
}

fun bootstrapValidateStrictImports(
    aliases: array<BootstrapModuleAlias>,
    snapshots: array<BootstrapModuleSnapshot>,
    fullModules: Map<string, int>,
    contractRoots: Map<string, int>
): BootstrapImportAliasValidation {
    if (bootstrapUnusedImportsWanted()) bootstrapUnusedImportEdges = aliases
    // (What sema checks once targets are known: none until this build's modules say.)
    bootstrapStrictVisibilityTable = bootstrapStrictVisibilityEmpty()
    bootstrapStrictIdentityModules = Map()
    bootstrapStrictOptOutModules = Map()
    bootstrapStrictDeferredFindings = []
    val report = bootstrapVisibilityReportPath != ""
    val strict: array<bool> = []
    // What the report asks: every module of the program (not the standard
    // library's) as if it were strict.
    val asStrict: array<bool> = []
    // The modules `--strict-imports=warn` covers: checked as strict, warned about, built flat.
    val warned: array<bool> = []
    var anyStrict = false
    for (snapshot in snapshots) {
        val found = bootstrapModuleStrict(snapshot.path)
        val warn = !found && bootstrapModuleStrictWarned(snapshot.path)
        if (!found && !warn) bootstrapWarnDeprecatedFlat(snapshot.path)
        strict.append(found)
        warned.append(warn)
        if (found && bootstrapModuleStrictByDefault(snapshot.path)) bootstrapStrictOptOutModules.set(snapshot.path, true)
        asStrict.append(found || warn || (report &&
            !bootstrapStandardLibraryModuleSource(snapshot.path) &&
            !snapshot.path.startsWith("<")))
        if (found || warn) anyStrict = true
    }
    if (!anyStrict && !report) return BootstrapImportAliasValidation(0, "")
    val strictSummary = bootstrapAliasSummary(aliases, snapshots, Map())
    // Every module's names, as plain references could reach them: not an
    // extension member, private, nor of a module whose names carry its
    // prefix (imported under an alias somewhere).
    val names = bootstrapStringSet()
    val declaring: array<array<int>> = []
    // Whether every declaration of the name is a function: called, sema picks the overload and checks it.
    val functionsOnly: array<bool> = []
    // Each class's members, which code in its body or its extension
    // functions may use without `this.`.
    val classes = bootstrapStringSet()
    val classMembers: array<array<string>> = []
    // The names some module declares as a type, which a type annotation can
    // name (`: never` is the built-in type, whatever values are called).
    val typeNames = bootstrapStringSet()
    var module = 0
    while (module < snapshots.size) {
        val prefixed = strictSummary.targetPrefix(snapshots[module].path) != ""
        for (declaration in snapshots[module].discovery.declarations) {
            if ((declaration.kind == "class" || declaration.kind == "interface" ||
                declaration.kind == "type") && !bootstrapIsMachineValueType(declaration.name)) {
                typeNames.add(declaration.name)
            }
            if (!prefixed && declaration.extensionOwner == "" &&
                !declaration.isPrivate && declaration.name != "" &&
                declaration.kind != "extend") {
                if (!names.contains(declaration.name)) {
                    names.add(declaration.name)
                    declaring.append([])
                    functionsOnly.append(true)
                }
                declaring[names.indexOf(declaration.name)].append(module)
                if (declaration.kind != "fun") functionsOnly[names.indexOf(declaration.name)] = false
            }
            if (declaration.kind == "class" || declaration.kind == "interface") {
                if (!classes.contains(declaration.name)) {
                    classes.add(declaration.name)
                    classMembers.append([])
                }
                val owner = classes.indexOf(declaration.name)
                for (parameter in declaration.parameters) {
                    classMembers[owner].append(parameter)
                }
                for (method in declaration.methods) classMembers[owner].append(method.name)
            }
        }
        module = module + 1
    }
    var errors = 0
    var diagnostics = ""
    var lines = ""
    // The names more than one module declares: only those can be ambiguous through `export import`.
    val sharedNames: array<int> = []
    var nameIndex = 0
    while (nameIndex < declaring.size) {
        var other = false
        for (candidate in declaring[nameIndex]) if (candidate != declaring[nameIndex][0]) other = true
        if (other) sharedNames.append(nameIndex)
        nameIndex = nameIndex + 1
    }
    // For sema (bootstrapStrictVisibility): each checked module's visible modules.
    val tableModules: Map<string, int> = Map()
    val tableModes: array<int> = []
    val tableVisible: array<array<int>> = []
    val tableMemberVisible: array<array<int>> = []
    val tableSources: array<string> = []
    module = 0
    while (module < snapshots.size) {
        tableModules.set(snapshots[module].path, module)
        tableModes.append(if (strict[module]) 1 else if (warned[module]) 3 else if (asStrict[module]) 2 else 0)
        tableVisible.append([])
        tableMemberVisible.append([])
        // (The sources only for the report's lines and columns: kept for the whole build otherwise.)
        tableSources.append(if (report) snapshots[module].source else "")
        module = module + 1
    }
    // The standard-library import to suggest for each declaring module, once
    // found ("": the module itself, by its path).
    val suggested = filledArray(snapshots.size, "")
    val suggestedKnown = filledArray(snapshots.size, false)
    val edges = bootstrapStrictEdgesOf(aliases, snapshots)
    val independent: array<bool> = []
    for (each in snapshots) independent.append(bootstrapIndependentEntryIdentity(each.path))
    module = 0
    while (module < snapshots.size) {
        val snapshot = snapshots[module]
        if (asStrict[module]) {
            val visible = bootstrapStrictVisibleModules(
                module, edges, snapshots, asStrict
            )
            tableVisible[module] = bootstrapStrictBits(visible)
            tableMemberVisible[module] = bootstrapStrictBits(
                bootstrapStrictVisibleModules(module, edges, snapshots, asStrict, true)
            )
            // W_UNUSED_IMPORT: what a module of the program (not the standard library's, not a package's vendored
            // copy) uses, by declaring module.
            val checkUses = bootstrapUnusedImportsWanted() &&
                !snapshot.path.startsWith(bootstrapNormalizeModulePath(bootstrapStandardLibraryRoot())) &&
                !snapshot.path.contains("/.abla/packages/")
            val uses: array<bool> = if (checkUses) filledArray(snapshots.size, false) else []
            val findings = bootstrapStrictImportFindings(
                snapshot, names, declaring, functionsOnly, classes, classMembers, visible, typeNames,
                !fullModules.has(snapshot.path), !contractRoots.has(snapshot.path),
                independent, uses
            )
            if (checkUses) {
                bootstrapUnusedImportChecked.set(bootstrapGenericSourceFile(snapshot.path), true)
                var used = 0
                while (used < uses.size) {
                    if (uses[used]) bootstrapImportUseRecord(snapshot.path, snapshots[used].path)
                    used = used + 1
                }
            }
            for (finding in findings) {
                if (!suggestedKnown[finding.declaring]) {
                    suggested[finding.declaring] = bootstrapStrictSuggestedImport(
                        finding.declaring, aliases, snapshots, strict
                    )
                    suggestedKnown[finding.declaring] = true
                }
                // A standard-library module imports the declaring module itself.
                val spelling = if (bootstrapStandardLibraryModuleSource(snapshot.path))
                    bootstrapStandardLibraryImportSpelling(
                        snapshot.path, snapshots[finding.declaring].path
                    )
                    else if (suggested[finding.declaring] != "")
                    suggested[finding.declaring]
                    else bootstrapImportSpelling(
                        snapshot.path, snapshots[finding.declaring].path
                    )
                // A library module's other file (not its entry) isn't API: a
                // program reaches it through the entry module that imports it
                // when flat, and not at all when strict.
                val internal = bootstrapLibraryInternalFile(
                    snapshot.path, snapshots[finding.declaring].path
                )
                val programSpelling = if (internal) bootstrapLibraryEntryReaching(
                    finding.declaring, aliases, snapshots
                ) else spelling
                // (A report-only module has no diagnostic: the report line is all it gives.)
                val diagnostic = if (!strict[module] && !warned[module]) "" else if (internal)
                    "error[E_NAME_NOT_IMPORTED]: `${finding.name}` is internal to the standard library (declared in ${snapshots[finding.declaring].path}); no import makes it visible\n${bootstrapInternalPublicHint(snapshots[finding.declaring].source)}help: a library module that offers it would be a change to the standard library to request\n${bootstrapStrictOptOutHelp(snapshot.path)}source[strict-import]:${snapshot.path}:${finding.begin}:${finding.end}\n"
                else
                    "error[E_NAME_NOT_IMPORTED]: `${finding.name}` is declared in ${snapshots[finding.declaring].path}, which this module doesn't import\nhelp: add: import \"$spelling\"\n${bootstrapStrictOptOutHelp(snapshot.path)}source[strict-import]:${snapshot.path}:${finding.begin}:${finding.end}\n"
                val reportLine =
                    "${snapshot.path}\t${finding.line}\t${finding.column}\t${finding.name}\t${snapshots[finding.declaring].path}\timport \"$programSpelling\"\n"
                if (finding.deferred) {
                    bootstrapStrictDeferredFindings.append(BootstrapStrictDeferredFinding(
                        snapshot.path, finding.name, finding.begin,
                        if (strict[module]) 1 else if (warned[module]) 3 else 0,
                        diagnostic, reportLine
                    ))
                } else {
                    if (strict[module]) {
                        errors = errors + 1
                        diagnostics = "$diagnostics$diagnostic"
                    } else if (warned[module]) bootstrapStrictImportWarning(diagnostic)
                    lines = "$lines$reportLine"
                }
            }
            if (strict[module] || warned[module]) {
                val ambiguity = bootstrapStrictPassedOnAmbiguity(
                    module, aliases, snapshots, names, declaring, sharedNames
                )
                if (strict[module]) {
                    errors = errors + ambiguity.errors
                    diagnostics = "$diagnostics${ambiguity.diagnostics}"
                } else bootstrapStrictImportWarning(ambiguity.diagnostics)
            }
        }
        module = module + 1
    }
    // The import spellings need only each module's path: stand-ins that hold it, not the snapshots
    // (sources and discoveries), which the table would otherwise keep alive for the whole build.
    val standIns: array<BootstrapModuleSnapshot> = []
    for (snapshot in snapshots) {
        standIns.append(BootstrapModuleSnapshot(
            snapshot.path, "", [], 0, snapshot.exists, -1, 0, 0, 0,
            BootstrapParseResult([], [], 0, 0, [], [], "")
        ))
    }
    bootstrapStrictVisibilityTable = BootstrapStrictVisibility(
        tableModules, tableModes, tableVisible, tableMemberVisible, tableSources,
        { caller: int, declaring: int ->
            bootstrapStrictImportSpellingFor(caller, declaring, aliases, standIns, strict)
        }
    )
    if (report) bootstrapVisibilityReportAdd(lines)
    BootstrapImportAliasValidation(errors, diagnostics)
}

/** Adds `lines` to the `--visibility-report`. A build may check its module graph more than once: the first check
 *  starts the report, later ones (and the uses a module's parse settles) add the lines it doesn't have yet. */
fun bootstrapVisibilityReportAdd(lines: string): void {
    val reportPath = Path(bootstrapVisibilityReportPath)
    var written = if (bootstrapVisibilityReportStarted) reportPath.readText() else ""
    for (line in lines.split("\n")) {
        if (line != "" && !written.contains("$line\n")) written = "$written$line\n"
    }
    reportPath.writeTextAtomic(written)
    bootstrapVisibilityReportStarted = true
    return
}

/** A use bootstrapValidateStrictImports found after a `$name` in module `path`: `mode` 1 an error, 3 a warning
 *  (`--strict-imports=warn`), 0 a report line only. */
class BootstrapStrictDeferredFinding(
    val path: string,
    val name: string,
    val begin: int,
    val mode: int,
    val diagnostic: string,
    val reportLine: string
)

// The uses found after a `$name` in this check's modules, settled by each module's parse.
var bootstrapStrictDeferredFindings: array<BootstrapStrictDeferredFinding> = []

/** The deferred uses of module `path`, now that its parse says what each `$name` expanded (`parsed`): one inside an
 *  expansion's text is a use only where the expansion has an expression the subparser took from the source (a name
 *  in `$mvcview <main>` is markup); the others are uses. Each name's first is reported, as a module's other uses
 *  are. The errors and their diagnostics, for the parse's. */
fun bootstrapStrictSettleDeferred(path: string, parsed: BootstrapParseResult): BootstrapImportAliasValidation {
    var errors = 0
    var diagnostics = ""
    var lines = ""
    val reported = bootstrapStringSet()
    for (finding in bootstrapStrictDeferredFindings) {
        if (finding.path == path && !reported.contains(finding.name)) {
            var text = false
            var span = 0
            while (!text && span + 1 < parsed.subparserSpans.size) {
                if (finding.begin >= parsed.subparserSpans[span] && finding.begin < parsed.subparserSpans[span + 1]) {
                    text = true
                }
                span = span + 2
            }
            if (text) {
                for (use in parsed.subparserUses) if (use == finding.begin) text = false
            }
            if (!text) {
                reported.add(finding.name)
                if (finding.mode == 1) {
                    errors = errors + 1
                    diagnostics = "$diagnostics${finding.diagnostic}"
                } else if (finding.mode == 3) bootstrapStrictImportWarning(finding.diagnostic)
                lines = "$lines${finding.reportLine}"
            }
        }
    }
    if (lines != "" && bootstrapVisibilityReportPath != "") bootstrapVisibilityReportAdd(lines)
    // (Settled once: a module parsed again, its contract twin, finds none left.)
    val left: array<BootstrapStrictDeferredFinding> = []
    for (finding in bootstrapStrictDeferredFindings) if (finding.path != path) left.append(finding)
    bootstrapStrictDeferredFindings = left
    BootstrapImportAliasValidation(errors, diagnostics)
}

/** Strict module `module`'s unaliased imports, with what each passes on through `export import`: a name two
 *  different modules expose that way is ambiguous, as two direct imports of it are (recordImportEdge reports
 *  those, so a pair of direct targets isn't reported again). The module's own declaration of the name decides it,
 *  and an imported module's own declaration hides what it passes on of that name. Each name is reported once, at
 *  the import that brings its second module. Only the names more than one module declares (`shared`, indices into
 *  `names` and `declaring`) can be ambiguous, so nothing is built per name for the others. */
fun bootstrapStrictPassedOnAmbiguity(
    module: int,
    aliases: array<BootstrapModuleAlias>,
    snapshots: array<BootstrapModuleSnapshot>,
    names: BootstrapStringSet,
    declaring: array<array<int>>,
    shared: array<int>
): BootstrapImportAliasValidation {
    var errors = 0
    var diagnostics = ""
    if (shared.size == 0) return BootstrapImportAliasValidation(errors, diagnostics)
    val path = snapshots[module].path
    // For each module this one reaches through an import and what it passes on: that import's target (-1: none),
    // and the import's edge (by its target).
    val via = filledArray(snapshots.size, -1)
    val edges = filledArray(snapshots.size, -1)
    var anyPassed = false
    var edgeIndex = 0
    while (edgeIndex < aliases.size) {
        val edge = aliases[edgeIndex]
        val target = if (edge.alias == "" && edge.importer == path)
            bootstrapSnapshotIndex(snapshots, edge.target) else -1
        if (target >= 0) {
            if (edges[target] < 0) edges[target] = edgeIndex
            val seen = filledArray(snapshots.size, false)
            seen[target] = true
            val pending = [target]
            var next = 0
            while (next < pending.size) {
                val from = pending[next]
                if (via[from] < 0) via[from] = target
                if (from != target) anyPassed = true
                for (exported in aliases) {
                    if (exported.exported && exported.alias == "" && exported.importer == snapshots[from].path) {
                        val reached = bootstrapSnapshotIndex(snapshots, exported.target)
                        if (reached >= 0 && !seen[reached]) {
                            seen[reached] = true
                            pending.append(reached)
                        }
                    }
                }
                next = next + 1
            }
        }
        edgeIndex = edgeIndex + 1
    }
    // Without an `export import` on the way, every pair is two direct imports (recordImportEdge's).
    if (!anyPassed) return BootstrapImportAliasValidation(errors, diagnostics)
    val own = bootstrapStringSet()
    for (declaration in snapshots[module].discovery.declarations) own.add(declaration.name)
    for (name in shared) {
        val text = names.keys[name]
        if (!own.contains(text)) {
            var first = -1
            var second = -1
            for (candidate in declaring[name]) {
                val target = via[candidate]
                var counts = target >= 0 && candidate != first && candidate != second
                // What an import passes on of a name its own target declares is hidden by that declaration.
                if (counts && target != candidate) {
                    for (other in declaring[name]) if (other == target) counts = false
                }
                if (counts) {
                    if (first < 0) first = candidate
                    else if (second < 0 && !(via[first] == first && target == candidate)) second = candidate
                }
            }
            if (second >= 0) {
                val edge = aliases[edges[via[second]]]
                errors = errors + 1
                diagnostics =
                    "${diagnostics}error[E_IMPORT_UNQUALIFIED_AMBIGUOUS]: unqualified declaration `$text` is exposed by both `${snapshots[first].path}` and `${snapshots[second].path}`; add explicit aliases\nsource[import]:$path:${edge.begin}:${edge.end}\n"
            }
        }
    }
    BootstrapImportAliasValidation(errors, diagnostics)
}

/** The import line (`import "…"`) module `caller` adds to see module `declaring`'s names, spelled as the report and
 *  the errors spell it: a standard-library module imports the declaring module itself; a program the import some
 *  module of it resolves there (bootstrapStrictSuggestedImport), else the path from `caller`; a library's internal
 *  file, the entry module that reaches it. */
fun bootstrapStrictImportSpellingFor(
    caller: int,
    declaring: int,
    aliases: array<BootstrapModuleAlias>,
    snapshots: array<BootstrapModuleSnapshot>,
    strict: array<bool>
): string {
    val path = snapshots[caller].path
    val target = snapshots[declaring].path
    if (bootstrapLibraryInternalFile(path, target)) {
        return "import \"${bootstrapLibraryEntryReaching(declaring, aliases, snapshots)}\""
    }
    if (bootstrapStandardLibraryModuleSource(path)) {
        return "import \"${bootstrapStandardLibraryImportSpelling(path, target)}\""
    }
    val suggested = bootstrapStrictSuggestedImport(declaring, aliases, snapshots, strict)
    "import \"${if (suggested != "") suggested else bootstrapImportSpelling(path, target)}\""
}

/** The standard-library import to suggest for a name of `declaring`, as the
 *  program writes it: the import some program module resolves to it (`abla/fs`
 *  resolves to `abla/sys/linux/fs`), else the shortest one a program module
 *  writes that passes it on (with a strict library, its own names and
 *  `export import`s), else its own name. "" for a program module. */
fun bootstrapStrictSuggestedImport(
    declaring: int,
    aliases: array<BootstrapModuleAlias>,
    snapshots: array<BootstrapModuleSnapshot>,
    strict: array<bool>
): string {
    val target = snapshots[declaring].path
    if (!bootstrapStandardLibraryModuleSource(target)) return ""
    var best = ""
    for (edge in aliases) {
        if (edge.alias == "" && edge.written.startsWith("abla/") &&
            !bootstrapStandardLibraryModuleSource(edge.importer)) {
            if (edge.target == target) return edge.written
            val candidate = bootstrapSnapshotIndex(snapshots, edge.target)
            if (candidate >= 0 && (best == "" || edge.written.size < best.size) &&
                bootstrapStrictPassedOn(
                    candidate, aliases, snapshots, strict
                )[declaring]) best = edge.written
        }
    }
    if (best != "") best else bootstrapImportSpelling("", target)
}

/** The modules whose names a module importing `module` gets from it, by
 *  index: `module` itself, and on from each module through its unaliased
 *  imports while that module is flat, or its `export import`s when strict. */
fun bootstrapStrictPassedOn(
    module: int,
    aliases: array<BootstrapModuleAlias>,
    snapshots: array<BootstrapModuleSnapshot>,
    strict: array<bool>
): array<bool> {
    val passed = filledArray(snapshots.size, false)
    passed[module] = true
    val pending = [module]
    var next = 0
    while (next < pending.size) {
        val from = pending[next]
        for (edge in aliases) {
            if (edge.alias == "" && edge.importer == snapshots[from].path &&
                (!strict[from] || edge.exported)) {
                val target = bootstrapSnapshotIndex(snapshots, edge.target)
                if (target >= 0 && !passed[target]) {
                    passed[target] = true
                    pending.append(target)
                }
            }
        }
        next = next + 1
    }
    passed
}

/** Whether `target` is a standard-library module's other file (not an entry
 *  module) and `importer` isn't in the library. */
/** The help line for a name from an internal library file: the `// public: <modules>` comment the file carries in its
 *  header (the modules that offer its surface, `none` when nothing does); "" without one. The table lives next to the
 *  internal modules, and tools/test-strict-imports.sh checks that every internal file has it and its modules exist. */
fun bootstrapInternalPublicHint(source: string): string {
    for (line in source.split("\n")) {
        if (!line.startsWith("//")) {
            if (line.trim() != "") return ""
            continue
        }
        if (!line.startsWith("// public:")) continue
        val modules = line.replace("// public:", "").trim()
        return if (modules == "none") "help: nothing public offers it: it is part of the standard library's own implementation\n"
            else if (modules == "") ""
            else "help: the public module(s) for this: $modules\n"
    }
    ""
}

fun bootstrapLibraryInternalFile(importer: string, target: string): bool =
    bootstrapStandardLibraryModuleSource(target) && !target.endsWith("/entry.ab") &&
        !bootstrapStandardLibraryModuleSource(importer)

/** The import of the nearest standard-library entry module whose imports reach
 *  the library file `target`; the file's own name when none does. */
fun bootstrapLibraryEntryReaching(
    target: int,
    aliases: array<BootstrapModuleAlias>,
    snapshots: array<BootstrapModuleSnapshot>
): string {
    val seen = filledArray(snapshots.size, false)
    val pending = [target]
    seen[target] = true
    var next = 0
    while (next < pending.size) {
        val path = snapshots[pending[next]].path
        if (pending[next] != target && path.endsWith("/entry.ab") &&
            bootstrapStandardLibraryModuleSource(path)) {
            return bootstrapImportSpelling("", path)
        }
        for (edge in aliases) {
            if (edge.target == path) {
                val importer = bootstrapSnapshotIndex(snapshots, edge.importer)
                if (importer >= 0 && !seen[importer] &&
                    bootstrapStandardLibraryModuleSource(edge.importer)) {
                    seen[importer] = true
                    pending.append(importer)
                }
            }
        }
        next = next + 1
    }
    bootstrapImportSpelling("", snapshots[target].path)
}

// The import edges of a build by importing module, with their targets as snapshot indexes, and the modules every
// program sees without importing them: made once per build (bootstrapStrictEdgesOf), so each module's walk
// (bootstrapStrictVisibleModules) follows only its own edges. Walking every edge of the program, with a linear
// lookup of each target, for every module and every module it reaches made the strict check quadratic in the
// modules (tools/test-frontend-scaling.sh: 600 modules 9.6 s of it, 300 modules 1.5 s).
class BootstrapStrictEdges(
    // By importer path: its edges' targets (-1: not a module of the build), whether each is unaliased, exported.
    val byImporter: Map<string, int>,
    val targets: array<array<int>>,
    val unaliased: array<array<bool>>,
    val exported: array<array<bool>>,
    val implicit: array<int>
)

fun bootstrapStrictEdgesOf(
    aliases: array<BootstrapModuleAlias>,
    snapshots: array<BootstrapModuleSnapshot>
): BootstrapStrictEdges {
    // A path's first snapshot, as bootstrapSnapshotIndex finds it.
    val indexOf: Map<string, int> = Map()
    var index = 0
    while (index < snapshots.size) {
        if (!indexOf.has(snapshots[index].path)) indexOf.set(snapshots[index].path, index)
        index = index + 1
    }
    val byImporter: Map<string, int> = Map()
    val targets: array<array<int>> = []
    val unaliased: array<array<bool>> = []
    val exported: array<array<bool>> = []
    for (edge in aliases) {
        var slot = byImporter.get(edge.importer) ?? -1
        if (slot < 0) {
            slot = targets.size
            byImporter.set(edge.importer, slot)
            targets.append([])
            unaliased.append([])
            exported.append([])
        }
        targets[slot].append(indexOf.get(edge.target) ?? -1)
        unaliased[slot].append(edge.alias == "")
        exported[slot].append(edge.exported)
    }
    // abla/stm, and the runtime the compiler loads into every program for its
    // target (abla/runtime/self and abla/runtime/platform's host.ab or
    // wasm.ab), which a program has without importing them.
    val transactions = bootstrapImplicitTransactionsPath()
    val standardLibrary = Path(bootstrapStandardLibraryRoot())
    val runtime = bootstrapRuntimeSelfModulePath()
    val platform = standardLibrary.child("abla/runtime/platform")
    val hostPlatform = bootstrapNormalizeModulePath(platform.child("host.ab").text)
    val hostOsPlatform = bootstrapNormalizeModulePath(platform.child("host_os.ab").text)
    val wasmPlatform = bootstrapNormalizeModulePath(platform.child("wasm.ab").text)
    val implicit: array<int> = []
    index = 0
    while (index < snapshots.size) {
        val path = snapshots[index].path
        if (path == transactions || path == runtime ||
            path == hostPlatform || path == hostOsPlatform || path == wasmPlatform) implicit.append(index)
        index = index + 1
    }
    BootstrapStrictEdges(byImporter, targets, unaliased, exported, implicit)
}

/** The modules whose names `module` sees under strict imports, by index. */
fun bootstrapStrictVisibleModules(
    module: int,
    edges: BootstrapStrictEdges,
    snapshots: array<BootstrapModuleSnapshot>,
    strict: array<bool>,
    // Also the modules imported under an alias, and what they pass on: an extension function or operator of one
    // is called as a member (`p.doubled()`), which no alias can qualify.
    aliased: bool = false
): array<bool> {
    val visible = filledArray(snapshots.size, false)
    visible[module] = true
    for (index in edges.implicit) visible[index] = true
    val pending: array<int> = []
    // Its own unaliased imports, then what they pass on.
    val own = edges.byImporter.get(snapshots[module].path) ?? -1
    if (own >= 0) {
        var edge = 0
        while (edge < edges.targets[own].size) {
            val target = edges.targets[own][edge]
            if ((edges.unaliased[own][edge] || aliased) && target >= 0 && !visible[target]) {
                visible[target] = true
                pending.append(target)
            }
            edge = edge + 1
        }
    }
    var next = 0
    while (next < pending.size) {
        val from = pending[next]
        val slot = edges.byImporter.get(snapshots[from].path) ?? -1
        if (slot >= 0) {
            var edge = 0
            while (edge < edges.targets[slot].size) {
                val target = edges.targets[slot][edge]
                if (edges.unaliased[slot][edge] && (!strict[from] || edges.exported[slot][edge]) &&
                    target >= 0 && !visible[target]) {
                    visible[target] = true
                    pending.append(target)
                }
                edge = edge + 1
            }
        }
        next = next + 1
    }
    visible
}

fun bootstrapSnapshotIndex(snapshots: array<BootstrapModuleSnapshot>, path: string): int {
    var index = 0
    while (index < snapshots.size) {
        if (snapshots[index].path == path) return index
        index = index + 1
    }
    -1
}

/** The end (exclusive) of the type that starts at `begin`: names and `.`,
 *  `?` and `*`, generic arguments (`<A, B>`, closed by `>` or `>>`), bounds
 *  (`&`) and function types (`(A) -> B`). */
fun bootstrapTypeSpanEnd(tokens: array<BootstrapToken>, begin: int): int {
    var index = begin
    var angle = 0
    var paren = 0
    while (index < tokens.size) {
        val kind = tokens[index].kind
        val previous = if (index > begin) tokens[index - 1].kind else -1
        if (kind == BOOTSTRAP_TOKEN_IDENTIFIER || kind == BOOTSTRAP_TOKEN_DOT || kind ==
            BOOTSTRAP_TOKEN_QUESTION || kind == BOOTSTRAP_TOKEN_STAR ||
            kind == BOOTSTRAP_TOKEN_AMP) {
        } else if (kind == BOOTSTRAP_TOKEN_LESS) {
            angle = angle + 1
        } else if (kind == BOOTSTRAP_TOKEN_GREATER && angle > 0) {
            angle = angle - 1
        } else if (kind == BOOTSTRAP_TOKEN_SHIFT_RIGHT && angle > 1) {
            angle = angle - 2
        } else if (kind == BOOTSTRAP_TOKEN_LPAREN) {
            paren = paren + 1
        } else if (kind == BOOTSTRAP_TOKEN_RPAREN && paren > 0) {
            paren = paren - 1
        } else if (kind == BOOTSTRAP_TOKEN_COMMA && (angle > 0 || paren > 0)) {
        } else if (kind == BOOTSTRAP_TOKEN_ARROW && previous == BOOTSTRAP_TOKEN_RPAREN && angle ==
            0 && paren == 0) {
        } else return index
        index = index + 1
    }
    index
}

class BootstrapStrictImportFinding(
    val name: string,
    val declaring: int,
    val begin: int,
    val end: int,
    val line: int,
    val column: int,
    // After a `$name`: kept until the parse says whether a subparser's text holds it.
    val deferred: bool = false
)

fun bootstrapStrictContractTokens(
    snapshot: BootstrapModuleSnapshot,
    typesOnly: bool
): array<BootstrapToken> {
    val tokens = bootstrapModuleTokens(snapshot)
    val parsed = bootstrapParseWithTokens(snapshot.source, snapshot.path, tokens)
    val retained: array<BootstrapToken> = []
    var cursor = 0
    for (declaration in parsed.declarations) {
        // These are exactly the declaration kinds bootstrapProjectContract
        // retains. It removes function expressions and class/extend methods.
        if ((!typesOnly && declaration.kind == "fun") || declaration.kind == "class" ||
            declaration.kind == "interface" || declaration.kind == "extend") {
            var end = declaration.end
            if (declaration.kind == "fun" &&
                declaration.expression.kind != "missing") {
                end = declaration.expression.begin
            }
            for (method in declaration.methods) {
                if (method.begin < end) end = method.begin
            }
            while (cursor < tokens.size &&
                tokens[cursor].begin < declaration.begin) cursor = cursor + 1
            while (cursor < tokens.size && tokens[cursor].begin < end) {
                retained.append(tokens[cursor])
                cursor = cursor + 1
            }
        }
    }
    retained
}

/** Whether `name` is a type parameter in scope at `position` of `declaration`:
 *  its own (`class Box<T>`, `fun <T> f`) or the one of the method (or nested
 *  declaration) that contains `position`. A type parameter is written
 *  `T`, `T:Shape&Named` or `T = int`: the name is the leading identifier. */
fun bootstrapStrictTypeParameterAt(
    declaration: BootstrapDeclaration,
    position: int,
    name: string
): bool {
    for (entry in declaration.typeParameters) {
        var end = 0
        while (end < entry.size && entry[end] != 58 && entry[end] != 61 &&
            entry[end] != 32) end = end + 1
        if (entry.slice(0, end) == name) return true
    }
    for (method in declaration.methods) {
        if (method.begin <= position && position < method.end &&
            bootstrapStrictTypeParameterAt(method, position, name)) return true
    }
    false
}

/** The plain names `snapshot` uses from modules it doesn't see, each once.
 *  A name its own declarations bind (a parameter, local or field of the
 *  enclosing declaration, or a member of the class it is in or extends), a
 *  named argument and a member after `.` are left alone. */
/** Whether the identifier at `index` (just after `fun`) is an extension's receiver: a `.` follows it, or its `<...>`. */
fun bootstrapStrictReceiverAhead(tokens: array<BootstrapToken>, index: int): bool {
    var at = index + 1
    if (at < tokens.size && tokens[at].kind == BOOTSTRAP_TOKEN_LESS) {
        var depth = 0
        while (at < tokens.size) {
            if (tokens[at].kind == BOOTSTRAP_TOKEN_LESS) depth = depth + 1
            if (tokens[at].kind == BOOTSTRAP_TOKEN_GREATER) {
                depth = depth - 1
                if (depth == 0) {
                    at = at + 1
                    break
                }
            }
            if (tokens[at].kind == BOOTSTRAP_TOKEN_LPAREN || tokens[at].kind == BOOTSTRAP_TOKEN_NEWLINE) return false
            at = at + 1
        }
    }
    at < tokens.size && tokens[at].kind == BOOTSTRAP_TOKEN_DOT
}

fun bootstrapStrictImportFindings(
    snapshot: BootstrapModuleSnapshot,
    names: BootstrapStringSet,
    declaring: array<array<int>>,
    functionsOnly: array<bool>,
    classes: BootstrapStringSet,
    classMembers: array<array<string>>,
    visible: array<bool>,
    typeNames: BootstrapStringSet,
    contractOnly: bool,
    typesOnly: bool,
    // By module index: a generated independent entry (bootstrapIndependentEntryIdentity).
    independent: array<bool> = [],
    // By module index, set for each visible module a name of this one resolves to (W_UNUSED_IMPORT); empty: not kept.
    var uses: array<bool>
): array<BootstrapStrictImportFinding> {
    val result: array<BootstrapStrictImportFinding> = []
    val source = snapshot.source
    val discovery = snapshot.discovery
    val own = bootstrapStringSet()
    for (declaration in discovery.declarations) {
        if (declaration.extensionOwner == "") own.add(declaration.name)
    }
    val tokens = if (contractOnly) bootstrapStrictContractTokens(snapshot, typesOnly)
        else bootstrapModuleTokens(snapshot)
    // The names a declaration binds locally, found when a candidate first needs them: most
    // modules (the library's, in every build) have none that does.
    var bounds: array<array<string>> = []
    var boundsReady = false
    // `bootstrapDeclarationAt` by search: the declarations come in source order, so the last
    // one beginning at or before an offset is the first to try. Unordered ones keep the scan.
    val declarationCount = discovery.declarations.size
    var ordered = true
    var orderCheck = 1
    while (ordered && orderCheck < declarationCount) {
        val here = discovery.declarations[orderCheck].begin
        if (here < discovery.declarations[orderCheck - 1].begin) ordered = false
        orderCheck = orderCheck + 1
    }
    val reported = bootstrapStringSet()
    // Where the first `$name` (a subparser's invocation) is, -1 for none.
    var subparserFrom = -1
    var scan = 0
    while (subparserFrom < 0 && scan + 1 < tokens.size) {
        if (tokens[scan].kind == BOOTSTRAP_TOKEN_DOLLAR && tokens[scan + 1].kind == BOOTSTRAP_TOKEN_IDENTIFIER) {
            subparserFrom = tokens[scan].begin
        }
        scan = scan + 1
    }
    var inImport = false
    var depth = 0
    var line = 1
    var lineStart = 0
    var lineCursor = 0
    var index = 0
    // The end of the type annotation the scan is in (after `:`, `is` or `as`).
    var typeEnd = 0
    while (index < tokens.size) {
        val token = tokens[index]
        if (token.kind == BOOTSTRAP_TOKEN_IMPORT) inImport = true
        if (token.kind == BOOTSTRAP_TOKEN_NEWLINE || token.kind ==
            BOOTSTRAP_TOKEN_SEMICOLON) inImport = false
        if (token.kind == BOOTSTRAP_TOKEN_LPAREN) depth = depth + 1
        if (token.kind == BOOTSTRAP_TOKEN_RPAREN && depth > 0) depth = depth - 1
        if (token.kind == BOOTSTRAP_TOKEN_COLON || token.kind == BOOTSTRAP_TOKEN_AS ||
            (token.kind == BOOTSTRAP_TOKEN_IDENTIFIER &&
                (bootstrapTokenText(source, token) == "is" ||
                    bootstrapTokenText(source, token) == "as"))) {
            val end = bootstrapTypeSpanEnd(tokens, index + 1)
            if (end > typeEnd) typeEnd = end
        }
        val previous = if (index > 0) tokens[index - 1].kind else -1
        val next = if (index + 1 < tokens.size) tokens[index + 1].kind else -1
        // An extension's receiver (`fun T.name`, `fun T<A>.name`) names the type it extends: a use of T's module
        // for W_UNUSED_IMPORT, though sema checks the body only where something calls it. Only a use: whether T
        // must be imported stays sema's to say, as before.
        if (uses.size > 0 && previous == BOOTSTRAP_TOKEN_FUN && token.kind == BOOTSTRAP_TOKEN_IDENTIFIER &&
            bootstrapStrictReceiverAhead(tokens, index)) {
            val receiver = names.indexOf(bootstrapTokenText(source, token))
            if (receiver >= 0) {
                for (candidate in declaring[receiver]) {
                    if (visible[candidate] && candidate < uses.size) uses[candidate] = true
                }
            }
        }
        if (!inImport && (token.kind == BOOTSTRAP_TOKEN_IDENTIFIER ||
                token.kind == BOOTSTRAP_TOKEN_INTERPOLATION_IDENTIFIER) &&
            previous != BOOTSTRAP_TOKEN_DOT && previous != BOOTSTRAP_TOKEN_FUN && previous !=
            BOOTSTRAP_TOKEN_AT &&
            !(next == BOOTSTRAP_TOKEN_EQUAL && depth > 0)) {
            val text = bootstrapTokenText(source, token)
            // A type annotation names a type: a value of that name elsewhere
            // isn't what it uses.
            val typePosition = index < typeEnd
            val known = if (typePosition && !typeNames.contains(text)) -1
                else names.indexOf(text)
            if (known >= 0 && !own.contains(text) && !reported.contains(text)) {
                var seen = false
                for (candidate in declaring[known]) {
                    if (visible[candidate]) {
                        seen = true
                        if (candidate < uses.size) uses[candidate] = true
                    }
                }
                // A built-in (Cell, Shared, Mutex, Map, filledArray, move) is seen everywhere: where no module this
                // one sees declares the name, it is the built-in, as in a flat module that doesn't import the
                // program's declaration of it (tests/cases/builtin-names).
                if (!seen && bootstrapBuiltinCallableName(text)) seen = true
                // A declaration of a generated independent entry (`program.declare { ... }`) is written in this
                // module's own source, inside the block its compile-time code hands to the new program: no
                // module imports that entry, and a use there is the generated program's (program-build).
                for (candidate in declaring[known]) {
                    if (candidate < independent.size && independent[candidate]) seen = true
                }
                // A call of a function that two modules overload: sema picks the overload the arguments fit and
                // names its module (chooseOverload); the first declaring module may not be it.
                if (!seen && next == BOOTSTRAP_TOKEN_LPAREN && functionsOnly[known] &&
                    declaring[known].size > 1) {
                    var other = false
                    for (candidate in declaring[known]) {
                        if (candidate != declaring[known][0]) other = true
                    }
                    if (other) seen = true
                }
                var enclosing = -1
                if (!seen) {
                    if (ordered) {
                        // The last declaration with begin <= offset, then back to the last whose
                        // end is past it (what the scan finds).
                        var low = 0
                        var high = declarationCount
                        while (low < high) {
                            val middle = (low + high) / 2
                            if (discovery.declarations[middle].begin <= token.begin) {
                                low = middle + 1
                            } else high = middle
                        }
                        var back = low - 1
                        while (enclosing < 0 && back >= 0) {
                            if (token.begin < discovery.declarations[back].end) enclosing = back
                            back = back - 1
                        }
                    } else enclosing = bootstrapDeclarationAt(discovery, token.begin)
                }
                if (!seen && enclosing >= 0) {
                    if (!boundsReady) {
                        bounds = bootstrapDeclarationBoundNamesIn(source, discovery, tokens)
                        boundsReady = true
                    }
                    if (enclosing < bounds.size &&
                        bootstrapAffineNamesContain(bounds[enclosing], text)) seen = true
                    val declaration = discovery.declarations[enclosing]
                    if (bootstrapStrictTypeParameterAt(declaration, token.begin, text)) seen = true
                    val owner = if (declaration.kind == "class" ||
                        declaration.kind == "interface") declaration.name
                        else bootstrapNormalizeType(declaration.extensionOwner)
                    val ownerIndex = if (owner != "") classes.indexOf(owner) else -1
                    if (ownerIndex >= 0 &&
                        bootstrapAffineNamesContain(classMembers[ownerIndex], text)) seen = true
                }
                if (!seen) {
                    // After a `$name`, a subparser's text may be what the token is: the use is deferred until the
                    // parse knows (bootstrapStrictSettleDeferred), and each one is kept, in case the first isn't one.
                    val deferred = subparserFrom >= 0 && token.begin > subparserFrom
                    if (!deferred) reported.add(text)
                    while (lineCursor < token.begin) {
                        if (source[lineCursor] == 10) {
                            line = line + 1
                            lineStart = lineCursor + 1
                        }
                        lineCursor = lineCursor + 1
                    }
                    result.append(BootstrapStrictImportFinding(
                        text, declaring[known][0], token.begin, token.end,
                        line, token.begin - lineStart + 1, deferred
                    ))
                }
            }
        }
        index = index + 1
    }
    result
}

fun bootstrapValidateImportAliases(
    aliases: array<BootstrapModuleAlias>,
    state: BootstrapModuleState
): BootstrapImportAliasValidation {
    var errors = 0
    // Each importer is lexed once, and its aliases are found by name as its
    // identifiers go by; each aliased edge's diagnostics are still reported
    // edge by edge, in token order.
    val edgeDiagnostics: array<string> = []
    // A use as `alias.member` skips the member's tokens for that alias.
    val skipUntil: array<int> = []
    val importerSlots: Map<string, int> = Map()
    val importerPaths: array<string> = []
    val importerNames: array<Map<string, int>> = []
    val sameName: array<int> = []
    var aliasIndex = 0
    while (aliasIndex < aliases.size) {
        val edge = aliases[aliasIndex]
        edgeDiagnostics.append("")
        skipUntil.append(0)
        sameName.append(-1)
        if (edge.alias != "" && state.indexOf(edge.importer) >= 0 &&
            state.indexOf(edge.target) >= 0) {
            val known = importerSlots.get(edge.importer)
            var slot = importerPaths.size
            if (known != null) {
                slot = known
            } else {
                importerSlots.set(edge.importer, slot)
                importerPaths.append(edge.importer)
                val names: Map<string, int> = Map()
                importerNames.append(names)
            }
            // (Later edges of a name are reached from the first.)
            val first = importerNames[slot].get(edge.alias)
            if (first == null) {
                importerNames[slot].set(edge.alias, aliasIndex)
            } else {
                var last = first
                while (sameName[last] >= 0) last = sameName[last]
                sameName[last] = aliasIndex
            }
        }
        aliasIndex = aliasIndex + 1
    }
    var importerIndex = 0
    while (importerIndex < importerPaths.size) {
        val importer = state.snapshots[state.indexOf(importerPaths[importerIndex])]
        val names = importerNames[importerIndex]
        val tokens = bootstrapModuleTokens(importer)
        var tokenIndex = 0
        var inImport = false
        while (tokenIndex < tokens.size) {
            val token = tokens[tokenIndex]
            if (token.kind == BOOTSTRAP_TOKEN_IMPORT) inImport = true
            if (token.kind == BOOTSTRAP_TOKEN_NEWLINE || token.kind == BOOTSTRAP_TOKEN_SEMICOLON) {
                inImport = false
            }
            val first = if (!inImport && token.kind == BOOTSTRAP_TOKEN_IDENTIFIER)
                names.get(bootstrapTokenText(importer.source, token)) else null
            var named = if (first != null) first else -1
            while (named >= 0) {
                val edge = aliases[named]
                if (tokenIndex >= skipUntil[named] &&
                    !bootstrapAliasShadowedAt(
                        importer.discovery, edge.alias, token.begin
                    )) {
                    val target = state.snapshots[state.indexOf(edge.target)]
                    if (tokenIndex + 2 < tokens.size &&
                        tokens[tokenIndex + 1].kind == BOOTSTRAP_TOKEN_DOT &&
                        tokens[tokenIndex + 2].kind == BOOTSTRAP_TOKEN_IDENTIFIER) {
                        val member = bootstrapTokenText(
                            importer.source,
                            tokens[tokenIndex + 2]
                        )
                        val declaring = bootstrapAliasMemberModules(
                            edge.target, member, aliases, state.snapshots
                        )
                        val exposed = declaring.size > 0
                        if (declaring.size > 1) {
                            errors = errors + 1
                            edgeDiagnostics[named] =
                                "${edgeDiagnostics[named]}error[E_IMPORT_ALIAS_MEMBER_AMBIGUOUS]: module alias `${edge.alias}` reaches `$member` in both ${declaring[0]} and ${declaring[1]}\n"
                        }
                        if (!exposed && bootstrapModuleDeclaresOnlyPrivately(
                            target.discovery, member
                        )) {
                            errors = errors + 1
                            edgeDiagnostics[named] =
                                "${edgeDiagnostics[named]}error[E_NAME_PRIVATE]: `$member` is private to ${edge.target}\ncontext[canonical-module]: ${edge.target}\nsource[qualified-import]:${edge.importer}:${token.begin}:${tokens[tokenIndex + 2].end}\nhelp: use a public declaration from that module, or remove `private` if you own it and mean to expose it\n"
                        } else if (!exposed) {
                            errors = errors + 1
                            edgeDiagnostics[named] =
                                "${edgeDiagnostics[named]}error[E_IMPORT_ALIAS_MEMBER_UNKNOWN]: module alias `${edge.alias}` has no exposed declaration named `$member`\ncontext[canonical-module]: ${edge.target}\nsource[qualified-import]:${edge.importer}:${token.begin}:${tokens[tokenIndex + 2].end}\n"
                        }
                        skipUntil[named] = tokenIndex + 3
                    } else {
                        errors = errors + 1
                        edgeDiagnostics[named] =
                            "${edgeDiagnostics[named]}error[E_IMPORT_ALIAS_USED_AS_VALUE]: module alias `${edge.alias}` is compile-time-only and must qualify a declaration\ncontext[canonical-module]: ${edge.target}\nsource[qualified-import]:${edge.importer}:${token.begin}:${token.end}\n"
                    }
                }
                named = sameName[named]
            }
            tokenIndex = tokenIndex + 1
        }
        importerIndex = importerIndex + 1
    }
    var diagnostics = ""
    for (edgeDiagnostic in edgeDiagnostics) diagnostics = "$diagnostics$edgeDiagnostic"
    BootstrapImportAliasValidation(errors, diagnostics)
}

// What a module graph looks its edges and modules up by, instead of scanning
// every edge or module recorded so far. By importing module (its slot, in
// importers): its edges in the graph's `aliases`, first to last (aliasNext links
// each to the module's next one), and the plain names its unqualified imports
// so far expose ("<slot>\n<name>"); and the place of each loaded module.
class BootstrapModuleGraphIndex(
    val importers: Map<string, int>,
    val firstAlias: array<int>,
    val lastAlias: array<int>,
    val aliasNext: array<int>,
    val unqualifiedNames: Map<string, int>,
    val modules: Map<string, int>,
    var indexedModules: int,
    // The root manifest whose `[imports]` remaps this graph ("" until the
    // first module outside the standard library loads; "-" when it has none),
    // the remaps, each directory's nearest manifest, and the other manifests
    // with an `[imports]` table already reported.
    var remapRoot: string,
    var remapEntries: array<BootstrapImportRemapEntry>,
    val manifestOfDirectory: Map<string, string>,
    val remapReported: Map<string, int>,
    // The modules loaded with their implementations (the rest, only their
    // contract), and those of them loaded for their contract first.
    val fullModules: Map<string, int>,
    val upgradedModules: Map<string, int>,
    // Explicit contract imports retain every root signature, in either order.
    val contractRoots: Map<string, int>,
    // The contract edges a contract module got to a class its direct imports only
    // reach through other modules ("importer\ntarget"), which its own full load
    // makes redundant.
    val transitiveEdges: Map<string, int>,
    var entryPath: string = "",
    var runtimeSimdScan: bool = false
)

fun bootstrapModuleGraphIndex(): BootstrapModuleGraphIndex =
    BootstrapModuleGraphIndex(Map(), [], [], [], Map(), Map(), 0, "", [], Map(), Map(), Map(),
        Map(), Map(), Map())

fun bootstrapMayUseRawProvider(source: string): bool {
    var site = source.indexOf("\$")
    while (site >= 0) {
        var nameEnd = site + 1
        while (nameEnd < source.size && bootstrapIsAlphaNumeric(source[nameEnd])) nameEnd += 1
        if (nameEnd > site + 1) {
            var body = nameEnd
            while (body < source.size &&
                (source[body] == 32 || source[body] == 9 || source[body] == 10 ||
                    source[body] == 13)) body += 1
            if (bootstrapAt(source, body, 123)) return true
        }
        site = source.indexOf("\$", nameEnd)
    }
    false
}

// Build a preview scope using only import sites the host lexer has reached.
// Discovery uses compile declarations and never evaluates ordinary handlers.
class BootstrapRawImportFrame(
    val path: string,
    val source: string,
    var nextRegistration: int,
    val pending: array<string> = [],
    val local: Map<string, BootstrapRawBoundaryBinding> = Map(),
    val declarations: array<BootstrapDeclaration> = [],
    var resolved: int = 0
)

class BootstrapRawImportScope(
    val syntaxOnly: bool,
    val overlayPaths: array<string>,
    val overlaySources: array<string>,
    val bindings: Map<string, BootstrapRawBoundaryBinding> = Map(),
    val seen: Map<string, bool> = Map(),
    val declarations: array<BootstrapDeclaration> = [],
    val frames: array<BootstrapRawImportFrame> = []
) {
    fun addRegistrations(path: string, discovery: BootstrapParseResult, frame: int): void {
        if (this.syntaxOnly && !bootstrapPathIsStandardLibrary(path)) return
        if (!bootstrapActionsRegisterSubparser(discovery.actions)) return
        val declarations = if (frame >= 0) this.frames[frame].declarations else this.declarations
        val registry = bootstrapBuildSubparserRegistry(BootstrapParseResult(
            declarations, discovery.actions, discovery.errors, discovery.extensionErrors,
            [], [], discovery.diagnostics
        ))
        for (registration in registry.registrations) {
            if (registration.rawBoundary != "" &&
                (frame >= 0 || this.bindings.get(registration.name) == null)) {
                val visible = BootstrapSubparserRegistration(
                    registration.name, registration.handler,
                    if (frame >= 0) registration.availableFrom else -1, registration.rawBoundary
                )
                val binding = BootstrapRawBoundaryBinding(
                    visible, declarations, bootstrapEvalContext(declarations)
                )
                if (frame >= 0) this.frames[frame].local.set(registration.name, binding)
                else this.bindings.set(registration.name, binding)
            }
        }
    }

    fun collect(scope: int, path: string): void {
        if (this.seen.get(path) != null) return
        this.seen.set(path, true)
        var source = ""
        var overlay = this.overlayPaths.size - 1
        while (overlay >= 0 && this.overlayPaths[overlay] != path) overlay -= 1
        if (overlay >= 0) source = this.overlaySources[overlay]
        else if (Path(path).info().isFile()) source = Path(path).readText()
        if (source == "") return
        val host = if (bootstrapMayUseRawProvider(source)) {
            val plan = bootstrapRawScanImportFrame(scope, path, source)
            if (plan.sites.size > 0) bootstrapRawHostSource(
                source, plan.chunks, BootstrapSourceRewrite("", [], [], [], [])
            ) else ""
        } else ""
        val scan = bootstrapScanImports(if (host == "") source else host)
        for (edge in scan.edges) {
            if (!edge.provider && !edge.contractOnly) {
                this.collect(scope, bootstrapResolveImport(path, edge.source))
            }
        }
        val discovery = bootstrapModuleDiscovery(source, path, host)
        for (declaration in discovery.declarations) {
            this.declarations.append(declaration)
        }
        this.addRegistrations(path, discovery, -1)
    }

    fun lookup(scope: int, frame: int, name: string, begin: int): BootstrapRawBoundaryBinding? {
        while (this.frames[frame].resolved < this.frames[frame].pending.size) {
            val target = this.frames[frame].pending[this.frames[frame].resolved]
            this.frames[frame].resolved += 1
            this.collect(scope, target)
        }
        var next = this.frames[frame].nextRegistration
        if (next >= 0 && next < begin) {
            val path = this.frames[frame].path
            val source = this.frames[frame].source
            while (next >= 0 && next < begin) {
                next = source.indexOf("compilerRegisterSubparser", next + 1)
            }
            this.frames[frame].nextRegistration = next
            val discovery = bootstrapModuleDiscovery(bootstrapRawPlanPrefix(begin), path)
            this.frames[frame].declarations.truncate(0)
            for (declaration in this.declarations) this.frames[frame].declarations.append(declaration)
            for (declaration in discovery.declarations) this.frames[frame].declarations.append(declaration)
            this.addRegistrations(path, discovery, frame)
        }
        val imported = this.bindings.get(name)
        if (imported != null) return imported
        val local = this.frames[frame].local.get(name)
        if (local != null && local.registration.availableFrom <= begin) return local
        return null
    }

    fun noteImport(frame: int, begin: int): void {
        val path = this.frames[frame].path
        val scan = bootstrapScanImportsWithIdentity(this.frames[frame].source, path, begin)
        for (edge in scan.edges) {
            if (!edge.provider && !edge.contractOnly) {
                this.frames[frame].pending.append(bootstrapResolveImport(path, edge.source))
            }
        }
    }
}

var bootstrapRawImportScopes: array<BootstrapRawImportScope> = []

fun bootstrapRawScanImportFrame(scope: int, path: string, source: string): BootstrapRawLayout {
    val frame = bootstrapRawImportScopes[scope].frames.size
    bootstrapRawImportScopes[scope].frames.append(BootstrapRawImportFrame(
        path, source, source.indexOf("compilerRegisterSubparser")
    ))
    val layout = bootstrapPlanRawSource(source, { name, begin ->
        bootstrapRawImportScopes[scope].lookup(scope, frame, name, begin)
    }, { begin ->
        bootstrapRawImportScopes[scope].noteImport(frame, begin)
    })
    bootstrapRawImportScopes[scope].frames.removeLast()
    layout
}

class BootstrapModuleGraph(
    val modules: array<BootstrapModule>,
    var errors: int,
    val state: BootstrapModuleState,
    val orderedSnapshots: array<BootstrapModuleSnapshot>,
    val authorizedCompileCapabilities: array<string>,
    var diagnostics: string,
    val aliases: array<BootstrapModuleAlias>,
    val index: BootstrapModuleGraphIndex
) {
    fun rawSnapshot(snapshot: BootstrapModuleSnapshot): BootstrapModuleSnapshot {
        if (!snapshot.mayUseRawProvider) return snapshot
        val known = this.state.rawDiscoveredIn.get(snapshot.path)
        if (known == this.state.build) return snapshot
        this.state.rawDiscoveredIn.set(snapshot.path, this.state.build)
        val source = snapshot.source
        val path = snapshot.path
        val overlayPaths: array<string> = []
        val overlaySources: array<string> = []
        for (overlay in this.state.overlays) {
            overlayPaths.append(overlay.path)
            overlaySources.append(overlay.text)
        }
        val scope = bootstrapRawImportScopes.size
        bootstrapRawImportScopes.append(BootstrapRawImportScope(
            this.state.syntaxOnly, overlayPaths, overlaySources
        ))
        bootstrapRawImportScopes[scope].seen.set(path, true)
        val plan = bootstrapRawScanImportFrame(scope, path, source)
        bootstrapRawImportScopes.removeLast()
        if (plan.sites.size == 0 && snapshot.rawSites.size == 0) return snapshot
        val host = bootstrapRawHostSource(snapshot.source, plan.chunks, BootstrapSourceRewrite("", [], [], [], []))
        val imports = bootstrapScanImports(host)
        val result = BootstrapModuleSnapshot(
            snapshot.path, snapshot.source, imports.edges, imports.errors, snapshot.exists,
            snapshot.size, snapshot.revision, snapshot.firstFingerprint, snapshot.secondFingerprint,
            bootstrapModuleDiscovery(snapshot.source, snapshot.path, host), plan.chunks, host,
            plan.sites, snapshot.mayUseRawProvider
        )
        this.state.replaceRawSnapshot(result)
    }

    fun importerSlot(importerPath: string): int {
        val known = this.index.importers.get(importerPath)
        if (known != null) return known
        val slot = this.index.firstAlias.size
        this.index.importers.set(importerPath, slot)
        this.index.firstAlias.append(-1)
        this.index.lastAlias.append(-1)
        slot
    }

    fun recordImportEdge(
        importer: BootstrapModuleSnapshot,
        edge: BootstrapImportEdge,
        target: string
    ): void {
        if (edge.alias != "" && (edge.source == "abla/runtime/self" ||
            target == bootstrapRuntimeSelfModulePath())) {
            this.errors += 1
            this.diagnostics =
                "${this.diagnostics}error[E_IMPORT_RUNTIME_ALIAS]: abla/runtime/self is loaded by the compiler and cannot be imported under an alias\nsource[import]:${importer.path}:${edge.begin}:${edge.end}\n"
            return
        }
        val slot = this.importerSlot(importer.path)
        var duplicateAlias = false
        var duplicateTarget = false
        var ownEdge = this.index.firstAlias[slot]
        while (ownEdge >= 0) {
            val found = this.aliases[ownEdge]
            // A module loaded for its contract before its implementations
            // recorded this edge then: the edge now is the implementation's.
            if (found.target == target && found.contractOnly &&
                this.index.upgradedModules.has(importer.path)) {
                this.aliases[ownEdge] = BootstrapModuleAlias(
                    importer.path, target, edge.alias, edge.contractOnly,
                    edge.begin, edge.end, edge.exported, edge.source
                )
                return
            }
            if (edge.alias != "" && found.alias == edge.alias) duplicateAlias = true
            if (found.target == target) duplicateTarget = true
            ownEdge = this.index.aliasNext[ownEdge]
        }
        var declarationCollision = false
        var index = 0
        while (index < importer.discovery.declarations.size) {
            if (edge.alias != "" &&
                importer.discovery.declarations[index].name == edge.alias) {
                declarationCollision = true
            }
            index = index + 1
        }
        var unqualifiedAmbiguities = 0
        var ambiguityDiagnostics = ""
        // Import discovery already parsed every module into the shared
        // snapshot. Reuse it here instead of reparsing the target and all
        // preceding imports for every edge.
        var targetDeclarations: array<BootstrapDeclaration> = []
        if (edge.alias == "") {
            targetDeclarations = this.rawSnapshot(this.state.acquire(target)).discovery.declarations
        }
        // Only an import that shares a plain name with one of the module's
        // earlier unqualified imports can be ambiguous: the others skip the
        // comparison with each of those imports.
        var sharesName = false
        for (declaration in targetDeclarations) {
            if (declaration.name != "" && declaration.extensionOwner == "" &&
                !declaration.isPrivate &&
                this.index.unqualifiedNames.get("$slot\n${declaration.name}") != null) {
                sharesName = true
            }
        }
        if (edge.alias == "" && sharesName) {
            ownEdge = this.index.firstAlias[slot]
            while (ownEdge >= 0) {
                val found = this.aliases[ownEdge]
                ownEdge = this.index.aliasNext[ownEdge]
                if (found.alias == "" && found.target != target) {
                    val foundDeclarations = this.state.acquire(
                        found.target
                    ).discovery.declarations
                    // How many of the found module's plain declarations
                    // bear each name: each one a target declaration shares
                    // is an ambiguity, reported once per declaration pair.
                    val foundNames = bootstrapStringSet()
                    val foundCounts: array<int> = []
                    for (declaration in foundDeclarations) {
                        if (declaration.extensionOwner == "" && !declaration.isPrivate) {
                            val known = foundNames.keys.size
                            foundNames.add(declaration.name)
                            if (foundNames.keys.size > known) foundCounts.append(0)
                            val key = foundNames.indexOf(declaration.name)
                            foundCounts[key] = foundCounts[key] + 1
                        }
                    }
                    for (declaration in targetDeclarations) {
                        val name = declaration.name
                        val key = if (name != "" && declaration.extensionOwner == "" &&
                            !declaration.isPrivate)
                            foundNames.indexOf(name) else -1
                        var shared = if (key >= 0) foundCounts[key] else 0
                        while (shared > 0) {
                            unqualifiedAmbiguities = unqualifiedAmbiguities + 1
                            ambiguityDiagnostics =
                                "${ambiguityDiagnostics}error[E_IMPORT_UNQUALIFIED_AMBIGUOUS]: unqualified declaration `$name` is exposed by both `${found.target}` and `$target`; add explicit aliases\nsource[import]:${importer.path}:${edge.begin}:${edge.end}\n"
                            shared = shared - 1
                        }
                    }
                }
            }
        }
        if (duplicateAlias) {
            this.errors = this.errors + 1
            this.diagnostics =
                "${this.diagnostics}error[E_IMPORT_ALIAS_DUPLICATE]: import alias `${edge.alias}` is bound more than once in module `${importer.path}`\nsource[import]:${importer.path}:${edge.begin}:${edge.end}\n"
        }
        if (declarationCollision) {
            this.errors = this.errors + 1
            this.diagnostics =
                "${this.diagnostics}error[E_IMPORT_ALIAS_DECLARATION_COLLISION]: import alias `${edge.alias}` collides with a declaration in module `${importer.path}`\nsource[import]:${importer.path}:${edge.begin}:${edge.end}\n"
        }
        if (duplicateTarget) {
            this.errors = this.errors + 1
            this.diagnostics =
                "${this.diagnostics}error[E_IMPORT_ALIAS_TARGET_DUPLICATE]: module `$target` is imported more than once by `${importer.path}`\nsource[import]:${importer.path}:${edge.begin}:${edge.end}\n"
        }
        if (unqualifiedAmbiguities > 0) {
            this.errors = this.errors + unqualifiedAmbiguities
            this.diagnostics =
                "${this.diagnostics}$ambiguityDiagnostics"
        }
        if (!duplicateAlias && !declarationCollision && !duplicateTarget &&
            unqualifiedAmbiguities == 0) {
            val added = this.aliases.size
            this.index.aliasNext.append(-1)
            if (this.index.lastAlias[slot] >= 0) {
                this.index.aliasNext[this.index.lastAlias[slot]] = added
            } else this.index.firstAlias[slot] = added
            this.index.lastAlias[slot] = added
            if (edge.alias == "") {
                for (declaration in targetDeclarations) {
                    if (declaration.name != "" && declaration.extensionOwner == "" &&
                        !declaration.isPrivate) {
                        this.index.unqualifiedNames.set("$slot\n${declaration.name}", 1)
                    }
                }
            }
            this.aliases.append(BootstrapModuleAlias(
                importer.path,
                target,
                edge.alias,
                edge.contractOnly,
                edge.begin,
                edge.end,
                edge.exported,
                edge.source
            ))
        }
        bootstrapSemanticUnit()
    }
    fun contains(modulePath: string): bool {
        val identity = bootstrapNormalizeModulePath(modulePath)
        // (Indexes the modules appended since the last lookup.)
        while (this.index.indexedModules < this.modules.size) {
            this.index.modules.set(
                this.modules[this.index.indexedModules].path,
                this.index.indexedModules
            )
            this.index.indexedModules = this.index.indexedModules + 1
        }
        this.index.modules.get(identity) != null
    }

    /** Whether `importer` has an import edge of its own to `target`. */
    fun importsDirectly(importer: BootstrapModuleSnapshot, target: string): bool {
        for (edge in importer.importEdges) {
            if (!edge.provider && this.state.exposedTarget(
                bootstrapResolveImport(importer.path, edge.source)
            ) == target) return true
        }
        false
    }

    /** The modules `start` reaches through plain imports (not `start` itself) that
     *  declare a class or interface the shape of `parsed` (the module `importer`) mentions,
     *  nearest first; `importer` is never one of them. */
    fun contractDeclarers(
        parsed: BootstrapParseResult,
        importer: string,
        start: string
    ): array<string> {
        val found: array<string> = []
        val seen = bootstrapStringSet()
        seen.add(importer)
        seen.add(start)
        val queue: array<string> = [start]
        var head = 0
        while (head < queue.size) {
            val current = queue[head]
            head = head + 1
            val snapshot = this.state.acquire(current)
            for (edge in snapshot.importEdges) {
                if (edge.provider || edge.alias != "") continue
                val reached = this.state.exposedTarget(
                    bootstrapResolveImport(current, edge.source)
                )
                if (seen.indexOf(reached) >= 0 || !this.state.sourceExists(reached)) continue
                seen.add(reached)
                queue.append(reached)
                for (candidate in this.state.acquire(reached).discovery.declarations) {
                    if ((candidate.kind == "class" || candidate.kind == "interface") &&
                        bootstrapContractShapeMentions(parsed, candidate.name)) {
                        found.append(reached)
                        break
                    }
                }
            }
        }
        found
    }

    fun loadContract(modulePath: string, typesOnly: bool = false): string {
        val identity = bootstrapNormalizeModulePath(modulePath)
        if (!typesOnly) this.index.contractRoots.set(identity, 1)
        if (!this.contains(identity)) {
            this.checkModuleManifest(identity)
            val snapshot = this.rawSnapshot(this.state.acquire(identity))
            if (bootstrapJsonConstructionRequested) bootstrapJsonConstructionCapture(identity, snapshot.source, bootstrapStandardLibraryRoot())
            this.errors = this.errors + snapshot.importErrors
            if (snapshot.importErrors > 0) {
                this.diagnostics =
                    "${this.diagnostics}${bootstrapScanImportsWithIdentity(if (snapshot.hostSource == "") snapshot.source else snapshot.hostSource, snapshot.path).diagnostics}"
            }
            this.modules.append(BootstrapModule(identity, ""))
            val recordedDeclarers = bootstrapStringSet()
            var index = 0
            while (index < snapshot.importEdges.size) {
                val edge = snapshot.importEdges[index]
                if (!edge.provider) {
                    val imported = bootstrapResolveImport(identity, edge.source)
                    val exposed = this.state.exposedTarget(imported)
                    val importedSnapshot = this.state.acquire(exposed)
                    if (bootstrapContractImportRequired(
                        snapshot.discovery,
                        edge,
                        importedSnapshot.discovery
                    )) {
                        val contractEdge = BootstrapImportEdge(
                            edge.source,
                            edge.provider,
                            edge.alias,
                            true,
                            edge.begin,
                            edge.end
                        )
                        this.recordImportEdge(snapshot, contractEdge, exposed)
                        this.loadContract(imported, !edge.contractOnly)
                    } else if (edge.alias == "") {
                        // The shape mentions a class the direct import only reaches
                        // through its own plain imports: load the module that declares
                        // it (not the modules between), for the contract.
                        for (declarer in this.contractDeclarers(
                            snapshot.discovery, snapshot.path, exposed
                        )) {
                            if (recordedDeclarers.indexOf(declarer) >= 0 ||
                                this.importsDirectly(snapshot, declarer)) continue
                            recordedDeclarers.add(declarer)
                            this.index.transitiveEdges.set("${snapshot.path}\n$declarer", 1)
                            this.recordImportEdge(snapshot, BootstrapImportEdge(
                                declarer, false, "", true, edge.begin, edge.end
                            ), declarer)
                            this.loadContract(declarer, !edge.contractOnly)
                        }
                    }
                }
                index = index + 1
            }
            this.orderedSnapshots.append(snapshot)
        }
        ""
    }

    /** The abla.toml nearest above `modulePath`, or "" when there is none. */
    fun nearestManifest(modulePath: string): string {
        val start = Path(bootstrapAbsoluteModulePath(modulePath)).parent()
        val known = this.index.manifestOfDirectory.get(start.text)
        if (known != null) return known
        var directory = start
        var result = ""
        var depth = 0
        while (result == "" && depth < 128) {
            val candidate = directory.child("abla.toml")
            if (candidate.exists()) result = candidate.text
            val parent = directory.parent()
            if (parent.text == directory.text) depth = 128
            directory = parent
            depth = depth + 1
        }
        this.index.manifestOfDirectory.set(start.text, result)
        result
    }

    /** Reads the remaps of the root manifest, the one nearest `entryPath`,
     *  and checks each: both modules exist, and the target declares what the
     *  source does. */
    fun useRootManifest(entryPath: string): void {
        if (this.index.remapRoot != "") return
        this.index.entryPath = bootstrapNormalizeModulePath(entryPath)
        val manifest = this.nearestManifest(entryPath)
        this.index.remapRoot = if (manifest == "") "-" else manifest
        bootstrapImportRemapEntries = []
        if (manifest == "" || bootstrapManifestTableOffset(manifest, "imports") < 0) {
            return
        }
        val resolved: array<BootstrapImportRemapEntry> = []
        // The modules of a program started by a relative path are named relative to
        // the working directory, so the manifest's modules are named that way too:
        // `../shared/dev.ab` must be the identity an import of it resolves to.
        val manifestBase = if (this.index.entryPath.startsWith("/")) manifest
            else bootstrapRelativeToWorkingDirectory(manifest)
        for (line in bootstrapImportRemapLines(manifest)) {
            if (line.code == "") {
                resolved.append(BootstrapImportRemapEntry(
                    line.written, line.writtenTarget,
                    bootstrapResolveImport(manifestBase, line.written),
                    bootstrapResolveImport(manifestBase, line.writtenTarget),
                    line.begin, line.end
                ))
            } else {
                resolved.append(BootstrapImportRemapEntry(
                    "", "", "", "", line.begin, line.end, line.code, line.problem
                ))
            }
        }
        val entries: array<BootstrapImportRemapEntry> = []
        var index = 0
        while (index < resolved.size) {
            val entry = resolved[index]
            var code = entry.code
            var problem = entry.problem
            var notes = ""
            if (code == "") {
                problem = bootstrapImportRemapProblem(resolved, index)
                if (problem != "") code = "E_IMPORT_REMAP_INVALID"
            }
            if (code == "") {
                val mismatch = bootstrapImportRemapMismatches(
                    entry,
                    this.state.acquire(this.state.exposedTarget(entry.source)).discovery,
                    this.state.acquire(this.state.exposedTarget(entry.target)).discovery
                )
                if (mismatch.errors > 0) {
                    code = "E_IMPORT_REMAP_MISMATCH"
                    problem =
                        "`${entry.writtenTarget}` can't stand in for `${entry.written}`: it must declare everything `${entry.written}` declares publicly, with the same signatures"
                    notes = mismatch.diagnostics
                }
            }
            if (code != "") {
                this.errors = this.errors + 1
                this.diagnostics = "${this.diagnostics}${bootstrapImportRemapDiagnostic(
                    code, problem, manifest, entry.begin, entry.end
                )}$notes"
            }
            entries.append(BootstrapImportRemapEntry(
                entry.written, entry.writtenTarget, entry.source, entry.target,
                entry.begin, entry.end, code, problem, notes
            ))
            index = index + 1
        }
        this.index.remapEntries = entries
        bootstrapImportRemapEntries = entries
    }

    /** An `[imports]` table in `modulePath`'s manifest, unless that is the
     *  root's, is an error (once per manifest). */
    fun checkModuleManifest(modulePath: string): void {
        if (bootstrapStandardLibraryModuleSource(modulePath) ||
            modulePath.startsWith("<")) return
        val manifest = this.nearestManifest(modulePath)
        if (manifest == "" || manifest == this.index.remapRoot ||
            this.index.remapReported.get(manifest) != null) return
        this.index.remapReported.set(manifest, 1)
        val offset = bootstrapManifestTableOffset(manifest, "imports")
        if (offset >= 0) {
            this.errors = this.errors + 1
            this.diagnostics = "${this.diagnostics}${bootstrapImportRemapDiagnostic(
                "E_IMPORT_REMAP_NOT_ROOT",
                "only the root abla.toml may remap imports; this manifest is a dependency's (module `$modulePath`)",
                manifest, offset, offset + 9
            )}"
        }
    }

    /** A module loaded for its contract now loads in full, at its new place. */
    fun dropContractLoad(identity: string): void {
        this.index.upgradedModules.set(identity, 1)
        // The contract edges it got to classes behind other modules are redundant
        // now: its own imports load those in full. Each becomes an unreachable
        // placeholder (a contract edge that stayed would make a second, contract
        // copy of a module the program also loads in full).
        val slot = this.index.importers.get(identity)
        var edge = if (slot != null) this.index.firstAlias[slot] else -1
        while (edge >= 0) {
            val found = this.aliases[edge]
            if (found.contractOnly &&
                this.index.transitiveEdges.get("$identity\n${found.target}") != null) {
                this.aliases[edge] = BootstrapModuleAlias(
                    "", "", "<dropped>", true, found.begin, found.end
                )
            }
            edge = this.index.aliasNext[edge]
        }
        var index = 0
        while (index < this.orderedSnapshots.size) {
            if (this.orderedSnapshots[index].path == identity) {
                while (index + 1 < this.orderedSnapshots.size) {
                    this.orderedSnapshots[index] = this.orderedSnapshots[index + 1]
                    index = index + 1
                }
                this.orderedSnapshots.truncate(index)
                return
            }
            index = index + 1
        }
        return
    }

    fun load(modulePath: string): string {
        bootstrapLexMemoActive = true
        val identity = bootstrapNormalizeModulePath(modulePath)
        if (this.index.remapRoot == "" &&
            !bootstrapStandardLibraryModuleSource(identity)) {
            this.useRootManifest(identity)
        }
        bootstrapImportRemapEntries = this.index.remapEntries
        if (this.modules.size == 0 &&
            this.authorizedCompileCapabilities.size == 0) {
            val capabilities = bootstrapManifestCompileCapabilities(identity)
            ctNativeSetEntry(identity)
            var capability = 0
            while (capability < capabilities.size) {
                this.authorizedCompileCapabilities.append(
                    capabilities[capability]
                )
                capability = capability + 1
            }
        }
        var output = ""
        val known = this.contains(identity)
        if (!known || !this.index.fullModules.has(identity)) {
            this.index.fullModules.set(identity, 1)
            if (known) this.dropContractLoad(identity)
            this.checkModuleManifest(identity)
            val snapshot = this.rawSnapshot(this.state.acquire(identity))
            bootstrapFrontendTraceMemory("graph.acquire:$identity")
            if (bootstrapJsonConstructionRequested) bootstrapJsonConstructionCapture(identity, snapshot.source, bootstrapStandardLibraryRoot())
            this.errors = this.errors + snapshot.importErrors
            if (snapshot.importErrors > 0) {
                this.diagnostics =
                    "${this.diagnostics}${bootstrapScanImportsWithIdentity(if (snapshot.hostSource == "") snapshot.source else snapshot.hostSource, snapshot.path).diagnostics}"
            }
            if (!known) this.modules.append(BootstrapModule(identity, snapshot.source, snapshot.hostSource))
            var index = 0
            while (index < snapshot.importEdges.size) {
                val edge = snapshot.importEdges[index]
                if (!edge.provider) {
                    // The portable implementation also serves older bootstrap
                    // compilers. Only x86-64 native builds load the SSE2 kernels.
                    val runtimeScan = this.index.runtimeSimdScan &&
                        edge.source == "./simd-scan.ab" &&
                        identity == bootstrapNormalizeModulePath(Path(bootstrapStandardLibraryRoot())
                            .child("abla/runtime/self/entry.ab").text)
                    val imported = bootstrapResolveImport(identity,
                        if (runtimeScan) "./simd-scan-x86.ab" else edge.source)
                    this.recordImportEdge(
                        snapshot,
                        edge,
                        this.state.exposedTarget(imported)
                    )
                    // A missing file is an error at its import, not an empty module
                    // whose declarations later fail as unknown names.
                    if (!this.state.sourceExists(imported)) {
                        this.errors = this.errors + 1
                        val help = if (edge.source.startsWith("abla/"))
                            "check the standard module name and whether it ships with this compiler's toolchain"
                            else "check the path and spelling; a relative import starts from the directory of the importing file"
                        this.diagnostics =
                            "${this.diagnostics}error[E_IMPORT_NOT_FOUND]: imported module `${edge.source}` doesn't exist (looked for $imported)\nsource[import]:$identity:${edge.begin}:${edge.end}\nhelp: $help\n"
                    } else if (edge.contractOnly) {
                        this.loadContract(imported)
                    } else this.load(imported)
                } else {
                    val provider = if (this.state.syntaxOnly)
                        bootstrapLiteralImportProvider(edge.source, this.index.remapRoot,
                            this.orderedSnapshots,
                            snapshot.discovery) else bootstrapEvaluateImportProvider(
                                edge.source, this.orderedSnapshots,
                                snapshot.discovery
                            )
                    if (provider.errors == 0) {
                        var imported = bootstrapResolvePackageImport(
                            identity, "package/${provider.dependency.name}"
                        )
                        var subpathDiagnostic = ""
                        if (this.state.syntaxOnly && imported != "" &&
                            !bootstrapLiteralImportCurrent(this.index.remapRoot,
                                provider.dependency, imported)) {
                            subpathDiagnostic =
                                "error[E_PACKAGE_LOCK_DISAGREEMENT]: materialized package metadata does not match the root lock\n"
                        }
                        if (subpathDiagnostic == "" && imported != "" &&
                            provider.dependency.subpaths.size > 0) {
                            val found = bootstrapPackageFindSubpath(
                                bootstrapPackageRootOfEntry(imported, provider.dependency.name),
                                provider.dependency.name, provider.dependency.subpaths[0]
                            )
                            // (Spelled as the module's own path, as an entry's import is: a
                            // strict importer otherwise sees nothing of it.)
                            imported = bootstrapNormalizeModulePath(found.path)
                            subpathDiagnostic = found.diagnostic
                        }
                        if (subpathDiagnostic != "") {
                            this.errors = this.errors + 1
                            this.diagnostics =
                                "${this.diagnostics}${subpathDiagnostic}source[import]:$identity:${edge.begin}:${edge.end}\n"
                        } else if (imported != "") {
                            this.recordImportEdge(
                                snapshot,
                                edge,
                                this.state.exposedTarget(imported)
                            )
                            if (edge.contractOnly) {
                                this.loadContract(imported)
                            } else this.load(imported)
                        } else {
                            this.errors = this.errors + 1
                            this.diagnostics =
                                "${this.diagnostics}error[E_PACKAGE_IMPORT]: locked package `${provider.dependency.name}` could not be resolved from module `$identity`\n${if (this.state.syntaxOnly) "source[import]:$identity:${edge.begin}:${edge.end}\n" else ""}"
                        }
                    } else {
                        this.errors = this.errors + provider.errors
                        this.diagnostics =
                            "${this.diagnostics}${provider.diagnostic}${if (this.state.syntaxOnly) "source[import]:$identity:${edge.begin}:${edge.end}\n" else ""}"
                    }
                }
                index = index + 1
            }
            this.orderedSnapshots.append(snapshot)
            // parse() consumes orderedSnapshots. Return only this requested
            // module instead of rebuilding the transitive graph as text at
            // each recursion level.
            output = snapshot.source
        }
        output
    }

    /** abla/stm, for a program whose code names `TVar` or `Transactional`
     *  (which need no import), unless a module of it declares its own
     *  `TVar`: a program without them parses as it did before. */
    fun loadImplicitTransactions(): void {
        val path = bootstrapImplicitTransactionsPath()
        if (this.contains(path)) return
        var named = false
        for (snapshot in this.orderedSnapshots) {
            for (declaration in snapshot.discovery.declarations) {
                if (declaration.extensionOwner == "" && declaration.kind != "extend" &&
                    declaration.name == "TVar") return
            }
            if (!named && !bootstrapRuntimeModuleSource(snapshot.path) &&
                (bootstrapSourceNamesWord(snapshot.source, "TVar") ||
                 bootstrapSourceNamesWord(snapshot.source, "Transactional"))) named = true
        }
        if (named) this.load(path)
        return
    }

    fun parse(): BootstrapParseResult {
        val enclosingRoot = bootstrapModuleIdentityRoot
        val enclosingStdlib = bootstrapModuleIdentityStdlib
        val enclosingPrefixes = bootstrapModuleIdentityPrefixes
        bootstrapModuleIdentityRoot = if (this.index.entryPath == "") ""
            else bootstrapModuleIdentityProjectRoot(this.index.entryPath)
        bootstrapModuleIdentityStdlib = bootstrapNormalizeModulePath(
            bootstrapAbsoluteModulePath(bootstrapStandardLibraryRoot())
        )
        bootstrapModuleIdentityPrefixes = Map()
        bootstrapImportRemapEntries = this.index.remapEntries
        // The placeholders of dropped contract edges (dropContractLoad) go before anything
        // reads the edges; the loads are over, so no chain needs their places.
        val kept: array<BootstrapModuleAlias> = []
        for (alias in this.aliases) {
            if (alias.importer != "") kept.append(alias)
        }
        if (kept.size < this.aliases.size) {
            this.aliases.truncate(0)
            for (alias in kept) this.aliases.append(alias)
        }
        bootstrapModuleImportsBegin()
        for (alias in this.aliases) {
            bootstrapModuleImportRecord(alias.target, alias.importer, alias.begin, alias.end)
        }
        this.loadImplicitTransactions()
        bootstrapFrontendTraceMemory(
            "parse.begin:${this.orderedSnapshots.size}"
        )
        // Clear transactional transform requests once per candidate graph.
        // Ordinary modules now bypass transform processing entirely.
        bootstrapTakeFunctionBodyReplacements()
        bootstrapTakeFunctionAnnotationAdditions()
        val declarations: array<BootstrapDeclaration> = []
        val actions: array<BootstrapExpression> = []
        val compileInputPaths: array<string> = []
        val compileInputContents: array<string> = []
        val handlerDeclarations: array<BootstrapDeclaration> = []
        // What the modules' transforms changed in other modules, in module order.
        val declarationEdits: array<BootstrapDeclarationEdit> = []
        val importedRegistrations: array<BootstrapSubparserRegistration> = []
        val preparedSnapshots: array<BootstrapModuleSnapshot> = []
        val aliasSummary = bootstrapAliasSummary(
            this.aliases, this.orderedSnapshots, this.index.fullModules
        )
        val shadows = bootstrapModuleShadows(
            this.aliases, this.orderedSnapshots, aliasSummary
        )
        var preparedIndex = 0
        while (preparedIndex < this.orderedSnapshots.size) {
            val prepared = bootstrapPrepareModuleSnapshot(
                this.orderedSnapshots[preparedIndex],
                this.aliases,
                this.orderedSnapshots,
                shadows,
                aliasSummary,
                !this.index.contractRoots.has(this.orderedSnapshots[preparedIndex].path)
            )
            preparedSnapshots.append(prepared)
            if (aliasSummary.twinnedTargets.has(prepared.path)) {
                preparedSnapshots.append(bootstrapContractTwinSnapshot(prepared))
            }
            preparedIndex = preparedIndex + 1
        }
        bootstrapFrontendTraceMemory(
            "parse.prepared:${preparedSnapshots.size}"
        )
        val aliasValidation = bootstrapValidateImportAliases(
            this.aliases, this.state
        )
        bootstrapFrontendTraceMemory("parse.aliases")
        // W_UNUSED_IMPORT warns within the program's project: the entry this graph was rooted at (the first graph
        // parsed is the program's; a compile-time graph parses later).
        if ((bootstrapUnusedImportsWanted() || bootstrapJsonConstructionRequested) && bootstrapUnusedImportEntry == "" && this.index.entryPath != "") {
            bootstrapUnusedImportEntry = this.index.entryPath
        }
        if (bootstrapJsonConstructionRequested) {
            for (module in this.modules) bootstrapJsonConstructionOwned.set(module.path, bootstrapUnusedImportInProject(module.path))
        }
        val strictValidation = bootstrapValidateStrictImports(
            this.aliases, this.orderedSnapshots, this.index.fullModules,
            this.index.contractRoots
        )
        var parseErrors = this.errors + aliasValidation.errors +
            strictValidation.errors
        var extensionErrors = 0
        val stackDepthStoppedSources: array<BootstrapStackDepthStop> = []
        var parseDiagnostics =
            "${this.diagnostics}${aliasValidation.diagnostics}${strictValidation.diagnostics}"
        var dependencyFingerprint = 29
        var authorizedEffects = 0
        var authorized = 0
        while (authorized < this.authorizedCompileCapabilities.size) {
            authorizedEffects = bootstrapCompileEffectMerge(
                authorizedEffects,
                bootstrapCompileEffectFromName(
                    this.authorizedCompileCapabilities[authorized]
                )
            )
            authorized = authorized + 1
        }
        var requestedEffects = 0
        val completeDeclarations: array<BootstrapDeclaration> = []
        var completeDeclarationFingerprint = 41
        var requestedModule = 0
        while (requestedModule < preparedSnapshots.size) {
            val requestedSnapshot = preparedSnapshots[requestedModule]
            requestedEffects = bootstrapCompileEffectMerge(
                requestedEffects,
                bootstrapBuildCompileEffectRequests(
                    requestedSnapshot.discovery
                )
            )
            var completeDeclaration = 0
            while (completeDeclaration <
                    requestedSnapshot.discovery.declarations.size) {
                completeDeclarations.append(
                    requestedSnapshot.discovery.declarations[completeDeclaration]
                )
                completeDeclaration = completeDeclaration + 1
            }
            // The staged parse cache uses this key. Syntax-only parses never consult it.
            if (!this.state.syntaxOnly) {
                val completeInterface = bootstrapModuleInterfaceIdentity(
                    requestedSnapshot.discovery,
                    requestedSnapshot.firstFingerprint,
                    requestedSnapshot.secondFingerprint
                )
                completeDeclarationFingerprint =
                    completeDeclarationFingerprint * 277 +
                    bootstrapModuleFingerprint(
                        completeInterface, 79, 281, 1000000007
                    )
                completeDeclarationFingerprint =
                    completeDeclarationFingerprint -
                    (completeDeclarationFingerprint / 1000000007) *
                        1000000007
            }
            requestedModule = requestedModule + 1
        }
        bootstrapFrontendTraceMemory(
            "parse.interfaces:${completeDeclarations.size}"
        )
        val allowedCompileEffects = bootstrapBuildCompileEffectGrants(
            requestedEffects,
            authorizedEffects
        )
        dependencyFingerprint = dependencyFingerprint + allowedCompileEffects +
            completeDeclarationFingerprint
        for (requesting in preparedSnapshots) {
            if (bootstrapCompileEffectHas(bootstrapBuildCompileEffectRequests(requesting.discovery),
                    BOOTSTRAP_COMPILE_TIME_UNLIMITED) &&
                !bootstrapAffineNamesContain(bootstrapCompileUnlimitedModules, requesting.path))
                bootstrapCompileUnlimitedModules.append(requesting.path)
        }
        var moduleIndex = 0
        var currentDeclarationBegin = 0
        while (moduleIndex < preparedSnapshots.size) {
            val snapshot = preparedSnapshots[moduleIndex]
            bootstrapFrontendTraceMemory(
                "parse.module.begin:$moduleIndex:${snapshot.path}"
            )
            var localRegistry = BootstrapSubparserRegistry([], 0, "")
            // The editor (syntax-only) expands the standard library's subparsers ($json, $html, ...): they are part of the
            // compiler's trusted base. A package's or the user's own stay unexpanded there (analysis never runs their code).
            if ((!this.state.syntaxOnly || bootstrapPathIsStandardLibrary(snapshot.path)) && bootstrapActionsRegisterSubparser(
                snapshot.discovery.actions
            )) {
                val visibleDeclarations: array<BootstrapDeclaration> = []
                var visibleDeclaration = 0
                while (visibleDeclaration < handlerDeclarations.size) {
                    visibleDeclarations.append(
                        handlerDeclarations[visibleDeclaration]
                    )
                    visibleDeclaration = visibleDeclaration + 1
                }
                visibleDeclaration = 0
                while (visibleDeclaration <
                    snapshot.discovery.declarations.size) {
                    visibleDeclarations.append(
                        snapshot.discovery.declarations[visibleDeclaration]
                    )
                    visibleDeclaration = visibleDeclaration + 1
                }
                localRegistry = bootstrapBuildSubparserRegistry(
                    BootstrapParseResult(
                        visibleDeclarations,
                        snapshot.discovery.actions,
                        snapshot.discovery.errors,
                        snapshot.discovery.extensionErrors,
                        [],
                        [],
                        snapshot.discovery.diagnostics
                    )
                )
            }
            parseErrors = parseErrors + localRegistry.errors
            extensionErrors = extensionErrors + localRegistry.errors
            parseDiagnostics =
                "$parseDiagnostics${localRegistry.diagnostics}"
            val moduleRegistrations: array<BootstrapSubparserRegistration> = []
            var declarationIndex = 0
            var registrationIndex = 0
            while (registrationIndex < importedRegistrations.size) {
                moduleRegistrations.append(
                    importedRegistrations[registrationIndex]
                )
                registrationIndex = registrationIndex + 1
            }
            registrationIndex = 0
            while (registrationIndex < localRegistry.registrations.size) {
                val registration = localRegistry.registrations[registrationIndex]
                var duplicate = false
                var importedIndex = 0
                while (importedIndex < importedRegistrations.size) {
                    if (importedRegistrations[importedIndex].name ==
                        registration.name) duplicate = true
                    importedIndex = importedIndex + 1
                }
                if (duplicate) {
                    parseErrors = parseErrors + 1
                    extensionErrors = extensionErrors + 1
                    parseDiagnostics =
                        "${parseDiagnostics}error[E_EXT_SUBPARSER_COLLISION]: imported subparser `${registration.name}` is registered more than once\nsource[module]:${snapshot.path}:0:0\n"
                    0
                } else {
                    moduleRegistrations.append(registration)
                    importedRegistrations.append(
                        BootstrapSubparserRegistration(
                            registration.name,
                            registration.handler,
                            -1,
                            registration.rawBoundary
                        )
                    )
                    0
                }
                registrationIndex = registrationIndex + 1
            }

            val parsed = if (aliasSummary.isContractTarget(snapshot.path))
                snapshot.discovery
            else this.state.acquireParsed(
                snapshot,
                dependencyFingerprint,
                completeDeclarations,
                currentDeclarationBegin,
                snapshot.discovery.declarations.size,
                BootstrapSubparserRegistry(moduleRegistrations, 0, ""),
                allowedCompileEffects
            )
            bootstrapFrontendTraceMemory(
                "parse.module.end:$moduleIndex:${parsed.declarations.size}"
            )
            if (!this.state.syntaxOnly) {
                val interfaceIdentity = bootstrapModuleInterfaceIdentity(
                    parsed,
                    snapshot.firstFingerprint,
                    snapshot.secondFingerprint
                )
                dependencyFingerprint = dependencyFingerprint * 257 +
                    bootstrapModuleFingerprint(
                        interfaceIdentity, 31, 269, 1000000007
                    )
                dependencyFingerprint = dependencyFingerprint -
                    (dependencyFingerprint / 1000000007) * 1000000007
                dependencyFingerprint = dependencyFingerprint * 263 +
                    bootstrapModuleFingerprint(
                        interfaceIdentity, 73, 271, 1000000009
                    )
                dependencyFingerprint = dependencyFingerprint -
                    (dependencyFingerprint / 1000000009) * 1000000009
            }
            parseErrors = parseErrors + parsed.errors
            if (bootstrapJsonConstructionRequested) bootstrapJsonConstructionSubparsers.set(snapshot.path, parsed.subparserSpans)
            if (bootstrapStrictDeferredFindings.size > 0) {
                val settled = bootstrapStrictSettleDeferred(snapshot.path, parsed)
                parseErrors = parseErrors + settled.errors
                parseDiagnostics = "$parseDiagnostics${settled.diagnostics}"
            }
            extensionErrors = extensionErrors + parsed.extensionErrors
            for (source in parsed.stackDepthStoppedSources) stackDepthStoppedSources.append(source)
            parseDiagnostics = "$parseDiagnostics${parsed.diagnostics}"
            bootstrapMergeCompileInputs(
                compileInputPaths,
                compileInputContents,
                parsed.compileInputPaths,
                parsed.compileInputContents
            )
            declarationIndex = 0
            while (declarationIndex < parsed.declarations.size) {
                declarations.append(parsed.declarations[declarationIndex])
                handlerDeclarations.append(parsed.declarations[declarationIndex])
                declarationIndex = declarationIndex + 1
            }
            // Later modules may inspect imported function bodies through typed
            // reflection. Replace discovery placeholders with the declarations
            // already parsed here, preserving the discovery slots used by the
            // staged parser even when expansion inserts generated declarations.
            // Each takes the first parsed declaration of its kind and name,
            // found through one index of the module (a scan per placeholder
            // was quadratic in the module's size); ABLA_MODULE_INDEX_CHECK=1
            // checks each against the scan.
            val parsedByName: Map<string, int> = Map()
            var indexed = 0
            while (indexed < parsed.declarations.size) {
                val key = bootstrapModuleDeclarationKey(parsed.declarations[indexed])
                if (!parsedByName.has(key)) parsedByName.set(key, indexed)
                indexed = indexed + 1
            }
            val checkIndex = bootstrapModuleIndexCheck()
            var discovered = 0
            while (discovered < snapshot.discovery.declarations.size) {
                val original = snapshot.discovery.declarations[discovered]
                val resolved = parsedByName.get(bootstrapModuleDeclarationKey(original))
                val at = if (resolved != null) resolved else -1
                if (at >= 0) {
                    completeDeclarations[currentDeclarationBegin + discovered] =
                        parsed.declarations[at]
                }
                if (checkIndex) {
                    var scanned = 0
                    while (scanned < parsed.declarations.size &&
                        !(parsed.declarations[scanned].name == original.name &&
                          parsed.declarations[scanned].kind == original.kind)) {
                        scanned = scanned + 1
                    }
                    if (scanned == parsed.declarations.size) scanned = -1
                    if (scanned != at) linuxWriteStandardError(
                        "error[E_INTERNAL]: module.index-check: `${original.name}` resolved to $at, a scan says $scanned\n"
                    )
                }
                discovered = discovered + 1
            }
            var actionIndex = 0
            while (actionIndex < parsed.actions.size) {
                actions.append(parsed.actions[actionIndex])
                actionIndex = actionIndex + 1
            }
            for (edit in parsed.declarationEdits) declarationEdits.append(edit)
            if (parsed.declarationEdits.size > 0) {
                // The modules parsed after this one see its edits, and their
                // reusable parses are keyed by them.
                val _viewed = bootstrapApplyDeclarationEdits(
                    completeDeclarations, parsed.declarationEdits, true
                )
                if (!this.state.syntaxOnly) {
                    dependencyFingerprint = dependencyFingerprint * 251 +
                        bootstrapDeclarationEditFingerprint(parsed.declarationEdits)
                    dependencyFingerprint = dependencyFingerprint -
                        (dependencyFingerprint / 1000000007) * 1000000007
                }
            }
            moduleIndex = moduleIndex + 1
            currentDeclarationBegin = currentDeclarationBegin +
                snapshot.discovery.declarations.size
        }
        bootstrapFrontendTraceMemory(
            "parse.modules.end:${declarations.size}"
        )
        var capability = 0
        while (capability < this.authorizedCompileCapabilities.size) {
            actions.append(BootstrapExpression(
                "compile.capability.authorization",
                this.authorizedCompileCapabilities[capability],
                0,
                0,
                []
            ))
            capability = capability + 1
        }
        // The modules' changes to each other, on the raw declarations.
        val edited = bootstrapApplyDeclarationEdits(declarations, declarationEdits)
        parseErrors = parseErrors + edited.errors
        extensionErrors = extensionErrors + edited.errors
        parseDiagnostics = "$parseDiagnostics${edited.diagnostics}"
        bootstrapFrontendTraceMemory("parse.normalize.begin")
        // One graph's count: a parse whose result never reached code generation
        // (an analysis-only request) leaves nothing behind for the next one.
        val _staleNamedArgumentErrors = bootstrapTakeNamedArgumentErrors()
        val assembled = BootstrapParseResult(
            declarations,
            actions,
            parseErrors,
            extensionErrors,
            compileInputPaths,
            compileInputContents,
            parseDiagnostics,
            [],
            stackDepthStoppedSources
        )
        // Named overload probing calls sema; keep it out of the no-evaluation
        // parse boundary, until the caller has inspected blocked CT sites.
        val normalized = if (this.state.syntaxOnly) assembled
            else bootstrapNormalizeNamedArguments(assembled)
        bootstrapFrontendTraceMemory("parse.normalize.end")
        bootstrapLexMemoEnd()
        bootstrapModuleIdentityRoot = enclosingRoot
        bootstrapModuleIdentityStdlib = enclosingStdlib
        bootstrapModuleIdentityPrefixes = enclosingPrefixes
        normalized
    }
}

/** The path of abla/stm, which a program naming `TVar` or `Transactional`
 *  has without importing it (loadImplicitTransactions). */
fun bootstrapImplicitTransactionsPath(): string =
    bootstrapNormalizeModulePath(Path(bootstrapStandardLibraryRoot()).child("abla/stm/entry.ab")
        .text)

/** Whether `source` has the word `word` outside its comments (a string
 *  literal may name it too: at worst the module is loaded for nothing). */
fun bootstrapSourceNamesWord(source: string, word: string): bool {
    var index = 0
    while (index < source.size) {
        val byte = source[index]
        if (byte == 47 && index + 1 < source.size && source[index + 1] == 47) {
            while (index < source.size && source[index] != 10) index = index + 1
        } else if (byte == 47 && index + 1 < source.size && source[index + 1] == 42) {
            index = index + 2
            while (index + 1 < source.size && !(source[index] == 42 && source[index + 1] ==
                47)) index = index + 1
            index = index + 2
        } else if (bootstrapGenericWordByte(byte)) {
            var end = index
            while (end < source.size && bootstrapGenericWordByte(source[end])) end = end + 1
            if (end - index == word.size && source.slice(index, end) == word) return true
            index = end
        } else index = index + 1
    }
    false
}

