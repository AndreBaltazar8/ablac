import "eval.ab"
import "borrow_inference.ab"
import "subparser.ab"
import "source_rewrite.ab"
import "parser.ab"
import "generic_types.ab"
import "sema.ab"
import "compile_actions.ab"
import "lexer.ab"
import "ct_lift.ab"

fun bootstrapMergeCompileInputs(
    var paths: array<string>,
    var contents: array<string>,
    incomingPaths: array<string>,
    incomingContents: array<string>
): void {
    var input = 0
    while (input < incomingPaths.size) {
        val path = incomingPaths[input]
        var found = -1
        var existing = 0
        while (existing < paths.size) {
            if (paths[existing] == path) found = existing
            existing = existing + 1
        }
        if (found >= 0) {
            contents[found] = incomingContents[input]
        } else {
            paths.append(path)
            contents.append(incomingContents[input])
        }
        input = input + 1
    }
}

fun bootstrapGeneratedRequestDiagnostic(
    code: string,
    message: string,
    request: BootstrapExtensionRequest
): string =
    "error[$code]: $message\ncontext[generated-namespace]: ${request.namespace}\nsource[extension-request]:${request.sourceIdentity}:${request.expression.begin}:${request.expression.end}\n"

fun bootstrapRegistrationIndex(
    registry: BootstrapSubparserRegistry,
    name: string,
    position: int
): int {
    var result = -1
    var index = 0
    while (index < registry.registrations.size) {
        val registration = registry.registrations[index]
        if (registration.name == name &&
            registration.availableFrom <= position) result = index
        index = index + 1
    }
    result
}

fun bootstrapReplacementFunctionSource(
    declaration: BootstrapDeclaration,
    body: string
): string {
    var source = "fun __abla_replacement("
    var parameter = 0
    while (parameter < declaration.parameters.size) {
        if (parameter > 0) source = "$source, "
        if (parameter < declaration.parameterKinds.size &&
            declaration.parameterKinds[parameter] == "own") {
            source = "${source}own "
        }
        if (parameter < declaration.parameterKinds.size &&
            declaration.parameterKinds[parameter] == "var") {
            source = "${source}var "
        }
        source = "$source${declaration.parameters[parameter]}: "
        source = "$source${declaration.parameterTypes[parameter]}"
        parameter = parameter + 1
    }
    source = "$source)"
    if (declaration.resultType != "inferred") {
        source = "$source: ${declaration.resultType}"
    }
    if (body.size > 0 && body[0] == 123) {
        source = "$source $body"
    } else source = "$source = $body"
    source
}

fun bootstrapDeclarationWithExpression(
    declaration: BootstrapDeclaration,
    expression: BootstrapExpression
): BootstrapDeclaration = BootstrapDeclaration(
    declaration.kind,
    declaration.name,
    declaration.begin,
    declaration.end,
    expression,
    declaration.parameters,
    declaration.parameterTypes,
    declaration.resultType,
    declaration.methods,
    declaration.parameterDefaults,
    declaration.externalLibrary,
    declaration.parameterKinds,
    declaration.extensionOwner,
    declaration.isTrusted,
    declaration.isResource,
    declaration.isNoEscape,
    declaration.generatedNamespace,
    declaration.generatedOriginBegin,
    declaration.generatedOriginEnd,
    declaration.annotations,
    declaration.annotationArguments,
    declaration.annotationBegins,
    declaration.annotationEnds,
    declaration.sourceIdentity,
    declaration.conformances,
    declaration.isSealed,
    declaration.isPrivate,
    declaration.typeParameters
)

fun bootstrapDeclarationWithName(
    declaration: BootstrapDeclaration,
    name: string
): BootstrapDeclaration = BootstrapDeclaration(
    declaration.kind,
    name,
    declaration.begin,
    declaration.end,
    declaration.expression,
    declaration.parameters,
    declaration.parameterTypes,
    declaration.resultType,
    declaration.methods,
    declaration.parameterDefaults,
    declaration.externalLibrary,
    declaration.parameterKinds,
    declaration.extensionOwner,
    declaration.isTrusted,
    declaration.isResource,
    declaration.isNoEscape,
    declaration.generatedNamespace,
    declaration.generatedOriginBegin,
    declaration.generatedOriginEnd,
    declaration.annotations,
    declaration.annotationArguments,
    declaration.annotationBegins,
    declaration.annotationEnds,
    declaration.sourceIdentity,
    declaration.conformances,
    declaration.isSealed,
    declaration.isPrivate,
    declaration.typeParameters
)

fun bootstrapIndependentEntryIdentity(identity: string): bool {
    val suffix = ".abla-independent.ab"
    identity.size >= suffix.size &&
        identity.slice(identity.size - suffix.size, identity.size) == suffix
}

fun bootstrapDeclarationWithAnnotation(
    declaration: BootstrapDeclaration,
    annotation: string
): BootstrapDeclaration {
    val annotations: array<string> = []
    val arguments: array<BootstrapExpression> = []
    val begins: array<int> = []
    val ends: array<int> = []
    var index = 0
    while (index < declaration.annotations.size) {
        annotations.append(declaration.annotations[index])
        arguments.append(declaration.annotationArguments[index])
        begins.append(declaration.annotationBegins[index])
        ends.append(declaration.annotationEnds[index])
        index = index + 1
    }
    annotations.append(annotation)
    arguments.append(BootstrapExpression(
        "missing", "", declaration.begin, declaration.begin, []
    ))
    begins.append(declaration.begin)
    ends.append(declaration.begin)
    BootstrapDeclaration(
        declaration.kind,
        declaration.name,
        declaration.begin,
        declaration.end,
        declaration.expression,
        declaration.parameters,
        declaration.parameterTypes,
        declaration.resultType,
        declaration.methods,
        declaration.parameterDefaults,
        declaration.externalLibrary,
        declaration.parameterKinds,
        declaration.extensionOwner,
        declaration.isTrusted,
        declaration.isResource,
        declaration.isNoEscape,
        declaration.generatedNamespace,
        declaration.generatedOriginBegin,
        declaration.generatedOriginEnd,
        annotations,
        arguments,
        begins,
        ends,
        declaration.sourceIdentity,
        declaration.conformances,
        declaration.isSealed,
        declaration.isPrivate,
        declaration.typeParameters
    )
}

fun bootstrapApplyFunctionBodyReplacement(
    var declarations: array<BootstrapDeclaration>,
    replacement: BootstrapFunctionBodyReplacement
): bool {
    var valid = replacement.handle >= 0 &&
        replacement.handle < declarations.size
    if (valid) {
        val declaration = declarations[replacement.handle]
        valid = declaration.kind == "fun" &&
            declaration.extensionOwner == "" &&
            declaration.parameterDefaults.size == declaration.parameters.size
        // The body reads names as its module does: that module's private
        // names (and every name of a module imported under an alias
        // elsewhere) carry its prefix.
        val own: array<BootstrapDeclaration> = []
        for (candidate in declarations) {
            if (candidate.sourceIdentity == declaration.sourceIdentity) own.append(candidate)
        }
        val parsed = bootstrapParse(bootstrapGeneratedSourceWithPrivates(
            bootstrapReplacementFunctionSource(declaration, replacement.body),
            declaration.sourceIdentity,
            own
        ))
        valid = valid && parsed.errors == 0 &&
            parsed.declarations.size == 1 && parsed.actions.size == 0 &&
            parsed.declarations[0].kind == "fun" &&
            parsed.declarations[0].expression.kind != "missing"
        if (valid) declarations[replacement.handle] =
            bootstrapDeclarationWithExpression(
                declaration,
                parsed.declarations[0].expression
            )
    }
    valid
}

fun bootstrapApplyFunctionAnnotationAddition(
    var declarations: array<BootstrapDeclaration>,
    addition: BootstrapFunctionAnnotationAddition
): bool {
    var valid = addition.handle >= 0 &&
        addition.handle < declarations.size
    if (valid) {
        val declaration = declarations[addition.handle]
        valid = declaration.kind == "fun" &&
            declaration.extensionOwner == ""
        var annotation = 0
        while (valid && annotation < declaration.annotations.size) {
            if (declaration.annotations[annotation] == addition.annotation) {
                valid = false
            }
            annotation = annotation + 1
        }
        if (valid) {
            bootstrapTransformEdits.append(BootstrapDeclarationEdit(
                "annotate",
                declaration.sourceIdentity,
                declaration.extensionOwner,
                declaration.name,
                bootstrapEditSignature(declaration),
                addition.annotation,
                [],
                bootstrapCompilerTransformOrigin,
                "transform"
            ))
            declarations[addition.handle] = bootstrapDeclarationWithAnnotation(
                declaration, addition.annotation
            )
        }
    }
    valid
}

/** The source of the transform handler `handler` (a unique compile fun). */
fun bootstrapCompilerTransformHandlerSource(
    declarations: array<BootstrapDeclaration>,
    handler: string
): string {
    for (declaration in declarations) {
        if (declaration.name == handler && declaration.kind == "compile.fun" &&
            declaration.extensionOwner == "") return declaration.sourceIdentity
    }
    ""
}

/** The edits the transform stage made so far, and a fresh list for the next. */
fun bootstrapTakeTransformEdits(): array<BootstrapDeclarationEdit> {
    val edits = bootstrapTransformEdits
    bootstrapTransformEdits = []
    edits
}

class BootstrapEditOutcome(val errors: int, val diagnostics: string)

/** Whether `declaration` is the target of `edit`. */
fun bootstrapEditTargets(edit: BootstrapDeclarationEdit, declaration: BootstrapDeclaration): bool {
    if (declaration.sourceIdentity != edit.targetIdentity) return false
    if (edit.kind == "removeField") {
        return bootstrapIsExtensionFieldKind(declaration.kind) &&
            declaration.extensionOwner == edit.owner && declaration.name == edit.name
    }
    declaration.kind == "fun" && declaration.extensionOwner == edit.owner &&
        declaration.name == edit.name &&
        (edit.signature == "" || bootstrapEditSignature(declaration) == edit.signature)
}

/** The declaration that asks the generics pass for the instance `spelling`
 *  (`Box<int>`) in module `identity`: `@__abla_instantiate("Box<int>")
 *  compile fun __abla_instantiate_<spelling>(): void {}`. */
fun bootstrapInstantiationRequest(identity: string, spelling: string): BootstrapDeclaration {
    BootstrapDeclaration(
        "compile.fun", "__abla_instantiate_${bootstrapGenericEscape(spelling)}", 0, 0,
        BootstrapExpression("block", "", 0, 0, []),
        [], [], "void", [], [], "", [], "", false, false, false, "", 0, 0,
        ["__abla_instantiate"], [BootstrapExpression("string", spelling, 0, 0, [])], [0], [0],
        identity
    )
}

/** Applies `edits` to the complete graph's declarations, raw (before any
 *  rewrite), in their order. Each target must be exactly one declaration
 *  (E_COMPILER_EDIT_TARGET), and two replacements of one body must agree
 *  (E_COMPILER_EDIT_CONFLICT). A module's own changes are already in its
 *  declarations; with `quiet` (a later module's view while the graph is still
 *  being parsed) a target not there yet is no error. */
fun bootstrapApplyDeclarationEdits(
    var declarations: array<BootstrapDeclaration>,
    edits: array<BootstrapDeclarationEdit>,
    quiet: bool = false
): BootstrapEditOutcome {
    var errors = 0
    var diagnostics = ""
    var first = 0
    while (!quiet && first < edits.size) {
        val edit = edits[first]
        var other = first + 1
        while (edit.kind == "replaceBody" && other < edits.size) {
            val later = edits[other]
            if (later.kind == "replaceBody" && later.targetIdentity == edit.targetIdentity &&
                later.owner == edit.owner && later.name == edit.name &&
                later.signature == edit.signature && later.payload != edit.payload) {
                errors = errors + 1
                diagnostics = "${diagnostics}error[E_COMPILER_EDIT_CONFLICT]: `${bootstrapEditTargetText(edit)}` is given two different bodies, by ${edit.origin} and ${later.origin}\n"
            }
            other = other + 1
        }
        first = first + 1
    }
    for (edit in edits) {
        // `compiler.instantiate` from a `#` site: the generics pass makes the
        // instance this declaration asks for (bootstrapGenericRequestInstantiations).
        if (edit.kind == "instantiate") {
            val request = bootstrapInstantiationRequest(edit.targetIdentity, edit.payload)
            var present = false
            for (candidate in declarations) if (candidate.name == request.name) present = true
            if (!present) declarations.append(request)
            continue
        }
        val instance = bootstrapTextContains(edit.targetIdentity, "\u{1F}")
        var matches = 0
        var at = -1
        var declaration = 0
        while (!instance && declaration < declarations.size) {
            if (bootstrapEditTargets(edit, declarations[declaration])) {
                matches = matches + 1
                at = declaration
            }
            declaration = declaration + 1
        }
        if (matches != 1) {
            if (!quiet) {
                errors = errors + 1
                diagnostics = "${diagnostics}error[E_COMPILER_EDIT_TARGET]: ${edit.kind} by ${edit.origin}: `${bootstrapEditTargetText(edit)}` is ${if (instance) "an instance of a generic, which no edit may target" else if (matches == 0) "no declaration" else "$matches declarations"}\n"
            }
        } else if (edit.kind == "annotate") {
            val candidate = declarations[at]
            var present = false
            for (annotation in candidate.annotations) {
                if (annotation == edit.payload) present = true
            }
            if (!present) declarations[at] =
                bootstrapDeclarationWithAnnotation(candidate, edit.payload)
        } else if (edit.kind == "replaceBody") {
            // A transform's replacement in its own module is in its
            // declarations already.
            if (!(edit.originChain == "transform" &&
                  bootstrapEditOriginModule(edit) == edit.targetIdentity) &&
                !bootstrapApplyFunctionBodyReplacement(
                    declarations, BootstrapFunctionBodyReplacement(at, edit.payload, edit.origin)
                ) && !quiet) {
                errors = errors + 1
                diagnostics = "${diagnostics}error[E_COMPILER_TRANSFORM_BODY]: replacement body by ${edit.origin} did not parse as exactly one compatible top-level function body\n"
            }
        } else if (edit.kind == "removeField" && !quiet) {
            // (Not in a view: removing would shift the slots of the modules
            // still to be parsed.)
            val owner = edit.owner
            val defaultName = bootstrapExtensionFieldDefaultName(edit.name)
            val kept: array<BootstrapDeclaration> = []
            for (candidate in declarations) {
                val dropped = (bootstrapIsExtensionFieldKind(candidate.kind) &&
                    candidate.sourceIdentity == edit.targetIdentity &&
                    candidate.extensionOwner == owner && candidate.name == edit.name) ||
                    (candidate.kind == "fun" && candidate.sourceIdentity == edit.targetIdentity &&
                     candidate.extensionOwner == owner && candidate.name == defaultName)
                if (!dropped) kept.append(candidate)
            }
            declarations.truncate(0)
            for (candidate in kept) declarations.append(candidate)
        }
    }
    BootstrapEditOutcome(errors, diagnostics)
}


/** Drops the extension fields the transforms removed from this module, with
 *  their default functions. */
fun bootstrapRemoveExtensionFields(var declarations: array<BootstrapDeclaration>): void {
    val removals = bootstrapExtensionFieldRemovals
    bootstrapExtensionFieldRemovals = []
    if (removals.size == 0) return
    val kept: array<BootstrapDeclaration> = []
    for (declaration in declarations) {
        var removed = false
        for (removal in removals) {
            if (bootstrapIsExtensionFieldKind(declaration.kind) &&
                "${declaration.extensionOwner}.${declaration.name}" == removal) removed = true
            if (declaration.kind == "fun" && declaration.extensionOwner != "" &&
                "${declaration.extensionOwner}.${declaration.name}" ==
                    "${removal.slice(0, bootstrapExtensionRemovalDot(removal))}.${bootstrapExtensionFieldDefaultName(removal.slice(bootstrapExtensionRemovalDot(removal) + 1, removal.size))}") {
                removed = true
            }
        }
        if (!removed) kept.append(declaration)
    }
    declarations.truncate(0)
    for (declaration in kept) declarations.append(declaration)
    return
}

fun bootstrapExtensionRemovalDot(removal: string): int {
    var dot = removal.size - 1
    while (dot > 0 && removal[dot] != 46) dot = dot - 1
    dot
}

fun bootstrapApplyCompilerTransforms(
    var declarations: array<BootstrapDeclaration>,
    actions: array<BootstrapExpression>,
    allowedCompileEffects: int
): BootstrapEvalResult {
    // A failed earlier compilation must never leak staged requests into this
    // candidate transaction.
    bootstrapTakeFunctionBodyReplacements()
    bootstrapTakeFunctionAnnotationAdditions()
    bootstrapTakeGeneratedModules()
    bootstrapTakeTransformEdits()
    var errors = 0
    var diagnostics = ""
    val compileInputPaths: array<string> = []
    val compileInputContents: array<string> = []
    // The handlers' declarations do not change until the loop ends: one evaluation
    // context serves every transform.
    var evalContext = bootstrapEvalNoContext()
    var action = 0
    while (action < actions.size) {
        var expression = actions[action]
        if (expression.kind == "compile" && expression.children.size == 1) {
            expression = expression.children[0]
        }
        if (expression.kind == "member.call" &&
            expression.text == "transform" &&
            expression.children.size > 0 &&
            expression.children[0].kind == "identifier" &&
            expression.children[0].text == "compiler") {
            var valid = expression.children.size == 2 &&
                expression.children[1].kind == "identifier"
            var handler = ""
            if (valid) handler = expression.children[1].text
            var matches = 0
            var declaration = 0
            while (valid && declaration < declarations.size) {
                val candidate = declarations[declaration]
                if (candidate.name == handler &&
                    candidate.extensionOwner == "" &&
                    candidate.kind == "compile.fun" &&
                    candidate.parameters.size == 0) matches = matches + 1
                declaration = declaration + 1
            }
            if (matches != 1) valid = false
            if (valid) {
                evalContext = bootstrapEvalContextFor(evalContext, declarations)
                bootstrapCompilerTransformOrigin =
                    "${bootstrapCompilerTransformHandlerSource(declarations, handler)}:${expression.begin}:${expression.end}"
                val invoked = bootstrapInvokeCompilerTransformIn(
                    evalContext,
                    declarations,
                    handler,
                    expression.begin,
                    expression.end,
                    allowedCompileEffects
                )
                errors = errors + invoked.errors
                diagnostics = "$diagnostics${invoked.diagnostics}"
                bootstrapMergeCompileInputs(
                    compileInputPaths,
                    compileInputContents,
                    invoked.compileInputPaths,
                    invoked.compileInputContents
                )
            } else {
                errors = errors + 1
                diagnostics =
                    "${diagnostics}error[E_COMPILER_TRANSFORM_HANDLER]: compiler.transform requires one unique zero-argument compile function identifier\n"
            }
        }
        action = action + 1
    }
    val replacements = bootstrapTakeFunctionBodyReplacements()
    var replacement = 0
    while (replacement < replacements.size) {
        val handle = replacements[replacement].handle
        if (!bootstrapApplyFunctionBodyReplacement(
            declarations,
            replacements[replacement]
        )) {
            errors = errors + 1
            diagnostics =
                "${diagnostics}error[E_COMPILER_TRANSFORM_BODY]: replacement body did not parse as exactly one compatible top-level function body\n"
        } else {
            // Recorded for every target, the own module's too: the module graph
            // applies another module's, and finds two that disagree.
            val target = declarations[handle]
            bootstrapTransformEdits.append(BootstrapDeclarationEdit(
                "replaceBody",
                target.sourceIdentity,
                target.extensionOwner,
                target.name,
                bootstrapEditSignature(target),
                replacements[replacement].body,
                [],
                replacements[replacement].origin,
                "transform"
            ))
        }
        replacement = replacement + 1
    }
    val annotationAdditions = bootstrapTakeFunctionAnnotationAdditions()
    var annotationAddition = 0
    while (annotationAddition < annotationAdditions.size) {
        if (!bootstrapApplyFunctionAnnotationAddition(
            declarations,
            annotationAdditions[annotationAddition]
        )) {
            errors = errors + 1
            diagnostics =
                "${diagnostics}error[E_COMPILER_TRANSFORM_ANNOTATION]: annotation addition requires one compatible top-level runtime function and cannot duplicate an existing annotation\n"
        }
        annotationAddition = annotationAddition + 1
    }
    BootstrapEvalResult(
        bootstrapEvalVoid(),
        errors,
        diagnostics,
        compileInputPaths,
        compileInputContents,
        []
    )
}

fun bootstrapModuleNeedsGeneratedProcessing(
    actions: array<BootstrapExpression>,
    extensionRequests: array<BootstrapExtensionRequest>
): bool {
    var needed = extensionRequests.size > 0 || bootstrapArtifactSliceActive
    var action = 0
    while (!needed && action < actions.size) {
        var expression = actions[action]
        if (expression.kind == "compile" && expression.children.size == 1) {
            expression = expression.children[0]
        }
        needed = expression.kind == "call" &&
            expression.text == "compilerGenerateModule"
        if (!needed) needed = expression.kind == "member.call" &&
            expression.text == "transform" &&
            expression.children.size > 0 &&
            expression.children[0].kind == "identifier" &&
            expression.children[0].text == "compiler"
        action = action + 1
    }
    needed
}

// For each top-level declaration, the names it binds inside itself:
// declared with `val`/`var`/`own`, typed (`name: T`, a field or a
// parameter), a lambda's parameters (`{ a, b ->`), a `for` variable, or,
// in a class or an extension function of one, the class's members.
fun bootstrapDeclarationBoundNames(
    source: string,
    discovery: BootstrapParseResult
): array<array<string>> {
    val tokens = bootstrapLex(source)
    val result: array<array<string>> = []
    var declaration = 0
    while (declaration < discovery.declarations.size) {
        result.append([])
        declaration = declaration + 1
    }
    var index = 0
    var current = 0
    while (index < tokens.size) {
        while (current < discovery.declarations.size &&
            discovery.declarations[current].end <= tokens[index].begin) {
            current = current + 1
        }
        val inside = current < discovery.declarations.size &&
            discovery.declarations[current].begin <= tokens[index].begin
        if (inside && tokens[index].kind == "identifier") {
            val previous = if (index > 0) tokens[index - 1].kind else ""
            val next = if (index + 1 < tokens.size) tokens[index + 1].kind else ""
            val previousOwn = index > 0 && previous == "identifier" &&
                bootstrapTokenText(source, tokens[index - 1]) == "own"
            if (previous == "val" || previous == "var" || previousOwn ||
                next == ":" ||
                bootstrapLambdaParameterAt(tokens, index) ||
                (previous == "(" && next == "in")) {
                result[current].append(bootstrapTokenText(source, tokens[index]))
            }
        }
        index = index + 1
    }
    // A class's members (fields, methods, and its extension members here) are
    // what its body and its extension functions name without `this.`.
    val receivers: array<string> = []
    val members: array<array<string>> = []
    for (declaration in discovery.declarations) {
        val receiver = if (declaration.extensionOwner != "")
            bootstrapReceiverBaseName(declaration.extensionOwner)
            else if (declaration.kind == "class" || declaration.kind == "interface")
            declaration.name
            else ""
        if (receiver != "") {
            var group = 0
            while (group < receivers.size && receivers[group] != receiver) group = group + 1
            if (group == receivers.size) {
                receivers.append(receiver)
                members.append([])
            }
            if (declaration.extensionOwner != "") {
                if (declaration.name != "") members[group].append(declaration.name)
            } else {
                for (parameter in declaration.parameters) members[group].append(parameter)
                for (method in declaration.methods) members[group].append(method.name)
            }
        }
    }
    declaration = 0
    while (declaration < discovery.declarations.size) {
        val owner = discovery.declarations[declaration]
        val receiver = if (owner.extensionOwner != "")
            bootstrapReceiverBaseName(owner.extensionOwner)
            else if (owner.kind == "class" || owner.kind == "interface") owner.name
            else ""
        var group = 0
        while (group < receivers.size && receivers[group] != receiver) group = group + 1
        if (receiver != "" && group < receivers.size) {
            for (member in members[group]) result[declaration].append(member)
        }
        declaration = declaration + 1
    }
    result
}

// `Box<T>` as the receiver it names: `Box`.
fun bootstrapReceiverBaseName(owner: string): string {
    var end = 0
    while (end < owner.size && owner[end] != 60 && owner[end] != 63) end = end + 1
    owner.slice(0, end)
}

// Whether the identifier at `index` is a lambda's parameter: one of
// `{ a, b ->`. A `when` arm's matches look the same (`when (x) { A, B ->`,
// or one per line) and are values, not bindings.
fun bootstrapLambdaParameterAt(tokens: array<BootstrapToken>, index: int): bool {
    // Past the parameters after this one, to the `->`.
    var after = index + 1
    while (after + 1 < tokens.size && tokens[after].kind == "," &&
        tokens[after + 1].kind == "identifier") after = after + 2
    if (after >= tokens.size || tokens[after].kind != "->") return false
    // Back past the ones before it, to the `{`.
    var before = index - 1
    var listed = true
    while (listed) {
        while (before >= 0 && tokens[before].kind == "newline") before = before - 1
        if (before >= 1 && tokens[before].kind == "," &&
            tokens[before - 1].kind == "identifier") before = before - 2
        else listed = false
    }
    if (before < 0 || tokens[before].kind != "{") return false
    // `when (…) {` opens arms, not a lambda.
    if (before == 0 || tokens[before - 1].kind != ")") return true
    var depth = 0
    var open = before - 1
    while (open >= 0) {
        if (tokens[open].kind == ")") depth = depth + 1
        if (tokens[open].kind == "(") {
            depth = depth - 1
            if (depth == 0) {
                return !(open > 0 && tokens[open - 1].kind == "when")
            }
        }
        open = open - 1
    }
    true
}

// The top-level declaration spanning `offset`, or -1.
fun bootstrapDeclarationAt(discovery: BootstrapParseResult, offset: int): int {
    var result = -1
    var declaration = 0
    while (declaration < discovery.declarations.size) {
        if (discovery.declarations[declaration].begin <= offset &&
            offset < discovery.declarations[declaration].end) {
            result = declaration
        }
        declaration = declaration + 1
    }
    result
}

/** A generated module's source, as the module that requested it sees names:
 *  that module's names that carry its prefix (in `declarations`: private
 *  ones, and every one of a module imported under an alias) replace the plain
 *  ones, except where a local of the generated code binds the name. */
fun bootstrapGeneratedSourceWithPrivates(
    source: string,
    identity: string,
    declarations: array<BootstrapDeclaration>
): string {
    val names: array<string> = []
    val replacements: array<string> = []
    for (declaration in declarations) {
        if (declaration.extensionOwner == "") {
            val visible = bootstrapSourceVisibleType(declaration.name)
            if (visible != declaration.name && !bootstrapAffineNamesContain(names, visible)) {
                names.append(visible)
                replacements.append(declaration.name)
            }
        }
    }
    if (names.size == 0) return source
    val discovery = bootstrapParseWithIdentity(source, identity)
    val bounds = bootstrapDeclarationBoundNames(source, discovery)
    val tokens = bootstrapLex(source)
    var output = ""
    var cursor = 0
    var index = 0
    while (index < tokens.size) {
        val token = tokens[index]
        if ((token.kind == "identifier" || token.kind == "interpolation-identifier") &&
            (index == 0 || (tokens[index - 1].kind != "." && tokens[index - 1].kind != "fun"))) {
            val text = bootstrapTokenText(source, token)
            var replacement = -1
            var candidate = 0
            while (candidate < names.size && replacement < 0) {
                if (names[candidate] == text) replacement = candidate
                candidate = candidate + 1
            }
            val enclosing = if (replacement >= 0) bootstrapDeclarationAt(discovery, token.begin) else -1
            if (enclosing >= 0 && enclosing < bounds.size &&
                bootstrapAffineNamesContain(bounds[enclosing], text)) replacement = -1
            if (replacement >= 0) {
                output = "$output${source.slice(cursor, token.begin)}${replacements[replacement]}"
                cursor = token.end
            }
        }
        index = index + 1
    }
    "$output${source.slice(cursor, source.size)}"
}

fun bootstrapApplyGeneratedModules(
    parsed: BootstrapParseResult,
    handlerDeclarations: array<BootstrapDeclaration>,
    currentDeclarationBegin: int,
    currentDeclarationCount: int,
    extensionRequests: array<BootstrapExtensionRequest>,
    allowedCompileEffects: int
): BootstrapParseResult {
    // Nearly all modules in a source-owned firmware graph contain ordinary
    // declarations only. Avoid copying the complete program declaration set
    // and running transform machinery once per such module; that turns a
    // many-module monolith from quadratic frontend work into linear work.
    if (!bootstrapModuleNeedsGeneratedProcessing(
        parsed.actions, extensionRequests
    )) return parsed

    val declarations: array<BootstrapDeclaration> = []
    val actions: array<BootstrapExpression> = []
    val namespaces: array<string> = []
    val compileInputPaths: array<string> = []
    val compileInputContents: array<string> = []
    val typedRequestBegins: array<int> = []
    val typedRequestEnds: array<int> = []
    val typedRequestKinds: array<string> = []
    val typedDeclarations: array<BootstrapDeclaration> = []
    var typedDeclaration = 0
    while (extensionRequests.size > 0 &&
           typedDeclaration < handlerDeclarations.size) {
        val local = typedDeclaration - currentDeclarationBegin
        if (local >= 0 && local < currentDeclarationCount &&
            local < parsed.declarations.size) {
            typedDeclarations.append(parsed.declarations[local])
        } else typedDeclarations.append(
            handlerDeclarations[typedDeclaration]
        )
        typedDeclaration = typedDeclaration + 1
    }
    // Discovery handles cover only currentDeclarationCount. A raw outer
    // expansion can reveal additional source declarations, which must be
    // appended instead of replacing stable handler declaration slots.
    var extraTypedDeclaration = currentDeclarationCount
    while (extensionRequests.size > 0 &&
           extraTypedDeclaration < parsed.declarations.size) {
        typedDeclarations.append(parsed.declarations[extraTypedDeclaration])
        extraTypedDeclaration = extraTypedDeclaration + 1
    }
    val typedActions: array<BootstrapExpression> = []
    var typedAction = 0
    while (extensionRequests.size > 0 &&
           typedAction < parsed.actions.size) {
        typedActions.append(parsed.actions[typedAction])
        typedAction = typedAction + 1
    }
    var typedRequest = 0
    while (typedRequest < extensionRequests.size) {
        val requested = extensionRequests[typedRequest].expression
        typedRequestBegins.append(requested.begin)
        typedRequestEnds.append(requested.end)
        typedRequestKinds.append(requested.kind)
        // Recursive raw providers often return a synthesized runtime tree
        // which intentionally omits the original call. Keep the immutable
        // request node in the semantic-only action set so target selection,
        // bindings, conversions, and result handles remain available.
        typedActions.append(requested)
        typedRequest = typedRequest + 1
    }
    // Requests whose expressions are plain literals (a name, a payload string)
    // have no calls to type. Skip the analysis for them: it summarizes the
    // complete program (affine types, mutable receivers, region calls, compile
    // effects) and otherwise runs once per module that uses an extension.
    var literalRequests = true
    var literalRequest = 0
    while (literalRequest < extensionRequests.size) {
        val requested = extensionRequests[literalRequest].expression
        if (requested.children.size > 0 ||
            !(requested.kind == "string" || requested.kind == "integer" ||
              requested.kind == "true" || requested.kind == "false")) {
            literalRequests = false
        }
        literalRequest = literalRequest + 1
    }
    val noTypedCalls: array<BootstrapTypedCall> = []
    val typedCalls = if (literalRequests) noTypedCalls
    else bootstrapAnalyzeRequestedSpans(
        BootstrapParseResult(
            typedDeclarations,
            typedActions,
            parsed.errors,
            parsed.extensionErrors,
            parsed.compileInputPaths,
            parsed.compileInputContents,
            parsed.diagnostics
        ),
        typedRequestBegins,
        typedRequestEnds,
        typedRequestKinds
    ).typedCalls
    bootstrapMergeCompileInputs(
        compileInputPaths,
        compileInputContents,
        parsed.compileInputPaths,
        parsed.compileInputContents
    )
    var declaration = 0
    while (declaration < parsed.declarations.size) {
        declarations.append(parsed.declarations[declaration])
        declaration = declaration + 1
    }
    var errors = parsed.errors
    var diagnostics = parsed.diagnostics
    var action = 0
    while (action < parsed.actions.size) {
        val staged = parsed.actions[action]
        actions.append(staged)
        var expression = staged
        if (staged.kind == "compile" && staged.children.size == 1) {
            expression = staged.children[0]
        }
        if (expression.kind == "call" &&
            expression.text == "compilerGenerateModule") {
            var valid = expression.children.size == 2 &&
                expression.children[0].kind == "string" &&
                expression.children[1].kind == "string" &&
                expression.children[0].text != "" &&
                expression.children[1].text.size <= 65536 &&
                namespaces.size < 64
            var namespace = ""
            if (expression.children.size > 0) {
                namespace = expression.children[0].text
            }
            var namespaceIndex = 0
            while (namespaceIndex < namespaces.size) {
                if (namespaces[namespaceIndex] == namespace) valid = false
                namespaceIndex = namespaceIndex + 1
            }
            if (!valid) {
                errors = errors + 1
                diagnostics =
                    "${diagnostics}error[E_EXT_GENERATED_MODULE_REQUEST]: compilerGenerateModule requires a unique non-empty namespace and at most 65536 bytes of source\n"
                diagnostics =
                    "${diagnostics}source[generated-origin]:$namespace:${expression.begin}:${expression.end}\n"
            }
            if (valid) {
                namespaces.append(namespace)
                val generated = bootstrapParseWithIdentity(
                    bootstrapGeneratedSourceWithPrivates(
                        expression.children[1].text,
                        "<generated:$namespace>",
                        declarations
                    ),
                    "<generated:$namespace>"
                )
                bootstrapMergeCompileInputs(
                    compileInputPaths,
                    compileInputContents,
                    generated.compileInputPaths,
                    generated.compileInputContents
                )
                errors = errors + generated.errors
                diagnostics = "$diagnostics${generated.diagnostics}"
                var generatedDeclaration = 0
                while (generatedDeclaration < generated.declarations.size) {
                    declarations.append(
                        generated.declarations[generatedDeclaration]
                    )
                    generatedDeclaration = generatedDeclaration + 1
                }
                var generatedAction = 0
                while (generatedAction < generated.actions.size) {
                    actions.append(generated.actions[generatedAction])
                    generatedAction = generatedAction + 1
                }
            }
        }
        action = action + 1
    }
    var request = 0
    while (request < extensionRequests.size && namespaces.size < 64) {
        val extensionRequest = extensionRequests[request]
        val finalized = bootstrapInvokeExtensionFinalizer(
            // Finalizers reflect the semantically analyzed current module,
            // not the earlier discovery snapshot used to locate handlers.
            // The typed view contains current source declarations in their
            // stable slots and preserves imported handler declarations.
            typedDeclarations,
            extensionRequest,
            typedCalls,
            allowedCompileEffects
        )
        bootstrapMergeCompileInputs(
            compileInputPaths,
            compileInputContents,
            finalized.compileInputPaths,
            finalized.compileInputContents
        )
        errors = errors + finalized.errors
        if (finalized.diagnostics != "") {
            diagnostics =
                "$diagnostics${finalized.diagnostics}"
            diagnostics =
                "${diagnostics}context[generated-extension-finalizer]: `${extensionRequest.finalizer}`\n"
            diagnostics =
                "${diagnostics}source[extension-request]:${extensionRequest.namespace}:${extensionRequest.sourceIdentity}:${extensionRequest.expression.begin}:${extensionRequest.expression.end}\n"
        }
        if (finalized.errors > 0 && finalized.diagnostics == "") {
            diagnostics =
                "${diagnostics}error[E_GENERATED_EXTENSION_FINALIZER]: generated extension finalizer `${extensionRequest.finalizer}` failed with ${finalized.errors} evaluator error(s)\n"
            diagnostics =
                "${diagnostics}request[generated-extension]:round=1,index=$request,namespace=${extensionRequest.namespace}\n"
            diagnostics =
                "${diagnostics}source[extension-request]:${extensionRequest.sourceIdentity}:${extensionRequest.expression.begin}:${extensionRequest.expression.end}\n"
        }
        var namespaceAvailable = extensionRequest.namespace != ""
        var existingNamespace = 0
        while (existingNamespace < namespaces.size) {
            if (namespaces[existingNamespace] == extensionRequest.namespace) {
                namespaceAvailable = false
            }
            existingNamespace = existingNamespace + 1
        }
        if (!namespaceAvailable) {
            errors = errors + 1
            diagnostics =
                "$diagnostics${bootstrapGeneratedRequestDiagnostic(
                    "E_EXT_NAMESPACE_COLLISION",
                    "generated namespace `${extensionRequest.namespace}` is not unique in this module",
                    extensionRequest
                )}"
        }
        if (namespaceAvailable && finalized.errors == 0 &&
            extensionRequest.directAst &&
            finalized.value.kind == "generated.module" &&
            finalized.value.text == extensionRequest.namespace) {
            val generatedIndexes: array<int> = []
            var validGenerated = true
            var element = 0
            while (element < finalized.value.elements.size) {
                val generated = finalized.value.elements[element]
                if (generated.kind == "generated.declaration") {
                    if (generated.integer < 0 ||
                        generated.integer >=
                            finalized.generatedDeclarations.size) {
                        validGenerated = false
                    } else {
                        val declaration = finalized.generatedDeclarations[generated.integer]
                        if (declaration.generatedNamespace !=
                            extensionRequest.namespace) {
                            validGenerated = false
                        } else generatedIndexes.append(generated.integer)
                    }
                } else if (generated.kind != "generated.origin") {
                    validGenerated = false
                }
                element = element + 1
            }
            if (generatedIndexes.size > 256) validGenerated = false
            if (validGenerated) {
                namespaces.append(extensionRequest.namespace)
                var generatedIndex = 0
                while (generatedIndex < generatedIndexes.size) {
                    declarations.append(finalized.generatedDeclarations[generatedIndexes[generatedIndex]])
                    generatedIndex = generatedIndex + 1
                }
            } else {
                errors = errors + 1
                diagnostics =
                    "$diagnostics${bootstrapGeneratedRequestDiagnostic(
                        "E_EXT_GENERATED_PROVENANCE",
                        "generated module violates its request provenance invariant",
                        extensionRequest
                    )}"
            }
        } else if (namespaceAvailable && finalized.errors == 0 &&
            !extensionRequest.directAst &&
            finalized.value.kind == "string" &&
            finalized.value.text.size <= 65536) {
            namespaces.append(extensionRequest.namespace)
            val generated = bootstrapParseWithIdentity(
                finalized.value.text,
                "<generated:${extensionRequest.namespace}>"
            )
            bootstrapMergeCompileInputs(
                compileInputPaths,
                compileInputContents,
                generated.compileInputPaths,
                generated.compileInputContents
            )
            errors = errors + generated.errors
            diagnostics = "$diagnostics${generated.diagnostics}"
            if (generated.errors > 0) diagnostics =
                "${diagnostics}context[generated-extension]: generated compatibility module failed to parse in namespace `${extensionRequest.namespace}`\nsource[extension-request]:${extensionRequest.sourceIdentity}:${extensionRequest.expression.begin}:${extensionRequest.expression.end}\n"
            var generatedDeclaration = 0
            while (generatedDeclaration < generated.declarations.size) {
                declarations.append(
                    generated.declarations[generatedDeclaration]
                )
                generatedDeclaration = generatedDeclaration + 1
            }
            var generatedAction = 0
            while (generatedAction < generated.actions.size) {
                actions.append(generated.actions[generatedAction])
                generatedAction = generatedAction + 1
            }
        } else if (namespaceAvailable && finalized.errors == 0) {
            errors = errors + 1
            diagnostics =
                "$diagnostics${bootstrapGeneratedRequestDiagnostic(
                    "E_EXT_FINALIZER_RESULT",
                    "finalizer returned the wrong result kind or namespace",
                    extensionRequest
                )}"
        }
        request = request + 1
    }
    if (request < extensionRequests.size) {
        errors = errors + 1
        val extensionRequest = extensionRequests[request]
        diagnostics =
            "$diagnostics${bootstrapGeneratedRequestDiagnostic(
                "E_EXT_NAMESPACE_LIMIT",
                "generated module namespace limit exceeded",
                extensionRequest
            )}"
    }
    val transformDeclarations: array<BootstrapDeclaration> = []
    var transformDeclaration = 0
    while (transformDeclaration < handlerDeclarations.size) {
        val local = transformDeclaration - currentDeclarationBegin
        if (local >= 0 && local < currentDeclarationCount &&
            local < parsed.declarations.size) {
            transformDeclarations.append(declarations[local])
        } else transformDeclarations.append(
            handlerDeclarations[transformDeclaration]
        )
        transformDeclaration = transformDeclaration + 1
    }
    var extraTransformDeclaration = currentDeclarationCount
    while (extraTransformDeclaration < parsed.declarations.size) {
        transformDeclarations.append(
            declarations[extraTransformDeclaration]
        )
        extraTransformDeclaration = extraTransformDeclaration + 1
    }
    var generatedForTransform = parsed.declarations.size
    while (generatedForTransform < declarations.size) {
        transformDeclarations.append(declarations[generatedForTransform])
        generatedForTransform = generatedForTransform + 1
    }
    // A transform changes this module's own declarations, the ones copied
    // back below; a change to another module's would be dropped, so it is
    // refused when it is requested (bootstrapCompilerTransformTarget).
    val editable: array<bool> = []
    while (editable.size < transformDeclarations.size) editable.append(false)
    var editableLocal = 0
    while (editableLocal < parsed.declarations.size) {
        val candidate = if (editableLocal < currentDeclarationCount) {
            currentDeclarationBegin + editableLocal
        } else {
            handlerDeclarations.size + editableLocal - currentDeclarationCount
        }
        if (candidate >= 0 && candidate < editable.size) editable[candidate] = true
        editableLocal = editableLocal + 1
    }
    bootstrapCompilerTransformEditable = editable
    val transformed = bootstrapApplyCompilerTransforms(
        transformDeclarations,
        actions,
        allowedCompileEffects
    )
    bootstrapCompilerTransformEditable = []
    // Kept with this module's parse, so a reused parse still changes the
    // modules its transforms changed.
    val transformEdits = bootstrapTakeTransformEdits()
    errors = errors + transformed.errors
    diagnostics = "$diagnostics${transformed.diagnostics}"
    bootstrapMergeCompileInputs(
        compileInputPaths,
        compileInputContents,
        transformed.compileInputPaths,
        transformed.compileInputContents
    )
    var transformedLocal = 0
    while (transformedLocal < parsed.declarations.size) {
        val candidate = if (transformedLocal < currentDeclarationCount) {
            currentDeclarationBegin + transformedLocal
        } else {
            handlerDeclarations.size +
                transformedLocal - currentDeclarationCount
        }
        if (candidate >= 0 && candidate < transformDeclarations.size) {
            declarations[transformedLocal] =
                transformDeclarations[candidate]
        }
        transformedLocal = transformedLocal + 1
    }
    bootstrapRemoveExtensionFields(declarations)
    // Modules the transform handlers generated join the candidate as the
    // literal ones did.
    val transformModules = bootstrapTakeGeneratedModules()
    var transformModule = 0
    while (transformModule < transformModules.size) {
        val namespace = transformModules[transformModule].namespace
        var valid = namespaces.size < 64
        var namespaceIndex = 0
        while (namespaceIndex < namespaces.size) {
            if (namespaces[namespaceIndex] == namespace) valid = false
            namespaceIndex = namespaceIndex + 1
        }
        if (!valid) {
            errors = errors + 1
            diagnostics =
                "${diagnostics}error[E_EXT_GENERATED_MODULE_REQUEST]: compilerGenerateModule requires a unique non-empty namespace and at most 65536 bytes of source\n"
        } else {
            namespaces.append(namespace)
            val generated = bootstrapParseWithIdentity(
                bootstrapGeneratedSourceWithPrivates(
                    transformModules[transformModule].source,
                    "<generated:$namespace>",
                    declarations
                ),
                "<generated:$namespace>"
            )
            bootstrapMergeCompileInputs(
                compileInputPaths,
                compileInputContents,
                generated.compileInputPaths,
                generated.compileInputContents
            )
            errors = errors + generated.errors
            diagnostics = "$diagnostics${generated.diagnostics}"
            var generatedDeclaration = 0
            while (generatedDeclaration < generated.declarations.size) {
                declarations.append(
                    generated.declarations[generatedDeclaration]
                )
                generatedDeclaration = generatedDeclaration + 1
            }
            var generatedAction = 0
            while (generatedAction < generated.actions.size) {
                actions.append(generated.actions[generatedAction])
                generatedAction = generatedAction + 1
            }
        }
        transformModule = transformModule + 1
    }
    if (bootstrapArtifactSliceActive) {
        var sliceDeclaration = 0
        while (sliceDeclaration < declarations.size) {
            if (declarations[sliceDeclaration].kind == "fun" &&
                declarations[sliceDeclaration].name == "main" &&
                declarations[sliceDeclaration].extensionOwner == "" &&
                !bootstrapIndependentEntryIdentity(
                    declarations[sliceDeclaration].sourceIdentity
                )) {
                declarations[sliceDeclaration] = bootstrapDeclarationWithName(
                    declarations[sliceDeclaration],
                    "__abla_slice_excluded_main"
                )
            }
            sliceDeclaration = sliceDeclaration + 1
        }
    }
    BootstrapParseResult(
        declarations,
        actions,
        errors,
        parsed.extensionErrors + errors - parsed.errors,
        compileInputPaths,
        compileInputContents,
        diagnostics,
        transformEdits
    )
}

/** parserSiteKey's key for a `$name` at `offset`: the name of the method,
 *  function or global (of this module's, from `begin` for `count`) that
 *  holds it, with an ordinal when an earlier one has the same name, and its
 *  offset within it, in the file; the offset in the file when none holds it.
 *  An edit outside that declaration (a line or an import above it) leaves
 *  the key alone, where a position would move. */
fun bootstrapSubparserSiteKey(
    declarations: array<BootstrapDeclaration>,
    begin: int,
    count: int,
    source: string,
    offset: int
): string {
    val rewrite = bootstrapSourceRewriteOf(source)
    val names: array<string> = []
    var index = begin
    while (index < begin + count && index < declarations.size) {
        val declaration = declarations[index]
        var holder = ""
        var holderBegin = 0
        for (method in declaration.methods) {
            if (holder == "" && method.begin <= offset && offset < method.end) {
                holder = bootstrapLambdaMethodOwnerName(declaration, method)
                holderBegin = method.begin
            }
        }
        if (holder == "" && declaration.begin <= offset && offset < declaration.end) {
            holder = bootstrapLambdaOwnerName(declaration)
            holderBegin = declaration.begin
        }
        val name = bootstrapLambdaOwnerName(declaration)
        if (holder != "") {
            var ordinal = 0
            for (earlier in names) {
                if (earlier == name) ordinal = ordinal + 1
            }
            var key = ""
            var at = 0
            while (at < holder.size) {
                val byte = holder[at]
                val plain = (byte >= 48 && byte <= 57) || (byte >= 65 && byte <= 90) ||
                    (byte >= 97 && byte <= 122) || byte == 95
                key = "$key${if (plain) holder.slice(at, at + 1) else "_"}"
                at = at + 1
            }
            if (ordinal > 0) key = "${key}_$ordinal"
            return "${key}_${rewrite.original(offset) - rewrite.original(holderBegin)}"
        }
        names.append(name)
        index = index + 1
    }
    "${rewrite.original(offset)}"
}

fun bootstrapParseStagedRegistered(
    source: string,
    sourceIdentity: string,
    handlerDeclarations: array<BootstrapDeclaration>,
    currentDeclarationBegin: int,
    currentDeclarationCount: int,
    registry: BootstrapSubparserRegistry,
    allowedCompileEffects: int
): BootstrapParseResult {
    val tokens = bootstrapLex(source)
    val expansionBegins: array<int> = []
    val expansionEnds: array<int> = []
    val expansionExpressions: array<BootstrapExpression> = []
    val extensionRequests: array<BootstrapExtensionRequest> = []
    val compileInputPaths: array<string> = []
    val compileInputContents: array<string> = []
    var diagnostics = ""
    var extensionErrors = 0
    // One evaluation context for every subparser invocation over these declarations.
    var evalContext = bootstrapEvalNoContext()
    // The names this module's subparsers mean (bootstrapSubparserVisibleName).
    val outerVisibleNames = bootstrapSubparserVisibleNames
    val outerVisibleReplacements = bootstrapSubparserVisibleReplacements
    val visibleNames: array<string> = []
    val visibleReplacements: array<string> = []
    var visibleDeclaration = currentDeclarationBegin
    while (visibleDeclaration < currentDeclarationBegin + currentDeclarationCount &&
        visibleDeclaration < handlerDeclarations.size) {
        val declaration = handlerDeclarations[visibleDeclaration]
        val visible = bootstrapSourceVisibleType(declaration.name)
        if (declaration.extensionOwner == "" && visible != declaration.name &&
            !bootstrapAffineNamesContain(visibleNames, visible)) {
            visibleNames.append(visible)
            visibleReplacements.append(declaration.name)
        }
        visibleDeclaration = visibleDeclaration + 1
    }

    var tokenIndex = tokens.size - 2
    while (tokenIndex >= 0) {
        if (tokens[tokenIndex].kind == "$" &&
            tokenIndex + 1 < tokens.size &&
            tokens[tokenIndex + 1].kind == "identifier") {
            val name = bootstrapTokenText(source, tokens[tokenIndex + 1])
            val registrationIndex = bootstrapRegistrationIndex(
                registry,
                name,
                tokens[tokenIndex].begin
            )
            if (registrationIndex >= 0) {
                var literalRawMarker = false
                if (tokens[tokenIndex].begin > 0 &&
                    tokens[tokenIndex + 1].end < source.size) {
                    literalRawMarker =
                        source[tokens[tokenIndex].begin - 1] == 62 &&
                        source[tokens[tokenIndex + 1].end] == 60
                }
                if (!literalRawMarker) {
                val position = tokenIndex + 2
                var rawPosition = source.size
                if (position < tokens.size) {
                    rawPosition = tokens[position].begin
                }
                val cursor = BootstrapSubparserCursor(
                    sourceIdentity,
                    source,
                    tokens,
                    expansionBegins,
                    expansionEnds,
                    expansionExpressions,
                    position,
                    rawPosition,
                    0,
                    bootstrapSubparserSiteKey(
                        handlerDeclarations, currentDeclarationBegin,
                        currentDeclarationCount, sourceIdentity,
                        tokens[tokenIndex].begin
                    )
                )
                evalContext = bootstrapEvalContextFor(evalContext, handlerDeclarations)
                bootstrapSubparserVisibleNames = visibleNames
                bootstrapSubparserVisibleReplacements = visibleReplacements
                val invocation = bootstrapInvokeSubparserHandlerIn(
                    evalContext,
                    handlerDeclarations,
                    registry.registrations[registrationIndex].handler,
                    cursor,
                    allowedCompileEffects
                )
                bootstrapSubparserVisibleNames = outerVisibleNames
                bootstrapSubparserVisibleReplacements = outerVisibleReplacements
                extensionErrors = extensionErrors + invocation.errors
                if (invocation.diagnostics != "") {
                    diagnostics = "$diagnostics${invocation.diagnostics}"
                    diagnostics =
                        "${diagnostics}context[subparser]: `${registry.registrations[registrationIndex].handler}`\n"
                    diagnostics =
                        "${diagnostics}source[extension-expression]:$sourceIdentity:${tokens[tokenIndex].begin}:${cursor.rawPosition}\n"
                } else if (invocation.errors > 0) {
                    diagnostics =
                        "${diagnostics}error[E_SUBPARSER_INVOCATION]: subparser `${registry.registrations[registrationIndex].handler}` failed with ${invocation.errors} evaluator/parser error(s)\n"
                    diagnostics =
                        "${diagnostics}source[extension-expression]:$sourceIdentity:${tokens[tokenIndex].begin}:${cursor.rawPosition}\n"
                }
                if (invocation.errors > 0) {
                    // A failed subparser has reported why; its text is skipped
                    // whole, as an unexpanded `$name` would be, so the parse
                    // goes on after it instead of inside it.
                    // What it built so far stands in for it, as before.
                    val skipped = bootstrapSubparserTextEnd(tokens, position, source.size)
                    expansionBegins.append(tokens[tokenIndex].begin)
                    expansionEnds.append(if (skipped > cursor.rawPosition) skipped else cursor.rawPosition)
                    expansionExpressions.append(
                        if (invocation.expression.kind != "invalid") invocation.expression
                        else BootstrapExpression(
                            "invalid", "subparser", tokens[tokenIndex].begin, skipped, []
                        )
                    )
                } else if (invocation.expression.kind != "invalid" &&
                    cursor.rawPosition > rawPosition) {
                    expansionBegins.append(tokens[tokenIndex].begin)
                    expansionEnds.append(cursor.rawPosition)
                    expansionExpressions.append(invocation.expression)
                }
                var request = 0
                while (request < invocation.extensionRequests.size) {
                    val extensionRequest = invocation.extensionRequests[request]
                    if (extensionRequest.diagnostic == "") {
                        extensionRequests.append(extensionRequest)
                    } else diagnostics =
                        "$diagnostics${extensionRequest.diagnostic}"
                    request = request + 1
                }
                bootstrapMergeCompileInputs(
                    compileInputPaths,
                    compileInputContents,
                    invocation.compileInputPaths,
                    invocation.compileInputContents
                )
                }
            }
        }
        tokenIndex = tokenIndex - 1
    }

    val parsed = BootstrapParser(
        sourceIdentity,
        source,
        tokens,
        expansionBegins,
        expansionEnds,
        expansionExpressions,
        0,
        0,
        "",
        [],
        [],
        0
    ).parse()
    bootstrapApplyGeneratedModules(
        BootstrapParseResult(
            parsed.declarations,
            parsed.actions,
            parsed.errors + extensionErrors,
            extensionErrors,
            compileInputPaths,
            compileInputContents,
            "${parsed.diagnostics}$diagnostics"
        ),
        handlerDeclarations,
        currentDeclarationBegin,
        currentDeclarationCount,
        extensionRequests,
        allowedCompileEffects
    )
}

fun bootstrapParseStaged(source: string): BootstrapParseResult {
    val discovery = bootstrapParse(source)
    val registry = bootstrapBuildSubparserRegistry(discovery)
    val parsed = bootstrapParseStagedRegistered(
        source,
        "<memory>",
        discovery.declarations,
        0,
        discovery.declarations.size,
        registry,
        0
    )
    BootstrapParseResult(
        parsed.declarations,
        parsed.actions,
        parsed.errors + registry.errors,
        parsed.extensionErrors + registry.errors,
        parsed.compileInputPaths,
        parsed.compileInputContents,
        "${parsed.diagnostics}${registry.diagnostics}"
    )
}

// The decimal at `text[begin until end]` when it is one (only digits), else -1.
fun bootstrapSourceRewriteDecimal(text: string, begin: int, end: int): int {
    if (end <= begin) return -1
    var value = 0
    var index = begin
    while (index < end) {
        val byte = text[index]
        if (byte < 48 || byte > 57) return -1
        value = value * 10 + byte - 48
        index = index + 1
    }
    value
}

// `line` with each `@<offset>` mapped through `rewrite`.
fun bootstrapSourceRewriteAtOffsets(
    line: string,
    rewrite: BootstrapSourceRewrite
): string {
    var output = ""
    var cursor = 0
    var index = 0
    while (index < line.size) {
        if (line[index] == 64) {
            var end = index + 1
            while (end < line.size && line[end] >= 48 && line[end] <= 57) {
                end = end + 1
            }
            val offset = bootstrapSourceRewriteDecimal(line, index + 1, end)
            if (offset >= 0) {
                output = "$output${line.slice(cursor, index + 1)}${rewrite.original(offset)}"
                cursor = end
            }
            index = end
        } else index = index + 1
    }
    "$output${line.slice(cursor, line.size)}"
}

// Diagnostics place an error with a `source[kind]:path:begin:end` line after it
// (and `@offset`s in its text). Those the parse, semantic analysis and
// extensions report are offsets into the source the module was parsed from:
// for a module whose names were rewritten, they are mapped back to its file
// here. Other diagnostics are returned unchanged.
fun bootstrapSourceRewriteDiagnostics(diagnostics: string): string {
    if (bootstrapSourceRewrites.size == 0) return diagnostics
    val pending: array<string> = []
    var output = ""
    var lineBegin = 0
    while (lineBegin < diagnostics.size) {
        var lineEnd = lineBegin
        while (lineEnd < diagnostics.size && diagnostics[lineEnd] != 10) {
            lineEnd = lineEnd + 1
        }
        val line = diagnostics.slice(lineBegin, lineEnd)
        val newline = if (lineEnd < diagnostics.size) "\n" else ""
        var mapped = line
        var rewritten = false
        if (line.size > 7 && line.slice(0, 7) == "source[") {
            // The path runs from after `]:` to the second colon from the end.
            var close = 7
            while (close < line.size && line[close] != 93) close = close + 1
            var last = line.size - 1
            while (last > close && line[last] != 58) last = last - 1
            var middle = last - 1
            while (middle > close && line[middle] != 58) middle = middle - 1
            val begin = bootstrapSourceRewriteDecimal(line, middle + 1, last)
            val end = bootstrapSourceRewriteDecimal(line, last + 1, line.size)
            // Positions the parse took (parser, semantic, extension,
            // compile-time evaluation and ownership diagnostics); import
            // diagnostics already name the file's own.
            val kind = line.slice(7, close)
            val parsed = kind == "semantic" || kind == "parser" ||
                kind == "extension-expression" ||
                kind == "extension-request" || kind == "subparser" ||
                kind == "eval" || kind == "ownership"
            if (parsed && close + 2 < middle && begin >= 0 && end >= 0) {
                val rewrite = bootstrapSourceRewriteOf(line.slice(close + 2, middle))
                if (rewrite.rewrittenBegins.size > 0) {
                    mapped = "${line.slice(0, middle + 1)}${rewrite.original(begin)}:${rewrite.originalEnd(end)}"
                    rewritten = true
                    for (text in pending) {
                        output = "$output${bootstrapSourceRewriteAtOffsets(text, rewrite)}\n"
                    }
                }
            }
            if (!rewritten) {
                for (text in pending) output = "$output$text\n"
            }
            pending.clear()
            output = "$output$mapped$newline"
        } else if (newline == "") {
            for (text in pending) output = "$output$text\n"
            pending.clear()
            output = "$output$line"
        } else pending.append(line)
        lineBegin = lineEnd + 1
    }
    for (text in pending) output = "$output$text\n"
    output
}

/** Where a subparser's text starting at token `position` ends, as the parser
 *  skips an unexpanded `$name` (parseDeferredSubparserPlaceholder): balanced
 *  brackets whole, up to a newline, `;`, `,` or a closing bracket. */
fun bootstrapSubparserTextEnd(tokens: array<BootstrapToken>, position: int, sourceSize: int): int {
    var index = position
    var depth = 0
    while (index < tokens.size && tokens[index].kind != "end") {
        val kind = tokens[index].kind
        if (kind == "(" || kind == "[" || kind == "{") depth = depth + 1
        else if (kind == ")" || kind == "]" || kind == "}") {
            if (depth == 0) return tokens[index].begin
            depth = depth - 1
        } else if (depth == 0 && (kind == "newline" || kind == ";" || kind == ",")) {
            return tokens[index].begin
        }
        index = index + 1
    }
    if (index < tokens.size) tokens[index].begin else sourceSize
}
