import "eval.ab"

fun bootstrapMergeCompileInputs(
    var paths: array<string>,
    var contents: array<string>,
    incomingPaths: array<string>,
    incomingContents: array<string>
): void {
    var input = 0
    while (input < incomingPaths.size) {
        val path = incomingPaths[input]
        var found = -1
        var existing = 0
        while (existing < paths.size) {
            if (paths[existing] == path) found = existing
            existing = existing + 1
        }
        if (found >= 0) {
            contents[found] = incomingContents[input]
        } else {
            paths.append(path)
            contents.append(incomingContents[input])
        }
        input = input + 1
    }
}

fun bootstrapGeneratedRequestDiagnostic(
    code: string,
    message: string,
    request: BootstrapExtensionRequest
): string =
    "error[$code]: $message\ncontext[generated-namespace]: ${request.namespace}\nsource[extension-request]:${request.sourceIdentity}:${request.expression.begin}:${request.expression.end}\n"

fun bootstrapRegistrationIndex(
    registry: BootstrapSubparserRegistry,
    name: string,
    position: int
): int {
    var result = -1
    var index = 0
    while (index < registry.registrations.size) {
        val registration = registry.registrations[index]
        if (registration.name == name &&
            registration.availableFrom <= position) result = index
        index = index + 1
    }
    result
}

fun bootstrapReplacementFunctionSource(
    declaration: BootstrapDeclaration,
    body: string
): string {
    var source = "fun __abla_replacement("
    var parameter = 0
    while (parameter < declaration.parameters.size) {
        if (parameter > 0) source = "$source, "
        if (parameter < declaration.parameterKinds.size &&
            declaration.parameterKinds[parameter] == "own") {
            source = "${source}own "
        }
        if (parameter < declaration.parameterKinds.size &&
            declaration.parameterKinds[parameter] == "var") {
            source = "${source}var "
        }
        source = "$source${declaration.parameters[parameter]}: "
        source = "$source${declaration.parameterTypes[parameter]}"
        parameter = parameter + 1
    }
    source = "$source)"
    if (declaration.resultType != "inferred") {
        source = "$source: ${declaration.resultType}"
    }
    if (body.size > 0 && body[0] == 123) {
        source = "$source $body"
    } else source = "$source = $body"
    source
}

fun bootstrapDeclarationWithExpression(
    declaration: BootstrapDeclaration,
    expression: BootstrapExpression
): BootstrapDeclaration = BootstrapDeclaration(
    declaration.kind,
    declaration.name,
    declaration.begin,
    declaration.end,
    expression,
    declaration.parameters,
    declaration.parameterTypes,
    declaration.resultType,
    declaration.methods,
    declaration.parameterDefaults,
    declaration.externalLibrary,
    declaration.parameterKinds,
    declaration.extensionOwner,
    declaration.isTrusted,
    declaration.isResource,
    declaration.isNoEscape,
    declaration.generatedNamespace,
    declaration.generatedOriginBegin,
    declaration.generatedOriginEnd,
    declaration.annotations,
    declaration.annotationArguments,
    declaration.annotationBegins,
    declaration.annotationEnds,
    declaration.sourceIdentity
)

fun bootstrapDeclarationWithName(
    declaration: BootstrapDeclaration,
    name: string
): BootstrapDeclaration = BootstrapDeclaration(
    declaration.kind,
    name,
    declaration.begin,
    declaration.end,
    declaration.expression,
    declaration.parameters,
    declaration.parameterTypes,
    declaration.resultType,
    declaration.methods,
    declaration.parameterDefaults,
    declaration.externalLibrary,
    declaration.parameterKinds,
    declaration.extensionOwner,
    declaration.isTrusted,
    declaration.isResource,
    declaration.isNoEscape,
    declaration.generatedNamespace,
    declaration.generatedOriginBegin,
    declaration.generatedOriginEnd,
    declaration.annotations,
    declaration.annotationArguments,
    declaration.annotationBegins,
    declaration.annotationEnds,
    declaration.sourceIdentity
)

fun bootstrapIndependentEntryIdentity(identity: string): bool {
    val suffix = ".abla-independent.ab"
    identity.size >= suffix.size &&
        identity.slice(identity.size - suffix.size, identity.size) == suffix
}

fun bootstrapDeclarationWithAnnotation(
    declaration: BootstrapDeclaration,
    annotation: string
): BootstrapDeclaration {
    val annotations: array<string> = []
    val arguments: array<BootstrapExpression> = []
    val begins: array<int> = []
    val ends: array<int> = []
    var index = 0
    while (index < declaration.annotations.size) {
        annotations.append(declaration.annotations[index])
        arguments.append(declaration.annotationArguments[index])
        begins.append(declaration.annotationBegins[index])
        ends.append(declaration.annotationEnds[index])
        index = index + 1
    }
    annotations.append(annotation)
    arguments.append(BootstrapExpression(
        "missing", "", declaration.begin, declaration.begin, []
    ))
    begins.append(declaration.begin)
    ends.append(declaration.begin)
    BootstrapDeclaration(
        declaration.kind,
        declaration.name,
        declaration.begin,
        declaration.end,
        declaration.expression,
        declaration.parameters,
        declaration.parameterTypes,
        declaration.resultType,
        declaration.methods,
        declaration.parameterDefaults,
        declaration.externalLibrary,
        declaration.parameterKinds,
        declaration.extensionOwner,
        declaration.isTrusted,
        declaration.isResource,
        declaration.isNoEscape,
        declaration.generatedNamespace,
        declaration.generatedOriginBegin,
        declaration.generatedOriginEnd,
        annotations,
        arguments,
        begins,
        ends,
        declaration.sourceIdentity
    )
}

fun bootstrapApplyFunctionBodyReplacement(
    var declarations: array<BootstrapDeclaration>,
    replacement: BootstrapFunctionBodyReplacement
): bool {
    var valid = replacement.handle >= 0 &&
        replacement.handle < declarations.size
    if (valid) {
        val declaration = declarations[replacement.handle]
        valid = declaration.kind == "fun" &&
            declaration.extensionOwner == "" &&
            declaration.parameterDefaults.size == declaration.parameters.size
        val parsed = bootstrapParse(bootstrapReplacementFunctionSource(
            declaration,
            replacement.body
        ))
        valid = valid && parsed.errors == 0 &&
            parsed.declarations.size == 1 && parsed.actions.size == 0 &&
            parsed.declarations[0].kind == "fun" &&
            parsed.declarations[0].expression.kind != "missing"
        if (valid) declarations[replacement.handle] =
            bootstrapDeclarationWithExpression(
                declaration,
                parsed.declarations[0].expression
            )
    }
    valid
}

fun bootstrapApplyFunctionAnnotationAddition(
    var declarations: array<BootstrapDeclaration>,
    addition: BootstrapFunctionAnnotationAddition
): bool {
    var valid = addition.handle >= 0 &&
        addition.handle < declarations.size
    if (valid) {
        val declaration = declarations[addition.handle]
        valid = declaration.kind == "fun" &&
            declaration.extensionOwner == ""
        var annotation = 0
        while (valid && annotation < declaration.annotations.size) {
            if (declaration.annotations[annotation] == addition.annotation) {
                valid = false
            }
            annotation = annotation + 1
        }
        if (valid) {
            bootstrapPendingFunctionAnnotationKeys.append(
                "${declaration.sourceIdentity}:${declaration.extensionOwner}:${declaration.name}"
            )
            bootstrapPendingFunctionAnnotationNames.append(addition.annotation)
            declarations[addition.handle] = bootstrapDeclarationWithAnnotation(
                declaration, addition.annotation
            )
        }
    }
    valid
}

fun bootstrapResetPendingFunctionAnnotations(): void {
    bootstrapPendingFunctionAnnotationKeys = []
    bootstrapPendingFunctionAnnotationNames = []
    return
}

fun bootstrapApplyPendingFunctionAnnotations(
    var declarations: array<BootstrapDeclaration>
): int {
    var errors = 0
    var pending = 0
    while (pending < bootstrapPendingFunctionAnnotationKeys.size) {
        var matches = 0
        var declaration = 0
        while (declaration < declarations.size) {
            val candidate = declarations[declaration]
            val key =
                "${candidate.sourceIdentity}:${candidate.extensionOwner}:${candidate.name}"
            if (key == bootstrapPendingFunctionAnnotationKeys[pending]) {
                matches = matches + 1
                var present = false
                var annotation = 0
                while (annotation < candidate.annotations.size) {
                    if (candidate.annotations[annotation] ==
                        bootstrapPendingFunctionAnnotationNames[pending]) {
                        present = true
                    }
                    annotation = annotation + 1
                }
                if (!present) declarations[declaration] =
                    bootstrapDeclarationWithAnnotation(
                        candidate,
                        bootstrapPendingFunctionAnnotationNames[pending]
                    )
            }
            declaration = declaration + 1
        }
        if (matches != 1) errors = errors + 1
        pending = pending + 1
    }
    bootstrapResetPendingFunctionAnnotations()
    errors
}

fun bootstrapApplyCompilerTransforms(
    var declarations: array<BootstrapDeclaration>,
    actions: array<BootstrapExpression>,
    allowedCompileEffects: int
): BootstrapEvalResult {
    // A failed earlier compilation must never leak staged requests into this
    // candidate transaction.
    bootstrapTakeFunctionBodyReplacements()
    bootstrapTakeFunctionAnnotationAdditions()
    var errors = 0
    var diagnostics = ""
    val compileInputPaths: array<string> = []
    val compileInputContents: array<string> = []
    var action = 0
    while (action < actions.size) {
        var expression = actions[action]
        if (expression.kind == "compile" && expression.children.size == 1) {
            expression = expression.children[0]
        }
        if (expression.kind == "member.call" &&
            expression.text == "transform" &&
            expression.children.size > 0 &&
            expression.children[0].kind == "identifier" &&
            expression.children[0].text == "compiler") {
            var valid = expression.children.size == 2 &&
                expression.children[1].kind == "identifier"
            var handler = ""
            if (valid) handler = expression.children[1].text
            var matches = 0
            var declaration = 0
            while (valid && declaration < declarations.size) {
                val candidate = declarations[declaration]
                if (candidate.name == handler &&
                    candidate.extensionOwner == "" &&
                    candidate.kind == "compile.fun" &&
                    candidate.parameters.size == 0) matches = matches + 1
                declaration = declaration + 1
            }
            if (matches != 1) valid = false
            if (valid) {
                val invoked = bootstrapInvokeCompilerTransform(
                    declarations,
                    handler,
                    expression.begin,
                    expression.end,
                    allowedCompileEffects
                )
                errors = errors + invoked.errors
                diagnostics = "$diagnostics${invoked.diagnostics}"
                bootstrapMergeCompileInputs(
                    compileInputPaths,
                    compileInputContents,
                    invoked.compileInputPaths,
                    invoked.compileInputContents
                )
            } else {
                errors = errors + 1
                diagnostics =
                    "${diagnostics}error[E_COMPILER_TRANSFORM_HANDLER]: compiler.transform requires one unique zero-argument compile function identifier\n"
            }
        }
        action = action + 1
    }
    val replacements = bootstrapTakeFunctionBodyReplacements()
    var replacement = 0
    while (replacement < replacements.size) {
        if (!bootstrapApplyFunctionBodyReplacement(
            declarations,
            replacements[replacement]
        )) {
            errors = errors + 1
            diagnostics =
                "${diagnostics}error[E_COMPILER_TRANSFORM_BODY]: replacement body did not parse as exactly one compatible top-level function body\n"
        }
        replacement = replacement + 1
    }
    val annotationAdditions = bootstrapTakeFunctionAnnotationAdditions()
    var annotationAddition = 0
    while (annotationAddition < annotationAdditions.size) {
        if (!bootstrapApplyFunctionAnnotationAddition(
            declarations,
            annotationAdditions[annotationAddition]
        )) {
            errors = errors + 1
            diagnostics =
                "${diagnostics}error[E_COMPILER_TRANSFORM_ANNOTATION]: annotation addition requires one compatible top-level runtime function and cannot duplicate an existing annotation\n"
        }
        annotationAddition = annotationAddition + 1
    }
    BootstrapEvalResult(
        bootstrapEvalVoid(),
        errors,
        diagnostics,
        compileInputPaths,
        compileInputContents,
        []
    )
}

fun bootstrapModuleNeedsGeneratedProcessing(
    actions: array<BootstrapExpression>,
    extensionRequests: array<BootstrapExtensionRequest>
): bool {
    var needed = extensionRequests.size > 0 || bootstrapArtifactSliceActive
    var action = 0
    while (!needed && action < actions.size) {
        var expression = actions[action]
        if (expression.kind == "compile" && expression.children.size == 1) {
            expression = expression.children[0]
        }
        needed = expression.kind == "call" &&
            expression.text == "compilerGenerateModule"
        if (!needed) needed = expression.kind == "member.call" &&
            expression.text == "transform" &&
            expression.children.size > 0 &&
            expression.children[0].kind == "identifier" &&
            expression.children[0].text == "compiler"
        action = action + 1
    }
    needed
}

fun bootstrapApplyGeneratedModules(
    parsed: BootstrapParseResult,
    handlerDeclarations: array<BootstrapDeclaration>,
    currentDeclarationBegin: int,
    currentDeclarationCount: int,
    extensionRequests: array<BootstrapExtensionRequest>,
    allowedCompileEffects: int
): BootstrapParseResult {
    // Nearly all modules in a source-owned firmware graph contain ordinary
    // declarations only. Avoid copying the complete program declaration set
    // and running transform machinery once per such module; that turns a
    // many-module monolith from quadratic frontend work into linear work.
    if (!bootstrapModuleNeedsGeneratedProcessing(
        parsed.actions, extensionRequests
    )) return parsed

    val declarations: array<BootstrapDeclaration> = []
    val actions: array<BootstrapExpression> = []
    val namespaces: array<string> = []
    val compileInputPaths: array<string> = []
    val compileInputContents: array<string> = []
    val typedRequestBegins: array<int> = []
    val typedRequestEnds: array<int> = []
    val typedRequestKinds: array<string> = []
    val typedDeclarations: array<BootstrapDeclaration> = []
    var typedDeclaration = 0
    while (extensionRequests.size > 0 &&
           typedDeclaration < handlerDeclarations.size) {
        val local = typedDeclaration - currentDeclarationBegin
        if (local >= 0 && local < currentDeclarationCount &&
            local < parsed.declarations.size) {
            typedDeclarations.append(parsed.declarations[local])
        } else typedDeclarations.append(
            handlerDeclarations[typedDeclaration]
        )
        typedDeclaration = typedDeclaration + 1
    }
    // Discovery handles cover only currentDeclarationCount. A raw outer
    // expansion can reveal additional source declarations, which must be
    // appended instead of replacing stable handler declaration slots.
    var extraTypedDeclaration = currentDeclarationCount
    while (extensionRequests.size > 0 &&
           extraTypedDeclaration < parsed.declarations.size) {
        typedDeclarations.append(parsed.declarations[extraTypedDeclaration])
        extraTypedDeclaration = extraTypedDeclaration + 1
    }
    val typedActions: array<BootstrapExpression> = []
    var typedAction = 0
    while (extensionRequests.size > 0 &&
           typedAction < parsed.actions.size) {
        typedActions.append(parsed.actions[typedAction])
        typedAction = typedAction + 1
    }
    var typedRequest = 0
    while (typedRequest < extensionRequests.size) {
        val requested = extensionRequests[typedRequest].expression
        typedRequestBegins.append(requested.begin)
        typedRequestEnds.append(requested.end)
        typedRequestKinds.append(requested.kind)
        // Recursive raw providers often return a synthesized runtime tree
        // which intentionally omits the original call. Keep the immutable
        // request node in the semantic-only action set so target selection,
        // bindings, conversions, and result handles remain available.
        typedActions.append(requested)
        typedRequest = typedRequest + 1
    }
    // Requests whose expressions are plain literals (a name, a payload string)
    // have no calls to type. Skip the analysis for them: it summarizes the
    // complete program (affine types, mutable receivers, region calls, compile
    // effects) and otherwise runs once per module that uses an extension.
    var literalRequests = true
    var literalRequest = 0
    while (literalRequest < extensionRequests.size) {
        val requested = extensionRequests[literalRequest].expression
        if (requested.children.size > 0 ||
            !(requested.kind == "string" || requested.kind == "integer" ||
              requested.kind == "true" || requested.kind == "false")) {
            literalRequests = false
        }
        literalRequest = literalRequest + 1
    }
    val noTypedCalls: array<BootstrapTypedCall> = []
    val typedCalls = if (literalRequests) noTypedCalls
    else bootstrapAnalyzeRequestedSpans(
        BootstrapParseResult(
            typedDeclarations,
            typedActions,
            parsed.errors,
            parsed.extensionErrors,
            parsed.compileInputPaths,
            parsed.compileInputContents,
            parsed.diagnostics
        ),
        typedRequestBegins,
        typedRequestEnds,
        typedRequestKinds
    ).typedCalls
    bootstrapMergeCompileInputs(
        compileInputPaths,
        compileInputContents,
        parsed.compileInputPaths,
        parsed.compileInputContents
    )
    var declaration = 0
    while (declaration < parsed.declarations.size) {
        declarations.append(parsed.declarations[declaration])
        declaration = declaration + 1
    }
    var errors = parsed.errors
    var diagnostics = parsed.diagnostics
    var action = 0
    while (action < parsed.actions.size) {
        val staged = parsed.actions[action]
        actions.append(staged)
        var expression = staged
        if (staged.kind == "compile" && staged.children.size == 1) {
            expression = staged.children[0]
        }
        if (expression.kind == "call" &&
            expression.text == "compilerGenerateModule") {
            var valid = expression.children.size == 2 &&
                expression.children[0].kind == "string" &&
                expression.children[1].kind == "string" &&
                expression.children[0].text != "" &&
                expression.children[1].text.size <= 65536 &&
                namespaces.size < 64
            var namespace = ""
            if (expression.children.size > 0) {
                namespace = expression.children[0].text
            }
            var namespaceIndex = 0
            while (namespaceIndex < namespaces.size) {
                if (namespaces[namespaceIndex] == namespace) valid = false
                namespaceIndex = namespaceIndex + 1
            }
            if (!valid) {
                errors = errors + 1
                diagnostics =
                    "${diagnostics}error[E_EXT_GENERATED_MODULE_REQUEST]: compilerGenerateModule requires a unique non-empty namespace and at most 65536 bytes of source\n"
                diagnostics =
                    "${diagnostics}source[generated-origin]:$namespace:${expression.begin}:${expression.end}\n"
            }
            if (valid) {
                namespaces.append(namespace)
                val generated = bootstrapParseWithIdentity(
                    expression.children[1].text,
                    "<generated:$namespace>"
                )
                bootstrapMergeCompileInputs(
                    compileInputPaths,
                    compileInputContents,
                    generated.compileInputPaths,
                    generated.compileInputContents
                )
                errors = errors + generated.errors
                diagnostics = "$diagnostics${generated.diagnostics}"
                var generatedDeclaration = 0
                while (generatedDeclaration < generated.declarations.size) {
                    declarations.append(
                        generated.declarations[generatedDeclaration]
                    )
                    generatedDeclaration = generatedDeclaration + 1
                }
                var generatedAction = 0
                while (generatedAction < generated.actions.size) {
                    actions.append(generated.actions[generatedAction])
                    generatedAction = generatedAction + 1
                }
            }
        }
        action = action + 1
    }
    var request = 0
    while (request < extensionRequests.size && namespaces.size < 64) {
        val extensionRequest = extensionRequests[request]
        val finalized = bootstrapInvokeExtensionFinalizer(
            // Finalizers reflect the semantically analyzed current module,
            // not the earlier discovery snapshot used to locate handlers.
            // The typed view contains current source declarations in their
            // stable slots and preserves imported handler declarations.
            typedDeclarations,
            extensionRequest,
            typedCalls,
            allowedCompileEffects
        )
        bootstrapMergeCompileInputs(
            compileInputPaths,
            compileInputContents,
            finalized.compileInputPaths,
            finalized.compileInputContents
        )
        errors = errors + finalized.errors
        if (finalized.diagnostics != "") {
            diagnostics =
                "$diagnostics${finalized.diagnostics}"
            diagnostics =
                "${diagnostics}context[generated-extension-finalizer]: `${extensionRequest.finalizer}`\n"
            diagnostics =
                "${diagnostics}source[extension-request]:${extensionRequest.namespace}:${extensionRequest.sourceIdentity}:${extensionRequest.expression.begin}:${extensionRequest.expression.end}\n"
        }
        if (finalized.errors > 0 && finalized.diagnostics == "") {
            diagnostics =
                "${diagnostics}error[E_GENERATED_EXTENSION_FINALIZER]: generated extension finalizer `${extensionRequest.finalizer}` failed with ${finalized.errors} evaluator error(s)\n"
            diagnostics =
                "${diagnostics}request[generated-extension]:round=1,index=$request,namespace=${extensionRequest.namespace}\n"
            diagnostics =
                "${diagnostics}source[extension-request]:${extensionRequest.sourceIdentity}:${extensionRequest.expression.begin}:${extensionRequest.expression.end}\n"
        }
        var namespaceAvailable = extensionRequest.namespace != ""
        var existingNamespace = 0
        while (existingNamespace < namespaces.size) {
            if (namespaces[existingNamespace] == extensionRequest.namespace) {
                namespaceAvailable = false
            }
            existingNamespace = existingNamespace + 1
        }
        if (!namespaceAvailable) {
            errors = errors + 1
            diagnostics =
                "$diagnostics${bootstrapGeneratedRequestDiagnostic(
                    "E_EXT_NAMESPACE_COLLISION",
                    "generated namespace `${extensionRequest.namespace}` is not unique in this module",
                    extensionRequest
                )}"
        }
        if (namespaceAvailable && finalized.errors == 0 &&
            extensionRequest.directAst &&
            finalized.value.kind == "generated.module" &&
            finalized.value.text == extensionRequest.namespace) {
            val generatedIndexes: array<int> = []
            var validGenerated = true
            var element = 0
            while (element < finalized.value.elements.size) {
                val generated = finalized.value.elements[element]
                if (generated.kind == "generated.declaration") {
                    if (generated.integer < 0 ||
                        generated.integer >=
                            finalized.generatedDeclarations.size) {
                        validGenerated = false
                    } else {
                        val declaration = finalized.generatedDeclarations[generated.integer]
                        if (declaration.generatedNamespace !=
                            extensionRequest.namespace) {
                            validGenerated = false
                        } else generatedIndexes.append(generated.integer)
                    }
                } else if (generated.kind != "generated.origin") {
                    validGenerated = false
                }
                element = element + 1
            }
            if (generatedIndexes.size > 256) validGenerated = false
            if (validGenerated) {
                namespaces.append(extensionRequest.namespace)
                var generatedIndex = 0
                while (generatedIndex < generatedIndexes.size) {
                    declarations.append(finalized.generatedDeclarations[generatedIndexes[generatedIndex]])
                    generatedIndex = generatedIndex + 1
                }
            } else {
                errors = errors + 1
                diagnostics =
                    "$diagnostics${bootstrapGeneratedRequestDiagnostic(
                        "E_EXT_GENERATED_PROVENANCE",
                        "generated module violates its request provenance invariant",
                        extensionRequest
                    )}"
            }
        } else if (namespaceAvailable && finalized.errors == 0 &&
            !extensionRequest.directAst &&
            finalized.value.kind == "string" &&
            finalized.value.text.size <= 65536) {
            namespaces.append(extensionRequest.namespace)
            val generated = bootstrapParseWithIdentity(
                finalized.value.text,
                "<generated:${extensionRequest.namespace}>"
            )
            bootstrapMergeCompileInputs(
                compileInputPaths,
                compileInputContents,
                generated.compileInputPaths,
                generated.compileInputContents
            )
            errors = errors + generated.errors
            diagnostics = "$diagnostics${generated.diagnostics}"
            if (generated.errors > 0) diagnostics =
                "${diagnostics}context[generated-extension]: generated compatibility module failed to parse in namespace `${extensionRequest.namespace}`\nsource[extension-request]:${extensionRequest.sourceIdentity}:${extensionRequest.expression.begin}:${extensionRequest.expression.end}\n"
            var generatedDeclaration = 0
            while (generatedDeclaration < generated.declarations.size) {
                declarations.append(
                    generated.declarations[generatedDeclaration]
                )
                generatedDeclaration = generatedDeclaration + 1
            }
            var generatedAction = 0
            while (generatedAction < generated.actions.size) {
                actions.append(generated.actions[generatedAction])
                generatedAction = generatedAction + 1
            }
        } else if (namespaceAvailable && finalized.errors == 0) {
            errors = errors + 1
            diagnostics =
                "$diagnostics${bootstrapGeneratedRequestDiagnostic(
                    "E_EXT_FINALIZER_RESULT",
                    "finalizer returned the wrong result kind or namespace",
                    extensionRequest
                )}"
        }
        request = request + 1
    }
    if (request < extensionRequests.size) {
        errors = errors + 1
        val extensionRequest = extensionRequests[request]
        diagnostics =
            "$diagnostics${bootstrapGeneratedRequestDiagnostic(
                "E_EXT_NAMESPACE_LIMIT",
                "generated module namespace limit exceeded",
                extensionRequest
            )}"
    }
    val transformDeclarations: array<BootstrapDeclaration> = []
    var transformDeclaration = 0
    while (transformDeclaration < handlerDeclarations.size) {
        val local = transformDeclaration - currentDeclarationBegin
        if (local >= 0 && local < currentDeclarationCount &&
            local < parsed.declarations.size) {
            transformDeclarations.append(declarations[local])
        } else transformDeclarations.append(
            handlerDeclarations[transformDeclaration]
        )
        transformDeclaration = transformDeclaration + 1
    }
    var extraTransformDeclaration = currentDeclarationCount
    while (extraTransformDeclaration < parsed.declarations.size) {
        transformDeclarations.append(
            declarations[extraTransformDeclaration]
        )
        extraTransformDeclaration = extraTransformDeclaration + 1
    }
    var generatedForTransform = parsed.declarations.size
    while (generatedForTransform < declarations.size) {
        transformDeclarations.append(declarations[generatedForTransform])
        generatedForTransform = generatedForTransform + 1
    }
    val transformed = bootstrapApplyCompilerTransforms(
        transformDeclarations,
        actions,
        allowedCompileEffects
    )
    errors = errors + transformed.errors
    diagnostics = "$diagnostics${transformed.diagnostics}"
    bootstrapMergeCompileInputs(
        compileInputPaths,
        compileInputContents,
        transformed.compileInputPaths,
        transformed.compileInputContents
    )
    var transformedLocal = 0
    while (transformedLocal < parsed.declarations.size) {
        val candidate = if (transformedLocal < currentDeclarationCount) {
            currentDeclarationBegin + transformedLocal
        } else {
            handlerDeclarations.size +
                transformedLocal - currentDeclarationCount
        }
        if (candidate >= 0 && candidate < transformDeclarations.size) {
            declarations[transformedLocal] =
                transformDeclarations[candidate]
        }
        transformedLocal = transformedLocal + 1
    }
    if (bootstrapArtifactSliceActive) {
        var sliceDeclaration = 0
        while (sliceDeclaration < declarations.size) {
            if (declarations[sliceDeclaration].kind == "fun" &&
                declarations[sliceDeclaration].name == "main" &&
                declarations[sliceDeclaration].extensionOwner == "" &&
                !bootstrapIndependentEntryIdentity(
                    declarations[sliceDeclaration].sourceIdentity
                )) {
                declarations[sliceDeclaration] = bootstrapDeclarationWithName(
                    declarations[sliceDeclaration],
                    "__abla_slice_excluded_main"
                )
            }
            sliceDeclaration = sliceDeclaration + 1
        }
    }
    BootstrapParseResult(
        declarations,
        actions,
        errors,
        parsed.extensionErrors + errors - parsed.errors,
        compileInputPaths,
        compileInputContents,
        diagnostics
    )
}

fun bootstrapParseStagedRegistered(
    source: string,
    sourceIdentity: string,
    handlerDeclarations: array<BootstrapDeclaration>,
    currentDeclarationBegin: int,
    currentDeclarationCount: int,
    registry: BootstrapSubparserRegistry,
    allowedCompileEffects: int
): BootstrapParseResult {
    val tokens = bootstrapLex(source)
    val expansionBegins: array<int> = []
    val expansionEnds: array<int> = []
    val expansionExpressions: array<BootstrapExpression> = []
    val extensionRequests: array<BootstrapExtensionRequest> = []
    val compileInputPaths: array<string> = []
    val compileInputContents: array<string> = []
    var diagnostics = ""
    var extensionErrors = 0

    var tokenIndex = tokens.size - 2
    while (tokenIndex >= 0) {
        if (tokens[tokenIndex].kind == "$" &&
            tokenIndex + 1 < tokens.size &&
            tokens[tokenIndex + 1].kind == "identifier") {
            val name = bootstrapTokenText(source, tokens[tokenIndex + 1])
            val registrationIndex = bootstrapRegistrationIndex(
                registry,
                name,
                tokens[tokenIndex].begin
            )
            if (registrationIndex >= 0) {
                var literalRawMarker = false
                if (tokens[tokenIndex].begin > 0 &&
                    tokens[tokenIndex + 1].end < source.size) {
                    literalRawMarker =
                        source[tokens[tokenIndex].begin - 1] == 62 &&
                        source[tokens[tokenIndex + 1].end] == 60
                }
                if (!literalRawMarker) {
                val position = tokenIndex + 2
                var rawPosition = source.size
                if (position < tokens.size) {
                    rawPosition = tokens[position].begin
                }
                val cursor = BootstrapSubparserCursor(
                    sourceIdentity,
                    source,
                    tokens,
                    expansionBegins,
                    expansionEnds,
                    expansionExpressions,
                    position,
                    rawPosition,
                    0
                )
                val invocation = bootstrapInvokeSubparserHandler(
                    handlerDeclarations,
                    registry.registrations[registrationIndex].handler,
                    cursor,
                    allowedCompileEffects
                )
                extensionErrors = extensionErrors + invocation.errors
                if (invocation.diagnostics != "") {
                    diagnostics = "$diagnostics${invocation.diagnostics}"
                    diagnostics =
                        "${diagnostics}context[subparser]: `${registry.registrations[registrationIndex].handler}`\n"
                    diagnostics =
                        "${diagnostics}source[extension-expression]:$sourceIdentity:${tokens[tokenIndex].begin}:${cursor.rawPosition}\n"
                } else if (invocation.errors > 0) {
                    diagnostics =
                        "${diagnostics}error[E_SUBPARSER_INVOCATION]: subparser `${registry.registrations[registrationIndex].handler}` failed with ${invocation.errors} evaluator/parser error(s)\n"
                    diagnostics =
                        "${diagnostics}source[extension-expression]:$sourceIdentity:${tokens[tokenIndex].begin}:${cursor.rawPosition}\n"
                }
                if (invocation.expression.kind != "invalid" &&
                    cursor.rawPosition > rawPosition) {
                    expansionBegins.append(tokens[tokenIndex].begin)
                    expansionEnds.append(cursor.rawPosition)
                    expansionExpressions.append(invocation.expression)
                }
                var request = 0
                while (request < invocation.extensionRequests.size) {
                    val extensionRequest = invocation.extensionRequests[request]
                    if (extensionRequest.diagnostic == "") {
                        extensionRequests.append(extensionRequest)
                    } else diagnostics =
                        "$diagnostics${extensionRequest.diagnostic}"
                    request = request + 1
                }
                bootstrapMergeCompileInputs(
                    compileInputPaths,
                    compileInputContents,
                    invocation.compileInputPaths,
                    invocation.compileInputContents
                )
                }
            }
        }
        tokenIndex = tokenIndex - 1
    }

    val parsed = BootstrapParser(
        sourceIdentity,
        source,
        tokens,
        expansionBegins,
        expansionEnds,
        expansionExpressions,
        0,
        0,
        ""
    ).parse()
    bootstrapApplyGeneratedModules(
        BootstrapParseResult(
            parsed.declarations,
            parsed.actions,
            parsed.errors + extensionErrors,
            extensionErrors,
            compileInputPaths,
            compileInputContents,
            "${parsed.diagnostics}$diagnostics"
        ),
        handlerDeclarations,
        currentDeclarationBegin,
        currentDeclarationCount,
        extensionRequests,
        allowedCompileEffects
    )
}

fun bootstrapParseStaged(source: string): BootstrapParseResult {
    val discovery = bootstrapParse(source)
    val registry = bootstrapBuildSubparserRegistry(discovery)
    val parsed = bootstrapParseStagedRegistered(
        source,
        "<memory>",
        discovery.declarations,
        0,
        discovery.declarations.size,
        registry,
        0
    )
    BootstrapParseResult(
        parsed.declarations,
        parsed.actions,
        parsed.errors + registry.errors,
        parsed.extensionErrors + registry.errors,
        parsed.compileInputPaths,
        parsed.compileInputContents,
        "${parsed.diagnostics}${registry.diagnostics}"
    )
}

// The source a module is parsed from differs from its file when names in it
// are rewritten with a module's prefix (bootstrapRewriteModuleSource), and
// that prefix spells the module's path. Each edit is kept with where it sits
// in both texts, so a position in the parsed source maps back to the file:
// debug information then names the file's own lines and columns, the same
// wherever the module is installed.
class BootstrapSourceRewrite(
    val path: string,
    val rewrittenBegins: array<int>,
    val rewrittenEnds: array<int>,
    val originalBegins: array<int>,
    val originalEnds: array<int>
) {
    // The file offset of a parsed-source offset; inside a rewritten name, the
    // name's own start.
    fun original(offset: int): int {
        var low = 0
        var high = this.rewrittenBegins.size
        while (low < high) {
            val middle = (low + high) / 2
            if (this.rewrittenBegins[middle] <= offset) low = middle + 1
            else high = middle
        }
        if (low == 0) return offset
        val edit = low - 1
        if (offset < this.rewrittenEnds[edit]) this.originalBegins[edit]
        else this.originalEnds[edit] + offset - this.rewrittenEnds[edit]
    }

    // The file offset of a parsed-source end offset (exclusive): an end inside
    // or at the end of a rewritten name is that name's end.
    fun originalEnd(offset: int): int {
        var low = 0
        var high = this.rewrittenBegins.size
        while (low < high) {
            val middle = (low + high) / 2
            if (this.rewrittenBegins[middle] < offset) low = middle + 1
            else high = middle
        }
        if (low == 0) return offset
        val edit = low - 1
        if (offset <= this.rewrittenEnds[edit]) this.originalEnds[edit]
        else this.originalEnds[edit] + offset - this.rewrittenEnds[edit]
    }
}

var bootstrapSourceRewrites: array<BootstrapSourceRewrite> = []

fun bootstrapRecordSourceRewrite(rewrite: BootstrapSourceRewrite): void {
    var index = 0
    while (index < bootstrapSourceRewrites.size) {
        if (bootstrapSourceRewrites[index].path == rewrite.path) {
            bootstrapSourceRewrites[index] = rewrite
            return
        }
        index = index + 1
    }
    if (rewrite.rewrittenBegins.size > 0) {
        bootstrapSourceRewrites.append(rewrite)
    }
    return
}

fun bootstrapSourceRewriteOf(path: string): BootstrapSourceRewrite {
    var index = 0
    while (index < bootstrapSourceRewrites.size) {
        if (bootstrapSourceRewrites[index].path == path) {
            return bootstrapSourceRewrites[index]
        }
        index = index + 1
    }
    BootstrapSourceRewrite(path, [], [], [], [])
}

// The decimal at `text[begin until end]` when it is one (only digits), else -1.
fun bootstrapSourceRewriteDecimal(text: string, begin: int, end: int): int {
    if (end <= begin) return -1
    var value = 0
    var index = begin
    while (index < end) {
        val byte = text[index]
        if (byte < 48 || byte > 57) return -1
        value = value * 10 + byte - 48
        index = index + 1
    }
    value
}

// `line` with each `@<offset>` mapped through `rewrite`.
fun bootstrapSourceRewriteAtOffsets(
    line: string,
    rewrite: BootstrapSourceRewrite
): string {
    var output = ""
    var cursor = 0
    var index = 0
    while (index < line.size) {
        if (line[index] == 64) {
            var end = index + 1
            while (end < line.size && line[end] >= 48 && line[end] <= 57) {
                end = end + 1
            }
            val offset = bootstrapSourceRewriteDecimal(line, index + 1, end)
            if (offset >= 0) {
                output = "$output${line.slice(cursor, index + 1)}${rewrite.original(offset)}"
                cursor = end
            }
            index = end
        } else index = index + 1
    }
    "$output${line.slice(cursor, line.size)}"
}

// Diagnostics place an error with a `source[kind]:path:begin:end` line after it
// (and `@offset`s in its text). Those the parse, semantic analysis and
// extensions report are offsets into the source the module was parsed from:
// for a module whose names were rewritten, they are mapped back to its file
// here. Other diagnostics are returned unchanged.
fun bootstrapSourceRewriteDiagnostics(diagnostics: string): string {
    if (bootstrapSourceRewrites.size == 0) return diagnostics
    val pending: array<string> = []
    var output = ""
    var lineBegin = 0
    while (lineBegin < diagnostics.size) {
        var lineEnd = lineBegin
        while (lineEnd < diagnostics.size && diagnostics[lineEnd] != 10) {
            lineEnd = lineEnd + 1
        }
        val line = diagnostics.slice(lineBegin, lineEnd)
        val newline = if (lineEnd < diagnostics.size) "\n" else ""
        var mapped = line
        var rewritten = false
        if (line.size > 7 && line.slice(0, 7) == "source[") {
            // The path runs from after `]:` to the second colon from the end.
            var close = 7
            while (close < line.size && line[close] != 93) close = close + 1
            var last = line.size - 1
            while (last > close && line[last] != 58) last = last - 1
            var middle = last - 1
            while (middle > close && line[middle] != 58) middle = middle - 1
            val begin = bootstrapSourceRewriteDecimal(line, middle + 1, last)
            val end = bootstrapSourceRewriteDecimal(line, last + 1, line.size)
            // Positions the parse took (parser, semantic and extension
            // diagnostics); import diagnostics already name the file's own.
            val kind = line.slice(7, close)
            val parsed = kind == "semantic" || kind == "parser" ||
                kind == "extension-expression" ||
                kind == "extension-request" || kind == "subparser"
            if (parsed && close + 2 < middle && begin >= 0 && end >= 0) {
                val rewrite = bootstrapSourceRewriteOf(line.slice(close + 2, middle))
                if (rewrite.rewrittenBegins.size > 0) {
                    mapped = "${line.slice(0, middle + 1)}${rewrite.original(begin)}:${rewrite.originalEnd(end)}"
                    rewritten = true
                    for (text in pending) {
                        output = "$output${bootstrapSourceRewriteAtOffsets(text, rewrite)}\n"
                    }
                }
            }
            if (!rewritten) {
                for (text in pending) output = "$output$text\n"
            }
            pending.clear()
            output = "$output$mapped$newline"
        } else if (newline == "") {
            for (text in pending) output = "$output$text\n"
            pending.clear()
            output = "$output$line"
        } else pending.append(line)
        lineBegin = lineEnd + 1
    }
    for (text in pending) output = "$output$text\n"
    output
}
