// The compiler's own `___emutls_get_address` (#826): ORC lowers the thread-locals of a JIT-compiled program (`ablac run`) to
// calls of it (on macOS for lack of a MachOPlatform; on Linux too), and the JIT resolves it in the compiler's image. This
// one is abla/runtime/emutls, on the Abla heap and atomics, instead of compiler-rt's (libSystem's malloc, pthread
// mutexes and keys on macOS; libc's on Linux). The link keeps it exported (src/toolchain.ab: -Wl,-u,___emutls_get_address
// on macOS).
import "abla/runtime/emutls"

@export("__emutls_get_address")
trusted fun ablaEmutlsGetAddress(control: int): int = emutlsGetAddress(control)
