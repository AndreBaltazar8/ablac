// Native code at compile time: extern:"c" calls and the trusted raw-memory
// and system intrinsics, for the compile-time evaluator.
//
// The compiler is itself a process on the Abla runtime, so a raw intrinsic is
// evaluated by performing it: a load reads the address, an allocation comes
// from the same allocator a program's would, a syscall enters the kernel the
// same way. An extern:"c" call resolves its symbol in the compiler process or
// in a library of the root manifest's `nativeLibraries` (loaded permanently,
// once per process) and goes through a thunk compiled for its signature by an
// in-process ORC JIT: the thunk loads the arguments from 64-bit words, makes
// the call with the declared C types, as a compiled program's call would, and
// stores the widened result.
//
// Everything here is arbitrary native code at compile time: it requires the
// `trusted.native` compile capability (process arguments and the environment
// require `environment`), checked when evaluated as well as by the semantic
// effect analysis, since parser handlers run before that analysis.

import "eval.ab"
import "abla/unsafe/memory"
import "abla/unsafe/native"
import "abla/sys/linux"
import "abla/sys/linux/process"
import "abla/sys/linux/fs"
import "abla/llvm/orc"
import "abla/float"
import "abla/platform/host"
import "abla/io"
import "abla/process/time"

// The runtime's 64-bit atomics and fences (abla/runtime/self declares them for the runtime alone), which its
// futex mutex and transactional memory use: compile-time code that reaches them (a runtime mutex, #829
// thread-heap-mutex) runs them on the real words, as at run time.
private trusted noescape extern:"intrinsic" fun ablaRuntimeAtomicLoadI64(address: int): int
private trusted noescape extern:"intrinsic" fun ablaRuntimeAtomicStoreI64(address: int, value: int): void
private trusted noescape extern:"intrinsic" fun ablaRuntimeAtomicCompareExchangeI64(
    address: int,
    expected: int,
    replacement: int
): int
private trusted noescape extern:"intrinsic" fun ablaRuntimeAtomicFetchAddI64(address: int, delta: int): int
private trusted noescape extern:"intrinsic" fun ablaRuntimeFence(): void
private trusted noescape extern:"intrinsic" fun ablaRuntimeFenceAcquire(): void
private trusted noescape extern:"intrinsic" fun ablaRuntimeFenceRelease(): void
import "parser.ab"
import "sema.ab"
import "ct_native_effects.ab"
import "abla/unsafe/memory/raw"
import "abla/text"

noescape extern:"c" fun dlopen(path: i64*, mode: i32): i64*
noescape extern:"c" fun dlsym(handle: i64*, name: cstring): i64*

// The entry module of the compilation being staged (set when its module graph
// starts loading): its root manifest names the native libraries.
var ctNativeEntryPath: string = ""

// The libraries loaded for `ctNativeLibrariesEntry`, and the ones that were
// named but not found (reported when a symbol is then missing).
var ctNativeLibrariesEntry: string = ""
var ctNativeLibrariesReady: bool = false
var ctNativeLoadedLibraries: array<string> = []
var ctNativeLoadedLibraryPaths: array<string> = []
var ctNativeMissingLibraries: array<string> = []
var ctNativeSearchedDirectories: string = ""

// The thunk JIT (created on the first extern:"c" call) and its thunks, one per
// signature key.
var ctNativeSessions: array<LlvmOrcSession> = []
var ctNativeThunkKeys: array<string> = []
var ctNativeThunkAddresses: array<int> = []

// Resolved symbols, by name.
var ctNativeSymbolNames: array<string> = []
var ctNativeSymbolAddresses: array<int> = []

// Strings whose storage an evaluated `ablaUnsafeCStringAddress` or
// `ablaUnsafeStringAddress` handed out. A program keeps such a string alive
// while it uses the address; the evaluator's values may be dropped earlier, so
// the most recent ones are held here.
val CT_NATIVE_PINNED_LIMIT = 4096
var ctNativePinned: array<string> = []
var ctNativePinnedNext: int = 0

// The compile-time tier the build cache keys on (toolchain.ab, the object cache's source identity; jit_cache.ab, a
// run record): ABLA_COMPILE_EVAL as given ("" when unset). The tiers can disagree (a site the evaluator stops on runs
// natively), so a build cached under one is never reused under another. (Read here, not through ct_eval.ab's
// bootstrapCtMode, which the cache's modules don't import.)
fun bootstrapCtCacheTier(): string {
    val configured = linuxEnvironment("ABLA_COMPILE_EVAL")
    if (configured.found) configured.value else ""
}

// Set while a site runs as a trial under ABLA_COMPILE_EVAL=auto (ct_jit.ab, bootstrapCtTrials): an attempt the
// native tier repeats if it does not finish, so nothing in it may act outside the interpreter. A provider call
// (files, output, the clock…), an extern:"c" call, a system call, an unsafe call or static storage stops it
// before it happens (ctNativeTrialStop): the site then runs natively, once.
var ctNativeTrial: bool = false

fun ctNativeTrialStop(var evaluator: BootstrapEvaluator, what: string): bool {
    if (!ctNativeTrial) return false
    evaluator.errors = evaluator.errors + 1
    evaluator.recordEvaluatorDiagnostic("E_CT_TRIAL", "a trial evaluation stops before $what")
    true
}

fun ctNativeTrialIntrinsic(name: string): bool =
    name == "ablaLinuxSyscall" || name.startsWith("ablaDarwin") || name.startsWith("ablaUnsafeCall") ||
    name.startsWith("nativeStatic") || name == "nativeThreadLocalBytes"

// The compile capabilities granted to the `#` expressions of the program being
// lowered: its source requests intersected with the manifest's authorization,
// and none once semantic analysis failed (a denied effect is one such
// failure, and lowering still evaluates for diagnostics).
var ctNativeLoweringGrants: int = 0

fun ctNativeSetLoweringGrants(parsed: BootstrapParseResult, semanticErrors: int): void {
    ctNativeLoweringGrants = if (semanticErrors > 0) 0 else
        bootstrapBuildCompileEffectGrants(
            bootstrapBuildCompileEffectRequests(parsed),
            bootstrapBuildCompileEffectAuthorizations(parsed)
        )
    return
}

fun ctNativeSetEntry(path: string): void {
    ctNativeEntryPath = path
    return
}

// The thread-local objects compile-time code made, by call site
// (nativeThreadLocalBytes).
val ctNativeThreadLocals: Map<string, int> = Map()

fun ctNativeIntrinsicPrefix(name: string): bool =
    name.startsWith("ablaUnsafe") || name.startsWith("ablaLinux") ||
    name.startsWith("ablaRuntimePointer") || name.startsWith("__ablaRuntime") ||
    name.startsWith("ablaRuntimeAtomic") || name.startsWith("ablaRuntimeFence") ||
    name == "ablaRuntimeTrap" || name == "ablaHostIsMacOS" || name == "ablaHostIsIOS" || name ==
    "ablaHostOwnsRuntime" ||
    name == "ablaHostValueArgumentsIndirect" ||
    name == "nativeStackAllocate" || name == "nativeStaticAllocate" ||
    name == "nativeThreadLocalBytes" || name == "nativeFunctionAddress" ||
    name == "nativeStaticBytes" || name == "nativeStaticMutableBytes"

// The raw intrinsics evaluated here (the extern:"intrinsic" declarations of
// abla/unsafe/memory, abla/unsafe/native and abla/sys/linux, and the runtime's
// allocation entry points they reach).
fun ctNativeIntrinsic(name: string): bool =
    name.startsWith("ablaUnsafeVolatileLoadU") || name.startsWith("ablaUnsafeVolatileStoreU") ||
    name == "ablaUnsafeLoadU8" || name == "ablaUnsafeLoadU16" ||
    name == "ablaUnsafeLoadU32" || name == "ablaUnsafeLoadI64" ||
    name == "ablaUnsafeLoadPointer" ||
    name == "ablaUnsafeStoreU8" || name == "ablaUnsafeStoreU16" ||
    name == "ablaUnsafeStoreU32" || name == "ablaUnsafeStoreI64" ||
    name == "ablaUnsafeStorePointer" ||
    name == "ablaUnsafeNullPointer" || name == "ablaUnsafePointerIsNull" ||
    name == "ablaUnsafePointerOffset" || name == "ablaUnsafePointerAddress" ||
    name == "ablaRuntimePointerFromAddress" ||
    name == "ablaRuntimePointerAddress" ||
    name == "ablaUnsafeSetMemory" || name == "ablaUnsafeCopyMemory" ||
    name == "ablaUnsafeCStringAddress" || name == "ablaUnsafeStringAddress" ||
    name == "ablaUnsafeAdoptString" || name == "ablaUnsafeBorrowCString" ||
    name == "__ablaRuntimeAllocateLayout" || name == "__ablaRuntimeAllocate" ||
    name == "__ablaRuntimeFree" || name == "__ablaRuntimeStringWriteVectors" ||
    name == "__ablaRuntimePlatformMemorySetLayout" ||
    name == "ablaUnsafeAtomicFetchAddI64" ||
    name == "ablaUnsafeAtomicCompareExchangeU32" ||
    name == "ablaUnsafeAtomicCompareExchangeRelaxedU32" ||
    name == "ablaUnsafeAtomicFence" ||
    name == "ablaRuntimeAtomicLoadI64" || name == "ablaRuntimeAtomicStoreI64" ||
    name == "ablaRuntimeAtomicCompareExchangeI64" || name == "ablaRuntimeAtomicFetchAddI64" ||
    name == "ablaRuntimeFence" || name == "ablaRuntimeFenceAcquire" || name == "ablaRuntimeFenceRelease" ||
    name == "nativeStackAllocate" || name == "nativeStaticAllocate" ||
    name == "nativeThreadLocalBytes" || name == "nativeFunctionAddress" ||
    name == "nativeStaticBytes" || name == "nativeStaticMutableBytes" ||
    name == "ablaUnsafeCallVoid0" || name == "ablaUnsafeCallI32" ||
    name == "ablaUnsafeCallVoidPointer3" ||
    name == "ablaLinuxSyscall" || name == "ablaRuntimeTrap" ||
    name == "ablaLinuxArgumentCount" || name == "ablaLinuxArgument" ||
    name == "ablaLinuxEnvironmentPointer" ||
    name == "ablaHostIsMacOS" || name == "ablaHostIsIOS" || name == "ablaHostOwnsRuntime" || name ==
    "ablaHostValueArgumentsIndirect"

// The build's target, as numbers (a string kept here would not outlive a region): what the interpreter answers for the
// target queries of abla/simd/target (the architecture) and abla/ct (32-bit pointers), so that compile-time code sees the
// target it is compiled for, as run-time code does, and not the host the compiler runs on (#822). -1: no build has set it
// (the compiler's own host).
var ctNativeBuildArch: int = -1
var ctNativeBuildNarrow: int = -1

// The architecture number of abla/simd/target: 1 x86-64, 2 AArch64, 3 Wasm, 4 Xtensa, 0 other.
fun ctNativeArchOfTriple(triple: string): int =
    if (bootstrapTextContains(triple, "x86_64")) 1
    else if (bootstrapTextContains(triple, "aarch64") || bootstrapTextContains(triple, "arm64")) 2
    else if (bootstrapTextContains(triple, "wasm32")) 3
    else if (bootstrapTextContains(triple, "xtensa")) 4
    else 0

// Pointers of 32 bits (Wasm excepted: its constant-time code has its own layout), as the backend's ablaCtNarrowTarget.
fun ctNativeNarrowOfTriple(triple: string): bool =
    (bootstrapTextContains(triple, "xtensa") || bootstrapTextContains(triple, "riscv32") ||
     bootstrapTextContains(triple, "thumb") || bootstrapTextContains(triple, "i386") ||
     bootstrapTextContains(triple, "i486") || bootstrapTextContains(triple, "i586") ||
     bootstrapTextContains(triple, "i686")) && !bootstrapTextContains(triple, "wasm32")

fun ctNativeSetBuildTarget(triple: string): void {
    ctNativeBuildArch = ctNativeArchOfTriple(triple)
    ctNativeBuildNarrow = if (ctNativeNarrowOfTriple(triple)) 1 else 0
    return
}

// The constant-time primitives (abla/ct: a secret integer is the integer itself under `#`, whose values are neither secret nor
// timed), the target queries, and the stack wipes (an interpreter frame has no native stack to wipe, as on Wasm). The CPU probe
// answers "no feature" (0): compile-time code takes the portable software path, whose answers the hardware paths must equal.
fun ctNativePrimitive(name: string): bool =
    name == "ablaCtNarrowTarget" || name == "ablaSimdTargetArch" || name == "ablaSimdCpuProbe" ||
    name.startsWith("ablaCtSecret_") || name.startsWith("ablaCtBits_") ||
    name == "ablaCtScrubSaveAreas" || name == "ablaCtScrubBounded" ||
    name.startsWith("ablaCtScrubStack") || name.startsWith("ablaCtScrubBoundedStack")

fun ctNativeEvaluatePrimitive(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression,
    name: string
): BootstrapEvalValue {
    if (name.startsWith("ablaCtSecret_") || name.startsWith("ablaCtBits_")) {
        if (expression.children.size == 0) return bootstrapEvalInvalid()
        val operand = evaluator.evaluate(expression.children[0])
        if (bootstrapEvalLeaves(operand)) return operand
        // ablaCtSecret_u32 makes a secretU32 of a u32 and ablaCtBits_u32 the u32 of a secretU32: the same bits, the other type,
        // which is what finds the operators of secretU32 for a value (an integer carries its type).
        val secret = name.startsWith("ablaCtSecret_")
        val width = if (name.endsWith("_u8")) "u8" else if (name.endsWith("_u16")) "u16"
            else if (name.endsWith("_u32")) "u32" else "u64"
        val nominal = if (!secret) "" else if (width == "u8") "secretU8" else if (width == "u16") "secretU16"
            else if (width == "u32") "secretU32" else "secretU64"
        return bootstrapEvalScalar(operand.integer, width, nominal)
    }
    if (name == "ablaCtNarrowTarget") {
        val narrow = if (ctNativeBuildNarrow >= 0) ctNativeBuildNarrow == 1
            else ctNativeNarrowOfTriple(llvmDefaultTargetTriple())
        return bootstrapEvalBoolean(narrow)
    }
    if (name == "ablaSimdTargetArch") {
        return bootstrapEvalInteger(if (ctNativeBuildArch >= 0) ctNativeBuildArch
            else ctNativeArchOfTriple(llvmDefaultTargetTriple()))
    }
    if (name == "ablaSimdCpuProbe") return bootstrapEvalInteger(0)
    // Whether the wipe needs the image's stack limit (Xtensa): under `#` no wipe touches a native stack, so the
    // unbounded no-op is taken, as on the hosted targets.
    if (name == "ablaCtScrubBounded") return bootstrapEvalBoolean(false)
    bootstrapEvalVoid()
}

// A volatile access is an ordinary one for the interpreter (no other thread, no device): ablaUnsafeVolatileLoadU32 is
// ablaUnsafeLoadU32, and the 64-bit ones are the I64 ones.
fun ctNativeNonVolatileName(name: string): string {
    val kind = if (name.startsWith("ablaUnsafeVolatileLoad")) "Load" else "Store"
    val width = name.slice(name.size - 3, name.size)
    if (width == "U64") "ablaUnsafe" + kind + "I64"
    else if (width == "U16") "ablaUnsafe" + kind + "U16"
    else if (width == "U32") "ablaUnsafe" + kind + "U32"
    else "ablaUnsafe" + kind + "U8"
}

// The compile capability an intrinsic needs (the effect bit the semantic
// analysis gives its declaration).
fun ctNativeIntrinsicEffect(name: string): int =
    if (name == "ablaLinuxArgumentCount" || name == "ablaLinuxArgument" ||
        name == "ablaRuntimeTrap" || name == "ablaHostIsMacOS" || name == "ablaHostIsIOS" || name ==
        "ablaHostOwnsRuntime" ||
        name == "ablaHostValueArgumentsIndirect") 0
    else if (name == "ablaLinuxEnvironmentPointer") 16
    else 512

// The source class (bootstrapCompileSourceClass) of the innermost frame being
// evaluated that is not the unsafe boundary or the runtime: raw memory the
// standard library's own code (1) reaches is contained; the program's (0)
// is trusted.native.
var ctNativeRawContext: int = 0

// Entering a declaration's body from `source`: returns the context to
// restore when it is left.
fun ctNativeEnterSource(source: string): int {
    val previous = ctNativeRawContext
    val sourceClass = bootstrapCompileSourceClass(source)
    // A standard-library callee of a network scope (class 4) stays in the scope; the program's own code (0) leaves it.
    if (sourceClass == 4 || (sourceClass == 1 && previous == 4)) ctNativeRawContext = 4
    else if (sourceClass <= 1) ctNativeRawContext = sourceClass
    previous
}

// Raw-memory operations: contained within the standard library.
fun ctNativeRawOperation(name: string): bool =
    bootstrapCompileRawMemoryIntrinsic(name) || name.startsWith("__ablaRuntime")

// Whether an evaluation holds capability `effect` (0: needs none).
fun ctNativeAllowed(evaluator: BootstrapEvaluator, effect: int): bool =
    effect <= 0 || bootstrapCompileEffectHas(evaluator.allowedCompileEffects,
        if ((ctNativeRawContext == 4 || bootstrapCompileBridgeScope) && bootstrapCompileScopeContains(effect)) 64 else effect)

fun ctNativeDenied(
    var evaluator: BootstrapEvaluator,
    what: string,
    effect: int
): BootstrapEvalValue {
    val capability = bootstrapCompileEffectName(effect)
    evaluator.errors = evaluator.errors + 1
    evaluator.recordEvaluatorDiagnostic(
        "E_COMPILE_NATIVE_DENIED",
        "compile-time $what needs the `$capability` compile capability: request it with `#compilerGrant(\"$capability\")` and authorize it in the entry's abla.toml `compileCapabilities`"
    )
    bootstrapEvalInvalid()
}

// The 64-bit word an evaluated scalar passes as (an integer or address, a
// bool as 0/1, a float's IEEE bits).
fun ctNativeWord(value: BootstrapEvalValue): int =
    if (value.kind == "boolean") { if (value.boolean) 1 else 0 }
    else value.integer

fun ctNativeArgument(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression,
    index: int
): int =
    if (index < expression.children.size)
        ctNativeWord(evaluator.evaluate(expression.children[index]))
    else 0

// An address `name` reads, writes or calls through, or -1 (after an error) when it
// is not one: a value that isn't an integer (a missing result), or one in the
// null page, which would crash the compiler instead of failing the evaluation.
fun ctNativeCheckedAddress(
    var evaluator: BootstrapEvaluator,
    value: BootstrapEvalValue,
    name: string
): int {
    val address = if (value.kind == "integer") value.integer else 0
    if (value.kind != "integer" || address < 4096) {
        evaluator.errors = evaluator.errors + 1
        evaluator.recordEvaluatorDiagnostic(
            "E_EVAL_NATIVE_ADDRESS",
            if (value.kind != "integer")
                "`$name` was given no address (a ${value.kind} value) in compile-time evaluation"
            else if (address < 0)
                "`$name` at address $address (not a process address) in compile-time evaluation"
            else "`$name` at address $address (a null pointer) in compile-time evaluation"
        )
        return -1
    }
    address
}

fun ctNativeAddressArgument(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression,
    index: int,
    name: string
): int = ctNativeCheckedAddress(evaluator,
    if (index < expression.children.size)
        evaluator.evaluate(expression.children[index]) else bootstrapEvalInvalid(),
    name)

fun ctNativeValueArgument(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression,
    index: int
): BootstrapEvalValue =
    if (index < expression.children.size)
        evaluator.evaluate(expression.children[index]) else bootstrapEvalInvalid()

trusted fun ctNativePin(value: string): void {
    if (ctNativePinned.size < CT_NATIVE_PINNED_LIMIT) {
        ctNativePinned.append(value)
    } else {
        ctNativePinned[ctNativePinnedNext] = value
        ctNativePinnedNext = ctNativePinnedNext + 1
        if (ctNativePinnedNext == CT_NATIVE_PINNED_LIMIT) {
            ctNativePinnedNext = 0
        }
    }
}

// A copy of the NUL-terminated bytes at `address`, owned by the compiler.
trusted fun ctNativeCopyCString(address: int): string {
    var length = 0
    while (ablaUnsafeLoadU8(nativePointerFromAddress(address + length)) != 0) {
        length = length + 1
    }
    val copy = nativeByteBuffer(length + 1)
    var index = 0
    while (index < length) {
        copy.store(index, ablaUnsafeLoadU8(
            nativePointerFromAddress(address + index)
        ))
        index = index + 1
    }
    copy.store(length, 0)
    copy.adoptString(length)
}

// A NUL-terminated copy of `text` in a platform allocation (released with
// ctNativeFree).
trusted fun ctNativeCString(text: string): int {
    val address = __ablaRuntimeAllocateLayout(text.size + 1, 10)
    var index = 0
    while (index < text.size) {
        ablaUnsafeStoreU8(nativePointerFromAddress(address + index), text[index])
        index = index + 1
    }
    ablaUnsafeStoreU8(nativePointerFromAddress(address + text.size), 0)
    address
}

trusted fun ctNativeFree(address: int): void = __ablaRuntimeFree(address)

@noinline
trusted fun ctNativeEvaluateIntrinsic(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression,
    name: string
): BootstrapEvalValue {
    if (name.startsWith("ablaUnsafeVolatile")) {
        return ctNativeEvaluateIntrinsic(evaluator, expression, ctNativeNonVolatileName(name))
    }
    // An evaluation that already failed performs no raw memory access, call or system call: the values it
    // goes on with are not the program's (an invalid load is read as 0 by arithmetic), so the effect would
    // land on a made-up address. (The runtime's panic path, interpreted after such an error, called the real
    // _longjmp with 0x30 and crashed the compiler: narrow-array-getters, scalar-array-setters.)
    if (evaluator.errors > 0) return bootstrapEvalInvalid()
    if (ctNativeTrialIntrinsic(name) && ctNativeTrialStop(evaluator, "intrinsic `$name`")) return bootstrapEvalInvalid()
    val effect = ctNativeIntrinsicEffect(name)
    val contained = (ctNativeRawContext == 1 || ctNativeRawContext == 4) && ctNativeRawOperation(name)
    if (!contained && !ctNativeAllowed(evaluator, effect)) {
        return ctNativeDenied(evaluator, "intrinsic `$name`", effect)
    }
    if (name == "nativeFunctionAddress") {
        return ctNativeEvaluateFunctionAddress(evaluator, expression)
    }
    if (name == "ablaRuntimeTrap") {
        // A run-time trap (an impossible state the runtime refuses to go on
        // from) ends a compile-time evaluation with a diagnostic instead.
        evaluator.errors = evaluator.errors + 1
        evaluator.recordEvaluatorDiagnostic(
            "E_EVAL_TRAP", "compile-time evaluation reached a run-time trap"
        )
        return bootstrapEvalInvalid()
    }
    var result = bootstrapEvalVoid()
    if (name == "ablaUnsafeLoadU8") {
        val address = ctNativeAddressArgument(evaluator, expression, 0, name)
        if (address < 0) return bootstrapEvalInvalid()
        result = bootstrapEvalInteger(ablaUnsafeLoadU8(nativePointerFromAddress(address)))
    } else if (name == "ablaUnsafeLoadU16") {
        val address = ctNativeAddressArgument(evaluator, expression, 0, name)
        if (address < 0) return bootstrapEvalInvalid()
        result = bootstrapEvalInteger(ablaUnsafeLoadU16(nativePointerFromAddress(address)))
    } else if (name == "ablaUnsafeLoadU32") {
        val address = ctNativeAddressArgument(evaluator, expression, 0, name)
        if (address < 0) return bootstrapEvalInvalid()
        result = bootstrapEvalInteger(ablaUnsafeLoadU32(nativePointerFromAddress(address)))
    } else if (name == "ablaUnsafeLoadI64") {
        val address = ctNativeAddressArgument(evaluator, expression, 0, name)
        if (address < 0) return bootstrapEvalInvalid()
        result = bootstrapEvalInteger(ablaUnsafeLoadI64(nativePointerFromAddress(address)))
    } else if (name == "ablaUnsafeLoadPointer") {
        val address = ctNativeAddressArgument(evaluator, expression, 0, name)
        if (address < 0) return bootstrapEvalInvalid()
        result = bootstrapEvalInteger(nativePointerAddress(
            ablaUnsafeLoadPointer(nativePointerFromAddress(address))
        ))
    } else if (name == "ablaUnsafeStoreU8" || name == "ablaUnsafeStoreU16" ||
               name == "ablaUnsafeStoreU32" || name == "ablaUnsafeStoreI64" ||
               name == "ablaUnsafeStorePointer") {
        val target = ctNativeAddressArgument(evaluator, expression, 0, name)
        if (target < 0) return bootstrapEvalInvalid()
        val address = nativePointerFromAddress(target)
        val value = ctNativeArgument(evaluator, expression, 1)
        if (name == "ablaUnsafeStoreU8") ablaUnsafeStoreU8(address, value)
        if (name == "ablaUnsafeStoreU16") ablaUnsafeStoreU16(address, value)
        if (name == "ablaUnsafeStoreU32") ablaUnsafeStoreU32(address, value)
        if (name == "ablaUnsafeStoreI64") ablaUnsafeStoreI64(address, value)
        if (name == "ablaUnsafeStorePointer") {
            ablaUnsafeStorePointer(address, nativePointerFromAddress(value))
        }
    } else if (name == "ablaUnsafeNullPointer") {
        result = bootstrapEvalInteger(0)
    } else if (name == "ablaUnsafePointerIsNull") {
        result = bootstrapEvalBoolean(
            ctNativeArgument(evaluator, expression, 0) == 0
        )
    } else if (name == "ablaUnsafePointerOffset") {
        val base = ctNativeArgument(evaluator, expression, 0)
        result = bootstrapEvalInteger(
            base + ctNativeArgument(evaluator, expression, 1)
        )
    } else if (name == "ablaUnsafePointerAddress" ||
               name == "ablaRuntimePointerFromAddress" ||
               name == "ablaRuntimePointerAddress") {
        result = bootstrapEvalInteger(ctNativeArgument(evaluator, expression, 0))
    } else if (name == "ablaUnsafeSetMemory") {
        // An empty fill may name no memory at all.
        val target = ctNativeValueArgument(evaluator, expression, 0)
        val value = ctNativeArgument(evaluator, expression, 1)
        val size = ctNativeArgument(evaluator, expression, 2)
        if (size > 0) {
            val address = ctNativeCheckedAddress(evaluator, target, name)
            if (address < 0) return bootstrapEvalInvalid()
            ablaUnsafeSetMemory(nativePointerFromAddress(address), value, size)
        }
    } else if (name == "ablaUnsafeCopyMemory") {
        // An empty copy may name no memory at all.
        val into = ctNativeValueArgument(evaluator, expression, 0)
        val origin = ctNativeValueArgument(evaluator, expression, 1)
        val size = ctNativeArgument(evaluator, expression, 2)
        if (size > 0) {
            val destination = ctNativeCheckedAddress(evaluator, into, name)
            if (destination < 0) return bootstrapEvalInvalid()
            val source = ctNativeCheckedAddress(evaluator, origin, name)
            if (source < 0) return bootstrapEvalInvalid()
            ablaUnsafeCopyMemory(destination, source, size)
        }
    } else if (name == "ablaUnsafeCStringAddress" ||
               name == "ablaUnsafeStringAddress") {
        val value = evaluator.evaluate(expression.children[0])
        if (value.kind == "string") {
            ctNativePin(value.text)
            result = bootstrapEvalInteger(
                if (name == "ablaUnsafeCStringAddress")
                    ablaUnsafeCStringAddress(value.text)
                else ablaUnsafeStringAddress(value.text)
            )
        } else {
            result = bootstrapEvalInvalid()
        }
    } else if (name == "ablaUnsafeAdoptString") {
        // The allocation came from this process's allocator (the evaluated
        // __ablaRuntimeAllocateLayout), so the string adopts it as a
        // program's would.
        val address = ctNativeArgument(evaluator, expression, 0)
        val length = ctNativeArgument(evaluator, expression, 1)
        result = bootstrapEvalString(
            ablaUnsafeAdoptString(nativePointerFromAddress(address), length)
        )
    } else if (name == "ablaUnsafeBorrowCString") {
        // The caller guarantees the bytes only for a while; the evaluator's
        // string may outlive that, so it gets a copy.
        val address = ctNativeAddressArgument(evaluator, expression, 0, name)
        if (address < 0) return bootstrapEvalInvalid()
        result = bootstrapEvalString(ctNativeCopyCString(address))
    } else if (name == "__ablaRuntimeAllocateLayout") {
        val size = ctNativeArgument(evaluator, expression, 0)
        val layout = ctNativeArgument(evaluator, expression, 1)
        result = bootstrapEvalInteger(__ablaRuntimeAllocateLayout(size, layout))
    } else if (name == "__ablaRuntimeAllocate") {
        result = bootstrapEvalInteger(__ablaRuntimeAllocate(
            ctNativeArgument(evaluator, expression, 0)
        ))
    } else if (name == "__ablaRuntimeStringWriteVectors") {
        // The iovecs a vectored write sends `value` from at `offset`: the
        // evaluator's string is one piece, so one vector (the runtime walks a
        // rope's pieces with the pending stack instead). The string is pinned
        // while the write uses its bytes.
        val value = evaluator.evaluate(expression.children[0])
        val vectors = ctNativeArgument(evaluator, expression, 1)
        val maximum = ctNativeArgument(evaluator, expression, 3)
        val offset = ctNativeArgument(evaluator, expression, 4)
        if (value.kind != "string") {
            result = bootstrapEvalInvalid()
        } else if (maximum <= 0 || offset < 0 || offset > value.text.size) {
            result = bootstrapEvalInteger(-22)
        } else if (offset == value.text.size) {
            result = bootstrapEvalInteger(0)
        } else {
            ctNativePin(value.text)
            ablaUnsafeStoreI64(nativePointerFromAddress(vectors),
                ablaUnsafeStringAddress(value.text) + offset)
            ablaUnsafeStoreI64(nativePointerFromAddress(vectors + 8),
                value.text.size - offset)
            result = bootstrapEvalInteger(1)
        }
    } else if (name == "__ablaRuntimeFree") {
        __ablaRuntimeFree(ctNativeArgument(evaluator, expression, 0))
    } else if (name == "__ablaRuntimePlatformMemorySetLayout") {
        val address = ctNativeArgument(evaluator, expression, 0)
        val layout = ctNativeArgument(evaluator, expression, 1)
        __ablaRuntimePlatformMemorySetLayout(address, layout)
    } else if (name == "ablaUnsafeAtomicFetchAddI64") {
        val address = ctNativeAddressArgument(evaluator, expression, 0, name)
        if (address < 0) return bootstrapEvalInvalid()
        val delta = ctNativeArgument(evaluator, expression, 1)
        result = bootstrapEvalInteger(ablaUnsafeAtomicFetchAddI64(
            nativePointerFromAddress(address), delta
        ))
    } else if (name == "ablaUnsafeAtomicCompareExchangeU32" ||
               name == "ablaUnsafeAtomicCompareExchangeRelaxedU32") {
        val address = ctNativeAddressArgument(evaluator, expression, 0, name)
        if (address < 0) return bootstrapEvalInvalid()
        val expected = u32(ctNativeArgument(evaluator, expression, 1))
        val replacement = u32(ctNativeArgument(evaluator, expression, 2))
        val observed = if (name == "ablaUnsafeAtomicCompareExchangeU32")
            ablaUnsafeAtomicCompareExchangeU32(address, expected, replacement)
        else ablaUnsafeAtomicCompareExchangeRelaxedU32(
            address, expected, replacement
        )
        result = bootstrapEvalInteger(i64(observed))
    } else if (name == "ablaUnsafeAtomicFence") {
        ablaUnsafeAtomicFence()
    } else if (name == "ablaRuntimeAtomicLoadI64") {
        val address = ctNativeAddressArgument(evaluator, expression, 0, name)
        if (address < 0) return bootstrapEvalInvalid()
        result = bootstrapEvalInteger(ablaRuntimeAtomicLoadI64(address))
    } else if (name == "ablaRuntimeAtomicStoreI64") {
        val address = ctNativeAddressArgument(evaluator, expression, 0, name)
        if (address < 0) return bootstrapEvalInvalid()
        ablaRuntimeAtomicStoreI64(address, ctNativeArgument(evaluator, expression, 1))
    } else if (name == "ablaRuntimeAtomicCompareExchangeI64") {
        val address = ctNativeAddressArgument(evaluator, expression, 0, name)
        if (address < 0) return bootstrapEvalInvalid()
        val expected = ctNativeArgument(evaluator, expression, 1)
        val replacement = ctNativeArgument(evaluator, expression, 2)
        result = bootstrapEvalInteger(
            ablaRuntimeAtomicCompareExchangeI64(address, expected, replacement)
        )
    } else if (name == "ablaRuntimeAtomicFetchAddI64") {
        val address = ctNativeAddressArgument(evaluator, expression, 0, name)
        if (address < 0) return bootstrapEvalInvalid()
        val delta = ctNativeArgument(evaluator, expression, 1)
        result = bootstrapEvalInteger(ablaRuntimeAtomicFetchAddI64(address, delta))
    } else if (name == "ablaRuntimeFence") {
        ablaRuntimeFence()
    } else if (name == "ablaRuntimeFenceAcquire") {
        ablaRuntimeFenceAcquire()
    } else if (name == "ablaRuntimeFenceRelease") {
        ablaRuntimeFenceRelease()
    } else if (name == "nativeStackAllocate") {
        // A frame's stack storage at run time; the evaluator's frames are not
        // native ones, so it lives in a platform allocation instead.
        result = bootstrapEvalInteger(__ablaRuntimeAllocateLayout(
            ctNativeArgument(evaluator, expression, 0), 10
        ))
    } else if (name == "ablaHostOwnsRuntime") {
        // `#` code runs on the compiler's host.
        result = bootstrapEvalBoolean(!ablaHostIsMacOS())
    } else if (name == "ablaHostIsIOS") {
        // The compiler runs on Linux/macOS; iOS supports static libraries,
        // not the compiler/JIT. Avoid requiring the new intrinsic in the
        // pinned bootstrap compiler that builds this handler.
        result = bootstrapEvalBoolean(false)
    } else if (name == "ablaHostIsMacOS") {
        // `#` code runs on the compiler's host.
        result = bootstrapEvalBoolean(ablaHostIsMacOS())
    } else if (name == "ablaHostValueArgumentsIndirect") {
        result = bootstrapEvalBoolean(ablaHostValueArgumentsIndirect())
    } else if (name == "nativeStaticAllocate") {
        // A program's zeroed static storage; under `#` it lasts for the
        // compilation (an evaluation that runs again gets storage of its own).
        val capacity = ctNativeArgument(evaluator, expression, 0)
        val rounded = (if (capacity > 0) capacity else 1) + 7
        val storage = __ablaRuntimeAllocateLayout(rounded / 8 * 8, 10)
        ablaUnsafeSetMemory(nativePointerFromAddress(storage), 0, rounded / 8 * 8)
        result = bootstrapEvalInteger(storage)
    } else if (name == "nativeThreadLocalBytes" || name == "nativeStaticBytes" ||
               name == "nativeStaticMutableBytes") {
        // A program's thread-local object, or its static bytes (read-only or writable), one per call site, holding
        // the given bytes. Compile-time code runs on one thread, so each site's object is made once and lasts for the
        // compilation, as a static object lasts for the program. (nativeStaticBytes was missing: ML-KEM's tables
        // failed under the interpreter.)
        val site = "$name:${evaluator.sourceIdentity}:${expression.begin}"
        val known = ctNativeThreadLocals.get(site)
        var storage = if (known != null) known else 0
        if (storage == 0) {
            val contents = if (expression.children.size > 0)
                bootstrapEvalUnwrapBorrow(evaluator.evaluate(expression.children[0])).text else ""
            storage = __ablaRuntimeAllocateLayout((contents.size + 8) / 8 * 8, 10)
            ablaUnsafeSetMemory(nativePointerFromAddress(storage), 0, (contents.size + 8) / 8 * 8)
            var index = 0
            while (index < contents.size) {
                ablaUnsafeStoreU8(nativePointerFromAddress(storage + index), contents[index])
                index = index + 1
            }
            ctNativeThreadLocals.set(site, storage)
        }
        result = bootstrapEvalInteger(storage)
    } else if (name == "ablaUnsafeCallVoid0") {
        val function = ctNativeAddressArgument(evaluator, expression, 0, name)
        if (function < 0) return bootstrapEvalInvalid()
        ablaUnsafeCallVoid0(function)
    } else if (name == "ablaUnsafeCallI32") {
        val function = ctNativeAddressArgument(evaluator, expression, 0, name)
        if (function < 0) return bootstrapEvalInvalid()
        result = bootstrapEvalInteger(ablaUnsafeCallI32(function))
    } else if (name == "ablaUnsafeCallVoidPointer3") {
        val address = ctNativeAddressArgument(evaluator, expression, 0, name)
        if (address < 0) return bootstrapEvalInvalid()
        val first = ctNativeArgument(evaluator, expression, 1)
        val second = ctNativeArgument(evaluator, expression, 2)
        val third = ctNativeArgument(evaluator, expression, 3)
        ablaUnsafeCallVoidPointer3(
            address,
            nativePointerFromAddress(first),
            nativePointerFromAddress(second),
            nativePointerFromAddress(third)
        )
    } else if (name == "ablaLinuxSyscall") {
        val number = ctNativeArgument(evaluator, expression, 0)
        val argument0 = ctNativeArgument(evaluator, expression, 1)
        val argument1 = ctNativeArgument(evaluator, expression, 2)
        val argument2 = ctNativeArgument(evaluator, expression, 3)
        val argument3 = ctNativeArgument(evaluator, expression, 4)
        val argument4 = ctNativeArgument(evaluator, expression, 5)
        val argument5 = ctNativeArgument(evaluator, expression, 6)
        result = bootstrapEvalInteger(ablaLinuxSyscall(
            number, argument0, argument1, argument2,
            argument3, argument4, argument5
        ))
        // A call the time limit's alarm interrupted (EINTR) or that just ran long ends the site here.
        if (ctNativeDeadline != 0 && ctNativeDeadlinePassed(evaluator, expression)) return bootstrapEvalInvalid()
    } else if (name == "ablaLinuxArgumentCount" || name == "ablaLinuxArgument") {
        // A compile-time evaluation is a program run with no arguments (not
        // the compiler's): no count, no program path.
        val _unused = ctNativeArgument(evaluator, expression, 0)
        result = if (name == "ablaLinuxArgumentCount") bootstrapEvalInteger(0)
            else bootstrapEvalString("")
    } else if (name == "ablaLinuxEnvironmentPointer") {
        result = bootstrapEvalInteger(
            nativePointerAddress(ablaLinuxEnvironmentPointer())
        )
    }
    result
}

// Fixed-width integer conversions (`i32(x)`, `u8(x)`, …) of an integer:
// the compiler's own conversion, so a value wraps as it does in a program.
fun ctNativeScalarConversion(name: string): bool =
    name == "i8" || name == "i16" || name == "i32" || name == "i64" ||
    name == "u8" || name == "u16" || name == "u32" || name == "u64"

@noinline
fun ctNativeEvaluateScalarConversion(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression,
    name: string
): BootstrapEvalValue {
    if (expression.children.size != 1) return bootstrapEvalInvalid()
    val value = evaluator.evaluate(expression.children[0])
    if (value.kind != "integer") return bootstrapEvalInvalid()
    val x = value.integer
    bootstrapEvalInteger(
        if (name == "i8") i64(i8(x))
        else if (name == "i16") i64(i16(x))
        else if (name == "i32") i64(i32(x))
        else if (name == "u8") i64(u8(x))
        else if (name == "u16") i64(u16(x))
        else if (name == "u32") i64(u32(x))
        else x
    )
}

// ---- extern:"c" ----

// A C ABI type of an extern:"c" parameter or result, as the LLVM backend
// lowers it (bootstrapLlvmNativeType): "" when unsupported.
fun ctNativeLlvmType(type: string): string =
    if (type == "i8" || type == "u8" || type == "char") "i8"
    else if (type == "i16" || type == "u16") "i16"
    else if (type == "i32" || type == "u32") "i32"
    else if (type == "i64" || type == "u64") "i64"
    else if (type == "f32") "float"
    else if (type == "f64") "double"
    else if (type == "bool") "i1"
    else if (type == "cstring" || ctNativeIsPointerType(type)) "ptr"
    else if (type == "void") "void"
    else ""

fun ctNativeIsPointerType(type: string): bool =
    type.size > 1 && type[type.size - 1] == 42 &&
    !bootstrapTextContains(type, ":") && !bootstrapTextContains(type, "(") &&
    !bootstrapTextContains(type, "<")

fun ctNativeUnsigned(type: string): bool =
    type == "char" || type == "u8" || type == "u16" || type == "u32" ||
    type == "u64"

fun ctNativeRuntimeType(
    declarations: array<BootstrapDeclaration>,
    type: string
): string {
    val normalized = bootstrapNormalizeType(type)
    val underlying = bootstrapScalarTypeUnderlying(declarations, normalized)
    if (underlying == "") normalized else underlying
}

// The thunk for one signature: `void thunk(ptr fn, ptr words, ptr result)`
// loads each argument from its word, calls `fn` with the declared C types and
// stores the result widened to a word (sign- or zero-extended by its type).
fun ctNativeThunkSource(
    symbol: string,
    parameterTypes: array<string>,
    resultType: string
): string {
    var body = ""
    val arguments: array<string> = []
    var index = 0
    while (index < parameterTypes.size) {
        val type = parameterTypes[index]
        val llvm = ctNativeLlvmType(type)
        body =
            "$body  %w$index.p = getelementptr i64, ptr %words, i64 $index\n  %w$index = load i64, ptr %w$index.p\n"
        if (llvm == "i64") {
            arguments.append("i64 %w$index")
        } else if (llvm == "i8" || llvm == "i16" || llvm == "i32" ||
                   llvm == "i1") {
            body = "$body  %a$index = trunc i64 %w$index to $llvm\n"
            arguments.append("$llvm %a$index")
        } else if (llvm == "double") {
            body = "$body  %a$index = bitcast i64 %w$index to double\n"
            arguments.append("double %a$index")
        } else if (llvm == "float") {
            body =
                "$body  %b$index = trunc i64 %w$index to i32\n  %a$index = bitcast i32 %b$index to float\n"
            arguments.append("float %a$index")
        } else {
            body = "$body  %a$index = inttoptr i64 %w$index to ptr\n"
            arguments.append("ptr %a$index")
        }
        index = index + 1
    }
    var list = ""
    index = 0
    while (index < arguments.size) {
        list = if (index == 0) arguments[index] else "$list, ${arguments[index]}"
        index = index + 1
    }
    val result = ctNativeLlvmType(resultType)
    if (result == "void") {
        body = "$body  call void %fn($list)\n  store i64 0, ptr %result\n"
    } else {
        body = "$body  %r = call $result %fn($list)\n"
        if (result == "i64") {
            body = "$body  store i64 %r, ptr %result\n"
        } else if (result == "i8" || result == "i16" || result == "i32" ||
                   result == "i1") {
            val extend = if (result == "i1" || ctNativeUnsigned(resultType))
                "zext" else "sext"
            body = "$body  %rw = $extend $result %r to i64\n  store i64 %rw, ptr %result\n"
        } else if (result == "double") {
            body = "$body  %rw = bitcast double %r to i64\n  store i64 %rw, ptr %result\n"
        } else if (result == "float") {
            body =
                "$body  %rb = bitcast float %r to i32\n  %rw = zext i32 %rb to i64\n  store i64 %rw, ptr %result\n"
        } else {
            body = "$body  %rw = ptrtoint ptr %r to i64\n  store i64 %rw, ptr %result\n"
        }
    }
    "define void @$symbol(ptr %fn, ptr %words, ptr %result) {\nentry:\n$body  ret void\n}\n"
}

// The thunk's address for a signature (compiled on first use), or a negative
// JIT status.
fun ctNativeThunk(parameterTypes: array<string>, resultType: string): int {
    var key = "$resultType("
    var index = 0
    while (index < parameterTypes.size) {
        key = "$key${parameterTypes[index]},"
        index = index + 1
    }
    index = 0
    while (index < ctNativeThunkKeys.size) {
        if (ctNativeThunkKeys[index] == key) return ctNativeThunkAddresses[index]
        index = index + 1
    }
    if (ctNativeSessions.size == 0) {
        ctNativeSessions.append(llvmOrcCreateSession())
    }
    val session = ctNativeSessions[0]
    if (session.status != 0) return -session.status
    val symbol = "abla_ct_native_thunk_${ctNativeThunkKeys.size}"
    val generation = session.addText(
        symbol, ctNativeThunkSource(symbol, parameterTypes, resultType)
    )
    if (generation.status != 0) return -generation.status
    val lookup = session.lookup(symbol)
    if (lookup.status != 0) return -lookup.status
    ctNativeThunkKeys.append(key)
    ctNativeThunkAddresses.append(lookup.address)
    lookup.address
}

// ---- native libraries ----

fun ctNativeRootManifest(entry: string): string {
    var directory = Path(entry).parent()
    var result = directory.child("abla.toml")
    var searching = !result.exists()
    var depth = 0
    while (searching && depth < 128) {
        val parent = directory.parent()
        if (parent.text == directory.text) searching = false
        directory = parent
        val candidate = directory.child("abla.toml")
        if (candidate.exists()) {
            result = candidate
            searching = false
        }
        depth = depth + 1
    }
    result.text
}

// The strings of the manifest's `nativeLibraries = [...]` array.
fun ctNativeManifestNames(source: string): array<string> {
    val names: array<string> = []
    val key = "nativeLibraries"
    var cursor = -1
    var lineBegin = 0
    while (cursor < 0 && lineBegin < source.size) {
        var lineEnd = lineBegin
        while (lineEnd < source.size && source[lineEnd] != 10) lineEnd = lineEnd + 1
        var begin = lineBegin
        while (begin < lineEnd && (source[begin] == 32 || source[begin] == 9)) {
            begin = begin + 1
        }
        if (begin + key.size <= lineEnd && source.slice(begin, begin + key.size) == key) {
            var index = begin + key.size
            while (index < lineEnd && (source[index] == 32 || source[index] == 9)) {
                index = index + 1
            }
            if (index < lineEnd && source[index] == 61) {
                index = index + 1
                while (index < lineEnd && (source[index] == 32 || source[index] == 9)) {
                    index = index + 1
                }
                if (index < lineEnd && source[index] == 91) cursor = index + 1
            }
        }
        lineBegin = lineEnd + 1
    }
    var complete = cursor < 0
    while (!complete && cursor < source.size) {
        val byte = source[cursor]
        if (byte == 93) {
            complete = true
        } else if (byte == 34) {
            var end = cursor + 1
            while (end < source.size && source[end] != 34 && source[end] != 10) {
                end = end + 1
            }
            if (end < source.size && source[end] == 34) {
                names.append(source.slice(cursor + 1, end))
                cursor = end + 1
            } else complete = true
        } else if (byte == 35) {
            while (cursor < source.size && source[cursor] != 10) cursor = cursor + 1
        } else {
            cursor = cursor + 1
        }
    }
    names
}

fun ctNativeLibraryNameValid(name: string): bool {
    var valid = name.size > 0 && name.size <= 128
    var index = 0
    while (valid && index < name.size) {
        val byte = name[index]
        valid = (byte >= 48 && byte <= 57) || (byte >= 65 && byte <= 90) ||
            (byte >= 97 && byte <= 122) ||
            byte == 43 || byte == 45 || byte == 46 || byte == 95
        index = index + 1
    }
    valid
}

// The C runtime's own libraries: already in the compiler process.
fun ctNativeProcessLibrary(name: string): bool =
    name == "c" || name == "m" || name == "dl" || name == "pthread" ||
    name == "rt" || name == "util" || name == "System"

// Where `-l<name>` may find a library: LIBRARY_PATH (which the C compiler
// driver also passes to the linker), then the usual system directories.
fun ctNativeLibraryDirectories(): array<string> {
    val directories: array<string> = []
    val configured = linuxEnvironment("LIBRARY_PATH")
    if (configured.found) {
        var begin = 0
        var index = 0
        while (index <= configured.value.size) {
            if (index == configured.value.size || configured.value[index] == 58) {
                if (index > begin) {
                    directories.append(configured.value.slice(begin, index))
                }
                begin = index + 1
            }
            index = index + 1
        }
    }
    if (ablaHostIsMacOS()) {
        directories.append("/opt/homebrew/lib")
        directories.append("/usr/local/lib")
        directories.append("/usr/lib")
    } else {
        directories.append("/usr/local/lib")
        directories.append("/usr/lib/x86_64-linux-gnu")
        directories.append("/lib/x86_64-linux-gnu")
        directories.append("/usr/lib/aarch64-linux-gnu")
        directories.append("/lib/aarch64-linux-gnu")
        directories.append("/usr/lib64")
        directories.append("/lib64")
        directories.append("/usr/lib")
        directories.append("/lib")
    }
    directories
}

// Loads a library file; a GNU ld script (a Linux `lib<name>.so` may be one)
// loads the shared objects it names instead.
fun ctNativeLoadFile(path: string): bool {
    if (llvmLoadLibraryPermanently(path) == 0) return true
    var loaded = false
    val info = Path(path).info()
    if (info.size > 0 && info.size < 4096) {
        val script = Path(path).readText()
        if (bootstrapTextContains(script, "GROUP") ||
            bootstrapTextContains(script, "INPUT")) {
            var index = 0
            while (index < script.size) {
                if (script[index] == 47) {
                    var end = index
                    while (end < script.size && script[end] != 32 &&
                           script[end] != 41 && script[end] != 10 &&
                           script[end] != 9) end = end + 1
                    val candidate = script.slice(index, end)
                    if (bootstrapTextContains(candidate, ".so") &&
                        llvmLoadLibraryPermanently(candidate) == 0) loaded = true
                    index = end
                } else {
                    index = index + 1
                }
            }
        }
    }
    loaded
}

// The path a library was loaded from ("" when not found).
fun ctNativeLoadLibrary(name: string, directories: array<string>): string {
    val file = if (ablaHostIsMacOS()) "lib$name.dylib" else "lib$name.so"
    var loaded = ""
    var index = 0
    while (loaded == "" && index < directories.size) {
        val candidate = "${directories[index]}/$file"
        if (Path(candidate).exists() && ctNativeLoadFile(candidate)) {
            loaded = candidate
        }
        index = index + 1
    }
    // The dynamic loader's own search (its configured paths, and on Darwin the
    // shared cache that holds the system libraries).
    if (loaded == "" && llvmLoadLibraryPermanently(file) == 0) loaded = file
    loaded
}

// Loads the root manifest's nativeLibraries for the current entry (once per
// entry; a library stays loaded for the life of the process).
fun ctNativePrepareLibraries(): void {
    if (ctNativeLibrariesReady && ctNativeLibrariesEntry == ctNativeEntryPath) {
        return
    }
    ctNativeLibrariesReady = true
    ctNativeLibrariesEntry = ctNativeEntryPath
    ctNativeLoadedLibraries = []
    ctNativeLoadedLibraryPaths = []
    ctNativeMissingLibraries = []
    if (ctNativeEntryPath == "") return
    val manifest = ctNativeRootManifest(ctNativeEntryPath)
    if (!Path(manifest).exists()) return
    val names = ctNativeManifestNames(Path(manifest).readText())
    val directories = ctNativeLibraryDirectories()
    var searched = ""
    var index = 0
    while (index < directories.size) {
        searched = if (index == 0) directories[index]
            else "$searched, ${directories[index]}"
        index = index + 1
    }
    ctNativeSearchedDirectories = searched
    index = 0
    while (index < names.size && index < 32) {
        val name = names[index]
        if (ctNativeLibraryNameValid(name) && !ctNativeProcessLibrary(name)) {
            val loaded = ctNativeLoadLibrary(name, directories)
            if (loaded != "") {
                ctNativeLoadedLibraries.append(name)
                ctNativeLoadedLibraryPaths.append(loaded)
            } else {
                ctNativeMissingLibraries.append(name)
            }
        }
        index = index + 1
    }
}

// The JIT tier's libraries for a slice program: the root manifest's
// nativeLibraries, loaded, when the program holds the trusted.native grant
// (none otherwise, so nothing outside the process resolves without it).
fun bootstrapCtNativeLibraries(parsed: BootstrapParseResult): array<string> {
    val grants = bootstrapBuildCompileEffectGrants(
        bootstrapBuildCompileEffectRequests(parsed),
        bootstrapBuildCompileEffectAuthorizations(parsed)
    )
    if (!bootstrapCompileEffectHas(grants, 512)) return []
    ctNativePrepareLibraries()
    val paths: array<string> = []
    for (path in ctNativeLoadedLibraryPaths) paths.append(path)
    paths
}

// A symbol in the process's global scope: the executable, its libraries and
// those loaded globally since (RTLD_LAZY is 1 on Darwin and Linux). Linux asks
// LLVM, so the compiler imports no dlopen or dlsym itself (#806; libLLVM still
// does, until the compiler stops linking it). LLVM only searches libraries it
// loaded: the empty name is the running program's own handle (dlopen("")), whose
// scope is the executable and what it links, loaded once.
var ctNativeProcessScopeLoaded: bool = false

trusted fun ctNativeProcessSymbol(name: string): int {
    if (ablaHostIsMacOS()) return nativePointerAddress(dlsym(dlopen(nativeNullPointer(), 1), name))
    if (!ctNativeProcessScopeLoaded) {
        llvmLoadLibraryPermanently("")
        ctNativeProcessScopeLoaded = true
    }
    llvmSearchForAddressOfSymbol(name)
}

// The address of a C symbol (0 when absent): the compiler process, then the
// libraries loaded for the root manifest.
fun ctNativeSymbol(name: string): int {
    var index = 0
    while (index < ctNativeSymbolNames.size) {
        if (ctNativeSymbolNames[index] == name) return ctNativeSymbolAddresses[index]
        index = index + 1
    }
    ctNativePrepareLibraries()
    var address = ctNativeProcessSymbol(name)
    if (address == 0) address = llvmSearchForAddressOfSymbol(name)
    if (address != 0) {
        ctNativeSymbolNames.append(name)
        ctNativeSymbolAddresses.append(address)
    }
    address
}

// Why `name` did not resolve (the message of E_COMPILE_NATIVE_SYMBOL).
fun ctNativeMissingSymbolMessage(name: string): string {
    var detail = ""
    var index = 0
    while (index < ctNativeMissingLibraries.size) {
        detail = if (index == 0) ctNativeMissingLibraries[index]
            else "$detail, ${ctNativeMissingLibraries[index]}"
        index = index + 1
    }
    if (detail != "") {
        detail =
            "; nativeLibraries not found: $detail (searched $ctNativeSearchedDirectories and the dynamic loader's paths)"
    }
    // The statically linked compiler (#806 step C) answers dlsym from a table of its own C library and loads no shared object.
    if (!ablaHostIsMacOS() && ctNativeProcessSymbol("ablac_static_libc") != 0) {
        detail = "$detail; this compiler is statically linked and loads no shared object, so nativeLibraries and dlopen of a library are not available in it"
    }
    "compile-time call to extern:\"c\" `$name`: the symbol is in neither the compiler process nor a library of the root manifest's nativeLibraries$detail"
}

fun ctNativeMissingSymbol(var evaluator: BootstrapEvaluator, name: string): BootstrapEvalValue {
    evaluator.errors = evaluator.errors + 1
    evaluator.recordEvaluatorDiagnostic(
        "E_COMPILE_NATIVE_SYMBOL", ctNativeMissingSymbolMessage(name)
    )
    bootstrapEvalInvalid()
}

// For the JIT tier, before a slice is added: an error line per extern:"c"
// declaration of `declarations` whose symbol does not resolve ("" when all do),
// instead of ORC's materialization failure.
fun bootstrapCtNativeCheckSymbols(declarations: array<BootstrapDeclaration>): string {
    var diagnostics = ""
    for (declaration in declarations) {
        if (declaration.kind == "extern" && declaration.externalLibrary == "c") {
            val name = bootstrapCanonicalDeclarationSourceName(declaration.name)
            if (ctNativeSymbol(name) == 0) {
                diagnostics =
                    "${diagnostics}error[E_COMPILE_NATIVE_SYMBOL]: ${ctNativeMissingSymbolMessage(name)}\n"
            }
        }
    }
    diagnostics
}

// Evaluates a call to an extern:"c" declaration by calling the C function.
@noinline
trusted fun ctNativeEvaluateExternCall(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression,
    declaration: BootstrapDeclaration
): BootstrapEvalValue {
    val name = bootstrapCanonicalDeclarationSourceName(declaration.name)
    if (ctNativeTrialStop(evaluator, "extern:\"c\" `$name`")) return bootstrapEvalInvalid()
    if (!ctNativeAllowed(evaluator, 512)) {
        return ctNativeDenied(evaluator, "call to extern:\"c\" `$name`", 512)
    }
    // No C call once the evaluation has failed (its arguments are made-up values: see ctNativeEvaluateIntrinsic).
    if (evaluator.errors > 0) return bootstrapEvalInvalid()
    // A non-local jump can't cross the interpreter: its buffer would name a frame of the compiler's own
    // stack, or none. (The runtime's panic recovery ends in _longjmp.)
    if (name == "_longjmp" || name == "longjmp" || name == "siglongjmp" || name == "_setjmp" ||
        name == "setjmp" || name == "sigsetjmp") {
        evaluator.errors = evaluator.errors + 1
        evaluator.recordEvaluatorDiagnostic(
            "E_COMPILE_NATIVE_JUMP",
            "compile-time call to extern:\"c\" `$name`: a non-local jump can't run in the compile-time interpreter (ABLA_COMPILE_EVAL=jit runs it natively)"
        )
        return bootstrapEvalInvalid()
    }
    val parameterTypes: array<string> = []
    var supported = true
    var index = 0
    while (index < declaration.parameterTypes.size) {
        val type = ctNativeRuntimeType(
            evaluator.declarations, declaration.parameterTypes[index]
        )
        if (ctNativeLlvmType(type) == "" || type == "void") supported = false
        parameterTypes.append(type)
        index = index + 1
    }
    val resultType = ctNativeRuntimeType(evaluator.declarations, declaration.resultType)
    if (ctNativeLlvmType(resultType) == "" || resultType == "cstring") {
        supported = false
    }
    if (!supported || expression.children.size != parameterTypes.size) {
        evaluator.errors = evaluator.errors + 1
        evaluator.recordEvaluatorDiagnostic(
            "E_COMPILE_NATIVE_SIGNATURE",
            "compile-time call to extern:\"c\" `$name` has a signature the C call bridge does not support (scalars, bool, f32/f64, pointers and cstring parameters; no cstring result)"
        )
        return bootstrapEvalInvalid()
    }
    val function = ctNativeSymbol(name)
    if (function == 0) return ctNativeMissingSymbol(evaluator, name)
    val thunk = ctNativeThunk(parameterTypes, resultType)
    if (thunk <= 0) {
        evaluator.errors = evaluator.errors + 1
        evaluator.recordEvaluatorDiagnostic(
            "E_COMPILE_NATIVE_JIT",
            "compile-time call to extern:\"c\" `$name`: compiling its call thunk failed (ORC status ${-thunk})"
        )
        return bootstrapEvalInvalid()
    }
    val words = nativeByteBuffer(if (parameterTypes.size == 0) 8 else parameterTypes.size * 8)
    val temporaries: array<int> = []
    var valid = true
    index = 0
    while (index < parameterTypes.size) {
        val value = evaluator.evaluate(expression.children[index])
        var word = 0
        if (parameterTypes[index] == "cstring") {
            if (value.kind == "string") {
                word = ctNativeCString(value.text)
                temporaries.append(word)
            } else valid = false
        } else if (value.kind == "integer" || value.kind == "boolean" ||
                   value.kind == "f64" || value.kind == "f32") {
            word = ctNativeWord(value)
        } else if (value.kind == "null") {
            word = 0
        } else valid = false
        words.storeI64(index * 8, word)
        index = index + 1
    }
    var result = bootstrapEvalInvalid()
    // An argument that failed to evaluate leaves a made-up word: no call.
    if (evaluator.errors > 0) valid = false
    if (valid) {
        val output = nativeI64Cell(0)
        ctNativeCallbackParents.append(
            bootstrapEvalInvocation(evaluator, [], [], [])
        )
        ablaUnsafeCallVoidPointer3(
            thunk,
            nativePointerFromAddress(function),
            words.address,
            output.address
        )
        val parent = ctNativeCallbackParents[ctNativeCallbackParents.size - 1]
        ctNativeCallbackParents.truncate(ctNativeCallbackParents.size - 1)
        evaluator.errors = parent.errors
        evaluator.steps = parent.steps
        evaluator.diagnostics = parent.diagnostics
        val word = output.load()
        output.close()
        if (ctNativeDeadline != 0 && ctNativeDeadlinePassed(evaluator, expression)) return bootstrapEvalInvalid()
        result = if (resultType == "void") bootstrapEvalVoid()
            else if (resultType == "bool") bootstrapEvalBoolean(word != 0)
            else if (resultType == "f64") BootstrapEvalValue("f64", word, false, "",
                BOOTSTRAP_EVAL_NO_ELEMENTS, "", BOOTSTRAP_EVAL_NO_FIELDS)
            else if (resultType == "f32") bootstrapEvalF32(ablaBitI32ToF32(word))
            else bootstrapEvalInteger(word)
    } else {
        evaluator.errors = evaluator.errors + 1
    }
    // A noescape declaration's temporary C strings live for the call, as a
    // compiled program's do; otherwise the callee may keep them.
    if (declaration.isNoEscape) {
        index = 0
        while (index < temporaries.size) {
            ctNativeFree(temporaries[index])
            index = index + 1
        }
    }
    words.close()
    result
}

// ---- callbacks: nativeFunctionAddress at compile time ----
//
// A compiled program's nativeFunctionAddress(f) is a C-ABI entry for f. At
// compile time f is evaluated, so its entry is a thunk compiled for f's
// signature that stores the arguments as words and calls
// ctNativeCallbackDispatch(slot, words), which evaluates f's body with the
// evaluator of the C call in progress (C code calls back during that call).

var ctNativeCallbackKeys: array<string> = []
var ctNativeCallbackAddresses: array<int> = []
var ctNativeCallbackDeclarations: array<BootstrapDeclaration> = []
// The evaluators of the extern:"c" calls in progress, innermost last.
var ctNativeCallbackParents: array<BootstrapEvaluator> = []

fun ctNativeCallbackValue(word: int, type: string): BootstrapEvalValue =
    if (type == "bool") bootstrapEvalBoolean(word != 0)
    else if (type == "f64") BootstrapEvalValue("f64", word, false, "", BOOTSTRAP_EVAL_NO_ELEMENTS,
        "", BOOTSTRAP_EVAL_NO_FIELDS)
    else if (type == "f32") bootstrapEvalF32(ablaBitI32ToF32(word))
    else bootstrapEvalInteger(word)

trusted fun ctNativeCallbackDispatch(slot: int, words: int): int {
    if (ctNativeCallbackParents.size == 0 || slot < 0 ||
        slot >= ctNativeCallbackDeclarations.size) return 0
    val top = ctNativeCallbackParents.size - 1
    var parent = ctNativeCallbackParents[top]
    val declaration = ctNativeCallbackDeclarations[slot]
    val names: array<string> = []
    val values: array<BootstrapEvalValue> = []
    val mutable: array<bool> = []
    var index = 0
    while (index < declaration.parameters.size) {
        names.append(declaration.parameters[index])
        values.append(ctNativeCallbackValue(
            ablaUnsafeLoadI64(nativePointerFromAddress(words + index * 8)),
            ctNativeRuntimeType(parent.declarations, declaration.parameterTypes[index])
        ))
        mutable.append(false)
        index = index + 1
    }
    val invocation = bootstrapEvalInvocation(parent, names, values, mutable)
    var result = invocation.evaluate(declaration.expression)
    if (result.kind == "return" && result.elements.size == 1) {
        result = result.elements[0]
    }
    parent.errors = invocation.errors
    parent.steps = invocation.steps
    parent.diagnostics = invocation.diagnostics
    ctNativeCallbackParents[top] = parent
    ctNativeWord(result)
}

trusted fun ctNativeCallbackDispatchAddress(): int =
    nativeFunctionAddress(ctNativeCallbackDispatch)

// The callback thunk: `R entry(P…)` stores each argument widened to a word
// and returns ctNativeCallbackDispatch(slot, words) narrowed to R.
fun ctNativeCallbackSource(
    symbol: string,
    slot: int,
    parameterTypes: array<string>,
    resultType: string
): string {
    val count = if (parameterTypes.size == 0) 1 else parameterTypes.size
    var parameters = ""
    var body = "  %words = alloca [$count x i64], align 8\n"
    var index = 0
    while (index < parameterTypes.size) {
        val type = parameterTypes[index]
        val llvm = ctNativeLlvmType(type)
        parameters = if (index == 0) "$llvm %p$index"
            else "$parameters, $llvm %p$index"
        body = "$body  %s$index = getelementptr i64, ptr %words, i64 $index\n"
        if (llvm == "i64") {
            body = "$body  store i64 %p$index, ptr %s$index\n"
        } else if (llvm == "i8" || llvm == "i16" || llvm == "i32" ||
                   llvm == "i1") {
            val extend = if (llvm == "i1" || ctNativeUnsigned(type)) "zext"
                else "sext"
            body =
                "$body  %w$index = $extend $llvm %p$index to i64\n  store i64 %w$index, ptr %s$index\n"
        } else if (llvm == "double") {
            body =
                "$body  %w$index = bitcast double %p$index to i64\n  store i64 %w$index, ptr %s$index\n"
        } else if (llvm == "float") {
            body =
                "$body  %b$index = bitcast float %p$index to i32\n  %w$index = zext i32 %b$index to i64\n  store i64 %w$index, ptr %s$index\n"
        } else {
            body =
                "$body  %w$index = ptrtoint ptr %p$index to i64\n  store i64 %w$index, ptr %s$index\n"
        }
        index = index + 1
    }
    val dispatch = ctNativeCallbackDispatchAddress()
    body =
        "$body  %address = ptrtoint ptr %words to i64\n  %dispatch = inttoptr i64 $dispatch to ptr\n  %r = call i64 %dispatch(i64 $slot, i64 %address)\n"
    val result = ctNativeLlvmType(resultType)
    if (result == "void") {
        body = "$body  ret void\n"
    } else if (result == "i64") {
        body = "$body  ret i64 %r\n"
    } else if (result == "i1") {
        body = "$body  %n = icmp ne i64 %r, 0\n  ret i1 %n\n"
    } else if (result == "i8" || result == "i16" || result == "i32") {
        body = "$body  %n = trunc i64 %r to $result\n  ret $result %n\n"
    } else if (result == "double") {
        body = "$body  %n = bitcast i64 %r to double\n  ret double %n\n"
    } else if (result == "float") {
        body = "$body  %t = trunc i64 %r to i32\n  %n = bitcast i32 %t to float\n  ret float %n\n"
    } else {
        body = "$body  %n = inttoptr i64 %r to ptr\n  ret ptr %n\n"
    }
    "define $result @$symbol($parameters) {\nentry:\n$body}\n"
}

@noinline
trusted fun ctNativeEvaluateFunctionAddress(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    if (!ctNativeAllowed(evaluator, 512)) {
        return ctNativeDenied(evaluator, "intrinsic `nativeFunctionAddress`", 512)
    }
    var name = ""
    if (expression.children.size == 1) {
        val reference = evaluator.evaluate(expression.children[0])
        if (reference.kind == "function") name = reference.text
    }
    var found = -1
    var index = 0
    while (found < 0 && index < evaluator.declarations.size) {
        val candidate = evaluator.declarations[index]
        if (candidate.name == name && candidate.kind == "fun" &&
            candidate.extensionOwner == "") found = index
        index = index + 1
    }
    val parameterTypes: array<string> = []
    var resultType = ""
    var supported = found >= 0
    if (supported) {
        val declaration = evaluator.declarations[found]
        index = 0
        while (index < declaration.parameterTypes.size) {
            val type = ctNativeRuntimeType(
                evaluator.declarations, declaration.parameterTypes[index]
            )
            // The scalar ABI nativeFunctionAddress takes in a compiled program.
            if (!bootstrapExportScalarTypeValid(type)) supported = false
            parameterTypes.append(type)
            index = index + 1
        }
        resultType = ctNativeRuntimeType(evaluator.declarations, declaration.resultType)
        if (resultType != "void" && !bootstrapExportScalarTypeValid(resultType)) {
            supported = false
        }
    }
    if (!supported) {
        evaluator.errors = evaluator.errors + 1
        evaluator.recordEvaluatorDiagnostic(
            "E_COMPILE_NATIVE_SIGNATURE",
            "compile-time nativeFunctionAddress needs a named top-level function with fixed-width integer, bool or f32/f64 parameters and result (got `$name`)"
        )
        return bootstrapEvalInvalid()
    }
    var key = "$name:$resultType("
    index = 0
    while (index < parameterTypes.size) {
        key = "$key${parameterTypes[index]},"
        index = index + 1
    }
    index = 0
    while (index < ctNativeCallbackKeys.size) {
        if (ctNativeCallbackKeys[index] == key) {
            return bootstrapEvalInteger(ctNativeCallbackAddresses[index])
        }
        index = index + 1
    }
    if (ctNativeSessions.size == 0) {
        ctNativeSessions.append(llvmOrcCreateSession())
    }
    val session = ctNativeSessions[0]
    val slot = ctNativeCallbackKeys.size
    val symbol = "abla_ct_native_callback_$slot"
    var status = session.status
    var address = 0
    if (status == 0) {
        val generation = session.addText(
            symbol, ctNativeCallbackSource(symbol, slot, parameterTypes, resultType)
        )
        status = generation.status
    }
    if (status == 0) {
        val lookup = session.lookup(symbol)
        status = lookup.status
        address = lookup.address
    }
    if (status != 0) {
        evaluator.errors = evaluator.errors + 1
        evaluator.recordEvaluatorDiagnostic(
            "E_COMPILE_NATIVE_JIT",
            "compile-time nativeFunctionAddress(`$name`): compiling its entry thunk failed (ORC status $status)"
        )
        return bootstrapEvalInvalid()
    }
    ctNativeCallbackKeys.append(key)
    ctNativeCallbackAddresses.append(address)
    ctNativeCallbackDeclarations.append(evaluator.declarations[found])
    bootstrapEvalInteger(address)
}

// ---- host providers: abla/platform/host at compile time ----
//
// The host API's functions are ordinary code in a program. At compile time
// the evaluator performs them with the compiler's own copy (the same source),
// under the capability each name implies; the semantic effect analysis gives
// them that capability instead of walking their bodies (which would demand
// trusted.native for the system calls inside).

// The function providers performed here, by name (ablaHostReadFile and
// ablaHostListDirectory are the evaluator's own, in bootstrapEvaluateCallHost).
fun ctNativeProviderName(name: string): bool =
    if (name.startsWith("ablaHost"))
        name != "ablaHostReadFile" && name != "ablaHostListDirectory" &&
        bootstrapCompileHostOperationEffect(name) >= 0
    else bootstrapCompileProviderEffect("io", "", name) >= 0 ||
        bootstrapCompileProviderEffect("time", "", name) >= 0 ||
        bootstrapCompileProviderEffect("exit", "", name) >= 0 ||
        name == "currentDirectory"

// The capability of the provider a call to `name` (receiver type `owner`, ""
// for a plain function) reaches, or -1 when it reaches anything else: every
// function of that name the program declares must be the provider.
fun ctNativeProviderTarget(var evaluator: BootstrapEvaluator, owner: string, name: string): int {
    var effect = -1
    var other = false
    var node = evaluator.firstNamed(name)
    while (node >= 0) {
        val declaration = evaluator.declarations[evaluator.namedDeclaration(node)]
        if (declaration.extensionOwner == owner &&
            (declaration.kind == "fun" || declaration.kind == "extern")) {
            val found = bootstrapCompileDeclarationProviderEffect(declaration)
            if (found >= 0) effect = found else other = true
        }
        node = evaluator.nextNamed(node)
    }
    if (other) -1 else effect
}

fun ctNativeValueText(values: array<BootstrapEvalValue>, index: int): string =
    if (index < values.size && values[index].kind == "string") values[index].text
    else ""

fun ctNativeValueTexts(values: array<BootstrapEvalValue>, index: int): array<string> {
    val texts: array<string> = []
    if (index < values.size && values[index].kind == "array") {
        for (element in values[index].elements) {
            if (element.kind == "string") texts.append(element.text)
        }
    }
    texts
}

fun ctNativeValueWord(values: array<BootstrapEvalValue>, index: int): int =
    if (index < values.size) ctNativeWord(values[index]) else 0

fun ctNativeValueFlag(values: array<BootstrapEvalValue>, index: int): bool =
    ctNativeValueWord(values, index) != 0

// The journal identities of the deterministic host observations besides file
// contents: what bootstrapCompileInputContents re-observes before a cached
// artifact is reused.
val CT_NATIVE_INPUT_PREFIXES = [
    "abla-input:file-kind:", "abla-input:file-size:",
    "abla-input:file-revision:", "abla-input:current-directory:",
    "abla-input:file-result:", "abla-input:symbolic-link:",
    "abla-input:entries:"
]

fun ctNativeHostInputPrefix(identity: string): string {
    for (prefix in CT_NATIVE_INPUT_PREFIXES) {
        if (identity.startsWith(prefix)) return prefix
    }
    ""
}

fun ctNativeHostInputContents(identity: string): string {
    val prefix = ctNativeHostInputPrefix(identity)
    val path = identity.slice(prefix.size, identity.size)
    if (prefix == "abla-input:file-kind:") "${ablaHostFileKind(path)}"
    else if (prefix == "abla-input:file-size:") "${ablaHostFileSize(path)}"
    else if (prefix == "abla-input:file-revision:") "${ablaHostFileRevision(path)}"
    else if (prefix ==
        "abla-input:file-result:") ctNativeReadResultText(Path(path).readTextResult())
    else if (prefix == "abla-input:symbolic-link:") "${Path(path).isSymbolicLink()}"
    else if (prefix == "abla-input:entries:") ctNativeEntryNames(path)
    else ablaHostCurrentDirectory()
}

@noinline
fun ctNativeEvaluateHost(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression,
    name: string
): BootstrapEvalValue {
    val effect = bootstrapCompileHostOperationEffect(name)
    if (!ctNativeAllowed(evaluator, effect)) {
        return ctNativeDenied(evaluator, "call to `$name`", effect)
    }
    val values: array<BootstrapEvalValue> = []
    for (child in expression.children) values.append(evaluator.evaluate(child))
    ctNativeHostCall(evaluator, name, values)
}

// Performs host provider `name` on evaluated arguments (for the interpreter
// and the JIT tier's bridge), after checking its capability.
fun ctNativeHostCall(
    var evaluator: BootstrapEvaluator,
    name: string,
    values: array<BootstrapEvalValue>
): BootstrapEvalValue {
    val effect = bootstrapCompileHostOperationEffect(name)
    if (!ctNativeAllowed(evaluator, effect)) {
        return ctNativeDenied(evaluator, "call to `$name`", effect)
    }
    val operation = name.slice(8, name.size)
    var result = bootstrapEvalVoid()
    if (operation == "FileKind" || operation == "FileSize" ||
        operation == "FileRevision") {
        val path = ctNativeValueText(values, 0)
        val staged = ctNativeStagedSlot(path) >= 0 || ctNativeStagedUnder(path)
        if (staged) {
            // The compile-time file view (ctNativeViewInfo).
            val info = ctNativeViewInfo(evaluator, path)
            result = bootstrapEvalInteger(ctNativeInfoField(
                info,
                if (operation == "FileKind") "kind" else if (operation ==
                    "FileSize") "size" else "revision"
            ))
        } else {
            val observed = if (operation == "FileKind") ablaHostFileKind(path)
                else if (operation == "FileSize") ablaHostFileSize(path)
                else ablaHostFileRevision(path)
            val kind = if (operation == "FileKind") "file-kind"
                else if (operation == "FileSize") "file-size" else "file-revision"
            evaluator.recordCompileInput("abla-input:$kind:$path", "$observed")
            result = bootstrapEvalInteger(observed)
        }
    } else if (operation == "CurrentDirectory") {
        val directory = ablaHostCurrentDirectory()
        evaluator.recordCompileInput("abla-input:current-directory:", directory)
        result = bootstrapEvalString(directory)
    } else if (operation == "WriteFile" || operation == "WriteFileAtomic") {
        // A real write, as at run time (#72).
        val path = ctNativeValueText(values, 0)
        val written = path != "" && (if (operation == "WriteFileAtomic")
            Path(path).writeTextAtomic(ctNativeValueText(values, 1))
            else Path(path).writeText(ctNativeValueText(values, 1)))
        if (operation == "WriteFileAtomic") result = bootstrapEvalBoolean(written)
    } else if (operation == "CreateParentDirectories" ||
               operation == "CreateDirectories") {
        val path = ctNativeValueText(values, 0)
        val directory = if (operation == "CreateDirectories") path else Path(path).parent().text
        val made = directory == "" || directory == "." || Path(directory).createDirectories()
        if (operation == "CreateDirectories") result = bootstrapEvalBoolean(made)
    } else if (operation == "MoveFile") {
        val source = ctNativeValueText(values, 0)
        val destination = ctNativeValueText(values, 1)
        result = bootstrapEvalBoolean(source != "" && destination != "" && Path(source).moveTo(Path(destination)))
    } else if (operation == "RemoveFile") {
        val path = ctNativeValueText(values, 0)
        result = bootstrapEvalBoolean(path != "" && Path(path).remove())
    } else if (operation == "ArgumentCount") {
        result = bootstrapEvalInteger(0)
    } else if (operation == "Argument") {
        result = bootstrapEvalString("")
    } else if (operation == "ReadStdinLine") {
        result = bootstrapEvalString(ablaHostReadStdinLine())
    } else if (operation == "StdinLineAvailable") {
        result = bootstrapEvalBoolean(ablaHostStdinLineAvailable())
    } else if (operation == "WriteStdout") {
        ablaHostWriteStdout(ctNativeValueText(values, 0))
    } else if (operation == "WriteStderr") {
        ablaHostWriteStderr(ctNativeValueText(values, 0))
    } else if (operation == "ProcessorCount") {
        result = bootstrapEvalInteger(ablaHostProcessorCount())
    } else if (operation == "RunProcess") {
        result = bootstrapEvalInteger(
            ablaHostRunProcess(ctNativeValueTexts(values, 0))
        )
    } else if (operation == "CaptureProcess") {
        result = bootstrapEvalString(
            ablaHostCaptureProcess(ctNativeValueTexts(values, 0))
        )
    } else if (operation == "StartProcess") {
        result = bootstrapEvalInteger(
            ablaHostStartProcess(ctNativeValueTexts(values, 0))
        )
    } else if (operation == "StartProcessConfigured") {
        val directory = ctNativeValueText(values, 0)
        val arguments = ctNativeValueTexts(values, 1)
        val names = ctNativeValueTexts(values, 2)
        val environmentValues = ctNativeValueTexts(values, 3)
        val output = ctNativeValueText(values, 4)
        result = bootstrapEvalInteger(ablaHostStartProcessConfigured(
            directory, arguments, names, environmentValues, output
        ))
    } else if (operation == "PollProcess") {
        result = bootstrapEvalInteger(
            ablaHostPollProcess(ctNativeValueWord(values, 0))
        )
    } else if (operation == "StopProcessTree" ||
               operation == "StopProcessGracefully") {
        val process = ctNativeValueWord(values, 0)
        val grace = ctNativeValueWord(values, 1)
        result = bootstrapEvalInteger(
            if (operation == "StopProcessTree") ablaHostStopProcessTree(process, grace)
            else ablaHostStopProcessGracefully(process, grace)
        )
    } else if (operation == "StopProcess") {
        result = bootstrapEvalInteger(
            ablaHostStopProcess(ctNativeValueWord(values, 0))
        )
    } else if (operation == "Sleep") {
        ablaHostSleep(ctNativeValueWord(values, 0))
    } else if (operation == "MonotonicMilliseconds") {
        result = bootstrapEvalInteger(ablaHostMonotonicMilliseconds())
    } else if (operation == "SecureRandom") {
        result = bootstrapEvalString(
            ablaHostSecureRandom(ctNativeValueWord(values, 0))
        )
    } else {
        result = ctNativeHostNetwork(evaluator, operation, values)
    }
    result
}

@noinline
fun ctNativeHostNetwork(
    var evaluator: BootstrapEvaluator,
    operation: string,
    values: array<BootstrapEvalValue>
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    if (operation == "NetConnect") {
        val host = ctNativeValueText(values, 0)
        val port = ctNativeValueWord(values, 1)
        val timeout = ctNativeValueWord(values, 2)
        result = bootstrapEvalInteger(ablaHostNetConnect(host, port, timeout))
    } else if (operation == "NetListen") {
        val host = ctNativeValueText(values, 0)
        val port = ctNativeValueWord(values, 1)
        val backlog = ctNativeValueWord(values, 2)
        val dualStack = ctNativeValueFlag(values, 3)
        result = bootstrapEvalInteger(ablaHostNetListen(host, port, backlog, dualStack))
    } else if (operation == "NetAccept" || operation == "NetLocalPort" ||
               operation == "NetClose") {
        val handle = ctNativeValueWord(values, 0)
        result = if (operation == "NetAccept") bootstrapEvalInteger(ablaHostNetAccept(handle))
            else if (operation == "NetLocalPort") bootstrapEvalInteger(ablaHostNetLocalPort(handle))
            else bootstrapEvalBoolean(ablaHostNetClose(handle))
    } else if (operation == "NetSetNonblocking") {
        val descriptor = ctNativeValueWord(values, 0)
        result = bootstrapEvalBoolean(ablaHostNetSetNonblocking(
            descriptor, ctNativeValueFlag(values, 1)
        ))
    } else if (operation == "NetRead" || operation == "NetUdpReceive") {
        val handle = ctNativeValueWord(values, 0)
        val maximum = ctNativeValueWord(values, 1)
        result = bootstrapEvalString(
            if (operation == "NetRead") ablaHostNetRead(handle, maximum)
            else ablaHostNetUdpReceive(handle, maximum)
        )
    } else if (operation == "NetWrite") {
        val handle = ctNativeValueWord(values, 0)
        val contents = ctNativeValueText(values, 1)
        result = bootstrapEvalInteger(ablaHostNetWrite(handle, contents))
    } else if (operation == "NetStatus") {
        result = bootstrapEvalInteger(ablaHostNetStatus())
    } else if (operation == "NetError") {
        result = bootstrapEvalInteger(ablaHostNetError())
    } else if (operation == "NetUdpBind") {
        val host = ctNativeValueText(values, 0)
        val port = ctNativeValueWord(values, 1)
        result = bootstrapEvalInteger(ablaHostNetUdpBind(
            host, port, ctNativeValueFlag(values, 2)
        ))
    } else if (operation == "NetUdpSend") {
        val descriptor = ctNativeValueWord(values, 0)
        val host = ctNativeValueText(values, 1)
        val port = ctNativeValueWord(values, 2)
        val contents = ctNativeValueText(values, 3)
        result = bootstrapEvalInteger(ablaHostNetUdpSend(descriptor, host, port, contents))
    } else if (operation == "NetSourceAddress") {
        result = bootstrapEvalString(ablaHostNetSourceAddress())
    } else if (operation == "NetSourcePort") {
        result = bootstrapEvalInteger(ablaHostNetSourcePort())
    } else if (operation == "NetPollerCreate") {
        result = bootstrapEvalInteger(ablaHostNetPollerCreate())
    } else if (operation == "NetPollerControl") {
        val poller = ctNativeValueWord(values, 0)
        val descriptor = ctNativeValueWord(values, 1)
        val readable = ctNativeValueFlag(values, 2)
        val writable = ctNativeValueFlag(values, 3)
        val operationCode = ctNativeValueWord(values, 4)
        result = bootstrapEvalBoolean(ablaHostNetPollerControl(
            poller, descriptor, readable, writable, operationCode
        ))
    } else if (operation == "NetPollerWait") {
        val poller = ctNativeValueWord(values, 0)
        val maximum = ctNativeValueWord(values, 1)
        val timeout = ctNativeValueWord(values, 2)
        result = bootstrapEvalString(ablaHostNetPollerWait(poller, maximum, timeout))
    }
    if (result.kind == "invalid") evaluator.errors = evaluator.errors + 1
    result
}

// ---- standard-library providers: abla/fs, abla/io, abla/process/time ----

fun ctNativePathValue(text: string): BootstrapEvalValue =
    bootstrapEvalObject("Path", ["text"], [bootstrapEvalString(text)])

fun ctNativePathText(value: BootstrapEvalValue): string {
    var text = ""
    var field = 0
    while (field < value.fieldNames.size) {
        if (value.fieldNames[field] == "text" && value.elements[field].kind == "string") {
            text = value.elements[field].text
        }
        field = field + 1
    }
    text
}

fun ctNativeEntryNames(path: string): string {
    var names = ""
    for (entry in Path(path).entries()) names = "$names${entry.name()}\n"
    names
}

fun ctNativeReadResultText(result: FileReadResult): string =
    "${result.succeeded}:${result.errorCode}:${result.text}"

// Performs a function provider (`effect` is its capability) on the call's
// arguments.
@noinline
fun ctNativeEvaluateProvider(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression,
    name: string,
    effect: int
): BootstrapEvalValue {
    if (ctNativeTrialStop(evaluator, "`$name`")) return bootstrapEvalInvalid()
    if (!ctNativeAllowed(evaluator, effect)) {
        return ctNativeDenied(evaluator, "call to `$name`", effect)
    }
    if (name.startsWith("ablaHost")) return ctNativeEvaluateHost(evaluator, expression, name)
    val values: array<BootstrapEvalValue> = []
    for (child in expression.children) values.append(evaluator.evaluate(child))
    var result = bootstrapEvalVoid()
    // Output goes to the compiler's own standard output and error.
    if (name == "print") print(ctNativeValueText(values, 0))
    else if (name == "println") println(ctNativeValueText(values, 0))
    else if (name == "eprint") eprint(ctNativeValueText(values, 0))
    else if (name == "eprintln") eprintln(ctNativeValueText(values, 0))
    else if (name == "readLine") result = bootstrapEvalString(readLine())
    else if (name == "currentDirectory") {
        val directory = currentDirectory().text
        evaluator.recordCompileInput("abla-input:current-directory:", directory)
        result = ctNativePathValue(directory)
    } else if (name == "sleep") {
        ctNativeSleepUntilDeadline(ctNativeValueWord(values, 0) * 1000000)
        if (ctNativeDeadline != 0 && ctNativeDeadlinePassed(evaluator, expression)) result = bootstrapEvalInvalid()
    } else if (name == "sleepNanoseconds") {
        val nanoseconds = ctNativeValueWord(values, 0)
        result = bootstrapEvalBoolean(nanoseconds >= 0 && ctNativeSleepUntilDeadline(nanoseconds))
        if (ctNativeDeadline != 0 && ctNativeDeadlinePassed(evaluator, expression)) result = bootstrapEvalInvalid()
    } else if (name == "monotonicNanoseconds") result = bootstrapEvalInteger(monotonicNanoseconds())
    else if (name == "monotonicMilliseconds") result = bootstrapEvalInteger(monotonicMilliseconds())
    else if (name == "realtimeNanoseconds") result = bootstrapEvalInteger(realtimeNanoseconds())
    else if (name == "realtimeMilliseconds") result = bootstrapEvalInteger(realtimeMilliseconds())
    // Stopping ends the evaluation, never the compiler: a panic is the error a
    // run-time panic with that message is, and `exit` a stop (the native tier's
    // reports are the same, ct_eval.ab bootstrapCtReportStop).
    else if (name == "panic") {
        val message = ctNativeValueText(values, 0)
        result = bootstrapEvalRuntimePanic(
            evaluator, bootstrapCompilePanicCode(message), message, expression
        )
    } else if (name == "exit") {
        result = bootstrapEvalRuntimePanic(
            evaluator, "E_CT_STOPPED",
            bootstrapCompileExitMessage("${ctNativeValueWord(values, 0)}"),
            expression
        )
    } else {
        evaluator.errors = evaluator.errors + 1
        result = bootstrapEvalInvalid()
    }
    result
}

// The slot of `path` among the outputs this compilation staged (-1: none).
fun ctNativeStagedSlot(path: string): int =
    if (bootstrapCompileOutputCount > 0 && bootstrapCompileOutputPathValid(path))
        bootstrapCompileOutputSlot(path)
    else -1

fun ctNativeStagedText(slot: int): string =
    Path("${bootstrapCompileOutputRoot()}/$slot.data").readText()

// ---- the compile-time file view ----
//
// Compile-time code's writes are real writes (#72), so what it reads is the
// disk. The only staged entries are the toolchain's own outputs
// (bootstrapStageToolchainOutput: sidecars, independent entries), published
// with the build: the view lays those over the disk. Disk observations are
// journaled as build inputs.

/** Whether a live staged path (a file or directory) lies under `path`. */
fun ctNativeStagedUnder(path: string): bool {
    if (bootstrapCompileOutputCount == 0 || !bootstrapCompileOutputPathValid(path)) return false
    val prefix = "$path/"
    var slot = 0
    while (slot < bootstrapCompileOutputCount) {
        val staged = bootstrapCompileOutputPath(slot)
        if (staged.startsWith(prefix) && bootstrapCompileOutputKind(slot) != "removed") return true
        slot = slot + 1
    }
    false
}

/** What `path` is in the view, as FileInfo's kind: 0 nothing, 1 a file, 2 a
 *  directory (the disk's other kinds as it says). */
fun ctNativeViewKind(var evaluator: BootstrapEvaluator, path: string): int {
    val slot = ctNativeStagedSlot(path)
    if (slot >= 0) {
        val kind = bootstrapCompileOutputKind(slot)
        return if (kind == "file") 1 else if (kind == "directory") 2 else 0
    }
    val observed = Path(path).info().kind
    evaluator.recordCompileInput("abla-input:file-kind:$path", "$observed")
    if (observed == 0 && ctNativeStagedUnder(path)) 2 else observed
}

/** `path`'s FileInfo in the view. */
fun ctNativeViewInfo(var evaluator: BootstrapEvaluator, path: string): BootstrapEvalValue {
    val slot = ctNativeStagedSlot(path)
    var kind = 0
    var size = 0
    var revision = 0
    var inode = 0
    var changed = 0
    if (slot >= 0) {
        val staged = bootstrapCompileOutputKind(slot)
        if (staged != "removed") {
            kind = if (staged == "file") 1 else 2
            if (staged == "file") size = ctNativeStagedText(slot).size
            revision = bootstrapCompileOutputRevision(slot)
        }
    } else {
        val info = Path(path).info()
        evaluator.recordCompileInput("abla-input:file-kind:$path", "${info.kind}")
        evaluator.recordCompileInput("abla-input:file-revision:$path", "${info.revision}")
        evaluator.recordCompileInput("abla-input:file-size:$path", "${info.size}")
        kind = info.kind
        size = info.size
        revision = info.revision
        inode = info.inode
        changed = info.changed
        if (kind == 0 && ctNativeStagedUnder(path)) kind = 2
    }
    bootstrapEvalObject(
        "FileInfo", ["path", "kind", "size", "revision", "inode", "changed"],
        [ctNativePathValue(path), bootstrapEvalInteger(kind),
         bootstrapEvalInteger(size), bootstrapEvalInteger(revision),
         bootstrapEvalInteger(inode), bootstrapEvalInteger(changed)]
    )
}

fun ctNativeInfoField(info: BootstrapEvalValue, name: string): int {
    var index = 0
    while (index < info.fieldNames.size) {
        if (info.fieldNames[index] == name) return info.elements[index].integer
        index = index + 1
    }
    0
}

/** A file's contents in the view, or why there are none (FileReadResult's
 *  error numbers: 2 nothing there, 21 a directory). `plain` reads as
 *  readText does, journaled under the path itself. */
fun ctNativeViewRead(var evaluator: BootstrapEvaluator, path: string,
    plain: bool = false): FileReadResult {
    val slot = ctNativeStagedSlot(path)
    if (slot >= 0) {
        val kind = bootstrapCompileOutputKind(slot)
        return if (kind == "file") FileReadResult(ctNativeStagedText(slot), true, 0)
            else FileReadResult("", false, if (kind == "directory") 21 else 2)
    }
    if (ctNativeStagedUnder(path) && Path(path).info().kind == 0) {
        return FileReadResult("", false, 21)
    }
    if (plain) {
        val contents = Path(path).readText()
        evaluator.recordCompileInput(path, contents)
        return FileReadResult(contents, true, 0)
    }
    val read = Path(path).readTextResult()
    evaluator.recordCompileInput("abla-input:file-result:$path", ctNativeReadResultText(read))
    read
}

/** The names in directory `path` in the view: the disk's (less staged
 *  removals), then what was staged in it. */
fun ctNativeViewEntries(var evaluator: BootstrapEvaluator, path: string): array<string> {
    val names: array<string> = []
    val slot = ctNativeStagedSlot(path)
    if (slot >= 0 && bootstrapCompileOutputKind(slot) != "directory") return names
    var listed = ""
    for (entry in Path(path).entries()) {
        val name = entry.name()
        listed = "$listed$name\n"
        val child = ctNativeStagedSlot(entry.text)
        if (child < 0 || bootstrapCompileOutputKind(child) != "removed") names.append(name)
    }
    evaluator.recordCompileInput("abla-input:entries:$path", listed)
    if (bootstrapCompileOutputCount > 0 && bootstrapCompileOutputPathValid(path)) {
        val prefix = "$path/"
        var staged = 0
        while (staged < bootstrapCompileOutputCount) {
            val stagedPath = bootstrapCompileOutputPath(staged)
            if (stagedPath.startsWith(prefix) && bootstrapCompileOutputKind(staged) != "removed") {
                var end = prefix.size
                while (end < stagedPath.size && stagedPath[end] != 47) end = end + 1
                val name = stagedPath.slice(prefix.size, end)
                var known = false
                for (present in names) if (present == name) known = true
                if (!known) names.append(name)
            }
            staged = staged + 1
        }
    }
    names
}

// Performs `Path.<method>` on an evaluated receiver; `arguments` holds the
// call's children and the method's arguments start at `first`. It answers
// from the compile-time file view (above), journaling what it observes on
// disk, so a cached build is reused only while the answer is the same.
@noinline
fun ctNativeEvaluatePathMethod(
    var evaluator: BootstrapEvaluator,
    receiver: BootstrapEvalValue,
    method: string,
    arguments: array<BootstrapExpression>,
    first: int,
    effect: int
): BootstrapEvalValue {
    if (!ctNativeAllowed(evaluator, effect)) {
        return ctNativeDenied(evaluator, "call to `Path.$method`", effect)
    }
    val values: array<BootstrapEvalValue> = []
    var index = first
    while (index < arguments.size) {
        values.append(evaluator.evaluate(arguments[index]))
        index = index + 1
    }
    val path = ctNativePathText(receiver)
    var result = bootstrapEvalInvalid()
    // Writes are real writes, as at run time (#72): the compiler performs the run-time operation itself, so the
    // site's own system calls and the processes it starts see them at once. A build that fails later keeps what
    // its sites wrote.
    if (method == "writeText" || method == "writeTextAtomic" || method == "appendText") {
        val contents = ctNativeValueText(values, 0)
        val mode = if (method != "appendText" && values.size > 1) ctNativeWord(values[1]) else 0o666
        val target = Path(path)
        result = bootstrapEvalBoolean(path != "" &&
            (if (method == "appendText") target.appendText(contents)
             else if (method == "writeTextAtomic") target.writeTextAtomic(contents, mode)
             else target.writeText(contents, mode)))
    } else if (method == "createDirectories") {
        val mode = if (values.size == 0) 0o777 else ctNativeWord(values[0])
        result = bootstrapEvalBoolean(path != "" && Path(path).createDirectories(mode))
    } else if (method == "createParentDirectories") {
        result = bootstrapEvalBoolean(path != "" && Path(path).createParentDirectories())
    } else if (method == "remove") {
        result = bootstrapEvalBoolean(path != "" && Path(path).remove())
    } else if (method == "moveTo") {
        val destination = ctNativePathText(if (values.size > 0) values[0] else bootstrapEvalInvalid())
        result = bootstrapEvalBoolean(path != "" && destination != "" && Path(path).moveTo(Path(destination)))
    } else if (method == "readText") {
        val read = ctNativeViewRead(evaluator, path, true)
        result = bootstrapEvalString(if (read.succeeded) read.text else "")
    } else if (method == "readTextResult") {
        val read = ctNativeViewRead(evaluator, path)
        result = bootstrapEvalObject(
            "FileReadResult", ["text", "succeeded", "errorCode"],
            [bootstrapEvalString(read.text), bootstrapEvalBoolean(read.succeeded),
             bootstrapEvalInteger(read.errorCode)]
        )
    } else if (method == "exists") {
        result = bootstrapEvalBoolean(ctNativeViewKind(evaluator, path) != 0)
    } else if (method == "info") {
        result = ctNativeViewInfo(evaluator, path)
    } else if (method == "revision") {
        result = bootstrapEvalInteger(ctNativeInfoField(ctNativeViewInfo(evaluator, path),
            "revision"))
    } else if (method == "isSymbolicLink") {
        var link = false
        if (ctNativeStagedSlot(path) < 0 && !ctNativeStagedUnder(path)) {
            link = Path(path).isSymbolicLink()
            evaluator.recordCompileInput("abla-input:symbolic-link:$path", "$link")
        }
        result = bootstrapEvalBoolean(link)
    } else if (method == "entries") {
        val elements: array<BootstrapEvalValue> = []
        for (name in ctNativeViewEntries(evaluator, path)) {
            elements.append(ctNativePathValue(Path(path).child(name).text))
        }
        result = bootstrapEvalArray(elements)
    } else {
        evaluator.errors = evaluator.errors + 1
    }
    result
}

// `p.method(...)` on a Path when that method is a provider (-1 otherwise).
fun ctNativePathProvider(var evaluator: BootstrapEvaluator, receiver: BootstrapEvalValue,
    method: string): int =
    if (receiver.kind == "object" && receiver.owner == "Path" &&
        bootstrapCompileProviderEffect("fs", "Path", method) >= 0)
        ctNativeProviderTarget(evaluator, "Path", method)
    else -1

// --- the time limit of an interpreted `#` site ------------------------------------------
// A native site stops at ABLA_COMPILE_EVAL_TIME_LIMIT through its alarm (ct_eval.ab). An interpreted one had only
// the step limit, which a site blocked in a system call (an accept, a wait for a child, a read of a pipe) never
// reaches: the build hung (the tls case, whose server waits for a client that can't connect). ct_eval.ab arms
// ITIMER_REAL for the interpreted site with a handler that only returns, first at the limit and then every second,
// so a blocked call returns EINTR from then on; the evaluator checks the clock every few thousand steps and after
// each system call or C call, and stops with E_CT_TIME_LIMIT.
// Monotonic milliseconds, 0: no interpreted site is timed.
var ctNativeDeadline: int = 0
var ctNativeDeadlineSeconds: int = 0
var ctNativeTimedOut: bool = false
// The native call's deadline in monotonic milliseconds (ct_eval.ab, bootstrapCtCall), 0: none. Its alarm can't stop
// the call while the compiler's code runs (a bridge call, ct_jit.ab), so a compile-time sleep wakes up by then.
var ctNativeCallDeadline: int = 0

// The live generation's mark of a stop the time limit deferred while the compiler's code ran (3; 0: none), a word of
// the slice (ct_jit.ab, bootstrapCtWrapBridgeEntries; #1036); 0 without a generation.
var ctNativeStopDeferredAddress: int = 0

// Whether the native call's time limit has passed while the compiler's code ran (its stop waits for the return).
trusted fun ctNativeStopDeferred(): bool = ctNativeStopDeferredAddress != 0 &&
    ablaUnsafeLoadI64(nativePointerFromAddress(ctNativeStopDeferredAddress)) != 0

// A compile-time `sleep`: `nanoseconds`, or less when the site's time limit comes first (#1036, #1037). Its signal
// only interrupts the sleep, which the standard library resumes, so the limit would wait for the whole sleep. An
// interpreted site's sleep ends at its deadline (the evaluator stops after it). A native site's ends once its alarm
// has deferred the stop, which the bridge then takes; past the deadline it sleeps in short steps until then, as
// the deadline here is read in milliseconds and the alarm may come a little later.
fun ctNativeSleepUntilDeadline(nanoseconds: int): bool {
    if (nanoseconds <= 0) return true
    if (ctNativeDeadline == 0 && ctNativeCallDeadline == 0) return sleepNanoseconds(nanoseconds)
    val end = monotonicNanoseconds() + nanoseconds
    var slept = true
    var now = monotonicNanoseconds()
    while (slept && now < end) {
        if (ctNativeDeadline != 0 && now >= ctNativeDeadline * 1000000) return true
        if (ctNativeStopDeferred()) return true
        var wake = end
        if (ctNativeDeadline != 0 && ctNativeDeadline * 1000000 < wake) wake = ctNativeDeadline * 1000000
        if (ctNativeCallDeadline != 0) {
            val callDeadline = ctNativeCallDeadline * 1000000
            if (now >= callDeadline) {
                if (now + 5000000 < wake) wake = now + 5000000
            } else if (callDeadline < wake) wake = callDeadline
        }
        slept = sleepNanoseconds(wake - now)
        now = monotonicNanoseconds()
    }
    slept
}

// Whether the interpreted site ran past its time limit (recorded once, as an error of `evaluator`).
@noinline
fun ctNativeDeadlinePassed(var evaluator: BootstrapEvaluator, at: BootstrapExpression): bool {
    if (ctNativeDeadline == 0) return false
    if (!ctNativeTimedOut && linuxMonotonicMilliseconds() >= ctNativeDeadline) {
        ctNativeTimedOut = true
        // Where it was when the limit passed, as the native tier's report says it (ct_eval.ab, bootstrapCtReportStop).
        bootstrapEvalRuntimePanic(evaluator, "E_CT_TIME_LIMIT", bootstrapCtTimeLimitMessage(ctNativeDeadlineSeconds),
            at)
    }
    ctNativeTimedOut
}

// The time limit's message, the same in both tiers.
fun bootstrapCtTimeLimitMessage(seconds: int): string =
    "compile-time evaluation ran past the time limit ($seconds s; ABLA_COMPILE_EVAL_TIME_LIMIT)"
