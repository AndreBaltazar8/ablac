// The linker in the compiler's own process (#92): lld, through runtime/abla_lld_shim.cpp, linked into the statically linked compiler by
// tools/build-static-compiler.sh. src/orc_main_static.ab installs it; the ordinary compiler never imports this module, so it has no such symbol.
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"
import "toolchain.ab"
import "codegen_units.ab"

// The shim (C++, lld::lldMain): the command line one argument per line, the diagnostics file (0 for standard error), lld's exit code or -1.
trusted noescape extern:"c" fun abla_lld_main(arguments: int, errors: int): int

// A NUL-terminated copy in native memory (nativeCStringAddress's copy is on the collected heap, which nothing holds while the C++ code runs).
trusted fun staticLldCopy(text: string): NativeByteBuffer {
    val buffer = nativeByteBuffer(text.size + 1)
    var index = 0
    while (index < text.size) {
        buffer.store(index, text[index])
        index = index + 1
    }
    buffer.store(text.size, 0)
    buffer
}

trusted fun staticLldRun(arguments: string, errors: string): int {
    val argumentsCopy = staticLldCopy(arguments)
    val errorsCopy = staticLldCopy(errors)
    val status = abla_lld_main(
        nativePointerAddress(argumentsCopy.address),
        if (errors == "") 0 else nativePointerAddress(errorsCopy.address)
    )
    argumentsCopy.close()
    errorsCopy.close()
    status
}

// The shim's archive writer (llvm-ar rcsD --format=gnu): one path a line, the archive first.
trusted noescape extern:"c" fun abla_archive_gnu(arguments: int): int

trusted fun staticArchiveRun(paths: string): int {
    val pathsCopy = staticLldCopy(paths)
    val status = abla_archive_gnu(nativePointerAddress(pathsCopy.address))
    pathsCopy.close()
    status
}

// The shim's object emission (llc): the bitcode, the object, verify, sections, loop alignment; 0, or non-zero (-1 from the stub).
trusted noescape extern:"c" fun abla_emit_object(bitcode: int, object: int, verify: int, sections: int, alignLoops: int): int

// The release path's llc: --function-sections --data-sections --align-loops=32 (bootstrapWholeProgramObjectCommand).
trusted fun staticEmitRun(bitcode: string, object: string, verify: bool): int {
    val bitcodeCopy = staticLldCopy(bitcode)
    val objectCopy = staticLldCopy(object)
    val status = abla_emit_object(
        nativePointerAddress(bitcodeCopy.address),
        nativePointerAddress(objectCopy.address),
        if (verify) 1 else 0,
        1,
        32
    )
    bitcodeCopy.close()
    objectCopy.close()
    status
}

// The shim's opt and llc: the tool, its arguments one a line; the tool's exit code.
trusted noescape extern:"c" fun abla_tool_main(tool: int, arguments: int): int
// 2 with the shim; the stub a static compiler built without it carries returns 0.
trusted noescape extern:"c" fun abla_shim_version(): int

trusted fun staticToolRun(tool: string, arguments: string): int {
    val toolCopy = staticLldCopy(tool)
    val argumentsCopy = staticLldCopy(arguments)
    val status = abla_tool_main(nativePointerAddress(toolCopy.address), nativePointerAddress(argumentsCopy.address))
    toolCopy.close()
    argumentsCopy.close()
    status
}

trusted fun staticLldInstall(): void {
    // Only a compiler built with the shim: the stub of one built without it (the AArch64 static compiler, whose lld and LLVM archives are not the host's) answers 0, and with the stub every
    // tool answers -1: the release parts would start children of the compiler (`--emit-object`) that fall back to an llc that is not there (CI run 44964395991: status 127 under qemu).
    if (abla_shim_version() < 1) return
    bootstrapInProcessLinker = staticLldRun
    bootstrapInProcessLinkerInstalled = true
    bootstrapInProcessArchiver = staticArchiveRun
    bootstrapInProcessArchiverInstalled = true
    bootstrapInProcessEmitter = staticEmitRun
    bootstrapInProcessEmitterInstalled = true
    bootstrapInProcessTool = staticToolRun
    bootstrapInProcessToolInstalled = true
}
