import "lexer.ab"
import "abla/bytes"
import "abla/unsafe/memory"

class BootstrapExpression(
    val kind: string,
    val text: string,
    val begin: int,
    val end: int,
    val children: array<BootstrapExpression>
)

class BootstrapParameters(
    val names: array<string>,
    val types: array<string>,
    val defaults: array<BootstrapExpression>,
    val kinds: array<string>
)

class BootstrapDeclaration(
    val kind: string,
    val name: string,
    val begin: int,
    val end: int,
    val expression: BootstrapExpression,
    val parameters: array<string>,
    val parameterTypes: array<string>,
    val resultType: string,
    val methods: array<BootstrapDeclaration>,
    val parameterDefaults: array<BootstrapExpression>,
    val externalLibrary: string,
    val parameterKinds: array<string>,
    val extensionOwner: string,
    val isTrusted: bool,
    val isResource: bool,
    val isNoEscape: bool,
    val generatedNamespace: string,
    val generatedOriginBegin: int,
    val generatedOriginEnd: int,
    val annotations: array<string>,
    val annotationArguments: array<BootstrapExpression>,
    val annotationBegins: array<int>,
    val annotationEnds: array<int>,
    val sourceIdentity: string,
    // `class Square(…) : Shape, Named`: the interfaces it declares it conforms to.
    val conformances: array<string> = [],
    // `sealed interface Shape`: its implementers are its own module's.
    val isSealed: bool = false,
    // `private fun helper()`: visible only in its own module.
    val isPrivate: bool = false,
    // `fun <T, U> f(…)`, `class Box<T>`: the type parameters as written
    // (`T`, or `T:Shape&Named` with bounds). Only generics.ab reads them:
    // it replaces each generic declaration by its instantiations.
    val typeParameters: array<string> = []
)

/** `declaration`, sealed. */
fun bootstrapDeclarationSealed(
    declaration: BootstrapDeclaration
): BootstrapDeclaration = BootstrapDeclaration(
    declaration.kind,
    declaration.name,
    declaration.begin,
    declaration.end,
    declaration.expression,
    declaration.parameters,
    declaration.parameterTypes,
    declaration.resultType,
    declaration.methods,
    declaration.parameterDefaults,
    declaration.externalLibrary,
    declaration.parameterKinds,
    declaration.extensionOwner,
    declaration.isTrusted,
    declaration.isResource,
    declaration.isNoEscape,
    declaration.generatedNamespace,
    declaration.generatedOriginBegin,
    declaration.generatedOriginEnd,
    declaration.annotations,
    declaration.annotationArguments,
    declaration.annotationBegins,
    declaration.annotationEnds,
    declaration.sourceIdentity,
    declaration.conformances,
    true,
    declaration.isPrivate,
    declaration.typeParameters
)

/** `declaration`, private to its module. */
fun bootstrapDeclarationPrivate(
    declaration: BootstrapDeclaration
): BootstrapDeclaration = BootstrapDeclaration(
    declaration.kind,
    declaration.name,
    declaration.begin,
    declaration.end,
    declaration.expression,
    declaration.parameters,
    declaration.parameterTypes,
    declaration.resultType,
    declaration.methods,
    declaration.parameterDefaults,
    declaration.externalLibrary,
    declaration.parameterKinds,
    declaration.extensionOwner,
    declaration.isTrusted,
    declaration.isResource,
    declaration.isNoEscape,
    declaration.generatedNamespace,
    declaration.generatedOriginBegin,
    declaration.generatedOriginEnd,
    declaration.annotations,
    declaration.annotationArguments,
    declaration.annotationBegins,
    declaration.annotationEnds,
    declaration.sourceIdentity,
    declaration.conformances,
    declaration.isSealed,
    true,
    declaration.typeParameters
)

/** A change to a declaration that a transform or compile-time code asks for,
 *  kept as data: keyed by the target's identity (never a handle, which shifts
 *  between graphs), so the parse that made it carries it even when the parse
 *  is reused, and the module graph applies it (bootstrapApplyDeclarationEdits). */
class BootstrapDeclarationEdit(
    // "annotate" (payload: the annotation's name)
    val kind: string,
    // The target: its module's source identity, receiver ("" for none) and name.
    val targetIdentity: string,
    val owner: string,
    val name: string,
    val payload: string,
    // Where it was asked for: "<sourceIdentity>:<begin>:<end>".
    val origin: string
)

class BootstrapParseResult(
    val declarations: array<BootstrapDeclaration>,
    val actions: array<BootstrapExpression>,
    val errors: int,
    val extensionErrors: int,
    val compileInputPaths: array<string>,
    val compileInputContents: array<string>,
    val diagnostics: string,
    // What this parse's transforms changed in other modules.
    val declarationEdits: array<BootstrapDeclarationEdit> = []
)

fun bootstrapHexValue(byte: int): int {
    var value = -1
    if (byte >= 48 && byte <= 57) value = byte - 48
    if (byte >= 65 && byte <= 70) value = byte - 65 + 10
    if (byte >= 97 && byte <= 102) value = byte - 97 + 10
    value
}

fun bootstrapIntegerText(raw: string): string {
    var base = 10
    var index = 0
    if (raw.size >= 2 && raw[0] == 48 &&
        (raw[1] == 120 || raw[1] == 88)) {
        base = 16
        index = 2
    }
    var value = 0
    while (index < raw.size) {
        if (raw[index] != 95) {
            val digit = if (base == 16) bootstrapHexValue(raw[index])
                else raw[index] - 48
            value = value * base + digit
        }
        index = index + 1
    }
    "$value"
}

fun bootstrapFloatText(raw: string): string {
    var result = ""
    var index = 0
    while (index < raw.size) {
        if (raw[index] != 95) {
            result = "$result${raw.slice(index, index + 1)}"
        }
        index = index + 1
    }
    result
}

fun bootstrapAsciiCodepoint(codepoint: int): string {
    var result = ""
    if (codepoint == 9) result = "\t"
    if (codepoint == 10) result = "\n"
    if (codepoint == 13) result = "\r"
    if (codepoint >= 32 && codepoint <= 126) {
        val printable = " !\"#\$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
        result = printable.slice(codepoint - 32, codepoint - 31)
    }
    result
}

// The byte a one-letter escape stands for: `\n` `\r` `\t` `\b` `\0`, and
// `\"` `\'` `\\` `\$` for themselves.
fun bootstrapSimpleEscapeByte(escaped: int): int {
    var result = -1
    if (escaped == 110) result = 10
    else if (escaped == 114) result = 13
    else if (escaped == 116) result = 9
    else if (escaped == 98) result = 8
    else if (escaped == 48) result = 0
    else if (escaped == 34 || escaped == 39 || escaped == 92 ||
             escaped == 36) result = escaped
    result
}

// The value of the hex digits starting at `begin`, up to the first non-digit.
fun bootstrapHexDigitsValue(raw: string, begin: int): int {
    var value = 0
    var cursor = begin
    while (cursor < raw.size && bootstrapHexValue(raw[cursor]) >= 0) {
        value = value * 16 + bootstrapHexValue(raw[cursor])
        cursor = cursor + 1
    }
    value
}

// Where the escape whose backslash is at `index` ends, or -1 when it is not
// a valid escape. Besides the one-letter escapes: `\xHH` (one byte),
// `\uXXXX` and `\u{H…}` (1-6 digits), which name a Unicode scalar value.
fun bootstrapEscapeEnd(raw: string, index: int): int {
    var finish = -1
    if (index + 1 < raw.size) {
        val escaped = raw[index + 1]
        if (bootstrapSimpleEscapeByte(escaped) >= 0) finish = index + 2
        else if (escaped == 120) {
            if (index + 3 < raw.size &&
                bootstrapHexValue(raw[index + 2]) >= 0 &&
                bootstrapHexValue(raw[index + 3]) >= 0) finish = index + 4
        } else if (escaped == 117) {
            var digitsBegin = index + 2
            if (index + 2 < raw.size && raw[index + 2] == 123) {
                digitsBegin = index + 3
                var cursor = digitsBegin
                while (cursor < raw.size && cursor - digitsBegin <= 6 &&
                       bootstrapHexValue(raw[cursor]) >= 0) {
                    cursor = cursor + 1
                }
                if (cursor > digitsBegin && cursor - digitsBegin <= 6 &&
                    cursor < raw.size && raw[cursor] == 125) {
                    finish = cursor + 1
                }
            } else if (index + 5 < raw.size &&
                       bootstrapHexValue(raw[index + 2]) >= 0 &&
                       bootstrapHexValue(raw[index + 3]) >= 0 &&
                       bootstrapHexValue(raw[index + 4]) >= 0 &&
                       bootstrapHexValue(raw[index + 5]) >= 0) {
                finish = index + 6
            }
            if (finish >= 0) {
                val codepoint = bootstrapHexDigitsValue(raw, digitsBegin)
                if (codepoint > 1114111 ||
                    (codepoint >= 55296 && codepoint <= 57343)) finish = -1
            }
        }
    }
    finish
}

// The first malformed escape in a string literal's text: its offset, or -1.
fun bootstrapInvalidEscapeOffset(raw: string): int {
    var result = -1
    var index = 0
    while (result < 0 && index < raw.size) {
        if (raw[index] == 92) {
            val finish = bootstrapEscapeEnd(raw, index)
            if (finish < 0) result = index else index = finish
        } else {
            index = index + 1
        }
    }
    result
}

fun bootstrapInvalidEscapeMessage(raw: string, offset: int): string {
    val escaped = if (offset + 1 < raw.size) raw[offset + 1] else 0
    if (escaped == 117) {
        "invalid Unicode escape: `\\uXXXX` takes 4 hex digits and `\\u{H...}` 1 to 6, naming a Unicode scalar value (at most 10FFFF, not a surrogate D800-DFFF)"
    } else if (escaped == 120) {
        "invalid byte escape: `\\x` takes exactly 2 hex digits"
    } else {
        "unknown escape `${raw.slice(offset, offset + 2)}` in a string; the escapes are \\n \\r \\t \\b \\0 \\\" \\' \\\\ \\\$ \\xHH \\uXXXX \\u{H...} (write `\\\\` for a backslash)"
    }
}

fun bootstrapDecodeString(raw: string): string {
    // A decoded literal can never exceed its source byte length (a `\u`
    // escape is at least as long as its UTF-8). Decode into one owned buffer
    // instead of repeatedly concatenating immutable strings; generated inline
    // assembly contains thousands of `\n` escapes, for which the old loop
    // retained quadratic transient copies. A malformed escape (reported by
    // the parser through bootstrapInvalidEscapeOffset) is kept as written.
    val output = nativeByteBuffer(raw.size + 1)
    var valid = !pointerIsNull(output.address)
    var index = 0
    var destination = 0
    while (valid && index < raw.size) {
        val finish = if (raw[index] == 92) bootstrapEscapeEnd(raw, index)
            else -1
        if (finish < 0) {
            valid = output.store(destination, raw[index])
            destination = destination + 1
            index = index + 1
        } else {
            val escaped = raw[index + 1]
            if (escaped == 120) {
                valid = output.store(
                    destination,
                    bootstrapHexValue(raw[index + 2]) * 16 +
                        bootstrapHexValue(raw[index + 3])
                )
                destination = destination + 1
            } else if (escaped == 117) {
                val codepoint = bootstrapHexDigitsValue(
                    raw, if (raw[index + 2] == 123) index + 3 else index + 2
                )
                if (codepoint < 128) {
                    valid = output.store(destination, codepoint)
                    destination = destination + 1
                } else if (codepoint < 2048) {
                    valid = output.store(destination, 192 + codepoint / 64)
                    if (valid) valid = output.store(
                        destination + 1, 128 + codepoint % 64
                    )
                    destination = destination + 2
                } else if (codepoint < 65536) {
                    valid = output.store(destination, 224 + codepoint / 4096)
                    if (valid) valid = output.store(
                        destination + 1, 128 + codepoint / 64 % 64
                    )
                    if (valid) valid = output.store(
                        destination + 2, 128 + codepoint % 64
                    )
                    destination = destination + 3
                } else {
                    valid = output.store(
                        destination, 240 + codepoint / 262144
                    )
                    if (valid) valid = output.store(
                        destination + 1, 128 + codepoint / 4096 % 64
                    )
                    if (valid) valid = output.store(
                        destination + 2, 128 + codepoint / 64 % 64
                    )
                    if (valid) valid = output.store(
                        destination + 3, 128 + codepoint % 64
                    )
                    destination = destination + 4
                }
            } else {
                valid = output.store(
                    destination, bootstrapSimpleEscapeByte(escaped)
                )
                destination = destination + 1
            }
            index = finish
        }
    }
    var result = ""
    if (valid) result = output.adoptString(destination)
    else output.close()
    result
}

class BootstrapParser(
    val sourceIdentity: string,
    val source: string,
    val tokens: array<BootstrapToken>,
    val expansionBegins: array<int>,
    val expansionEnds: array<int>,
    val expansionExpressions: array<BootstrapExpression>,
    var position: int,
    var errors: int,
    var diagnostics: string,
    // The names in scope where the parser is, innermost last, and whether
    // each is stable (a parameter, a `val` without `by`, a `for` variable),
    // which `?.` and `??` test in place (nullGuard). Names below
    // bindingFloor belong to an enclosing declaration and are not seen.
    val bindingNames: array<string>,
    val bindingStable: array<bool>,
    var bindingFloor: int
) {
    fun at(kind: string): bool = this.tokens[this.position].kind == kind

    fun declareBinding(name: string, stable: bool) {
        this.bindingNames.append(name)
        this.bindingStable.append(stable)
    }

    fun leaveBindings(size: int) {
        this.bindingNames.truncate(size)
        this.bindingStable.truncate(size)
    }

    /** Whether `name` is a binding in scope that can't change, so testing it
     *  and then reading it again reads the same value. */
    fun stableBinding(name: string): bool {
        var index = this.bindingNames.size
        while (index > this.bindingFloor) {
            index = index - 1
            if (this.bindingNames[index] == name) return this.bindingStable[index]
        }
        false
    }

    fun atWord(word: string): bool = this.at("identifier") &&
        bootstrapTokenText(this.source, this.tokens[this.position]) == word

    // A contextual keyword (`own`, `region`) is an ordinary identifier unless
    // the next token is of kind `next`.
    fun atContextualKeyword(word: string, next: string): bool =
        this.atWord(word) && this.position + 1 < this.tokens.size &&
        this.tokens[this.position + 1].kind == next

    fun expansionAt(begin: int): int {
        var result = -1
        var index = 0
        while (index < this.expansionBegins.size) {
            if (this.expansionBegins[index] == begin) result = index
            index = index + 1
        }
        result
    }

    fun consume(kind: string): bool {
        val matched = this.at(kind)
        if (matched) this.position = this.position + 1
        matched
    }

    fun consumeWord(word: string): bool {
        val matched = this.atWord(word)
        if (matched) this.position = this.position + 1
        matched
    }

    fun failAt(code: string, message: string, begin: int, end: int) {
        this.errors = this.errors + 1
        this.diagnostics =
            "${this.diagnostics}error[E_PARSE_$code]: $message\n"
        this.diagnostics =
            "${this.diagnostics}source[parser]:${this.sourceIdentity}:$begin:$end\n"
    }

    // Reports the first malformed escape in a string literal's text.
    fun checkEscapes(token: BootstrapToken, raw: string) {
        val offset = bootstrapInvalidEscapeOffset(raw)
        if (offset >= 0) this.failAt(
            "INVALID_ESCAPE",
            bootstrapInvalidEscapeMessage(raw, offset),
            token.begin + offset,
            token.begin + if (offset + 2 < raw.size) offset + 2 else raw.size
        )
    }

    fun fail(code: string, message: string) {
        val token = this.tokens[this.position]
        this.failAt(code, message, token.begin, token.end)
    }

    fun expect(kind: string) {
        if (!this.consume(kind)) {
            val found = this.tokens[this.position].kind
            this.fail(
                "EXPECTED_TOKEN",
                "expected token `$kind`, found `$found`"
            )
            if (!this.at("end")) this.position = this.position + 1
        }
    }

    fun skipSeparators() {
        var more = this.at("newline") || this.at(";")
        while (more) {
            this.position = this.position + 1
            more = this.at("newline") || this.at(";")
        }
    }

    // A leading binary operator continues the preceding expression. Keep
    // semicolons as hard statement boundaries, but allow generated and
    // hand-written constants to put `+ ` or `- ` at the beginning of the next
    // line without requiring parentheses. A sign glued to its operand on a
    // new line (`-1`) is a unary minus starting the next statement: after
    // `if (found) return i` it is the function's result, not `i - 1`.
    fun continueAdditiveExpression(): bool {
        val before = this.position
        while (this.at("newline")) this.position = this.position + 1
        var continued = this.at("+") || this.at("-")
        if (continued && this.position > before &&
            this.position + 1 < this.tokens.size &&
            this.tokens[this.position + 1].begin ==
                this.tokens[this.position].end) continued = false
        if (!continued) this.position = before
        continued
    }

    // A line starting with `.` continues the chain above it:
    // `val b = B([]).add("a")` then `    .add("b")`.
    fun continueMemberChain(): bool {
        val before = this.position
        while (this.at("newline")) this.position = this.position + 1
        val continued = this.at(".")
        if (!continued) this.position = before
        continued
    }

    // `?.` continues a chain as `.` does, from the next line too.
    fun continueSafeCall(): bool {
        val before = this.position
        while (this.at("newline")) this.position = this.position + 1
        val continued = this.at("?") &&
            this.position + 1 < this.tokens.size &&
            this.tokens[this.position + 1].kind == "."
        if (!continued) this.position = before
        continued
    }

    // `??` (or Kotlin's `?:`, reported and read as `??`), from the next line too.
    fun continueNullDefault(): bool {
        val before = this.position
        while (this.at("newline")) this.position = this.position + 1
        val continued = this.at("?") &&
            this.position + 1 < this.tokens.size &&
            (this.tokens[this.position + 1].kind == "?" ||
             this.tokens[this.position + 1].kind == ":")
        if (!continued) this.position = before
        continued
    }

    fun skipBalanced(open: string, close: string) {
        this.expect(open)
        var depth = 1
        while (depth > 0 && !this.at("end")) {
            if (this.at(open)) depth = depth + 1
            if (this.at(close)) depth = depth - 1
            this.position = this.position + 1
        }
        if (depth != 0) this.fail(
            "UNCLOSED_DELIMITER",
            "expected closing delimiter `$close`"
        )
    }

    fun skipToDeclarationEnd() {
        var parentheses = 0
        var brackets = 0
        var finished = false
        while (!finished && !this.at("end")) {
            if (parentheses == 0 && brackets == 0 &&
                (this.at("newline") || this.at(";") || this.at("}"))) {
                finished = true
                this.position = this.position
            } else {
                if (this.at("(")) parentheses = parentheses + 1
                if (this.at(")")) parentheses = parentheses - 1
                if (this.at("[")) brackets = brackets + 1
                if (this.at("]")) brackets = brackets - 1
                this.position = this.position + 1
            }
        }
    }

    fun parseType(stopOnRightParen: bool): string {
        var type = ""
        var angles = 0
        var parentheses = 0
        var finished = false
        while (!finished && !this.at("end")) {
            if (angles == 0 && parentheses == 0 &&
                (this.at("=") || this.atWord("by") || this.at("{") ||
                 // `interface Shape { fun area(): int }`: the body's end.
                 this.at("}") ||
                 this.at("newline") || this.at(";") ||
                 // `fun f(): T where …`: a reserved generic constraint.
                 (type != "" && this.atWord("where")))) {
                finished = true
            } else if (angles == 0 && parentheses == 0 &&
                (this.at(",") || (stopOnRightParen && this.at(")")))) {
                finished = true
            } else {
                if (this.at("<")) angles = angles + 1
                if (this.at(">")) angles = angles - 1
                if (this.at(">>")) angles = angles - 2
                if (this.at(">>>")) angles = angles - 3
                if (this.at("(")) parentheses = parentheses + 1
                if (this.at(")")) parentheses = parentheses - 1
                type = "$type${bootstrapTokenText(this.source, this.tokens[this.position])}"
                this.position = this.position + 1
                finished = finished
            }
        }
        type
    }

    fun parseParameters(): BootstrapParameters {
        val parameters: array<string> = []
        val types: array<string> = []
        val defaults: array<BootstrapExpression> = []
        val kinds: array<string> = []
        this.expect("(")
        this.skipSeparators()
        while (!this.at(")") && !this.at("end")) {
            var parameterKind = "parameter"
            if (this.at("val") || this.at("var")) {
                parameterKind = this.tokens[this.position].kind
                this.position = this.position + 1
            } else if (this.atContextualKeyword("own", "identifier")) {
                // `own` is a keyword only before a parameter's name.
                parameterKind = "own"
                this.position = this.position + 1
            }
            kinds.append(parameterKind)
            val name = this.tokens[this.position]
            this.expect("identifier")
            parameters.append(bootstrapTokenText(this.source, name))
            var declaredType = "inferred"
            if (this.consume(":")) {
                declaredType = this.parseType(true)
                types.append(declaredType)
            } else types.append("unknown")
            if (this.atWord("by")) {
                // `var balance: int by TVar(0)`: a delegated class property. Its
                // delegate is made at each construction, like a default
                // (delegated_properties.ab); the property takes no argument.
                val byToken = this.tokens[this.position]
                this.position = this.position + 1
                this.skipSeparators()
                val delegate = this.parseExpression()
                if (parameterKind != "val" && parameterKind != "var") this.failAt(
                    "DELEGATED_PARAMETER",
                    "`by` delegates a class property (`val` or `var`), not a parameter",
                    byToken.begin,
                    delegate.end
                )
                defaults.append(BootstrapExpression(
                    "delegate.initializer",
                    parameterKind,
                    byToken.begin,
                    delegate.end,
                    [
                        delegate,
                        BootstrapExpression(
                            "type", declaredType, name.begin, delegate.begin, []
                        )
                    ]
                ))
            } else if (this.consume("=")) {
                this.skipSeparators()
                defaults.append(this.parseExpression())
            } else defaults.append(BootstrapExpression(
                "missing",
                "",
                name.end,
                name.end,
                []
            ))
            this.skipSeparators()
            if (!this.consume(",") && !this.at(")")) this.fail(
                "PARAMETER_SEPARATOR",
                "expected `,` or `)` after parameter"
            )
            this.skipSeparators()
        }
        this.expect(")")
        BootstrapParameters(parameters, types, defaults, kinds)
    }

    fun parseLambdaType(): string {
        var type = ""
        var angles = 0
        var parentheses = 0
        var finished = false
        while (!finished && !this.at("end")) {
            if (angles == 0 && parentheses == 0 &&
                (this.at(",") || this.at("->"))) {
                finished = true
            } else {
                if (this.at("<")) angles = angles + 1
                if (this.at(">")) angles = angles - 1
                if (this.at(">>")) angles = angles - 2
                if (this.at(">>>")) angles = angles - 3
                if (this.at("(")) parentheses = parentheses + 1
                if (this.at(")")) parentheses = parentheses - 1
                type = "$type${bootstrapTokenText(
                    this.source,
                    this.tokens[this.position]
                )}"
                this.position = this.position + 1
                finished = finished
            }
        }
        type
    }

    fun parseLambda(): BootstrapExpression {
        val start = this.tokens[this.position]
        this.expect("{")
        this.skipSeparators()
        if (this.at("fun") || this.at("class") ||
            this.at("interface") || this.at("@") ||
            this.at("trusted") || this.at("noescape") ||
            this.at("resource") || this.at("extern") ||
            this.at("compile")) {
            return this.parseDeclarationBlock(start)
        }
        val children: array<BootstrapExpression> = []
        val parameterStart = this.position
        val parameters: array<BootstrapExpression> = []
        var hasArrow = false

        if (this.consume("->")) {
            hasArrow = true
        } else if (this.at("identifier")) {
            var parsingParameters = true
            while (parsingParameters) {
                val name = this.tokens[this.position]
                this.expect("identifier")
                var type = "unknown"
                if (this.consume(":")) type = this.parseLambdaType()
                parameters.append(BootstrapExpression(
                    "lambda.parameter",
                    bootstrapTokenText(this.source, name),
                    name.begin,
                    this.tokens[this.position].begin,
                    [BootstrapExpression(
                        "type",
                        type,
                        name.begin,
                        this.tokens[this.position].begin,
                        []
                    )]
                ))
                if (this.consume(",")) {
                    this.skipSeparators()
                    parsingParameters = parsingParameters
                } else parsingParameters = false
            }
            if (this.consume("->")) hasArrow = true
            else {
                this.position = parameterStart
                hasArrow = hasArrow
            }
        } else hasArrow = hasArrow

        val bindings = this.bindingNames.size
        if (hasArrow) {
            var parameter = 0
            while (parameter < parameters.size) {
                children.append(parameters[parameter])
                this.declareBinding(parameters[parameter].text, true)
                parameter = parameter + 1
            }
            this.skipSeparators()
        }

        val statements: array<BootstrapExpression> = []
        while (!this.at("}") && !this.at("end")) {
            val before = this.position
            if (this.at("val") || this.at("var")) {
                statements.append(this.parseLocal())
            } else if (this.at("while")) {
                statements.append(this.parseWhile())
            } else if (this.at("do")) {
                statements.append(this.parseDoWhile())
            } else if (this.at("for")) {
                statements.append(this.parseFor())
            } else if (this.at("return")) {
                statements.append(this.parseReturn())
            } else if (this.at("defer")) {
                statements.append(this.parseDefer())
            } else if (this.at("break") || this.at("continue")) {
                statements.append(this.parseLoopControl())
            } else statements.append(this.parseExpression())
            if (this.position == before) {
                this.fail(
                    "LAMBDA_PROGRESS",
                    "could not parse the next lambda statement"
                )
                this.position = this.position + 1
            }
            if (!this.at("}") && !this.at("newline") &&
                !this.at(";") && !this.at("end")) {
                this.fail(
                    "STATEMENT_SEPARATOR",
                    "expected a newline, `;`, or `}` after statement"
                )
                this.skipToDeclarationEnd()
            }
            this.skipSeparators()
        }
        val end = this.tokens[this.position]
        this.expect("}")
        this.leaveBindings(bindings)
        children.append(BootstrapExpression(
            "block",
            "",
            start.begin,
            end.end,
            statements
        ))
        BootstrapExpression("lambda", "", start.begin, end.end, children)
    }

    // Declaration blocks are compile-time syntax values. They deliberately
    // retain their exact source spelling so a compiler service can attach the
    // declarations to another module, while parsing every declaration here
    // still gives malformed quotes immediate, source-local diagnostics.
    fun parseDeclarationBlock(start: BootstrapToken): BootstrapExpression {
        val contentBegin = start.end
        var declarations = 0
        while (!this.at("}") && !this.at("end")) {
            val before = this.position
            if (this.at("#")) {
                this.parseExpression()
            } else if (this.at("@")) {
                this.parseAnnotatedDeclaration()
            } else if (this.atOperatorDeclaration()) {
                this.parseOperatorDeclaration()
            } else if (this.at("trusted")) {
                this.parseTrustedDeclaration()
            } else if (this.at("noescape")) {
                this.parseNoEscapeDeclaration()
            } else if (this.at("resource")) {
                this.parseResourceDeclaration()
            } else if (this.at("extern") ||
                (this.at("compile") &&
                 this.tokens[this.position + 1].kind == "extern")) {
                this.parseExternal()
            } else if (this.at("compile")) {
                this.parseCompileDeclaration()
            } else if (this.at("fun") || this.at("class") ||
                       this.at("interface") || this.at("val") ||
                       this.at("var")) {
                this.parseDeclaration()
            } else {
                this.fail(
                    "DECLARATION_BLOCK_MEMBER",
                    "expected a declaration inside declaration block"
                )
                this.skipToDeclarationEnd()
            }
            declarations = declarations + 1
            if (this.position == before) {
                this.fail(
                    "DECLARATION_BLOCK_PROGRESS",
                    "could not parse the next declaration"
                )
                this.position = this.position + 1
            }
            this.skipSeparators()
        }
        val end = this.tokens[this.position]
        this.expect("}")
        if (declarations == 0) this.failAt(
            "DECLARATION_BLOCK_EMPTY",
            "declaration block requires at least one declaration",
            start.begin,
            end.end
        )
        BootstrapExpression(
            "declaration.block",
            this.source.slice(contentBegin, end.begin),
            start.begin,
            end.end,
            [BootstrapExpression(
                "declaration.block.source",
                this.sourceIdentity,
                start.begin,
                end.end,
                []
            )]
        )
    }

    fun parseLocal(): BootstrapExpression {
        val start = this.tokens[this.position]
        val localKind = this.tokens[this.position].kind
        this.position = this.position + 1
        val name = this.tokens[this.position]
        this.expect("identifier")
        var declaredType = "inferred"
        if (this.consume(":")) {
            declaredType = this.parseType(false)
        }
        var initializer = BootstrapExpression(
            "missing",
            "",
            name.end,
            name.end,
            []
        )
        if (this.consumeWord("by")) {
            val byBegin = this.tokens[this.position - 1].begin
            this.skipSeparators()
            val delegate = this.parseExpression()
            initializer = BootstrapExpression(
                "delegate.initializer",
                localKind,
                byBegin,
                delegate.end,
                [
                    delegate,
                    BootstrapExpression(
                        "type",
                        declaredType,
                        name.begin,
                        delegate.begin,
                        []
                    )
                ]
            )
        } else if (this.consume("=")) {
            this.skipSeparators()
            initializer = this.parseExpression()
        }
        this.declareBinding(
            bootstrapTokenText(this.source, name),
            localKind == "val" && initializer.kind != "delegate.initializer"
        )
        BootstrapExpression(
            "local.$localKind",
            bootstrapTokenText(this.source, name),
            start.begin,
            initializer.end,
            [
                initializer,
                BootstrapExpression(
                    "type",
                    declaredType,
                    name.begin,
                    initializer.begin,
                    []
                )
            ]
        )
    }

    fun parseBlock(): BootstrapExpression {
        val start = this.tokens[this.position]
        val bindings = this.bindingNames.size
        this.expect("{")
        val statements: array<BootstrapExpression> = []
        this.skipSeparators()
        while (!this.at("}") && !this.at("end")) {
            val before = this.position
            if (this.at("val") || this.at("var")) {
                statements.append(this.parseLocal())
            } else if (this.at("while")) {
                statements.append(this.parseWhile())
            } else if (this.at("do")) {
                statements.append(this.parseDoWhile())
            } else if (this.at("for")) {
                statements.append(this.parseFor())
            } else if (this.at("return")) {
                statements.append(this.parseReturn())
            } else if (this.at("defer")) {
                statements.append(this.parseDefer())
            } else if (this.at("break") || this.at("continue")) {
                statements.append(this.parseLoopControl())
            } else statements.append(this.parseExpression())
            if (this.position == before) {
                this.fail(
                    "BLOCK_PROGRESS",
                    "could not parse the next block statement"
                )
                this.position = this.position + 1
            }
            if (
                !this.at("}") && !this.at("newline") &&
                !this.at(";") && !this.at("end")
            ) {
                this.fail(
                    "STATEMENT_SEPARATOR",
                    "expected a newline, `;`, or `}` after statement"
                )
                this.skipToDeclarationEnd()
            }
            this.skipSeparators()
        }
        val end = this.tokens[this.position]
        this.expect("}")
        this.leaveBindings(bindings)
        BootstrapExpression("block", "", start.begin, end.end, statements)
    }

    fun parseControlBody(): BootstrapExpression {
        if (this.at("return")) this.parseReturn()
        else if (this.at("break") || this.at("continue")) {
            this.parseLoopControl()
        }
        else if (this.at("for")) this.parseFor()
        else if (this.at("{")) this.parseBlock()
        else this.parseExpression()
    }

    fun parseDefer(): BootstrapExpression {
        val start = this.tokens[this.position]
        this.expect("defer")
        this.skipSeparators()
        if (!this.at("{")) {
            this.fail("DEFER_BODY", "expected a block after `defer`")
            BootstrapExpression("defer", "", start.begin, start.end, [
                BootstrapExpression("missing", "defer", start.end, start.end, [])
            ])
        } else {
            var body = this.parseBlock()
            // A deferred block runs for its effects, so a trailing
            // assignment (`defer { n += 1 }`) is a statement, as at the end
            // of a void function: an empty block after it makes it void.
            if (body.kind == "block" && body.children.size > 0) {
                val last = body.children[body.children.size - 1].kind
                if (last == "assign" || last == "member.assign" ||
                    last == "index.assign") {
                    body.children.append(BootstrapExpression(
                        "block", "", body.end, body.end, []
                    ))
                }
            }
            BootstrapExpression("defer", "", start.begin, body.end, [body])
        }
    }

    fun parseSuspendingBlock(): BootstrapExpression {
        val start = this.tokens[this.position]
        val kind = start.kind
        this.position = this.position + 1
        this.skipSeparators()
        if (!this.at("{")) {
            this.fail(
                "SUSPENDING_BODY",
                "expected a block after `$kind`"
            )
            BootstrapExpression(kind, "", start.begin, start.end, [
                BootstrapExpression("missing", kind, start.end, start.end, [])
            ])
        } else {
            val body = this.parseBlock()
            BootstrapExpression(kind, "", start.begin, body.end, [body])
        }
    }

    fun parseLoopControl(): BootstrapExpression {
        val token = this.tokens[this.position]
        val kind = token.kind
        this.position = this.position + 1
        BootstrapExpression(kind, "", token.begin, token.end, [])
    }

    fun parseReturn(): BootstrapExpression {
        val start = this.tokens[this.position]
        this.expect("return")
        var value = BootstrapExpression(
            "missing",
            "return",
            start.end,
            start.end,
            []
        )
        // A closer or `,` ends a bare `return` too: `f(x ?? return, y)`.
        if (!this.at("newline") && !this.at(";") &&
            !this.at("}") && !this.at("end") && !this.at(")") &&
            !this.at("]") && !this.at(",")) {
            value = this.parseExpression()
        }
        BootstrapExpression(
            "return",
            "",
            start.begin,
            value.end,
            [value]
        )
    }

    fun parseIf(): BootstrapExpression {
        val start = this.tokens[this.position]
        this.expect("if")
        this.expect("(")
        this.skipSeparators()
        val condition = this.parseExpression()
        this.skipSeparators()
        this.expect(")")
        this.skipSeparators()
        val thenBranch = this.parseControlBody()
        val beforeElseSeparators = this.position
        this.skipSeparators()
        var elseBranch = BootstrapExpression(
            "missing",
            "",
            thenBranch.end,
            thenBranch.end,
            []
        )
        if (this.consume("else")) {
            this.skipSeparators()
            elseBranch = this.parseControlBody()
            this.position = this.position
        } else this.position = beforeElseSeparators
        BootstrapExpression(
            "if",
            "",
            start.begin,
            elseBranch.end,
            [condition, thenBranch, elseBranch]
        )
    }

    fun parseWhile(): BootstrapExpression {
        val start = this.tokens[this.position]
        this.expect("while")
        this.expect("(")
        this.skipSeparators()
        val condition = this.parseExpression()
        this.skipSeparators()
        this.expect(")")
        this.skipSeparators()
        val body = this.parseControlBody()
        BootstrapExpression(
            "while",
            "",
            start.begin,
            body.end,
            [condition, body]
        )
    }

    fun parseDoWhile(): BootstrapExpression {
        val start = this.tokens[this.position]
        this.expect("do")
        this.skipSeparators()
        val body = this.parseControlBody()
        this.skipSeparators()
        this.expect("while")
        this.expect("(")
        this.skipSeparators()
        val condition = this.parseExpression()
        this.skipSeparators()
        val end = this.tokens[this.position]
        this.expect(")")
        BootstrapExpression(
            "do.while",
            "",
            start.begin,
            end.end,
            [body, condition]
        )
    }

    fun parseFor(): BootstrapExpression {
        val start = this.tokens[this.position]
        this.expect("for")
        this.expect("(")
        this.skipSeparators()
        val name = this.tokens[this.position]
        this.expect("identifier")
        this.expect("in")
        this.skipSeparators()
        val source = this.parseExpression()
        this.skipSeparators()
        this.expect(")")
        this.skipSeparators()
        val bindings = this.bindingNames.size
        this.declareBinding(bootstrapTokenText(this.source, name), true)
        val body = this.parseControlBody()
        this.leaveBindings(bindings)
        BootstrapExpression(
            "for",
            bootstrapTokenText(this.source, name),
            start.begin,
            body.end,
            [source, body]
        )
    }

    fun parseWhen(): BootstrapExpression {
        val start = this.tokens[this.position]
        this.expect("when")
        this.expect("(")
        this.skipSeparators()
        val subject = this.parseExpression()
        this.skipSeparators()
        this.expect(")")
        this.skipSeparators()
        this.expect("{")
        val children: array<BootstrapExpression> = [subject]
        this.skipSeparators()
        while (!this.at("}") && !this.at("end")) {
            val matches: array<BootstrapExpression> = []
            if (this.consume("else")) {
                matches.append(BootstrapExpression(
                    "missing",
                    "else",
                    this.tokens[this.position].begin,
                    this.tokens[this.position].begin,
                    []
                ))
            } else {
                matches.append(this.parseWhenMatch())
                while (this.consume(",")) {
                    this.skipSeparators()
                    matches.append(this.parseWhenMatch())
                }
            }
            this.skipSeparators()
            this.expect("->")
            this.skipSeparators()
            val body = this.parseControlBody()
            var match = 0
            while (match < matches.size) {
                children.append(matches[match])
                children.append(body)
                match = match + 1
            }
            this.skipSeparators()
        }
        val end = this.tokens[this.position]
        this.expect("}")
        BootstrapExpression("when", "", start.begin, end.end, children)
    }

    /** A `when` arm's match: a value, or `is Type` (the subject is an
     *  instance of the class, or of a class conforming to the interface). */
    fun parseWhenMatch(): BootstrapExpression {
        if (!this.atContextualKeyword("is", "identifier")) return this.parseExpression()
        val begin = this.tokens[this.position].begin
        this.position = this.position + 1
        val type = this.parseCastType()
        BootstrapExpression("is", type, begin, this.tokens[this.position - 1].end, [])
    }

    /** `atomic { … }`, a transaction: an "atomic" node over its body as a
     *  lambda. `atomic { a } orElse { b }` runs `b` when `a` retries: the body
     *  is then a lambda over an "stm.orElse" of the two (each `orElse` takes
     *  what came before as its first alternative). */
    fun parseAtomic(): BootstrapExpression {
        val start = this.tokens[this.position]
        this.position = this.position + 1
        val first = this.parseBlock()
        var body = BootstrapExpression("lambda", "", first.begin, first.end, [first])
        var more = true
        while (more) {
            // `orElse` on the same line as the `}`, or at the start of the next.
            val before = this.position
            while (this.at("newline")) this.position = this.position + 1
            if (this.atContextualKeyword("orElse", "{")) {
                this.position = this.position + 1
                val alternative = this.parseBlock()
                val choice = BootstrapExpression(
                    "stm.orElse", "", start.begin, alternative.end, [
                        body,
                        BootstrapExpression(
                            "lambda", "", alternative.begin, alternative.end, [alternative]
                        )
                    ]
                )
                body = BootstrapExpression("lambda", "", start.begin, alternative.end, [
                    BootstrapExpression("block", "", start.begin, alternative.end, [choice])
                ])
            } else {
                this.position = before
                more = false
            }
        }
        BootstrapExpression("atomic", "", start.begin, body.end, [body])
    }

    fun parseRegion(): BootstrapExpression {
        val start = this.tokens[this.position]
        this.position = this.position + 1
        this.skipSeparators()
        if (!this.at("{")) {
            this.fail("REGION_BODY", "expected a block after `region`")
            BootstrapExpression(
                "region",
                "",
                start.begin,
                start.end,
                [BootstrapExpression(
                    "invalid",
                    "",
                    start.end,
                    start.end,
                    []
                )]
            )
        } else {
            val body = this.parseBlock()
            BootstrapExpression(
                "region",
                "",
                start.begin,
                body.end,
                [body]
            )
        }
    }

    // Module discovery runs before imported compile-time subparsers are
    // registered. Preserve a `$name ...` invocation as one opaque expression
    // in that preliminary pass instead of reporting `$` as an invalid primary
    // and recovering through the surrounding function body. The staged pass
    // later replaces this exact source range with the handler's typed syntax,
    // so this placeholder neither interprets nor authorizes target syntax.
    fun parseDeferredSubparserPlaceholder(): BootstrapExpression {
        val start = this.tokens[this.position]
        this.expect("$")
        var name = ""
        var end = start.end
        if (this.at("identifier")) {
            name = bootstrapTokenText(
                this.source, this.tokens[this.position]
            )
            end = this.tokens[this.position].end
            this.position = this.position + 1
        }
        var finished = false
        while (!finished && !this.at("end")) {
            if (this.at("(") || this.at("[") || this.at("{")) {
                val open = this.tokens[this.position].kind
                val close = if (open == "(") ")" else
                    if (open == "[") "]" else "}"
                this.skipBalanced(open, close)
                end = this.tokens[this.position - 1].end
            } else if (this.at("newline") || this.at(";") ||
                       this.at(")") || this.at("]") ||
                       this.at("}") || this.at(",")) {
                finished = true
            } else {
                end = this.tokens[this.position].end
                this.position = this.position + 1
            }
        }
        BootstrapExpression(
            "subparser.placeholder", name, start.begin, end, []
        )
    }

    /** At `array<T>()` or `Map<K, V>()`: the position of the type's closing
     *  `>`, else -1. */
    /** At `<` after a name: the index of the `>` closing a list of type
     *  arguments followed by `(` or `{` (`first<int>(xs)`, `xs.map<int> {`),
     *  else -1. `a < b > (c)` reads as type arguments too (as in Kotlin);
     *  as a comparison it never type-checked. */
    fun typeArgumentsEnd(): int {
        var index = this.position
        var angles = 0
        var parentheses = 0
        while (index < this.tokens.size) {
            val kind = this.tokens[index].kind
            if (kind == "<") angles = angles + 1
            else if (kind == ">") angles = angles - 1
            else if (kind == ">>") angles = angles - 2
            else if (kind == ">>>") angles = angles - 3
            else if (kind == "(") parentheses = parentheses + 1
            else if (kind == ")") parentheses = parentheses - 1
            else if (kind != "identifier" && kind != "," && kind != "?" &&
                     kind != "->" && kind != ".") return -1
            if (angles < 0 || parentheses < 0) return -1
            if (angles == 0) {
                if (parentheses != 0 || index + 1 >= this.tokens.size) return -1
                val next = this.tokens[index + 1].kind
                return if (next == "(" || next == "{") index else -1
            }
            index = index + 1
        }
        -1
    }

    /** `<T, U : Shape & Named>` after `fun` or a class's name: each
     *  parameter as `T`, or `T:Shape&Named` with its bounds. */
    fun parseTypeParameters(): array<string> {
        val parameters: array<string> = []
        if (this.position + 1 < this.tokens.size &&
            bootstrapTokenText(this.source, this.tokens[this.position + 1]) == "const") {
            // `<const N: int>`: reserved.
            this.failReserved("a `const` type parameter")
            this.skipAngleGroup()
            return parameters
        }
        this.expect("<")
        var open = true
        while (open && !this.at("end")) {
            val name = this.tokens[this.position]
            this.expect("identifier")
            var parameter = bootstrapTokenText(this.source, name)
            if (this.consume(":")) {
                var bound = ""
                var angles = 0
                var reading = true
                while (reading && !this.at("end")) {
                    if (angles == 0 && (this.at(",") || this.at(">") || this.at(">>"))) {
                        reading = false
                    } else if (angles == 1 && this.at(">>")) {
                        // `<T : Source<int>>`: the `>>` closes the bound and the list.
                        bound = "$bound>"
                        angles = 0
                        reading = false
                    } else {
                        if (this.at("<")) angles = angles + 1
                        if (this.at(">")) angles = angles - 1
                        bound = "$bound${bootstrapTokenText(this.source, this.tokens[this.position])}"
                        this.position = this.position + 1
                    }
                }
                parameter = "$parameter:$bound"
                if (this.at(">>") && bound.size > 0 && bound[bound.size - 1] == 62) {
                    this.position = this.position + 1
                    parameters.append(parameter)
                    return parameters
                }
            }
            parameters.append(parameter)
            if (!this.consume(",")) open = false
        }
        this.expect(">")
        parameters
    }

    fun typedEmptyEnd(): int {
        if (!this.atWord("array") && !this.atWord("Map")) return -1
        var index = this.position + 1
        if (index >= this.tokens.size || this.tokens[index].kind != "<") return -1
        var angles = 0
        var parentheses = 0
        while (index < this.tokens.size) {
            val kind = this.tokens[index].kind
            if (kind == "end" || kind == "newline" || kind == ";" || kind == "=" ||
                kind == "{" || kind == "}") return -1
            if (kind == "<") angles = angles + 1
            if (kind == ">") angles = angles - 1
            if (kind == ">>") angles = angles - 2
            if (kind == ">>>") angles = angles - 3
            if (kind == "(") parentheses = parentheses + 1
            if (kind == ")") parentheses = parentheses - 1
            if (angles < 0 || parentheses < 0) return -1
            if (angles == 0) {
                if (parentheses != 0 || index + 2 >= this.tokens.size ||
                    this.tokens[index + 1].kind != "(" ||
                    this.tokens[index + 2].kind != ")") return -1
                return index
            }
            index = index + 1
        }
        -1
    }

    /** `array<T>()` is the empty array literal of that element type, kept in
     *  its text; `Map<K, V>()` is `Map()` with the type as its one child. */
    fun parseTypedEmpty(): BootstrapExpression {
        val begin = this.tokens[this.position].begin
        val close = this.typedEmptyEnd()
        var type = ""
        while (this.position <= close) {
            type = "$type${bootstrapTokenText(this.source, this.tokens[this.position])}"
            this.position = this.position + 1
        }
        val typeEnd = this.tokens[close].end
        this.expect("(")
        val end = this.tokens[this.position].end
        this.expect(")")
        if (type.size >= 5 && type.slice(0, 5) == "array") {
            BootstrapExpression("array", type, begin, end, [])
        } else BootstrapExpression(
            "call", "Map", begin, end,
            [BootstrapExpression("type", type, begin, typeEnd, [])]
        )
    }

    fun parsePrimary(): BootstrapExpression {
        val token = this.tokens[this.position]
        val expansion = this.expansionAt(token.begin)
        if (expansion >= 0 && expansion < this.expansionEnds.size &&
            expansion < this.expansionExpressions.size) {
            val end = this.expansionEnds[expansion]
            while (!this.at("end") &&
                   this.tokens[this.position].begin < end) {
                this.position = this.position + 1
            }
            this.expansionExpressions[expansion]
        } else if (this.at("$")) {
            this.parseDeferredSubparserPlaceholder()
        } else if (this.at("if")) {
            this.parseIf()
        } else if (this.at("when")) {
            this.parseWhen()
        } else if (this.atContextualKeyword("region", "{")) {
            this.parseRegion()
        } else if (this.atContextualKeyword("atomic", "{")) {
            this.parseAtomic()
        } else if (this.at("generator") || this.at("task") ||
                   this.at("thread")) {
            this.parseSuspendingBlock()
        } else if (this.typedEmptyEnd() >= 0) {
            this.parseTypedEmpty()
        } else if (
            this.at("integer") || this.at("float") ||
            this.at("identifier") ||
            this.at("true") || this.at("false") || this.at("null")
        ) {
            this.position = this.position + 1
            BootstrapExpression(
                token.kind,
                if (token.kind == "integer") bootstrapIntegerText(
                    bootstrapTokenText(this.source, token)
                ) else if (token.kind == "float") bootstrapFloatText(
                    bootstrapTokenText(this.source, token)
                ) else bootstrapTokenText(this.source, token),
                token.begin,
                token.end,
                []
            )
        } else if (this.consume("string-start")) {
            var text = ""
            var templated = false
            val parts: array<BootstrapExpression> = []
            while (!this.at("string-end") && !this.at("end")) {
                if (this.at("string-text")) {
                    val textToken = this.tokens[this.position]
                    val rawText = bootstrapTokenText(this.source, textToken)
                    this.checkEscapes(textToken, rawText)
                    val part = bootstrapDecodeString(rawText)
                    text = "$text$part"
                    parts.append(BootstrapExpression(
                        "string",
                        part,
                        textToken.begin,
                        textToken.end,
                        []
                    ))
                    this.position = this.position + 1
                } else if (this.at("interpolation-identifier")) {
                    templated = true
                    val identifier = this.tokens[this.position]
                    parts.append(BootstrapExpression(
                        "identifier",
                        bootstrapTokenText(this.source, identifier),
                        identifier.begin,
                        identifier.end,
                        []
                    ))
                    this.position = this.position + 1
                } else if (this.consume("interpolation-start")) {
                    templated = true
                    parts.append(this.parseExpression())
                    this.expect("interpolation-end")
                    this.position = this.position
                } else {
                    this.fail(
                        "STRING_PART",
                        "expected string text, interpolation, or closing quote"
                    )
                    this.position = this.position + 1
                }
            }
            val stringEnd = this.tokens[this.position]
            this.expect("string-end")
            if (templated) {
                BootstrapExpression(
                    "string.template",
                    "",
                    token.begin,
                    stringEnd.end,
                    parts
                )
            } else BootstrapExpression(
                "string",
                text,
                token.begin,
                stringEnd.end,
                []
            )
        } else if (this.consume("(")) {
            this.skipSeparators()
            val expression = this.parseExpression()
            this.skipSeparators()
            this.expect(")")
            expression
        } else if (this.consume("[")) {
            val elements: array<BootstrapExpression> = []
            this.skipSeparators()
            var open = true
            while (open && !this.at("]") && !this.at("end")) {
                elements.append(this.parseExpression())
                this.skipSeparators()
                if (!this.consume(",") && !this.at("]")) {
                    this.fail(
                        "ARRAY_SEPARATOR",
                        "expected `,` or `]` after array element"
                    )
                    // Another construct's closer ends the list; anything
                    // else is skipped, so the loop always moves on.
                    if (this.at(")") || this.at("}")) open = false
                    else if (!this.at("end")) this.position = this.position + 1
                }
                this.skipSeparators()
            }
            val end = this.tokens[this.position]
            this.expect("]")
            BootstrapExpression("array", "", token.begin, end.end, elements)
        } else if (this.at("{")) {
            this.parseLambda()
        } else {
            this.fail(
                "EXPRESSION",
                "expected an expression, found `${token.kind}`"
            )
            // A closing delimiter belongs to the construct around the
            // missing expression (`(1 +)`): leave it, so that one mistake is
            // one error. Callers that loop always advance through `expect`.
            if (!this.at("end") && !this.at(")") && !this.at("]") &&
                !this.at("}")) this.position = this.position + 1
            BootstrapExpression("invalid", "", token.begin, token.end, [])
        }
    }

    fun parsePostfix(): BootstrapExpression = this.parsePostfixOn(this.parsePrimary())

    // Calls, member access and indexing after `expression`.
    fun parsePostfixOn(initial: BootstrapExpression): BootstrapExpression {
        var expression = initial
        var more = true
        while (more) {
            val typeArgumentsClose = if (this.at("<") &&
                (expression.kind == "identifier" || expression.kind == "member"))
                this.typeArgumentsEnd() else -1
            if (typeArgumentsClose >= 0) {
                // `first<int>(xs)`, `Box<int>(1)`, `xs.map<string> { … }`:
                // the type arguments stay in the callee's spelling
                // (`first<int>`), which generics.ab resolves.
                var typeArguments = ""
                while (this.position <= typeArgumentsClose) {
                    typeArguments = "$typeArguments${bootstrapTokenText(this.source, this.tokens[this.position])}"
                    this.position = this.position + 1
                }
                expression = BootstrapExpression(
                    expression.kind,
                    "${expression.text}$typeArguments",
                    expression.begin,
                    this.tokens[typeArgumentsClose].end,
                    expression.children
                )
            } else if (this.at("(")) {
                val arguments: array<BootstrapExpression> = []
                this.position = this.position + 1
                this.skipSeparators()
                var open = true
                while (open && !this.at(")") && !this.at("end")) {
                    if (this.at("identifier") &&
                        this.tokens[this.position + 1].kind == "=") {
                        val name = this.tokens[this.position]
                        this.position = this.position + 2
                        this.skipSeparators()
                        val value = this.parseExpression()
                        arguments.append(BootstrapExpression(
                            "named.argument",
                            bootstrapTokenText(this.source, name),
                            name.begin,
                            value.end,
                            [value]
                        ))
                    } else arguments.append(this.parseExpression())
                    this.skipSeparators()
                    if (!this.consume(",") && !this.at(")")) {
                        this.fail(
                            "ARGUMENT_SEPARATOR",
                            "expected `,` or `)` after argument"
                        )
                        if (this.at("]") || this.at("}")) open = false
                        else if (!this.at("end")) this.position = this.position + 1
                    }
                    this.skipSeparators()
                }
                this.expect(")")
                if (expression.kind == "member") {
                    val memberArguments: array<BootstrapExpression> = []
                    memberArguments.append(expression.children[0])
                    var argument = 0
                    while (argument < arguments.size) {
                        memberArguments.append(arguments[argument])
                        argument = argument + 1
                    }
                    expression = BootstrapExpression(
                        "member.call",
                        expression.text,
                        expression.begin,
                        this.tokens[this.position].begin,
                        memberArguments
                    )
                } else if (expression.kind == "identifier") {
                    expression = BootstrapExpression(
                        "call",
                        expression.text,
                        expression.begin,
                        this.tokens[this.position].begin,
                        arguments
                    )
                } else {
                    // Any other callee (an element, a call's result, a
                    // parenthesized expression) is kept and its value called.
                    val valueArguments: array<BootstrapExpression> = [expression]
                    for (each in arguments) valueArguments.append(each)
                    expression = BootstrapExpression(
                        "call.value",
                        "",
                        expression.begin,
                        this.tokens[this.position].begin,
                        valueArguments
                    )
                }
                more = more
            } else if (this.continueSafeCall()) {
                expression = this.parseSafeCall(expression)
                more = more
            } else if (this.continueMemberChain()) {
                this.position = this.position + 1
                // `account.^balance`: the delegate of a delegated property.
                val projection = this.at("^")
                if (projection) this.position = this.position + 1
                val member = this.tokens[this.position]
                this.expect("identifier")
                expression = BootstrapExpression(
                    "member",
                    bootstrapTokenText(this.source, member),
                    expression.begin,
                    member.end,
                    [expression]
                )
                if (projection) expression = BootstrapExpression(
                    "delegate.project", "", expression.begin, member.end, [expression]
                )
                more = more
            } else if (this.consume("[")) {
                this.skipSeparators()
                val index = this.parseExpression()
                this.skipSeparators()
                val end = this.tokens[this.position]
                this.expect("]")
                expression = BootstrapExpression(
                    "index",
                    "",
                    expression.begin,
                    end.end,
                    [expression, index]
                )
                more = more
            } else if (this.at("{")) {
                val lambda = this.parseLambda()
                if (expression.kind == "call.value") {
                    val valueArguments: array<BootstrapExpression> = []
                    for (each in expression.children) valueArguments.append(each)
                    valueArguments.append(lambda)
                    expression = BootstrapExpression(
                        "call.value", "", expression.begin, lambda.end, valueArguments
                    )
                } else if (expression.kind == "call") {
                    val arguments: array<BootstrapExpression> = []
                    var argument = 0
                    while (argument < expression.children.size) {
                        arguments.append(expression.children[argument])
                        argument = argument + 1
                    }
                    arguments.append(lambda)
                    expression = BootstrapExpression(
                        "call",
                        expression.text,
                        expression.begin,
                        lambda.end,
                        arguments
                    )
                } else if (expression.kind == "member") {
                    expression = BootstrapExpression(
                        "member.call",
                        expression.text,
                        expression.begin,
                        lambda.end,
                        [expression.children[0], lambda]
                    )
                } else if (expression.kind == "member.call") {
                    // `c.apply(2) { v -> v * 10 }`: the lambda is the last
                    // argument, after the receiver and the others.
                    val arguments: array<BootstrapExpression> = []
                    var argument = 0
                    while (argument < expression.children.size) {
                        arguments.append(expression.children[argument])
                        argument = argument + 1
                    }
                    arguments.append(lambda)
                    expression = BootstrapExpression(
                        "member.call",
                        expression.text,
                        expression.begin,
                        lambda.end,
                        arguments
                    )
                } else if (expression.kind == "identifier") {
                    if (expression.text == "move") {
                        expression = BootstrapExpression(
                            "lambda.move",
                            "",
                            expression.begin,
                            lambda.end,
                            lambda.children
                        )
                    } else {
                        expression = BootstrapExpression(
                            "call",
                            expression.text,
                            expression.begin,
                            lambda.end,
                            [lambda]
                        )
                    }
                } else {
                    this.failAt(
                        "TRAILING_LAMBDA_TARGET",
                        "trailing lambda requires a callable target",
                        expression.begin,
                        lambda.end
                    )
                    expression = BootstrapExpression(
                        "invalid",
                        "trailing-lambda-target",
                        expression.begin,
                        lambda.end,
                        [expression, lambda]
                    )
                }
                more = more
            } else more = false
        }
        expression
    }

    fun parseFactor(): BootstrapExpression {
        var expression = this.parseCast()
        var more = this.at("*") || this.at("/") || this.at("%")
        while (more) {
            val operation = this.tokens[this.position]
            this.position = this.position + 1
            this.skipSeparators()
            val right = this.parseCast()
            expression = BootstrapExpression(
                operation.kind,
                operation.kind,
                expression.begin,
                right.end,
                [expression, right]
            )
            more = this.at("*") || this.at("/") || this.at("%")
        }
        expression
    }

    /** `shape as? Square`: the value as the class, or null when it is an
     *  instance of another (binds tighter than `*`, as in Kotlin). */
    fun parseCast(): BootstrapExpression {
        var expression = this.parseUnary()
        while (this.atContextualKeyword("as", "?")) {
            this.position = this.position + 2
            val type = this.parseCastType()
            expression = BootstrapExpression(
                "as?",
                type,
                expression.begin,
                this.tokens[this.position - 1].end,
                [expression]
            )
        }
        expression
    }

    /** The type after `as?`, inside an expression: a name (qualified by an
     *  import alias or not) and its `<…>` arguments, nothing after them. */
    fun parseCastType(): string {
        var type = ""
        if (!this.at("identifier")) {
            this.fail("CAST_TYPE", "expected a class name after `as?`")
            return "unknown"
        }
        type = bootstrapTokenText(this.source, this.tokens[this.position])
        this.position = this.position + 1
        while (this.at(".") && this.position + 1 < this.tokens.size &&
               this.tokens[this.position + 1].kind == "identifier") {
            type = "$type.${bootstrapTokenText(this.source, this.tokens[this.position + 1])}"
            this.position = this.position + 2
        }
        if (this.at("<")) {
            var angles = 0
            var more = true
            while (more && !this.at("end")) {
                if (this.at("<")) angles = angles + 1
                if (this.at(">")) angles = angles - 1
                if (this.at(">>")) angles = angles - 2
                type = "$type${bootstrapTokenText(this.source, this.tokens[this.position])}"
                this.position = this.position + 1
                more = angles > 0
            }
        }
        type
    }

    fun parseUnary(): BootstrapExpression {
        if (this.at("await") || this.at("yield")) {
            val operation = this.tokens[this.position]
            this.position = this.position + 1
            this.skipSeparators()
            // `await t + 1` awaits `t`; `yield k * 10` yields the whole expression, as a
            // statement-level `yield` reads (it has no value of its own to combine).
            val operand =
                if (operation.kind == "yield") this.parseExpression()
                else this.parseUnary()
            BootstrapExpression(
                operation.kind,
                "",
                operation.begin,
                operand.end,
                [operand]
            )
        } else if (this.at("#")) {
            val operation = this.tokens[this.position]
            this.position = this.position + 1
            val operand = this.parseUnary()
            BootstrapExpression(
                "compile",
                "",
                operation.begin,
                operand.end,
                [operand]
            )
        } else if (this.at("^")) {
            val operation = this.tokens[this.position]
            this.position = this.position + 1
            // `^` projects a binding: `^volume.maximum` is the delegate's field,
            // `(^volume).maximum`, as a binding has no members of its own.
            if (this.at("identifier")) {
                val binding = this.parsePrimary()
                this.parsePostfixOn(BootstrapExpression(
                    "delegate.project",
                    "",
                    operation.begin,
                    binding.end,
                    [binding]
                ))
            } else {
                val operand = this.parseUnary()
                BootstrapExpression(
                    "delegate.project",
                    "",
                    operation.begin,
                    operand.end,
                    [operand]
                )
            }
        } else if (this.at("!") || this.at("~") ||
                   this.at("-") || this.at("+")) {
            val operation = this.tokens[this.position]
            this.position = this.position + 1
            val operand = this.parseUnary()
            BootstrapExpression(
                "unary${operation.kind}",
                operation.kind,
                operation.begin,
                operand.end,
                [operand]
            )
        } else this.parsePostfix()
    }

    fun parseTerm(): BootstrapExpression {
        var expression = this.parseFactor()
        var more = this.continueAdditiveExpression()
        while (more) {
            val operation = this.tokens[this.position]
            this.position = this.position + 1
            this.skipSeparators()
            val right = this.parseFactor()
            expression = BootstrapExpression(
                operation.kind,
                operation.kind,
                expression.begin,
                right.end,
                [expression, right]
            )
            more = this.continueAdditiveExpression()
        }
        expression
    }

    fun parseShift(): BootstrapExpression {
        var expression = this.parseTerm()
        var more = this.at("<<") || this.at(">>") || this.at(">>>")
        while (more) {
            val operation = this.tokens[this.position]
            this.position = this.position + 1
            this.skipSeparators()
            val right = this.parseTerm()
            expression = BootstrapExpression(
                operation.kind,
                operation.kind,
                expression.begin,
                right.end,
                [expression, right]
            )
            more = this.at("<<") || this.at(">>") || this.at(">>>")
        }
        expression
    }

    fun parseRange(): BootstrapExpression {
        var expression = this.parseShift()
        if (this.at("..") || this.at("until")) {
            val operation = this.tokens[this.position]
            this.position = this.position + 1
            this.skipSeparators()
            val right = this.parseShift()
            val kind = if (operation.kind == "..") {
                "range.closed"
            } else "range.until"
            expression = BootstrapExpression(
                kind,
                operation.kind,
                expression.begin,
                right.end,
                [expression, right]
            )
        }
        expression
    }

    // `a ?? b` binds tighter than comparisons and looser than ranges, and
    // groups to the right: `a ?? b ?? c` is `a ?? (b ?? c)`. The right side
    // may also be `return`, `break` or `continue`, as an `if` branch may.
    fun parseNullDefault(): BootstrapExpression {
        val left = this.parseRange()
        if (!this.continueNullDefault()) return left
        val mark = this.tokens[this.position]
        val next = this.tokens[this.position + 1]
        if (next.kind == ":") this.failAt(
            "ELVIS",
            "Abla writes Kotlin's `?:` as `??`: `x ?? fallback`",
            mark.begin,
            next.end
        )
        this.position = this.position + 2
        this.skipSeparators()
        val right =
            if (this.at("return")) this.parseReturn()
            else if (this.at("break") || this.at("continue")) this.parseLoopControl()
            else this.parseNullDefault()
        // Always through a local: `present` hands its value on (a resource
        // is moved out of it, ir.ab bootstrapIsNullDefaultResult).
        val name = "__abla_null_default_${mark.begin}"
        this.nullGuard("??", left, name, mark, bootstrapNullSubjectUse(name, mark), right)
    }

    // `receiver?.name…`: the rest of the chain (members, calls, indexing,
    // further `?.`) runs on the receiver only when it is not null, and the
    // whole chain is null otherwise, so the arguments of a skipped call are
    // never evaluated. Parentheses end the chain: `(a?.b).c`.
    fun parseSafeCall(receiver: BootstrapExpression): BootstrapExpression {
        val mark = this.tokens[this.position]
        this.position = this.position + 2
        val member = this.tokens[this.position]
        this.expect("identifier")
        val name = this.nullSubjectName(receiver, mark)
        val rest = this.parsePostfixOn(BootstrapExpression(
            "member",
            bootstrapTokenText(this.source, member),
            receiver.begin,
            member.end,
            [bootstrapNullSubjectUse(name, mark)]
        ))
        this.nullGuard(
            "?.",
            receiver,
            name,
            mark,
            rest,
            BootstrapExpression("null", "null", mark.begin, mark.begin + 1, [])
        )
    }

    // What the test of `?.` reads: a stable binding itself, which the chain
    // then only reads through, else a local holding the receiver (nullGuard).
    // The locals are named for the operator's offset, which no source name
    // repeats.
    fun nullSubjectName(subject: BootstrapExpression, mark: BootstrapToken): string =
        if (subject.kind == "identifier" && this.stableBinding(subject.text)) subject.text
        else "__abla_safe_call_${mark.begin}"

    // `if (x != null) present else absent` when `?.`'s subject is a stable
    // binding `x` (a parameter, a `val`: narrowed as written), else
    // `{ val t = subject; if (t != null) present else absent }`, so the
    // subject is evaluated once and `t` is narrowed in `present`. The `if`,
    // the comparison (and the block) carry the operator as their text, for
    // its diagnostics. Each read of the subject has a span of its own (the
    // operator's first byte for the test, its second for `present`), as
    // reads in source do.
    fun nullGuard(
        operator: string,
        subject: BootstrapExpression,
        name: string,
        mark: BootstrapToken,
        present: BootstrapExpression,
        absent: BootstrapExpression
    ): BootstrapExpression {
        val direct = name == subject.text && subject.kind == "identifier"
        val test = BootstrapExpression("!=", operator, mark.begin, mark.begin + 2, [
            if (direct) subject
            else BootstrapExpression("identifier", name, mark.begin, mark.begin + 1, []),
            BootstrapExpression("null", "null", mark.begin, mark.begin + 1, [])
        ])
        val end = if (absent.end > present.end) absent.end else present.end
        val choice = BootstrapExpression("if", operator, subject.begin, end, [test, present, absent])
        if (direct) return choice
        val local = BootstrapExpression("local.val", name, subject.begin, subject.end, [
            subject,
            BootstrapExpression("type", "inferred", subject.begin, subject.begin, [])
        ])
        BootstrapExpression("block", operator, subject.begin, end, [local, choice])
    }

    fun parseComparison(): BootstrapExpression {
        var expression = this.parseNullDefault()
        var more =
            this.at("<") || this.at("<=") ||
            this.at(">") || this.at(">=")
        while (more) {
            val operation = this.tokens[this.position]
            this.position = this.position + 1
            this.skipSeparators()
            val right = this.parseNullDefault()
            expression = BootstrapExpression(
                operation.kind,
                operation.kind,
                expression.begin,
                right.end,
                [expression, right]
            )
            more =
                this.at("<") || this.at("<=") ||
                this.at(">") || this.at(">=")
        }
        expression
    }

    fun parseEquality(): BootstrapExpression {
        var expression = this.parseComparison()
        var more = this.at("==") || this.at("!=")
        while (more) {
            val operation = this.tokens[this.position]
            this.position = this.position + 1
            this.skipSeparators()
            val right = this.parseComparison()
            expression = BootstrapExpression(
                operation.kind,
                operation.kind,
                expression.begin,
                right.end,
                [expression, right]
            )
            more = this.at("==") || this.at("!=")
        }
        expression
    }

    fun parseLogicalAnd(): BootstrapExpression {
        var expression = this.parseBitwiseOr()
        while (this.consume("&&")) {
            this.skipSeparators()
            val right = this.parseBitwiseOr()
            expression = BootstrapExpression(
                "&&",
                "&&",
                expression.begin,
                right.end,
                [expression, right]
            )
        }
        expression
    }

    fun parseBitwiseAnd(): BootstrapExpression {
        var expression = this.parseEquality()
        while (this.consume("&")) {
            this.skipSeparators()
            val right = this.parseEquality()
            expression = BootstrapExpression(
                "&", "&", expression.begin, right.end, [expression, right]
            )
        }
        expression
    }

    fun parseBitwiseXor(): BootstrapExpression {
        var expression = this.parseBitwiseAnd()
        while (this.consume("^")) {
            this.skipSeparators()
            val right = this.parseBitwiseAnd()
            expression = BootstrapExpression(
                "^", "^", expression.begin, right.end, [expression, right]
            )
        }
        expression
    }

    fun parseBitwiseOr(): BootstrapExpression {
        var expression = this.parseBitwiseXor()
        while (this.consume("|")) {
            this.skipSeparators()
            val right = this.parseBitwiseXor()
            expression = BootstrapExpression(
                "|", "|", expression.begin, right.end, [expression, right]
            )
        }
        expression
    }

    fun parseLogicalOr(): BootstrapExpression {
        var expression = this.parseLogicalAnd()
        while (this.consume("||")) {
            this.skipSeparators()
            val right = this.parseLogicalAnd()
            expression = BootstrapExpression(
                "||",
                "||",
                expression.begin,
                right.end,
                [expression, right]
            )
        }
        expression
    }

    fun parseExpression(): BootstrapExpression {
        val expression = this.parseLogicalOr()
        if (this.consume("=")) {
            this.skipSeparators()
            return this.assignment(expression, this.parseExpression())
        }
        // `place op= value` is `place = place op value`; the place is read
        // again, so it may not call anything.
        val kind = this.tokens[this.position].kind
        if (kind == "+=" || kind == "-=" || kind == "*=" || kind == "/=" || kind == "%=") {
            this.position = this.position + 1
            this.skipSeparators()
            val value = this.parseExpression()
            // (A `?.` chain is reported once, as not assignable.)
            if (!bootstrapRereadablePlace(expression) &&
                !bootstrapIsSafeChain(expression)) this.failAt(
                "COMPOUND_ASSIGNMENT_TARGET",
                "the left side of `$kind` is evaluated twice, so it may not call anything",
                expression.begin,
                expression.end
            )
            val operation = kind.slice(0, 1)
            return this.assignment(expression, BootstrapExpression(
                operation, operation, expression.begin, value.end, [expression, value]
            ))
        }
        expression
    }

    fun assignment(expression: BootstrapExpression, value: BootstrapExpression): BootstrapExpression =
        if (expression.kind == "identifier") {
            BootstrapExpression(
                "assign",
                expression.text,
                expression.begin,
                value.end,
                [value]
            )
        } else if (expression.kind == "member") {
            BootstrapExpression(
                "member.assign",
                expression.text,
                expression.begin,
                value.end,
                [expression.children[0], value]
            )
        } else if (expression.kind == "index") {
            BootstrapExpression(
                "index.assign",
                "",
                expression.begin,
                value.end,
                [
                    expression.children[0],
                    expression.children[1],
                    value
                ]
            )
        } else if (expression.kind == "delegate.project") {
            BootstrapExpression(
                "delegate.assign",
                "",
                expression.begin,
                value.end,
                [expression.children[0], value]
            )
        } else {
            this.failAt(
                "ASSIGNMENT_TARGET",
                if (bootstrapIsSafeChain(expression))
                    "a `?.` chain is not assignable: check `x != null` (that narrows a `val`), then assign through `.`"
                else "left side of assignment is not assignable",
                expression.begin,
                expression.end
            )
            BootstrapExpression(
                "invalid",
                "assignment-target",
                expression.begin,
                value.end,
                [value]
            )
        }

    /** Reserved syntax (a generic's `<T>`, `where`, `const` type parameters, an
     *  interface's `type Item`, `sealed`): reported as not supported yet, and
     *  skipped, so it never parses as something else. */
    fun failReserved(form: string) {
        this.fail("NOT_YET_SUPPORTED", "$form is reserved syntax, not supported yet")
    }

    /** Skips a `<…>` group (type parameters), nested ones included. */
    fun skipAngleGroup() {
        var depth = 0
        var more = true
        while (more && !this.at("end")) {
            if (this.at("<")) depth = depth + 1
            if (this.at(">")) depth = depth - 1
            if (this.at(">>")) depth = depth - 2
            if (this.at(">>>")) depth = depth - 3
            this.position = this.position + 1
            if (depth <= 0) more = false
        }
    }

    fun parseDeclaration(): BootstrapDeclaration {
        val begin = this.tokens[this.position].begin
        // A declaration (one in a declaration block too) sees none of the
        // enclosing function's locals.
        val enclosingFloor = this.bindingFloor
        val enclosingBindings = this.bindingNames.size
        this.bindingFloor = enclosingBindings
        var kind = this.tokens[this.position].kind
        if (this.atWord("type")) kind = "type"
        this.position = this.position + 1
        // `fun <T> first(…)`: a generic function.
        var typeParameters: array<string> = []
        if (kind == "fun" && this.at("<")) typeParameters = this.parseTypeParameters()
        var nameToken = this.tokens[this.position]
        this.expect("identifier")
        var declarationName = bootstrapTokenText(this.source, nameToken)
        var extensionOwner = ""
        // `fun array<int>.total()`, `fun string?.orEmpty()`: the receiver is
        // any type, read up to the `.` before the method name.
        var receiverType = declarationName
        if (kind == "fun" && (this.at("<") || this.at("?"))) {
            var angles = 0
            var more = true
            while (more && !this.at("end")) {
                if (angles == 0 && this.at(".")) {
                    more = false
                } else if (angles == 0 && !this.at("<") && !this.at("?")) {
                    more = false
                } else if (angles > 0 && (this.at("newline") ||
                           this.at("{") || this.at("=") || this.at(")"))) {
                    more = false
                } else {
                    if (this.at("<")) angles = angles + 1
                    if (this.at(">")) angles = angles - 1
                    if (this.at(">>")) angles = angles - 2
                    if (this.at(">>>")) angles = angles - 3
                    receiverType = "$receiverType${bootstrapTokenText(this.source, this.tokens[this.position])}"
                    this.position = this.position + 1
                }
            }
            if (!this.at(".")) {
                this.fail(
                    "EXTENSION_RECEIVER",
                    "expected `.` and the method name after the extension's receiver type `$receiverType`"
                )
                // Skip the rest of the declaration (its line, or its braced
                // body), so one mistake is one error.
                var braces = 0
                var skipping = true
                while (skipping && !this.at("end")) {
                    if (braces == 0 && this.at("newline")) {
                        skipping = false
                    } else {
                        if (this.at("{")) braces = braces + 1
                        if (this.at("}")) {
                            braces = braces - 1
                            if (braces == 0) skipping = false
                        }
                        this.position = this.position + 1
                    }
                }
            }
        }
        if (kind == "fun" && this.consume(".")) {
            extensionOwner = receiverType
            nameToken = this.tokens[this.position]
            this.expect("identifier")
            declarationName = bootstrapTokenText(this.source, nameToken)
        }
        // `var Point.label: string = ""`: an extension field of the class.
        if ((kind == "val" || kind == "var") && this.consume(".")) {
            kind = "extension.$kind"
            extensionOwner = declarationName
            nameToken = this.tokens[this.position]
            this.expect("identifier")
            declarationName = bootstrapTokenText(this.source, nameToken)
        }
        var expression = BootstrapExpression("missing", "", begin, begin, [])
        var parameters: array<string> = []
        var parameterTypes: array<string> = []
        var parameterDefaults: array<BootstrapExpression> = []
        var parameterKinds: array<string> = []
        var resultType = "inferred"
        val methods: array<BootstrapDeclaration> = []
        val conformances: array<string> = []

        if (kind == "fun") {
            if (this.at("(")) {
                val parsedParameters = this.parseParameters()
                parameters = parsedParameters.names
                parameterTypes = parsedParameters.types
                parameterDefaults = parsedParameters.defaults
                parameterKinds = parsedParameters.kinds
                for (fallback in parameterDefaults) {
                    // (`by` after a plain parameter was reported already.)
                    if (fallback.kind == "delegate.initializer" &&
                        (fallback.text == "val" || fallback.text == "var")) this.failAt(
                        "DELEGATED_PARAMETER",
                        "`by` delegates a class property (`val` or `var`), not a parameter",
                        fallback.begin,
                        fallback.end
                    )
                }
            }
            if (this.consume(":")) {
                resultType = this.parseType(false)
            }
            // `where T : Shape`: a generic's constraints.
            if (this.atWord("where")) {
                this.failReserved("a `where` clause")
                while (!this.at("end") && !this.at("=") && !this.at("{") &&
                       !this.at("newline")) this.position = this.position + 1
            }
            this.declareBinding("this", true)
            for (parameter in parameters) this.declareBinding(parameter, true)
            if (this.consume("=")) {
                this.skipSeparators()
                expression = this.parseExpression()
                this.skipToDeclarationEnd()
            }
            else if (this.at("{")) expression = this.parseBlock()
        } else if (kind == "class" || kind == "interface") {
            // `class Box<T>`: a generic class. A generic interface is reserved.
            if (this.at("<") && kind == "class") typeParameters = this.parseTypeParameters()
            else if (this.at("<")) {
                this.failReserved("a generic ${kind} (`$kind ${declarationName}<T>`)")
                this.skipAngleGroup()
            }
            if (this.at("(")) {
                val parsedParameters = this.parseParameters()
                parameters = parsedParameters.names
                parameterTypes = parsedParameters.types
                parameterDefaults = parsedParameters.defaults
                parameterKinds = parsedParameters.kinds
            }
            // `: Shape, Named`: the interfaces a class conforms to (or an
            // interface's parents, read and refused until they are supported).
            if (this.consume(":")) {
                var more = true
                while (more) {
                    conformances.append(this.parseType(false))
                    more = this.consume(",")
                }
            }
            if (this.consume("{")) {
                this.skipSeparators()
                while (!this.at("}") && !this.at("end")) {
                    if (this.at("fun")) {
                        methods.append(this.parseDeclaration())
                    } else if (this.atOperatorDeclaration()) {
                        methods.append(this.parseOperatorDeclaration())
                    } else if (this.at("trusted")) {
                        methods.append(this.parseTrustedDeclaration())
                    } else if (this.at("noescape")) {
                        methods.append(this.parseNoEscapeDeclaration())
                    } else if (kind == "interface" && this.atWord("type")) {
                        // `type Item`: an interface's associated type.
                        this.failReserved("an associated type (`type Item`)")
                        this.skipToDeclarationEnd()
                    } else {
                        this.fail(
                            "CLASS_MEMBER",
                            "expected a method declaration in class body"
                        )
                        this.skipToDeclarationEnd()
                    }
                    this.skipSeparators()
                }
                this.expect("}")
            }
        } else if (kind == "type") {
            this.expect("=")
            resultType = this.parseType(false)
            this.skipToDeclarationEnd()
        } else {
            if (this.consume(":")) {
                resultType = this.parseType(false)
            }
            if (this.consumeWord("by")) {
                val byBegin = this.tokens[this.position - 1].begin
                this.skipSeparators()
                val delegate = this.parseExpression()
                expression = BootstrapExpression(
                    "delegate.initializer",
                    kind,
                    byBegin,
                    delegate.end,
                    [
                        delegate,
                        BootstrapExpression(
                            "type",
                            resultType,
                            nameToken.begin,
                            delegate.begin,
                            []
                        )
                    ]
                )
            } else if (this.consume("=")) {
                this.skipSeparators()
                expression = this.parseExpression()
            }
            this.skipToDeclarationEnd()
        }
        this.leaveBindings(enclosingBindings)
        this.bindingFloor = enclosingFloor

        BootstrapDeclaration(
            kind,
            declarationName,
            begin,
            this.tokens[this.position].begin,
            expression,
            parameters,
            parameterTypes,
            resultType,
            methods,
            parameterDefaults,
            "",
            parameterKinds,
            extensionOwner,
            false,
            false,
            false,
            "",
            begin,
            this.tokens[this.position].begin,
            [],
            [],
            [],
            [],
            this.sourceIdentity,
            conformances,
            false,
            false,
            typeParameters
        )
    }

    /** `extend Square : Printable, Named`: interfaces for a class declared
     *  elsewhere, satisfied by its methods or by extension functions. */
    fun parseExtend(): BootstrapDeclaration {
        val begin = this.tokens[this.position].begin
        this.position = this.position + 1
        val name = this.parseCastType()
        val conformances: array<string> = []
        this.expect(":")
        var more = true
        while (more) {
            conformances.append(this.parseType(false))
            more = this.consume(",")
        }
        this.skipToDeclarationEnd()
        BootstrapDeclaration(
            "extend",
            name,
            begin,
            this.tokens[this.position].begin,
            BootstrapExpression("missing", "", begin, begin, []),
            [],
            [],
            "inferred",
            [],
            [],
            "",
            [],
            "",
            false,
            false,
            false,
            "",
            begin,
            this.tokens[this.position].begin,
            [],
            [],
            [],
            [],
            this.sourceIdentity,
            conformances
        )
    }

    fun parseExternal(): BootstrapDeclaration {
        val begin = this.tokens[this.position].begin
        if (this.at("compile")) this.position = this.position + 1
        this.expect("extern")
        this.expect(":")
        this.expect("string-start")
        var library = ""
        if (this.at("string-text")) {
            val libraryToken = this.tokens[this.position]
            val rawLibrary = bootstrapTokenText(this.source, libraryToken)
            this.checkEscapes(libraryToken, rawLibrary)
            library = bootstrapDecodeString(rawLibrary)
            this.position = this.position + 1
        }
        this.expect("string-end")
        val declaration = this.parseDeclaration()
        BootstrapDeclaration(
            "extern",
            declaration.name,
            begin,
            declaration.end,
            declaration.expression,
            declaration.parameters,
            declaration.parameterTypes,
            declaration.resultType,
            declaration.methods,
            declaration.parameterDefaults,
            library,
            declaration.parameterKinds,
            declaration.extensionOwner,
            declaration.isTrusted,
            declaration.isResource,
            declaration.isNoEscape,
            declaration.generatedNamespace,
            declaration.generatedOriginBegin,
            declaration.generatedOriginEnd,
            declaration.annotations,
            declaration.annotationArguments,
            declaration.annotationBegins,
            declaration.annotationEnds,
            declaration.sourceIdentity,
            declaration.conformances,
            declaration.isSealed,
            declaration.isPrivate,
            declaration.typeParameters
        )
    }

    fun parseCompileDeclaration(): BootstrapDeclaration {
        val begin = this.tokens[this.position].begin
        this.expect("compile")
        val declaration = this.parseDeclaration()
        var compileKind = declaration.kind
        if (declaration.kind == "fun") compileKind = "compile.fun"
        if (declaration.kind == "val") compileKind = "compile.val"
        if (declaration.kind == "var") compileKind = "compile.var"
        BootstrapDeclaration(
            compileKind,
            declaration.name,
            begin,
            declaration.end,
            declaration.expression,
            declaration.parameters,
            declaration.parameterTypes,
            declaration.resultType,
            declaration.methods,
            declaration.parameterDefaults,
            declaration.externalLibrary,
            declaration.parameterKinds,
            declaration.extensionOwner,
            declaration.isTrusted,
            declaration.isResource,
            declaration.isNoEscape,
            declaration.generatedNamespace,
            declaration.generatedOriginBegin,
            declaration.generatedOriginEnd,
            declaration.annotations,
            declaration.annotationArguments,
            declaration.annotationBegins,
            declaration.annotationEnds,
            declaration.sourceIdentity,
            declaration.conformances,
            declaration.isSealed,
            declaration.isPrivate,
            declaration.typeParameters
        )
    }

    fun parseTrustedDeclaration(): BootstrapDeclaration {
        val begin = this.tokens[this.position].begin
        this.expect("trusted")
        val declaration = if (this.at("noescape")) {
            this.parseNoEscapeDeclaration()
        } else if (this.at("extern")) {
            this.parseExternal()
        } else this.parseDeclaration()
        BootstrapDeclaration(
            declaration.kind,
            declaration.name,
            begin,
            declaration.end,
            declaration.expression,
            declaration.parameters,
            declaration.parameterTypes,
            declaration.resultType,
            declaration.methods,
            declaration.parameterDefaults,
            declaration.externalLibrary,
            declaration.parameterKinds,
            declaration.extensionOwner,
            true,
            declaration.isResource,
            declaration.isNoEscape,
            declaration.generatedNamespace,
            declaration.generatedOriginBegin,
            declaration.generatedOriginEnd,
            declaration.annotations,
            declaration.annotationArguments,
            declaration.annotationBegins,
            declaration.annotationEnds,
            declaration.sourceIdentity,
            declaration.conformances,
            declaration.isSealed,
            declaration.isPrivate,
            declaration.typeParameters
        )
    }

    fun parseResourceDeclaration(): BootstrapDeclaration {
        val begin = this.tokens[this.position].begin
        this.expect("resource")
        val declaration = this.parseDeclaration()
        if (declaration.kind != "class" && declaration.kind != "interface") this.failAt(
            "RESOURCE_DECLARATION",
            "`resource` must modify a class or interface declaration",
            begin,
            declaration.end
        )
        BootstrapDeclaration(
            declaration.kind,
            declaration.name,
            begin,
            declaration.end,
            declaration.expression,
            declaration.parameters,
            declaration.parameterTypes,
            declaration.resultType,
            declaration.methods,
            declaration.parameterDefaults,
            declaration.externalLibrary,
            declaration.parameterKinds,
            declaration.extensionOwner,
            declaration.isTrusted,
            true,
            declaration.isNoEscape,
            declaration.generatedNamespace,
            declaration.generatedOriginBegin,
            declaration.generatedOriginEnd,
            declaration.annotations,
            declaration.annotationArguments,
            declaration.annotationBegins,
            declaration.annotationEnds,
            declaration.sourceIdentity,
            declaration.conformances,
            declaration.isSealed,
            declaration.isPrivate,
            declaration.typeParameters
        )
    }

    fun parseNoEscapeDeclaration(): BootstrapDeclaration {
        val begin = this.tokens[this.position].begin
        this.expect("noescape")
        val declaration = if (this.at("trusted")) {
            this.parseTrustedDeclaration()
        } else if (this.at("extern")) {
            this.parseExternal()
        } else this.parseDeclaration()
        BootstrapDeclaration(
            declaration.kind,
            declaration.name,
            begin,
            declaration.end,
            declaration.expression,
            declaration.parameters,
            declaration.parameterTypes,
            declaration.resultType,
            declaration.methods,
            declaration.parameterDefaults,
            declaration.externalLibrary,
            declaration.parameterKinds,
            declaration.extensionOwner,
            declaration.isTrusted,
            declaration.isResource,
            true,
            declaration.generatedNamespace,
            declaration.generatedOriginBegin,
            declaration.generatedOriginEnd,
            declaration.annotations,
            declaration.annotationArguments,
            declaration.annotationBegins,
            declaration.annotationEnds,
            declaration.sourceIdentity,
            declaration.conformances,
            declaration.isSealed,
            declaration.isPrivate,
            declaration.typeParameters
        )
    }

    // `operator fun A.plus(b: B): C`: `operator` is a contextual word.
    fun atOperatorDeclaration(): bool = this.atWord("operator") &&
        this.position + 1 < this.tokens.size &&
        this.tokens[this.position + 1].kind == "fun"

    /** `operator fun …`: the declaration carries the `operator` annotation. */
    fun parseOperatorDeclaration(): BootstrapDeclaration {
        val begin = this.tokens[this.position].begin
        this.position = this.position + 1
        val declaration = this.parseDeclaration()
        val annotations: array<string> = ["operator"]
        val annotationArguments: array<BootstrapExpression> = [
            BootstrapExpression("missing", "", begin, begin, [])
        ]
        val annotationBegins: array<int> = [begin]
        val annotationEnds: array<int> = [begin]
        BootstrapDeclaration(
            declaration.kind,
            declaration.name,
            begin,
            declaration.end,
            declaration.expression,
            declaration.parameters,
            declaration.parameterTypes,
            declaration.resultType,
            declaration.methods,
            declaration.parameterDefaults,
            declaration.externalLibrary,
            declaration.parameterKinds,
            declaration.extensionOwner,
            declaration.isTrusted,
            declaration.isResource,
            declaration.isNoEscape,
            declaration.generatedNamespace,
            declaration.generatedOriginBegin,
            declaration.generatedOriginEnd,
            annotations,
            annotationArguments,
            annotationBegins,
            annotationEnds,
            declaration.sourceIdentity,
            declaration.conformances,
            declaration.isSealed,
            declaration.isPrivate,
            declaration.typeParameters
        )
    }

    fun parseAnnotatedDeclaration(): BootstrapDeclaration {
        val annotationNames: array<string> = []
        val annotationArguments: array<BootstrapExpression> = []
        val annotationBegins: array<int> = []
        val annotationEnds: array<int> = []
        val begin = this.tokens[this.position].begin
        while (this.consume("@")) {
            val annotation = this.tokens[this.position]
            this.expect("identifier")
            val name = bootstrapTokenText(this.source, annotation)
            var argument = BootstrapExpression(
                "missing", "", annotation.end, annotation.end, []
            )
            var annotationEnd = annotation.end
            if (this.consume("(")) {
                this.skipSeparators()
                if (!this.at(")")) argument = this.parseExpression()
                this.skipSeparators()
                val closing = this.tokens[this.position]
                this.expect(")")
                annotationEnd = closing.end
            }
            var duplicate = false
            var existing = 0
            while (existing < annotationNames.size) {
                if (annotationNames[existing] == name) duplicate = true
                existing = existing + 1
            }
            if (name == "" || duplicate) this.failAt(
                "ANNOTATION",
                if (duplicate) "duplicate annotation `$name`"
                else "annotation requires a name",
                annotation.begin,
                annotation.end
            )
            if (name != "" && !duplicate) {
                annotationNames.append(name)
                annotationArguments.append(argument)
                annotationBegins.append(annotation.begin)
                annotationEnds.append(annotationEnd)
            }
            this.skipSeparators()
        }
        var declaration = if (this.at("trusted")) {
            this.parseTrustedDeclaration()
        } else if (this.at("noescape")) {
            this.parseNoEscapeDeclaration()
        } else if (this.at("resource")) {
            this.parseResourceDeclaration()
        } else if (this.at("extern") ||
            (this.at("compile") &&
             this.tokens[this.position + 1].kind == "extern")) {
            this.parseExternal()
        } else if (this.at("compile")) {
            this.parseCompileDeclaration()
        } else if (
            this.at("fun") || this.at("class") || this.atWord("type") ||
            this.at("interface") || this.at("val") || this.at("var")
        ) {
            this.parseDeclaration()
        } else {
            this.fail(
                "ANNOTATED_DECLARATION",
                "annotation must precede a declaration"
            )
            this.skipToDeclarationEnd()
            BootstrapDeclaration(
                "invalid", "", begin, begin,
                BootstrapExpression("missing", "", begin, begin, []),
                [], [], "inferred", [], [], "", [], "", false, false,
                false, "", begin, begin, [], [], [], [], this.sourceIdentity
            )
        }
        BootstrapDeclaration(
            declaration.kind,
            declaration.name,
            begin,
            declaration.end,
            declaration.expression,
            declaration.parameters,
            declaration.parameterTypes,
            declaration.resultType,
            declaration.methods,
            declaration.parameterDefaults,
            declaration.externalLibrary,
            declaration.parameterKinds,
            declaration.extensionOwner,
            declaration.isTrusted,
            declaration.isResource,
            declaration.isNoEscape,
            declaration.generatedNamespace,
            declaration.generatedOriginBegin,
            declaration.generatedOriginEnd,
            annotationNames,
            annotationArguments,
            annotationBegins,
            annotationEnds,
            declaration.sourceIdentity,
            declaration.conformances,
            declaration.isSealed,
            declaration.isPrivate,
            declaration.typeParameters
        )
    }

    fun parse(): BootstrapParseResult {
        val declarations: array<BootstrapDeclaration> = []
        val actions: array<BootstrapExpression> = []
        this.skipSeparators()
        while (!this.at("end")) {
            val before = this.position
            // `private …`: the next declaration is visible only in this module.
            // (`internal`, for a package, is reserved.)
            var markPrivate = false
            if (this.atWord("private") && this.position + 1 < this.tokens.size &&
                this.tokens[this.position + 1].kind != "newline" &&
                this.tokens[this.position + 1].kind != "=" &&
                this.tokens[this.position + 1].kind != ":") {
                markPrivate = true
                this.position = this.position + 1
            } else if (this.atWord("internal") && this.position + 1 < this.tokens.size &&
                this.tokens[this.position + 1].kind != "newline" &&
                this.tokens[this.position + 1].kind != "=" &&
                this.tokens[this.position + 1].kind != ":") {
                this.failReserved("`internal` (visibility within a package)")
                this.position = this.position + 1
            }
            val declaredBefore = declarations.size
            if (this.at("import") ||
                (this.atWord("export") && this.position + 1 < this.tokens.size &&
                 this.tokens[this.position + 1].kind == "import")) {
                // (`export import`: module.ab reads it.)
                this.skipToDeclarationEnd()
            } else if (this.at("#")) {
                actions.append(this.parseExpression())
            } else if (this.at("@")) {
                declarations.append(this.parseAnnotatedDeclaration())
            } else if (this.atOperatorDeclaration()) {
                declarations.append(this.parseOperatorDeclaration())
            } else if (this.at("trusted")) {
                declarations.append(this.parseTrustedDeclaration())
            } else if (this.at("noescape")) {
                declarations.append(this.parseNoEscapeDeclaration())
            } else if (this.at("resource")) {
                declarations.append(this.parseResourceDeclaration())
            } else if (this.at("extern") ||
                (this.at("compile") &&
                 this.tokens[this.position + 1].kind == "extern")) {
                declarations.append(this.parseExternal())
            } else if (this.at("compile")) {
                declarations.append(this.parseCompileDeclaration())
            } else if (this.atContextualKeyword("extend", "identifier")) {
                declarations.append(this.parseExtend())
            } else if (this.atWord("sealed") &&
                this.tokens[this.position + 1].kind == "interface") {
                // `sealed interface Shape`: implemented only in its module.
                this.position = this.position + 1
                declarations.append(bootstrapDeclarationSealed(this.parseDeclaration()))
            } else if (this.atWord("sealed") &&
                this.tokens[this.position + 1].kind == "class") {
                // `sealed class`: reported, then read as the plain form.
                this.failReserved("a `sealed class` (a `sealed interface` is supported)")
                this.position = this.position + 1
                declarations.append(this.parseDeclaration())
            } else if (
                this.at("fun") || this.at("class") || this.atWord("type") ||
                this.at("interface") || this.at("val") || this.at("var")
            ) {
                declarations.append(this.parseDeclaration())
            } else {
                this.fail(
                    "TOP_LEVEL_DECLARATION",
                    "expected a top-level declaration or compile expression"
                )
                this.skipToDeclarationEnd()
            }
            if (markPrivate) {
                if (declarations.size == declaredBefore + 1 &&
                    declarations[declaredBefore].kind != "extend") {
                    declarations[declaredBefore] =
                        bootstrapDeclarationPrivate(declarations[declaredBefore])
                } else this.fail(
                    "PRIVATE_TARGET",
                    "`private` modifies one top-level declaration (a fun, val, var, class, interface or type)"
                )
            }
            if (this.position == before) {
                this.fail(
                    "TOP_LEVEL_PROGRESS",
                    "could not parse the next top-level declaration"
                )
                this.position = this.position + 1
            }
            this.skipSeparators()
        }
        bootstrapAppendExtensionFieldDefaults(declarations)
        BootstrapParseResult(
            declarations,
            actions,
            this.errors,
            0,
            [],
            [],
            this.diagnostics
        )
    }
}

fun bootstrapIsExtensionFieldKind(kind: string): bool =
    kind == "extension.val" || kind == "extension.var"

/** The extension function that computes an extension field's default:
 *  `Owner.__abla_default_<field>()`, whose body is the default expression (so
 *  it reads `this` and the receiver's fields as an extension function does). */
fun bootstrapExtensionFieldDefaultName(field: string): string = "__abla_default_$field"

/** Appends each extension field's default function after the declarations. */
fun bootstrapAppendExtensionFieldDefaults(var declarations: array<BootstrapDeclaration>): void {
    val count = declarations.size
    var index = 0
    while (index < count) {
        val field = declarations[index]
        if (bootstrapIsExtensionFieldKind(field.kind) &&
            field.expression.kind != "missing" &&
            field.expression.kind != "delegate.initializer") {
            declarations.append(BootstrapDeclaration(
                "fun",
                bootstrapExtensionFieldDefaultName(field.name),
                field.begin,
                field.end,
                field.expression,
                [],
                [],
                field.resultType,
                [],
                [],
                "",
                [],
                field.extensionOwner,
                false,
                false,
                false,
                field.generatedNamespace,
                field.generatedOriginBegin,
                field.generatedOriginEnd,
                [],
                [],
                [],
                [],
                field.sourceIdentity,
                field.typeParameters
            ))
        }
        index = index + 1
    }
    return
}

fun bootstrapParse(source: string): BootstrapParseResult {
    BootstrapParser(
        "<memory>", source, bootstrapLex(source), [], [], [], 0, 0, "", [], [], 0
    ).parse()
}

fun bootstrapParseWithIdentity(
    source: string,
    sourceIdentity: string
): BootstrapParseResult {
    BootstrapParser(
        sourceIdentity,
        source,
        bootstrapLex(source),
        [],
        [],
        [],
        0,
        0,
        "",
        [],
        [],
        0
    ).parse()
}

fun bootstrapPrimaryDiagnosticCount(diagnostics: string): int {
    var count = 0
    var index = 0
    var lineBegin = true
    while (index < diagnostics.size) {
        if (lineBegin && index + 6 <= diagnostics.size &&
            bootstrapRegionEquals(
                diagnostics, index, index + 6, "error["
            )) count = count + 1
        lineBegin = diagnostics[index] == 10
        index = index + 1
    }
    count
}

fun bootstrapEnsurePrimaryDiagnostics(
    diagnostics: string,
    expected: int,
    code: string,
    phase: string
): string {
    var output = diagnostics
    var count = bootstrapPrimaryDiagnosticCount(output)
    while (count < expected) {
        output =
            "${output}error[$code]: $phase failed without a more specific diagnostic (diagnostic ${count + 1} of $expected)\n"
        count = count + 1
    }
    output
}

fun bootstrapCanonicalNameDelimiter(name: string): int {
    val prefix = "__abla_module_"
    var delimiter = -1
    if (name.size >= prefix.size &&
        name.slice(0, prefix.size) == prefix) {
        var index = prefix.size
        while (index + 1 < name.size && delimiter < 0) {
            if (name[index] == 95 && name[index + 1] == 95) {
                delimiter = index
            }
            index = index + 1
        }
    }
    delimiter
}

fun bootstrapCanonicalDeclarationSourceName(name: string): string {
    val delimiter = bootstrapCanonicalNameDelimiter(name)
    if (delimiter >= 0) name.slice(delimiter + 2, name.size)
    else name
}

fun bootstrapCanonicalDeclarationModuleIdentity(name: string): string {
    val prefix = "__abla_module_"
    val delimiter = bootstrapCanonicalNameDelimiter(name)
    var identity = ""
    if (delimiter >= 0) {
        var index = prefix.size
        while (index + 1 < delimiter) {
            val high = bootstrapHexValue(name[index])
            val low = bootstrapHexValue(name[index + 1])
            if (high >= 0 && low >= 0) {
                identity = "$identity${bootstrapAsciiCodepoint(high * 16 + low)}"
            }
            index = index + 2
        }
    }
    identity
}

fun bootstrapSourceVisibleType(type: string): string {
    val prefix = "__abla_module_"
    var output = ""
    var cursor = 0
    var index = 0
    while (index < type.size) {
        if (index + prefix.size <= type.size &&
            type.slice(index, index + prefix.size) == prefix) {
            output = "$output${type.slice(cursor, index)}"
            var delimiter = index + prefix.size
            while (delimiter + 1 < type.size &&
                !(type[delimiter] == 95 && type[delimiter + 1] == 95)) {
                delimiter = delimiter + 1
            }
            if (delimiter + 1 < type.size) {
                cursor = delimiter + 2
                index = cursor
            } else index = index + 1
        } else index = index + 1
    }
    "$output${type.slice(cursor, type.size)}"
}

// The read of the subject `present` starts with (parser.ab, nullGuard).
fun bootstrapNullSubjectUse(name: string, mark: BootstrapToken): BootstrapExpression =
    BootstrapExpression("identifier", name, mark.begin + 1, mark.begin + 2, [])

// A `?.` chain (parser.ab, nullGuard), which is not a place.
fun bootstrapIsSafeChain(expression: BootstrapExpression): bool =
    (expression.kind == "block" || expression.kind == "if") && expression.text == "?."

/** A place made only of names, literals, fields and indexes: reading it twice
 *  has no effects. */
fun bootstrapRereadablePlace(expression: BootstrapExpression): bool {
    if (expression.kind == "identifier" || expression.kind == "integer" ||
        expression.kind == "string") return true
    if (expression.kind != "member" && expression.kind != "index" &&
        expression.kind != "delegate.project") return false
    for (child in expression.children) if (!bootstrapRereadablePlace(child)) return false
    true
}
