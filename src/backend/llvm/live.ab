import "analysis.ab"
import "bindings.ab"
import "core.ab"
import "debug.ab"
import "functions.ab"
import "../../codegen_units.ab"
import "../../ir.ab"
import "../../module_paths.ab"
import "abla/unsafe/memory/raw"
import "abla/unsafe/memory"
import "abla/llvm/orc"
import "abla/sys/linux"
import "abla/sys/linux/fs"
import "abla/sys/linux/process"
import "abla/text"
import "abla/integer"
import "live_lambdas.ab"

// `ablac run --live` (docs/design/live-jit.md): every function of the program's own source files is
// called through one table of code pointers, so that a later generation can redefine it while the
// program runs. The table is `abla_live_table`, a pointer to an immutable array of entries
// (`abla_live_entries` for the first generation); a redefinition publishes a new array with one
// release store. Each such function's `<symbol>_direct` becomes a trampoline: load the table
// (acquire), load the entry, call it with the same arguments. Its body is renamed
// `<symbol>_live<generation>` and every use of the old function (direct calls, its wrapper, its own
// recursion) is redirected to the trampoline, so nothing at a call site changes and function values,
// closures and thread entries (which reach a body through its wrapper) all take the newest body.
// LLVM may inline a trampoline into its callers (a caller then loads the table itself) but never a
// body: its only reference is the table, which is not constant.
//
// Then the data (every global, each private constant named after its contents) and the table's functions
// get hidden external names (bootstrapLlvmLivePromote), so a later generation, a module of its own in the
// same JITDylib, can name them; the other functions stay internal and a generation has its own copies.
// A generation is the whole program compiled again;
// the live pass then cuts it down (bootstrapLlvmLiveCut): what the first generation defines becomes a
// declaration of it, a body whose code is unchanged goes, and what is left is the changed bodies, new
// functions and the code only they need.

noescape extern:"c" fun LLVMSetTailCall(call: i64*, isTailCall: i32): void

// What the program as loaded defines, kept in the compiler between reloads (generation 0 sets it,
// each applied reload extends it): the table index of each live function's direct symbol, each
// entry's body hash, and the name of every definition in the JITDylib.
var bootstrapLlvmLiveIndices: Map<string, int> = Map()
var bootstrapLlvmLiveHashes: array<int> = []
var bootstrapLlvmLiveNames: array<string> = []
var bootstrapLlvmLiveDefined: Map<string, int> = Map()
// Each entry's source text hash (bootstrapLlvmLiveSourceHashes), each named function's symbol by its
// readable name, and the classes' layouts (bootstrapLlvmLiveClassLayouts), as the program was loaded.
var bootstrapLlvmLiveSources: array<int> = []
var bootstrapLlvmLiveLabels: Map<string, string> = Map()
var bootstrapLlvmLiveClasses = ""

// The result of the last live pass: the number of functions through the table, and for a reload
// the entries it redefines or adds (their index, body symbol and hash), and why it is refused.
var bootstrapLlvmLiveCount = 0
var bootstrapLlvmLiveTableSize = 0
var bootstrapLlvmLiveChangedIndices: array<int> = []
var bootstrapLlvmLiveChangedBodies: array<string> = []
var bootstrapLlvmLiveChangedHashes: array<int> = []
var bootstrapLlvmLiveChangedLabels: array<string> = []
var bootstrapLlvmLiveChangedSymbols: array<string> = []
var bootstrapLlvmLiveRefusals: array<string> = []
// The definitions a reload's module keeps (added to bootstrapLlvmLiveDefined once it is applied).
var bootstrapLlvmLiveKept: array<string> = []
// Every entry's slot and source hash in a reload, recorded as the program's once it is applied.
var bootstrapLlvmLivePendingSlots: array<int> = []
var bootstrapLlvmLivePendingSources: array<int> = []
// The functions the running program takes as values (function.ref, closure.create: any function of any module,
// a lambda's body among them), by direct symbol: a changed signature applies only to one it never took
// (bootstrapLlvmLiveSignatureRefusal). A reload's are added once it is applied, with the labels whose
// function moved to a new symbol.
var bootstrapLlvmLiveTaken: Map<string, int> = Map()
var bootstrapLlvmLivePendingTaken: array<string> = []
var bootstrapLlvmLivePendingMovedLabels: array<string> = []
var bootstrapLlvmLivePendingMovedSymbols: array<string> = []
// What a reload that applies says about each function that moved (live_watch.ab prints them under --watch).
var bootstrapLlvmLiveMovedNotes: array<string> = []
var bootstrapLlvmLivePendingMovedNames: array<string> = []


// A function of the program's own source files: not the standard library's, the runtime's or a
// naked or sectioned one (those keep their exact code).
fun bootstrapLlvmLiveFunction(function: BootstrapIrFunction, stdlibRoot: string): bool {
    if (function.naked || function.section != "") return false
    if (bootstrapLlvmRuntimeFunction(function)) return false
    if (bootstrapLlvmModuleInitializer(function.name)) return false
    val file = bootstrapIrSourcePositionFile(function.position)
    if (file < 0 || file >= bootstrapIrSourceFiles.size) return false
    val path = bootstrapNormalizeModulePath(bootstrapIrSourceFiles[file])
    !(stdlibRoot != "" && path.startsWith(stdlibRoot))
}

// A lambda's function (ir.ab names it `<owner>_lambda_<begin>_<end>_<n>`, offsets in its owner): an
// edit before it in its owner renames it, so a reload does not redefine one (stage 3 gives a reload's
// new lambdas ids of their own).
fun bootstrapLlvmLiveLambda(name: string): bool = name.contains("lambda_")

// A body's code as a number: its printed IR with its own name (which has the generation in it) and
// the metadata attachments (debug locations) left out. The constants it names are named after their
// contents by then, and everything else it names by symbol, so two compiles of the same code agree.
trusted fun bootstrapLlvmLiveBodyHash(body: i64*): int {
    val name = bootstrapLlvmDebugValueName(body)
    val printed = LLVMPrintValueToString(body)
    val text = nativeCString(printed)
    LLVMDisposeMessage(printed)
    // ABLA_LIVE_DUMP=<directory>: each hashed body as printed, per generation, to compare two compiles.
    val dump = linuxEnvironment("ABLA_LIVE_DUMP")
    if (dump.found && dump.value != "") {
        Path("${dump.value}/${bootstrapLlvmLiveGeneration}-$name.ll").writeText(text)
    }
    var hash = 1469598103
    var index = 0
    while (index < text.size) {
        val character = text[index]
        // `!dbg !12`, `!tbaa !3`: an attachment runs to the end of its token; so does an attribute group
        // (`#12`), which the module numbers.
        if (character == 35 && index + 1 < text.size && text[index + 1] >= 48 && text[index + 1] <=
            57) {
            index = index + 1
            while (index < text.size && text[index] >= 48 && text[index] <= 57) index = index + 1
            continue
        }
        if (character == 33) {
            while (index < text.size && text[index] != 10 && text[index] != 44 &&
                text[index] != 32) index = index + 1
            continue
        }
        if (character == 64 && index + 1 + name.size <= text.size &&
            text.slice(index + 1, index + 1 + name.size) == name) {
            hash = bootstrapCodegenMix(hash, 7)
            index = index + 1 + name.size
            continue
        }
        hash = bootstrapCodegenMix(hash, character)
        index = index + 1
    }
    hash
}

fun bootstrapLlvmLiveReset(): void {
    bootstrapLlvmLiveIndices = Map()
    bootstrapLlvmLiveHashes = []
    bootstrapLlvmLiveSources = []
    bootstrapLlvmLiveNames = []
    bootstrapLlvmLiveLabels = Map()
    bootstrapLlvmLiveClasses = ""
    bootstrapLlvmLiveDefined = Map()
    bootstrapLlvmLiveRuntimeIds = Map()
    bootstrapLlvmLiveRuntimeIdsTaken = Map()
    bootstrapLlvmLiveTaken = Map()
    return
}

// Each entry's source text as a number: from its declaration to the next named function's in the same
// file (or the file's end). Two compiles of a function whose text is the same agree, wherever it moved.
fun bootstrapLlvmLiveSourceHashes(program: BootstrapIrProgram, functions: array<int>): array<int> {
    val starts: array<int> = []
    for (function in program.functions) {
        if (function.position >= 0 &&
            !bootstrapLlvmLiveLambda(function.name)) starts.append(function.position)
    }
    val texts: Map<int, string> = Map()
    val hashes: array<int> = []
    for (index in functions) {
        val position = program.functions[index].position
        val file = bootstrapIrSourcePositionFile(position)
        val offset = bootstrapIrSourcePositionOffset(position)
        var text = texts.get(file)
        if (text == null) {
            val read = if (file >= 0 && file < bootstrapIrSourceFiles.size)
                Path(bootstrapIrSourceFiles[file]).readText() else ""
            texts.set(file, read)
            text = read
        }
        val source = text ?? ""
        var end = source.size
        for (start in starts) {
            if (bootstrapIrSourcePositionFile(start) == file) {
                val other = bootstrapIrSourcePositionOffset(start)
                if (other > offset && other < end) end = other
            }
        }
        val begin = if (offset >= 0 && offset <= source.size) offset else source.size
        hashes.append(bootstrapCodegenTextHash(source.slice(begin, if (end < begin) begin else end),
            13))
    }
    hashes
}

// The program's classes as one text: each one's name, id, fields, their places and its size, in order.
fun bootstrapLlvmLiveClassLayouts(program: BootstrapIrProgram): string {
    var text = ""
    for (type in program.classes) {
        text = text +
            "${type.name} ${type.id} ${type.fields.join(",")} ${bootstrapLlvmLiveJoinInts(type.fieldPlaces)} ${type.size}\n"
    }
    text
}

// The first class whose layout differs between two class texts, for the refusal.
fun bootstrapLlvmLiveLayoutChange(before: string, after: string): string {
    val earlier = before.split("\n")
    val later = after.split("\n")
    var line = 0
    while (line < earlier.size || line < later.size) {
        val was = if (line < earlier.size) earlier[line] else ""
        val now = if (line < later.size) later[line] else ""
        if (was != now) {
            val name = (if (now != "") now else was).split(" ")[0]
            return if (was == "") "class $name was added" else if (now ==
                "") "class ${was.split(" ")[0]} was removed"
                else "class $name changed"
        }
        line = line + 1
    }
    "the classes changed"
}

fun bootstrapLlvmLiveJoinInts(values: array<int>): string {
    var text = ""
    for (value in values) text = if (text == "") "$value" else "$text,$value"
    text
}

fun bootstrapLlvmLiveLabelOf(program: BootstrapIrProgram, name: string): string {
    for (function in program.functions) {
        if (function.name == name) return if (function.label != "") function.label else name
    }
    name
}

trusted fun bootstrapLlvmLiveIndirect(
    backend: BootstrapLlvmBackend,
    program: BootstrapIrProgram,
    identities: BootstrapLlvmFunctionIdentities,
    emitted: array<bool>
): void {
    val generation = bootstrapLlvmLiveGeneration
    bootstrapLlvmLiveCount = 0
    bootstrapLlvmLiveChangedIndices = []
    bootstrapLlvmLiveChangedBodies = []
    bootstrapLlvmLiveChangedHashes = []
    bootstrapLlvmLiveChangedLabels = []
    bootstrapLlvmLiveChangedSymbols = []
    bootstrapLlvmLiveRefusals = []
    bootstrapLlvmLiveKept = []
    bootstrapLlvmLivePendingTaken = []
    bootstrapLlvmLivePendingMovedLabels = []
    bootstrapLlvmLivePendingMovedSymbols = []
    bootstrapLlvmLivePendingMovedNames = []
    bootstrapLlvmLiveMovedNotes = []
    val changedFunctions: array<int> = []
    // What this compile takes as a value: the program's own once loaded, a reload's once applied.
    val takenNames: array<string> = []
    for (function in program.functions) takenNames.append(function.name)
    val taken = bootstrapLlvmAddressTaken(program, bootstrapLlvmNameIndex(takenNames))
    var takenIndex = 0
    while (takenIndex < taken.size && takenIndex < identities.symbols.size) {
        if (taken[takenIndex]) {
            val takenSymbol = bootstrapLlvmDirectFunctionSymbol(identities.symbols[takenIndex])
            bootstrapLlvmLivePendingTaken.append(takenSymbol)
        }
        takenIndex = takenIndex + 1
    }
    // The functions of this reload that moved to a new symbol (a changed signature that applies): callers
    // that compile differently only for them are not refused (they call the new entry; old code keeps the old).
    val moved: Map<string, int> = Map()
    // The lambdas' refusals (live_lambdas.ab, before the backend).
    for (refusal in bootstrapLlvmLiveLambdaRefusals) bootstrapLlvmLiveRefusals.append(refusal)
    // The registry of lambdas reloads add (dispatch.ab): the program as loaded always defines it, so a reload
    // finds it defined and names it.
    if (pointerIsNull(LLVMGetNamedGlobal(backend.module, "abla_live_lambdas"))) {
        val registry = LLVMAddGlobal(backend.module, backend.pointerType, "abla_live_lambdas")
        LLVMSetAlignment(registry, i32(8))
        LLVMSetInitializer(registry, LLVMConstNull(backend.pointerType))
    }
    bootstrapLlvmLivePendingSlots = []
    bootstrapLlvmLivePendingSources = []
    if (generation == 0) {
        bootstrapLlvmLiveReset()
        // The program as loaded: what it takes is the running code's from the start.
        for (symbol in bootstrapLlvmLivePendingTaken) bootstrapLlvmLiveTaken.set(symbol, 1)
    }
    val root = bootstrapNormalizeModulePath(bootstrapStandardLibraryRoot())
    val stdlibRoot = if (root.endsWith("/")) root else root + "/"
    val originals: array<i64*> = []
    val functions: array<int> = []
    val slots: array<int> = []
    var appended = bootstrapLlvmLiveNames.size
    var index = 0
    while (index < program.functions.size) {
        if (index < emitted.size && emitted[index] &&
            bootstrapLlvmLiveFunction(program.functions[index], stdlibRoot)) {
            val symbol = bootstrapLlvmDirectFunctionSymbol(identities.symbols[index])
            val original = LLVMGetNamedFunction(backend.module, symbol)
            if (!pointerIsNull(original) && LLVMIsDeclaration(original) == 0) {
                originals.append(original)
                functions.append(index)
                val known = bootstrapLlvmLiveIndices.get(symbol)
                if (known != null) slots.append(known)
                else {
                    slots.append(if (generation == 0) slots.size else appended)
                    if (generation != 0) appended = appended + 1
                }
            }
        }
        index = index + 1
    }
    val count = originals.size
    var size = if (generation == 0) count else appended
    if (count == 0 && generation == 0) return
    LLVMSetCurrentDebugLocation2(backend.builder, nativeNullPointer())
    val tableType = LLVMArrayType2(backend.pointerType, if (size > 0) size else 1)
    val table = LLVMAddGlobal(backend.module, backend.pointerType, "abla_live_table")
    LLVMSetAlignment(table, i32(8))
    val bodies: array<i64*> = []
    var entry = 0
    while (entry < count) {
        val original = originals[entry]
        val function = program.functions[functions[entry]]
        val name = bootstrapLlvmDirectFunctionSymbol(identities.symbols[functions[entry]])
        val type = LLVMGlobalGetValueType(original)
        val renamed = "${name}_live$generation"
        LLVMSetValueName2(original, renamed, renamed.size)
        val trampoline = LLVMAddFunction(backend.module, name, type)
        LLVMSetLinkage(trampoline, llvmInternalLinkage())
        LLVMSetFunctionCallConv(trampoline, LLVMGetFunctionCallConv(original))
        val sret = bootstrapLlvmDirectResultUsesOutput(function)
        if (sret) bootstrapLlvmAddSret(backend, trampoline, false)
        LLVMReplaceAllUsesWith(original, trampoline)
        val block = LLVMAppendBasicBlockInContext(backend.context, trampoline, "entry")
        LLVMPositionBuilderAtEnd(backend.builder, block)
        val current = LLVMBuildLoad2(backend.builder, backend.pointerType, table, "live.table")
        LLVMSetAlignment(current, i32(8))
        // Acquire: the entries of a newly published array are visible before its pointer.
        LLVMSetOrdering(current, i32(4))
        val slot = bootstrapLlvmArrayElement(backend, tableType, current, slots[entry], "live.slot")
        val target = LLVMBuildLoad2(backend.builder, backend.pointerType, slot, "live.body")
        LLVMSetAlignment(target, i32(8))
        val arguments: array<i64*> = []
        val parameters = int(LLVMCountParams(trampoline))
        var parameter = 0
        while (parameter < parameters) {
            arguments.append(LLVMGetParam(trampoline, i32(parameter)))
            parameter = parameter + 1
        }
        val call = bootstrapLlvmCallTyped(backend, type, target, arguments, "")
        if (sret) bootstrapLlvmAddSret(backend, call, true)
        LLVMSetInstructionCallConv(call, LLVMGetFunctionCallConv(original))
        LLVMSetTailCall(call, 1)
        // LLVMVoidTypeKind is 0.
        if (LLVMGetTypeKind(LLVMGetReturnType(type)) == 0) LLVMBuildRetVoid(backend.builder)
        else LLVMBuildRet(backend.builder, call)
        bodies.append(original)
        entry = entry + 1
    }
    // The first generation's entries; a reload's array is the compiler's (bootstrapLiveReload).
    val entries = LLVMAddGlobal(backend.module, tableType, "abla_live_entries")
    if (generation == 0) {
        val elements = bootstrapLlvmPointerArguments(backend, bodies)
        LLVMSetInitializer(entries, LLVMConstArray2(backend.pointerType, elements, count))
        bootstrapLlvmDropPointerArguments(backend, elements)
    } else {
        LLVMSetInitializer(entries, LLVMConstNull(tableType))
    }
    LLVMSetInitializer(table, entries)
    // The program reaches the compiler's reload through `abla_live_host` (ablaLiveHost()).
    val host = LLVMGetNamedGlobal(backend.module, "abla_live_host")
    if (!pointerIsNull(host)) {
        val reloadType = bootstrapLlvmFunctionType(
            backend, backend.i64Type, [backend.pointerType, backend.i64Type]
        )
        var reload = LLVMGetNamedFunction(backend.module, "ablac_live_reload")
        if (pointerIsNull(reload)) reload = LLVMAddFunction(backend.module, "ablac_live_reload",
            reloadType)
        LLVMSetInitializer(host, LLVMConstPtrToInt(reload, backend.i64Type))
    }
    // The data (every global, constants named after their contents), the trampolines and the bodies get
    // hidden external names; other functions stay internal, optimized as in any build.
    bootstrapLlvmLivePromote(backend.module, bodies)
    val sources = bootstrapLlvmLiveSourceHashes(program, functions)
    val layouts = bootstrapLlvmLiveClassLayouts(program)
    if (generation == 0) {
        bootstrapLlvmLiveClasses = layouts
    } else if (layouts != bootstrapLlvmLiveClasses) {
        bootstrapLlvmLiveRefusals.append(
            "E_LIVE_LAYOUT: ${bootstrapLlvmLiveLayoutChange(bootstrapLlvmLiveClasses, layouts)}: instances made by the running code keep the old layout"
        )
    }
    // A reload's entries whose code changed though their source did not (E_LIVE_CALLER, below), and the
    // functions whose source the edit changed.
    val callers: array<int> = []
    val edited: Map<string, int> = Map()
    entry = 0
    while (entry < count) {
        val body = bodies[entry]
        val hash = bootstrapLlvmLiveBodyHash(body)
        val function = program.functions[functions[entry]]
        val label = function.label
        val shown = if (label != "") label else function.name
        val symbol = bootstrapLlvmDirectFunctionSymbol(identities.symbols[functions[entry]])
        val slot = slots[entry]
        if (generation == 0) {
            bootstrapLlvmLiveIndices.set(symbol, slot)
            bootstrapLlvmLiveHashes.append(hash)
            bootstrapLlvmLiveSources.append(sources[entry])
            bootstrapLlvmLiveNames.append(shown)
            bootstrapLlvmLiveLabels.set(shown, symbol)
        } else {
            bootstrapLlvmLivePendingSlots.append(slot)
            bootstrapLlvmLivePendingSources.append(sources[entry])
            val known = slot < bootstrapLlvmLiveSources.size
            if (!known || bootstrapLlvmLiveSources[slot] !=
                sources[entry]) edited.set(function.name, 1)
            if (!known) {
                // A function the program has under another symbol: its parameters or result changed. It
                // moves to a new entry, and the running code keeps calling the old one, which is consistent
                // unless something made by the running code reaches the old one from new code.
                val before = bootstrapLlvmLiveLabels.get(shown)
                if (before != null && before != symbol && !bootstrapLlvmLiveLambda(function.name)) {
                    val why = bootstrapLlvmLiveSignatureRefusal(shown, before)
                    if (why != "") {
                        bootstrapLlvmLiveRefusals.append(
                            "E_LIVE_SIGNATURE: $shown: its parameters or result changed; $why"
                        )
                    } else {
                        moved.set(function.name, 1)
                        bootstrapLlvmLivePendingMovedLabels.append(shown)
                        bootstrapLlvmLivePendingMovedSymbols.append(symbol)
                        bootstrapLlvmLivePendingMovedNames.append(function.name)
                    }
                }
            }
        }
        if (generation != 0 && (slot >= bootstrapLlvmLiveHashes.size ||
            bootstrapLlvmLiveHashes[slot] != hash)) {
            if (bootstrapLlvmLiveLambda(function.name)) {
                // An edited lambda took the running code's name (live_lambdas.ab) and is redefined like a
                // named function; one whose text is the same must compile to the same code.
                if (bootstrapLlvmLiveLambdaUnchanged.get(function.name) != null) {
                    bootstrapLlvmLiveRefusals.append(
                        "E_LIVE_CALLER: $shown (unchanged) would compile differently: it depends on a change it calls"
                    )
                }
            } else if (slot < bootstrapLlvmLiveSources.size && bootstrapLlvmLiveSources[slot] ==
                sources[entry]) {
                callers.append(entry)
            }
            bootstrapLlvmLiveChangedIndices.append(slot)
            changedFunctions.append(functions[entry])
            bootstrapLlvmLiveChangedBodies.append(bootstrapLlvmDebugValueName(body))
            bootstrapLlvmLiveChangedHashes.append(hash)
            bootstrapLlvmLiveChangedLabels.append(shown)
            bootstrapLlvmLiveChangedSymbols.append(
                bootstrapLlvmDirectFunctionSymbol(identities.symbols[functions[entry]])
            )
        }
        entry = entry + 1
    }
    // The rule (docs/design/live-jit.md, stage 0): a function the edit did not touch must compile to the
    // same code, or the running code relies on a fact about a callee that changed.
    for (caller in callers) {
        val function = program.functions[functions[caller]]
        val shown = if (function.label != "") function.label else function.name
        val names: array<string> = []
        var inPlace = false
        for (instruction in function.instructions) {
            if (instruction.opcode == "call" && edited.get(instruction.text) != null) {
                if (moved.get(instruction.text) == null) inPlace = true
                val callee = bootstrapLlvmLiveLabelOf(program, instruction.text)
                var listed = false
                for (name in names) if (name == callee) listed = true
                if (!listed) names.append(callee)
            }
        }
        // It calls only callees that moved to new entries: the running code keeps their old ones, so the old
        // caller relies on nothing that changed, and this one is redefined to call the new entries.
        if (names.size > 0 && !inPlace) continue
        val because = if (names.size == 0) "after this edit"
            else if (names.size == 1) "it calls ${names[0]}, whose change it depends on"
            else "it calls ${names.join(", ")}, whose changes it depends on"
        bootstrapLlvmLiveRefusals
            .append("E_LIVE_CALLER: $shown (unchanged) would compile differently: $because")
    }
    // Each function that moved, and the redefined functions that call it: the new signature reaches the program
    // when one of those is entered again (a caller that never returns keeps its old body).
    var movedIndex = 0
    while (movedIndex < bootstrapLlvmLivePendingMovedNames.size) {
        val movedName = bootstrapLlvmLivePendingMovedNames[movedIndex]
        val callerLabels: array<string> = []
        for (changed in changedFunctions) {
            val caller = program.functions[changed]
            if (caller.name != movedName) {
                var calls = false
                for (instruction in caller.instructions) {
                    if (instruction.opcode == "call" && instruction.text == movedName) calls = true
                }
                val callerLabel = if (caller.label != "") caller.label else caller.name
                var listed = false
                for (known in callerLabels) if (known == callerLabel) listed = true
                if (calls && !listed) callerLabels.append(callerLabel)
            }
        }
        val callersText = if (callerLabels.size == 0) "none" else callerLabels.join(", ")
        bootstrapLlvmLiveMovedNotes.append(
            "live: ${bootstrapLlvmLivePendingMovedLabels[movedIndex]}'s signature changed; callers redefined: $callersText (it applies when they are entered again)"
        )
        movedIndex = movedIndex + 1
    }
    bootstrapLlvmLiveCount = count
    bootstrapLlvmLiveTableSize = size
    if (generation != 0) bootstrapLlvmLiveLambdaDispatchers(backend.module, program, identities,
        generation)
    if (generation == 0) {
        bootstrapLlvmLiveRecordDefinitions(backend.module)
        var function = 0
        while (function < identities.symbols.size) {
            bootstrapLlvmLiveRuntimeId(identities.symbols[function],
                identities.runtimeIds[function])
            function = function + 1
        }
    }
    else bootstrapLlvmLiveCut(backend.module)
    return
}

// A reload's new functions (its new lambdas among them): their runtime ids and symbols, and this generation's
// dispatchers under names of their own, which the compiler registers for those ids (abla_live_lambdas,
// dispatch.ab) once it is applied; their ids then join the running program's (bootstrapLlvmLiveRuntimeIds).
var bootstrapLlvmLiveLambdaNewIds: array<int> = []
var bootstrapLlvmLiveNewSymbols: array<string> = []
var bootstrapLlvmLiveLambdaCallDispatcher = ""
var bootstrapLlvmLiveLambdaDropDispatcher = ""

trusted fun bootstrapLlvmLiveLambdaDispatchers(
    module: i64*,
    program: BootstrapIrProgram,
    identities: BootstrapLlvmFunctionIdentities,
    generation: int
): void {
    bootstrapLlvmLiveLambdaNewIds = []
    bootstrapLlvmLiveLambdaCallDispatcher = ""
    bootstrapLlvmLiveLambdaDropDispatcher = ""
    bootstrapLlvmLiveNewSymbols = []
    // Every function the running program does not have, a lambda or a named one: a value of it may reach code
    // that was not redefined, whose dispatchers know only the running program's ids.
    var index = 0
    while (index < program.functions.size && index < identities.runtimeIds.size) {
        if (bootstrapLlvmLiveRuntimeIds.get(identities.symbols[index]) == null) {
            bootstrapLlvmLiveLambdaNewIds.append(identities.runtimeIds[index])
            bootstrapLlvmLiveNewSymbols.append(identities.symbols[index])
        }
        index = index + 1
    }
    if (bootstrapLlvmLiveLambdaNewIds.size == 0) return
    val call = LLVMGetNamedFunction(module, "abla_llvm_call_indirect")
    val drop = LLVMGetNamedFunction(module, "abla_llvm_drop_closure")
    if (!pointerIsNull(call) && LLVMIsDeclaration(call) == 0) {
        bootstrapLlvmLiveLambdaCallDispatcher = "abla_llvm_call_indirect_live$generation"
        LLVMSetValueName2(call, bootstrapLlvmLiveLambdaCallDispatcher,
            bootstrapLlvmLiveLambdaCallDispatcher.size)
        LLVMSetLinkage(call, llvmExternalLinkage())
        LLVMSetVisibility(call, llvmHiddenVisibility())
    }
    if (!pointerIsNull(drop) && LLVMIsDeclaration(drop) == 0) {
        bootstrapLlvmLiveLambdaDropDispatcher = "abla_llvm_drop_closure_live$generation"
        LLVMSetValueName2(drop, bootstrapLlvmLiveLambdaDropDispatcher,
            bootstrapLlvmLiveLambdaDropDispatcher.size)
        LLVMSetLinkage(drop, llvmExternalLinkage())
        LLVMSetVisibility(drop, llvmHiddenVisibility())
    }
    return
}

// What a generation can link against: the definitions with an external name (local ones are the
// module's own).
trusted fun bootstrapLlvmLiveVisible(value: i64*): bool {
    val linkage = LLVMGetLinkage(value)
    linkage != llvmInternalLinkage() && linkage != i32(9)
}

// Gives the data and the table's functions (trampolines and bodies) hidden external names, as
// codegen_units.ab's promotion does for every symbol: a generation shares the program's state (variables,
// class descriptors, constants) and reaches its functions through the table, and brings its own copies
// of the other functions it calls.
trusted fun bootstrapLlvmLivePromote(module: i64*, bodies: array<i64*>): void {
    bootstrapCodegenNameConstants(module)
    var anonymous = 0
    var global = LLVMGetFirstGlobal(module)
    while (!pointerIsNull(global)) {
        if (LLVMIsDeclaration(global) == 0) anonymous = bootstrapCodegenPromoteValue(global,
            anonymous)
        global = LLVMGetNextGlobal(global)
    }
    for (body in bodies) {
        val name = bootstrapLlvmDebugValueName(body)
        val trampoline = LLVMGetNamedFunction(module, name.slice(0, name.lastIndexOf("_live")))
        if (!pointerIsNull(trampoline)) anonymous = bootstrapCodegenPromoteValue(trampoline,
            anonymous)
        anonymous = bootstrapCodegenPromoteValue(body, anonymous)
    }
    return
}

trusted fun bootstrapLlvmLiveRecordDefinitions(module: i64*): void {
    var function = LLVMGetFirstFunction(module)
    while (!pointerIsNull(function)) {
        if (LLVMIsDeclaration(function) == 0 &&
            bootstrapLlvmLiveVisible(function)) bootstrapLlvmLiveDefined
            .set(bootstrapLlvmDebugValueName(function), 1)
        function = LLVMGetNextFunction(function)
    }
    var global = LLVMGetFirstGlobal(module)
    while (!pointerIsNull(global)) {
        if (LLVMIsDeclaration(global) == 0 && bootstrapLlvmLiveVisible(global)) {
            bootstrapLlvmLiveDefined.set(bootstrapLlvmDebugValueName(global), 1)
        }
        global = LLVMGetNextGlobal(global)
    }
    var alias = LLVMGetFirstGlobalAlias(module)
    while (!pointerIsNull(alias)) {
        bootstrapLlvmLiveDefined.set(bootstrapLlvmDebugValueName(alias), 1)
        alias = LLVMGetNextGlobalAlias(alias)
    }
    return
}

fun bootstrapLlvmLiveIsDefined(name: string): bool = bootstrapLlvmLiveDefined.get(name) != null

// Cuts a reload's module down: everything the JITDylib already defines becomes a declaration of it
// (as codegen_units.ab's unit strip does for other units), a body whose code did not change goes, the
// `llvm.*` arrays and module assembly go, and what is left must be code: a variable the program does
// not have yet is refused (its initializer never ran: E_LIVE_GLOBAL).
trusted fun bootstrapLlvmLiveCut(module: i64*): void {
    val changed: Map<string, int> = Map()
    for (body in bootstrapLlvmLiveChangedBodies) changed.set(body, 1)
    val arrays: array<int> = []
    var global = LLVMGetFirstGlobal(module)
    while (!pointerIsNull(global)) {
        val name = bootstrapLlvmDebugValueName(global)
        if (bootstrapCodegenLlvmName(name)) {
            arrays.append(nativePointerAddress(global))
        } else if (LLVMIsDeclaration(global) == 0) {
            if (bootstrapLlvmLiveIsDefined(name)) {
                LLVMSetInitializer(global, nativeNullPointer())
                LLVMSetLinkage(global, i32(0))
                LLVMGlobalClearMetadata(global)
            } else if (LLVMIsGlobalConstant(global) == 0) {
                bootstrapLlvmLiveRefusals.append(
                    "E_LIVE_GLOBAL: a variable the running program does not have ($name): its initializer would not run"
                )
            } else bootstrapLlvmLiveKept.append(name)
        }
        global = LLVMGetNextGlobal(global)
    }
    for (array in arrays) LLVMDeleteGlobal(nativePointerFromAddress(array))
    LLVMSetModuleInlineAsm2(module, "", 0)
    val declared: array<int> = []
    val dropped: array<int> = []
    var function = LLVMGetFirstFunction(module)
    while (!pointerIsNull(function)) {
        if (LLVMIsDeclaration(function) == 0) {
            val name = bootstrapLlvmDebugValueName(function)
            if (bootstrapLlvmLiveIsDefined(name)) declared.append(nativePointerAddress(function))
            else if (name.contains("_direct_live") && changed.get(name) == null) {
                dropped.append(nativePointerAddress(function))
            } else if (bootstrapLlvmLiveVisible(function)) bootstrapLlvmLiveKept.append(name)
        }
        function = LLVMGetNextFunction(function)
    }
    for (other in declared) bootstrapCodegenDeclareFunction(module, nativePointerFromAddress(other))
    for (body in dropped) {
        val value = nativePointerFromAddress(body)
        if (pointerIsNull(LLVMGetFirstUse(value))) LLVMDeleteFunction(value)
        else bootstrapCodegenDeclareFunction(module, value)
    }
    var stub = nativeNullPointer()
    var alias = LLVMGetFirstGlobalAlias(module)
    while (!pointerIsNull(alias)) {
        val name = bootstrapLlvmDebugValueName(alias)
        if (bootstrapLlvmLiveIsDefined(name)) {
            val type = LLVMGlobalGetValueType(alias)
            LLVMSetValueName2(alias, "", 0)
            val declaration = if (LLVMGetTypeKind(type) == i32(9))
                LLVMAddFunction(module, name, type)
                else LLVMAddGlobal(module, type, name)
            LLVMSetVisibility(declaration, LLVMGetVisibility(alias))
            LLVMReplaceAllUsesWith(alias, declaration)
            if (pointerIsNull(stub)) stub = bootstrapCodegenAliasStub(module)
            LLVMAliasSetAliasee(alias, stub)
            LLVMSetLinkage(alias, i32(9))
        } else bootstrapLlvmLiveKept.append(name)
        alias = LLVMGetNextGlobalAlias(alias)
    }
    return
}

// After a reload's module is in the JITDylib: what it defines is now the program's, and the changed
// entries' hashes are its.
fun bootstrapLlvmLiveApplied(): void {
    bootstrapLlvmLiveLambdaApplied()
    for (symbol in bootstrapLlvmLivePendingTaken) bootstrapLlvmLiveTaken.set(symbol, 1)
    // A function that moved is known by its new symbol from now on: a later change compares with it.
    var moving = 0
    while (moving < bootstrapLlvmLivePendingMovedLabels.size) {
        bootstrapLlvmLiveLabels.set(bootstrapLlvmLivePendingMovedLabels[moving],
            bootstrapLlvmLivePendingMovedSymbols[moving])
        moving = moving + 1
    }
    var added = 0
    while (added < bootstrapLlvmLiveNewSymbols.size) {
        bootstrapLlvmLiveRuntimeId(bootstrapLlvmLiveNewSymbols[added],
            bootstrapLlvmLiveLambdaNewIds[added])
        added = added + 1
    }
    for (name in bootstrapLlvmLiveKept) bootstrapLlvmLiveDefined.set(name, 1)
    var pending = 0
    while (pending < bootstrapLlvmLivePendingSlots.size) {
        val slot = bootstrapLlvmLivePendingSlots[pending]
        while (bootstrapLlvmLiveSources.size <= slot) bootstrapLlvmLiveSources.append(0)
        bootstrapLlvmLiveSources[slot] = bootstrapLlvmLivePendingSources[pending]
        pending = pending + 1
    }
    var change = 0
    while (change < bootstrapLlvmLiveChangedIndices.size) {
        val slot = bootstrapLlvmLiveChangedIndices[change]
        while (bootstrapLlvmLiveHashes.size <= slot) {
            bootstrapLlvmLiveHashes.append(0)
            bootstrapLlvmLiveNames.append("")
        }
        bootstrapLlvmLiveHashes[slot] = bootstrapLlvmLiveChangedHashes[change]
        bootstrapLlvmLiveNames[slot] = bootstrapLlvmLiveChangedLabels[change]
        bootstrapLlvmLiveIndices.set(bootstrapLlvmLiveChangedSymbols[change], slot)
        if (bootstrapLlvmLiveLabels.get(bootstrapLlvmLiveChangedLabels[change]) == null) {
            bootstrapLlvmLiveLabels.set(bootstrapLlvmLiveChangedLabels[change],
                bootstrapLlvmLiveChangedSymbols[change])
        }
        change = change + 1
    }
    return
}

// The compiler's record of a live program as text, kept beside its cached object (`<object>.live`), so a
// live run that starts from the object cache can still reload: one line per table entry, named function,
// definition and class, and the table's size.
fun bootstrapLlvmLiveRecordText(): string {
    var text = "abla-live 3\nsize\t$bootstrapLlvmLiveTableSize\n"
    var slot = 0
    while (slot < bootstrapLlvmLiveHashes.size) {
        text = text +
            "entry\t$slot\t${bootstrapLlvmLiveHashes[slot]}\t${bootstrapLlvmLiveSources[slot]}\t${bootstrapLlvmLiveNames[slot]}\n"
        slot = slot + 1
    }
    for (symbol in bootstrapLlvmLiveIndices.keys()) {
        text = text + "index\t$symbol\t${bootstrapLlvmLiveIndices.get(symbol) ?? -1}\n"
    }
    for (label in bootstrapLlvmLiveLabels.keys()) {
        text = text + "label\t$label\t${bootstrapLlvmLiveLabels.get(label) ?? ""}\n"
    }
    for (name in bootstrapLlvmLiveDefined.keys()) text = text + "defined\t$name\n"
    for (symbol in bootstrapLlvmLiveTaken.keys()) text = text + "taken\t$symbol\n"
    for (line in bootstrapLlvmLiveClasses.split("\n")) if (line != "") text = text +
        "class\t$line\n"
    for (symbol in bootstrapLlvmLiveRuntimeIds.keys()) {
        text = text + "rid\t$symbol\t${bootstrapLlvmLiveRuntimeIds.get(symbol) ?? -1}\n"
    }
    text + bootstrapLlvmLiveLambdaRecordText()
}

// Restores the record from its text; false (and nothing restored) when it is not one.
fun bootstrapLlvmLiveRecordLoad(text: string): bool {
    val lines = text.split("\n")
    if (lines.size == 0 || lines[0] != "abla-live 3") return false
    bootstrapLlvmLiveReset()
    bootstrapLlvmLiveLambdaReset()
    var size = -1
    for (line in lines) {
        val fields = line.split("\t")
        if (fields.size == 2 && fields[0] == "size") size = fields[1].parseInt() ?? -1
        else if (fields.size == 5 && fields[0] == "entry") {
            bootstrapLlvmLiveHashes.append(fields[2].parseInt() ?? 0)
            bootstrapLlvmLiveSources.append(fields[3].parseInt() ?? 0)
            bootstrapLlvmLiveNames.append(fields[4])
        } else if (fields.size == 3 && fields[0] == "index") {
            bootstrapLlvmLiveIndices.set(fields[1], fields[2].parseInt() ?? -1)
        } else if (fields.size == 3 && fields[0] == "label") {
            bootstrapLlvmLiveLabels.set(fields[1], fields[2])
        } else if (fields.size == 2 && fields[0] == "taken") {
            bootstrapLlvmLiveTaken.set(fields[1], 1)
        } else if (fields.size == 2 && fields[0] == "defined") {
            bootstrapLlvmLiveDefined.set(fields[1], 1)
        } else if (fields.size == 2 && fields[0] == "class") {
            bootstrapLlvmLiveClasses = bootstrapLlvmLiveClasses + fields[1] + "\n"
        } else if (fields.size == 6 && fields[0] ==
            "lambda") bootstrapLlvmLiveLambdaRecordLine(fields)
        else if (fields.size == 3 && fields[0] == "rid") bootstrapLlvmLiveRuntimeId(fields[1],
            fields[2].parseInt() ?? -1)
    }
    if (size < 0 || bootstrapLlvmLiveHashes.size == 0) {
        bootstrapLlvmLiveReset()
        return false
    }
    bootstrapLlvmLiveTableSize = size
    bootstrapLlvmLiveCount = bootstrapLlvmLiveHashes.size
    true
}

// Records a function of the running program and its runtime id (it keeps it in every reload).
fun bootstrapLlvmLiveRuntimeId(symbol: string, id: int): void {
    if (bootstrapLlvmLiveRuntimeIds.get(symbol) != null) return
    bootstrapLlvmLiveRuntimeIds.set(symbol, id)
    bootstrapLlvmLiveRuntimeIdsTaken.set(id, 1)
    return
}

// Why a function whose parameters or result changed (now under a new symbol) cannot move to a new entry, or "" when
// it can. The running code keeps calling the old entry, which is consistent; only something the running code made
// that reaches the old function from new code is not: a function value or closure of it, or a call through a
// class (a method or an extension, `Owner.name`, whose dispatch the running classes keep).
fun bootstrapLlvmLiveSignatureRefusal(shown: string, before: string): string =
    if (shown.contains(".")) "callers through its class still reach it the old way"
    else if (bootstrapLlvmLiveTaken.get(before) != null)
        "the running code takes it as a value, and function values, closures and threads it made still call it the old way"
    else ""
