    if (name == "ablaUnsafeCallVoidI32PointerPointer") return [1, 0, 0]
    if (name == "ablaUnsafeCallVoidF32F32F32F32F32F32") return [3, 3, 3, 3, 3, 3]
    if (name == "ablaUnsafeCallVoidI32PointerPointerI32") return [1, 0, 0, 1]
