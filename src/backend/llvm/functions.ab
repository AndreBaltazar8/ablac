            )
            bootstrapLlvmSetNativeValue(
                backend,
                storage,
                instruction.result,
                LLVMBuildSExt(
                    backend.builder,
                    status,
                    backend.i64Type,
                    "unsafe.call.i32.status.i64"
                )
            )
        }
    }
    if (name == "ablaUnsafeCallI32PointerI64") {
        if (instruction.operands.size != 3) supported = false
        if (instruction.operands.size == 3) {
            val type = bootstrapLlvmFunctionType(
                backend,
                backend.i32Type,
                [backend.pointerType, backend.i64Type]
            )
            val function = LLVMBuildIntToPtr(
                backend.builder,
                bootstrapLlvmCoreIntrinsicInteger(
                    backend, storage, instruction.operands[0]
                ),
                backend.pointerType,
                "unsafe.call.i32.pointer-i64"
            )
            val first = LLVMBuildIntToPtr(
                backend.builder,
                bootstrapLlvmCoreIntrinsicInteger(
                    backend, storage, instruction.operands[1]
                ),
                backend.pointerType,
                "unsafe.call.first.pointer"
            )
            val second = bootstrapLlvmCoreIntrinsicInteger(
                backend, storage, instruction.operands[2]
            )
            val status = bootstrapLlvmCallTyped(
                backend,
                type,
                function,
                [first, second],
                "unsafe.call.i32.status"
            )
            bootstrapLlvmSetNativeValue(
                backend,
                storage,
                instruction.result,
                LLVMBuildSExt(
                    backend.builder,
                    status,
                    backend.i64Type,
                    "unsafe.call.i32.status.i64"
                )
            )
        }
    }
    if (name == "ablaUnsafeCallVoidPointerPointer") {
        if (instruction.operands.size != 3) supported = false
        if (instruction.operands.size == 3) {
            val type = bootstrapLlvmFunctionType(
                backend,
                backend.voidType,
                [backend.pointerType, backend.pointerType]
            )
            val function = LLVMBuildIntToPtr(
                backend.builder,
                bootstrapLlvmCoreIntrinsicInteger(
                    backend, storage, instruction.operands[0]
                ),
                backend.pointerType,
                "unsafe.call.void.pointer-pointer"
            )
            val first = LLVMBuildIntToPtr(
                backend.builder,
                bootstrapLlvmCoreIntrinsicInteger(
                    backend, storage, instruction.operands[1]
                ),
                backend.pointerType,
                "unsafe.call.first.pointer"
            )
            val second = LLVMBuildIntToPtr(
                backend.builder,
                bootstrapLlvmCoreIntrinsicInteger(
                    backend, storage, instruction.operands[2]
                ),
                backend.pointerType,
                "unsafe.call.second.pointer"
            )
            bootstrapLlvmCallTyped(
                backend, type, function, [first, second], ""
            )
            bootstrapLlvmInitializeVoidValue(
                backend, storage.values[instruction.result]
            )
        }
    }
    if (name == "ablaUnsafeCallI32Pointer4") {
        if (instruction.operands.size != 5) supported = false
        if (instruction.operands.size == 5) {
            val type = bootstrapLlvmFunctionType(
                backend,
                backend.i32Type,
                [backend.pointerType, backend.pointerType,
                 backend.pointerType, backend.pointerType]
            )
            val function = LLVMBuildIntToPtr(
                backend.builder,
                bootstrapLlvmCoreIntrinsicInteger(
                    backend, storage, instruction.operands[0]
                ),
                backend.pointerType,
                "unsafe.call.i32.pointer4"
            )
            val arguments: array<i64*> = []
            var argument = 1
            while (argument < 5) {
                arguments.append(LLVMBuildIntToPtr(
                    backend.builder,
                    bootstrapLlvmCoreIntrinsicInteger(
                        backend,
                        storage,
                        instruction.operands[argument]
                    ),
                    backend.pointerType,
                    "unsafe.call.pointer.argument"
                ))
                argument = argument + 1
            }
            val status = bootstrapLlvmCallTyped(
                backend,
                type,
                function,
                arguments,
                "unsafe.call.i32.status"
            )
            bootstrapLlvmSetNativeValue(
                backend,
                storage,
                instruction.result,
                LLVMBuildSExt(
                    backend.builder,
                    status,
                    backend.i64Type,
                    "unsafe.call.i32.status.i64"
                )
            )
        }
    }
    if (name == "ablaUnsafeCallI32Pointer3" ||
        name == "ablaUnsafeCallVoidPointer3") {
        if (instruction.operands.size != 4) supported = false
        if (instruction.operands.size == 4) {
            val returnsStatus = name == "ablaUnsafeCallI32Pointer3"
            val type = bootstrapLlvmFunctionType(
                backend,
                if (returnsStatus) backend.i32Type else backend.voidType,
                [backend.pointerType, backend.pointerType,
                 backend.pointerType]
            )
            val function = LLVMBuildIntToPtr(
                backend.builder,
                bootstrapLlvmCoreIntrinsicInteger(
                    backend, storage, instruction.operands[0]
                ),
                backend.pointerType,
                if (returnsStatus) "unsafe.call.i32.pointer3"
                else "unsafe.call.void.pointer3"
            )
            val arguments: array<i64*> = []
            var argument = 1
            while (argument < 4) {
                arguments.append(LLVMBuildIntToPtr(
                    backend.builder,
                    bootstrapLlvmCoreIntrinsicInteger(
                        backend,
                        storage,
                        instruction.operands[argument]
                    ),
                    backend.pointerType,
                    "unsafe.call.pointer.argument"
                ))
                argument = argument + 1
            }
            val result = bootstrapLlvmCallTyped(
                backend,
                type,
                function,
                arguments,
                if (returnsStatus) "unsafe.call.i32.status" else ""
            )
            if (returnsStatus) {
                bootstrapLlvmSetNativeValue(
                    backend,
                    storage,
                    instruction.result,
                    LLVMBuildSExt(
                        backend.builder,
                        result,
                        backend.i64Type,
                        "unsafe.call.i32.status.i64"
                    )
                )
            } else {
                bootstrapLlvmInitializeVoidValue(
                    backend, storage.values[instruction.result]
                )
            }
        }
    }
    if (name == "ablaUnsafeCallVoidPointerIntPointer") {
        if (instruction.operands.size != 4) supported = false
        if (instruction.operands.size == 4) {
            val type = bootstrapLlvmFunctionType(
                backend,
                backend.voidType,
                [backend.pointerType, backend.i64Type, backend.pointerType]
            )
            val function = LLVMBuildIntToPtr(
                backend.builder,
                bootstrapLlvmCoreIntrinsicInteger(
                    backend, storage, instruction.operands[0]
                ),
                backend.pointerType,
                "unsafe.call.void.pointer-int-pointer"
            )
            val first = LLVMBuildIntToPtr(
                backend.builder,
                bootstrapLlvmCoreIntrinsicInteger(
                    backend, storage, instruction.operands[1]
                ),
                backend.pointerType,
                "unsafe.call.first.pointer"
            )
            val second = bootstrapLlvmCoreIntrinsicInteger(
                backend, storage, instruction.operands[2]
            )
            val third = LLVMBuildIntToPtr(
                backend.builder,
                bootstrapLlvmCoreIntrinsicInteger(
                    backend, storage, instruction.operands[3]
                ),
                backend.pointerType,
                "unsafe.call.third.pointer"
            )
            bootstrapLlvmCallTyped(
                backend,
                type,
                function,
                [first, second, third],
                ""
            )
            bootstrapLlvmInitializeVoidValue(
                backend, storage.values[instruction.result]
            )
        }
    }
    if (name == "ablaUnsafeCallVoidPointerIntIntPointer") {
        if (instruction.operands.size != 5) supported = false
        if (instruction.operands.size == 5) {
            val type = bootstrapLlvmFunctionType(
                backend,
                backend.voidType,
                [backend.pointerType, backend.i32Type,
                 backend.i32Type, backend.pointerType]
            )
            val function = LLVMBuildIntToPtr(
                backend.builder,
                bootstrapLlvmCoreIntrinsicInteger(
                    backend, storage, instruction.operands[0]
                ),
                backend.pointerType,
                "unsafe.call.void.pointer-int-int-pointer"
            )
            val first = LLVMBuildIntToPtr(
                backend.builder,
                bootstrapLlvmCoreIntrinsicInteger(
                    backend, storage, instruction.operands[1]
                ),
                backend.pointerType,
                "unsafe.call.first.pointer"
            )
            val second = LLVMBuildTrunc(
                backend.builder,
                bootstrapLlvmCoreIntrinsicInteger(
                    backend, storage, instruction.operands[2]
                ),
                backend.i32Type,
                "unsafe.call.second.i32"
            )
            val third = LLVMBuildTrunc(
                backend.builder,
                bootstrapLlvmCoreIntrinsicInteger(
                    backend, storage, instruction.operands[3]
                ),
                backend.i32Type,
                "unsafe.call.third.i32"
            )
            val fourth = LLVMBuildIntToPtr(
                backend.builder,
                bootstrapLlvmCoreIntrinsicInteger(
                    backend, storage, instruction.operands[4]
                ),
                backend.pointerType,
                "unsafe.call.fourth.pointer"
            )
            bootstrapLlvmCallTyped(
                backend,
                type,
                function,
                [first, second, third, fourth],
                ""
            )
            bootstrapLlvmInitializeVoidValue(
                backend, storage.values[instruction.result]
            )
        }
    }
    if (name == "ablaHostIsMacOS" ||
        name == "ablaHostValueArgumentsIndirect") {
        if (instruction.operands.size != 0) supported = false
        if (instruction.operands.size == 0) {
            val enabled = if (name == "ablaHostIsMacOS") backend.macOS
                else backend.valueArgumentsIndirect
            bootstrapLlvmSetNativeValue(
                backend, storage, instruction.result,
                LLVMConstInt(backend.i1Type, if (enabled) 1 else 0, 0)
            )
        }
    }
    if (name == "ablaLinuxArgumentCount") {
        if (instruction.operands.size != 0) supported = false
        if (instruction.operands.size == 0) {
            val count = LLVMBuildLoad2(
                backend.builder, backend.i32Type,
                LLVMGetNamedGlobal(
                    backend.module, "abla_runtime_argument_count"
                ), "runtime.arguments.count"
            )
            val positive = LLVMBuildICmp(
                backend.builder, llvmIntSignedGreaterThan(), count,
                LLVMConstInt(backend.i32Type, 0, 0),
                "runtime.arguments.positive"
            )
            val userCount = LLVMBuildSelect(
                backend.builder, positive,
                LLVMBuildSub(
                    backend.builder, count,
                    LLVMConstInt(backend.i32Type, 1, 0),
                    "runtime.arguments.user.count"
                ),
                LLVMConstInt(backend.i32Type, 0, 0),
                "runtime.arguments.safe.count"
            )
            bootstrapLlvmSetNativeValue(
                backend, storage, instruction.result,
                LLVMBuildZExt(
                    backend.builder, userCount, backend.i64Type,
                    "runtime.arguments.user.count.i64"
                )
            )
        }
    }
    if (name == "ablaLinuxArgument") {
        if (instruction.operands.size != 1) supported = false
        if (instruction.operands.size == 1) {
            val vector = LLVMBuildLoad2(
                backend.builder, backend.pointerType,
                LLVMGetNamedGlobal(
                    backend.module, "abla_runtime_argument_vector"
                ), "runtime.arguments.vector"
            )
            val indices = llvmPointerVector(1)
            indices.set(
                0,
                LLVMBuildAdd(
                    backend.builder,
                    bootstrapLlvmCoreIntrinsicInteger(
                        backend, storage, instruction.operands[0]
                    ),
                    LLVMConstInt(backend.i64Type, 1, 0),
                    "runtime.argument.index"
                )
            )
            val slot = LLVMBuildGEP2(
                backend.builder, backend.pointerType, vector,
                indices.pointer(), 1, "runtime.argument.slot"
            )
            indices.drop()
            val text = LLVMBuildLoad2(
                backend.builder, backend.pointerType, slot,
                "runtime.argument.text"
            )
            val strlen = bootstrapLlvmDeclare(
                backend, "strlen", backend.i64Type,
                [backend.pointerType], false, [false]
            )
            val length = bootstrapLlvmCall(
                backend, strlen, [text], "runtime.argument.length",
                false, [false]
            )
            bootstrapLlvmCallNamed(
                backend, "abla_string_static",
                [storage.values[instruction.result], text, length],
                "", true, [false, false, false]
            )
        }
    }
    if (name == "ablaLinuxEnvironmentPointer") {
        if (instruction.operands.size != 0) supported = false
        if (instruction.operands.size == 0) {
            val environment = LLVMBuildLoad2(
                backend.builder, backend.pointerType,
                LLVMGetNamedGlobal(
                    backend.module, "abla_runtime_environment_vector"
                ), "runtime.environment.vector"
            )
            bootstrapLlvmStoreTaggedWordValue(
                backend, storage.values[instruction.result], 2,
                LLVMBuildPtrToInt(
                    backend.builder, environment, backend.i64Type,
                    "runtime.environment.address"
                )
            )
        }
    }
    if (name == "ablaLinuxSyscall") {
        if (instruction.operands.size != 7) supported = false
        if (instruction.operands.size == 7) {
            val types: array<i64*> = []
            val arguments: array<i64*> = []
            var operand = 0
            while (operand < 7) {
                types.append(backend.i64Type)
                arguments.append(bootstrapLlvmCoreIntrinsicInteger(
                    backend, storage, instruction.operands[operand]
                ))
                operand = operand + 1
            }
            val syscall = bootstrapLlvmDeclare(
                backend,
                if (backend.macOS) "abla_darwin_linux_syscall" else "syscall",
                backend.i64Type,
                types, false, bootstrapLlvmFalseFlags(7)
            )
            val raw = bootstrapLlvmCall(
                backend, syscall, arguments, "linux.syscall",
                false, bootstrapLlvmFalseFlags(7)
            )
            var result = raw
            if (!backend.macOS) {
                val failed = LLVMBuildICmp(
                    backend.builder, llvmIntEqual(), raw,
                    LLVMConstInt(backend.i64Type, -1, 1),
                    "linux.syscall.failed"
                )
                val errnoLocation = bootstrapLlvmDeclare(
                    backend, "__errno_location", backend.pointerType,
                    [], false, []
                )
                val errnoPointer = bootstrapLlvmCall(
                    backend, errnoLocation, [], "linux.errno.pointer",
                    false, []
                )
                val errno = LLVMBuildLoad2(
                    backend.builder, backend.i32Type, errnoPointer,
                    "linux.errno"
                )
                val negativeErrno = LLVMBuildNeg(
                    backend.builder,
                    LLVMBuildZExt(
                        backend.builder, errno, backend.i64Type,
                        "linux.errno.i64"
                    ),
                    "linux.errno.negative"
                )
                result = LLVMBuildSelect(
                    backend.builder, failed, negativeErrno, raw,
                    "linux.syscall.result"
                )
            }
            bootstrapLlvmSetNativeValue(
                backend, storage, instruction.result, result
            )
        }
    }
    if (name == "ablaRuntimeWasmHeapBase") {
        if (instruction.operands.size != 0) supported = false
        if (instruction.operands.size == 0) {
            var heapBase = LLVMGetNamedGlobal(
                backend.module, "__heap_base"
            )
            if (pointerIsNull(heapBase)) heapBase = LLVMAddGlobal(
                backend.module, backend.i8Type, "__heap_base"
            )
            LLVMSetLinkage(heapBase, llvmExternalLinkage())
            bootstrapLlvmSetNativeValue(
                backend, storage, instruction.result,
                LLVMBuildPtrToInt(
                    backend.builder, heapBase, backend.i64Type,
                    "runtime.wasm.heap.base"
                )
            )
        }
    }
    if (name == "ablaRuntimeWasmMemorySize" ||
        name == "ablaRuntimeWasmMemoryGrow") {
        val expected = if (name == "ablaRuntimeWasmMemoryGrow") 1 else 0
        if (instruction.operands.size != expected) supported = false
        if (instruction.operands.size == expected) {
            val parameters: array<i64*> = [backend.i32Type]
            if (name == "ablaRuntimeWasmMemoryGrow") {
                parameters.append(backend.i32Type)
            }
            val intrinsic = bootstrapLlvmDeclare(
                backend,
                if (name == "ablaRuntimeWasmMemoryGrow") {
                    "llvm.wasm.memory.grow.i32"
                } else "llvm.wasm.memory.size.i32",
                backend.i32Type, parameters, false, [false]
            )
            val arguments: array<i64*> = []
            arguments.append(LLVMConstInt(backend.i32Type, 0, 0))
            if (name == "ablaRuntimeWasmMemoryGrow") {
                arguments.append(
                    LLVMBuildTrunc(
                        backend.builder,
                        bootstrapLlvmCoreIntrinsicInteger(
                            backend, storage, instruction.operands[0]
                        ),
                        backend.i32Type, "runtime.wasm.pages"
                    )
                )
            }
            val result = bootstrapLlvmCall(
                backend, intrinsic, arguments,
                "runtime.wasm.memory", false, [false]
            )
            bootstrapLlvmSetNativeValue(
                backend, storage, instruction.result,
                if (name == "ablaRuntimeWasmMemoryGrow") LLVMBuildSExt(
                    backend.builder, result, backend.i64Type,
                    "runtime.wasm.memory.result"
                ) else LLVMBuildZExt(
                    backend.builder, result, backend.i64Type,
                    "runtime.wasm.memory.result"
                )
            )
        }
    }
    supported
}

fun bootstrapLlvmLocalPointer(
    storage: BootstrapLlvmFunctionStorage,
    function: BootstrapIrFunction,
    name: string
): i64* {
    var result = nativeNullPointer()
    val parameter = bootstrapLlvmParameterId(function, name)
    val local = storage.localIndex.find(name)
    if (parameter >= 0) result = storage.parameters[parameter]
    if (parameter < 0 && local >= 0) result = storage.locals[local]
    result
}

fun bootstrapLlvmEmitFunctionReturn(
    backend: BootstrapLlvmBackend,
    function: BootstrapIrFunction,
    storage: BootstrapLlvmFunctionStorage,
    value: int,
    output: i64*
): void {
    val scalar = bootstrapLlvmDirectScalarType(function.resultType)
    if (bootstrapLlvmDirectResultIsVoid(function)) {
        bootstrapLlvmPopRoots(backend, storage)
        LLVMBuildRetVoid(backend.builder)
    } else if (scalar != "") {
        var native = LLVMConstNull(backend.type(scalar))
        if (value >= 0) {
            native = bootstrapLlvmNativeValue(backend, storage, value)
            if (pointerIsNull(native)) native = bootstrapLlvmUnboxScalar(
                backend, storage.values[value], scalar, "direct.return"
            )
        }
        bootstrapLlvmPopRoots(backend, storage)
        LLVMBuildRet(backend.builder, native)
    } else {
        if (value >= 0) bootstrapLlvmCopyValue(
            backend, storage.values[value], output, "function.result"
        )
        else bootstrapLlvmRuntimeCall(
            backend, "abla_void", output, []
        )
        bootstrapLlvmPopRoots(backend, storage)
        LLVMBuildRetVoid(backend.builder)
    }
    return
}

fun bootstrapLlvmEmitFunction(
    backend: BootstrapLlvmBackend,
    program: BootstrapIrProgram,
    function: BootstrapIrFunction,
    functionId: int,
    functionIndex: BootstrapLlvmNameIndex,
    identities: BootstrapLlvmFunctionIdentities,
    nativeIndex: BootstrapLlvmNameIndex,
    globalIndex: BootstrapLlvmNameIndex,
    classIndex: BootstrapLlvmNameIndex,
    fieldIndex: BootstrapLlvmNameIndex,
    mayCollect: array<bool>
): int {
    val llvmFunction = LLVMGetNamedFunction(
        backend.module,
        bootstrapLlvmDirectFunctionSymbol(identities.symbols[functionId])
    )
    val entry = LLVMAppendBasicBlockInContext(
        backend.context, llvmFunction, "entry"
    )
    LLVMPositionBuilderAtEnd(backend.builder, entry)
    val runtimePrefix = "__ablaRuntime"
    val runtimeImplementation =
        function.name.size >= runtimePrefix.size &&
        function.name.slice(0, runtimePrefix.size) == runtimePrefix
    val collecting = functionId < mayCollect.size &&
        mayCollect[functionId] && !runtimeImplementation
    var directlyAllocates = false
    var allocationInstruction = 0
    while (allocationInstruction < function.instructions.size) {
        if (bootstrapLlvmInstructionMayAllocate(
            function.instructions[allocationInstruction]
        )) directlyAllocates = true
        allocationInstruction = allocationInstruction + 1
    }
    var rootValues: array<bool> = []
    if (collecting) rootValues = bootstrapLlvmGcRootPlan(
        function, functionIndex, mayCollect
    )
    val scalarPlan = bootstrapLlvmBuildScalarPlan(
        program, function, functionIndex, nativeIndex
    )
    var storage = bootstrapLlvmCreateFunctionStorage(
        backend, function, llvmFunction, collecting, rootValues,
        scalarPlan
    )
    bootstrapLlvmInitializeParameters(
        backend, function, llvmFunction, storage
    )
    bootstrapLlvmPushRoots(backend, storage)
    if (collecting && directlyAllocates && !runtimeImplementation &&
        function.name != "__bootstrap_globals") {
        bootstrapLlvmCallNamed(
            backend, "abla_runtime_memory_pressure", [],
            "", false, []
        )
    }
    val resultUsesOutput = bootstrapLlvmDirectResultUsesOutput(function)
    val output = if (resultUsesOutput) LLVMGetParam(llvmFunction, 0)
        else nativeNullPointer()
    val argumentCount = LLVMGetParam(
        llvmFunction, if (resultUsesOutput) 1 else 0
    )
    var errors = 0
    var terminated = false
    var instructionIndex = 0
    while (instructionIndex < function.instructions.size) {
        val instruction = function.instructions[instructionIndex]
        var matched = false
        var supported = true
        val reachable = !terminated || instruction.opcode == "label"
        if (!reachable) matched = true
        if (reachable && instruction.opcode == "label") {
            matched = true
            if (!terminated) LLVMBuildBr(
                backend.builder, storage.block(instruction.target)
            )
            LLVMPositionBuilderAtEnd(
                backend.builder, storage.block(instruction.target)
            )
            terminated = false
        }
        if (reachable && instruction.opcode == "const.i64") {
            matched = true
            bootstrapLlvmSetNativeValue(
                backend, storage, instruction.result,
                LLVMConstInt(
                    backend.i64Type,
                    bootstrapLlvmParseInteger(instruction.text), 1
                )
            )
        }
        if (reachable && instruction.opcode == "const.f64") {
            matched = true
            bootstrapLlvmSetNativeValue(
                backend, storage, instruction.result,
                LLVMConstRealOfStringAndSize(
                    backend.f64Type,
                    instruction.text,
                    instruction.text.size
                )
            )
        }
        if (reachable && instruction.opcode == "const.bool") {
            matched = true
            bootstrapLlvmSetNativeValue(
                backend, storage, instruction.result, LLVMConstInt(
                    backend.i1Type,
                    if (instruction.text == "true") 1 else 0,
                    0
                )
            )
        }
        if (reachable && instruction.opcode == "const.string") {
            matched = true
            val name = bootstrapLlvmStringSymbolFrom(
                identities.symbols[functionId], instruction.result
            )
            val pointer = if (bootstrapLlvmStringNeedsExplicitLength(
                instruction.text
            )) bootstrapLlvmGlobalStringPointer(
                backend, instruction.text, name
            ) else LLVMBuildGlobalStringPtr(
                backend.builder, instruction.text, name
            )
            bootstrapLlvmCallNamed(
                backend, "abla_string_static",
                [storage.values[instruction.result], pointer,
                 LLVMConstInt(backend.i64Type, instruction.text.size, 0)],
                "", true, [false, false, false]
            )
        }
        if (reachable && (instruction.opcode == "const.null" ||
                          instruction.opcode == "const.void")) {
            matched = true
            bootstrapLlvmRuntimeCall(
                backend,
                if (instruction.opcode == "const.null")
                    "abla_null" else "abla_void",
                storage.values[instruction.result], []
            )
        }
        if (reachable && instruction.opcode == "parameter.load") {
            matched = true
            val found = bootstrapLlvmParameterId(function, instruction.text)
            if (found < 0) supported = false
            if (found >= 0) {
                if (instruction.result < storage.valueTypes.size &&
                    storage.valueTypes[instruction.result] != "") {
                    val scalar = storage.valueTypes[instruction.result]
                    if (!bootstrapLlvmParameterHasDefault(
                        function, instruction.text
                    )) {
                        val resultUsesOutput =
                            bootstrapLlvmDirectResultUsesOutput(function)
                        val parameterBegin =
                            (if (resultUsesOutput) 1 else 0) + 1
                        bootstrapLlvmSetNativeValue(
                            backend, storage, instruction.result,
                            LLVMGetParam(
                                llvmFunction, found + parameterBegin
                            )
                        )
                    } else bootstrapLlvmSetNativeValue(
                        backend, storage, instruction.result,
                        bootstrapLlvmUnboxScalar(
                            backend, storage.parameters[found], scalar,
                            "parameter.load"
                        )
                    )
                } else bootstrapLlvmCopyValue(
                    backend, storage.parameters[found],
                    storage.values[instruction.result], "parameter.load"
                )
            }
        }
        if (reachable && instruction.opcode == "parameter.default") {
            matched = true
            val found = bootstrapLlvmParameterId(function, instruction.text)
            if (found < 0) supported = false
            if (found >= 0) {
                val useDefault = LLVMAppendBasicBlockInContext(
                    backend.context, llvmFunction, "default.use"
                )
                val keep = LLVMAppendBasicBlockInContext(
                    backend.context, llvmFunction, "default.keep"
                )
                val ready = LLVMAppendBasicBlockInContext(
                    backend.context, llvmFunction, "default.ready"
                )
                val needed = LLVMBuildICmp(
                    backend.builder, llvmIntUnsignedLessOrEqual(),
                    argumentCount,
                    LLVMConstInt(backend.i64Type, instruction.right, 0),
                    "default.needed"
                )
                LLVMBuildCondBr(backend.builder, needed, useDefault, keep)
                LLVMPositionBuilderAtEnd(backend.builder, useDefault)
                bootstrapLlvmCopyValue(
                    backend, storage.values[instruction.left],
                    storage.parameters[found], "default.value"
                )
                LLVMBuildBr(backend.builder, ready)
                LLVMPositionBuilderAtEnd(backend.builder, keep)
                LLVMBuildBr(backend.builder, ready)
                LLVMPositionBuilderAtEnd(backend.builder, ready)
                bootstrapLlvmCopyValue(
                    backend, storage.parameters[found],
                    storage.values[instruction.result], "default.result"
                )
            }
        }
        if (reachable && (instruction.opcode == "local.declare" ||
                          instruction.opcode == "local.assign")) {
            matched = true
            val found = storage.localIndex.find(
                instruction.text
            )
            if (found < 0) supported = false
            if (found >= 0) {
                val nativeLocal = storage.nativeLocals[found]
                if (!pointerIsNull(nativeLocal)) {
                    val native = bootstrapLlvmNativeValue(
                        backend, storage, instruction.left
                    )
                    LLVMBuildStore(backend.builder, native, nativeLocal)
                    bootstrapLlvmSetNativeValue(
                        backend, storage, instruction.result, native
                    )
                } else {
                    bootstrapLlvmCopyValue(
                        backend, storage.values[instruction.left],
                        storage.locals[found], "local.value"
                    )
                    bootstrapLlvmCopyValue(
                        backend, storage.locals[found],
                        storage.values[instruction.result], "local.result"
                    )
                }
            }
        }
        if (reachable && (instruction.opcode == "local.load" ||
                          instruction.opcode == "local.set" ||
                          instruction.opcode == "resource.peek" ||
                          instruction.opcode == "place.root")) {
            matched = true
            val local = bootstrapLlvmLocalPointer(
                storage, function, instruction.text
            )
            if (pointerIsNull(local)) supported = false
            val nativeLocal = bootstrapLlvmNativeLocalPointer(
                storage, instruction.text
            )
            if (!pointerIsNull(nativeLocal)) {
                if (instruction.opcode == "local.set") {
                    LLVMBuildStore(
                        backend.builder,
                        bootstrapLlvmNativeValue(
                            backend, storage, instruction.left
                        ),
                        nativeLocal
                    )
                } else {
                    val native = LLVMBuildLoad2(
                        backend.builder,
                        backend.type(storage.valueTypes[instruction.result]),
                        nativeLocal, "scalar.local.load"
                    )
                    bootstrapLlvmSetNativeValue(
                        backend, storage, instruction.result, native
                    )
                }
                supported = true
            } else if (!pointerIsNull(local)) {
                if (instruction.opcode == "local.set") {
                    bootstrapLlvmCopyValue(
                        backend, storage.values[instruction.left], local,
                        "local.set"
                    )
                } else bootstrapLlvmCopyValue(
                    backend, local, storage.values[instruction.result],
                    "local.load"
                )
            }
        }
        if (reachable && (instruction.opcode == "place.load" ||
                          instruction.opcode == "place.move" ||
                          instruction.opcode == "place.set" ||
                          instruction.opcode == "borrow.bind" ||
                          instruction.opcode == "borrow.mutate")) {
            matched = true
        }
        if (reachable && (bootstrapIrIsLocalZero(instruction.opcode) ||
                          instruction.opcode == "local.allocate")) {
            matched = true
            val local = storage.localIndex.find(
                instruction.text
            )
            if (local < 0) supported = false
            if (local >= 0) {
                if (!pointerIsNull(storage.nativeLocals[local])) {
                    val scalarType = storage.localTypes[local]
                    LLVMBuildStore(
                        backend.builder,
                        LLVMConstInt(backend.type(scalarType), 0, 0),
                        storage.nativeLocals[local]
                    )
                } else if (bootstrapIrIsLocalZero(instruction.opcode)) {
                    bootstrapLlvmCallNamed(
                        backend, "abla_i64",
                        [storage.locals[local],
                         LLVMConstInt(backend.i64Type, 0, 0)],
                        "", true, [false, false]
                    )
                } else bootstrapLlvmRuntimeCall(
                    backend, "abla_null", storage.locals[local], []
                )
            }
        }
        if (reachable && (instruction.opcode == "local.move" ||
                          instruction.opcode == "resource.clear")) {
            matched = true
            val local = bootstrapLlvmLocalPointer(
                storage, function, instruction.text
            )
            if (pointerIsNull(local)) supported = false
            if (!pointerIsNull(local)) bootstrapLlvmRuntimeCall(
                backend, "abla_null", local, []
            )
        }
        if (reachable && instruction.opcode == "resource.drop") {
            matched = true
            val called = functionIndex.find(
                bootstrapDropFunctionName(instruction.text)
            )
            if (called < 0) supported = false
            if (called >= 0) {
                val run = LLVMAppendBasicBlockInContext(
                    backend.context, llvmFunction, "drop.run"
                )
                val done = LLVMAppendBasicBlockInContext(
                    backend.context, llvmFunction, "drop.done"
                )
                val tagPointer = LLVMBuildStructGEP2(
                    backend.builder, backend.valueType,
                    storage.values[instruction.left], 0, "drop.tag.pointer"
                )
                val tag = LLVMBuildLoad2(
                    backend.builder, backend.i32Type,
                    tagPointer, "drop.tag"
                )
                val active = LLVMBuildICmp(
                    backend.builder, llvmIntNotEqual(), tag,
                    LLVMConstInt(backend.i32Type, 1, 0), "drop.active"
                )
                LLVMBuildCondBr(backend.builder, active, run, done)
                LLVMPositionBuilderAtEnd(backend.builder, run)
                val arguments = bootstrapLlvmDirectCallArguments(
                    backend, storage, program.functions[called],
                    [instruction.left], storage.auxiliary[instructionIndex]
                )
                bootstrapLlvmEmitDirectCall(
                    backend,
                    program.functions[called],
                    LLVMGetNamedFunction(
                        backend.module, bootstrapLlvmDirectFunctionSymbol(
                            identities.symbols[called]
                        )
                    ),
                    arguments,
                    storage.auxiliary[instructionIndex]
                )
                LLVMBuildBr(backend.builder, done)
                LLVMPositionBuilderAtEnd(backend.builder, done)
            }
        }
        if (reachable && instruction.opcode == "closure.drop") {
            matched = true
            bootstrapLlvmCallNamed(
                backend, "abla_llvm_drop_closure",
                [storage.values[instruction.left]], "", false, [false]
            )
        }
        if (reachable && instruction.opcode == "function.ref") {
            matched = true
            val found = functionIndex.find(instruction.text)
            if (found < 0) supported = false
            if (found >= 0) bootstrapLlvmCallNamed(
                backend, "abla_function",
                [storage.values[instruction.result], LLVMConstInt(
                    backend.i32Type, identities.runtimeIds[found], 0
                )],
                "", true, [false, false]
            )
        }
        if (reachable && instruction.opcode == "closure.create") {
            matched = true
            val found = functionIndex.find(instruction.text)
            if (found < 0) supported = false
            if (found >= 0 && instruction.operands.size == 0) {
                bootstrapLlvmCallNamed(
                    backend, "abla_function",
                    [storage.values[instruction.result], LLVMConstInt(
                        backend.i32Type, identities.runtimeIds[found], 0
                    )],
                    "", true, [false, false]
                )
            }
            if (found >= 0 && instruction.operands.size > 0) {
                val captures = bootstrapLlvmPrepareArguments(
                    backend, storage, instructionIndex,
                    instruction.operands, 0
                )
                bootstrapLlvmCallNamed(
                    backend, "abla_closure",
                    [storage.values[instruction.result], LLVMConstInt(
                        backend.i32Type, identities.runtimeIds[found], 0
                     ), captures, LLVMConstInt(
                        backend.i64Type, instruction.operands.size, 0
                     )],
                    "", true, [false, false, false, false]
                )
            }
        }
        if (reachable && instruction.opcode == "shared.unlock") {
            matched = true
            bootstrapLlvmCallNamed(
                backend, "abla_shared_unlock",
                [storage.values[instruction.left]], "", false, [true]
            )
        }
        var scalarOperation = false
        if (reachable) scalarOperation = bootstrapLlvmEmitScalarOperation(
            backend, storage, instruction
        )
        if (scalarOperation) matched = true
        val runtime = bootstrapLlvmRuntimeOperation(instruction.opcode)
        if (reachable && runtime != "" &&
            instruction.opcode != "&&" && instruction.opcode != "||" &&
            !scalarOperation) {
            matched = true
            bootstrapLlvmRuntimeCall(
                backend, runtime, storage.values[instruction.result],
                bootstrapLlvmInstructionInputs(storage, instruction)
            )
        }
        if (reachable && (instruction.opcode == "&&" ||
                          instruction.opcode == "||") &&
            !scalarOperation) {
            matched = true
            val left = bootstrapLlvmCallNamed(
                backend, "abla_as_bool", [storage.values[instruction.left]],
                "boolean.left", false, [true]
            )
            val right = bootstrapLlvmCallNamed(
                backend, "abla_as_bool", [storage.values[instruction.right]],
                "boolean.right", false, [true]
            )
            val result = if (instruction.opcode == "&&") LLVMBuildAnd(
                backend.builder, left, right, "boolean.and"
            ) else LLVMBuildOr(
                backend.builder, left, right, "boolean.or"
            )
            bootstrapLlvmCallNamed(
                backend, "abla_bool", [storage.values[instruction.result], result],
                "", true, [false, false]
            )
        }
        if (reachable && instruction.opcode == "return") {
            matched = true
            bootstrapLlvmEmitFunctionReturn(
                backend, function, storage, instruction.left, output
            )
            terminated = true
        }
        if (reachable && instruction.opcode == "unreachable") {
            matched = true
            val message = LLVMBuildGlobalStringPtr(
                backend.builder, "non-exhaustive when", "abla.when.error"
            )
            bootstrapLlvmCallNamed(
                backend, "abla_platform_panic",
                [message, LLVMConstInt(backend.i64Type, 19, 0)],
                "", false, [false, false]
            )
            LLVMBuildUnreachable(backend.builder)
            terminated = true
        }
        if (reachable && instruction.opcode == "jump") {
            matched = true
            val target = storage.block(instruction.target)
            if (pointerIsNull(target)) supported = false
            if (!pointerIsNull(target)) LLVMBuildBr(backend.builder, target)
            terminated = true
        }
        if (reachable && instruction.opcode == "branch") {
            matched = true
            val yes = storage.block(instruction.target)
            val no = storage.block(instruction.alternate)
            if (pointerIsNull(yes) || pointerIsNull(no)) supported = false
            if (!pointerIsNull(yes) && !pointerIsNull(no)) {
                var condition = bootstrapLlvmNativeValue(
                    backend, storage, instruction.left
                )
                if (pointerIsNull(condition)) {
                    condition = bootstrapLlvmCallNamed(
                        backend, "abla_as_bool",
                        [storage.values[instruction.left]],
                        "branch.condition", false, [true]
                    )
                }
                LLVMBuildCondBr(backend.builder, condition, yes, no)
            }
            terminated = true
        }
        if (reachable && instruction.opcode == "call") {
            matched = true
            val called = functionIndex.find(instruction.text)
            if (called < 0) supported = false
            if (called >= 0) {
                val calledIsScalar = bootstrapLlvmDirectResultIsScalar(
                    program.functions[called]
                )
                val calledUsesOutput = bootstrapLlvmDirectResultUsesOutput(
                    program.functions[called]
                )
                val callOutput = if (calledUsesOutput)
                    storage.values[instruction.result]
                    else nativeNullPointer()
                val arguments = bootstrapLlvmDirectCallArguments(
                    backend, storage, program.functions[called],
                    instruction.operands, callOutput
                )
                val directResult = bootstrapLlvmEmitDirectCall(
                    backend,
                    program.functions[called],
                    LLVMGetNamedFunction(
                        backend.module, bootstrapLlvmDirectFunctionSymbol(
                            identities.symbols[called]
                        )
                    ),
                    arguments,
                    callOutput
                )
                if (calledIsScalar) bootstrapLlvmSetNativeValue(
                        backend, storage, instruction.result, directResult
                    )
            }
        }
        if (reachable && (instruction.opcode == "generator.create" ||
                          instruction.opcode == "task.create" ||
                          instruction.opcode == "thread.create")) {
            matched = true
            val createArguments: array<i64*> =
                [storage.values[instruction.result],
                 storage.values[instruction.left],
                 LLVMGetNamedFunction(
                    backend.module, "abla_llvm_call_indirect"
                 ),
                 LLVMGetNamedFunction(
                    backend.module, "abla_llvm_release_closure"
                 ),
                 LLVMGetNamedFunction(
                    backend.module, "abla_llvm_drop_closure"
                 )]
            if (instruction.opcode == "thread.create") {
                createArguments.append(LLVMGetNamedFunction(
                    backend.module, "abla_runtime_thread_entry"
                ))
            }
            bootstrapLlvmCallNamed(
                backend,
                "abla_${instruction.opcode.slice(
                    0, instruction.opcode.size - 7
                )}_create",
                createArguments,
                "", true, bootstrapLlvmFalseFlags(createArguments.size)
            )
        }
        if (reachable && (instruction.opcode == "generator.next" ||
                          instruction.opcode == "generator.value" ||
                          instruction.opcode == "generator.yield" ||
                          instruction.opcode == "generator.drop" ||
                          instruction.opcode == "task.drop" ||
                          instruction.opcode == "thread.drop" ||
                          instruction.opcode == "await")) {
            matched = true
            var runtimeName = "abla_await"
            if (instruction.opcode == "generator.next") {
                runtimeName = "abla_generator_next"
            }
            if (instruction.opcode == "generator.value") {
                runtimeName = "abla_generator_value"
            }
            if (instruction.opcode == "generator.yield") {
                runtimeName = "abla_generator_yield"
            }
            if (instruction.opcode == "generator.drop") {
                runtimeName = "abla_generator_drop"
            }
            if (instruction.opcode == "task.drop") {
                runtimeName = "abla_task_drop"
            }
            if (instruction.opcode == "thread.drop") {
                runtimeName = "abla_thread_drop"
            }
            bootstrapLlvmRuntimeCall(
                backend, runtimeName, storage.values[instruction.result],
                [storage.values[instruction.left]]
            )
        }
        if (reachable && instruction.opcode == "extern.host") {
            matched = true
            bootstrapLlvmRuntimeCall(
                backend, instruction.text,
                storage.values[instruction.result],
                bootstrapLlvmInstructionInputs(storage, instruction)
            )
        }
        if (reachable && instruction.opcode == "extern.c") {
            matched = true
            supported = bootstrapLlvmEmitNativeCall(
                backend, program, nativeIndex, storage, instruction
            )
        }
        if (reachable && instruction.opcode == "extern.intrinsic") {
            matched = true
            if (bootstrapLlvmCoreIntrinsic(instruction.text)) {
                supported = bootstrapLlvmEmitCoreIntrinsic(
                    backend, storage, instruction
                )
            } else bootstrapLlvmRuntimeCall(
                    backend, instruction.text,
                    storage.values[instruction.result],
                    bootstrapLlvmInstructionInputs(storage, instruction)
                )
        }
        if (reachable && (instruction.opcode == "call.indirect" ||
                          instruction.opcode == "call.indirect.once")) {
            matched = true
            if (instruction.operands.size < 1) supported = false
            if (instruction.operands.size >= 1) {
                val arguments = bootstrapLlvmPrepareArguments(
                    backend, storage, instructionIndex,
                    instruction.operands, 1
                )
                bootstrapLlvmCallNamed(
                    backend, "abla_llvm_call_indirect",
                    [storage.values[instruction.result],
                     storage.values[instruction.operands[0]], arguments,
                     LLVMConstInt(
                         backend.i64Type, instruction.operands.size - 1, 0
                     )],
                    "", true, [false, false, false, false]
                )
                if (instruction.opcode == "call.indirect.once") {
                    bootstrapLlvmCallNamed(
                        backend, "abla_llvm_release_closure",
                        [storage.values[instruction.operands[0]]],
                        "", false, [false]
                    )
                }
            }
        }
        if (reachable && instruction.opcode == "array.create") {
            matched = true
            val values = bootstrapLlvmPrepareArguments(
                backend, storage, instructionIndex,
                instruction.operands, 0
            )
            bootstrapLlvmCallNamed(
                backend, "abla_array_create",
                [storage.values[instruction.result], values,
                 LLVMConstInt(
                     backend.i64Type, instruction.operands.size, 0
                 )],
                "", true, [false, false, false]
            )
        }
        if (reachable && instruction.opcode == "index.set") {
            matched = true
            if (instruction.operands.size != 3) supported = false
            if (instruction.operands.size == 3) {
                bootstrapLlvmCallNamed(
                    backend, "abla_array_set",
                    [storage.values[instruction.operands[0]],
                     storage.values[instruction.operands[1]],
                     storage.values[instruction.operands[2]]],
                    "", false, [true, true, true]
                )
                bootstrapLlvmCopyValue(
                    backend, storage.values[instruction.operands[2]],
                    storage.values[instruction.result], "index.set"
                )
            }
        }
        if (reachable && (instruction.opcode == "object.allocate" ||
                          instruction.opcode == "object.create")) {
            matched = true
            val found = classIndex.find(instruction.text)
            if (found < 0) supported = false
            if (found >= 0) {
                bootstrapLlvmCallNamed(
                    backend, "abla_object_create",
                    [storage.values[instruction.result], LLVMConstInt(
                        backend.i32Type,
                        bootstrapLlvmStableNameId(instruction.text), 0
                    ), LLVMConstInt(
                        backend.i64Type,
                        program.classes[found].fields.size, 0
                    )],
                    "", true, [false, false, false]
                )
                if (instruction.opcode == "object.create") {
                    var classPosition = 0
                    while (classPosition < program.classes.size) {
                        val foundClass = program.classes[classPosition]
                        if (foundClass.name == instruction.text) {
                            var field = 0
                            while (field < foundClass.fields.size &&
                                   field < foundClass.fieldParameters.size) {
                                val argument =
                                    foundClass.fieldParameters[field]
                                if (argument < instruction.operands.size) {
                                    bootstrapLlvmCallNamed(
                                        backend, "abla_field_initialize",
                                        [storage.values[instruction.result],
                                         LLVMConstInt(
                                            backend.i32Type,
                                            bootstrapLlvmStableNameId(
                                                foundClass.fields[field]
                                            ), 0
                                         ),
                                         storage.values[
                                            instruction.operands[argument]
                                         ]],
                                        "", false, [true, false, true]
                                    )
                                }
                                field = field + 1
                            }
                        }
                        classPosition = classPosition + 1
                    }
                }
            }
        }
        if (reachable && instruction.opcode == "field.get") {
            matched = true
            val found = fieldIndex.find(instruction.text)
            if (found < 0) supported = false
            if (found >= 0) bootstrapLlvmCallNamed(
                backend, "abla_field_get",
                [storage.values[instruction.result],
                 storage.values[instruction.left],
                 LLVMConstInt(
                    backend.i32Type,
                    bootstrapLlvmStableNameId(instruction.text), 0
                 )],
                "", true, [false, true, false]
            )
        }
        if (reachable && instruction.opcode == "field.get.indexed") {
            matched = true
            val found = fieldIndex.find(instruction.text)
            if (found < 0 || instruction.target < 0) supported = false
            if (found >= 0 && instruction.target >= 0) {
                bootstrapLlvmCallNamed(
                    backend, "abla_field_get_indexed",
                    [storage.values[instruction.result],
                     storage.values[instruction.left],
                     LLVMConstInt(
                        backend.i32Type,
                        bootstrapLlvmStableNameId(instruction.text), 0
                     ),
                     LLVMConstInt(
                        backend.i64Type, instruction.target, 0
                     )],
                    "", true, [false, true, false, false]
                )
            }
        }
        if (reachable && instruction.opcode == "field.set") {
            matched = true
            val found = fieldIndex.find(instruction.text)
            if (found < 0 || instruction.operands.size != 2) {
                supported = false
            }
            if (found >= 0 && instruction.operands.size == 2) {
                bootstrapLlvmCallNamed(
                    backend, "abla_field_set",
                    [storage.values[instruction.operands[0]], LLVMConstInt(
                        backend.i32Type,
                        bootstrapLlvmStableNameId(instruction.text), 0
                     ), storage.values[instruction.operands[1]]],
                    "", false, [true, false, true]
                )
                bootstrapLlvmCopyValue(
                    backend, storage.values[instruction.operands[1]],
                    storage.values[instruction.result], "field.set"
                )
            }
        }
        if (reachable && (instruction.opcode == "field.set.indexed.i64" ||
                          instruction.opcode == "field.set.indexed.bool" ||
                          instruction.opcode == "field.set.indexed.f64")) {
            matched = true
            val found = fieldIndex.find(instruction.text)
            if (found < 0 || instruction.target < 0 ||
                instruction.operands.size != 2) supported = false
            if (found >= 0 && instruction.target >= 0 &&
                instruction.operands.size == 2) {
                val scalar = if (
                    instruction.opcode == "field.set.indexed.bool"
                ) "bool" else if (
                    instruction.opcode == "field.set.indexed.f64"
                ) "f64" else "i64"
                val scalarValue = bootstrapLlvmScalarOperand(
                    backend, storage, instruction.operands[1], scalar
                )
                val native = if (scalar == "f64") LLVMBuildBitCast(
                    backend.builder, scalarValue, backend.i64Type,
                    "scalar.field.set.f64"
                ) else scalarValue
                bootstrapLlvmCallNamed(
                    backend,
                    if (scalar == "bool") {
                        "abla_field_set_indexed_bool"
                    } else "abla_field_set_indexed_i64",
                    [storage.values[instruction.operands[0]], LLVMConstInt(
                        backend.i32Type,
                        bootstrapLlvmStableNameId(instruction.text), 0
                     ), LLVMConstInt(
                        backend.i64Type, instruction.target, 0
                     ), native],
                    "", false, [true, false, false, false]
                )
                bootstrapLlvmSetNativeValue(
                    backend, storage, instruction.result, scalarValue
                )
            }
        }
        if (reachable && instruction.opcode == "field.set.indexed") {
            matched = true
            val found = fieldIndex.find(instruction.text)
            if (found < 0 || instruction.target < 0 ||
                instruction.operands.size != 2) supported = false
            if (found >= 0 && instruction.target >= 0 &&
                instruction.operands.size == 2) {
                bootstrapLlvmCallNamed(
                    backend, "abla_field_set_indexed",
                    [storage.values[instruction.operands[0]], LLVMConstInt(
                        backend.i32Type,
                        bootstrapLlvmStableNameId(instruction.text), 0
                     ), LLVMConstInt(
                        backend.i64Type, instruction.target, 0
                     ), storage.values[instruction.operands[1]]],
                    "", false, [true, false, false, true]
                )
                bootstrapLlvmCopyValue(
                    backend, storage.values[instruction.operands[1]],
                    storage.values[instruction.result], "field.set.indexed"
                )
            }
        }
        if (reachable && instruction.opcode == "global.load") {
            matched = true
            val found = globalIndex.find(instruction.text)
            if (found < 0) supported = false
            if (found >= 0) {
                val global = LLVMGetNamedGlobal(
                    backend.module,
                    bootstrapLlvmGlobalSymbol(instruction.text)
                )
                val scalar = bootstrapLlvmGlobalScalarType(
                    program, instruction.text
                )
                if (scalar == "") bootstrapLlvmCopyValue(
                    backend, global,
                    storage.values[instruction.result], "global.load"
                )
                else bootstrapLlvmSetNativeValue(
                    backend, storage, instruction.result,
                    LLVMBuildLoad2(
                        backend.builder, backend.type(scalar), global,
                        "global.scalar.load"
                    )
                )
            }
        }
        if (reachable && (instruction.opcode == "global.assign" ||
                          instruction.opcode == "global.store")) {
            matched = true
            val found = globalIndex.find(instruction.text)
            if (found < 0) supported = false
            if (found >= 0) {
                val global = LLVMGetNamedGlobal(
                    backend.module,
                    bootstrapLlvmGlobalSymbol(instruction.text)
                )
                val scalar = bootstrapLlvmGlobalScalarType(
                    program, instruction.text
                )
                val constant = if (instruction.opcode == "global.store") {
                    if (backend.constantScalarVarInitializers) {
                        bootstrapLlvmScalarGlobalInitializer(
                            backend, program, instruction.text
                        )
                    } else bootstrapLlvmScalarGlobalConstant(
                        backend, program, instruction.text
                    )
                } else nativeNullPointer()
                if (!pointerIsNull(constant)) {
                    bootstrapLlvmSetNativeValue(
                        backend, storage, instruction.result, constant
                    )
                } else if (scalar == "") {
                    bootstrapLlvmCopyValue(
                        backend, storage.values[instruction.left], global,
                        "global.store"
                    )
                    bootstrapLlvmCopyValue(
                        backend, global, storage.values[instruction.result],
                        "global.result"
                    )
                } else {
                    var native = bootstrapLlvmNativeValue(
                        backend, storage, instruction.left
                    )
                    if (pointerIsNull(native)) native =
                        bootstrapLlvmUnboxScalar(
                            backend, storage.values[instruction.left],
                            scalar, "global.scalar.value"
                        )
                    LLVMBuildStore(backend.builder, native, global)
                    bootstrapLlvmSetNativeValue(
                        backend, storage, instruction.result, native
                    )
                }
            }
        }
        if (!matched || !supported) {
            linuxPrintStandardError(
                "error[E_LLVM_INSTRUCTION_UNSUPPORTED]: function `${function.name}` cannot lower `${instruction.opcode}` target `${instruction.text}`\n"
            )
            errors = errors + 1
        }
        instructionIndex = instructionIndex + 1
    }
    if (!terminated) {
        bootstrapLlvmEmitFunctionReturn(
            backend, function, storage, function.result, output
        )
    }
    errors
}
