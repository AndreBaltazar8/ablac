            val pointer = bootstrapLlvmGlobalBytesPointer(
                backend, instruction.text, name
            )
            bootstrapLlvmSetNativeValue(
                backend, storage, instruction.result,
                LLVMBuildPtrToInt(
                    backend.builder, pointer, backend.i64Type,
                    "native.static.bytes.address"
                )
            )
        }
        if (reachable && instruction.opcode == "closure.create") {
            matched = true
            val found = functionIndex.find(instruction.text)
            if (found < 0) supported = false
            if (found >= 0 && instruction.operands.size == 0) {
