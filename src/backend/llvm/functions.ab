    if (name == "ablaUnsafeCallVoidI32PointerI32PointerPointer") return [1, 0, 1, 0, 0]
    if (name == "ablaUnsafeCallVoidI32I32PointerI32I32I32I32") return [1, 1, 0, 1, 1, 1, 1]
    if (name == "ablaUnsafeCallVoidI32I32I32I32I32I8") return [1, 1, 1, 1, 1, 6]
    if (name == "ablaUnsafeCallVoidI32I32I32I32I32I32I32I32I8") return [1, 1, 1, 1, 1, 1, 1, 1, 6]
    if (name == "ablaUnsafeCallVoidI32I32I32I32I32I8I32I64") return [1, 1, 1, 1, 1, 6, 1, 2]
    if (name == "ablaUnsafeCallVoidI32I32I32I32I64") return [1, 1, 1, 1, 2]
