import "runtime.ab"

fun bootstrapLlvmDirectFunctionSymbol(name: string): string =
    "${name}_direct"

fun bootstrapLlvmXtensaInterruptEntrySymbol(name: string): string =
    "${name}_xtensa_interrupt_entry"

fun bootstrapLlvmNativeFunctionAdapterSymbol(name: string): string =
    "${name}_native_adapter"

fun bootstrapLlvmDeclareXtensaInterruptEntry(
    backend: BootstrapLlvmBackend,
    name: string
): i64* {
    val declared = bootstrapLlvmDeclare(
        backend, bootstrapLlvmXtensaInterruptEntrySymbol(name),
        backend.voidType, [], false, []
    )
    LLVMSetLinkage(declared, llvmInternalLinkage())
    LLVMSetSection(declared, ".iram1.text")
    declared
}

fun bootstrapLlvmDirectScalarType(type: string): string {
    bootstrapLlvmScalarType(type)
}

fun bootstrapLlvmDirectResultIsScalar(
    function: BootstrapIrFunction
): bool = bootstrapLlvmDirectScalarType(function.resultType) != ""

fun bootstrapLlvmDirectResultIsVoid(
    function: BootstrapIrFunction
): bool = bootstrapNormalizeType(function.resultType) == "void"

fun bootstrapLlvmDirectResultUsesOutput(
    function: BootstrapIrFunction
): bool = !bootstrapLlvmDirectResultIsScalar(function) &&
    !bootstrapLlvmDirectResultIsVoid(function)

fun bootstrapLlvmDirectParameterScalarType(
    function: BootstrapIrFunction,
    parameter: int
): string {
    if (parameter < 0 || parameter >= function.parameterTypes.size) ""
    else bootstrapLlvmDirectScalarType(function.parameterTypes[parameter])
}

fun bootstrapLlvmDirectNeedsArgumentCount(
    function: BootstrapIrFunction
): bool {
    var needed = false
    var parameter = 0
    while (!needed && parameter < function.parameters.size) {
        needed = bootstrapLlvmParameterHasDefault(
            function, function.parameters[parameter]
        )
        parameter = parameter + 1
    }
    needed
}

fun bootstrapLlvmDeclareDirectFunction(
    backend: BootstrapLlvmBackend,
    name: string,
    function: BootstrapIrFunction
): i64* {
    val scalarResult = bootstrapLlvmDirectScalarType(
        function.resultType
    )
    val parameters: array<i64*> = []
    if (scalarResult == "" && !bootstrapLlvmDirectResultIsVoid(function)) {
        parameters.append(backend.pointerType)
    }
    if (bootstrapLlvmDirectNeedsArgumentCount(function)) {
        parameters.append(backend.i64Type)
    }
    var parameter = 0
    while (parameter < function.parameters.size) {
        val scalar = bootstrapLlvmDirectParameterScalarType(
            function, parameter
        )
        parameters.append(
            if (scalar == "") backend.pointerType
            else backend.type(scalar)
        )
        parameter = parameter + 1
    }
    val declared = bootstrapLlvmDeclare(
        backend, bootstrapLlvmDirectFunctionSymbol(name),
        if (scalarResult == "") backend.voidType
        else backend.type(scalarResult),
        parameters, bootstrapLlvmDirectResultUsesOutput(function),
        bootstrapLlvmFalseFlags(parameters.size)
    )
    // Generated implementations are module-private. Foreign callers enter
    // through explicit export thunks, while closures and direct calls remain
    // inside this module. Internal linkage lets LLVM remove imported runtime
    // and library implementations which are not reachable from the artifact.
    LLVMSetLinkage(declared, llvmInternalLinkage())
    if (!function.naked && !function.noinlineHint &&
        (function.inlineHint || bootstrapLlvmMcuRuntimeInline(
            backend.targetTriple, function.name
        ))) {
        bootstrapLlvmAddFunctionAttribute(
            backend, declared, "alwaysinline"
        )
    }
    if (!function.naked && function.noinlineHint) {
        bootstrapLlvmAddFunctionAttribute(backend, declared, "noinline")
    }
    // ESP-IDF disables jump tables for Xtensa. Small embedded switches often
    // otherwise gain a larger read-only dispatch table than the code they
    // replace. Make this target policy automatic instead of requiring a
    // source-level optimization annotation.
    if (!function.naked &&
        bootstrapTextContains(backend.targetTriple, "xtensa")) {
        bootstrapLlvmAddStringFunctionAttribute(
            backend, declared, "no-jump-tables", "true"
        )
    }
    declared
}

class BootstrapLlvmFunctionStorage(
    val values: array<i64*>,
    val nativeValues: array<i64*>,
    val valueTypes: array<string>,
    val locals: array<i64*>,
    val nativeLocals: array<i64*>,
    val localTypes: array<string>,
    val parameters: array<i64*>,
    val scratch: array<i64*>,
    val scratchTypes: array<i64*>,
    val auxiliary: array<i64*>,
    val rootValues: array<bool>,
    val localIndex: BootstrapLlvmNameIndex,
    val labels: array<int>,
    val blocks: array<i64*>,
    val gcFrame: i64*,
    val gcRoots: i64*,
    val gcRootsType: i64*,
    val gcRootCount: int
)

fun BootstrapLlvmFunctionStorage.block(label: int): i64* {
    var result = nativeNullPointer()
    var index = 0
    while (index < this.labels.size) {
        if (this.labels[index] == label) result = this.blocks[index]
        index = index + 1
    }
    result
}

fun bootstrapLlvmValueCount(function: BootstrapIrFunction): int {
    var count = 0
    var index = 0
    while (index < function.instructions.size) {
        val instruction = function.instructions[index]
        if (instruction.result >= count) count = instruction.result + 1
        if (instruction.left >= count) count = instruction.left + 1
        if (instruction.right >= count) count = instruction.right + 1
        var operand = 0
        while (operand < instruction.operands.size) {
            if (instruction.operands[operand] >= count) {
                count = instruction.operands[operand] + 1
            }
            operand = operand + 1
        }
        index = index + 1
    }
    count
}

fun bootstrapLlvmCreateFunctionStorage(
    backend: BootstrapLlvmBackend,
    function: BootstrapIrFunction,
    llvmFunction: i64*,
    collecting: bool,
    rootValues: array<bool>,
    scalarPlan: BootstrapLlvmScalarPlan
): BootstrapLlvmFunctionStorage {
    val values: array<i64*> = []
    val nativeValues: array<i64*> = []
    val locals: array<i64*> = []
    val nativeLocals: array<i64*> = []
    val parameters: array<i64*> = []
    val scratch: array<i64*> = []
    val scratchTypes: array<i64*> = []
    val auxiliary: array<i64*> = []
    val labels: array<int> = []
    val blocks: array<i64*> = []
    val nullPointer = nativeNullPointer()
    val valueCount = bootstrapLlvmValueCount(function)
    var index = 0
    while (index < valueCount) {
        var slot: i64* = nullPointer
        if (index >= scalarPlan.valueTypes.size ||
            scalarPlan.valueTypes[index] == "" ||
            (index < scalarPlan.boxedValues.size &&
             scalarPlan.boxedValues[index])) {
            slot = LLVMBuildAlloca(
                backend.builder, backend.valueType, "value"
            )
            LLVMSetAlignment(slot, 8)
        }
        values.append(slot)
        nativeValues.append(nullPointer)
        index = index + 1
    }
    index = 0
    while (index < function.instructions.size) {
        val instruction = function.instructions[index]
        var local: i64* = nullPointer
        var nativeLocal: i64* = nullPointer
        if (instruction.opcode == "local.declare" ||
            bootstrapIrIsLocalZero(instruction.opcode) ||
            instruction.opcode == "local.allocate") {
            val scalar = if (index < scalarPlan.localTypes.size)
                scalarPlan.localTypes[index] else ""
            if (scalar == "") {
                local = LLVMBuildAlloca(
                    backend.builder, backend.valueType, "local"
                )
                LLVMSetAlignment(local, 8)
            } else {
                nativeLocal = LLVMBuildAlloca(
                    backend.builder, backend.type(scalar), "scalar.local"
                )
                LLVMSetAlignment(
                    nativeLocal, bootstrapLlvmScalarAlignment(scalar)
                )
            }
        }
        locals.append(local)
        nativeLocals.append(nativeLocal)
        var storage: i64* = nullPointer
        var storageType: i64* = nullPointer
        if ((instruction.opcode == "closure.create" ||
             instruction.opcode == "array.create") &&
            instruction.operands.size > 0) {
            storageType = LLVMArrayType2(
                backend.valueType, instruction.operands.size
            )
            storage = LLVMBuildAlloca(
                backend.builder, storageType, "arguments"
            )
            LLVMSetAlignment(storage, 8)
        }
        if ((instruction.opcode == "call.indirect" ||
             instruction.opcode == "call.indirect.once") &&
            instruction.operands.size > 1) {
            storageType = LLVMArrayType2(
                backend.valueType, instruction.operands.size - 1
            )
            storage = LLVMBuildAlloca(
                backend.builder, storageType, "indirect.arguments"
            )
            LLVMSetAlignment(storage, 8)
        }
        scratch.append(storage)
        scratchTypes.append(storageType)
        var extra: i64* = nullPointer
        if (instruction.opcode == "resource.drop") {
            extra = LLVMBuildAlloca(
                backend.builder, backend.valueType, "drop.result"
            )
            LLVMSetAlignment(extra, 8)
        }
        auxiliary.append(extra)
        if (instruction.opcode == "label") {
            labels.append(instruction.target)
            blocks.append(LLVMAppendBasicBlockInContext(
                backend.context,
                llvmFunction,
                "source.label"
            ))
        }
        index = index + 1
    }
    index = 0
    val resultUsesOutput = bootstrapLlvmDirectResultUsesOutput(function)
    val parameterBegin = (if (resultUsesOutput) 1 else 0) +
        if (bootstrapLlvmDirectNeedsArgumentCount(function)) 1 else 0
    while (index < function.parameters.size) {
        var slot: i64* = nullPointer
        if (bootstrapLlvmParameterHasDefault(
            function, function.parameters[index]
        )) {
            slot = LLVMBuildAlloca(
                backend.builder, backend.valueType, "parameter"
            )
            LLVMSetAlignment(slot, 8)
        } else if (bootstrapLlvmDirectParameterScalarType(
            function, index
        ) == "") {
            // Required arguments are guaranteed by semantic analysis. Keep
            // their incoming AblaValue pointer directly instead of copying a
            // 24-byte value through a second stack slot in every call.
            slot = LLVMGetParam(llvmFunction, index + parameterBegin)
        }
        parameters.append(slot)
        index = index + 1
    }
    index = 0
    val zero = LLVMConstNull(backend.valueType)
    while (index < values.size) {
        if (!pointerIsNull(values[index])) {
            val stored = LLVMBuildStore(backend.builder, zero, values[index])
            LLVMSetAlignment(stored, 8)
        }
        index = index + 1
    }
    index = 0
    while (index < locals.size) {
        if (!pointerIsNull(locals[index])) {
            val stored = LLVMBuildStore(backend.builder, zero, locals[index])
            LLVMSetAlignment(stored, 8)
        }
        index = index + 1
    }
    var rootCount = 0
    if (collecting) {
        index = 0
        while (index < parameters.size) {
            if (!pointerIsNull(parameters[index])) rootCount = rootCount + 1
            index = index + 1
        }
        index = 0
        while (index < values.size && index < rootValues.size) {
            if (rootValues[index] &&
                !pointerIsNull(values[index])) rootCount = rootCount + 1
            index = index + 1
        }
        index = 0
        while (index < locals.size) {
            if (!pointerIsNull(locals[index])) rootCount = rootCount + 1
            index = index + 1
        }
    }
    var gcFrame: i64* = nullPointer
    var gcRoots: i64* = nullPointer
    var gcRootsType: i64* = nullPointer
    if (rootCount > 0) {
        gcFrame = LLVMBuildAlloca(
            backend.builder, backend.rootFrameType, "gc.frame"
        )
        gcRootsType = LLVMArrayType2(backend.pointerType, rootCount)
        gcRoots = LLVMBuildAlloca(
            backend.builder, gcRootsType, "gc.roots"
        )
    }
    BootstrapLlvmFunctionStorage(
        values, nativeValues, scalarPlan.valueTypes,
        locals, nativeLocals, scalarPlan.localTypes,
        parameters, scratch, scratchTypes, auxiliary,
        rootValues, bootstrapLlvmLocalIndex(function),
        labels, blocks, gcFrame, gcRoots, gcRootsType, rootCount
    )
}

fun bootstrapLlvmInitializeParameters(
    backend: BootstrapLlvmBackend,
    function: BootstrapIrFunction,
    llvmFunction: i64*,
    storage: BootstrapLlvmFunctionStorage
): void {
    val resultUsesOutput = bootstrapLlvmDirectResultUsesOutput(function)
    val countIndex = if (resultUsesOutput) 1 else 0
    val needsArgumentCount = bootstrapLlvmDirectNeedsArgumentCount(function)
    val parameterBegin = countIndex + if (needsArgumentCount) 1 else 0
    val count = if (needsArgumentCount) {
        LLVMGetParam(llvmFunction, countIndex)
    } else LLVMConstInt(
        backend.i64Type, function.parameters.size, 0
    )
    var parameter = 0
    while (parameter < function.parameters.size) {
        val hasDefault = bootstrapLlvmParameterHasDefault(
            function, function.parameters[parameter]
        )
        if (!hasDefault) {
            // Required direct-call arguments are already either native LLVM
            // scalars or incoming AblaValue pointers in function storage.
            parameter = parameter + 1
            continue
        }
        val present = LLVMAppendBasicBlockInContext(
            backend.context, llvmFunction, "argument.present"
        )
        val missing = LLVMAppendBasicBlockInContext(
            backend.context, llvmFunction, "argument.missing"
        )
        val ready = LLVMAppendBasicBlockInContext(
            backend.context, llvmFunction, "argument.ready"
        )
        val hasArgument = LLVMBuildICmp(
            backend.builder,
            llvmIntUnsignedGreaterThan(),
            count,
            LLVMConstInt(backend.i64Type, parameter, 0),
            "argument.available"
        )
        LLVMBuildCondBr(backend.builder, hasArgument, present, missing)
        LLVMPositionBuilderAtEnd(backend.builder, present)
        val source = LLVMGetParam(
            llvmFunction, parameter + parameterBegin
        )
        val scalar = bootstrapLlvmDirectParameterScalarType(
            function, parameter
        )
        if (scalar == "") {
            bootstrapLlvmCopyValue(
                backend, source, storage.parameters[parameter], "argument"
            )
        } else {
            bootstrapLlvmBoxScalar(
                backend, storage.parameters[parameter], source, scalar
            )
        }
        LLVMBuildBr(backend.builder, ready)
        LLVMPositionBuilderAtEnd(backend.builder, missing)
        bootstrapLlvmRuntimeCall(
            backend, "abla_void", storage.parameters[parameter], []
        )
        LLVMBuildBr(backend.builder, ready)
        LLVMPositionBuilderAtEnd(backend.builder, ready)
        parameter = parameter + 1
    }
}

fun bootstrapLlvmParameterHasDefault(
    function: BootstrapIrFunction,
    name: string
): bool {
    var found = false
    var instruction = 0
    while (instruction < function.instructions.size) {
        val candidate = function.instructions[instruction]
        if (candidate.opcode == "parameter.default" &&
            candidate.text == name) found = true
        instruction = instruction + 1
    }
    found
}

fun bootstrapLlvmPushRoots(
    backend: BootstrapLlvmBackend,
    storage: BootstrapLlvmFunctionStorage
): void {
    if (storage.gcRootCount > 0) {
        var root = 0
        var index = 0
        while (index < storage.values.size) {
            if (index < storage.rootValues.size &&
                storage.rootValues[index] &&
                !pointerIsNull(storage.values[index])) {
                val destination = bootstrapLlvmArrayElement(
                    backend, storage.gcRootsType, storage.gcRoots,
                    root, "gc.root"
                )
                LLVMBuildStore(
                    backend.builder, storage.values[index], destination
                )
                root = root + 1
            }
            index = index + 1
        }
        index = 0
        while (index < storage.parameters.size) {
            if (!pointerIsNull(storage.parameters[index])) {
                val destination = bootstrapLlvmArrayElement(
                    backend, storage.gcRootsType, storage.gcRoots,
                    root, "gc.root"
                )
                LLVMBuildStore(
                    backend.builder, storage.parameters[index], destination
                )
                root = root + 1
            }
            index = index + 1
        }
        index = 0
        while (index < storage.locals.size) {
            if (!pointerIsNull(storage.locals[index])) {
                val destination = bootstrapLlvmArrayElement(
                    backend, storage.gcRootsType, storage.gcRoots,
                    root, "gc.root"
                )
                LLVMBuildStore(
                    backend.builder, storage.locals[index], destination
                )
                root = root + 1
            }
            index = index + 1
        }
        val first = bootstrapLlvmArrayElement(
            backend, storage.gcRootsType, storage.gcRoots, 0, "gc.roots.pointer"
        )
        bootstrapLlvmCallNamed(
            backend,
            "abla_runtime_roots_push",
            [storage.gcFrame, first,
             LLVMConstInt(backend.i64Type, storage.gcRootCount, 0)],
            "", false, [false, false, false]
        )
    }
}

fun bootstrapLlvmPopRoots(
    backend: BootstrapLlvmBackend,
    storage: BootstrapLlvmFunctionStorage
): void {
    if (storage.gcRootCount > 0) {
        bootstrapLlvmCallNamed(
            backend, "abla_runtime_roots_pop", [storage.gcFrame],
            "", false, [false]
        )
    }
}

fun bootstrapLlvmNativeValue(
    backend: BootstrapLlvmBackend,
    storage: BootstrapLlvmFunctionStorage,
    value: int
): i64* {
    var result = nativeNullPointer()
    if (value >= 0 && value < storage.nativeValues.size) {
        result = storage.nativeValues[value]
        if (pointerIsNull(result) &&
            value < storage.valueTypes.size &&
            storage.valueTypes[value] != "" &&
            !pointerIsNull(storage.values[value])) {
            val scalar = storage.valueTypes[value]
            result = bootstrapLlvmUnboxScalar(
                backend, storage.values[value], scalar, "scalar.unbox"
            )
        }
    }
    result
}

fun bootstrapLlvmUnboxScalar(
    backend: BootstrapLlvmBackend,
    boxed: i64*,
    scalar: string,
    name: string
): i64* {
    var result = bootstrapLlvmCallNamed(
        backend,
        if (scalar == "bool") "abla_as_bool" else "abla_as_i64",
        [boxed], name, false, [true]
    )
    if (scalar == "f64") result = LLVMBuildBitCast(
        backend.builder, result, backend.f64Type, "$name.f64"
    )
    if (scalar == "f32") result = LLVMBuildBitCast(
        backend.builder,
        LLVMBuildTrunc(
            backend.builder, result, backend.i32Type, "$name.f32.bits"
        ),
        backend.f32Type,
        "$name.f32"
    )
    if (bootstrapLlvmIsNarrowNativeInteger(scalar)) {
        result = LLVMBuildTrunc(
            backend.builder, result, backend.type(scalar), "$name.narrow"
        )
    }
    if (scalar == "ptr") result = LLVMBuildIntToPtr(
        backend.builder, result, backend.pointerType, "$name.pointer"
    )
    result
}

fun bootstrapLlvmCastNativeScalar(
    backend: BootstrapLlvmBackend,
    value: i64*,
    source: string,
    target: string,
    name: string
): i64* {
    var result = value
    if (source != target && bootstrapLlvmIsNativeInteger(source) &&
        bootstrapLlvmIsNativeInteger(target)) {
        val sourceWidth = bootstrapLlvmScalarBitWidth(source)
        val targetWidth = bootstrapLlvmScalarBitWidth(target)
        if (sourceWidth > targetWidth) result = LLVMBuildTrunc(
            backend.builder, value, backend.type(target), "$name.truncate"
        )
        if (sourceWidth < targetWidth) {
            result = if (bootstrapLlvmIsUnsignedNativeInteger(source)) {
                LLVMBuildZExt(
                    backend.builder, value, backend.type(target),
                    "$name.zero.extend"
                )
            } else LLVMBuildSExt(
                backend.builder, value, backend.type(target),
                "$name.sign.extend"
            )
        }
    }
    result
}

fun bootstrapLlvmBoxScalar(
    backend: BootstrapLlvmBackend,
    destination: i64*,
    native: i64*,
    scalar: string
): void {
    var stored = native
    if (scalar == "f64") stored = LLVMBuildBitCast(
        backend.builder, native, backend.i64Type, "scalar.f64.bits"
    )
    if (scalar == "f32") stored = LLVMBuildZExt(
        backend.builder,
        LLVMBuildBitCast(
            backend.builder, native, backend.i32Type, "scalar.f32.bits"
        ),
        backend.i64Type,
        "scalar.f32.wide"
    )
    if (bootstrapLlvmIsNarrowNativeInteger(scalar)) {
        stored = bootstrapLlvmCastNativeScalar(
            backend, native, scalar, "i64", "scalar.box"
        )
    }
    if (scalar == "ptr") stored = LLVMBuildPtrToInt(
        backend.builder, native, backend.i64Type, "scalar.pointer.address"
    )
    bootstrapLlvmCallNamed(
        backend,
        if (scalar == "bool") "abla_bool" else "abla_i64",
        [destination, stored], "", true, [false, false]
    )
    return
}

fun bootstrapLlvmSetNativeValue(
    backend: BootstrapLlvmBackend,
    var storage: BootstrapLlvmFunctionStorage,
    value: int,
    native: i64*
): void {
    if (value >= 0 && value < storage.nativeValues.size) {
        storage.nativeValues[value] = native
        if (!pointerIsNull(storage.values[value])) {
            val scalar = storage.valueTypes[value]
            bootstrapLlvmBoxScalar(
                backend, storage.values[value], native, scalar
            )
        }
    }
}

fun bootstrapLlvmNativeLocalPointer(
    storage: BootstrapLlvmFunctionStorage,
    name: string
): i64* {
    var result = nativeNullPointer()
    val local = storage.localIndex.find(name)
    if (local >= 0 && local < storage.nativeLocals.size) {
        result = storage.nativeLocals[local]
    }
    result
}

fun bootstrapLlvmPrepareArguments(
    backend: BootstrapLlvmBackend,
    storage: BootstrapLlvmFunctionStorage,
    instructionIndex: int,
    operands: array<int>,
    skip: int
): i64* {
    var result = LLVMConstNull(backend.pointerType)
    val count = operands.size - skip
    if (count > 0) {
        var operand = skip
        while (operand < operands.size) {
            val position = operand - skip
            val destination = bootstrapLlvmArrayElement(
                backend,
                storage.scratchTypes[instructionIndex],
                storage.scratch[instructionIndex],
                position,
                "call.argument"
            )
            bootstrapLlvmCopyValue(
                backend, storage.values[operands[operand]], destination,
                "call.argument.value"
            )
            operand = operand + 1
        }
        result = bootstrapLlvmArrayElement(
            backend,
            storage.scratchTypes[instructionIndex],
            storage.scratch[instructionIndex],
            0,
            "call.arguments"
        )
    }
    result
}

fun bootstrapLlvmDirectCallArguments(
    backend: BootstrapLlvmBackend,
    storage: BootstrapLlvmFunctionStorage,
    function: BootstrapIrFunction,
    operands: array<int>,
    output: i64*
): array<i64*> {
    val arguments: array<i64*> = []
    if (bootstrapLlvmDirectResultUsesOutput(function)) {
        arguments.append(output)
    }
    if (bootstrapLlvmDirectNeedsArgumentCount(function)) {
        arguments.append(LLVMConstInt(
            backend.i64Type, operands.size, 0
        ))
    }
    var parameter = 0
    while (parameter < function.parameters.size) {
        val scalar = bootstrapLlvmDirectParameterScalarType(
            function, parameter
        )
        if (parameter < operands.size) {
            if (scalar == "") {
                arguments.append(storage.values[operands[parameter]])
            } else {
                var native = bootstrapLlvmNativeValue(
                    backend, storage, operands[parameter]
                )
                if (pointerIsNull(native)) native = bootstrapLlvmUnboxScalar(
                    backend, storage.values[operands[parameter]], scalar,
                    "direct.argument"
                )
                if (!pointerIsNull(native) &&
                    operands[parameter] >= 0 &&
                    operands[parameter] < storage.valueTypes.size) {
                    val source = storage.valueTypes[operands[parameter]]
                    if (source != "") native = bootstrapLlvmCastNativeScalar(
                        backend, native, source, scalar,
                        "direct.argument.cast"
                    )
                }
                arguments.append(native)
            }
        } else {
            arguments.append(
                if (scalar == "") LLVMConstNull(backend.pointerType)
                else LLVMConstNull(backend.type(scalar))
            )
        }
        parameter = parameter + 1
    }
    arguments
}

fun bootstrapLlvmEmitDirectCall(
    backend: BootstrapLlvmBackend,
    function: BootstrapIrFunction,
    target: i64*,
    arguments: array<i64*>,
    output: i64*
): i64* {
    val scalar = bootstrapLlvmDirectScalarType(function.resultType)
    val returnsVoid = bootstrapLlvmDirectResultIsVoid(function)
    val result = bootstrapLlvmCall(
        backend, target, arguments,
        if (scalar == "") "" else "direct.scalar",
        scalar == "" && !returnsVoid,
        bootstrapLlvmFalseFlags(arguments.size)
    )
    if (scalar != "" && !pointerIsNull(output)) {
        bootstrapLlvmBoxScalar(backend, output, result, scalar)
    }
    result
}

fun bootstrapLlvmRuntimeOperation(opcode: string): string {
    var name = bootstrapLlvmRuntimeBinary(opcode)
    if (opcode == "neg") name = "abla_negate"
    if (opcode == "not") name = "abla_not"
    if (opcode == "bit.not") name = "ablaBitNot"
    if (opcode == "cell.create") name = "abla_cell_create"
    if (opcode == "cell.get") name = "abla_cell_get"
    if (opcode == "cell.set") name = "abla_cell_set"
    if (opcode == "shared.create") name = "abla_shared_create"
    if (opcode == "shared.clone") name = "abla_shared_clone"
    if (opcode == "shared.get") name = "abla_shared_get"
    if (opcode == "shared.lock") name = "abla_shared_lock"
    if (opcode == "shared.release") name = "abla_shared_release"
    if (opcode == "weak.create") name = "abla_weak_create"
    if (opcode == "weak.clone") name = "abla_weak_clone"
    if (opcode == "weak.upgrade") name = "abla_weak_upgrade"
    if (opcode == "weak.alive") name = "abla_weak_alive"
    if (opcode == "weak.release") name = "abla_weak_release"
    if (opcode == "length") name = "abla_length"
    if (opcode == "index.get") name = "abla_index_get"
    if (opcode == "string.length") name = "abla_string_length"
    if (opcode == "string.get") name = "abla_string_get"
    if (opcode == "array.length") name = "abla_array_length"
    if (opcode == "array.get") name = "abla_array_get"
    if (opcode == "string.equal") name = "abla_string_equal"
    if (opcode == "string.not.equal") name = "abla_string_not_equal"
    if (opcode == "array.append") name = "abla_array_append"
    if (opcode == "string.slice") name = "abla_string_slice"
    if (opcode == "string.concat") name = "abla_string_concat"
    if (opcode == "to.string") name = "abla_to_string"
    name
}

fun bootstrapLlvmScalarOperand(
    backend: BootstrapLlvmBackend,
    storage: BootstrapLlvmFunctionStorage,
    value: int,
    scalar: string
): i64* {
    var result = bootstrapLlvmNativeValue(backend, storage, value)
    if (pointerIsNull(result)) result = bootstrapLlvmUnboxScalar(
        backend, storage.values[value], scalar, "scalar.boundary"
    )
    if (!pointerIsNull(result) && value >= 0 &&
        value < storage.valueTypes.size &&
        storage.valueTypes[value] != "" &&
        storage.valueTypes[value] != scalar) {
        result = bootstrapLlvmCastNativeScalar(
            backend, result, storage.valueTypes[value], scalar,
            "scalar.operand"
        )
    }
    result
}

fun bootstrapLlvmEmitScalarOperation(
    backend: BootstrapLlvmBackend,
    var storage: BootstrapLlvmFunctionStorage,
    instruction: BootstrapInstruction
): bool {
    var emitted = false
    if (instruction.result >= 0 &&
        instruction.result < storage.valueTypes.size &&
        storage.valueTypes[instruction.result] != "") {
        var native = nativeNullPointer()
        if (instruction.opcode == "scalar.cast") {
            val target = storage.valueTypes[instruction.result]
            var source = ""
            if (instruction.left >= 0 &&
                instruction.left < storage.valueTypes.size) {
                source = storage.valueTypes[instruction.left]
            }
            val operand = bootstrapLlvmScalarOperand(
                backend, storage, instruction.left,
                if (source == "") target else source
            )
            if (!pointerIsNull(operand)) native =
                if (source == "" || source == target) operand
                else bootstrapLlvmCastNativeScalar(
                    backend, operand, source, target, "scalar.cast"
                )
        }
        if (instruction.opcode == "+" || instruction.opcode == "-" ||
            instruction.opcode == "*" || instruction.opcode == "/" ||
            instruction.opcode == "%") {
            val scalar = storage.valueTypes[instruction.result]
            val left = bootstrapLlvmScalarOperand(
                backend, storage, instruction.left, scalar
            )
            val right = bootstrapLlvmScalarOperand(
                backend, storage, instruction.right, scalar
            )
            if (scalar == "f32" || scalar == "f64") {
                if (instruction.opcode == "+") native = LLVMBuildFAdd(
                    backend.builder, left, right, "scalar.fadd"
                )
                if (instruction.opcode == "-") native = LLVMBuildFSub(
                    backend.builder, left, right, "scalar.fsubtract"
                )
                if (instruction.opcode == "*") native = LLVMBuildFMul(
                    backend.builder, left, right, "scalar.fmultiply"
                )
                if (instruction.opcode == "/") native = LLVMBuildFDiv(
                    backend.builder, left, right, "scalar.fdivide"
                )
                if (instruction.opcode == "%") native = LLVMBuildFRem(
                    backend.builder, left, right, "scalar.fremainder"
                )
            } else {
                if (instruction.opcode == "+") native = LLVMBuildAdd(
                    backend.builder, left, right, "scalar.add"
                )
                if (instruction.opcode == "-") native = LLVMBuildSub(
                    backend.builder, left, right, "scalar.subtract"
                )
                if (instruction.opcode == "*") native = LLVMBuildMul(
                    backend.builder, left, right, "scalar.multiply"
                )
                if (instruction.opcode == "/") native =
                    if (bootstrapLlvmIsUnsignedNativeInteger(scalar)) {
                        LLVMBuildUDiv(
                            backend.builder, left, right, "scalar.divide"
                        )
                    } else LLVMBuildSDiv(
                        backend.builder, left, right, "scalar.divide"
                    )
                if (instruction.opcode == "%") native =
                    if (bootstrapLlvmIsUnsignedNativeInteger(scalar)) {
                        LLVMBuildURem(
                            backend.builder, left, right, "scalar.remainder"
                        )
                    } else LLVMBuildSRem(
                        backend.builder, left, right, "scalar.remainder"
                    )
            }
        }
        if (instruction.opcode == "neg") {
            val scalar = storage.valueTypes[instruction.result]
            val operand = bootstrapLlvmScalarOperand(
                backend, storage, instruction.left, scalar
            )
            native = if (scalar == "f32" || scalar == "f64") LLVMBuildFNeg(
                backend.builder, operand, "scalar.fnegate"
            ) else LLVMBuildNeg(backend.builder, operand, "scalar.negate")
        }
        if (instruction.opcode == "&" || instruction.opcode == "|" ||
            instruction.opcode == "^") {
            val scalar = storage.valueTypes[instruction.result]
            val left = bootstrapLlvmScalarOperand(
                backend, storage, instruction.left, scalar
            )
            val right = bootstrapLlvmScalarOperand(
                backend, storage, instruction.right, scalar
            )
            if (!pointerIsNull(left) && !pointerIsNull(right) &&
                instruction.opcode == "&") native = LLVMBuildAnd(
                    backend.builder, left, right, "scalar.bit.and"
                )
            if (!pointerIsNull(left) && !pointerIsNull(right) &&
                instruction.opcode == "|") native = LLVMBuildOr(
                    backend.builder, left, right, "scalar.bit.or"
                )
            if (!pointerIsNull(left) && !pointerIsNull(right) &&
                instruction.opcode == "^") native = LLVMBuildXor(
                    backend.builder, left, right, "scalar.bit.xor"
                )
        }
        if (instruction.opcode == "bit.not") {
            val scalar = storage.valueTypes[instruction.result]
            val value = bootstrapLlvmScalarOperand(
                backend, storage, instruction.left, scalar
            )
            if (!pointerIsNull(value)) native = LLVMBuildXor(
                backend.builder, value,
                LLVMConstInt(backend.type(scalar), -1, 1),
                "scalar.bit.not"
            )
        }
        if (instruction.opcode == "<<" || instruction.opcode == ">>" ||
            instruction.opcode == ">>>") {
            val scalar = storage.valueTypes[instruction.result]
            val value = bootstrapLlvmScalarOperand(
                backend, storage, instruction.left, scalar
            )
            val count = bootstrapLlvmScalarOperand(
                backend, storage, instruction.right, scalar
            )
            if (!pointerIsNull(value) && !pointerIsNull(count)) {
                val zero = LLVMConstInt(backend.type(scalar), 0, 0)
                val negative = if (
                    bootstrapLlvmIsUnsignedNativeInteger(scalar)
                ) LLVMConstInt(backend.i1Type, 0, 0) else LLVMBuildICmp(
                    backend.builder, llvmIntSignedLessThan(), count, zero,
                    "scalar.shift.negative"
                )
                val tooLarge = LLVMBuildICmp(
                    backend.builder,
                    if (bootstrapLlvmIsUnsignedNativeInteger(scalar)) {
                        llvmIntUnsignedGreaterOrEqual()
                    } else llvmIntSignedGreaterOrEqual(), count,
                    LLVMConstInt(
                        backend.type(scalar),
                        bootstrapLlvmScalarBitWidth(scalar), 0
                    ),
                    "scalar.shift.too.large"
                )
                val invalid = LLVMBuildOr(
                    backend.builder, negative, tooLarge,
                    "scalar.shift.invalid"
                )
                val safeCount = LLVMBuildSelect(
                    backend.builder, invalid, zero, count,
                    "scalar.shift.safe.count"
                )
                var shifted = nativeNullPointer()
                if (instruction.opcode == "<<") shifted = LLVMBuildShl(
                    backend.builder, value, safeCount, "scalar.shift.left"
                )
                if (instruction.opcode == ">>") shifted =
                    if (bootstrapLlvmIsUnsignedNativeInteger(scalar)) {
                        LLVMBuildLShr(
                            backend.builder, value, safeCount,
                            "scalar.shift.right"
                        )
                    } else LLVMBuildAShr(
                        backend.builder, value, safeCount,
                        "scalar.shift.right"
                    )
                if (instruction.opcode == ">>>") shifted = LLVMBuildLShr(
                    backend.builder, value, safeCount,
                    "scalar.shift.right.unsigned"
                )
                native = LLVMBuildSelect(
                    backend.builder, invalid, zero, shifted,
                    "scalar.shift.result"
                )
            }
        }
        if (instruction.opcode == "not") native = LLVMBuildXor(
            backend.builder,
            bootstrapLlvmScalarOperand(
                backend, storage, instruction.left, "bool"
            ),
            LLVMConstInt(backend.i1Type, 1, 0), "scalar.not"
        )
        if (instruction.opcode == "string.length" ||
            instruction.opcode == "array.length") {
            native = bootstrapLlvmCallNamed(
                backend,
                if (instruction.opcode == "string.length") {
                    "abla_string_length_i64"
                } else "abla_array_length_i64",
                [storage.values[instruction.left]],
                "scalar.length", false, [true]
            )
        }
        if (instruction.opcode == "string.get") {
            native = bootstrapLlvmCallNamed(
                backend, "abla_string_get_i64",
                [storage.values[instruction.left],
                 bootstrapLlvmScalarOperand(
                    backend, storage, instruction.right, "i64"
                 )],
                "scalar.string.get", false, [true, false]
            )
        }
        if (instruction.opcode == "array.get.i64" ||
            instruction.opcode == "array.get.bool" ||
            instruction.opcode == "array.get.f64") {
            native = bootstrapLlvmCallNamed(
                backend,
                if (instruction.opcode == "array.get.bool") {
                    "abla_array_get_bool"
                } else "abla_array_get_i64",
                [storage.values[instruction.left],
                 bootstrapLlvmScalarOperand(
                    backend, storage, instruction.right, "i64"
                 )],
                "scalar.array.get", false, [true, false]
            )
            if (instruction.opcode == "array.get.f64") {
                native = LLVMBuildBitCast(
                    backend.builder, native, backend.f64Type,
                    "scalar.array.get.f64"
                )
            }
        }
        if (instruction.opcode == "string.equal" ||
            instruction.opcode == "string.not.equal") {
            native = bootstrapLlvmCallNamed(
                backend,
                if (instruction.opcode == "string.equal") {
                    "abla_string_equal_bool"
                } else "abla_string_not_equal_bool",
                [storage.values[instruction.left],
                 storage.values[instruction.right]],
                "scalar.string.equal", false, [true, true]
            )
        }
        if (instruction.opcode == "field.get.indexed.i64" ||
            instruction.opcode == "field.get.indexed.bool" ||
            instruction.opcode == "field.get.indexed.f64") {
            native = bootstrapLlvmCallNamed(
                backend,
                if (instruction.opcode == "field.get.indexed.bool") {
                    "abla_field_get_indexed_bool"
                } else "abla_field_get_indexed_i64",
                [storage.values[instruction.left], LLVMConstInt(
                    backend.i32Type,
                    bootstrapLlvmStableNameId(instruction.text), 0
                 ), LLVMConstInt(
                    backend.i64Type, instruction.target, 0
                 )],
                "scalar.field.get", false, [true, false, false]
            )
            if (instruction.opcode == "field.get.indexed.f64") {
                native = LLVMBuildBitCast(
                    backend.builder, native, backend.f64Type,
                    "scalar.field.get.f64"
                )
            }
        }
        if (instruction.opcode == "&&" || instruction.opcode == "||") {
            val left = bootstrapLlvmScalarOperand(
                backend, storage, instruction.left, "bool"
            )
            val right = bootstrapLlvmScalarOperand(
                backend, storage, instruction.right, "bool"
            )
            native = if (instruction.opcode == "&&") LLVMBuildAnd(
                backend.builder, left, right, "scalar.and"
            ) else LLVMBuildOr(
                backend.builder, left, right, "scalar.or"
            )
        }
        if (instruction.opcode == "==" || instruction.opcode == "!=" ||
            instruction.opcode == "<" || instruction.opcode == "<=" ||
            instruction.opcode == ">" || instruction.opcode == ">=") {
            var operandType = "i64"
            var rightType = ""
            if (instruction.left >= 0 &&
                instruction.left < storage.valueTypes.size &&
                storage.valueTypes[instruction.left] != "") {
                operandType = storage.valueTypes[instruction.left]
            }
            if (instruction.right >= 0 &&
                instruction.right < storage.valueTypes.size) {
                rightType = storage.valueTypes[instruction.right]
            }
            if (rightType != "" && rightType != operandType &&
                bootstrapIsIntegerScalarType(rightType) &&
                bootstrapIsIntegerScalarType(operandType)) {
                operandType = "i64"
            }
            val left = bootstrapLlvmScalarOperand(
                backend, storage, instruction.left, operandType
            )
            val right = bootstrapLlvmScalarOperand(
                backend, storage, instruction.right, operandType
            )
            if (operandType == "f32" || operandType == "f64") {
                var predicate = llvmRealOrderedEqual()
                if (instruction.opcode == "!=") {
                    predicate = llvmRealUnorderedNotEqual()
                }
                if (instruction.opcode == "<") {
                    predicate = llvmRealOrderedLessThan()
                }
                if (instruction.opcode == "<=") {
                    predicate = llvmRealOrderedLessOrEqual()
                }
                if (instruction.opcode == ">") {
                    predicate = llvmRealOrderedGreaterThan()
                }
                if (instruction.opcode == ">=") {
                    predicate = llvmRealOrderedGreaterOrEqual()
                }
                native = LLVMBuildFCmp(
                    backend.builder, predicate, left, right,
                    "scalar.fcompare"
                )
            } else {
                val unsigned = bootstrapLlvmIsUnsignedNativeInteger(
                    operandType
                )
                var predicate = llvmIntEqual()
                if (instruction.opcode == "!=") predicate = llvmIntNotEqual()
                if (instruction.opcode == "<") {
                    predicate = if (unsigned) llvmIntUnsignedLessThan()
                        else llvmIntSignedLessThan()
                }
                if (instruction.opcode == "<=") {
                    predicate = if (unsigned) llvmIntUnsignedLessOrEqual()
                        else llvmIntSignedLessOrEqual()
                }
                if (instruction.opcode == ">") {
                    predicate = if (unsigned) llvmIntUnsignedGreaterThan()
                        else llvmIntSignedGreaterThan()
                }
                if (instruction.opcode == ">=") {
                    predicate = if (unsigned) llvmIntUnsignedGreaterOrEqual()
                        else llvmIntSignedGreaterOrEqual()
                }
                native = LLVMBuildICmp(
                    backend.builder, predicate, left, right,
                    "scalar.compare"
                )
            }
        }
        if (!pointerIsNull(native)) {
            bootstrapLlvmSetNativeValue(
                backend, storage, instruction.result, native
            )
            emitted = true
        }
    }
    emitted
}

fun bootstrapLlvmParseInteger(text: string): int {
    var sign = 1
    var index = 0
    if (text.size > 0 && text[0] == 45) {
        sign = -1
        index = 1
    }
    var result = 0
    while (index < text.size) {
        result = result * 10 + text[index] - 48
        index = index + 1
    }
    result * sign
}

fun bootstrapLlvmInstructionInputs(
    storage: BootstrapLlvmFunctionStorage,
    instruction: BootstrapInstruction
): array<i64*> {
    val inputs: array<i64*> = []
    if (instruction.operands.size > 0) {
        var index = 0
        while (index < instruction.operands.size) {
            inputs.append(storage.values[instruction.operands[index]])
            index = index + 1
        }
    } else {
        if (instruction.left >= 0) inputs.append(
            storage.values[instruction.left]
        )
        if (instruction.right >= 0) inputs.append(
            storage.values[instruction.right]
        )
    }
    inputs
}

fun bootstrapLlvmNativeArgument(
    backend: BootstrapLlvmBackend,
    storage: BootstrapLlvmFunctionStorage,
    value: int,
    type: string
): i64* {
    var result = nativeNullPointer()
    var scalar = nativeNullPointer()
    var scalarType = ""
    if (value >= 0 && value < storage.valueTypes.size &&
        storage.valueTypes[value] != "") {
        scalarType = storage.valueTypes[value]
        scalar = bootstrapLlvmNativeValue(backend, storage, value)
    }
    if (type == "bool" && !pointerIsNull(scalar)) {
        result = scalar
    } else if (type == "bool") {
        result = bootstrapLlvmCallNamed(
            backend, "abla_as_bool", [storage.values[value]],
            "native.bool", false, [true]
        )
    } else if ((type == "f32" || type == "f64") &&
        !pointerIsNull(scalar)) {
        result = scalar
    } else if (type == "f32" || type == "f64") {
        result = bootstrapLlvmUnboxScalar(
            backend, storage.values[value], type, "native.float"
        )
    } else if (type == "cstring") {
        result = bootstrapLlvmCallNamed(
            backend, "abla_as_cstring", [storage.values[value]],
            "native.cstring", false, [true]
        )
    } else if (bootstrapLlvmIsPointerType(type) && scalarType == "ptr" &&
        !pointerIsNull(scalar)) {
        result = scalar
    } else {
        val integer = if (!pointerIsNull(scalar)) scalar
            else bootstrapLlvmCallNamed(
                backend, "abla_as_i64", [storage.values[value]],
                "native.integer", false, [true]
            )
        result = integer
        if (bootstrapLlvmIsNativeInteger(type)) {
            if (scalarType != "" &&
                bootstrapLlvmIsNativeInteger(scalarType)) {
                result = bootstrapLlvmCastNativeScalar(
                    backend, integer, scalarType, type, "native.argument"
                )
            } else if (bootstrapLlvmIsNarrowNativeInteger(type)) {
                result = LLVMBuildTrunc(
                    backend.builder, integer, backend.type(type),
                    "native.narrow"
                )
            }
        }
        if (bootstrapLlvmIsPointerType(type)) {
            result = LLVMBuildIntToPtr(
                backend.builder, integer, backend.pointerType,
                "native.pointer"
            )
        }
    }
    result
}

fun bootstrapLlvmStoreNativeResult(
    backend: BootstrapLlvmBackend,
    var storage: BootstrapLlvmFunctionStorage,
    output: int,
    value: i64*,
    type: string
): void {
    if (type == "void") {
        bootstrapLlvmRuntimeCall(
            backend, "abla_void", storage.values[output], []
        )
    }
    if (type == "bool") {
        bootstrapLlvmCallNamed(
            backend, "abla_bool", [storage.values[output], value],
            "", true, [false, false]
        )
    }
    if (bootstrapLlvmIsNativeInteger(type)) {
        var integer = value
        if (bootstrapLlvmIsNarrowNativeInteger(type)) {
            if (bootstrapLlvmIsUnsignedNativeInteger(type)) {
                integer = LLVMBuildZExt(
                    backend.builder, value, backend.i64Type, "native.wide"
                )
            } else {
                integer = LLVMBuildSExt(
                    backend.builder, value, backend.i64Type, "native.wide"
                )
            }
        }
        bootstrapLlvmCallNamed(
            backend, "abla_i64", [storage.values[output], integer],
            "", true, [false, false]
        )
    }
    if (bootstrapLlvmIsPointerType(type)) {
        if (output >= 0 && output < storage.valueTypes.size &&
            storage.valueTypes[output] == "ptr") {
            bootstrapLlvmSetNativeValue(backend, storage, output, value)
        } else {
            val integer = LLVMBuildPtrToInt(
                backend.builder, value, backend.i64Type, "native.address"
            )
            bootstrapLlvmCallNamed(
                backend, "abla_i64", [storage.values[output], integer],
                "", true, [false, false]
            )
        }
    }
    if (type == "f32" || type == "f64") {
        bootstrapLlvmBoxScalar(
            backend, storage.values[output], value, type
        )
    }
}

fun bootstrapLlvmEmitNativeCall(
    backend: BootstrapLlvmBackend,
    program: BootstrapIrProgram,
    nativeIndex: BootstrapLlvmNameIndex,
    var storage: BootstrapLlvmFunctionStorage,
    instruction: BootstrapInstruction
): bool {
    var supported = true
    val arguments: array<i64*> = []
    val temporaryCStrings: array<i64*> = []
    val parameterTypes: array<i64*> = []
    val byval: array<bool> = []
    var operand = 0
    while (operand < instruction.operands.size) {
        val type = bootstrapLlvmNativeParameterType(
            program, nativeIndex, instruction.text, operand
        )
        val nativeType = bootstrapLlvmNativeType(type)
        if (nativeType == "unknown") supported = false
        val argument = bootstrapLlvmNativeArgument(
            backend, storage, instruction.operands[operand], type
        )
        arguments.append(argument)
        if (type == "cstring") temporaryCStrings.append(argument)
        parameterTypes.append(backend.type(nativeType))
        byval.append(false)
        operand = operand + 1
    }
    val resultType = bootstrapLlvmNativeResultType(
        program, nativeIndex, instruction.text
    )
    val nativeResultType = bootstrapLlvmNativeType(resultType)
    if (nativeResultType == "unknown" || resultType == "cstring") {
        supported = false
    }
    if (supported) {
        val native = bootstrapLlvmDeclare(
            backend, instruction.text, backend.type(nativeResultType),
            parameterTypes, false, byval
        )
        val result = bootstrapLlvmCall(
            backend, native, arguments,
            if (resultType == "void") "" else "native.result",
            false, byval
        )
        if (instruction.result >= 0 &&
            instruction.result < storage.valueTypes.size &&
            storage.valueTypes[instruction.result] != "") {
            bootstrapLlvmSetNativeValue(
                backend, storage, instruction.result, result
            )
        } else {
            bootstrapLlvmStoreNativeResult(
                backend, storage, instruction.result, result, resultType
            )
        }
        if (bootstrapLlvmNativeNoEscape(
            program, nativeIndex, instruction.text
        )) {
            val release = bootstrapLlvmDeclare(
                backend, "abla_platform_free", backend.voidType,
                [backend.pointerType], false, [false]
            )
            var temporary = 0
            while (temporary < temporaryCStrings.size) {
                bootstrapLlvmCall(
                    backend, release, [temporaryCStrings[temporary]],
                    "", false, [false]
                )
                temporary = temporary + 1
            }
        }
    }
    supported
}

fun bootstrapLlvmCoreIntrinsic(name: string): bool =
    name == "ablaCountLeadingZerosU32" ||
    name == "ablaRuntimeValueAddress" ||
    name == "ablaRuntimeMakeValue" ||
    name == "ablaRuntimeLoadI32" ||
    name == "ablaRuntimeStoreI32" ||
    name == "ablaRuntimeLoadI64" ||
    name == "ablaRuntimeStoreI64" ||
    name == "ablaRuntimeLoadU8" ||
    name == "ablaRuntimeStoreU8" ||
    name == "ablaRuntimeTrap" ||
    name == "ablaRuntimePointerAddress" ||
    name == "ablaRuntimePointerFromAddress" ||
    name == "nativeStackAllocate" ||
    name == "nativeStaticAllocate" ||
    name == "nativeInitializeGlobals" ||
    name == "nativeLinkerSymbolAddress" ||
    name == "nativeLinkedStaticAllocate" ||
    name == "nativeLinkedThreadLocalAllocate" ||
    name == "nativeThreadLocalBytes" ||
    name == "nativeXtensaCoreId" ||
    name == "nativeXtensaCycleCounter" ||
    name == "nativeXtensaDelayCycles" ||
    name == "nativeXtensaInterruptsEnable" ||
    name == "nativeXtensaInterruptsDisable" ||
    name == "nativeXtensaInterruptTableAddress" ||
    name == "nativeXtensaExceptionTableAddress" ||
    name == "nativeXtensaInterruptLevelTableAddress" ||
    name == "nativeXtensaUnhandledInterruptAddress" ||
    name == "nativeXtensaUnhandledExceptionAddress" ||
    name == "nativeXtensaOwnedDispatcherTableAddress" ||
    name == "ablaUnsafeLoadI64" ||
    name == "ablaUnsafeStoreI64" ||
    name == "ablaUnsafeAtomicFetchAddI64" ||
    name == "ablaUnsafeLoadPointer" ||
    name == "ablaUnsafeStorePointer" ||
    name == "ablaUnsafeNullPointer" ||
    name == "ablaUnsafePointerIsNull" ||
    bootstrapLlvmUnsafeCallIntrinsic(name) ||
    name == "ablaUnsafeCStringAddress" ||
    name == "ablaUnsafeStringAddress" ||
    name == "ablaUnsafePointerAddress" ||
    name == "ablaUnsafePointerOffset" ||
    name == "ablaUnsafeLoadU8" ||
    name == "ablaUnsafeLoadU16" ||
    name == "ablaUnsafeLoadU32" ||
    name == "ablaUnsafeStoreU8" ||
    name == "ablaUnsafeStoreU16" ||
    name == "ablaUnsafeStoreU32" ||
    name == "ablaUnsafeSetMemory" ||
    name == "ablaUnsafeVolatileLoadU8" ||
    name == "ablaUnsafeVolatileLoadU16" ||
    name == "ablaUnsafeVolatileLoadU32" ||
    name == "ablaUnsafeVolatileLoadU64" ||
    name == "ablaUnsafeVolatileStoreU8" ||
    name == "ablaUnsafeVolatileStoreU16" ||
    name == "ablaUnsafeVolatileStoreU32" ||
    name == "ablaUnsafeVolatileStoreU64" ||
    name == "ablaUnsafeCopyMemory" ||
    name == "ablaUnsafeAdoptString" ||
    name == "ablaUnsafeBorrowCString" ||
    name == "ablaBitF64ToI64" ||
    name == "ablaBitI64ToF64" ||
    name == "ablaConvertI64ToF64" ||
    name == "ablaBitF32ToI32" ||
    name == "ablaBitI32ToF32" ||
    name == "ablaConvertU32ToF32" ||
    name == "ablaConvertI32ToF32" ||
    name == "ablaConvertF32ToU32" ||
    name == "ablaConvertF32ToI32" ||
    name == "ablaHostIsMacOS" ||
    name == "ablaHostValueArgumentsIndirect" ||
    name == "ablaLinuxArgumentCount" ||
    name == "ablaLinuxArgument" ||
    name == "ablaLinuxEnvironmentPointer" ||
    name == "ablaLinuxSyscall" ||
    name == "ablaRuntimeWasmHeapBase" ||
    name == "ablaRuntimeWasmMemorySize" ||
    name == "ablaRuntimeWasmMemoryGrow"

fun bootstrapLlvmCoreIntrinsicInteger(
    backend: BootstrapLlvmBackend,
    storage: BootstrapLlvmFunctionStorage,
    value: int
): i64* {
    var result = bootstrapLlvmNativeValue(backend, storage, value)
    if (!pointerIsNull(result) && value >= 0 &&
        value < storage.valueTypes.size) {
        val type = storage.valueTypes[value]
        if (bootstrapLlvmIsNativeInteger(type) && type != "i64") {
            result = bootstrapLlvmCastNativeScalar(
                backend, result, type, "i64", "runtime.intrinsic.integer"
            )
        }
        if (type == "bool") result = LLVMBuildZExt(
            backend.builder, result, backend.i64Type,
            "runtime.intrinsic.integer"
        )
        if (type == "ptr") result = LLVMBuildPtrToInt(
            backend.builder, result, backend.i64Type,
            "runtime.intrinsic.pointer.address"
        )
    }
    if (pointerIsNull(result)) result = bootstrapLlvmCallNamed(
        backend, "abla_as_i64", [storage.values[value]],
        "runtime.intrinsic.integer", false, [true]
    )
    result
}

fun bootstrapLlvmCoreIntrinsicConstantString(
    function: BootstrapIrFunction,
    value: int
): string {
    var result = ""
    var index = 0
    while (result == "" && index < function.instructions.size) {
        val candidate = function.instructions[index]
        if (candidate.result == value && candidate.opcode == "const.string") {
            result = candidate.text
        }
        index = index + 1
    }
    result
}

fun bootstrapLlvmStorePointerIntrinsic(
    backend: BootstrapLlvmBackend,
    var storage: BootstrapLlvmFunctionStorage,
    result: int,
    pointer: i64*
): void {
    if (result >= 0 && result < storage.valueTypes.size &&
        storage.valueTypes[result] == "ptr") {
        bootstrapLlvmSetNativeValue(backend, storage, result, pointer)
    } else bootstrapLlvmStoreTaggedWordValue(
        backend, storage.values[result], 2,
        LLVMBuildPtrToInt(
            backend.builder, pointer, backend.i64Type,
            "pointer.intrinsic.address"
        )
    )
    return
}

fun bootstrapLlvmInitializeVoidValue(
    backend: BootstrapLlvmBackend,
    destination: i64*
): void {
    val stored = LLVMBuildStore(
        backend.builder, LLVMConstNull(backend.valueType), destination
    )
    LLVMSetAlignment(stored, 8)
}

fun bootstrapLlvmEmitInlineAssembly(
    backend: BootstrapLlvmBackend,
    var storage: BootstrapLlvmFunctionStorage,
    instruction: BootstrapInstruction
): bool {
    val resultCode = instruction.text
    val constraints = if (instruction.texts.size > 0)
        instruction.texts[0] else ""
    val assembly = if (instruction.texts.size > 1)
        instruction.texts[1] else ""
    val resultType = if (resultCode == "void") backend.voidType
        else backend.type(bootstrapLlvmScalarType(resultCode))
    var supported = resultCode == "void" ||
        bootstrapLlvmScalarType(resultCode) != ""
    val parameterTypes: array<i64*> = []
    val arguments: array<i64*> = []
    var operand = 0
    while (operand < instruction.operands.size) {
        val value = instruction.operands[operand]
        var code = ""
        if (value >= 0 && value < storage.valueTypes.size) {
            code = bootstrapLlvmScalarType(storage.valueTypes[value])
        }
        if (code == "") supported = false
        if (code != "") {
            parameterTypes.append(backend.type(code))
            val argument = bootstrapLlvmNativeValue(
                backend, storage, value
            )
            if (pointerIsNull(argument)) supported = false
            arguments.append(argument)
        }
        operand = operand + 1
    }
    if (supported) {
        val type = bootstrapLlvmFunctionType(
            backend, resultType, parameterTypes
        )
        val operation = LLVMGetInlineAsm(
            type,
            assembly,
            assembly.size,
            constraints,
            constraints.size,
            1,
            0,
            0,
            0
        )
        val result = bootstrapLlvmCallTyped(
            backend,
            type,
            operation,
            arguments,
            if (resultCode == "void") "" else "inline.assembly.result"
        )
        if (resultCode == "void") {
            bootstrapLlvmInitializeVoidValue(
                backend, storage.values[instruction.result]
            )
        } else bootstrapLlvmSetNativeValue(
            backend, storage, instruction.result, result
        )
    }
    supported
}

fun bootstrapLlvmNakedAssemblyIndex(
    function: BootstrapIrFunction
): int {
    if (!function.naked) return -1
    var found = -1
    var valid = true
    var index = 0
    while (index < function.instructions.size) {
        val opcode = function.instructions[index].opcode
        if (opcode == "inline.assembly") {
            if (found < 0) found = index else found = -2
        }
        if (opcode != "inline.assembly" && opcode != "return") {
            valid = false
        }
        index = index + 1
    }
    if (valid) found else -2
}

fun bootstrapLlvmAssemblyDirectiveAt(
    assembly: string,
    offset: int,
    end: int,
    directive: string
): bool {
    var matches = offset + directive.size <= end
    var index = 0
    while (matches && index < directive.size) {
        matches = assembly[offset + index] == directive[index]
        index = index + 1
    }
    if (matches && offset + directive.size < end) {
        val next = assembly[offset + directive.size]
        matches = next == 32 || next == 9 || next == 10 || next == 13
    }
    matches
}

// Reconstructed native sources can place many independently collectable
// functions and data records in one inline-assembly string. The reachability
// graph decides which pushsection regions are live; omit the dead regions
// before assembly so their unresolved relocations cannot pull archive members
// before the ELF linker's section garbage collection runs. This is still one
// LLVM module and one native object.
fun bootstrapLlvmFilterAssemblyRegions(
    assembly: string,
    instructionIndex: int,
    regionBegin: int,
    regionEnd: int,
    regionInstructions: array<int>,
    regionOrdinals: array<int>,
    regionReachable: array<bool>
): string {
    if (regionBegin < 0 || regionEnd <= regionBegin) return assembly
    val keep: array<bool> = []
    var regionIndex = regionBegin
    var applicable = false
    while (regionIndex < regionEnd) {
        if (regionInstructions[regionIndex] == instructionIndex) {
            applicable = true
            val ordinal = regionOrdinals[regionIndex]
            while (keep.size <= ordinal) keep.append(false)
            keep[ordinal] = regionReachable[regionIndex]
        }
        regionIndex = regionIndex + 1
    }
    if (!applicable) return assembly

    val output = nativeByteBuffer(assembly.size + 1)
    if (pointerIsNull(output.address)) return assembly
    val regionStack: array<int> = []
    var regionDepth = 0
    var nextRegion = 0
    var source = 0
    var destination = 0
    var valid = true
    while (valid && source < assembly.size) {
        var lineEnd = source
        while (lineEnd < assembly.size && assembly[lineEnd] != 10) {
            lineEnd = lineEnd + 1
        }
        if (lineEnd < assembly.size) lineEnd = lineEnd + 1
        var directive = source
        while (directive < lineEnd &&
               (assembly[directive] == 32 || assembly[directive] == 9)) {
            directive = directive + 1
        }
        val push = bootstrapLlvmAssemblyDirectiveAt(
            assembly, directive, lineEnd, ".pushsection"
        )
        val pop = bootstrapLlvmAssemblyDirectiveAt(
            assembly, directive, lineEnd, ".popsection"
        )
        var include = regionDepth == 0 ||
            (regionStack[regionDepth - 1] < keep.size &&
             keep[regionStack[regionDepth - 1]])
        if (push) {
            if (regionDepth < regionStack.size) {
                regionStack[regionDepth] = nextRegion
            } else regionStack.append(nextRegion)
            regionDepth = regionDepth + 1
            include = nextRegion < keep.size && keep[nextRegion]
            nextRegion = nextRegion + 1
        } else if (pop) {
            include = regionDepth > 0 &&
                regionStack[regionDepth - 1] < keep.size &&
                keep[regionStack[regionDepth - 1]]
        }
        if (include) {
            var byte = source
            while (valid && byte < lineEnd) {
                valid = output.store(destination, assembly[byte])
                destination = destination + 1
                byte = byte + 1
            }
        }
        if (pop && regionDepth > 0) regionDepth = regionDepth - 1
        source = lineEnd
    }
    if (!valid) {
        output.close()
        return assembly
    }
    if (destination == assembly.size) {
        output.close()
        return assembly
    }
    output.adoptString(destination)
}

fun bootstrapLlvmEmitNakedAssemblyText(
    backend: BootstrapLlvmBackend,
    function: i64*,
    constraints: string,
    assembly: string
): void {
    bootstrapLlvmAddFunctionAttribute(backend, function, "naked")
    bootstrapLlvmAddFunctionAttribute(backend, function, "noinline")
    bootstrapLlvmAddFunctionAttribute(backend, function, "nounwind")
    val type = bootstrapLlvmFunctionType(
        backend, backend.voidType, []
    )
    val operation = LLVMGetInlineAsm(
        type,
        assembly,
        assembly.size,
        constraints,
        constraints.size,
        1,
        0,
        0,
        0
    )
    bootstrapLlvmCallTyped(
        backend, type, operation, [], ""
    )
    LLVMBuildUnreachable(backend.builder)
    return
}

fun bootstrapLlvmEmitNakedAssemblyBody(
    backend: BootstrapLlvmBackend,
    function: i64*,
    instruction: BootstrapInstruction
): void {
    val constraints = if (instruction.texts.size > 0)
        instruction.texts[0] else ""
    val assembly = if (instruction.texts.size > 1)
        instruction.texts[1] else ""
    bootstrapLlvmEmitNakedAssemblyText(
        backend, function, constraints, assembly
    )
}

