            matched = true
            val found = functionIndex.find(instruction.text)
            if (found < 0) supported = false
            if (found >= 0) bootstrapLlvmCallNamed(
                backend, "abla_function",
                [storage.values[instruction.result], LLVMConstInt(
                    backend.i32Type, identities.runtimeIds[found], 0
                )],
                "", true, [false, false]
            )
        }
        if (reachable && instruction.opcode ==
            "native.xtensa.interrupt.handler.address") {
            matched = true
            val found = functionIndex.find(instruction.text)
            if (found < 0 || !bootstrapTextContains(
                backend.targetTriple, "xtensa"
            )) supported = false
            if (found >= 0 && bootstrapTextContains(
                backend.targetTriple, "xtensa"
            )) {
                val entryFunction = LLVMGetNamedFunction(
                    backend.module,
                    bootstrapLlvmXtensaInterruptEntrySymbol(
                        identities.symbols[found]
                    )
                )
                if (pointerIsNull(entryFunction)) supported = false
                if (!pointerIsNull(entryFunction)) {
                    bootstrapLlvmSetNativeValue(
                        backend, storage, instruction.result,
                        LLVMBuildPtrToInt(
                            backend.builder, entryFunction,
                            backend.i32Type, "interrupt.handler.address"
                        )
                    )
                }
            }
        }
        if (reachable && instruction.opcode == "native.function.address") {
            matched = true
            val found = functionIndex.find(instruction.text)
            if (found < 0) supported = false
            if (found >= 0) {
                val adapter = LLVMGetNamedFunction(
                    backend.module,
                    bootstrapLlvmNativeFunctionAdapterSymbol(
                        identities.symbols[found]
                    )
                )
                if (pointerIsNull(adapter)) supported = false
                if (!pointerIsNull(adapter)) bootstrapLlvmSetNativeValue(
                    backend, storage, instruction.result,
                    LLVMBuildPtrToInt(
                        backend.builder, adapter, backend.i64Type,
                        "native.function.address"
                    )
                )
            }
        }
