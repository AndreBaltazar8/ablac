            val called = functionIndex.find(instruction.text)
            if (called < 0) supported = false
            if (called >= 0) {
                val calledIsScalar = bootstrapLlvmDirectResultIsScalar(
                    program.functions[called]
                )
                val calledUsesOutput = bootstrapLlvmDirectResultUsesOutput(
                    program.functions[called]
                )
                val callOutput = if (calledUsesOutput)
                    storage.values[instruction.result]
                    else nativeNullPointer()
                val arguments = bootstrapLlvmDirectCallArguments(
                    backend, storage, program.functions[called],
                    instruction.operands, callOutput
                )
                val directResult = bootstrapLlvmEmitDirectCall(
                    backend,
                    program.functions[called],
                    LLVMGetNamedFunction(
