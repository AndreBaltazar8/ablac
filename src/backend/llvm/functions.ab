    }
    if (name == "ablaUnsafeCallI32PointerI32PointerI32I64PointerI64") {
        return [0, 1, 0, 1, 2, 0, 2]
    }
    []
}

fun bootstrapLlvmUnsafeExactStatusCall(name: string): bool =
    bootstrapLlvmUnsafeEncodedExactResultKind(name) == 5 ||
    name == "ablaUnsafeCallI32Zero" ||
    name == "ablaUnsafeCallI32I32Pointer" ||
    name == "ablaUnsafeCallI32I32I32Pointer" ||
    bootstrapLlvmUnsafeI32StatusCallIntrinsic(name) ||
    name == "ablaUnsafeCallI32PointerI64I32I32I64Pointer" ||
    name == "ablaUnsafeCallI32PointerI32PointerPointerPointer" ||
    name == "ablaUnsafeCallI32PointerI32PointerI32I64" ||
    name == "ablaUnsafeCallI32PointerI64I32PointerPointerPointer" ||
    name == "ablaUnsafeCallI32PointerI64I64I32PointerPointerPointer" ||
    name == "ablaUnsafeCallI32PointerI64I32Pointer" ||
    bootstrapLlvmUnsafeBulkStatusCallIntrinsic(name) ||
    bootstrapLlvmUnsafeCoreStatusCallIntrinsic(name) ||
    bootstrapLlvmUnsafeFinalResultCallIntrinsic1(name) ||
    bootstrapLlvmUnsafeFinalResultCallIntrinsic2(name)

fun bootstrapLlvmUnsafeExactI64Call(name: string): bool =
    bootstrapLlvmUnsafeEncodedExactResultKind(name) == 7 ||
    name == "ablaUnsafeCallI64PointerI64I32I32" ||
    name == "ablaUnsafeCallI64PointerI64I64" ||
    name == "ablaUnsafeCallI64PointerI32" ||
    bootstrapLlvmUnsafeI64ScalarCallIntrinsic(name)

fun bootstrapLlvmUnsafeExactAddressCall(name: string): bool =
    bootstrapLlvmUnsafeEncodedExactResultKind(name) == 8 ||
    name == "ablaUnsafeCallAddressPointerPointer" ||
    name == "ablaUnsafeCallAddressI32" ||
    name == "ablaUnsafeCallAddressI32I32" ||
    name == "ablaUnsafeCallAddressI32I64" ||
    name == "ablaUnsafeCallAddressI32I64I32" ||
    name == "ablaUnsafeCallAddressI32I64I64I32" ||
    name == "ablaUnsafeCallAddressPointer" ||
    name == "ablaUnsafeCallAddressI32I32I32PointerPointer"

fun bootstrapLlvmUnsafeExactI8Call(name: string): bool =
    bootstrapLlvmUnsafeEncodedExactResultKind(name) == 2 ||
    name == "ablaUnsafeCallI8I32" ||
    name == "ablaUnsafeCallI8I32I32" ||
    name == "ablaUnsafeCallI8I64" ||
    name == "ablaUnsafeCallI8I32PointerPointer"

fun bootstrapLlvmUnsafeExactU32Call(name: string): bool =
    bootstrapLlvmUnsafeEncodedExactResultKind(name) == 6 ||
    name == "ablaUnsafeCallU32Zero" ||
    name == "ablaUnsafeCallU32I32" ||
    name == "ablaUnsafeCallU32I32I32" ||
    name == "ablaUnsafeCallU32I32I32I32" ||
    name == "ablaUnsafeCallU32I32I32Pointer" ||
    name == "ablaUnsafeCallU32I32Pointer"

fun bootstrapLlvmUnsafeExactZeroArgumentCall(name: string): bool =
    (bootstrapLlvmUnsafeEncodedExactIntrinsic(name) &&
        bootstrapLlvmUnsafeEncodedExactCallKinds(name).size == 0) ||
    name == "ablaUnsafeCallU32Zero" || name == "ablaUnsafeCallI32Zero"

fun bootstrapLlvmEmitCoreIntrinsic(
    backend: BootstrapLlvmBackend,
    var storage: BootstrapLlvmFunctionStorage,
    irFunction: BootstrapIrFunction,
    instruction: BootstrapInstruction
): bool {
    var supported = bootstrapLlvmCoreIntrinsic(instruction.text)
    if (!supported) return supported

    val name = instruction.text
    if (name == "nativeInitializeGlobals") {
        if (instruction.operands.size != 0) supported = false
        if (instruction.operands.size == 0) {
            val initialize = LLVMGetNamedFunction(
                backend.module, "abla_export_ensure_initialized"
            )
            if (!pointerIsNull(initialize)) bootstrapLlvmCallNamed(
                backend, "abla_export_ensure_initialized", [], "", false, []
            )
            bootstrapLlvmInitializeVoidValue(
                backend, storage.values[instruction.result]
            )
        }
    }
    val exactCallKinds = bootstrapLlvmUnsafeExactCallKinds(name)
    if (exactCallKinds.size > 0 ||
        bootstrapLlvmUnsafeExactZeroArgumentCall(name)) {
        val expected = exactCallKinds.size + 1
        if (instruction.operands.size != expected) supported = false
        if (instruction.operands.size == expected) {
            val argumentTypes: array<i64*> = []
            val arguments: array<i64*> = []
            var argument = 0
            while (argument < exactCallKinds.size) {
                val kind = exactCallKinds[argument]
                argumentTypes.append(
                    if (kind == 0) backend.pointerType else
                    if (kind == 1) backend.i32Type else
                    if (kind == 2) backend.i64Type else
                    if (kind == 5) backend.f64Type else backend.f32Type
                )
                if (kind == 4) argumentTypes[argumentTypes.size - 1] =
                    LLVMIntTypeInContext(backend.context, 16)
                if (kind == 6) argumentTypes[argumentTypes.size - 1] =
                    backend.i8Type
                var value = if (kind == 3 || kind == 5)
                    bootstrapLlvmScalarOperand(
                    backend,
                    storage,
                    instruction.operands[argument + 1],
                    "f64"
                ) else bootstrapLlvmCoreIntrinsicInteger(
                    backend, storage, instruction.operands[argument + 1]
                )
                if (kind == 0) value = LLVMBuildIntToPtr(
                    backend.builder,
                    value,
                    backend.pointerType,
                    "unsafe.call.exact.pointer"
                )
                if (kind == 1) value = LLVMBuildTrunc(
                    backend.builder,
                    value,
                    backend.i32Type,
                    "unsafe.call.exact.i32"
                )
                if (kind == 3) value = LLVMBuildFPTrunc(
                    backend.builder,
                    value,
                    backend.f32Type,
                    "unsafe.call.exact.f32"
                )
                if (kind == 4) value = LLVMBuildTrunc(
                    backend.builder,
                    value,
                    LLVMIntTypeInContext(backend.context, 16),
                    "unsafe.call.exact.i16"
                )
                if (kind == 6) value = LLVMBuildTrunc(
                    backend.builder,
                    value,
                    backend.i8Type,
                    "unsafe.call.exact.i8"
                )
                arguments.append(value)
                argument = argument + 1
            }
            val statusCall = bootstrapLlvmUnsafeExactStatusCall(name)
            val i64Call = bootstrapLlvmUnsafeExactI64Call(name)
            val addressCall = bootstrapLlvmUnsafeExactAddressCall(name)
            val i8Call = bootstrapLlvmUnsafeExactI8Call(name)
            val u32Call = bootstrapLlvmUnsafeExactU32Call(name)
            val encodedResult =
                bootstrapLlvmUnsafeEncodedExactResultKind(name)
            val signedI8Call = encodedResult == 1
            val signedI16Call = encodedResult == 3
            val unsignedI16Call = encodedResult == 4
            val f32ResultCall = encodedResult == 9
            val f64ResultCall = encodedResult == 10
            val type = bootstrapLlvmFunctionType(
                backend,
                if (addressCall) backend.pointerType else
                if (i64Call) backend.i64Type else
                if (i8Call || signedI8Call) backend.i8Type else
                if (signedI16Call || unsignedI16Call)
                    LLVMIntTypeInContext(backend.context, 16) else
                if (f32ResultCall) backend.f32Type else
                if (f64ResultCall) backend.f64Type else
                if (statusCall || u32Call) backend.i32Type else
                backend.voidType,
                argumentTypes
            )
            val function = LLVMBuildIntToPtr(
                backend.builder,
                bootstrapLlvmCoreIntrinsicInteger(
                    backend, storage, instruction.operands[0]
                ),
                backend.pointerType,
                "unsafe.call.exact.function"
            )
            val result = bootstrapLlvmCallTyped(
                backend,
                type,
                function,
                arguments,
                if (statusCall || i64Call || addressCall || i8Call ||
                    u32Call || signedI8Call || signedI16Call ||
                    unsignedI16Call || f32ResultCall || f64ResultCall)
                    "unsafe.call.exact.status" else ""
            )
            if (addressCall) bootstrapLlvmSetNativeValue(
                backend,
                storage,
                instruction.result,
                LLVMBuildPtrToInt(
                    backend.builder,
                    result,
                    backend.i64Type,
                    "unsafe.call.exact.address"
                )
            ) else if (i64Call) bootstrapLlvmSetNativeValue(
                backend, storage, instruction.result, result
            ) else if (f32ResultCall) bootstrapLlvmSetNativeValue(
                backend,
                storage,
                instruction.result,
                LLVMBuildFPExt(
                    backend.builder,
                    result,
                    backend.f64Type,
                    "unsafe.call.exact.f32.result"
                )
            ) else if (f64ResultCall) bootstrapLlvmSetNativeValue(
                backend, storage, instruction.result, result
            ) else if (i8Call || u32Call || unsignedI16Call)
                bootstrapLlvmSetNativeValue(
                backend,
                storage,
                instruction.result,
                LLVMBuildZExt(
                    backend.builder,
                    result,
                    backend.i64Type,
                    "unsafe.call.exact.unsigned.i64"
                )
            ) else if (statusCall || signedI8Call || signedI16Call)
                bootstrapLlvmSetNativeValue(
                backend,
                storage,
                instruction.result,
                LLVMBuildSExt(
                    backend.builder,
                    result,
                    backend.i64Type,
                    "unsafe.call.exact.status.i64"
                )
            ) else bootstrapLlvmInitializeVoidValue(
                backend, storage.values[instruction.result]
            )
        }
    }
    if (name == "ablaCountLeadingZerosU32") {
        if (instruction.operands.size != 1) supported = false
        if (instruction.operands.size == 1) {
            val value = LLVMBuildTrunc(
                backend.builder,
                bootstrapLlvmCoreIntrinsicInteger(
                    backend, storage, instruction.operands[0]
                ),
                backend.i32Type,
                "integer.clz.value"
            )
            // Xtensa's NSA extension implements these exact zero-defined
            // semantics in one instruction. Espressif LLVM currently expands
            // llvm.ctlz.i32 into a software popcount sequence even for
            // -mcpu=esp32,+nsa, so select the instruction here. The assembly
            // has no side effects or memory clobber: LLVM can still delete and
            // move unused operations. Every other target retains the semantic
            // LLVM intrinsic and all of its normal folding opportunities.
            val result = if (bootstrapTextContains(
                backend.targetTriple, "xtensa"
            )) {
                val type = bootstrapLlvmFunctionType(
                    backend, backend.i32Type, [backend.i32Type]
                )
                val assembly = "nsau $0, $1"
                val constraints = "=a,a"
                val operation = LLVMGetInlineAsm(
                    type,
                    assembly,
                    assembly.size,
                    constraints,
                    constraints.size,
                    0,
                    0,
                    0,
                    0
                )
                bootstrapLlvmCallTyped(
                    backend,
                    type,
                    operation,
                    [value],
                    "integer.clz.xtensa"
                )
            } else {
                val intrinsic = bootstrapLlvmDeclare(
                    backend,
                    "llvm.ctlz.i32",
                    backend.i32Type,
                    [backend.i32Type, backend.i1Type],
                    false,
                    [false, false]
                )
                bootstrapLlvmCall(
                    backend,
                    intrinsic,
                    [value, LLVMConstInt(backend.i1Type, 0, 0)],
                    "integer.clz",
                    false,
                    [false, false]
                )
            }
            bootstrapLlvmSetNativeValue(
                backend, storage, instruction.result, result
            )
        }
    }
    if (name == "ablaBitF64ToI64") {
        if (instruction.operands.size != 1) supported = false
        if (instruction.operands.size == 1) {
            val value = bootstrapLlvmScalarOperand(
                backend, storage, instruction.operands[0], "f64"
            )
            bootstrapLlvmSetNativeValue(
                backend, storage, instruction.result,
                LLVMBuildBitCast(
                    backend.builder, value, backend.i64Type,
                    "bit.f64.to.i64"
                )
            )
        }
    }
    if (name == "ablaBitI64ToF64") {
        if (instruction.operands.size != 1) supported = false
        if (instruction.operands.size == 1) {
            val value = bootstrapLlvmCoreIntrinsicInteger(
                backend, storage, instruction.operands[0]
            )
            bootstrapLlvmSetNativeValue(
                backend, storage, instruction.result,
                LLVMBuildBitCast(
                    backend.builder, value, backend.f64Type,
                    "bit.i64.to.f64"
                )
            )
        }
    }
    if (name == "ablaConvertI64ToF64") {
        if (instruction.operands.size != 1) supported = false
        if (instruction.operands.size == 1) {
            val value = bootstrapLlvmCoreIntrinsicInteger(
                backend, storage, instruction.operands[0]
            )
            bootstrapLlvmSetNativeValue(
                backend, storage, instruction.result,
                LLVMBuildSIToFP(
                    backend.builder, value, backend.f64Type,
                    "convert.i64.to.f64"
                )
            )
        }
    }
    if (name == "ablaBitF32ToI32") {
        if (instruction.operands.size != 1) supported = false
        if (instruction.operands.size == 1) {
            val value = bootstrapLlvmScalarOperand(
                backend, storage, instruction.operands[0], "f32"
            )
            val bits = LLVMBuildBitCast(
                backend.builder, value, backend.i32Type, "bit.f32.to.i32"
            )
            bootstrapLlvmSetNativeValue(
                backend, storage, instruction.result,
                LLVMBuildZExt(
                    backend.builder, bits, backend.i64Type,
                    "bit.f32.to.i32.i64"
                )
            )
        }
    }
    if (name == "ablaBitI32ToF32") {
        if (instruction.operands.size != 1) supported = false
        if (instruction.operands.size == 1) {
            val value = LLVMBuildTrunc(
                backend.builder,
                bootstrapLlvmCoreIntrinsicInteger(
                    backend, storage, instruction.operands[0]
                ),
                backend.i32Type, "bit.i32.to.f32.i32"
            )
            bootstrapLlvmSetNativeValue(
                backend, storage, instruction.result,
                LLVMBuildBitCast(
                    backend.builder, value, backend.f32Type,
                    "bit.i32.to.f32"
                )
            )
        }
    }
    if (name == "ablaConvertU32ToF32" ||
        name == "ablaConvertI32ToF32") {
        if (instruction.operands.size != 1) supported = false
        if (instruction.operands.size == 1) {
            val value = LLVMBuildTrunc(
                backend.builder,
                bootstrapLlvmCoreIntrinsicInteger(
                    backend, storage, instruction.operands[0]
                ),
                backend.i32Type, "convert.i32.to.f32.value"
            )
            bootstrapLlvmSetNativeValue(
                backend, storage, instruction.result,
