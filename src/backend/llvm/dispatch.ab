import "functions.ab"
import "bindings.ab"
import "core.ab"
import "../../ir.ab"
import "abla/llvm/orc"
import "abla/unsafe/memory/raw"
import "analysis.ab"
import "runtime.ab"
import "debug.ab"
import "backend.ab"

fun bootstrapLlvmAddPhiIncoming(
    phi: i64*,
    value: i64*,
    block: i64*
): void {
    val values = llvmPointerVector(1)
    val blocks = llvmPointerVector(1)
    values.set(0, value)
    blocks.set(0, block)
    LLVMAddIncoming(phi, values.pointer(), blocks.pointer(), 1)
    values.drop()
    blocks.drop()
}

fun bootstrapLlvmWrapperScalarArgument(
    backend: BootstrapLlvmBackend,
    wrapper: i64*,
    values: i64*,
    count: i64*,
    parameter: int,
    scalar: string
): i64* {
    val present = LLVMAppendBasicBlockInContext(
        backend.context, wrapper, "wrapper.argument.present"
    )
    val missing = LLVMAppendBasicBlockInContext(
        backend.context, wrapper, "wrapper.argument.missing"
    )
    val ready = LLVMAppendBasicBlockInContext(
        backend.context, wrapper, "wrapper.argument.ready"
    )
    val available = LLVMBuildICmp(
        backend.builder, llvmIntUnsignedGreaterThan(), count,
        LLVMConstInt(backend.i64Type, parameter, 0),
        "wrapper.argument.available"
    )
    LLVMBuildCondBr(backend.builder, available, present, missing)
    LLVMPositionBuilderAtEnd(backend.builder, present)
    val boxed = bootstrapLlvmValueElement(
        backend, values, parameter, "wrapper.argument"
    )
    val native = bootstrapLlvmUnboxScalar(
        backend, boxed, scalar, "wrapper.scalar"
    )
    LLVMBuildBr(backend.builder, ready)
    LLVMPositionBuilderAtEnd(backend.builder, missing)
    val zero = LLVMConstNull(backend.type(scalar))
    LLVMBuildBr(backend.builder, ready)
    LLVMPositionBuilderAtEnd(backend.builder, ready)
    val result = LLVMBuildPhi(
        backend.builder, backend.type(scalar), "wrapper.argument.scalar"
    )
    bootstrapLlvmAddPhiIncoming(result, native, present)
    bootstrapLlvmAddPhiIncoming(result, zero, missing)
    result
}

fun bootstrapLlvmWrapperValueArgument(
    backend: BootstrapLlvmBackend,
    wrapper: i64*,
    values: i64*,
    count: i64*,
    parameter: int
): i64* {
    val present = LLVMAppendBasicBlockInContext(
        backend.context, wrapper, "wrapper.value.present"
    )
    val missing = LLVMAppendBasicBlockInContext(
        backend.context, wrapper, "wrapper.value.missing"
    )
    val ready = LLVMAppendBasicBlockInContext(
        backend.context, wrapper, "wrapper.value.ready"
    )
    val available = LLVMBuildICmp(
        backend.builder, llvmIntUnsignedGreaterThan(), count,
        LLVMConstInt(backend.i64Type, parameter, 0),
        "wrapper.value.available"
    )
    LLVMBuildCondBr(backend.builder, available, present, missing)
    LLVMPositionBuilderAtEnd(backend.builder, present)
    val supplied = bootstrapLlvmValueElement(
        backend, values, parameter, "wrapper.argument"
    )
    LLVMBuildBr(backend.builder, ready)
    LLVMPositionBuilderAtEnd(backend.builder, missing)
    val fallback = LLVMBuildAlloca(
        backend.builder, backend.valueType, "wrapper.missing.argument"
    )
    LLVMSetAlignment(fallback, 8)
    bootstrapLlvmRuntimeCall(backend, "abla_void", fallback, [])
    LLVMBuildBr(backend.builder, ready)
    LLVMPositionBuilderAtEnd(backend.builder, ready)
    val result = LLVMBuildPhi(
        backend.builder, backend.pointerType, "wrapper.value.argument"
    )
    bootstrapLlvmAddPhiIncoming(result, supplied, present)
    bootstrapLlvmAddPhiIncoming(result, fallback, missing)
    result
}

fun bootstrapLlvmEmitGeneratedWrapper(
    backend: BootstrapLlvmBackend,
    function: BootstrapIrFunction,
    symbol: string
): void {
    val wrapper = LLVMGetNamedFunction(backend.module, symbol)
    val direct = LLVMGetNamedFunction(
        backend.module, bootstrapLlvmDirectFunctionSymbol(symbol)
    )
    val entry = LLVMAppendBasicBlockInContext(
        backend.context, wrapper, "entry"
    )
    LLVMPositionBuilderAtEnd(backend.builder, entry)
    val output = LLVMGetParam(wrapper, 0)
    val values = LLVMGetParam(wrapper, 1)
    val count = LLVMGetParam(wrapper, 2)
    val arguments: array<i64*> = []
    if (bootstrapLlvmDirectResultUsesOutput(function)) {
        arguments.append(output)
    }
    if (bootstrapLlvmDirectNeedsArgumentCount(function)) {
        arguments.append(count)
    }
    var parameter = 0
    val parameterCount = bootstrapLlvmDirectParameterCount(function)
    while (parameter < parameterCount) {
        val scalar = bootstrapLlvmDirectParameterScalarType(
            function, parameter
        )
        if (scalar == "") {
            arguments.append(bootstrapLlvmWrapperValueArgument(
                backend, wrapper, values, count, parameter
            ))
        } else {
            arguments.append(bootstrapLlvmWrapperScalarArgument(
                backend, wrapper, values, count, parameter, scalar
            ))
        }
        parameter = parameter + 1
    }
    bootstrapLlvmEmitDirectCall(
        backend, function, direct, arguments, output
    )
    if (bootstrapLlvmDirectResultIsVoid(function)) {
        bootstrapLlvmRuntimeCall(backend, "abla_void", output, [])
    }
    LLVMBuildRetVoid(backend.builder)
    if (false) LLVMDisposeMessage(nativeNullPointer())
}

fun bootstrapLlvmDeclareDispatchers(
    backend: BootstrapLlvmBackend
): void {
    bootstrapLlvmDeclare(
        backend, "abla_llvm_call_indirect", backend.voidType,
        [backend.pointerType, backend.pointerType,
         backend.pointerType, backend.i64Type],
        true, [false, false, false, false]
    )
    bootstrapLlvmDeclare(
        backend, "abla_llvm_release_closure", backend.voidType,
        [backend.pointerType], false, [false]
    )
    bootstrapLlvmDeclare(
        backend, "abla_llvm_drop_closure", backend.voidType,
        [backend.pointerType], false, [false]
    )
    if (false) LLVMDisposeMessage(nativeNullPointer())
}

fun bootstrapLlvmEmitClosureDispatchers(
    backend: BootstrapLlvmBackend,
    program: BootstrapIrProgram,
    functionIndex: BootstrapLlvmNameIndex,
    identities: BootstrapLlvmFunctionIdentities,
    reachable: array<bool>
): void {
    val release = LLVMGetNamedFunction(
        backend.module, "abla_llvm_release_closure"
    )
    LLVMSetLinkage(release, llvmInternalLinkage())
    val releaseEntry = LLVMAppendBasicBlockInContext(
        backend.context, release, "entry"
    )
    LLVMPositionBuilderAtEnd(backend.builder, releaseEntry)
    bootstrapLlvmCallNamed(
        backend, "abla_closure_release", [LLVMGetParam(release, 0)],
        "", false, [true]
    )
    LLVMBuildRetVoid(backend.builder)

    val drop = LLVMGetNamedFunction(
        backend.module, "abla_llvm_drop_closure"
    )
    LLVMSetLinkage(drop, llvmInternalLinkage())
    val entry = LLVMAppendBasicBlockInContext(
        backend.context, drop, "entry"
    )
    val releaseBlock = LLVMAppendBasicBlockInContext(
        backend.context, drop, "release"
    )
    LLVMPositionBuilderAtEnd(backend.builder, entry)
    val dropResult = LLVMBuildAlloca(
        backend.builder, backend.valueType, "drop.result"
    )
    val closure = LLVMGetParam(drop, 0)
    val functionId = bootstrapLlvmCallNamed(
        backend, "abla_as_function", [closure],
        "function.id", false, [true]
    )
    val captures = bootstrapLlvmCallNamed(
        backend, "abla_function_capture_pointer", [closure],
        "captures", false, [true]
    )
    val captureCount = bootstrapLlvmCallNamed(
        backend, "abla_function_capture_count", [closure],
        "capture.count", false, [true]
    )
    val switch = LLVMBuildSwitch(
        backend.builder, functionId, releaseBlock, i32(program.functions.size)
    )
    var original = 0
    while (original < program.functions.size) {
        val dropFunction = functionIndex.find(
            bootstrapClosureDropFunctionName(
                program.functions[original].name
            )
        )
        if (original < reachable.size && reachable[original] &&
            dropFunction >= 0 && dropFunction < reachable.size &&
            reachable[dropFunction]) {
            val case = LLVMAppendBasicBlockInContext(
                backend.context, drop, "drop.captures"
            )
            LLVMAddCase(
                switch,
                LLVMConstInt(
                    backend.i32Type, identities.runtimeIds[original], 0
                ),
                case
            )
            LLVMPositionBuilderAtEnd(backend.builder, case)
            bootstrapLlvmCall(
                backend,
                LLVMGetNamedFunction(
                    backend.module, identities.symbols[dropFunction]
                ),
                [dropResult, captures, captureCount],
                "", true, [false, false, false]
            )
            LLVMBuildBr(backend.builder, releaseBlock)
        }
        original = original + 1
    }
    LLVMPositionBuilderAtEnd(backend.builder, releaseBlock)
    bootstrapLlvmCallNamed(
        backend, "abla_closure_release", [closure],
        "", false, [true]
    )
    LLVMBuildRetVoid(backend.builder)
    if (false) LLVMDisposeMessage(nativeNullPointer())
}

fun bootstrapLlvmEmitIndirectDispatcher(
    backend: BootstrapLlvmBackend,
    program: BootstrapIrProgram,
    addressTaken: array<bool>,
    identities: BootstrapLlvmFunctionIdentities,
    reachable: array<bool>
): void {
    val function = LLVMGetNamedFunction(
        backend.module, "abla_llvm_call_indirect"
    )
    LLVMSetLinkage(function, llvmInternalLinkage())
    val output = LLVMGetParam(function, 0)
    val closure = LLVMGetParam(function, 1)
    val arguments = LLVMGetParam(function, 2)
    val count = LLVMGetParam(function, 3)
    val entry = LLVMAppendBasicBlockInContext(
        backend.context, function, "entry"
    )
    val captureCondition = LLVMAppendBasicBlockInContext(
        backend.context, function, "capture.condition"
    )
    val captureBody = LLVMAppendBasicBlockInContext(
        backend.context, function, "capture.body"
    )
    val argumentCondition = LLVMAppendBasicBlockInContext(
        backend.context, function, "argument.condition"
    )
    val argumentBody = LLVMAppendBasicBlockInContext(
        backend.context, function, "argument.body"
    )
    val dispatch = LLVMAppendBasicBlockInContext(
        backend.context, function, "dispatch"
    )
    val invalid = LLVMAppendBasicBlockInContext(
        backend.context, function, "invalid.function"
    )
    val foreign = LLVMAppendBasicBlockInContext(
        backend.context, function, "foreign.callback"
    )
    val foreignInvalid = LLVMAppendBasicBlockInContext(
        backend.context, function, "foreign.invalid"
    )
    val done = LLVMAppendBasicBlockInContext(
        backend.context, function, "done"
    )
    LLVMPositionBuilderAtEnd(backend.builder, entry)
    val captureCount = bootstrapLlvmCallNamed(
        backend, "abla_function_capture_count", [closure],
        "capture.count", false, [true]
    )
    val total = LLVMBuildAdd(
        backend.builder, captureCount, count, "argument.total"
    )
    val merged = LLVMBuildArrayAlloca(
        backend.builder, backend.valueType, total, "merged.arguments"
    )
    LLVMSetAlignment(merged, 8)
    // The captures sit in one array: copy them straight from it, rather than
    // calling the runtime once per capture.
    val captures = bootstrapLlvmCallNamed(
        backend, "abla_function_capture_pointer", [closure],
        "captures", false, [true]
    )
    LLVMBuildBr(backend.builder, captureCondition)

    LLVMPositionBuilderAtEnd(backend.builder, captureCondition)
    val captureIndex = LLVMBuildPhi(
        backend.builder, backend.i64Type, "capture.index"
    )
    bootstrapLlvmAddPhiIncoming(
        captureIndex, LLVMConstInt(backend.i64Type, 0, 0), entry
    )
    val captureMore = LLVMBuildICmp(
        backend.builder, llvmIntUnsignedLessThan(),
        captureIndex, captureCount, "capture.more"
    )
    LLVMBuildCondBr(
        backend.builder, captureMore, captureBody, argumentCondition
    )
    LLVMPositionBuilderAtEnd(backend.builder, captureBody)
    val captureDestinationIndices = llvmPointerVector(1)
    captureDestinationIndices.set(0, captureIndex)
    val captureDestination = LLVMBuildGEP2(
        backend.builder, backend.valueType, merged,
        captureDestinationIndices.pointer(), 1, "capture.destination"
    )
    captureDestinationIndices.drop()
    val captureSourceIndices = llvmPointerVector(1)
    captureSourceIndices.set(0, captureIndex)
    val captureSource = LLVMBuildGEP2(
        backend.builder, backend.valueType, captures,
        captureSourceIndices.pointer(), 1, "capture.source"
    )
    captureSourceIndices.drop()
    bootstrapLlvmCopyValue(
        backend, captureSource, captureDestination, "capture.value"
    )
    val captureNext = LLVMBuildAdd(
        backend.builder, captureIndex,
        LLVMConstInt(backend.i64Type, 1, 0), "capture.next"
    )
    LLVMBuildBr(backend.builder, captureCondition)
    bootstrapLlvmAddPhiIncoming(
        captureIndex, captureNext, captureBody
    )

    LLVMPositionBuilderAtEnd(backend.builder, argumentCondition)
    val argumentIndex = LLVMBuildPhi(
        backend.builder, backend.i64Type, "argument.index"
    )
    bootstrapLlvmAddPhiIncoming(
        argumentIndex, LLVMConstInt(backend.i64Type, 0, 0), captureCondition
    )
    val argumentMore = LLVMBuildICmp(
        backend.builder, llvmIntUnsignedLessThan(),
        argumentIndex, count, "argument.more"
    )
    LLVMBuildCondBr(
        backend.builder, argumentMore, argumentBody, dispatch
    )
    LLVMPositionBuilderAtEnd(backend.builder, argumentBody)
    val sourceIndices = llvmPointerVector(1)
    sourceIndices.set(0, argumentIndex)
    val source = LLVMBuildGEP2(
        backend.builder, backend.valueType, arguments,
        sourceIndices.pointer(), 1, "argument.source"
    )
    sourceIndices.drop()
    val position = LLVMBuildAdd(
        backend.builder, captureCount, argumentIndex, "argument.position"
    )
    val destinationIndices = llvmPointerVector(1)
    destinationIndices.set(0, position)
    val destination = LLVMBuildGEP2(
        backend.builder, backend.valueType, merged,
        destinationIndices.pointer(), 1, "argument.destination"
    )
    destinationIndices.drop()
    bootstrapLlvmCopyValue(
        backend, source, destination, "argument.value"
    )
    val argumentNext = LLVMBuildAdd(
        backend.builder, argumentIndex,
        LLVMConstInt(backend.i64Type, 1, 0), "argument.next"
    )
    LLVMBuildBr(backend.builder, argumentCondition)
    bootstrapLlvmAddPhiIncoming(
        argumentIndex, argumentNext, argumentBody
    )

    LLVMPositionBuilderAtEnd(backend.builder, dispatch)
    val functionId = bootstrapLlvmCallNamed(
        backend, "abla_as_function", [closure],
        "function.id", false, [true]
    )
    val switch = LLVMBuildSwitch(
        backend.builder, functionId, invalid, i32(program.functions.size + 1)
    )
    LLVMAddCase(
        switch, LLVMConstInt(backend.i32Type, -1, 1), foreign
    )
    var functionIndex = 0
    while (functionIndex < program.functions.size) {
        if (addressTaken[functionIndex] &&
            functionIndex < reachable.size && reachable[functionIndex]) {
            val case = LLVMAppendBasicBlockInContext(
                backend.context, function, "indirect.call"
            )
            LLVMAddCase(
                switch, LLVMConstInt(
                    backend.i32Type, identities.runtimeIds[functionIndex], 0
                ), case
            )
            LLVMPositionBuilderAtEnd(backend.builder, case)
            bootstrapLlvmCall(
                backend,
                LLVMGetNamedFunction(
                    backend.module, identities.symbols[functionIndex]
                ),
                [output, merged, total], "", true,
                [false, false, false]
            )
            LLVMBuildBr(backend.builder, done)
        }
        functionIndex = functionIndex + 1
    }

    LLVMPositionBuilderAtEnd(backend.builder, foreign)
    val captureValid = LLVMBuildICmp(
        backend.builder, llvmIntEqual(), captureCount,
        LLVMConstInt(backend.i64Type, 2, 0), "foreign.captures.valid"
    )
    val countValid = LLVMBuildICmp(
        backend.builder, llvmIntEqual(), count,
        LLVMConstInt(backend.i64Type, 1, 0), "foreign.arguments.valid"
    )
    val signatureValid = LLVMBuildAnd(
        backend.builder, captureValid, countValid, "foreign.valid"
    )
    val invoke = LLVMAppendBasicBlockInContext(
        backend.context, function, "foreign.invoke"
    )
    LLVMBuildCondBr(
        backend.builder, signatureValid, invoke, foreignInvalid
    )
    LLVMPositionBuilderAtEnd(backend.builder, invoke)
    val callbackInteger = bootstrapLlvmCallNamed(
        backend, "abla_as_i64", [merged],
        "foreign.callback.address", false, [true]
    )
    val contextValue = bootstrapLlvmValueElement(
        backend, merged, 1, "foreign.context.value"
    )
    val contextInteger = bootstrapLlvmCallNamed(
        backend, "abla_as_i64", [contextValue],
        "foreign.context.address", false, [true]
    )
    val argumentValue = bootstrapLlvmValueElement(
        backend, merged, 2, "foreign.argument.value"
    )
    val argumentInteger = bootstrapLlvmCallNamed(
        backend, "abla_as_i64", [argumentValue],
        "foreign.argument", false, [true]
    )
    val callbackPointer = LLVMBuildIntToPtr(
        backend.builder, callbackInteger, backend.pointerType,
        "foreign.callback"
    )
    val contextPointer = LLVMBuildIntToPtr(
        backend.builder, contextInteger, backend.pointerType,
        "foreign.context"
    )
    val callbackType = bootstrapLlvmFunctionType(
        backend, backend.i64Type, [backend.pointerType, backend.i64Type]
    )
    val callbackResult = bootstrapLlvmCallTyped(
        backend, callbackType, callbackPointer,
        [contextPointer, argumentInteger], "foreign.result"
    )
    bootstrapLlvmCallNamed(
        backend, "abla_i64", [output, callbackResult],
        "", true, [false, false]
    )
    LLVMBuildBr(backend.builder, done)

    LLVMPositionBuilderAtEnd(backend.builder, foreignInvalid)
    val foreignMessage = LLVMBuildGlobalStringPtr(
        backend.builder, "invalid foreign callback", "foreign.error"
    )
    bootstrapLlvmCallNamed(
        backend, "abla_platform_panic",
        [foreignMessage, LLVMConstInt(backend.i64Type, 24, 0)],
        "", false, [false, false]
    )
    LLVMBuildUnreachable(backend.builder)

    LLVMPositionBuilderAtEnd(backend.builder, invalid)
    val invalidMessage = LLVMBuildGlobalStringPtr(
        backend.builder, "invalid function reference", "function.error"
    )
    bootstrapLlvmCallNamed(
        backend, "abla_platform_panic",
        [invalidMessage, LLVMConstInt(backend.i64Type, 26, 0)],
        "", false, [false, false]
    )
    LLVMBuildUnreachable(backend.builder)

    LLVMPositionBuilderAtEnd(backend.builder, done)
    LLVMBuildRetVoid(backend.builder)
    if (false) LLVMDisposeMessage(nativeNullPointer())
}

// A generator's step runs on every iteration. Through abla_llvm_call_indirect
// it would count the closure's captures, switch over every closure function
// and check each argument's presence; the closure a `generator.create` takes
// is known where it is made, so it gets its own entry with the dispatcher's
// signature that copies the captures and the one argument as the dispatcher
// does and calls the step's direct function. The runtime keeps the entry in
// the generator and calls it through abla_llvm_call_dispatch.

fun bootstrapLlvmGeneratorStepSymbol(symbol: string): string =
    "${symbol}_generator_step"

/** The step function of the `generator.create` at `at`: the function of the
 *  `closure.create` it takes, when that takes the closure's captures and one
 *  argument; else -1. */
fun bootstrapLlvmGeneratorStepFunction(
    program: BootstrapIrProgram,
    function: BootstrapIrFunction,
    at: int,
    functionIndex: BootstrapLlvmNameIndex
): int {
    val create = function.instructions[at]
    var index = at - 1
    while (index >= 0) {
        val candidate = function.instructions[index]
        if (candidate.result == create.left) {
            if (candidate.opcode != "closure.create") return -1
            val found = functionIndex.find(candidate.text)
            if (found < 0) return -1
            val step = program.functions[found]
            if (bootstrapLlvmDirectNeedsArgumentCount(step) ||
                bootstrapLlvmDirectParameterCount(step) != candidate.operands.size + 1) return -1
            return found
        }
        index = index - 1
    }
    -1
}

/** Declares abla_llvm_call_dispatch when the program runs generators, and
 *  each emitted generator's step entry. */
fun bootstrapLlvmDeclareGeneratorSteps(
    backend: BootstrapLlvmBackend,
    program: BootstrapIrProgram,
    functionIndex: BootstrapLlvmNameIndex,
    identities: BootstrapLlvmFunctionIdentities,
    emitted: array<bool>
): void {
    if (!bootstrapLlvmRuntimeBridgeUsed(program, "abla_generator_create") &&
        !bootstrapLlvmRuntimeBridgeUsed(program, "abla_generator_next") &&
        !bootstrapLlvmRuntimeBridgeUsed(program, "abla_generator_drop")) return
    val parameters = [backend.pointerType, backend.pointerType, backend.pointerType, backend.i64Type]
    val dispatch = bootstrapLlvmDeclare(
        backend, "abla_llvm_call_dispatch", backend.voidType,
        [backend.pointerType, backend.pointerType, backend.pointerType,
         backend.pointerType, backend.i64Type],
        false, [false, false, false, false, false]
    )
    LLVMSetLinkage(dispatch, llvmInternalLinkage())
    var index = 0
    while (index < program.functions.size) {
        if (index < emitted.size && emitted[index]) {
            val function = program.functions[index]
            var at = 0
            while (at < function.instructions.size) {
                if (function.instructions[at].opcode == "generator.create") {
                    val step = bootstrapLlvmGeneratorStepFunction(program, function, at, functionIndex)
                    if (step >= 0 && step < emitted.size && emitted[step]) {
                        val entry = bootstrapLlvmDeclare(
                            backend, bootstrapLlvmGeneratorStepSymbol(identities.symbols[step]),
                            backend.voidType, parameters, true, [false, false, false, false]
                        )
                        LLVMSetLinkage(entry, llvmInternalLinkage())
                    }
                }
                at = at + 1
            }
        }
        index = index + 1
    }
    return
}

/** The step entry `generator.create` at `at` passes the runtime: the step's
 *  own (bootstrapLlvmDeclareGeneratorSteps), else the closure dispatcher. */
fun bootstrapLlvmGeneratorDispatch(
    backend: BootstrapLlvmBackend,
    program: BootstrapIrProgram,
    function: BootstrapIrFunction,
    at: int,
    functionIndex: BootstrapLlvmNameIndex,
    identities: BootstrapLlvmFunctionIdentities
): i64* {
    val step = bootstrapLlvmGeneratorStepFunction(program, function, at, functionIndex)
    if (step >= 0) {
        val entry = LLVMGetNamedFunction(
            backend.module, bootstrapLlvmGeneratorStepSymbol(identities.symbols[step])
        )
        if (!pointerIsNull(entry)) return entry
    }
    LLVMGetNamedFunction(backend.module, "abla_llvm_call_indirect")
}

/** The bodies of abla_llvm_call_dispatch and of the step entries declared. */
fun bootstrapLlvmEmitGeneratorSteps(
    backend: BootstrapLlvmBackend,
    program: BootstrapIrProgram,
    identities: BootstrapLlvmFunctionIdentities,
    emitted: array<bool>
): void {
    val dispatch = LLVMGetNamedFunction(backend.module, "abla_llvm_call_dispatch")
    if (pointerIsNull(dispatch)) return
    // abla_llvm_call_dispatch(entry, output, closure, arguments, count)
    // calls `entry`, which has the dispatcher's signature.
    LLVMPositionBuilderAtEnd(
        backend.builder, LLVMAppendBasicBlockInContext(backend.context, dispatch, "entry")
    )
    val forwarded = llvmPointerVector(4)
    var parameter = 0
    while (parameter < 4) {
        forwarded.set(parameter, LLVMGetParam(dispatch, i32(parameter + 1)))
        parameter = parameter + 1
    }
    val call = LLVMBuildCall2(
        backend.builder,
        LLVMGlobalGetValueType(LLVMGetNamedFunction(backend.module, "abla_llvm_call_indirect")),
        LLVMGetParam(dispatch, 0), forwarded.pointer(), 4, ""
    )
    forwarded.drop()
    bootstrapLlvmAddSret(backend, call, true)
    LLVMBuildRetVoid(backend.builder)
    var index = 0
    while (index < program.functions.size) {
        val entry = LLVMGetNamedFunction(
            backend.module, bootstrapLlvmGeneratorStepSymbol(identities.symbols[index])
        )
        if (!pointerIsNull(entry) && index < emitted.size && emitted[index]) {
            bootstrapLlvmEmitGeneratorStep(backend, program.functions[index], identities.symbols[index], entry)
        }
        index = index + 1
    }
    if (false) LLVMDisposeMessage(nativeNullPointer())
}

fun bootstrapLlvmEmitGeneratorStep(
    backend: BootstrapLlvmBackend,
    function: BootstrapIrFunction,
    symbol: string,
    entry: i64*
): void {
    LLVMPositionBuilderAtEnd(
        backend.builder, LLVMAppendBasicBlockInContext(backend.context, entry, "entry")
    )
    val output = LLVMGetParam(entry, 0)
    val closure = LLVMGetParam(entry, 1)
    val supplied = LLVMGetParam(entry, 2)
    val count = bootstrapLlvmDirectParameterCount(function)
    val captures = bootstrapLlvmCallNamed(
        backend, "abla_function_capture_pointer", [closure], "captures", false, [true]
    )
    // The step's values, copied as the dispatcher copies them: the captures,
    // then its argument.
    val merged = LLVMBuildArrayAlloca(
        backend.builder, backend.valueType, LLVMConstInt(backend.i64Type, count, 0), "step.arguments"
    )
    LLVMSetAlignment(merged, 8)
    val arguments: array<i64*> = []
    if (bootstrapLlvmDirectResultUsesOutput(function)) arguments.append(output)
    var parameter = 0
    while (parameter < count) {
        val source = if (parameter < count - 1)
            bootstrapLlvmValueElement(backend, captures, parameter, "step.capture")
        else bootstrapLlvmValueElement(backend, supplied, 0, "step.argument")
        val slot = bootstrapLlvmValueElement(backend, merged, parameter, "step.value")
        LLVMBuildStore(
            backend.builder, LLVMBuildLoad2(backend.builder, backend.valueType, source, "step.load"), slot
        )
        val scalar = bootstrapLlvmDirectParameterScalarType(function, parameter)
        arguments.append(
            if (scalar == "") slot else bootstrapLlvmUnboxScalar(backend, slot, scalar, "step.scalar")
        )
        parameter = parameter + 1
    }
    bootstrapLlvmEmitDirectCall(
        backend, function,
        LLVMGetNamedFunction(backend.module, bootstrapLlvmDirectFunctionSymbol(symbol)),
        arguments, output
    )
    if (bootstrapLlvmDirectResultIsVoid(function)) {
        bootstrapLlvmRuntimeCall(backend, "abla_void", output, [])
    }
    LLVMBuildRetVoid(backend.builder)
    return
}

/** abla_stm_invoke(closure, output, slot): runs one attempt of a transaction's body
 *  (the closure, through abla_llvm_call_indirect) under a jmp_buf in this function's
 *  frame, whose address it stores at `slot` first. 0 when the body returned; 1 when
 *  the runtime abandoned the attempt (a conflict or a retry) by longjmp'ing to it.
 *  Defined when the runtime's transactions are reached (they declare it). */
fun bootstrapLlvmDefineStmInvoke(backend: BootstrapLlvmBackend): void {
    val invoke = LLVMGetNamedFunction(backend.module, "abla_stm_invoke")
    if (pointerIsNull(invoke) || LLVMIsDeclaration(invoke) == 0) return
    val indirect = LLVMGetNamedFunction(backend.module, "abla_llvm_call_indirect")
    if (pointerIsNull(indirect)) return
    LLVMSetLinkage(invoke, llvmInternalLinkage())
    bootstrapLlvmAddFunctionAttribute(backend, invoke, "noinline")
    if (bootstrapLlvmWasmUnwinding) {
        bootstrapLlvmDefineWasmStmInvoke(backend, invoke, indirect)
        return
    }
    val setjmp = bootstrapLlvmDeclare(
        backend, "_setjmp", backend.i32Type, [backend.pointerType], false, [false]
    )
    bootstrapLlvmAddFunctionAttribute(backend, setjmp, "returns_twice")
    val entry = LLVMAppendBasicBlockInContext(backend.context, invoke, "entry")
    val call = LLVMAppendBasicBlockInContext(backend.context, invoke, "call")
    val abandoned = LLVMAppendBasicBlockInContext(backend.context, invoke, "abandoned")
    LLVMPositionBuilderAtEnd(backend.builder, entry)
    // 512 bytes cover every hosted libc's jmp_buf (glibc x86-64 200, Darwin arm64 192).
    val buffer = LLVMBuildAlloca(
        backend.builder, LLVMArrayType2(backend.i8Type, 512), "stm.jmp_buf"
    )
    LLVMSetAlignment(buffer, 16)
    val resumed = bootstrapLlvmCall(
        backend, setjmp, [buffer], "stm.resumed", false, [false]
    )
    LLVMBuildCondBr(
        backend.builder,
        LLVMBuildICmp(
            backend.builder, llvmIntEqual(), resumed,
            LLVMConstInt(backend.i32Type, 0, 0), "stm.first"
        ),
        call, abandoned
    )
    val result = LLVMGetReturnType(LLVMGlobalGetValueType(invoke))
    LLVMPositionBuilderAtEnd(backend.builder, call)
    LLVMBuildStore(backend.builder, buffer, LLVMGetParam(invoke, 2))
    val arguments = llvmPointerVector(4)
    arguments.set(0, LLVMGetParam(invoke, 1))
    arguments.set(1, LLVMGetParam(invoke, 0))
    arguments.set(2, LLVMConstNull(backend.pointerType))
    arguments.set(3, LLVMConstInt(backend.i64Type, 0, 0))
    val attempt = LLVMBuildCall2(
        backend.builder, LLVMGlobalGetValueType(indirect), indirect,
        arguments.pointer(), 4, ""
    )
    arguments.drop()
    bootstrapLlvmAddSret(backend, attempt, true)
    LLVMBuildRet(backend.builder, LLVMConstInt(result, 0, 0))
    LLVMPositionBuilderAtEnd(backend.builder, abandoned)
    LLVMBuildRet(backend.builder, LLVMConstInt(result, 1, 0))
    return
}

/** abla_stm_invoke on WebAssembly with exception handling (a module whose
 *  `orElse` alternatives can retry: bootstrapLlvmWasmUnwinding): the attempt is
 *  an invoke whose catch_all (legacy try/catch_all; `catchpad [ptr null]` asks
 *  for no type check, so no personality routine runs) returns 1, and
 *  abla_stm_throw, which abandons it, throws with LLVM's C++ tag (defined in
 *  the module). The stack pointer is restored at the catch by LLVM; the root
 *  frames and region by the runtime (__ablaRuntimePlatformUnwindingRestore).
 *  These two functions alone use exception handling. */
fun bootstrapLlvmDefineWasmStmInvoke(
    backend: BootstrapLlvmBackend,
    invoke: i64*,
    indirect: i64*
): void {
    bootstrapLlvmAddStringFunctionAttribute(backend, invoke, "target-features", "+exception-handling")
    val personality = bootstrapLlvmDeclare(
        backend, "__gxx_wasm_personality_v0", backend.i32Type, [], false, []
    )
    LLVMSetPersonalityFn(invoke, personality)
    val entry = LLVMAppendBasicBlockInContext(backend.context, invoke, "entry")
    val returned = LLVMAppendBasicBlockInContext(backend.context, invoke, "returned")
    val dispatch = LLVMAppendBasicBlockInContext(backend.context, invoke, "dispatch")
    val caught = LLVMAppendBasicBlockInContext(backend.context, invoke, "caught")
    val abandoned = LLVMAppendBasicBlockInContext(backend.context, invoke, "abandoned")
    val result = LLVMGetReturnType(LLVMGlobalGetValueType(invoke))
    LLVMPositionBuilderAtEnd(backend.builder, entry)
    val arguments = llvmPointerVector(4)
    arguments.set(0, LLVMGetParam(invoke, 1))
    arguments.set(1, LLVMGetParam(invoke, 0))
    arguments.set(2, LLVMConstNull(backend.pointerType))
    arguments.set(3, LLVMConstInt(backend.i64Type, 0, 0))
    val attempt = LLVMBuildInvoke2(
        backend.builder, LLVMGlobalGetValueType(indirect), indirect,
        arguments.pointer(), 4, returned, dispatch, ""
    )
    arguments.drop()
    bootstrapLlvmAddSret(backend, attempt, true)
    LLVMPositionBuilderAtEnd(backend.builder, returned)
    LLVMBuildRet(backend.builder, LLVMConstInt(result, 0, 0))
    LLVMPositionBuilderAtEnd(backend.builder, dispatch)
    val catchSwitch = LLVMBuildCatchSwitch(
        backend.builder, nativeNullPointer(), nativeNullPointer(), 1, "stm.dispatch"
    )
    LLVMAddHandler(catchSwitch, caught)
    LLVMPositionBuilderAtEnd(backend.builder, caught)
    val everything = llvmPointerVector(1)
    everything.set(0, LLVMConstNull(backend.pointerType))
    val pad = LLVMBuildCatchPad(backend.builder, catchSwitch, everything.pointer(), 1, "stm.caught")
    everything.drop()
    LLVMBuildCatchRet(backend.builder, pad, abandoned)
    LLVMPositionBuilderAtEnd(backend.builder, abandoned)
    LLVMBuildRet(backend.builder, LLVMConstInt(result, 1, 0))
    val thrower = LLVMGetNamedFunction(backend.module, "abla_stm_throw")
    if (pointerIsNull(thrower) || LLVMIsDeclaration(thrower) == 0) return
    LLVMSetLinkage(thrower, llvmInternalLinkage())
    bootstrapLlvmAddFunctionAttribute(backend, thrower, "noinline")
    bootstrapLlvmAddFunctionAttribute(backend, thrower, "noreturn")
    bootstrapLlvmAddStringFunctionAttribute(backend, thrower, "target-features", "+exception-handling")
    val raise = bootstrapLlvmDeclare(
        backend, "llvm.wasm.throw", backend.voidType, [backend.i32Type, backend.pointerType], false, [false, false]
    )
    LLVMPositionBuilderAtEnd(
        backend.builder, LLVMAppendBasicBlockInContext(backend.context, thrower, "entry")
    )
    // Tag 0: LLVM's C++ exception tag; the catch_all above takes any. No C++
    // runtime defines it here, so the module does (hidden: every LTO partition
    // links it, and no export names it).
    val tag = ".globl __cpp_exception\n.hidden __cpp_exception\n.tagtype __cpp_exception i32\n__cpp_exception:\n"
    LLVMAppendModuleInlineAsm(backend.module, tag, tag.size)
    bootstrapLlvmCall(
        backend, raise, [LLVMConstInt(backend.i32Type, 0, 0), LLVMConstNull(backend.pointerType)],
        "", false, [false, false]
    )
    LLVMBuildUnreachable(backend.builder)
    return
}
