fun bootstrapLlvmTraceMemory(label: string): void {
    val configured = linuxEnvironment("ABLA_COMPILER_MEMORY_TRACE")
    if (configured.found && configured.value != "") {
        linuxWriteStandardError(
            "abla-llvm-memory $label ${runtimeMemoryLiveBytes()}\n"
        )
    }
}

// Every defined function inlines its calls to `threshold` (LLVM's default is 225).
fun bootstrapLlvmSetInlineThreshold(
    backend: BootstrapLlvmBackend,
    threshold: int
): void {
    var function = LLVMGetFirstFunction(backend.module)
    while (!pointerIsNull(function)) {
        if (LLVMIsDeclaration(function) == 0) {
            bootstrapLlvmAddStringFunctionAttribute(
                backend, function, "function-inline-threshold", "$threshold"
            )
        }
        function = LLVMGetNextFunction(function)
    }
}

// Fold the portable runtime hook without mutating the cached, target-neutral
// IR. A bootstrap compiler that predates this policy simply keeps its false
// body and the old scalar clear. Calls are folded before reachability/scalar
// planning so fast and closed targets need neither a helper call nor an import.
fun bootstrapLlvmObjectZeroPolicy(
    program: BootstrapIrProgram,
    targetTriple: string,
    requireMain: bool
): BootstrapIrProgram {
    if (program.errors > 0) return program
    var found = false
    for (function in program.functions) {
        if (function.name == "__ablaRuntimeUseBulkObjectZero" ||
            function.name == "__ablaRuntimeEqualFloatKinds") found = true
    }
    if (!found) return program
    val host64 = targetTriple.startsWith("x86_64") ||
        targetTriple.startsWith("aarch64") || targetTriple.startsWith("arm64") ||
        targetTriple.startsWith("riscv64")
    val enabled = bootstrapLlvmAllowBulkObjectZero && requireMain &&
        !bootstrapLlvmStoreBoxes && host64 &&
        (bootstrapTextContains(targetTriple, "linux") ||
         bootstrapTextContains(targetTriple, "apple-macos") ||
         bootstrapTextContains(targetTriple, "apple-darwin"))
    val functions: array<BootstrapIrFunction> = []
    for (function in program.functions) {
        if (function.name == "__ablaRuntimeObjectBlock" ||
            function.name == "__ablaRuntimeUseBulkObjectZero" ||
            function.name == "__ablaRuntimeEqual" ||
            function.name == "__ablaRuntimeEqualFloatKinds") {
            val instructions: array<BootstrapInstruction> = []
            for (instruction in function.instructions) {
                val policyCall = function.name == "__ablaRuntimeObjectBlock" &&
                    instruction.opcode == "call" &&
                    instruction.text == "__ablaRuntimeUseBulkObjectZero"
                val policyBody = function.name == "__ablaRuntimeUseBulkObjectZero" &&
                    instruction.opcode == "const.bool"
                // `==` through `any` compares erased floats by kind only where a float may be
                // erased (bootstrapLlvmFloatKindEquality).
                val kindsCall = function.name == "__ablaRuntimeEqual" &&
                    instruction.opcode == "call" &&
                    instruction.text == "__ablaRuntimeEqualFloatKinds"
                val kindsBody = function.name == "__ablaRuntimeEqualFloatKinds" &&
                    instruction.opcode == "const.bool"
                if (policyCall || policyBody) {
                    instructions.append(BootstrapInstruction(
                        "const.bool", instruction.result, -1, -1,
                        if (enabled) "true" else "false", -1, -1, [], [],
                        instruction.position
                    ))
                } else if (kindsCall || kindsBody) {
                    instructions.append(BootstrapInstruction(
                        "const.bool", instruction.result, -1, -1,
                        if (bootstrapLlvmFloatKindEquality) "true" else "false", -1, -1, [], [],
                        instruction.position
                    ))
                } else instructions.append(instruction)
            }
            functions.append(BootstrapIrFunction(
                function.name, function.parameters, instructions, function.result,
                function.blocks, function.locals, function.localTypes,
                function.parameterTypes, function.resultType, function.inlineHint,
                function.noinlineHint, function.naked, function.section,
                function.targetFeatures, function.verificationErrors,
                function.label, function.position
            ))
        } else functions.append(function)
    }
    BootstrapIrProgram(
        program.instructions, functions, program.classes, program.natives,
        program.globalNames, program.globalTypes, program.globalKinds,
        program.compileInputPaths, program.compileInputContents, program.errors,
        program.lookup, program.validationFailures, program.extensionFields
    )
}

// A pruned function was declared external and hidden (a missed edge to it is a link error);
// one nothing uses would still leave an undefined symbol in the object.
trusted fun bootstrapLlvmEraseUnusedDormant(module: i64*): void {
    var function = LLVMGetFirstFunction(module)
    while (!pointerIsNull(function)) {
        val following = LLVMGetNextFunction(function)
        if (LLVMIsDeclaration(function) != 0 && LLVMGetVisibility(function) == 1 &&
            pointerIsNull(LLVMGetFirstUse(function))) LLVMDeleteFunction(function)
        function = following
    }
}

fun bootstrapEmitLlvmProgram(
    program: BootstrapIrProgram,
    targetTriple: string,
    requireMain: bool = true
): BootstrapLlvmEmission = bootstrapEmitLlvmProgramPrepared(
    bootstrapLlvmObjectZeroPolicy(program, targetTriple, requireMain),
    targetTriple, requireMain
)

fun bootstrapEmitLlvmProgramPrepared(
    program: BootstrapIrProgram,
    targetTriple: string,
    requireMain: bool
): BootstrapLlvmEmission {
    bootstrapLlvmTraceMemory("program.begin")
    bootstrapLlvmParameterDefaultsReset()
    bootstrapLlvmFloatReflectionDemand = false
    bootstrapLlvmInlineAssembly = []
    bootstrapLlvmProgramUsesSimd = bootstrapTextContains(targetTriple, "wasm32") &&
        bootstrapLlvmProgramHasSimd(program)
    bootstrapLlvmBridgeSymbolsReset()
    var exports = bootstrapTakeExportRequests()
    val functionNames: array<string> = []
    val nativeNames: array<string> = []
    var index = 0
    while (index < program.functions.size) {
        functionNames.append(program.functions[index].name)
        index = index + 1
    }
    index = 0
    while (index < program.natives.size) {
        nativeNames.append(program.natives[index].name)
        index = index + 1
    }
    val functionIndex = bootstrapLlvmNameIndex(functionNames)
    val nativeIndex = bootstrapLlvmNameIndex(nativeNames)
    val globalIndex = bootstrapLlvmGlobalIndex(program)
    val classIndex = bootstrapLlvmClassIndex(program)
    val fieldIndex = bootstrapLlvmFieldIndex(program)
    val addressTaken = bootstrapLlvmAddressTaken(program, functionIndex)
    val pressureSafePoints =
        bootstrapLlvmNeedsCollector(program, exports, targetTriple)
    val mayCollect = bootstrapLlvmCollectingFunctions(
        program, functionIndex, addressTaken, pressureSafePoints
    )
    val identities = bootstrapLlvmFunctionIdentities(program)
    val interruptHandlerRoots = bootstrapLlvmXtensaInterruptHandlerRoots(
        program, functionIndex
    )
    val nativeFunctionRoots = bootstrapLlvmNativeFunctionAddressRoots(
        program, functionIndex
    )
    // Native addresses in CT-only helper bodies are not runtime roots on
    // iOS. Follow those edges from the exported runtime graph instead.
    val ios = bootstrapLlvmTargetIsIOS(targetTriple)
    val initialNativeRoots: array<bool> = if (ios) [] else nativeFunctionRoots
    // Pruning (--fast, hosted): the roots are main, the globals and the exports, plus the runtime
    // function behind each bridge the reachable code needs. Which bridges those are depends on the
    // reachable instructions and on the roots, so it is settled by iteration: reach from the roots,
    // gather the bridges the reachable instructions call (and the backend's own), add their
    // implementations as roots, until nothing is added.
    val reachRoots: array<bool> = []
    for (flag in initialNativeRoots) reachRoots.append(flag)
    // The roots may be shorter than the functions (none, or iOS's empty list).
    while (reachRoots.size < program.functions.size) reachRoots.append(false)
    // A float `%` on WebAssembly and on x86-64 Linux calls the platform's
    // fmod (bootstrapLlvmEmitScalarOperation), which no export reaches. Where
    // the runtime is pruned (Linux) it is a root, so what it calls is emitted
    // too; forcing only its own emission left its callees out of a --fast build.
    val floatRemainder = if (bootstrapTextContains(targetTriple, "wasm32") ||
        bootstrapLlvmTargetIsX8664Linux(targetTriple) ||
        (bootstrapLlvmAarch64Hosted && bootstrapLlvmTargetIsAarch64Linux(targetTriple)) ||
        (bootstrapTextContains(targetTriple, "aarch64") && bootstrapTextContains(targetTriple,
            "android")))
        functionIndex.find("__ablaRuntimeFloatRemainder") else -1
    if (floatRemainder >= 0) reachRoots[floatRemainder] = true
    val pruning = bootstrapLlvmPruneRuntime && bootstrapTextContains(targetTriple, "linux") &&
        !bootstrapLlvmTargetHasClosedProgramBoundary(targetTriple)
    bootstrapLlvmPruneBridgesFinal = false
    bootstrapLlvmPruneActive = pruning
    bootstrapLlvmPruneFieldFamily = false
    bootstrapLlvmPruneConcurrencyFamily = false
    if (pruning) {
        var changed = true
        // The roots only grow and are bounded by the function count: this ends.
        while (changed) {
            changed = false
            val settled = bootstrapLlvmReachableExports(
                program, exports, functionIndex,
                interruptHandlerRoots, reachRoots, ios
            )
            bootstrapLlvmBridgeSymbolsGatherReachable(program, settled.functions)
            var pruneIndex = 0
            while (pruneIndex < program.functions.size) {
                if (!reachRoots[pruneIndex]) {
                    val pruneSymbol =
                        bootstrapLlvmSelfHostedRuntimeSymbol(program.functions[pruneIndex].name)
                    if (pruneSymbol != "" && (
                        bootstrapLlvmBackendOwnedBridge(pruneSymbol) ||
                        bootstrapLlvmBridgeSymbols
                        .slots[bootstrapLlvmBridgeSymbolSlot(pruneSymbol)] >= 0 ||
                        (pruneSymbol == "abla_runtime_thread_entry" &&
                         bootstrapLlvmBridgeSymbols
                            .slots[bootstrapLlvmBridgeSymbolSlot("abla_thread_create")] >= 0))) {
                        reachRoots[pruneIndex] = true
                        changed = true
                    }
                }
                pruneIndex = pruneIndex + 1
            }
        }
        bootstrapLlvmPruneBridgesFinal = true
    }
    val exportReachability = bootstrapLlvmReachableExports(
        program, exports, functionIndex,
        interruptHandlerRoots, if (pruning) reachRoots else initialNativeRoots, ios
    )
    if (ios) {
        index = 0
        while (index < nativeFunctionRoots.size) {
            nativeFunctionRoots[index] = nativeFunctionRoots[index] &&
                exportReachability.functions[index]
            index = index + 1
        }
    }
    val emittedFunctions: array<bool> = []
    val closedProgram = bootstrapLlvmTargetHasClosedProgramBoundary(
        targetTriple
    )
    index = 0
    while (index < program.functions.size) {
        emittedFunctions.append(
            (!closedProgram && !pruning) || exportReachability.functions[index]
        )
        index = index + 1
    }
    if (floatRemainder >= 0) emittedFunctions[floatRemainder] = true
    // So does a raw Linux system call on a bare wasm32 target, the browser
    // host's shim (bootstrapLlvmEmitWasmSyscall), and on the other 32-bit
    // targets that run that runtime (a microcontroller's: toolchain.ab), whose
    // platform answers the same abla_host calls.
    val wasmSyscall = if (bootstrapLlvmTargetIsBareWasm(targetTriple) ||
        (bootstrapLlvmTargetUses32BitPointers(targetTriple) &&
         !bootstrapTextContains(targetTriple, "wasm32")))
        functionIndex.find("__ablaRuntimeWasmSyscall") else -1
    if (wasmSyscall >= 0) emittedFunctions[wasmSyscall] = true
    // A macOS program's raw Linux system calls go to the Abla dispatcher over BSD
    // system calls (#811; stdlib/abla/runtime/platform/host.ab).
    val darwinSyscall = if (bootstrapTextContains(targetTriple, "macosx") &&
        !bootstrapLlvmTargetIsIOS(targetTriple))
        functionIndex.find("__ablaRuntimeDarwinSyscall") else -1
    if (darwinSyscall >= 0) emittedFunctions[darwinSyscall] = true
    // The macOS program records its image's identity before main (#811).
    val darwinImage = if (bootstrapTextContains(targetTriple, "macosx") &&
        !bootstrapLlvmTargetIsIOS(targetTriple))
        functionIndex.find("__ablaRuntimeDarwinRecordImage") else -1
    if (darwinImage >= 0) emittedFunctions[darwinImage] = true
    if (bootstrapLlvmTargetIsIOS(targetTriple) &&
        bootstrapLlvmIosAvailability(
            program, functionIndex, nativeIndex, emittedFunctions
        ) > 0) {
        return BootstrapLlvmEmission("", program.errors + 1, "")
    }
    exports = exportReachability.exports
    bootstrapLlvmCheckedExports = false
    for (export in exports) {
        if (export.checked) bootstrapLlvmCheckedExports = true
    }
    bootstrapLlvmTraceMemory("reachability.end")
    val interruptCode = bootstrapLlvmXtensaInterruptCode(
        program, functionIndex, interruptHandlerRoots, exports
    )
    val backend = bootstrapLlvmBackend(targetTriple)
    backend.pressureSafePoints = pressureSafePoints
    backend.noPanicRecovery = !bootstrapLlvmProgramMayRecoverPanic(program, exports, requireMain)
    backend.executableTls = requireMain && !backend.macOS &&
        bootstrapTextContains(targetTriple, "linux") &&
        functionIndex.find("main") >= 0
    // Foreign-callable and freestanding firmware artifacts benefit from
    // static scalar-var initialization because it can eliminate their lazy
    // export guard. Keep ordinary main executables on their established code
    // layout; abla-compare is a performance gate for that path.
    backend.constantScalarVarInitializers = exports.size > 0
    var exportInitializationRequired: array<bool> = []
    if (exports.size > 0) {
        exportInitializationRequired =
            bootstrapLlvmExportInitializationRequirements(
                backend, program, functionIndex
            )
    }
    bootstrapLlvmTraceMemory("initialization-analysis.end")
    // The frontend's work is done: the runtime heap's free memory goes back to the system before LLVM builds the
    // module, whose allocations come from the C library's malloc (once the runtime's blocks and malloc's were one
    // pool, and LLVM reused what the frontend freed).
    runtimeMemoryRelease()
    LLVMSetTarget(
        backend.module,
        nativePointerFromAddress(nativeCStringAddress(
            targetTriple
        ))
    )
    val targetDataLayout = bootstrapLlvmTargetDataLayout(targetTriple)
    if (targetDataLayout != "") {
        LLVMSetDataLayout(backend.module, targetDataLayout)
    }
    bootstrapLlvmDeclareRuntime(backend, program)
    // Only a hosted main receives argc/argv. Export-only and freestanding
    // modules keep zero-initialized process globals for process intrinsics but
    // do not expose an unreachable argument-setter definition.
    bootstrapLlvmEmitRuntimeProcessSupport(
        backend, functionIndex.find("main") >= 0
    )
    // Only into an x86-64 Linux executable module, whatever the flags say.
    val ownRoutines = bootstrapLlvmOwnMemoryRoutines && backend.executableTls &&
        bootstrapLlvmTargetIsX8664Linux(targetTriple)
    // A library has the memory and jump routines too, hidden so that each library binds its own copy and the host
    // keeps its memcpy; never the entry or thread routines (the host process owns those).
    val libraryRoutines = bootstrapLlvmLibraryRoutines && !backend.executableTls &&
        bootstrapLlvmTargetIsX8664Linux(targetTriple)
    if (ownRoutines || libraryRoutines) {
        bootstrapLlvmEmitLinuxMemoryRoutines(backend)
        bootstrapLlvmEmitLinuxJumpRoutines(backend)
    }
    // A macOS executable has the memory and C-runtime routines too, hidden (#811).
    val machORoutines = bootstrapLlvmOwnMachORoutines && bootstrapLlvmTargetIsMacOS(targetTriple) &&
        !bootstrapLlvmTargetIsIOS(targetTriple)
    if (machORoutines) bootstrapLlvmEmitMachORoutines(backend)
    // An AArch64 Linux executable keeps x86-64 system call numbers (aarch64.ab).
    if (bootstrapLlvmAarch64LinuxExecutable(backend)) {
        bootstrapLlvmEmitAarch64Routines(backend)
    }
    // An aarch64 Android library: the translator, memory and jump routines only (aarch64.ab).
    if (bootstrapLlvmAndroidArm64Library(backend)) {
        bootstrapLlvmEmitAarch64LibraryRoutines(backend)
    }
    if (ownRoutines && bootstrapLlvmFreestandingStart) {
        bootstrapLlvmEmitLinuxThreadRoutines(backend)
    }
    bootstrapLlvmDeclareDispatchers(backend)
    bootstrapLlvmDeclareProgramBoundaries(backend, program, exports)
    if (bootstrapLlvmCoverage) {
        bootstrapLlvmCoveragePlan(program)
        bootstrapLlvmCoverageDeclareHits(backend)
        bootstrapLlvmCoverageEmitDump(backend)
        if (functionIndex.find("main") < 0) bootstrapLlvmCoverageRegisterLibrary(backend)
    }
    var debug = bootstrapLlvmDebugBegin(backend, program)
    index = 0
    while (index < program.functions.size) {
        // Declare the complete typed call graph before selecting bodies. A
        // declaration is metadata only and is discarded when unused; keeping
        // it available makes a missed reachability edge a verifier error
        // instead of passing a null LLVMValueRef to LLVMBuildCall2.
        val generatedFunction = bootstrapLlvmDeclareGeneratedFunction(
            backend, identities.symbols[index]
        )
        val directFunction = bootstrapLlvmDeclareDirectFunction(
            backend, identities.symbols[index],
            program.functions[index]
        )
        // Keep the Abla source identity beside the stable, hashed linker
        // identity in textual LLVM. This is ordinary compiler metadata: LLVM
        // does not materialize it in the target image, but size and instruction
        // audits can map an optimized native function back to the `.ab` body
        // that produced it.
        bootstrapLlvmAddStringFunctionAttribute(
            backend, directFunction, "abla.source",
            program.functions[index].name
        )
        if (program.functions[index].name == "__ablaRuntimeWasmPanicWrite") {
            bootstrapLlvmAddStringFunctionAttribute(
                backend, directFunction, "abla.panic-write", ""
            )
        }
        if (emittedFunctions[index]) bootstrapLlvmDebugDeclareFunction(
            debug, backend, program.functions[index], index, directFunction,
            bootstrapLlvmDirectFunctionSymbol(identities.symbols[index])
        )
        if (!emittedFunctions[index]) {
            // LLVM rejects declaration-only values with internal linkage.
            // Leave dormant declarations external and hidden; if a missed
            // edge references one, verification succeeds and the native link
            // reports the precise unresolved symbol instead of crashing.
            LLVMSetLinkage(generatedFunction, llvmExternalLinkage())
            LLVMSetVisibility(generatedFunction, llvmHiddenVisibility())
            LLVMSetLinkage(directFunction, llvmExternalLinkage())
            LLVMSetVisibility(directFunction, llvmHiddenVisibility())
        }
        if (index < interruptCode.size && interruptCode[index]) {
            LLVMSetSection(directFunction, ".iram1.text")
        } else if (program.functions[index].section != "") {
            LLVMSetSection(
                directFunction,
                program.functions[index].section
            )
        }
        index = index + 1
    }
    bootstrapLlvmDeclareNativeFunctionAdapters(
        backend, program, nativeFunctionRoots, identities
    )
    bootstrapLlvmFloatRemainderSymbol = if (floatRemainder >= 0)
        bootstrapLlvmDirectFunctionSymbol(identities.symbols[floatRemainder]) else ""
    bootstrapLlvmWasmSyscallSymbol = if (wasmSyscall >= 0)
        bootstrapLlvmDirectFunctionSymbol(identities.symbols[wasmSyscall]) else ""
    bootstrapLlvmDarwinSyscallSymbol = if (darwinSyscall >= 0)
        bootstrapLlvmDirectFunctionSymbol(identities.symbols[darwinSyscall]) else ""
    bootstrapLlvmDarwinImageSymbol = if (darwinImage >= 0)
        bootstrapLlvmDirectFunctionSymbol(identities.symbols[darwinImage]) else ""
    // Global constants may contain nativeFunctionAddress relocations. Declare
    // every requested adapter before materializing globals so those addresses
    // become LLVM constants instead of forcing runtime initialization.
    bootstrapLlvmEmitGlobals(backend, program)
    bootstrapLlvmTraceMemory("declarations.end")
    index = 0
    while (index < program.functions.size) {
        if (index < interruptHandlerRoots.size &&
            interruptHandlerRoots[index]) {
            bootstrapLlvmDeclareXtensaInterruptEntry(
                backend, identities.symbols[index]
            )
        }
        index = index + 1
    }
    bootstrapLlvmTraceMemory("entry-declarations.end")
    if (exports.size > 0) bootstrapLlvmEmitExportInitializer(
        backend, program, functionIndex, identities
    )
    var errors = program.errors + identities.collisions +
        bootstrapLlvmStableNameCollisions(classIndex.names) +
        bootstrapLlvmStableNameCollisions(fieldIndex.names)
    bootstrapLlvmTraceMemory(
        "errors.initial:$errors:program=${program.errors}:identities=${identities.collisions}"
    )
    val retainedLinkedData: array<i64*> = []
    // Pre-size before entering per-function memory checkpoints. Growing this
    // array during emission would allocate its backing storage inside a
    // checkpoint which is reset before export/retention materialization.
    var retainedLinkedDataCapacity = 0
    index = 0
    while (index < program.functions.size) {
        if (emittedFunctions[index]) {
            var retainedInstruction = 0
            while (retainedInstruction <
                   program.functions[index].instructions.size) {
                val candidate =
                    program.functions[index].instructions[retainedInstruction]
                if (candidate.opcode == "extern.intrinsic" &&
                    (candidate.text ==
                        "nativeInternalLinkedStaticAllocate" ||
                     candidate.text ==
                        "nativeInternalSectionBytes" ||
                     candidate.text ==
                        "nativeInternalSectionThreadLocalAllocate")) {
                    retainedLinkedDataCapacity =
                        retainedLinkedDataCapacity + 1
                }
                if (candidate.opcode ==
                    "native.internal.section.u32s") {
                    retainedLinkedDataCapacity =
                        retainedLinkedDataCapacity + 1
                }
                retainedInstruction = retainedInstruction + 1
            }
        }
        index = index + 1
    }
    while (retainedLinkedData.size < retainedLinkedDataCapacity) {
        retainedLinkedData.append(nativeNullPointer())
    }
    bootstrapLlvmDeclareGeneratorSteps(backend, program, functionIndex, identities,
        emittedFunctions)
    // ABLA_ESCAPE_TRACE=<text>: why each closure or cell of a function whose name
    // contains <text> escapes its frame.
    val escapeDebug = linuxEnvironment("ABLA_ESCAPE_TRACE")
    bootstrapLlvmEscapeDebug = escapeDebug.found && escapeDebug.value != ""
    bootstrapLlvmStackClosureSitesAll = bootstrapLlvmStackClosureSites(
        program, functionIndex, emittedFunctions
    )
    for (line in bootstrapLlvmEscapeDebugLines) {
        if (bootstrapTextContains(line,
            escapeDebug.value)) linuxWriteStandardError("escape: $line\n")
    }

    bootstrapLlvmTraceStackClosures(program, emittedFunctions)
    // The inline assembly a held module keeps names visible for, gathered here: a function
    // is emitted inside a checkpoint that frees what it allocated, so the list can't grow
    // there (an Xtensa build that appended to it freed its storage under it, and ran out of
    // its 4 GB in the corrupted heap).
    index = 0
    while (index < program.functions.size) {
        if (emittedFunctions[index]) {
            for (instruction in program.functions[index].instructions) {
                if (instruction.opcode == "inline.assembly" && instruction.texts.size > 1) {
                    bootstrapLlvmInlineAssembly.append(instruction.texts[1])
                }
            }
        }
        index = index + 1
    }
    index = 0
    while (index < program.functions.size) {
        if (emittedFunctions[index]) {
            val emissionCheckpoint = runtimeMemoryCheckpoint()
            val functionErrors = bootstrapLlvmEmitFunction(
                backend, program, program.functions[index], index,
                functionIndex, identities, nativeIndex, globalIndex,
                classIndex, fieldIndex, mayCollect,
                exportReachability.assemblyRegionStarts[index],
                exportReachability.assemblyRegionEnds[index],
                exportReachability.assemblyRegionInstructions,
                exportReachability.assemblyRegionOrdinals,
                exportReachability.assemblyRegionReachable,
                retainedLinkedData,
                debug
            )
            bootstrapLlvmDebugClear(debug, backend)
            errors = errors + functionErrors
            runtimeMemoryReset(emissionCheckpoint)
        }
        index = index + 1
    }
    bootstrapLlvmTraceMemory("functions.end:errors=$errors")
    bootstrapLlvmStackClosureSitesAll = []
    bootstrapLlvmStackClosureFlags = bootstrapLlvmNoStackClosures
    bootstrapLlvmEmitGeneratorSteps(backend, program, identities, emittedFunctions)
    bootstrapLlvmDefineStmInvoke(backend)
    index = 0
    while (index < program.functions.size) {
        if (index < interruptHandlerRoots.size &&
            interruptHandlerRoots[index]) {
            val entryFunction = LLVMGetNamedFunction(
                backend.module,
                bootstrapLlvmXtensaInterruptEntrySymbol(
                    identities.symbols[index]
                )
            )
            val entryBlock = LLVMAppendBasicBlockInContext(
                backend.context, entryFunction, "entry"
            )
            LLVMPositionBuilderAtEnd(backend.builder, entryBlock)
            val interruptArguments: array<i64*> = []
            if (bootstrapLlvmDirectNeedsArgumentCount(
                program.functions[index]
            )) interruptArguments.append(
                LLVMConstInt(backend.i64Type, 0, 0)
            )
            bootstrapLlvmEmitDirectCall(
                backend, program.functions[index],
                LLVMGetNamedFunction(
                    backend.module, bootstrapLlvmDirectFunctionSymbol(
                        identities.symbols[index]
                    )
                ),
                interruptArguments,
                nativeNullPointer()
            )
            LLVMBuildRetVoid(backend.builder)
        }
        index = index + 1
    }
    bootstrapLlvmTraceMemory("interrupt-entries.end")
    bootstrapLlvmEmitSelfHostedRuntimeBridges(
        backend, program, identities
    )
    bootstrapLlvmTraceMemory("runtime-bridges.end")
    bootstrapLlvmEmitClosureDispatchers(
        backend, program, functionIndex, identities,
        emittedFunctions
    )
    bootstrapLlvmEmitIndirectDispatcher(
        backend, program, addressTaken, identities,
        exportReachability.functions
    )
    bootstrapLlvmTraceMemory("dispatchers.end")
    errors = errors + bootstrapLlvmEmitExports(
        backend, program, exports, functionIndex, identities,
        exportInitializationRequired, exportReachability.assemblyOwners,
        retainedLinkedData
    )
    bootstrapLlvmTraceMemory("exports.end:errors=$errors")
    bootstrapLlvmEmitNativeFunctionAdapters(
        backend, program, nativeFunctionRoots, identities,
        exportInitializationRequired
    )
    bootstrapLlvmTraceMemory("native-adapters.end")
    errors = errors + bootstrapLlvmEmitMain(
        backend, program, functionIndex, identities, globalIndex, exports,
        requireMain
    )
    bootstrapLlvmTraceMemory("module.end:errors=$errors")
    // A lowering error is already reported and leaves the module partial:
    // an instruction that could not be lowered has no value, so passes over
    // its users (and the verifier) would read a null operand. Skip them.
    if (errors == 0) {
        bootstrapLlvmMaterializeUsedWrappers(
            backend, program, identities, emittedFunctions,
            bootstrapLlvmInlineAssembly.size > 0
        )
        bootstrapLlvmTraceMemory("wrappers.end")
        // The flag is module-wide: descriptors and erased arrays can cross
        // functions and later codegen partitions. Resolve it only after late
        // wrapper emission, before optimization or partitioning.
        val floatReflection = LLVMGetNamedGlobal(backend.module, "abla_float_reflection_demand")
        if (!pointerIsNull(floatReflection)) {
            val enabled = LLVMConstInt(backend.i1Type,
                if (bootstrapLlvmFloatReflectionDemand) 1 else 0, 0)
            var use = LLVMGetFirstUse(floatReflection)
            while (!pointerIsNull(use)) {
                val load = LLVMGetUser(use)
                LLVMReplaceAllUsesWith(load, enabled)
                LLVMInstructionEraseFromParent(load)
                use = LLVMGetFirstUse(floatReflection)
            }
            LLVMDeleteGlobal(floatReflection)
        }
        val reflectionFlagIndex = functionIndex.find("ablaRuntimeFloatReflectionEnabled")
        if (reflectionFlagIndex >= 0) {
            val flagFunction = LLVMGetNamedFunction(backend.module,
                bootstrapLlvmDirectFunctionSymbol(identities.symbols[reflectionFlagIndex]))
            if (!pointerIsNull(flagFunction) && pointerIsNull(LLVMGetFirstUse(flagFunction))) {
                LLVMDeleteFunction(flagFunction)
            }
        }
        // Only a bare Wasm module has the host's write for the panic message
        // (wasm_panic.ab); a microcontroller's platform has none.
        if (!bootstrapLlvmTargetIsBareWasm(targetTriple) &&
            functionIndex.find("__ablaRuntimeWasmPanicWrite") >= 0) {
            bootstrapEraseWasmPanicWrite(backend.module)
        }
        bootstrapLlvmBridgeValuesByPointer(backend, program)
        bootstrapLlvmEmitStackGuardHandler(backend)
        bootstrapLlvmEmitDebugRuntime(backend)
        if (bootstrapLlvmPruneActive) bootstrapLlvmEraseUnusedDormant(backend.module)
        bootstrapLlvmDebugFinish(
            debug, backend, program, identities, emittedFunctions
        )
    }
    LLVMDisposeBuilder(backend.builder)
    var owned = LlvmOwnedModule(
        backend.context, backend.module, 0, false
    )
    val verification = if (errors == 0) owned.verify() else 0
    bootstrapLlvmTraceMemory(
        "verification.end:status=$verification:errors=$errors"
    )
    if (verification != 0) errors = errors + 1
    if (errors == 0 && bootstrapLlvmFastInlineThreshold > 0) {
        bootstrapLlvmSetInlineThreshold(backend, bootstrapLlvmFastInlineThreshold)
    }
    // Kept for in-process code generation (bootstrapLlvmHoldModule), or handed on as
    // bitcode (bootstrapLlvmBitcodePath): either way the emission's text is empty.
    val held = errors == 0 && bootstrapLlvmHoldModule
    if (errors == 0 && !held && bootstrapLlvmBitcodePath != "" &&
        owned.writeBitcode(bootstrapLlvmBitcodePath) != 0) errors = errors + 1
    val output = if (errors == 0 && !held && bootstrapLlvmBitcodePath == "") owned.render() else ""
    bootstrapLlvmTraceMemory("render.end")
    if (held) {
        bootstrapLlvmHeldContext = owned.context
        bootstrapLlvmHeldModule = owned.module
        owned.closed = true
    }
    owned.drop()
    bootstrapLlvmDropPointerScratch(backend)
    bootstrapLlvmTraceMemory("module.drop")
    BootstrapLlvmEmission(
        output, errors, bootstrapLlvmExportAbi(exports)
    )
}

// Function declarations are placeholders requested by address-taking code,
// dispatchers, globals and exports. Materialize their boxed entry points only
// after all those users have been emitted. A wrapper can itself refer to
// another wrapper, so keep looking until no new use appears. LLVM cannot see
// symbol references inside inline assembly; conservatively keep all in that
// case. Delete unused placeholders only after reaching the fixed point.
fun bootstrapLlvmMaterializeUsedWrappers(
    backend: BootstrapLlvmBackend,
    program: BootstrapIrProgram,
    identities: BootstrapLlvmFunctionIdentities,
    emitted: array<bool>,
    retainAssembly: bool
): void {
    val materialized: array<bool> = []
    var index = 0
    while (index < program.functions.size) {
        materialized.append(false)
        index = index + 1
    }
    var changed = true
    while (changed) {
        changed = false
        index = 0
        while (index < program.functions.size) {
            if (emitted[index] && !materialized[index]) {
                val wrapper = LLVMGetNamedFunction(
                    backend.module, identities.symbols[index]
                )
                if (!pointerIsNull(wrapper) &&
                    (retainAssembly || !pointerIsNull(LLVMGetFirstUse(wrapper)))) {
                    materialized[index] = true
                    bootstrapLlvmEmitGeneratedWrapper(
                        backend, program.functions[index], identities.symbols[index]
                    )
                    changed = true
                }
            }
            index = index + 1
        }
    }
    index = 0
    while (index < program.functions.size) {
        if (emitted[index] && !materialized[index]) {
            val wrapper = LLVMGetNamedFunction(
                backend.module, identities.symbols[index]
            )
            if (!pointerIsNull(wrapper)) LLVMDeleteFunction(wrapper)
        }
        index = index + 1
    }
    return
}

// Whether the module being built is a WebAssembly one whose `orElse`
// alternatives can retry (bootstrapSemanticWasmUnwinds): its attempts are left
// by an exception (bootstrapWasmUnwindingParse, bootstrapLlvmDefineStmInvoke),
// and it alone is built with exception handling (toolchain.ab).
var bootstrapLlvmWasmUnwinding = false
// The graph owner requests one semantic probe before running user actions.
// Nested CT compilations leave this off and cannot consume the request.
var bootstrapFloatBridgeProbe = false
// A whole program asks the same semantic probe for one fact only: whether any float is
// erased to `any` (bootstrapLlvmFloatKindEquality), with no bridge or formatting effect.
var bootstrapFloatOriginProbe = false
var bootstrapFloatBridgeAvailable = false

// The WebAssembly platform's attempt, abandon and unwinding, and the versions
// whose bodies replace them in a module that leaves attempts by an exception
// (abla/runtime/platform/wasm.ab).
val BOOTSTRAP_WASM_UNWINDING = [
    "__ablaRuntimePlatformAttempt", "__ablaRuntimePlatformUnwindingAttempt",
    "__ablaRuntimePlatformAbandon", "__ablaRuntimePlatformUnwindingAbandon",
    "__ablaRuntimePlatformUnwindSave", "__ablaRuntimePlatformUnwindingSave",
    "__ablaRuntimePlatformUnwindRestore", "__ablaRuntimePlatformUnwindingRestore"
]

/** `parsed` with each of the platform's attempt, abandon and unwinding running
 *  its unwinding version's body (same parameters, analyzed with the program),
 *  so the runtime's callers reach them unchanged. */
fun bootstrapWasmUnwindingParse(parsed: BootstrapParseResult): BootstrapParseResult {
    val bodies: array<BootstrapExpression> = []
    val found: array<bool> = []
    var pair = 0
    while (pair < BOOTSTRAP_WASM_UNWINDING.size) {
        bodies.append(BootstrapExpression("missing", "", 0, 0, []))
        found.append(false)
        pair = pair + 2
    }
    for (declaration in parsed.declarations) {
        pair = 0
        while (pair < BOOTSTRAP_WASM_UNWINDING.size) {
            if (declaration.kind == "fun" && declaration.name == BOOTSTRAP_WASM_UNWINDING[pair +
                1]) {
                bodies[pair / 2] = declaration.expression
                found[pair / 2] = true
            }
            pair = pair + 2
        }
    }
    val declarations: array<BootstrapDeclaration> = []
    for (declaration in parsed.declarations) {
        var replaced = declaration
        pair = 0
        while (pair < BOOTSTRAP_WASM_UNWINDING.size) {
            if (declaration.kind == "fun" && declaration.name == BOOTSTRAP_WASM_UNWINDING[pair] &&
                found[pair / 2]) replaced = bootstrapDeclarationWithExpression(declaration,
                    bodies[pair / 2])
            pair = pair + 2
        }
        declarations.append(replaced)
    }
    BootstrapParseResult(
        declarations, parsed.actions, parsed.errors, parsed.extensionErrors,
        parsed.compileInputPaths, parsed.compileInputContents, parsed.diagnostics
    )
}

/** Whether `expression` calls a function named `name` (a module's prefix aside). */
fun bootstrapExpressionCallsNamed(expression: BootstrapExpression, name: string): bool {
    if (expression.kind == "call" && bootstrapCanonicalDeclarationSourceName(expression.text) ==
        name) return true
    for (child in expression.children) if (bootstrapExpressionCallsNamed(child, name)) return true
    false
}

/** Whether the program's own code (not the standard library's) turns on background
 *  freeing (memorySetBackgroundFree, or the runtime's runtimeMemorySetBackgroundFree). */
fun bootstrapProgramWantsBackgroundFree(parsed: BootstrapParseResult): bool {
    for (declaration in parsed.declarations) {
        if (bootstrapStandardLibraryModuleSource(declaration.sourceIdentity)) continue
        if (bootstrapExpressionCallsNamed(declaration.expression, "memorySetBackgroundFree") ||
            bootstrapExpressionCallsNamed(declaration.expression,
                "runtimeMemorySetBackgroundFree")) return true
        for (method in declaration.methods) {
            if (bootstrapExpressionCallsNamed(method.expression, "memorySetBackgroundFree") ||
                bootstrapExpressionCallsNamed(method.expression,
                    "runtimeMemorySetBackgroundFree")) return true
        }
    }
    false
}

/** `parsed` whose collection is the host runtime's one with background freeing
 *  (__ablaRuntimeHostBackgroundMemoryCollect's body, same signature, analyzed with the
 *  program): built only for a program that turns it on, so any other program's
 *  collection, and code, are what they were. */
fun bootstrapBackgroundFreeParse(parsed: BootstrapParseResult): BootstrapParseResult {
    var body = BootstrapExpression("missing", "", 0, 0, [])
    for (declaration in parsed.declarations) {
        if (declaration.kind == "fun" && declaration.name ==
            "__ablaRuntimeHostBackgroundMemoryCollect") {
            body = declaration.expression
        }
    }
    if (body.kind == "missing") return parsed
    val declarations: array<BootstrapDeclaration> = []
    for (declaration in parsed.declarations) declarations.append(
        if (declaration.kind == "fun" && declaration.name == "__ablaRuntimePlatformMemoryCollect")
            bootstrapDeclarationWithExpression(declaration, body)
        else declaration
    )
    BootstrapParseResult(
        declarations, parsed.actions, parsed.errors, parsed.extensionErrors,
        parsed.compileInputPaths, parsed.compileInputContents, parsed.diagnostics
    )
}

// Rounds of lowering that commit compile-time code's edits, at most.
val BOOTSTRAP_COMPILE_EDIT_ROUNDS = 8

/** The edits of `edits` that aren't already in `committed` (a site that asks
 *  for what it got changes nothing). */
fun bootstrapNewCompileEdits(
    edits: array<BootstrapDeclarationEdit>,
    committed: array<BootstrapDeclarationEdit>
): array<BootstrapDeclarationEdit> {
    val fresh: array<BootstrapDeclarationEdit> = []
    for (edit in edits) {
        var known = false
        for (other in committed) {
            if (other.kind == edit.kind && other.targetIdentity == edit.targetIdentity &&
                other.owner == edit.owner && other.name == edit.name &&
                other.signature == edit.signature && other.payload == edit.payload) known = true
        }
        for (other in fresh) {
            if (other.kind == edit.kind && other.targetIdentity == edit.targetIdentity &&
                other.owner == edit.owner && other.name == edit.name &&
                other.signature == edit.signature && other.payload == edit.payload) known = true
        }
        if (!known) fresh.append(edit)
    }
    fresh
}

fun bootstrapCompileLlvmParsedCached(
    written: BootstrapParseResult,
    var cache: BootstrapIrCacheState,
    targetTriple: string,
    pruneUnused: bool = false,
    requireMain: bool = true,
    // The round of lowering (0: the first), and the edits compile-time code
    // made in the rounds before, committed to `written` already.
    round: int = 0,
    committed: array<BootstrapDeclarationEdit> = [],
    // The compile globals before the first round's `#` sites ran: each round
    // starts from them, as a single lowering would.
    globalsBefore: array<string> = [],
    // A release driver can request a bitcode handoff for LLVM clients. Decide
    // after lowering, without changing ordinary programs or nested CT emits.
    holdLlvmClient: bool = false
): BootstrapLlvmCompilation {
    val bridgeProbe = bootstrapFloatBridgeProbe
    val originProbe = bootstrapFloatOriginProbe
    val floatProbe = bridgeProbe || originProbe
    bootstrapFloatBridgeProbe = false
    bootstrapFloatOriginProbe = false
    var floatKinds = true
    // A parse error stops the build after the parser: analysis and code
    // generation would only run over the holes it left, and their errors
    // (unknown types, invalid IR) would bury it. Named-argument mistakes are
    // counted with the parse but are semantic, so they don't stop it here.
    val parserOnlyErrors = written.errors - written.extensionErrors -
        bootstrapPeekNamedArgumentErrors()
    if (parserOnlyErrors > 0) {
        val discardedExports = bootstrapTakeExportRequests()
        val discardedNamed = bootstrapTakeNamedArgumentErrors()
        val discardedLowering = bootstrapTakeDiagnosedLoweringErrors()
        return BootstrapLlvmCompilation(
            "",
            written.errors,
            parserOnlyErrors,
            written.extensionErrors,
            discardedNamed,
            0,
            bootstrapSourceRewriteDiagnostics(
                "${written.diagnostics}${bootstrapTakeDriverDiagnostics()}"
            ),
            false,
            false,
            [],
            [],
            ""
        )
    }
    // Generics are replaced by their instances (generics.ab), and overloads
    // get distinct names and their calls name them (overload.ab).
    // Receiver members called (and, in extensions, fields read) by plain name
    // become `this.` accesses, and array literals take the type expected of
    // them (expected_types.ab), before overloads are resolved; delegated
    // properties' accesses become plain calls of their delegates
    // (delegated_properties.ab); results that return a view of a parameter
    // get its borrow contract.
    val parsed = bootstrapPreSemanticPipeline(written)
    bootstrapLlvmTraceMemory("frontend.annotations.begin")
    val annotationErrors = bootstrapStageAnnotatedExports(parsed)
    bootstrapLlvmTraceMemory("frontend.annotations.end")
    bootstrapLlvmTraceMemory("frontend.semantic.begin")
    // (Whether the build is for WebAssembly: what a transaction may do there.)
    val outerTargetsWasm = bootstrapSemanticTargetsWasm
    bootstrapSemanticTargetsWasm = bootstrapTextContains(targetTriple, "wasm")
    bootstrapSemanticWasmUnwinds = false
    val outerFloatDemandActive = bootstrapFloatDemandActive
    if (floatProbe) {
        bootstrapFloatDemandOrigin = false
        bootstrapFloatDemandText = false
        bootstrapFloatDemandPrepare(parsed.declarations)
        bootstrapFloatDemandActive = true
    }
    val analyzed = bootstrapCtAnalyze(parsed, targetTriple)
    bootstrapFloatDemandActive = outerFloatDemandActive
    if (floatProbe) bootstrapFloatDemandNames = Map()
    if (floatProbe && analyzed.errors == 0) {
        val demanded = bootstrapFloatDemandOrigin && bootstrapFloatDemandText
        if (bridgeProbe) {
            if (demanded && !bootstrapFloatBridgeAvailable) {
                bootstrapSemanticTargetsWasm = outerTargetsWasm
                bootstrapSemanticWasmUnwinds = false
                bootstrapCtFinishPass()
                val discardedExports = bootstrapTakeExportRequests()
                return BootstrapLlvmCompilation("", 0, 0, 0, 0, 0, "", false, false, [], [], "",
                    true)
            }
            bootstrapFloatFormattingRequested = demanded
        }
        if (originProbe) floatKinds = bootstrapFloatDemandOrigin
    }
    bootstrapSemanticTargetsWasm = outerTargetsWasm
    // A WebAssembly program whose `orElse` alternatives can retry leaves them
    // by an exception; any other module is built as it always was.
    bootstrapLlvmWasmUnwinding = bootstrapSemanticWasmUnwinds &&
        bootstrapTextContains(targetTriple, "wasm")
    bootstrapSemanticWasmUnwinds = false
    bootstrapLlvmTraceMemory("frontend.semantic.end")
    val actionInputPaths: array<string> = []
    val actionInputContents: array<string> = []
    var actionErrors = 0
    var actionDiagnostics = ""
    var action = 0
    while (analyzed.errors == 0 && action < parsed.actions.size) {
        var expression = parsed.actions[action]
        if (expression.kind == "compile" && expression.children.size == 1) {
            expression = expression.children[0]
        }
        val transform = expression.kind == "member.call" &&
            expression.text == "transform" &&
            expression.children.size > 0 &&
            expression.children[0].kind == "identifier" &&
            expression.children[0].text == "compiler"
        val authorization = expression.kind ==
            "compile.capability.authorization"
        // Grants, subparser registrations and generated modules written as
        // literal actions were applied from source before analysis.
        val grant = expression.kind == "call" &&
            (expression.text == "compilerGrant" ||
             expression.text == "compilerRegisterSubparser" ||
             expression.text == "compilerGenerateModule")
        if (!transform && !authorization && !grant) {
            val evaluated = bootstrapCtEvaluateWithEffects(
                expression,
                parsed.declarations,
                bootstrapBuildCompileEffectGrants(
                    bootstrapBuildCompileEffectRequests(parsed),
                    bootstrapBuildCompileEffectAuthorizations(parsed)
                )
            )
            actionErrors = actionErrors + evaluated.errors
            actionDiagnostics =
                "$actionDiagnostics${evaluated.diagnostics}"
            bootstrapMergeCompileInputs(
                actionInputPaths,
                actionInputContents,
                evaluated.compileInputPaths,
                evaluated.compileInputContents
            )
        }
        action = action + 1
    }
    bootstrapLlvmTraceMemory("frontend.actions.end")
    bootstrapLlvmTraceMemory("frontend.lowering.begin")
    val staleDiagnosed = bootstrapTakeDiagnosedLoweringErrors()
    bootstrapStagedEvaluationBlocked = analyzed.errors > 0 || actionErrors > 0
    // `#` sites may change the program (compiler.replaceFunctionBody, ...):
    // their edits are committed and the program lowered again (a round), until
    // a round changes nothing.
    bootstrapCompileEditRound = round
    bootstrapCompileRoundRaw = written.declarations
    val globals = if (round == 0) bootstrapSnapshotCompileGlobals() else globalsBefore
    if (round > 0) bootstrapRestoreCompileGlobals(globals)
    val earlierRoundEdits = bootstrapTakeCompileRoundEdits()
    val program = bootstrapLowerParsedCached(
        if (bootstrapLlvmWasmUnwinding) bootstrapWasmUnwindingParse(parsed)
        else if (bootstrapProgramWantsBackgroundFree(parsed)) bootstrapBackgroundFreeParse(parsed)
        else parsed,
        analyzed, cache, pruneUnused
    )
    bootstrapCompileEditRound = -1
    bootstrapCompileRoundRaw = []
    bootstrapStagedEvaluationBlocked = false
    val roundEdits = bootstrapNewCompileEdits(bootstrapTakeCompileRoundEdits(), committed)
    if (roundEdits.size > 0 && analyzed.errors == 0 && actionErrors == 0 &&
        program.errors == 0) {
        // This round's code is discarded: what it staged goes with it.
        val discardedExports = bootstrapTakeExportRequests()
        val discardedDiagnosed = bootstrapTakeDiagnosedLoweringErrors()
        val discardedDiagnostics = bootstrapTakeDriverDiagnostics()
        bootstrapCtFinishPass()
        if (round + 1 >= BOOTSTRAP_COMPILE_EDIT_ROUNDS) {
            var asked = ""
            for (edit in roundEdits) {
                asked =
                    "$asked\n  ${edit.kind} `${bootstrapEditTargetText(edit)}` (${edit.originChain})"
            }
            return BootstrapLlvmCompilation(
                "", 1, 0, 0, 1, 0,
                "error[E_COMPILE_EDIT_FIXPOINT]: compile.edit-fixpoint: compile-time code changed the program in each of $BOOTSTRAP_COMPILE_EDIT_ROUNDS rounds of lowering; the last round asked for:$asked\n",
                false, false, [], [], ""
            )
        }
        val sofar: array<BootstrapDeclarationEdit> = []
        for (edit in committed) sofar.append(edit)
        for (edit in roundEdits) sofar.append(edit)
        bootstrapFloatBridgeProbe = bootstrapFloatBridgeAvailable
        bootstrapFloatOriginProbe = originProbe
        return bootstrapCompileLlvmParsedCached(
            bootstrapCommitEdits(written, roundEdits), cache, targetTriple,
            pruneUnused, requireMain, round + 1, sofar, globals, holdLlvmClient
        )
    }
    // Lowering errors whose diagnostics are already staged (a compile-time
    // evaluation or lift that failed, one per diagnostic): they are the
    // diagnosis, as semantic errors are, so nothing is emitted for them and
    // they are not reported again as IR failures.
    val diagnosedLowering = bootstrapTakeDiagnosedLoweringErrors()
    bootstrapLlvmTraceMemory(
        "frontend.lowering.end:${program.functions.size}"
    )
    bootstrapMergeCompileInputs(
        program.compileInputPaths,
        program.compileInputContents,
        actionInputPaths,
        actionInputContents
    )
    // In a program that parsed, semantic errors (overload resolution's among
    // them, which `parsed` counts) are the diagnosis: code generation would
    // only add verifier noise about the same mistakes. So is a failed extension
    // (a subparser's syntax error leaves no expression to lower). (A parse
    // error already stopped the build above.)
    val overloadErrors = parsed.errors - written.errors
    // Named-argument mistakes are counted with the parse but are semantic: no code
    // generation after them either.
    val namedArgumentErrors = bootstrapTakeNamedArgumentErrors()
    val semanticErrors = analyzed.errors - parsed.errors - analyzed.extensionErrors +
        overloadErrors + namedArgumentErrors
    val extensionErrors = parsed.extensionErrors + analyzed.extensionErrors
    val enclosingHold = bootstrapLlvmHoldModule
    if (!enclosingHold && holdLlvmClient && bootstrapLlvmNeedsLlvm(program)) {
        bootstrapLlvmHoldModule = true
    }
    val emitted = if (bootstrapParsedHasContractCall(parsed) ||
                      actionErrors > 0 || extensionErrors > 0 ||
                      diagnosedLowering > 0 ||
                      (semanticErrors > 0 &&
                       written.errors - namedArgumentErrors == 0)) {
        val discardedExports = bootstrapTakeExportRequests()
        BootstrapLlvmEmission(
            "", analyzed.errors + actionErrors + diagnosedLowering, ""
        )
        // After a parse error, a `main` the parser skipped isn't missing.
    } else {
        val enclosingFloatKinds = bootstrapLlvmFloatKindEquality
        bootstrapLlvmFloatKindEquality = floatKinds
        val result = bootstrapEmitLlvmProgram(
            program, targetTriple, requireMain && written.errors == 0
        )
        bootstrapLlvmFloatKindEquality = enclosingFloatKinds
        result
    }
    bootstrapLlvmHoldModule = enclosingHold
    // Code generation's own diagnosed errors (E_NO_MAIN) are named already.
    val emissionErrors = bootstrapTakeDiagnosedLoweringErrors()
    val irErrors = emitted.errors - analyzed.errors - actionErrors - diagnosedLowering
    val totalErrors = emitted.errors + annotationErrors
    var diagnostics = bootstrapEnsurePrimaryDiagnostics(
        "${analyzed.diagnostics}$actionDiagnostics",
        analyzed.errors + actionErrors,
        "E_COMPILER_UNCLASSIFIED",
        "parser, extension, or semantic analysis"
    )
    diagnostics = "${diagnostics}${bootstrapTakeDriverDiagnostics()}"
    if (irErrors > emissionErrors) {
        diagnostics = "$diagnostics${bootstrapIrVerificationDiagnostics(
            program,
            parsed,
            analyzed.errors + diagnosedLowering,
            irErrors - emissionErrors
        )}"
    }
    diagnostics = bootstrapSourceRewriteDiagnostics(
        bootstrapEnsurePrimaryDiagnostics(
            diagnostics,
            totalErrors,
            "E_COMPILER_UNCLASSIFIED",
            "LLVM compilation"
        )
    )
    bootstrapCtFinishPass()
    BootstrapLlvmCompilation(
        emitted.output,
        totalErrors,
        written.errors - parsed.extensionErrors - namedArgumentErrors,
        parsed.extensionErrors + analyzed.extensionErrors,
        semanticErrors + annotationErrors + actionErrors + diagnosedLowering,
        irErrors,
        diagnostics,
        // iOS rejects reachable LLVM calls before emission. Unused native
        // declarations (including CT-only helpers) must not request a JIT link.
        !bootstrapLlvmTargetIsIOS(targetTriple) && bootstrapLlvmNeedsLlvm(program),
        bootstrapLlvmNeedsHostRuntime(program),
        program.compileInputPaths,
        program.compileInputContents,
        emitted.abiExports,
        hostImports = bootstrapLlvmNeedsHostImports(program)
    )
}

fun bootstrapCompileLlvmParsed(
    parsed: BootstrapParseResult
): BootstrapLlvmCompilation {
    val cache = bootstrapIrTransientState()
    bootstrapCompileLlvmParsedCached(parsed, cache, llvmDefaultTargetTriple())
}

// For `--emit-llvm`: a big import graph costs what it reaches, as in a build.
fun bootstrapCompileLlvmEmit(
    parsed: BootstrapParseResult,
    sourcePath: string
): BootstrapLlvmCompilation {
    val cache = bootstrapIrTransientState()
    bootstrapLowerEveryBodyOf = bootstrapNormalizeModulePath(sourcePath)
    val compilation = bootstrapCompileLlvmParsedCached(parsed, cache, llvmDefaultTargetTriple(),
        true)
    bootstrapLowerEveryBodyOf = ""
    compilation
}

fun bootstrapCompileLlvm(source: string): BootstrapLlvmCompilation =
    bootstrapCompileLlvmParsed(bootstrapParseStaged(source))

fun bootstrapEmitLlvm(source: string): string =
    bootstrapCompileLlvm(source).output

// ABLA_CLOSURE_TRACE=1: how many closures with captures the program makes, and how
// many of them keep their captures in the frame; how many cells, and how many of
// them are in the frame.
fun bootstrapLlvmTraceStackClosures(program: BootstrapIrProgram, emitted: array<bool>): void {
    val configured = linuxEnvironment("ABLA_CLOSURE_TRACE")
    if (!configured.found || configured.value == "") return
    var sites = 0
    var stack = 0
    var cells = 0
    var frameCells = 0
    for (index in 0 until program.functions.size) {
        if (index < emitted.size && emitted[index]) {
            val function = program.functions[index]
            for (at in 0 until function.instructions.size) {
                val instruction = function.instructions[at]
                if (instruction.opcode == "cell.create") {
                    cells = cells + 1
                    if (index < bootstrapLlvmStackClosureSitesAll.size &&
                        at < bootstrapLlvmStackClosureSitesAll[index].size &&
                        bootstrapLlvmStackClosureSitesAll[index][at]) frameCells = frameCells + 1
                }
                if (instruction.opcode == "closure.create" && instruction.operands.size > 0) {
                    sites = sites + 1
                    if (index < bootstrapLlvmStackClosureSitesAll.size &&
                        at < bootstrapLlvmStackClosureSitesAll[index].size &&
                        bootstrapLlvmStackClosureSitesAll[index][at]) stack = stack + 1
                }
            }
        }
    }
    linuxWriteStandardError("closures: $stack of $sites with captures keep them in the frame\n")
    linuxWriteStandardError("cells: $frameCells of $cells in the frame\n")
    return
}
