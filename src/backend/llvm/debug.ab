    builder: i64*, scope: i64*, name: cstring, nameLength: int, file: i64*, line: i32, sizeInBits: int,
    alignInBits: i32, flags: i32, derivedFrom: i64*, elements: i64*, elementCount: i32, runtimeLanguage: i32,
    vtableHolder: i64*, uniqueId: cstring, uniqueIdLength: int
): i64*
