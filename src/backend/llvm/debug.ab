// Debug information: DWARF line tables, readable function symbols and frame
// pointers. A build with debug information on (bootstrapLlvmDebugInfo) maps
// every lowered instruction back to its Abla file, line and column, names each
// emitted function after its Abla declaration ("Owner.method" qualified by its
// module), and keeps a frame-pointer chain on native targets, so debuggers,
// crash reports and browser developer tools show Abla stacks.

import "../../source_rewrite.ab"
import "core.ab"
import "bindings.ab"
import "abla/unsafe/memory/raw"
import "../../staged_parser.ab"
import "../../ir.ab"
import "abla/sys/linux/fs"
import "../../parser.ab"
import "abla/unsafe/memory"
import "analysis.ab"
import "../../sema.ab"

// Set by the driver for one build (on by default for development builds).
// A --fast hosted build emits only the runtime functions its program reaches (set by the build
// driver on Linux hosts; ABLA_FAST_PRUNE=0 turns it off). The three prune globals are set at the
// start of every emission and reset by the driver after a build; a compile-time emission
// (ct_jit.ab) runs unpruned and finishes before the outer emission reaches its fixpoint.
var bootstrapLlvmPruneRuntime: bool = false
// Set once a pruned build has settled which bridges it needs (bootstrapLlvmRuntimeBridgeUsed).
var bootstrapLlvmPruneBridgesFinal: bool = false
// Whether this build prunes (the flag above, on a target that is not a closed program).
var bootstrapLlvmPruneActive: bool = false
var bootstrapLlvmDebugInfo: bool = false
// Set with bootstrapLlvmDebugInfo: whether the module is optimized (release).
var bootstrapLlvmDebugOptimized: bool = false
// Set with bootstrapLlvmDebugInfo: the program's entry source, which names
// the compile unit.
var bootstrapLlvmDebugEntry: string = ""
// Where the module is written as bitcode instead of rendered as LLVM text ("": text). A
// build sets it around its own compilation, restoring the previous value after, so a
// build nested in compile-time evaluation decides for itself.
var bootstrapLlvmBitcodePath: string = ""
// Set the same way: a fast or balanced build's inliner threshold, given to every defined
// function as "function-inline-threshold" (0: none). A function attribute rather than
// opt's process-wide -inline-threshold, so builds in one process don't share it.
var bootstrapLlvmFastInlineThreshold: int = 0
// Set the same way: in a release WebAssembly build, the module initializer's body is
// cut into blocks of this many IR instructions (0: one block). See
// bootstrapLlvmInitializerChunk.
var bootstrapLlvmInitializerChunk: int = 0
// Set the same way: keep the finished module (bootstrapLlvmHeldModule, in
// bootstrapLlvmHeldContext) for in-process code generation instead of writing it.
var bootstrapLlvmHoldModule: bool = false
var bootstrapLlvmHeldContext: i64* = nativeNullPointer()
var bootstrapLlvmHeldModule: i64* = nativeNullPointer()
// The inline assembly of the module last emitted, as the program wrote it: what names in it
// a held module must keep visible (bootstrapOptimizeHeldWholeProgram), as its text would say.
var bootstrapLlvmInlineAssembly: array<string> = []
// Set while the compile-time tier emits its slice (ct_jit.ab): the module's exports
// are its entry points as a hosted program's `main` is, so it collects under
// allocation pressure by default and publishes its globals as collector roots.
var bootstrapLlvmExportsAreEntries: bool = false

noescape extern:"c" fun LLVMCreateDIBuilder(module: i64*): i64*
noescape extern:"c" fun LLVMDisposeDIBuilder(builder: i64*): void
noescape extern:"c" fun LLVMDIBuilderFinalize(builder: i64*): void
noescape extern:"c" fun LLVMDIBuilderCreateFile(
    builder: i64*,
    name: cstring,
    nameLength: int,
    directory: cstring,
    directoryLength: int
): i64*
noescape extern:"c" fun LLVMDIBuilderCreateCompileUnit(
    builder: i64*,
    language: i32,
    file: i64*,
    producer: cstring,
    producerLength: int,
    optimized: i32,
    flags: cstring,
    flagsLength: int,
    runtimeVersion: i32,
    splitName: cstring,
    splitNameLength: int,
    kind: i32,
    dwoId: i32,
    splitDebugInlining: i32,
    debugInfoForProfiling: i32,
    sysroot: cstring,
    sysrootLength: int,
    sdk: cstring,
    sdkLength: int
): i64*
noescape extern:"c" fun LLVMDIBuilderCreateSubroutineType(
    builder: i64*,
    file: i64*,
    parameterTypes: i64*,
    parameterCount: i32,
    flags: i32
): i64*
noescape extern:"c" fun LLVMDIBuilderCreateFunction(
    builder: i64*,
    scope: i64*,
    name: cstring,
    nameLength: int,
    linkageName: cstring,
    linkageNameLength: int,
    file: i64*,
    line: i32,
    type: i64*,
    localToUnit: i32,
    definition: i32,
    scopeLine: i32,
    flags: i32,
    optimized: i32
): i64*
noescape extern:"c" fun LLVMSetSubprogram(function: i64*, subprogram: i64*): void
noescape extern:"c" fun LLVMGetSubprogram(function: i64*): i64*
noescape extern:"c" fun LLVMDIBuilderCreateDebugLocation(
    context: i64*,
    line: i32,
    column: i32,
    scope: i64*,
    inlinedAt: i64*
): i64*
noescape extern:"c" fun LLVMSetCurrentDebugLocation2(
    builder: i64*,
    location: i64*
): void
noescape extern:"c" fun LLVMDILocationGetScope(location: i64*): i64*
noescape extern:"c" fun LLVMAddModuleFlag(
    module: i64*,
    behavior: i32,
    key: cstring,
    keyLength: int,
    value: i64*
): void
noescape extern:"c" fun LLVMValueAsMetadata(value: i64*): i64*
noescape extern:"c" fun LLVMGetFirstFunction(module: i64*): i64*
noescape extern:"c" fun LLVMGetNextFunction(function: i64*): i64*
noescape extern:"c" fun LLVMIsDeclaration(global: i64*): i32
noescape extern:"c" fun LLVMGetLinkage(global: i64*): i32
noescape extern:"c" fun LLVMGetFirstBasicBlock(function: i64*): i64*
noescape extern:"c" fun LLVMGetNextBasicBlock(block: i64*): i64*
noescape extern:"c" fun LLVMGetValueName2(value: i64*, length: i64*): i64*

trusted fun bootstrapLlvmDebugAddress(pointer: i64*): int =
    nativePointerAddress(pointer)

fun bootstrapLlvmDebugSame(left: i64*, right: i64*): bool =
    bootstrapLlvmDebugAddress(left) == bootstrapLlvmDebugAddress(right)

class BootstrapLlvmDebug(
    val enabled: bool,
    val builder: i64*,
    val unit: i64*,
    val unitFile: i64*,
    val subroutineType: i64*,
    // Per source file (bootstrapIrSourceFiles): its DIFile, the byte offset
    // each line starts at, and how its parsed source maps back to it.
    val files: array<i64*>,
    val lineStarts: array<array<int>>,
    val rewrites: array<BootstrapSourceRewrite>,
    // Per lowered function: its DISubprogram (null when it has none) and the
    // file index of its declaration.
    val subprograms: array<i64*>,
    val functionFiles: array<int>,
    val functionLines: array<int>,
    // The addresses of emitted Abla functions with no source position (the
    // global initializers, generated drops): they get no subprogram. One
    // would only add line-0 rows, and WebAssembly code generation scans each
    // block of a function with debug information once per value, which the
    // initializers' one huge block makes quadratic.
    val undescribed: array<int>,
    // The location the builder currently carries.
    var currentScope: i64*,
    var currentLine: int,
    var currentColumn: int
)

fun bootstrapLlvmDebugDisabled(): BootstrapLlvmDebug =
    BootstrapLlvmDebug(
        false, nativeNullPointer(), nativeNullPointer(),
        nativeNullPointer(), nativeNullPointer(), [], [], [], [], [], [], [],
        nativeNullPointer(), -1, -1
    )

// The directory and name parts of a path, for a DIFile.
fun bootstrapLlvmDebugSplitPath(path: string): array<string> {
    var slash = path.size - 1
    while (slash >= 0 && path[slash] != 47) slash = slash - 1
    if (slash < 0) ["", path]
    else if (slash == 0) ["/", path.slice(1, path.size)]
    else [path.slice(0, slash), path.slice(slash + 1, path.size)]
}

// An absolute, normalized path ("a/./b/../c" → "a/c") for a source identity.
fun bootstrapLlvmDebugAbsolutePath(path: string, directory: string): string {
    val joined = if (path.size > 0 && path[0] == 47) path
        else "$directory/$path"
    val parts: array<string> = []
    var depth = 0
    var begin = 0
    var index = 0
    while (index <= joined.size) {
        if (index == joined.size || joined[index] == 47) {
            val part = joined.slice(begin, index)
            if (part == "..") {
                if (depth > 0) depth = depth - 1
            } else if (part != "" && part != ".") {
                if (depth < parts.size) parts[depth] = part
                else parts.append(part)
                depth = depth + 1
            }
            begin = index + 1
        }
        index = index + 1
    }
    var result = ""
    index = 0
    while (index < depth) {
        result = "$result/${parts[index]}"
        index = index + 1
    }
    if (result == "") "/" else result
}

// A source file's DIFile. For a native object the compilation directory is ".", as
// clang's -fdebug-compilation-dir=. and Go's -trimpath make it: a path the build names
// relatively stays relative (a debugger resolves it from where it runs, the project
// root), and an absolute one (the standard library's) is split into its directory and
// name. The working directory never reaches the object, so a copy of the project built
// from its own root gives the same object, and the build cache may share it. A
// WebAssembly module's DWARF keeps absolute paths (`directory`, the working directory,
// joined): browser tools resolve them as file URLs.
fun bootstrapLlvmDebugCreateFile(builder: i64*, path: string, directory: string): i64* {
    if (directory != "" || (path.size > 0 && path[0] == 47)) {
        val parts = bootstrapLlvmDebugSplitPath(bootstrapLlvmDebugAbsolutePath(
            path, if (directory != "") directory else "/"
        ))
        return LLVMDIBuilderCreateFile(
            builder, parts[1], parts[1].size, parts[0], parts[0].size
        )
    }
    var relative = path
    while (relative.size > 2 && relative.slice(0, 2) == "./") {
        relative = relative.slice(2, relative.size)
    }
    LLVMDIBuilderCreateFile(builder, relative, relative.size, ".", 1)
}

// The module a source file names, for qualified symbols: "renderer" for
// .../renderer.ab, "exit" for .../exit/entry.ab.
fun bootstrapLlvmDebugModuleName(path: string): string {
    val parts = bootstrapLlvmDebugSplitPath(path)
    var name = parts[1]
    if (name.size > 3 && name.slice(name.size - 3, name.size) == ".ab") {
        name = name.slice(0, name.size - 3)
    }
    if (name == "entry" && parts[0] != "") {
        name = bootstrapLlvmDebugSplitPath(parts[0])[1]
    }
    name
}

fun bootstrapLlvmDebugLineStarts(source: string): array<int> {
    val starts: array<int> = [0]
    var index = 0
    while (index < source.size) {
        if (source[index] == 10) starts.append(index + 1)
        index = index + 1
    }
    starts
}

// The 1-based line holding `offset` (binary search over line starts).
fun bootstrapLlvmDebugLine(starts: array<int>, offset: int): int {
    var low = 0
    var high = starts.size - 1
    while (low < high) {
        val middle = (low + high + 1) / 2
        if (starts[middle] <= offset) low = middle else high = middle - 1
    }
    low + 1
}

fun bootstrapLlvmDebugBegin(
    backend: BootstrapLlvmBackend,
    program: BootstrapIrProgram
): BootstrapLlvmDebug {
    if (!bootstrapLlvmDebugInfo) return bootstrapLlvmDebugDisabled()
    val directory = if (bootstrapTextContains(backend.targetTriple, "wasm"))
        currentDirectory().text else ""
    val builder = LLVMCreateDIBuilder(backend.module)
    val files: array<i64*> = []
    val lineStarts: array<array<int>> = []
    val rewrites: array<BootstrapSourceRewrite> = []
    var file = 0
    while (file < bootstrapIrSourceFiles.size) {
        val path = bootstrapIrSourceFiles[file]
        files.append(bootstrapLlvmDebugCreateFile(builder, path, directory))
        val source = Path(path)
        lineStarts.append(if (source.exists())
            bootstrapLlvmDebugLineStarts(source.readText())
            else [0])
        rewrites.append(bootstrapSourceRewriteOf(bootstrapIrSourceFiles[file]))
        file = file + 1
    }
    // The unit is named after the program's entry source.
    val unitFile = bootstrapLlvmDebugCreateFile(
        builder,
        if (bootstrapLlvmDebugEntry != "") bootstrapLlvmDebugEntry else "<abla>",
        directory
    )
    var function = 0
    val producer = "ablac"
    // DW_LANG_C (the C API's enumerator 1) and line tables only (2): the
    // tables, subprograms and their names, without types or variables.
    val unit = LLVMDIBuilderCreateCompileUnit(
        builder, 1, unitFile, producer, producer.size,
        if (bootstrapLlvmDebugOptimized) 1 else 0, "", 0, 0, "", 0, 2, 0,
        0, 0, "", 0, "", 0
    )
    LLVMAddModuleFlag(
        backend.module, 1, "Debug Info Version", 18,
        LLVMValueAsMetadata(LLVMConstInt(backend.i32Type, 3, 0))
    )
    LLVMAddModuleFlag(
        backend.module, 1, "Dwarf Version", 13,
        LLVMValueAsMetadata(LLVMConstInt(backend.i32Type, 5, 0))
    )
    val subroutineType = LLVMDIBuilderCreateSubroutineType(
        builder, unitFile, nativeNullPointer(), 0, 0
    )
    val subprograms: array<i64*> = []
    val functionFiles: array<int> = []
    val functionLines: array<int> = []
    function = 0
    while (function < program.functions.size) {
        subprograms.append(nativeNullPointer())
        val position = program.functions[function].position
        val positionFile = bootstrapIrSourcePositionFile(position)
        functionFiles.append(positionFile)
        functionLines.append(
            if (positionFile >= 0 && positionFile < lineStarts.size)
                bootstrapLlvmDebugLine(
                    lineStarts[positionFile],
                    rewrites[positionFile].original(
                        bootstrapIrSourcePositionOffset(position)
                    )
                )
            else 0
        )
        function = function + 1
    }
    BootstrapLlvmDebug(
        true, builder, unit, unitFile, subroutineType, files, lineStarts,
        rewrites, subprograms, functionFiles, functionLines, [],
        nativeNullPointer(), -1, -1
    )
}

// The readable name of a lowered function, qualified by its module: the name
// its source wrote, without the prefix that keeps a private or shadowing name
// apart (the module qualifier already does).
fun bootstrapLlvmDebugFunctionName(
    function: BootstrapIrFunction,
    file: int
): string {
    val label = bootstrapSourceVisibleType(
        if (function.label != "") function.label else function.name
    )
    if (file >= 0 && file < bootstrapIrSourceFiles.size)
        "${bootstrapLlvmDebugModuleName(bootstrapIrSourceFiles[file])}.$label"
    else label
}

// Gives a lowered function's LLVM body its subprogram. Called before its
// body is emitted, outside the per-function memory checkpoint.
fun bootstrapLlvmDebugDeclareFunction(
    var debug: BootstrapLlvmDebug,
    backend: BootstrapLlvmBackend,
    function: BootstrapIrFunction,
    functionId: int,
    llvmFunction: i64*,
    linkageName: string
): void {
    if (!debug.enabled || pointerIsNull(llvmFunction)) return
    if (function.position < 0) {
        debug.undescribed.append(bootstrapLlvmDebugAddress(llvmFunction))
        return
    }
    val file = debug.functionFiles[functionId]
    val scopeFile = if (file >= 0 && file < debug.files.size)
        debug.files[file] else debug.unitFile
    val name = bootstrapLlvmDebugFunctionName(function, file)
    val line = debug.functionLines[functionId]
    // DIFlagArtificial (1 << 6) for what no declaration wrote.
    val subprogram = LLVMDIBuilderCreateFunction(
        debug.builder, scopeFile, name, name.size, linkageName,
        linkageName.size, scopeFile, i32(line), debug.subroutineType, 1, 1, i32(line),
        if (file >= 0) 0 else 64,
        if (bootstrapLlvmDebugOptimized) 1 else 0
    )
    LLVMSetSubprogram(llvmFunction, subprogram)
    debug.subprograms[functionId] = subprogram
    return
}

// Points the builder at an instruction's source position (inside function
// `functionId`). Positions in another file than the function's keep the
// previous location.
fun bootstrapLlvmDebugLocate(
    var debug: BootstrapLlvmDebug,
    backend: BootstrapLlvmBackend,
    functionId: int,
    position: int
): void {
    if (!debug.enabled) return
    val subprogram = debug.subprograms[functionId]
    if (pointerIsNull(subprogram)) return
    val file = debug.functionFiles[functionId]
    var line = debug.currentLine
    var column = debug.currentColumn
    if (!bootstrapLlvmDebugSame(debug.currentScope, subprogram)) {
        line = debug.functionLines[functionId]
        column = 0
    }
    if (position >= 0 && file >= 0 &&
        bootstrapIrSourcePositionFile(position) == file) {
        val starts = debug.lineStarts[file]
        val offset = debug.rewrites[file].original(
            bootstrapIrSourcePositionOffset(position)
        )
        if (starts.size > 1 || offset == 0) {
            line = bootstrapLlvmDebugLine(starts, offset)
            column = offset - starts[line - 1] + 1
        }
    }
    if (!bootstrapLlvmDebugSame(debug.currentScope, subprogram) ||
        line != debug.currentLine || column != debug.currentColumn) {
        LLVMSetCurrentDebugLocation2(
            backend.builder,
            LLVMDIBuilderCreateDebugLocation(
                backend.context, i32(line), i32(column), subprogram,
                nativeNullPointer()
            )
        )
        debug.currentScope = subprogram
        debug.currentLine = line
        debug.currentColumn = column
    }
    return
}

// Clears the builder's location (after a function body).
fun bootstrapLlvmDebugClear(
    var debug: BootstrapLlvmDebug,
    backend: BootstrapLlvmBackend
): void {
    if (!debug.enabled) return
    LLVMSetCurrentDebugLocation2(backend.builder, nativeNullPointer())
    debug.currentScope = nativeNullPointer()
    debug.currentLine = -1
    debug.currentColumn = -1
    return
}

trusted fun bootstrapLlvmDebugValueName(value: i64*): string {
    val length = nativeByteBuffer(8)
    val name = LLVMGetValueName2(value, length.pointerAt(0))
    val size = length.loadI64(0)
    length.close()
    var result = ""
    if (!pointerIsNull(name) && size > 0) {
        val copy = nativeByteBuffer(size + 1)
        var index = 0
        while (index < size) {
            copy.store(index, ablaUnsafeLoadU8(
                ablaUnsafePointerOffset(name, index)
            ))
            index = index + 1
        }
        copy.store(size, 0)
        result = copy.adoptString(size)
    }
    result
}

// Completes the module's debug information once every body is emitted:
// gives each remaining defined function an artificial subprogram, puts every
// instruction in its own function's scope (LLVM requires a location on each
// inlinable call of a function with debug information), renames emitted
// Abla functions after their declarations and, on native targets, keeps
// frame pointers.
fun bootstrapLlvmDebugFinish(
    debug: BootstrapLlvmDebug,
    backend: BootstrapLlvmBackend,
    program: BootstrapIrProgram,
    identities: BootstrapLlvmFunctionIdentities,
    emittedFunctions: array<bool>
): void {
    if (!debug.enabled) return
    LLVMSetCurrentDebugLocation2(backend.builder, nativeNullPointer())
    val wasm = bootstrapTextContains(backend.targetTriple, "wasm")
    val optimized: i32 = if (bootstrapLlvmDebugOptimized) 1 else 0
    var function = LLVMGetFirstFunction(backend.module)
    while (!pointerIsNull(function)) {
        var undescribed = false
        for (address in debug.undescribed) {
            if (address == bootstrapLlvmDebugAddress(function)) undescribed = true
        }
        if (undescribed) {
            var block = LLVMGetFirstBasicBlock(function)
            while (!pointerIsNull(block)) {
                var instruction = LLVMGetFirstInstruction(block)
                while (!pointerIsNull(instruction)) {
                    if (!pointerIsNull(LLVMInstructionGetDebugLoc(instruction))) {
                        LLVMInstructionSetDebugLoc(
                            instruction, nativeNullPointer()
                        )
                    }
                    instruction = LLVMGetNextInstruction(instruction)
                }
                block = LLVMGetNextBasicBlock(block)
            }
            if (!wasm) bootstrapLlvmAddStringFunctionAttribute(
                backend, function, "frame-pointer", "all"
            )
        } else if (LLVMIsDeclaration(function) == 0) {
            var subprogram = LLVMGetSubprogram(function)
            var line = 0
            if (pointerIsNull(subprogram)) {
                val name = bootstrapLlvmDebugValueName(function)
                subprogram = LLVMDIBuilderCreateFunction(
                    debug.builder, debug.unitFile, name, name.size, name,
                    name.size, debug.unitFile, 0, debug.subroutineType,
                    if (LLVMGetLinkage(function) == llvmExternalLinkage())
                        0 else 1,
                    1, 0, 64, optimized
                )
                LLVMSetSubprogram(function, subprogram)
            }
            val fallback = LLVMDIBuilderCreateDebugLocation(
                backend.context, 0, 0, subprogram, nativeNullPointer()
            )
            var block = LLVMGetFirstBasicBlock(function)
            while (!pointerIsNull(block)) {
                var instruction = LLVMGetFirstInstruction(block)
                while (!pointerIsNull(instruction)) {
                    val location = LLVMInstructionGetDebugLoc(instruction)
                    if (pointerIsNull(location) || !bootstrapLlvmDebugSame(
                        LLVMDILocationGetScope(location), subprogram
                    )) LLVMInstructionSetDebugLoc(instruction, fallback)
                    instruction = LLVMGetNextInstruction(instruction)
                }
                block = LLVMGetNextBasicBlock(block)
            }
            if (!wasm) bootstrapLlvmAddStringFunctionAttribute(
                backend, function, "frame-pointer", "all"
            )
        }
        function = LLVMGetNextFunction(function)
    }
    // Readable symbols: the module-qualified Abla name on the body, and with
    // a ".boxed" suffix on its value-ABI wrapper. Only internal definitions
    // are renamed; LLVM makes repeated names unique.
    var index = 0
    while (index < program.functions.size) {
        if (index < emittedFunctions.size && emittedFunctions[index]) {
            val name = bootstrapLlvmDebugFunctionName(
                program.functions[index], debug.functionFiles[index]
            )
            val direct = LLVMGetNamedFunction(
                backend.module,
                "${identities.symbols[index]}_direct"
            )
            if (!pointerIsNull(direct) && LLVMIsDeclaration(direct) == 0 &&
                LLVMGetLinkage(direct) == llvmInternalLinkage()) {
                LLVMSetValueName2(direct, name, name.size)
            }
            val wrapper = LLVMGetNamedFunction(
                backend.module, identities.symbols[index]
            )
            if (!pointerIsNull(wrapper) && LLVMIsDeclaration(wrapper) == 0 &&
                LLVMGetLinkage(wrapper) == llvmInternalLinkage()) {
                val boxed = "$name.boxed"
                LLVMSetValueName2(wrapper, boxed, boxed.size)
            }
        }
        index = index + 1
    }
    LLVMDIBuilderFinalize(debug.builder)
    LLVMDisposeDIBuilder(debug.builder)
}

// --- stacks at run time -----------------------------------------------------
// A debug build of a hosted executable prints the stack when it dies: Abla's
// `panic` calls abla_runtime_print_stack, and fault signals (a trap, a bad
// access, an abort) run abla_runtime_fault, which prints it and lets the
// signal take its default course (the exit status and the system's crash
// report stay as they were). The frames are named by the symbol table; lldb or
// atos map them to file:line through the debug information. Other builds keep
// abla_runtime_print_stack as an empty function, so code can always call it.

fun bootstrapLlvmDebugHostedRuntime(backend: BootstrapLlvmBackend): bool =
    bootstrapLlvmDebugInfo &&
    !bootstrapTextContains(backend.targetTriple, "wasm") &&
    (backend.macOS || bootstrapTextContains(backend.targetTriple, "linux"))

// SIGILL, SIGTRAP, SIGABRT, SIGFPE, SIGBUS, SIGSEGV.
fun bootstrapLlvmDebugFaultSignals(backend: BootstrapLlvmBackend): array<int> =
    if (backend.macOS) [4, 5, 6, 8, 10, 11] else [4, 5, 6, 8, 7, 11]

// The address of element `index` (a value) of a pointer array.
fun bootstrapLlvmDebugPointerElement(
    backend: BootstrapLlvmBackend,
    pointers: i64*,
    index: i64*
): i64* {
    val indices = llvmPointerVector(1)
    indices.set(0, index)
    val element = LLVMBuildGEP2(
        backend.builder, backend.pointerType, pointers, indices.pointer(), 1,
        ""
    )
    indices.drop()
    element
}

fun bootstrapLlvmDebugCall(
    backend: BootstrapLlvmBackend,
    name: string,
    result: i64*,
    parameters: array<i64*>,
    arguments: array<i64*>
): i64* = bootstrapLlvmCall(
    backend,
    bootstrapLlvmDeclare(backend, name, result, parameters, false, []),
    arguments, "", false, []
)

// In the C `main` of a debug build, before any Abla code runs: route the
// fault signals to abla_runtime_fault (defined at the end of the module).
fun bootstrapLlvmDebugInstallFaultHandlers(
    backend: BootstrapLlvmBackend
): void {
    if (!bootstrapLlvmDebugHostedRuntime(backend)) return
    val fault = bootstrapLlvmDeclare(
        backend, "abla_runtime_fault", backend.voidType, [backend.i64Type],
        false, []
    )
    LLVMSetLinkage(fault, llvmInternalLinkage())
    if (bootstrapLlvmStackGuardKernel(backend)) {
        // signal()'s BSD semantics by rt_sigaction: SA_RESTART | SA_RESTORER.
        val action = bootstrapLlvmStackGuardKernelAction(
            backend, fault, 335544320, bootstrapLlvmSigreturnRestorer(backend), "fault.action"
        )
        for (signal in bootstrapLlvmDebugFaultSignals(backend)) {
            bootstrapLlvmStackGuardKernelSigaction(
                backend, LLVMConstInt(backend.i64Type, signal, 0), action
            )
        }
        return
    }
    for (signal in bootstrapLlvmDebugFaultSignals(backend)) {
        bootstrapLlvmDebugCall(
            backend, "signal", backend.pointerType,
            [backend.i64Type, backend.pointerType],
            [LLVMConstInt(backend.i64Type, signal, 0), fault]
        )
    }
    return
}

// --- stack overflow ---------------------------------------------------------
// A hosted executable (macOS or Linux, with libc) turns a stack overflow into
// a panic: "panic: stack overflow" on standard error (and the stack in a debug
// build), exit status 101. Main records its frame address and installs a
// SIGSEGV/SIGBUS handler that runs on an alternate signal stack (a static
// buffer), since the overflowed stack has no room left for it. The handler
// calls a fault an overflow when its address lies at the far end of the stack:
// below the thread's stack base (macOS), or of RLIMIT_STACK below main's frame
// (Linux). Any other fault keeps its course (the debug fault report, else the
// default action). Nothing runs on the normal path. The toolchain sets
// bootstrapLlvmStackGuard for hosted, non-Wasm targets.

var bootstrapLlvmStackGuard: bool = false

// Emit the program's own entry and thread block routines (exports.ab, #806): set
// by the toolchain for every hosted x86-64 Linux executable.
var bootstrapLlvmFreestandingStart: bool = false

// Set by the toolchain for an executable of the cross target aarch64-linux (#811): its own
// start-up, system call translator and routines. Objects another build defines for an
// AArch64 Linux triple keep libc's.
var bootstrapLlvmAarch64Hosted: bool = false

// Calls C function `name` with the given signature, declaring it if the module
// doesn't have it yet. The call carries its own type, so a declaration the
// program made with other integer widths (`extern:"c" fun raise(signal: int)`)
// doesn't clash.
fun bootstrapLlvmStackGuardCall(
    backend: BootstrapLlvmBackend,
    name: string,
    result: i64*,
    parameters: array<i64*>,
    arguments: array<i64*>
): i64* {
    var function = LLVMGetNamedFunction(backend.module, name)
    if (pointerIsNull(function)) {
        function = bootstrapLlvmDeclare(
            backend, name, result, parameters, false, []
        )
    }
    bootstrapLlvmCallTyped(
        backend, bootstrapLlvmFunctionType(backend, result, parameters),
        function, arguments, ""
    )
}

fun bootstrapLlvmStackGuardRuntime(backend: BootstrapLlvmBackend): bool =
    bootstrapLlvmStackGuard &&
    !bootstrapTextContains(backend.targetTriple, "wasm") &&
    (backend.macOS || bootstrapTextContains(backend.targetTriple, "linux"))

fun bootstrapLlvmSignalStackBytes(): int = 65536

// x86-64 Linux (not x32): the stack guard talks to the kernel directly, with
// sigaltstack and rt_sigaction (#806), so it needs neither libc's sigaction
// nor its restorer.
fun bootstrapLlvmStackGuardKernel(backend: BootstrapLlvmBackend): bool =
    !backend.macOS &&
    ((bootstrapTextContains(backend.targetTriple, "x86_64") &&
      bootstrapTextContains(backend.targetTriple, "linux") &&
      !bootstrapTextContains(backend.targetTriple, "gnux32")) ||
     bootstrapLlvmAarch64LinuxExecutable(backend))

// The kernel's struct sigaction on x86-64: handler, flags (SA_SIGINFO |
// SA_ONSTACK | SA_RESTORER), restorer, and an 8-byte signal mask.
fun bootstrapLlvmStackGuardKernelAction(
    backend: BootstrapLlvmBackend,
    handler: i64*,
    flags: int,
    restorer: i64*,
    name: string
): i64* {
    val actionType = LLVMArrayType2(backend.i8Type, 32)
    val action = LLVMBuildAlloca(backend.builder, actionType, name)
    LLVMBuildStore(backend.builder, LLVMConstNull(actionType), action)
    LLVMBuildStore(backend.builder, handler, action)
    LLVMBuildStore(
        backend.builder, LLVMConstInt(backend.i64Type, flags, 0),
        bootstrapLlvmByteAt(backend, action, 32, 8)
    )
    // (AArch64's kernel struct has the same fields; its restorer is ignored and null here.)
    LLVMBuildStore(
        backend.builder, restorer, bootstrapLlvmByteAt(backend, action, 32, 16)
    )
    action
}

// The rt_sigreturn trampoline an x86-64 Linux signal handler returns through
// (the kernel's SA_RESTORER), declared on first use.
fun bootstrapLlvmSigreturnRestorer(backend: BootstrapLlvmBackend): i64* {
    if (bootstrapLlvmAarch64LinuxExecutable(backend)) {
        return LLVMConstNull(backend.pointerType)
    }
    var restorer = LLVMGetNamedFunction(backend.module, "abla_runtime_sigreturn")
    if (pointerIsNull(restorer)) {
        restorer = bootstrapLlvmDeclare(
            backend, "abla_runtime_sigreturn", backend.voidType, [], false, []
        )
        LLVMSetLinkage(restorer, llvmInternalLinkage())
    }
    restorer
}

// Defines the trampoline when something took its address: no frame, just
// rt_sigreturn (15).
fun bootstrapLlvmEmitSigreturnRestorer(backend: BootstrapLlvmBackend): void {
    val restorer = LLVMGetNamedFunction(backend.module, "abla_runtime_sigreturn")
    if (pointerIsNull(restorer) || LLVMIsDeclaration(restorer) == 0) return
    LLVMPositionBuilderAtEnd(
        backend.builder,
        LLVMAppendBasicBlockInContext(backend.context, restorer, "entry")
    )
    bootstrapLlvmAddFunctionAttribute(backend, restorer, "naked")
    bootstrapLlvmAddFunctionAttribute(backend, restorer, "noinline")
    bootstrapLlvmAddFunctionAttribute(backend, restorer, "nounwind")
    val restorerType = bootstrapLlvmFunctionType(backend, backend.voidType, [])
    val trampoline = "movq $$15, %rax\n\tsyscall"
    bootstrapLlvmCallTyped(
        backend, restorerType,
        LLVMGetInlineAsm(restorerType, trampoline, trampoline.size, "", 0, 1, 0, 0, 0),
        [], ""
    )
    LLVMBuildUnreachable(backend.builder)
    return
}

// write(descriptor, text, size) on standard error or another descriptor: the
// system call on x86-64 Linux, libc's write elsewhere.
fun bootstrapLlvmRuntimeWrite(
    backend: BootstrapLlvmBackend,
    descriptor: int,
    text: i64*,
    size: i64*
): void {
    val fd = LLVMConstInt(backend.i64Type, descriptor, 0)
    if (bootstrapLlvmStackGuardKernel(backend)) {
        bootstrapLlvmLinuxX64Syscall(backend, 1, [fd, text, size])
    } else {
        bootstrapLlvmDebugCall(
            backend, "write", backend.i64Type,
            [backend.i64Type, backend.pointerType, backend.i64Type],
            [fd, text, size]
        )
    }
    return
}

// rt_sigaction(signal, action, NULL, sizeof the kernel's signal mask).
fun bootstrapLlvmStackGuardKernelSigaction(
    backend: BootstrapLlvmBackend,
    signal: i64*,
    action: i64*
): void {
    val zero = LLVMConstInt(backend.i64Type, 0, 0)
    bootstrapLlvmLinuxX64Syscall(
        backend, 13, [signal, action, zero, LLVMConstInt(backend.i64Type, 8, 0)]
    )
    return
}

// The address `offset` bytes into a byte buffer of `bytes` bytes.
fun bootstrapLlvmByteAt(
    backend: BootstrapLlvmBackend,
    buffer: i64*,
    bytes: int,
    offset: int
): i64* = bootstrapLlvmArrayElement(
    backend, LLVMArrayType2(backend.i8Type, bytes), buffer, offset, ""
)

fun bootstrapLlvmStackGuardGlobal(
    backend: BootstrapLlvmBackend,
    name: string,
    type: i64*
): i64* {
    var global = LLVMGetNamedGlobal(backend.module, name)
    if (pointerIsNull(global)) {
        global = LLVMAddGlobal(backend.module, type, name)
        LLVMSetInitializer(global, LLVMConstNull(type))
        LLVMSetLinkage(global, llvmInternalLinkage())
        LLVMSetAlignment(global, 16)
    }
    global
}

// In the C `main`, before any Abla code runs: record the stack top, give the
// thread an alternate signal stack and route SIGSEGV and SIGBUS to
// abla_runtime_stack_fault (defined after every other body).
fun bootstrapLlvmInstallStackGuard(backend: BootstrapLlvmBackend): void {
    if (!bootstrapLlvmStackGuardRuntime(backend)) return
    val mac = backend.macOS
    val top = bootstrapLlvmStackGuardGlobal(
        backend, "abla_runtime_stack_top", backend.i64Type
    )
    val frame = bootstrapLlvmStackGuardCall(
        backend, "llvm.frameaddress.p0", backend.pointerType,
        [backend.i32Type], [LLVMConstInt(backend.i32Type, 0, 0)]
    )
    LLVMBuildStore(
        backend.builder,
        LLVMBuildPtrToInt(backend.builder, frame, backend.i64Type, ""),
        top
    )
    // stack_t: macOS {sp, size, flags}, Linux {sp, flags, size}.
    val signalStack = bootstrapLlvmStackGuardGlobal(
        backend, "abla_runtime_signal_stack",
        LLVMArrayType2(backend.i8Type, bootstrapLlvmSignalStackBytes())
    )
    val stackType = LLVMArrayType2(backend.i8Type, 32)
    val stack = LLVMBuildAlloca(backend.builder, stackType, "signal.stack")
    LLVMBuildStore(
        backend.builder, LLVMConstNull(stackType), stack
    )
    LLVMBuildStore(backend.builder, signalStack, stack)
    LLVMBuildStore(
        backend.builder,
        LLVMConstInt(backend.i64Type, bootstrapLlvmSignalStackBytes(), 0),
        bootstrapLlvmByteAt(backend, stack, 32, if (mac) 8 else 16)
    )
    val kernel = bootstrapLlvmStackGuardKernel(backend)
    if (kernel) {
        bootstrapLlvmLinuxX64Syscall(
            backend, 131, [stack, LLVMConstInt(backend.i64Type, 0, 0)]
        )
    } else {
        bootstrapLlvmStackGuardCall(
            backend, "sigaltstack", backend.i32Type,
            [backend.pointerType, backend.pointerType],
            [stack, LLVMConstNull(backend.pointerType)]
        )
    }
    // struct sigaction: the handler first; sa_flags at 12 (macOS) or 136
    // (Linux, after a 128-byte mask). SA_SIGINFO | SA_ONSTACK.
    val actionType = LLVMArrayType2(backend.i8Type, 160)
    val action = LLVMBuildAlloca(backend.builder, actionType, "signal.action")
    LLVMBuildStore(backend.builder, LLVMConstNull(actionType), action)
    val handler = bootstrapLlvmDeclare(
        backend, "abla_runtime_stack_fault", backend.voidType,
        [backend.i32Type, backend.pointerType, backend.pointerType],
        false, []
    )
    LLVMSetLinkage(handler, llvmInternalLinkage())
    if (bootstrapLlvmCompactLinuxRuntime(backend)) {
        bootstrapLlvmAddFunctionAttribute(backend, handler, "optsize")
        bootstrapLlvmAddFunctionAttribute(backend, handler, "minsize")
    }
    if (kernel) {
        // SA_SIGINFO (4) | SA_ONSTACK (0x08000000) | SA_RESTORER (0x04000000):
        // the handler returns through abla_runtime_sigreturn, rt_sigreturn.
        val restorer = bootstrapLlvmSigreturnRestorer(backend)
        val kernelAction = bootstrapLlvmStackGuardKernelAction(
            backend, handler,
            if (bootstrapLlvmAarch64LinuxExecutable(backend)) 134217732 else 201326596,
            restorer, "signal.kernel.action"
        )
        for (signal in [11, 7]) {
            bootstrapLlvmStackGuardKernelSigaction(
                backend, LLVMConstInt(backend.i64Type, signal, 0), kernelAction
            )
        }
        return
    }
    LLVMBuildStore(backend.builder, handler, action)
    LLVMBuildStore(
        backend.builder,
        LLVMConstInt(backend.i32Type, if (mac) 65 else 134217732, 0),
        bootstrapLlvmByteAt(backend, action, 160, if (mac) 12 else 136)
    )
    for (signal in [11, if (mac) 10 else 7]) {
        bootstrapLlvmStackGuardCall(
            backend, "sigaction", backend.i32Type,
            [backend.i32Type, backend.pointerType, backend.pointerType],
            [LLVMConstInt(backend.i32Type, signal, 0), action,
             LLVMConstNull(backend.pointerType)]
        )
    }
    return
}

// abla_runtime_stack_fault(signal, siginfo, context), when main installed it.
fun bootstrapLlvmEmitStackGuardHandler(backend: BootstrapLlvmBackend): void {
    val handler = LLVMGetNamedFunction(
        backend.module, "abla_runtime_stack_fault"
    )
    if (pointerIsNull(handler) || LLVMIsDeclaration(handler) == 0) return
    bootstrapLlvmEmitSigreturnRestorer(backend)
    val mac = backend.macOS
    val i64 = backend.i64Type
    LLVMPositionBuilderAtEnd(
        backend.builder,
        LLVMAppendBasicBlockInContext(backend.context, handler, "entry")
    )
    // si_addr: offset 24 on macOS, 16 on Linux.
    val info = LLVMGetParam(handler, 1)
    val address = LLVMBuildPtrToInt(
        backend.builder,
        LLVMBuildLoad2(
            backend.builder, backend.pointerType,
            bootstrapLlvmByteAt(backend, info, 32, if (mac) 24 else 16),
            "fault.address"
        ),
        i64, ""
    )
    var low = nativeNullPointer()
    var window = 0
    if (mac) {
        val currentThread = bootstrapLlvmStackGuardCall(
            backend, "pthread_self", backend.pointerType, [], []
        )
        val base = bootstrapLlvmStackGuardCall(
            backend, "pthread_get_stackaddr_np", backend.pointerType,
            [backend.pointerType], [currentThread]
        )
        val size = bootstrapLlvmStackGuardCall(
            backend, "pthread_get_stacksize_np", i64,
            [backend.pointerType], [currentThread]
        )
        low = LLVMBuildSub(
            backend.builder,
            LLVMBuildPtrToInt(backend.builder, base, i64, ""), size, ""
        )
        window = 1048576
    } else {
        // RLIMIT_STACK (3) below main's frame; an unlimited stack (all
        // ones) counts as 64 GiB.
        val limitType = LLVMArrayType2(backend.i8Type, 16)
        val limit = LLVMBuildAlloca(backend.builder, limitType, "stack.limit")
        if (bootstrapLlvmStackGuardKernel(backend)) {
            // prlimit64(0, RLIMIT_STACK, NULL, &limit), the operation libc's
            // getrlimit uses on modern Linux; its two limits are 64-bit.
            bootstrapLlvmLinuxX64Syscall(backend, 302, [
                LLVMConstInt(i64, 0, 0), LLVMConstInt(i64, 3, 0),
                LLVMConstInt(i64, 0, 0), limit
            ])
        } else {
            bootstrapLlvmStackGuardCall(
                backend, "getrlimit", backend.i32Type,
                [backend.i32Type, backend.pointerType],
                [LLVMConstInt(backend.i32Type, 3, 0), limit]
            )
        }
        val current = LLVMBuildLoad2(backend.builder, i64, limit, "")
        val size = LLVMBuildSelect(
            backend.builder,
            LLVMBuildICmp(
                backend.builder, llvmIntEqual(), current,
                LLVMConstInt(i64, -1, 1), ""
            ),
            LLVMConstInt(i64, 68719476736, 0), current, ""
        )
        low = LLVMBuildSub(
            backend.builder,
            LLVMBuildLoad2(
                backend.builder, i64,
                LLVMGetNamedGlobal(backend.module, "abla_runtime_stack_top"),
                ""
            ),
            size, ""
        )
        // main's frame sits below the environment and arguments.
        window = 2097152
    }
    // low - window <= address < low + window (unsigned: address - (low -
    // window) < 2 * window).
    val overflow = LLVMBuildICmp(
        backend.builder, llvmIntUnsignedLessThan(),
        LLVMBuildSub(
            backend.builder, address,
            LLVMBuildSub(backend.builder, low, LLVMConstInt(i64, window, 0), ""),
            ""
        ),
        LLVMConstInt(i64, 2 * window, 0), "stack.overflow"
    )
    val overflowed = LLVMAppendBasicBlockInContext(
        backend.context, handler, "overflow"
    )
    val other = LLVMAppendBasicBlockInContext(
        backend.context, handler, "other"
    )
    LLVMBuildCondBr(backend.builder, overflow, overflowed, other)
    LLVMPositionBuilderAtEnd(backend.builder, overflowed)
    val message = "panic: stack overflow\n"
    val messageArguments = [LLVMConstInt(i64, 2, 0),
        bootstrapLlvmGlobalStringPointer(backend, message, "abla.stack.overflow"),
        LLVMConstInt(i64, message.size, 0)]
    bootstrapLlvmRuntimeWrite(backend, 2, messageArguments[1], messageArguments[2])
    if (bootstrapLlvmDebugHostedRuntime(backend)) {
        bootstrapLlvmStackGuardCall(
            backend, "abla_runtime_print_stack", backend.voidType, [], []
        )
    }
    if (bootstrapLlvmStackGuardKernel(backend)) {
        // exit_group, as libc _exit: terminate the entire process, not just
        // the thread handling the fault.
        bootstrapLlvmLinuxX64Syscall(backend, 231, [LLVMConstInt(i64, 101, 0)])
    } else {
        bootstrapLlvmStackGuardCall(
            backend, "_exit", backend.voidType, [backend.i64Type],
            [LLVMConstInt(backend.i64Type, 101, 0)]
        )
    }
    LLVMBuildUnreachable(backend.builder)
    LLVMPositionBuilderAtEnd(backend.builder, other)
    val signal = LLVMBuildZExt(
        backend.builder, LLVMGetParam(handler, 0), i64, ""
    )
    if (bootstrapLlvmDebugHostedRuntime(backend)) {
        // The debug report, which restores the default action.
        val fault = bootstrapLlvmDeclare(
            backend, "abla_runtime_fault", backend.voidType, [i64], false, []
        )
        LLVMSetLinkage(fault, llvmInternalLinkage())
        bootstrapLlvmCall(backend, fault, [signal], "", false, [])
    } else if (bootstrapLlvmStackGuardKernel(backend)) {
        // Restore SIG_DFL: rt_sigaction with an all-zero kernel struct.
        val defaultType = LLVMArrayType2(backend.i8Type, 32)
        val action = LLVMBuildAlloca(backend.builder, defaultType, "signal.default")
        LLVMBuildStore(backend.builder, LLVMConstNull(defaultType), action)
        bootstrapLlvmStackGuardKernelSigaction(backend, signal, action)
    } else {
        bootstrapLlvmStackGuardCall(
            backend, "signal", backend.pointerType,
            [i64, backend.pointerType],
            [signal, LLVMConstNull(backend.pointerType)]
        )
    }
    // Back to the default action: the signal raised again (delivered once
    // the handler returns) or the faulting instruction run again ends the
    // process as before.
    if (bootstrapLlvmStackGuardKernel(backend)) {
        val process = bootstrapLlvmLinuxX64Syscall(backend, 39, [])
        val threadId = bootstrapLlvmLinuxX64Syscall(backend, 186, [])
        bootstrapLlvmLinuxX64Syscall(backend, 234, [process, threadId, signal])
    } else {
        bootstrapLlvmStackGuardCall(
            backend, "raise", backend.i32Type, [backend.i32Type],
            [LLVMGetParam(handler, 0)]
        )
    }
    LLVMBuildRetVoid(backend.builder)
    return
}

fun bootstrapLlvmDebugWrite(
    backend: BootstrapLlvmBackend,
    text: string,
    name: string
): void {
    bootstrapLlvmRuntimeWrite(
        backend, 2, bootstrapLlvmGlobalStringPointer(backend, text, name),
        LLVMConstInt(backend.i64Type, text.size, 0)
    )
    return
}

// Writes `value` to standard error as 0x and sixteen hexadecimal digits.
fun bootstrapLlvmDebugWriteHex(
    backend: BootstrapLlvmBackend,
    value: i64*
): void {
    val bufferType = LLVMArrayType2(backend.i8Type, 18)
    val buffer = LLVMBuildAlloca(backend.builder, bufferType, "hex")
    var digit = 0
    while (digit < 18) {
        val byte = if (digit == 0) LLVMConstInt(backend.i8Type, 48, 0)
        else if (digit == 1) LLVMConstInt(backend.i8Type, 120, 0)
        else {
            val shift = 60 - 4 * (digit - 2)
            val nibble = LLVMBuildTrunc(
                backend.builder,
                LLVMBuildAnd(
                    backend.builder,
                    LLVMBuildLShr(
                        backend.builder, value,
                        LLVMConstInt(backend.i64Type, shift, 0), ""
                    ),
                    LLVMConstInt(backend.i64Type, 15, 0), ""
                ),
                backend.i8Type, ""
            )
            // ULT (36): a digit below ten is '0' + n, else 'a' + n - 10.
            LLVMBuildSelect(
                backend.builder,
                LLVMBuildICmp(
                    backend.builder, 36, nibble,
                    LLVMConstInt(backend.i8Type, 10, 0), ""
                ),
                LLVMBuildAdd(
                    backend.builder, nibble,
                    LLVMConstInt(backend.i8Type, 48, 0), ""
                ),
                LLVMBuildAdd(
                    backend.builder, nibble,
                    LLVMConstInt(backend.i8Type, 87, 0), ""
                ),
                ""
            )
        }
        LLVMBuildStore(
            backend.builder, byte,
            bootstrapLlvmArrayElement(backend, bufferType, buffer, digit, "")
        )
        digit = digit + 1
    }
    bootstrapLlvmRuntimeWrite(
        backend, 2, buffer, LLVMConstInt(backend.i64Type, 18, 0)
    )
    return
}

// The stack on x86-64 Linux without libc's backtrace: walk the frame-pointer
// chain (a debug build keeps it in every function) and print each return
// address, less one so it falls inside the call, as 0x and sixteen hex digits,
// then the executable's load address (__ehdr_start) for a position-independent
// executable. Every frame is read with process_vm_readv on this process, which
// fails with EFAULT instead of faulting where the chain ends or is not a chain
// (a signal interrupted code without frame pointers), and the walk stops at 64
// frames, a null or misaligned frame, or one that does not move up the stack.
fun bootstrapLlvmEmitFramePointerWalk(
    backend: BootstrapLlvmBackend,
    printStack: i64*
): void {
    val i64 = backend.i64Type
    bootstrapLlvmDebugWrite(
        backend,
        "stack (return addresses: subtract the load address, then addr2line or gdb on the program gives file:line):\n",
        "abla.stack.header"
    )
    val frame = bootstrapLlvmStackGuardCall(
        backend, "llvm.frameaddress.p0", backend.pointerType,
        [backend.i32Type], [LLVMConstInt(backend.i32Type, 0, 0)]
    )
    val cursor = LLVMBuildAlloca(backend.builder, i64, "fp")
    LLVMBuildStore(
        backend.builder, LLVMBuildPtrToInt(backend.builder, frame, i64, ""), cursor
    )
    val counter = LLVMBuildAlloca(backend.builder, i64, "n")
    LLVMBuildStore(backend.builder, LLVMConstInt(i64, 0, 0), counter)
    val record = LLVMBuildAlloca(backend.builder, LLVMArrayType2(backend.i8Type, 16), "record")
    val iov = LLVMBuildAlloca(backend.builder, LLVMArrayType2(backend.i8Type, 32), "iov")
    val process = bootstrapLlvmLinuxX64Syscall(backend, 39, [])
    val loop = LLVMAppendBasicBlockInContext(backend.context, printStack, "walk")
    val read = LLVMAppendBasicBlockInContext(backend.context, printStack, "read")
    val take = LLVMAppendBasicBlockInContext(backend.context, printStack, "take")
    val show = LLVMAppendBasicBlockInContext(backend.context, printStack, "show")
    val done = LLVMAppendBasicBlockInContext(backend.context, printStack, "walked")
    LLVMBuildBr(backend.builder, loop)
    LLVMPositionBuilderAtEnd(backend.builder, loop)
    val count = LLVMBuildLoad2(backend.builder, i64, counter, "")
    val current = LLVMBuildLoad2(backend.builder, i64, cursor, "")
    // ULT (36), NE (33), EQ (32).
    val inRange = LLVMBuildICmp(
        backend.builder, 36, count, LLVMConstInt(i64, 64, 0), ""
    )
    val present = LLVMBuildICmp(backend.builder, 33, current, LLVMConstInt(i64, 0, 0), "")
    val aligned = LLVMBuildICmp(
        backend.builder, 32,
        LLVMBuildAnd(backend.builder, current, LLVMConstInt(i64, 7, 0), ""),
        LLVMConstInt(i64, 0, 0), ""
    )
    LLVMBuildCondBr(
        backend.builder,
        LLVMBuildAnd(
            backend.builder, LLVMBuildAnd(backend.builder, inRange, present, ""), aligned, ""
        ),
        read, done
    )
    LLVMPositionBuilderAtEnd(backend.builder, read)
    // process_vm_readv(pid, &local, 1, &remote, 1, 0): the 16 bytes at the frame
    // (saved frame pointer, return address) into `record`.
    LLVMBuildStore(backend.builder, record, iov)
    LLVMBuildStore(
        backend.builder, LLVMConstInt(i64, 16, 0), bootstrapLlvmByteAt(backend, iov, 32, 8)
    )
    LLVMBuildStore(backend.builder, current, bootstrapLlvmByteAt(backend, iov, 32, 16))
    LLVMBuildStore(
        backend.builder, LLVMConstInt(i64, 16, 0), bootstrapLlvmByteAt(backend, iov, 32, 24)
    )
    val got = bootstrapLlvmLinuxX64Syscall(backend, 310, [
        process, iov, LLVMConstInt(i64, 1, 0),
        bootstrapLlvmByteAt(backend, iov, 32, 16), LLVMConstInt(i64, 1, 0),
        LLVMConstInt(i64, 0, 0)
    ])
    LLVMBuildCondBr(
        backend.builder,
        LLVMBuildICmp(backend.builder, 32, got, LLVMConstInt(i64, 16, 0), ""),
        take, done
    )
    LLVMPositionBuilderAtEnd(backend.builder, take)
    val next = LLVMBuildLoad2(backend.builder, i64, record, "")
    val returnAddress = LLVMBuildLoad2(
        backend.builder, i64, bootstrapLlvmByteAt(backend, record, 16, 8), ""
    )
    LLVMBuildCondBr(
        backend.builder,
        LLVMBuildICmp(backend.builder, 33, returnAddress, LLVMConstInt(i64, 0, 0), ""),
        show, done
    )
    LLVMPositionBuilderAtEnd(backend.builder, show)
    bootstrapLlvmDebugWriteHex(
        backend, LLVMBuildSub(backend.builder, returnAddress, LLVMConstInt(i64, 1, 0), "")
    )
    bootstrapLlvmDebugWrite(backend, "\n", "abla.stack.end")
    LLVMBuildStore(
        backend.builder, LLVMBuildAdd(backend.builder, count, LLVMConstInt(i64, 1, 0), ""),
        counter
    )
    LLVMBuildStore(backend.builder, next, cursor)
    // Keep going only while the chain moves up (ULE (37): next <= current stops).
    LLVMBuildCondBr(
        backend.builder, LLVMBuildICmp(backend.builder, 37, next, current, ""), done, loop
    )
    LLVMPositionBuilderAtEnd(backend.builder, done)
    bootstrapLlvmDebugWrite(backend, "load address ", "abla.stack.load")
    var base = LLVMGetNamedGlobal(backend.module, "__ehdr_start")
    if (pointerIsNull(base)) base = LLVMAddGlobal(backend.module, backend.i8Type, "__ehdr_start")
    bootstrapLlvmDebugWriteHex(backend, LLVMBuildPtrToInt(backend.builder, base, i64, ""))
    bootstrapLlvmDebugWrite(backend, "\n", "abla.stack.end")
    return
}

// Defines abla_runtime_print_stack (when the program calls it or a debug
// build needs it) and, in a debug build of a hosted executable,
// abla_runtime_fault. Runs after every other body is emitted.
fun bootstrapLlvmEmitDebugRuntime(backend: BootstrapLlvmBackend): void {
    bootstrapLlvmEmitSigreturnRestorer(backend)
    val hosted = bootstrapLlvmDebugHostedRuntime(backend)
    var printStack = LLVMGetNamedFunction(
        backend.module, "abla_runtime_print_stack"
    )
    val fault = LLVMGetNamedFunction(backend.module, "abla_runtime_fault")
    val faultNeeded = hosted && !pointerIsNull(fault) &&
        LLVMIsDeclaration(fault) != 0
    if (pointerIsNull(printStack) && !faultNeeded) return
    if (pointerIsNull(printStack)) printStack = bootstrapLlvmDeclare(
        backend, "abla_runtime_print_stack", backend.voidType, [], false, []
    )
    if (LLVMIsDeclaration(printStack) != 0) {
        LLVMSetLinkage(printStack, llvmInternalLinkage())
        LLVMPositionBuilderAtEnd(
            backend.builder,
            LLVMAppendBasicBlockInContext(backend.context, printStack, "entry")
        )
        if (hosted && bootstrapLlvmStackGuardKernel(backend)) {
            bootstrapLlvmEmitFramePointerWalk(backend, printStack)
        } else if (hosted) {
            val framesType = LLVMArrayType2(backend.pointerType, 64)
            val frames = LLVMBuildAlloca(backend.builder, framesType, "frames")
            bootstrapLlvmDebugWrite(
                backend,
                "stack (lldb on the program, or atos/addr2line with the addresses, gives file:line):\n",
                "abla.stack.header"
            )
            val count = bootstrapLlvmDebugCall(
                backend, "backtrace", backend.i64Type,
                [backend.pointerType, backend.i64Type],
                [frames, LLVMConstInt(backend.i64Type, 64, 0)]
            )
            // Every frame but the innermost holds a return address: step it
            // back into the call, so its line is the call's line.
            val cursor = LLVMBuildAlloca(backend.builder, backend.i64Type, "i")
            LLVMBuildStore(
                backend.builder, LLVMConstInt(backend.i64Type, 1, 0), cursor
            )
            val loop = LLVMAppendBasicBlockInContext(
                backend.context, printStack, "loop"
            )
            val body = LLVMAppendBasicBlockInContext(
                backend.context, printStack, "body"
            )
            val done = LLVMAppendBasicBlockInContext(
                backend.context, printStack, "done"
            )
            LLVMBuildBr(backend.builder, loop)
            LLVMPositionBuilderAtEnd(backend.builder, loop)
            val index = LLVMBuildLoad2(
                backend.builder, backend.i64Type, cursor, ""
            )
            // SLT (40).
            LLVMBuildCondBr(
                backend.builder,
                LLVMBuildICmp(backend.builder, 40, index, count, ""),
                body, done
            )
            LLVMPositionBuilderAtEnd(backend.builder, body)
            val slot = bootstrapLlvmDebugPointerElement(
                backend, frames, index
            )
            val address = LLVMBuildPtrToInt(
                backend.builder,
                LLVMBuildLoad2(backend.builder, backend.pointerType, slot, ""),
                backend.i64Type, ""
            )
            LLVMBuildStore(
                backend.builder,
                LLVMBuildIntToPtr(
                    backend.builder,
                    LLVMBuildSub(
                        backend.builder, address,
                        LLVMConstInt(backend.i64Type, 1, 0), ""
                    ),
                    backend.pointerType, ""
                ),
                slot
            )
            LLVMBuildStore(
                backend.builder,
                LLVMBuildAdd(
                    backend.builder, index,
                    LLVMConstInt(backend.i64Type, 1, 0), ""
                ),
                cursor
            )
            LLVMBuildBr(backend.builder, loop)
            LLVMPositionBuilderAtEnd(backend.builder, done)
            bootstrapLlvmDebugCall(
                backend, "backtrace_symbols_fd", backend.voidType,
                [backend.pointerType, backend.i64Type, backend.i64Type],
                [frames, count, LLVMConstInt(backend.i64Type, 2, 0)]
            )
            if (backend.macOS) {
                // atos -o <program> -l <load address> <address>...
                bootstrapLlvmDebugWrite(
                    backend, "load address ", "abla.stack.load"
                )
                val header = bootstrapLlvmDebugCall(
                    backend, "_dyld_get_image_header", backend.pointerType,
                    [backend.i64Type], [LLVMConstInt(backend.i64Type, 0, 0)]
                )
                bootstrapLlvmDebugWriteHex(
                    backend,
                    LLVMBuildPtrToInt(
                        backend.builder, header, backend.i64Type, ""
                    )
                )
                bootstrapLlvmDebugWrite(backend, "\n", "abla.stack.end")
            }
        }
        LLVMBuildRetVoid(backend.builder)
    }
    if (faultNeeded) {
        LLVMPositionBuilderAtEnd(
            backend.builder,
            LLVMAppendBasicBlockInContext(backend.context, fault, "entry")
        )
        bootstrapLlvmDebugWrite(
            backend, "\nfatal signal: a trap, a bad memory access or an abort\n",
            "abla.fault.header"
        )
        bootstrapLlvmCall(backend, printStack, [], "", false, [])
        // Back to the default action: returning re-runs the faulting
        // instruction (or abort raises again), which now ends the process.
        if (bootstrapLlvmStackGuardKernel(backend)) {
            val defaultType = LLVMArrayType2(backend.i8Type, 32)
            val action = LLVMBuildAlloca(backend.builder, defaultType, "fault.default")
            LLVMBuildStore(backend.builder, LLVMConstNull(defaultType), action)
            bootstrapLlvmStackGuardKernelSigaction(backend, LLVMGetParam(fault, 0), action)
        } else {
            bootstrapLlvmDebugCall(
                backend, "signal", backend.pointerType,
                [backend.i64Type, backend.pointerType],
                [LLVMGetParam(fault, 0), LLVMConstNull(backend.pointerType)]
            )
        }
        LLVMBuildRetVoid(backend.builder)
    }
    return
}
