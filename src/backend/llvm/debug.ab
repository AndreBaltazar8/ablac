    builder: i64*,
    name: cstring,
    nameLength: int,
    directory: cstring,
    directoryLength: int
): i64*
noescape extern:"c" fun LLVMDIBuilderCreateCompileUnit(
    builder: i64*,
    language: i32,
    file: i64*,
    producer: cstring,
    producerLength: int,
    optimized: i32,
    flags: cstring,
    flagsLength: int,
    runtimeVersion: i32,
    splitName: cstring,
