    builder: i64*, value: i64*, variable: i64*, expression: i64*, location: i64*, block: i64*
): i64*

trusted fun bootstrapLlvmDebugAddress(pointer: i64*): int =
    nativePointerAddress(pointer)

fun bootstrapLlvmDebugSame(left: i64*, right: i64*): bool =
    bootstrapLlvmDebugAddress(left) == bootstrapLlvmDebugAddress(right)

class BootstrapLlvmDebug(
    val enabled: bool,
    val builder: i64*,
    val unit: i64*,
    val unitFile: i64*,
    val subroutineType: i64*,
    // Per source file (bootstrapIrSourceFiles): its DIFile, the byte offset
    // each line starts at, and how its parsed source maps back to it.
    val files: array<i64*>,
    val lineStarts: array<array<int>>,
    val rewrites: array<BootstrapSourceRewrite>,
    // Per lowered function: its DISubprogram (null when it has none) and the
    // file index of its declaration.
    val subprograms: array<i64*>,
    val functionFiles: array<int>,
    val functionLines: array<int>,
    // The addresses of emitted Abla functions with no source position (the
    // global initializers, generated drops): they get no subprogram. One
    // would only add line-0 rows, and WebAssembly code generation scans each
    // block of a function with debug information once per value, which the
    // initializers' one huge block makes quadratic.
    val undescribed: array<int>,
    // The location the builder currently carries.
    var currentScope: i64*,
    var currentLine: int,
    var currentColumn: int,
    // Whether parameters and locals are described (bootstrapLlvmDebugVariables), and the types made so far,
    // by their Abla text.
    val variables: bool = false,
    val types: Map<string, i64*> = Map(),
    // Set once bootstrapLlvmDebugBegin has made every type the program's variables have: a function's emission
    // frees what it allocated (its memory checkpoint), so the cache must not grow then.
    var typesSealed: bool = false
)

fun bootstrapLlvmDebugDisabled(): BootstrapLlvmDebug =
    BootstrapLlvmDebug(
        false, nativeNullPointer(), nativeNullPointer(),
        nativeNullPointer(), nativeNullPointer(), [], [], [], [], [], [], [],
        nativeNullPointer(), -1, -1
    )

// The directory and name parts of a path, for a DIFile.
fun bootstrapLlvmDebugSplitPath(path: string): array<string> {
    var slash = path.size - 1
    while (slash >= 0 && path[slash] != 47) slash = slash - 1
    if (slash < 0) ["", path]
    else if (slash == 0) ["/", path.slice(1, path.size)]
    else [path.slice(0, slash), path.slice(slash + 1, path.size)]
}

// An absolute, normalized path ("a/./b/../c" → "a/c") for a source identity.
fun bootstrapLlvmDebugAbsolutePath(path: string, directory: string): string {
    val joined = if (path.size > 0 && path[0] == 47) path
        else "$directory/$path"
    val parts: array<string> = []
    var depth = 0
    var begin = 0
    var index = 0
    while (index <= joined.size) {
        if (index == joined.size || joined[index] == 47) {
            val part = joined.slice(begin, index)
            if (part == "..") {
                if (depth > 0) depth = depth - 1
            } else if (part != "" && part != ".") {
                if (depth < parts.size) parts[depth] = part
                else parts.append(part)
                depth = depth + 1
            }
            begin = index + 1
        }
        index = index + 1
    }
    var result = ""
    index = 0
    while (index < depth) {
        result = "$result/${parts[index]}"
        index = index + 1
    }
    if (result == "") "/" else result
}

// The directory a build's sources are named against: the entry source's own, absolute ("" when the build has no
// entry source, which keeps the names as the build gave them).
fun bootstrapLlvmDebugProjectRoot(cwd: string): string {
    if (bootstrapLlvmDebugEntry == "" || bootstrapLlvmDebugEntry == "<abla>") return ""
    val entry = bootstrapLlvmDebugAbsolutePath(bootstrapLlvmDebugEntry, cwd)
    val parts = bootstrapLlvmDebugSplitPath(entry)
    if (parts[0] == "") "/" else parts[0]
}

// `path` relative to the project root, or "" when it should stay absolute: a file under the root is named by its path
// below it; a file the build named relatively but that lies outside (`../lib/x.ab`) by the `..` path from the root,
// still independent of the working directory; an absolute file outside it (the standard library, another project)
// keeps its absolute path, which --path-prefix-map may rewrite.
fun bootstrapLlvmDebugProjectRelative(path: string, cwd: string, root: string): string {
    if (root == "" || (path.size > 0 && path[0] == 60)) return ""
    val absolute = bootstrapLlvmDebugAbsolutePath(path, cwd)
    val prefix = if (root == "/") "/" else "$root/"
    if (absolute.size > prefix.size && absolute.slice(0, prefix.size) == prefix) {
        return absolute.slice(prefix.size, absolute.size)
    }
    if (path.size > 0 && path[0] == 47) return ""
    val rootParts = bootstrapLlvmDebugSplitAll(root)
    val parts = bootstrapLlvmDebugSplitAll(absolute)
    var common = 0
    while (common < rootParts.size && common < parts.size && rootParts[common] == parts[common]) {
        common = common + 1
    }
    var result = ""
    var up = common
    while (up < rootParts.size) {
        result = "$result../"
        up = up + 1
    }
    var below = common
    while (below < parts.size) {
        result = if (below == common) "$result${parts[below]}" else "$result/${parts[below]}"
        below = below + 1
    }
    result
}

fun bootstrapLlvmDebugSplitAll(path: string): array<string> {
    val parts: array<string> = []
    var begin = 0
    var index = 0
    while (index <= path.size) {
        if (index == path.size || path[index] == 47) {
            if (index > begin) parts.append(path.slice(begin, index))
            begin = index + 1
        }
        index = index + 1
    }
    parts
}

// --path-prefix-map OLD=NEW (like clang's -fdebug-prefix-map), pairs of OLD and NEW: the first OLD that is a prefix of an absolute path
// source name is replaced by NEW.
var bootstrapLlvmDebugPrefixMap: array<string> = []

fun bootstrapLlvmDebugMapPrefix(path: string): string {
    var index = 0
    while (index + 1 < bootstrapLlvmDebugPrefixMap.size) {
        val old = bootstrapLlvmDebugPrefixMap[index]
        if (old.size > 0 && path.size >= old.size && path.slice(0, old.size) == old &&
            (path.size == old.size || old[old.size - 1] == 47 || path[old.size] == 47)) {
            return "${bootstrapLlvmDebugPrefixMap[index + 1]}${path.slice(old.size, path.size)}"
        }
        index = index + 2
    }
    path
}

// A source file's DIFile. For a native object the compilation directory is ".", as
// clang's -fdebug-compilation-dir=. and Go's -trimpath make it, and a source is named
// relative to the project root, the entry source's directory (bootstrapLlvmDebugProjectRelative):
// `ablac build d/x.ab`, `cd d && ablac build x.ab` and `ablac build $PWD/d/x.ab` give the same
// object, and so does a copy of the project built from its own root. A debugger resolves the
// names from where it runs, the project root. The standard library's files (and any other
// outside the root) keep their absolute path, which --path-prefix-map may rewrite. A
// WebAssembly module's DWARF keeps absolute paths (`directory`, the working directory,
// joined): browser tools resolve them as file URLs; they do not depend on the working
// directory either.
fun bootstrapLlvmDebugCreateFile(builder: i64*, path: string, directory: string): i64* {
    if (directory == "") {
        val cwd = currentDirectory().text
        val project = bootstrapLlvmDebugProjectRelative(path, cwd, bootstrapLlvmDebugProjectRoot(cwd))
        if (project != "") {
            return LLVMDIBuilderCreateFile(builder, project, project.size, ".", 1)
        }
    }
    if (directory != "" || (path.size > 0 && path[0] == 47)) {
        val absolute = bootstrapLlvmDebugAbsolutePath(path, if (directory != "") directory else "/")
        val parts = bootstrapLlvmDebugSplitPath(bootstrapLlvmDebugMapPrefix(absolute))
        return LLVMDIBuilderCreateFile(
            builder, parts[1], parts[1].size, parts[0], parts[0].size
        )
    }
    var relative = path
    while (relative.size > 2 && relative.slice(0, 2) == "./") {
        relative = relative.slice(2, relative.size)
    }
    LLVMDIBuilderCreateFile(builder, relative, relative.size, ".", 1)
}

// The module a source file names, for qualified symbols: "renderer" for
// .../renderer.ab, "exit" for .../exit/entry.ab.
fun bootstrapLlvmDebugModuleName(path: string): string {
    val parts = bootstrapLlvmDebugSplitPath(path)
    var name = parts[1]
    if (name.size > 3 && name.slice(name.size - 3, name.size) == ".ab") {
        name = name.slice(0, name.size - 3)
    }
    if (name == "entry" && parts[0] != "") {
        name = bootstrapLlvmDebugSplitPath(parts[0])[1]
    }
    name
}

fun bootstrapLlvmDebugLineStarts(source: string): array<int> {
    val starts: array<int> = [0]
    var index = 0
    while (index < source.size) {
        if (source[index] == 10) starts.append(index + 1)
        index = index + 1
    }
    starts
}

// The 1-based line holding `offset` (binary search over line starts).
fun bootstrapLlvmDebugLine(starts: array<int>, offset: int): int {
    var low = 0
    var high = starts.size - 1
    while (low < high) {
        val middle = (low + high + 1) / 2
        if (starts[middle] <= offset) low = middle else high = middle - 1
    }
    low + 1
}

fun bootstrapLlvmDebugBegin(
    backend: BootstrapLlvmBackend,
    program: BootstrapIrProgram
): BootstrapLlvmDebug {
    if (!bootstrapLlvmDebugInfo) return bootstrapLlvmDebugDisabled()
    val directory = if (bootstrapTextContains(backend.targetTriple, "wasm"))
        currentDirectory().text else ""
    val builder = LLVMCreateDIBuilder(backend.module)
    val files: array<i64*> = []
    val lineStarts: array<array<int>> = []
    val rewrites: array<BootstrapSourceRewrite> = []
    var file = 0
    while (file < bootstrapIrSourceFiles.size) {
        val path = bootstrapIrSourceFiles[file]
        files.append(bootstrapLlvmDebugCreateFile(builder, path, directory))
        val source = Path(path)
        lineStarts.append(if (source.exists())
            bootstrapLlvmDebugLineStarts(source.readText())
            else [0])
        rewrites.append(bootstrapSourceRewriteOf(bootstrapIrSourceFiles[file]))
        file = file + 1
    }
    // The unit is named after the program's entry source.
    val unitFile = bootstrapLlvmDebugCreateFile(
        builder,
        if (bootstrapLlvmDebugEntry != "") bootstrapLlvmDebugEntry else "<abla>",
        directory
    )
    var function = 0
    val producer = "ablac"
    // DW_LANG_C (the C API's enumerator 1). An optimized build has line tables only (2): the tables and the
    // subprograms of inlined functions, without types or variables, which its optimizations would leave wrong. A
    // development build (-g --fast, native) is full (1): every function's subprogram, its parameters and locals
    // and their types (bootstrapLlvmDebugDeclareVariable).
    val variables = !bootstrapLlvmDebugOptimized && !bootstrapTextContains(backend.targetTriple, "wasm")
    val unit = LLVMDIBuilderCreateCompileUnit(
        builder, 1, unitFile, producer, producer.size,
        if (bootstrapLlvmDebugOptimized) 1 else 0, "", 0, 0, "", 0, if (variables) 1 else 2, 0,
        0, 0, "", 0, "", 0
    )
    LLVMAddModuleFlag(
        backend.module, 1, "Debug Info Version", 18,
        LLVMValueAsMetadata(LLVMConstInt(backend.i32Type, 3, 0))
    )
    LLVMAddModuleFlag(
        backend.module, 1, "Dwarf Version", 13,
        LLVMValueAsMetadata(LLVMConstInt(backend.i32Type, 5, 0))
    )
    val subroutineType = LLVMDIBuilderCreateSubroutineType(
        builder, unitFile, nativeNullPointer(), 0, 0
    )
    val subprograms: array<i64*> = []
    val functionFiles: array<int> = []
    val functionLines: array<int> = []
    function = 0
    while (function < program.functions.size) {
        subprograms.append(nativeNullPointer())
        val position = program.functions[function].position
        val positionFile = bootstrapIrSourcePositionFile(position)
        functionFiles.append(positionFile)
        functionLines.append(
            if (positionFile >= 0 && positionFile < lineStarts.size)
                bootstrapLlvmDebugLine(
                    lineStarts[positionFile],
                    rewrites[positionFile].original(
                        bootstrapIrSourcePositionOffset(position)
                    )
                )
            else 0
        )
        function = function + 1
    }
    var debug = BootstrapLlvmDebug(
        true, builder, unit, unitFile, subroutineType, files, lineStarts,
        rewrites, subprograms, functionFiles, functionLines, [],
        nativeNullPointer(), -1, -1, variables, Map()
    )
    // Every type a parameter or local of the program has, made now: the cache cannot grow while a function is
    // emitted (BootstrapLlvmDebug.typesSealed).
    if (variables) {
        for (code in ["bool", "int", "u64", "i32", "u32", "i16", "u16", "i8", "u8", "char", "float", "f32"]) {
            bootstrapLlvmDebugScalarType(debug, code)
        }
        bootstrapLlvmDebugValueType(debug)
        for (lowered in program.functions) {
            for (type in lowered.parameterTypes) bootstrapLlvmDebugValuePlace(debug, program, type)
            for (type in lowered.localTypes) bootstrapLlvmDebugValuePlace(debug, program, type)
        }
    }
    debug.typesSealed = true
    debug
}

// ---- Variables: a development build's parameters and locals, with their Abla types ----
// DW_ATE_boolean 2, float 4, signed 5, unsigned 7, unsigned_char 8 (a wider `unsigned_char` reads as no type at all:
// the value's words and an array's capacity showed as `void` in lldb and as nothing in gdb).

fun bootstrapLlvmDebugBasicType(var debug: BootstrapLlvmDebug, name: string, bits: int, encoding: int): i64* {
    val key = "basic $name"
    val known = debug.types.get(key)
    if (known != null) return known
    val made = LLVMDIBuilderCreateBasicType(debug.builder, name, name.size, bits, i32(encoding), i32(0))
    if (!debug.typesSealed) debug.types.set(key, made)
    made
}

fun bootstrapLlvmDebugPointerType(var debug: BootstrapLlvmDebug, pointee: i64*, name: string): i64* =
    LLVMDIBuilderCreatePointerType(debug.builder, pointee, 64, i32(64), i32(0), name, name.size)

// A structure of members (name, offset and size in bytes, type), `size` bytes in all.
trusted fun bootstrapLlvmDebugStructType(var debug: BootstrapLlvmDebug, name: string, size: int,
    names: array<string>, offsets: array<int>, sizes: array<int>, types: array<i64*>): i64* {
    val members = llvmPointerVector(names.size)
    for (index in 0 until names.size) {
        members.set(index, LLVMDIBuilderCreateMemberType(debug.builder, debug.unitFile, names[index],
            names[index].size, debug.unitFile, i32(0), sizes[index] * 8, i32(8), offsets[index] * 8, i32(0),
            types[index]))
    }
    val made = LLVMDIBuilderCreateStructType(debug.builder, debug.unitFile, name, name.size, debug.unitFile, i32(0),
        size * 8, i32(64), i32(0), nativeNullPointer(), members.pointer(), i32(names.size), i32(0),
        nativeNullPointer(), "", 0)
    members.drop()
    made
}

// A native scalar's type by its code (core.ab, BootstrapLlvmBackend.type): an Abla int is a signed 64-bit word,
// a float an f64. Null for a code that is no scalar.
fun bootstrapLlvmDebugScalarType(var debug: BootstrapLlvmDebug, code: string): i64* {
    if (code == "i1" || code == "bool") return bootstrapLlvmDebugBasicType(debug, "bool", 8, 2)
    if (code == "i64" || code == "int") return bootstrapLlvmDebugBasicType(debug, "int", 64, 5)
    if (code == "u64") return bootstrapLlvmDebugBasicType(debug, "u64", 64, 7)
    if (code == "i32") return bootstrapLlvmDebugBasicType(debug, "i32", 32, 5)
    if (code == "u32") return bootstrapLlvmDebugBasicType(debug, "u32", 32, 7)
    if (code == "i16") return bootstrapLlvmDebugBasicType(debug, "i16", 16, 5)
    if (code == "u16") return bootstrapLlvmDebugBasicType(debug, "u16", 16, 7)
    if (code == "i8") return bootstrapLlvmDebugBasicType(debug, "i8", 8, 5)
    if (code == "u8" || code == "char") return bootstrapLlvmDebugBasicType(debug, code, 8, 8)
    if (code == "f64" || code == "float") return bootstrapLlvmDebugBasicType(debug, "float", 64, 4)
    if (code == "f32") return bootstrapLlvmDebugBasicType(debug, "f32", 32, 4)
    nativeNullPointer()
}

// A string's two words as a flat string has them: its bytes and their count (a rope's first word is 0 and its
// second the rope; stdlib/abla/runtime/self/entry.ab, __ablaRuntimeStringLengthValue).
fun bootstrapLlvmDebugStringType(var debug: BootstrapLlvmDebug): i64* {
    val known = debug.types.get("string")
    if (known != null) return known
    val bytes = bootstrapLlvmDebugPointerType(debug, bootstrapLlvmDebugBasicType(debug, "char", 8, 6), "")
    val made = bootstrapLlvmDebugStructType(debug, "string", 16, ["data", "length"], [0, 8], [8, 8],
        [bytes, bootstrapLlvmDebugScalarType(debug, "int")])
    if (!debug.typesSealed) debug.types.set("string", made)
    made
}

// The universal value (core.ab, AblaValue): its tag, a second word and the two payload words, as any value a
// type below does not describe is shown.
fun bootstrapLlvmDebugValueType(var debug: BootstrapLlvmDebug): i64* {
    val known = debug.types.get("value")
    if (known != null) return known
    val word = bootstrapLlvmDebugScalarType(debug, "u64")
    val half = bootstrapLlvmDebugScalarType(debug, "u32")
    val made = bootstrapLlvmDebugStructType(debug, "value", 24, ["tag", "flags", "word0", "word1"], [0, 4, 8, 16],
        [4, 4, 8, 8], [half, half, word, word])
    if (!debug.typesSealed) debug.types.set("value", made)
    made
}

// A universal value of an Abla type the types above do not describe (a nullable string, a Map, ...), under the
// name Abla writes the type with: a typedef of `value`, so a debugger names the variable's type.
fun bootstrapLlvmDebugNamedValueType(var debug: BootstrapLlvmDebug, type: string): i64* {
    val key = "named $type"
    val known = debug.types.get(key)
    if (known != null) return known
    val shown = if (type.startsWith("nullable:")) "${type.slice(9, type.size)}?" else type
    val made = LLVMDIBuilderCreateTypedef(debug.builder, bootstrapLlvmDebugValueType(debug), shown, shown.size,
        debug.unitFile, i32(0), debug.unitFile, i32(0))
    if (!debug.typesSealed) debug.types.set(key, made)
    made
}

// An array's object (stdlib/abla/runtime/self/entry.ab): its length, its capacity (the top byte says how the
// elements are stored) and its elements, 8-byte words for numbers and bools of a dense array, values otherwise.
fun bootstrapLlvmDebugArrayType(var debug: BootstrapLlvmDebug, type: string): i64* {
    val known = debug.types.get(type)
    if (known != null) return known
    // `type` is array:T; the structure is named as Abla writes it.
    val element = type.slice(6, type.size)
    val elementType = if (element == "i64") bootstrapLlvmDebugScalarType(debug, "int")
        else if (element == "f64") bootstrapLlvmDebugScalarType(debug, "float")
        else bootstrapLlvmDebugValueType(debug)
    val shown = if (element == "i64") "int" else if (element == "f64") "float" else element
    val made = bootstrapLlvmDebugStructType(debug, "array<$shown>", 24, ["length", "capacity", "data"], [0, 8, 16],
        [8, 8, 8],
        [bootstrapLlvmDebugScalarType(debug, "int"), bootstrapLlvmDebugScalarType(debug, "u64"),
         bootstrapLlvmDebugPointerType(debug, elementType, "")])
    if (!debug.typesSealed) debug.types.set(type, made)
    made
}

// A class's instance (ir.ab, BootstrapIrClass): the 16-byte header (its class's descriptor, its extension
// fields), then each field at its place, by the kind it is stored as. A reference field is a pointer: the place
// does not say to which class.
fun bootstrapLlvmDebugClassType(var debug: BootstrapLlvmDebug, irClass: BootstrapIrClass): i64* {
    val key = "class ${irClass.name}"
    val known = debug.types.get(key)
    if (known != null) return known
    val word = bootstrapLlvmDebugScalarType(debug, "u64")
    val names = ["class", "extension"]
    val offsets = [0, 8]
    val sizes = [8, 8]
    val types = [word, word]
    for (field in 0 until irClass.fields.size) {
        val place = irClass.fieldPlaces[field]
        val kind = bootstrapIrFieldPlaceKind(place)
        val floating = (place / 562949953421312) % 4
        names.append(irClass.fields[field])
        offsets.append(place % 4294967296)
        if (kind == BOOTSTRAP_IR_FIELD_WORD) {
            sizes.append(8)
            types.append(if (floating == 2) bootstrapLlvmDebugScalarType(debug, "float")
                else bootstrapLlvmDebugScalarType(debug, "int"))
        } else if (kind == BOOTSTRAP_IR_FIELD_BOOL) {
            sizes.append(1)
            types.append(bootstrapLlvmDebugScalarType(debug, "bool"))
        } else if (kind == BOOTSTRAP_IR_FIELD_STRING) {
            sizes.append(16)
            types.append(bootstrapLlvmDebugStringType(debug))
        } else if (kind == BOOTSTRAP_IR_FIELD_REFERENCE || kind == BOOTSTRAP_IR_FIELD_NULLABLE_REFERENCE) {
            sizes.append(8)
            types.append(bootstrapLlvmDebugPointerType(debug, nativeNullPointer(), ""))
        } else {
            sizes.append(24)
            types.append(bootstrapLlvmDebugValueType(debug))
        }
    }
    val made = bootstrapLlvmDebugStructType(debug, irClass.name, irClass.size, names, offsets, sizes, types)
    if (!debug.typesSealed) debug.types.set(key, made)
    made
}

class BootstrapLlvmDebugPlace(
    // The variable's type, and the DWARF operations from its storage's address to it.
    val type: i64*,
    val operations: array<int>
)

// How a universal value (a 24-byte AblaValue in memory) of Abla type `type` is shown: the payload as the type
// says (an int, float or bool its first word; a string its two words; an instance the object its first word
// points to; a nullable instance or an array, the pointer), else the value itself.
// DW_OP_plus_uconst 0x23, DW_OP_deref 0x06.
fun bootstrapLlvmDebugValuePlace(var debug: BootstrapLlvmDebug, program: BootstrapIrProgram,
    type: string): BootstrapLlvmDebugPlace {
    // Types come normalized (sema.ab, bootstrapNormalizeType): i64, f64, array:T, nullable:T.
    val scalar = bootstrapLlvmDebugScalarType(debug, type)
    if (!pointerIsNull(scalar)) return BootstrapLlvmDebugPlace(scalar, [35, 8])
    if (type == "string") return BootstrapLlvmDebugPlace(bootstrapLlvmDebugStringType(debug), [35, 8])
    if (type.startsWith("array:")) {
        return BootstrapLlvmDebugPlace(
            bootstrapLlvmDebugPointerType(debug, bootstrapLlvmDebugArrayType(debug, type), ""), [35, 8])
    }
    val nullable = type.startsWith("nullable:")
    val name = if (nullable) type.slice(9, type.size) else type
    for (irClass in program.classes) {
        if (irClass.name == name) {
            val object = bootstrapLlvmDebugClassType(debug, irClass)
            return if (nullable) BootstrapLlvmDebugPlace(bootstrapLlvmDebugPointerType(debug, object, ""), [35, 8])
                else BootstrapLlvmDebugPlace(object, [35, 8, 6])
        }
    }
    BootstrapLlvmDebugPlace(bootstrapLlvmDebugNamedValueType(debug, type), [])
}

// A variable of function `functionId` named `name`, of Abla type `type`, at `storage`: the address of a native
// scalar (`scalar` its code) or of a universal value, or (`value`) a native scalar's value itself. A parameter has
// its number from 1, a local 0. Its record goes at the end of `block` (the entry block, after the allocas).
trusted fun bootstrapLlvmDebugDeclareVariable(var debug: BootstrapLlvmDebug, backend: BootstrapLlvmBackend,
    program: BootstrapIrProgram, functionId: int, name: string, type: string, scalar: string, storage: i64*,
    value: bool, argument: int, position: int, block: i64*): void {
    if (!debug.enabled || !debug.variables || pointerIsNull(storage)) return
    val subprogram = debug.subprograms[functionId]
    if (pointerIsNull(subprogram)) return
    val place = if (scalar != "") BootstrapLlvmDebugPlace(bootstrapLlvmDebugScalarType(debug, scalar), [])
        else bootstrapLlvmDebugValuePlace(debug, program, type)
    if (pointerIsNull(place.type)) return
    val file = debug.functionFiles[functionId]
    var line = debug.functionLines[functionId]
    if (position >= 0 && file >= 0 && bootstrapIrSourcePositionFile(position) == file) {
        line = bootstrapLlvmDebugLine(debug.lineStarts[file],
            debug.rewrites[file].original(bootstrapIrSourcePositionOffset(position)))
    }
    val scopeFile = if (file >= 0 && file < debug.files.size) debug.files[file] else debug.unitFile
    val variable = if (argument > 0)
        LLVMDIBuilderCreateParameterVariable(debug.builder, subprogram, name, name.size, i32(argument), scopeFile,
            i32(line), place.type, 1, i32(0))
        else LLVMDIBuilderCreateAutoVariable(debug.builder, subprogram, name, name.size, scopeFile, i32(line),
            place.type, 1, i32(0), i32(0))
    // The operations as the C API takes them, an array of 64-bit words.
    val operations = llvmPointerVector(place.operations.size + 1)
    for (index in 0 until place.operations.size) {
        operations.set(index, nativePointerFromAddress(place.operations[index]))
    }
    val expression = LLVMDIBuilderCreateExpression(debug.builder, operations.pointer(), place.operations.size)
    operations.drop()
    val location = LLVMDIBuilderCreateDebugLocation(backend.context, i32(line), i32(0), subprogram,
        nativeNullPointer())
    if (value) LLVMDIBuilderInsertDbgValueRecordAtEnd(debug.builder, storage, variable, expression, location, block)
    else LLVMDIBuilderInsertDeclareRecordAtEnd(debug.builder, storage, variable, expression, location, block)
    return
}

// The readable name of a lowered function, qualified by its module: the name
// its source wrote, without the prefix that keeps a private or shadowing name
// apart (the module qualifier already does).
fun bootstrapLlvmDebugFunctionName(
    function: BootstrapIrFunction,
    file: int
): string {
    val label = bootstrapSourceVisibleType(
        if (function.label != "") function.label else function.name
    )
    if (file >= 0 && file < bootstrapIrSourceFiles.size)
        "${bootstrapLlvmDebugModuleName(bootstrapIrSourceFiles[file])}.$label"
    else label
}

// Gives a lowered function's LLVM body its subprogram. Called before its
// body is emitted, outside the per-function memory checkpoint.
fun bootstrapLlvmDebugDeclareFunction(
    var debug: BootstrapLlvmDebug,
    _backend: BootstrapLlvmBackend,
    function: BootstrapIrFunction,
    functionId: int,
    llvmFunction: i64*,
    linkageName: string
): void {
    if (!debug.enabled || pointerIsNull(llvmFunction)) return
    if (function.position < 0) {
        debug.undescribed.append(bootstrapLlvmDebugAddress(llvmFunction))
        return
    }
    val file = debug.functionFiles[functionId]
    val scopeFile = if (file >= 0 && file < debug.files.size)
        debug.files[file] else debug.unitFile
    val name = bootstrapLlvmDebugFunctionName(function, file)
    val line = debug.functionLines[functionId]
    // DIFlagArtificial (1 << 6) for what no declaration wrote. A development build names no linkage name: with
    // one, a debugger names the frame after the symbol (abla_fn_..._direct), not the function.
    val linkage = if (debug.variables) "" else linkageName
    val subprogram = LLVMDIBuilderCreateFunction(
        debug.builder, scopeFile, name, name.size, linkage,
        linkage.size, scopeFile, i32(line), debug.subroutineType, 1, 1, i32(line),
        if (file >= 0) 0 else 64,
        if (bootstrapLlvmDebugOptimized) 1 else 0
    )
    LLVMSetSubprogram(llvmFunction, subprogram)
    debug.subprograms[functionId] = subprogram
    return
}

// Points the builder at an instruction's source position (inside function
// `functionId`). Positions in another file than the function's keep the
// previous location.
fun bootstrapLlvmDebugLocate(
    var debug: BootstrapLlvmDebug,
    backend: BootstrapLlvmBackend,
    functionId: int,
    position: int
): void {
    if (!debug.enabled) return
    val subprogram = debug.subprograms[functionId]
    if (pointerIsNull(subprogram)) return
    val file = debug.functionFiles[functionId]
    var line = debug.currentLine
    var column = debug.currentColumn
    if (!bootstrapLlvmDebugSame(debug.currentScope, subprogram)) {
        line = debug.functionLines[functionId]
        column = 0
    }
    if (position >= 0 && file >= 0 &&
        bootstrapIrSourcePositionFile(position) == file) {
        val starts = debug.lineStarts[file]
        val offset = debug.rewrites[file].original(
            bootstrapIrSourcePositionOffset(position)
        )
        if (starts.size > 1 || offset == 0) {
            line = bootstrapLlvmDebugLine(starts, offset)
            column = offset - starts[line - 1] + 1
        }
    }
    if (!bootstrapLlvmDebugSame(debug.currentScope, subprogram) ||
        line != debug.currentLine || column != debug.currentColumn) {
        LLVMSetCurrentDebugLocation2(
            backend.builder,
            LLVMDIBuilderCreateDebugLocation(
                backend.context, i32(line), i32(column), subprogram,
                nativeNullPointer()
            )
        )
        debug.currentScope = subprogram
        debug.currentLine = line
        debug.currentColumn = column
    }
    return
}

// Clears the builder's location (after a function body).
fun bootstrapLlvmDebugClear(
    var debug: BootstrapLlvmDebug,
    backend: BootstrapLlvmBackend
): void {
    if (!debug.enabled) return
    LLVMSetCurrentDebugLocation2(backend.builder, nativeNullPointer())
    debug.currentScope = nativeNullPointer()
    debug.currentLine = -1
    debug.currentColumn = -1
    return
}

trusted fun bootstrapLlvmDebugValueName(value: i64*): string {
    val length = nativeByteBuffer(8)
    val name = LLVMGetValueName2(value, length.pointerAt(0))
    val size = length.loadI64(0)
    length.close()
    var result = ""
    if (!pointerIsNull(name) && size > 0) {
        val copy = nativeByteBuffer(size + 1)
        var index = 0
        while (index < size) {
            copy.store(index, ablaUnsafeLoadU8(
                ablaUnsafePointerOffset(name, index)
            ))
            index = index + 1
        }
        copy.store(size, 0)
        result = copy.adoptString(size)
    }
    result
}

// Completes the module's debug information once every body is emitted:
// gives each remaining defined function an artificial subprogram, puts every
// instruction in its own function's scope (LLVM requires a location on each
// inlinable call of a function with debug information), renames emitted
// Abla functions after their declarations and, on native targets, keeps
// frame pointers.
fun bootstrapLlvmDebugFinish(
    debug: BootstrapLlvmDebug,
    backend: BootstrapLlvmBackend,
    program: BootstrapIrProgram,
    identities: BootstrapLlvmFunctionIdentities,
    emittedFunctions: array<bool>
): void {
    if (!debug.enabled) return
    LLVMSetCurrentDebugLocation2(backend.builder, nativeNullPointer())
    val wasm = bootstrapTextContains(backend.targetTriple, "wasm")
    val optimized: i32 = if (bootstrapLlvmDebugOptimized) 1 else 0
    // A function's value-ABI wrapper, which the dispatch table calls, keeps its hashed symbol (it is not internal:
    // a release build's LTO internalizes it later). In a development build and in a WebAssembly one its
    // subprogram is named as the body's with ".boxed", so a frame of it (and, in a module, the body inlined into
    // it) reads `probe.main.lambda.boxed`: a debugger takes the subprogram's name, and the module's name section
    // is renamed from it (sourcemap.ab). A native development build gives it no linkage name, which a debugger
    // would show instead; a module's keeps it, the symbol its name section has.
    val wrapperNames: Map<string, string> = Map()
    if (debug.variables || wasm) {
        for (index in 0 until program.functions.size) {
            if (index < emittedFunctions.size && emittedFunctions[index]) {
                wrapperNames.set(identities.symbols[index], "${bootstrapLlvmDebugFunctionName(
                    program.functions[index], debug.functionFiles[index])}.boxed")
            }
        }
    }
    var function = LLVMGetFirstFunction(backend.module)
    while (!pointerIsNull(function)) {
        var undescribed = false
        for (address in debug.undescribed) {
            if (address == bootstrapLlvmDebugAddress(function)) undescribed = true
        }
        if (undescribed) {
            var block = LLVMGetFirstBasicBlock(function)
            while (!pointerIsNull(block)) {
                var instruction = LLVMGetFirstInstruction(block)
                while (!pointerIsNull(instruction)) {
                    if (!pointerIsNull(LLVMInstructionGetDebugLoc(instruction))) {
                        LLVMInstructionSetDebugLoc(
                            instruction, nativeNullPointer()
                        )
                    }
                    instruction = LLVMGetNextInstruction(instruction)
                }
                block = LLVMGetNextBasicBlock(block)
            }
            if (!wasm) bootstrapLlvmAddStringFunctionAttribute(
                backend, function, "frame-pointer", "all"
            )
        } else if (LLVMIsDeclaration(function) == 0) {
            var subprogram = LLVMGetSubprogram(function)
            if (pointerIsNull(subprogram)) {
                val symbol = bootstrapLlvmDebugValueName(function)
                val wrapper = wrapperNames.get(symbol)
                val name = wrapper ?? symbol
                val linkage = if (wrapper != null && !wasm) "" else symbol
                subprogram = LLVMDIBuilderCreateFunction(
                    debug.builder, debug.unitFile, name, name.size, linkage,
                    linkage.size, debug.unitFile, 0, debug.subroutineType,
                    if (LLVMGetLinkage(function) == llvmExternalLinkage())
                        0 else 1,
                    1, 0, 64, optimized
                )
                LLVMSetSubprogram(function, subprogram)
            }
            val fallback = LLVMDIBuilderCreateDebugLocation(
                backend.context, 0, 0, subprogram, nativeNullPointer()
            )
            var block = LLVMGetFirstBasicBlock(function)
            while (!pointerIsNull(block)) {
                var instruction = LLVMGetFirstInstruction(block)
                while (!pointerIsNull(instruction)) {
                    val location = LLVMInstructionGetDebugLoc(instruction)
                    if (pointerIsNull(location) || !bootstrapLlvmDebugSame(
                        LLVMDILocationGetScope(location), subprogram
                    )) LLVMInstructionSetDebugLoc(instruction, fallback)
                    instruction = LLVMGetNextInstruction(instruction)
                }
                block = LLVMGetNextBasicBlock(block)
            }
            if (!wasm) bootstrapLlvmAddStringFunctionAttribute(
                backend, function, "frame-pointer", "all"
            )
        }
        function = LLVMGetNextFunction(function)
    }
    // Readable symbols: the module-qualified Abla name on the body, and with
    // a ".boxed" suffix on its value-ABI wrapper. Only internal definitions
    // are renamed; LLVM makes repeated names unique.
    var index = 0
    while (index < program.functions.size) {
        if (index < emittedFunctions.size && emittedFunctions[index]) {
            val name = bootstrapLlvmDebugFunctionName(
                program.functions[index], debug.functionFiles[index]
            )
            val direct = LLVMGetNamedFunction(
                backend.module,
                "${identities.symbols[index]}_direct"
            )
            if (!pointerIsNull(direct) && LLVMIsDeclaration(direct) == 0 &&
                LLVMGetLinkage(direct) == llvmInternalLinkage()) {
                LLVMSetValueName2(direct, name, name.size)
            }
            val wrapper = LLVMGetNamedFunction(
                backend.module, identities.symbols[index]
            )
            if (!pointerIsNull(wrapper) && LLVMIsDeclaration(wrapper) == 0 &&
                LLVMGetLinkage(wrapper) == llvmInternalLinkage()) {
                val boxed = "$name.boxed"
                LLVMSetValueName2(wrapper, boxed, boxed.size)
            }
        }
        index = index + 1
    }
    LLVMDIBuilderFinalize(debug.builder)
    LLVMDisposeDIBuilder(debug.builder)
}

// --- stacks at run time -----------------------------------------------------
// A debug build of a hosted executable prints the stack when it dies: Abla's
// `panic` calls abla_runtime_print_stack, and fault signals (a trap, a bad
// access, an abort) run abla_runtime_fault, which prints it and lets the
// signal take its default course (the exit status and the system's crash
// report stay as they were). The frames are named by the symbol table; lldb or
// atos map them to file:line through the debug information. Other builds keep
// abla_runtime_print_stack as an empty function, so code can always call it.

// `build --backtrace` (crash reports, step 2): a build without debug information that still prints a named stack
// when it dies, as a debug build prints one: the fault handlers, the frame-pointer walk and a frame pointer in every
// function, and a table of the functions' start addresses and names (abla_backtrace_entries, defined once the
// module is optimized: bootstrapLlvmDefineBacktraceTable) that the walk names each frame by.
var bootstrapLlvmBacktrace: bool = false

// A native --backtrace executable (ELF, or a hosted Windows PE) is an optimized build with line tables (bootstrapLlvmDebugInfo), whose DWARF the
// link's output loses to `<output>.debug` beside it: the same build's, named by its build-id note and debug link, which
// `ablac symbolize` (llvm-symbolizer) reads for file:line. (Asked -g, a build keeps its DWARF instead.)
var bootstrapLlvmBacktraceSplit: bool = false

private noescape extern:"c" fun LLVMDeleteGlobal(global: i64*): void

// The readable name of each function's symbol (its body's, and with ".boxed" its value-ABI wrapper's), set as the
// module is emitted (backend.ab) for the table made after optimization.
var bootstrapLlvmBacktraceNames: Map<string, string> = Map()

// Defines the table the walk names frames by, from the functions the optimized `module` still has: each one's
// address and readable name (bootstrapLlvmBacktraceNames; a name without the hashed prefix is its own, as a debug
// build renames bodies), the names stored once. Replaces the declarations the walk was emitted against.
trusted fun bootstrapLlvmDefineBacktraceTable(module: i64*, context: i64*): void {
    if (!bootstrapLlvmBacktrace) return
    val declaredEntries = LLVMGetNamedGlobal(module, "abla_backtrace_entries")
    if (pointerIsNull(declaredEntries)) return
    val i8 = LLVMInt8TypeInContext(context)
    val i32 = LLVMInt32TypeInContext(context)
    val i64 = LLVMInt64TypeInContext(context)
    val pointer = LLVMPointerTypeInContext(context, i32(0))
    val fields = llvmPointerVector(3)
    fields.set(0, pointer)
    fields.set(1, i32)
    fields.set(2, i32)
    val entryType = LLVMStructTypeInContext(context, fields.pointer(), i32(3), 0)
    fields.drop()
    val functions: array<i64*> = []
    val offsets: array<int> = []
    val lengths: array<int> = []
    val stored: Map<string, int> = Map()
    var blob = ""
    var function = LLVMGetFirstFunction(module)
    while (!pointerIsNull(function)) {
        if (LLVMIsDeclaration(function) == 0) {
            val symbol = bootstrapLlvmDebugValueName(function)
            val known = bootstrapLlvmBacktraceNames.get(symbol)
            val name = if (known != null) known else if (symbol.startsWith("abla_fn_")) "" else symbol
            if (name != "") {
                var offset = stored.get(name) ?? -1
                if (offset < 0) {
                    offset = blob.size
                    stored.set(name, offset)
                    blob = "$blob$name"
                }
                functions.append(function)
                offsets.append(offset)
                lengths.append(name.size)
            }
        }
        function = LLVMGetNextFunction(function)
    }
    val entries = llvmPointerVector(functions.size + 1)
    for (index in 0 until functions.size) {
        val values = llvmPointerVector(3)
        values.set(0, functions[index])
        values.set(1, LLVMConstInt(i32, offsets[index], 0))
        values.set(2, LLVMConstInt(i32, lengths[index], 0))
        entries.set(index, LLVMConstStructInContext(context, values.pointer(), i32(3), 0))
        values.drop()
    }
    val entriesType = LLVMArrayType2(entryType, functions.size)
    val table = LLVMAddGlobal(module, entriesType, "abla_backtrace_entries.table")
    LLVMSetInitializer(table, LLVMConstArray2(entryType, entries.pointer(), functions.size))
    entries.drop()
    val namesValue = LLVMConstStringInContext2(context, blob, blob.size, 1)
    val names = LLVMAddGlobal(module, LLVMArrayType2(i8, blob.size), "abla_backtrace_names.table")
    LLVMSetInitializer(names, namesValue)
    val count = LLVMAddGlobal(module, i64, "abla_backtrace_count.table")
    LLVMSetInitializer(count, LLVMConstInt(i64, functions.size, 0))
    for (made in [table, names, count]) {
        LLVMSetGlobalConstant(made, 1)
        LLVMSetLinkage(made, llvmInternalLinkage())
    }
    val replaced = [declaredEntries, LLVMGetNamedGlobal(module, "abla_backtrace_names"),
        LLVMGetNamedGlobal(module, "abla_backtrace_count")]
    val by = [table, names, count]
    for (index in 0 until 3) {
        if (!pointerIsNull(replaced[index])) {
            LLVMReplaceAllUsesWith(replaced[index], by[index])
            LLVMDeleteGlobal(replaced[index])
        }
    }
    return
}

// The frame pointer a fault interrupted, where the walk starts instead of its own frame (0: none).
fun bootstrapLlvmFaultFrameGlobal(backend: BootstrapLlvmBackend): i64* {
    var global = LLVMGetNamedGlobal(backend.module, "abla_runtime_fault_frame")
    if (pointerIsNull(global)) {
        global = LLVMAddGlobal(backend.module, backend.i64Type, "abla_runtime_fault_frame")
        LLVMSetInitializer(global, LLVMConstInt(backend.i64Type, 0, 0))
        LLVMSetLinkage(global, llvmInternalLinkage())
    }
    global
}

// --backtrace on a WebAssembly module: its functions take their readable names (bootstrapLlvmBacktraceNames), which
// the name section the link then keeps carries into a host's stack traces. Only what nothing outside the module names
// is renamed: internal or hidden functions (the module is linked whole); a clash gets LLVM's numeric suffix.
trusted fun bootstrapLlvmBacktraceWasmNames(module: i64*): void {
    if (!bootstrapLlvmBacktrace) return
    var function = LLVMGetFirstFunction(module)
    while (!pointerIsNull(function)) {
        val next = LLVMGetNextFunction(function)
        if (LLVMIsDeclaration(function) == 0 && (LLVMGetLinkage(function) == llvmInternalLinkage() ||
            LLVMGetVisibility(function) == llvmHiddenVisibility())) {
            val known = bootstrapLlvmBacktraceNames.get(bootstrapLlvmDebugValueName(function))
            if (known != null) LLVMSetValueName2(function, known, known.size)
        }
        function = next
    }
    return
}

// A word the stack guard's handler records for the fault report (internal, 0 until a fault).
fun bootstrapLlvmFaultWord(backend: BootstrapLlvmBackend, name: string): i64* {
    var global = LLVMGetNamedGlobal(backend.module, name)
    if (pointerIsNull(global)) {
        global = LLVMAddGlobal(backend.module, backend.i64Type, name)
        LLVMSetInitializer(global, LLVMConstInt(backend.i64Type, 0, 0))
        LLVMSetLinkage(global, llvmInternalLinkage())
    }
    global
}

// The pc a fault interrupted, which the stack guard's handler records for the walk to print first (0: none).
fun bootstrapLlvmFaultPcGlobal(backend: BootstrapLlvmBackend): i64* {
    var global = LLVMGetNamedGlobal(backend.module, "abla_runtime_fault_pc")
    if (pointerIsNull(global)) {
        global = LLVMAddGlobal(backend.module, backend.i64Type, "abla_runtime_fault_pc")
        LLVMSetInitializer(global, LLVMConstInt(backend.i64Type, 0, 0))
        LLVMSetLinkage(global, llvmInternalLinkage())
    }
    global
}

// Where the walk starts: the interrupted frame when a fault interrupted the program (abla_runtime_fault_frame, set by
// the stack guard's handler, so the walk skips the handler and the signal frame), else the walker's own frame.
fun bootstrapLlvmWalkStart(backend: BootstrapLlvmBackend, own: i64*): i64* {
    val i64 = backend.i64Type
    val start = LLVMBuildPtrToInt(backend.builder, own, i64, "")
    val faultFrame = LLVMGetNamedGlobal(backend.module, "abla_runtime_fault_frame")
    if (pointerIsNull(faultFrame)) return start
    val interrupted = LLVMBuildLoad2(backend.builder, i64, faultFrame, "fault.frame")
    // NE (33).
    LLVMBuildSelect(backend.builder,
        LLVMBuildICmp(backend.builder, 33, interrupted, LLVMConstInt(i64, 0, 0), ""), interrupted, start, "walk.start")
}

// The walk's first line when a fault interrupted the program (abla_runtime_fault_pc set by the stack guard's
// handler): the faulting instruction itself, which no frame's return address names; named as the frames are.
fun bootstrapLlvmWalkFaultPc(backend: BootstrapLlvmBackend, printStack: i64*): void {
    val faultPc = LLVMGetNamedGlobal(backend.module, "abla_runtime_fault_pc")
    if (pointerIsNull(faultPc)) return
    val i64 = backend.i64Type
    val pc = LLVMBuildLoad2(backend.builder, i64, faultPc, "fault.pc")
    val print = LLVMAppendBasicBlockInContext(backend.context, printStack, "fault.pc.print")
    val after = LLVMAppendBasicBlockInContext(backend.context, printStack, "fault.pc.after")
    // NE (33).
    LLVMBuildCondBr(backend.builder, LLVMBuildICmp(backend.builder, 33, pc, LLVMConstInt(i64, 0, 0), ""), print, after)
    LLVMPositionBuilderAtEnd(backend.builder, print)
    bootstrapLlvmDebugWriteHex(backend, pc)
    if (bootstrapLlvmBacktrace) {
        bootstrapLlvmCall(backend, bootstrapLlvmBacktraceNameFunction(backend), [pc], "", false, [])
    }
    bootstrapLlvmDebugWrite(backend, " (the faulting instruction)\n", "abla.stack.fault.pc")
    LLVMBuildBr(backend.builder, after)
    LLVMPositionBuilderAtEnd(backend.builder, after)
    return
}

// The table's three symbols, declared for the walk and defined after optimization: the entries (16 bytes each: the
// function's address, its name's offset and length in the names), their count, and the names.
// Weak and empty (no entries) until then: the optimizer cannot fold a weak value, and a build that defines no table
// (a pipeline other than the release one) links with these and prints its addresses unnamed.
fun bootstrapLlvmBacktraceGlobal(backend: BootstrapLlvmBackend, name: string, type: i64*): i64* {
    var global = LLVMGetNamedGlobal(backend.module, name)
    if (pointerIsNull(global)) {
        global = LLVMAddGlobal(backend.module, type, name)
        LLVMSetInitializer(global, LLVMConstNull(type))
        // WeakAny (5).
        LLVMSetLinkage(global, i32(5))
    }
    global
}

// abla_backtrace_name(address): writes " in <name>" for the function the table says `address` (a return address,
// one byte back) is in, the one with the greatest start at or below it; nothing when none is.
fun bootstrapLlvmBacktraceNameFunction(backend: BootstrapLlvmBackend): i64* {
    val existing = LLVMGetNamedFunction(backend.module, "abla_backtrace_name")
    if (!pointerIsNull(existing)) return existing
    val i64 = backend.i64Type
    val i32 = backend.i32Type
    val function = bootstrapLlvmDeclare(backend, "abla_backtrace_name", backend.voidType, [i64], false, [])
    LLVMSetLinkage(function, llvmInternalLinkage())
    val saved = LLVMGetInsertBlock(backend.builder)
    LLVMPositionBuilderAtEnd(backend.builder, LLVMAppendBasicBlockInContext(backend.context, function, "entry"))
    val entries = bootstrapLlvmBacktraceGlobal(backend, "abla_backtrace_entries", LLVMArrayType2(backend.i8Type, 0))
    val names = bootstrapLlvmBacktraceGlobal(backend, "abla_backtrace_names", LLVMArrayType2(backend.i8Type, 0))
    val countGlobal = bootstrapLlvmBacktraceGlobal(backend, "abla_backtrace_count", i64)
    val address = LLVMGetParam(function, 0)
    val count = LLVMBuildLoad2(backend.builder, i64, countGlobal, "count")
    val base = LLVMBuildPtrToInt(backend.builder, entries, i64, "")
    val index = LLVMBuildAlloca(backend.builder, i64, "i")
    val best = LLVMBuildAlloca(backend.builder, i64, "best")
    val bestStart = LLVMBuildAlloca(backend.builder, i64, "best.start")
    LLVMBuildStore(backend.builder, LLVMConstInt(i64, 0, 0), index)
    LLVMBuildStore(backend.builder, LLVMConstInt(i64, -1, 1), best)
    LLVMBuildStore(backend.builder, LLVMConstInt(i64, 0, 0), bestStart)
    val loop = LLVMAppendBasicBlockInContext(backend.context, function, "scan")
    val body = LLVMAppendBasicBlockInContext(backend.context, function, "entry.read")
    val better = LLVMAppendBasicBlockInContext(backend.context, function, "entry.better")
    val next = LLVMAppendBasicBlockInContext(backend.context, function, "entry.next")
    val found = LLVMAppendBasicBlockInContext(backend.context, function, "found")
    val write = LLVMAppendBasicBlockInContext(backend.context, function, "write")
    val done = LLVMAppendBasicBlockInContext(backend.context, function, "done")
    LLVMBuildBr(backend.builder, loop)
    LLVMPositionBuilderAtEnd(backend.builder, loop)
    val at = LLVMBuildLoad2(backend.builder, i64, index, "")
    // ULT (36), ULE (37), UGE (35).
    LLVMBuildCondBr(backend.builder, LLVMBuildICmp(backend.builder, 36, at, count, ""), body, found)
    LLVMPositionBuilderAtEnd(backend.builder, body)
    val entry = LLVMBuildAdd(backend.builder, base, LLVMBuildShl(backend.builder, at, LLVMConstInt(i64, 4, 0), ""), "")
    val start = LLVMBuildLoad2(backend.builder, i64, LLVMBuildIntToPtr(backend.builder, entry, backend.pointerType, ""), "")
    val current = LLVMBuildLoad2(backend.builder, i64, bestStart, "")
    LLVMBuildCondBr(backend.builder, LLVMBuildAnd(backend.builder,
        LLVMBuildICmp(backend.builder, 37, start, address, ""),
        LLVMBuildICmp(backend.builder, 35, start, current, ""), ""), better, next)
    LLVMPositionBuilderAtEnd(backend.builder, better)
    LLVMBuildStore(backend.builder, at, best)
    LLVMBuildStore(backend.builder, start, bestStart)
    LLVMBuildBr(backend.builder, next)
    LLVMPositionBuilderAtEnd(backend.builder, next)
    LLVMBuildStore(backend.builder, LLVMBuildAdd(backend.builder, at, LLVMConstInt(i64, 1, 0), ""), index)
    LLVMBuildBr(backend.builder, loop)
    LLVMPositionBuilderAtEnd(backend.builder, found)
    val chosen = LLVMBuildLoad2(backend.builder, i64, best, "")
    // Nor past the program's code (the C library's frames below main, in a program that links it): the end of its
    // text, which the linker defines (0 when it did not: no bound).
    // (On Windows, the end of the image: kernel32's and ntdll's frames lie above it.)
    val end = if (bootstrapLlvmFaultWindows(backend)) bootstrapLlvmWindowsImageEnd(backend) else {
        val endName = if (backend.macOS) "\x01section\$end\$__TEXT\$__text" else "etext"
        var textEnd = LLVMGetNamedGlobal(backend.module, endName)
        if (pointerIsNull(textEnd)) {
            textEnd = LLVMAddGlobal(backend.module, backend.i8Type, endName)
            LLVMSetLinkage(textEnd, llvmExternalWeakLinkage())
        }
        LLVMBuildPtrToInt(backend.builder, textEnd, i64, "")
    }
    // SLT (40), NE (33), UGE (35).
    val outside = LLVMBuildAnd(backend.builder, LLVMBuildICmp(backend.builder, 33, end, LLVMConstInt(i64, 0, 0), ""),
        LLVMBuildICmp(backend.builder, 35, address, end, ""), "")
    LLVMBuildCondBr(backend.builder, LLVMBuildOr(backend.builder,
        LLVMBuildICmp(backend.builder, 40, chosen, LLVMConstInt(i64, 0, 0), ""), outside, ""), done, write)
    LLVMPositionBuilderAtEnd(backend.builder, write)
    val record = LLVMBuildAdd(backend.builder, base, LLVMBuildShl(backend.builder, chosen, LLVMConstInt(i64, 4, 0), ""), "")
    val offset = LLVMBuildZExt(backend.builder, LLVMBuildLoad2(backend.builder, i32, LLVMBuildIntToPtr(backend.builder,
        LLVMBuildAdd(backend.builder, record, LLVMConstInt(i64, 8, 0), ""), backend.pointerType, ""), ""), i64, "")
    val length = LLVMBuildZExt(backend.builder, LLVMBuildLoad2(backend.builder, i32, LLVMBuildIntToPtr(backend.builder,
        LLVMBuildAdd(backend.builder, record, LLVMConstInt(i64, 12, 0), ""), backend.pointerType, ""), ""), i64, "")
    bootstrapLlvmDebugWrite(backend, " in ", "abla.backtrace.in")
    bootstrapLlvmRuntimeWrite(backend, 2, LLVMBuildIntToPtr(backend.builder,
        LLVMBuildAdd(backend.builder, LLVMBuildPtrToInt(backend.builder, names, i64, ""), offset, ""),
        backend.pointerType, ""), length)
    LLVMBuildBr(backend.builder, done)
    LLVMPositionBuilderAtEnd(backend.builder, done)
    LLVMBuildRetVoid(backend.builder)
    LLVMPositionBuilderAtEnd(backend.builder, saved)
    function
}

fun bootstrapLlvmDebugHostedRuntime(backend: BootstrapLlvmBackend): bool =
    (bootstrapLlvmDebugInfo || bootstrapLlvmBacktrace) &&
    !bootstrapTextContains(backend.targetTriple, "wasm") &&
    (backend.macOS || bootstrapTextContains(backend.targetTriple, "linux") || bootstrapLlvmFaultWindows(backend))

// SIGILL, SIGTRAP, SIGABRT, SIGFPE, SIGBUS, SIGSEGV.
fun bootstrapLlvmDebugFaultSignals(backend: BootstrapLlvmBackend): array<int> =
    if (backend.macOS) [4, 5, 6, 8, 10, 11] else [4, 5, 6, 8, 7, 11]

// The address of element `index` (a value) of a pointer array.
fun bootstrapLlvmDebugPointerElement(
    backend: BootstrapLlvmBackend,
    pointers: i64*,
    index: i64*
): i64* {
    val indices = llvmPointerVector(1)
    indices.set(0, index)
    val element = LLVMBuildGEP2(
        backend.builder, backend.pointerType, pointers, indices.pointer(), 1,
        ""
    )
    indices.drop()
    element
}

fun bootstrapLlvmDebugCall(
    backend: BootstrapLlvmBackend,
    name: string,
    result: i64*,
    parameters: array<i64*>,
    arguments: array<i64*>
): i64* = bootstrapLlvmCall(
    backend,
    bootstrapLlvmDeclare(backend, name, result, parameters, false, []),
    arguments, "", false, []
)

// In the C `main` of a debug build, before any Abla code runs: route the
// fault signals to abla_runtime_fault (defined at the end of the module).
fun bootstrapLlvmDebugInstallFaultHandlers(
    backend: BootstrapLlvmBackend
): void {
    // (Windows has no signals: the stack guard's exception handler reports every fault, bootstrapLlvmInstallStackGuard.)
    if (!bootstrapLlvmDebugHostedRuntime(backend) || bootstrapLlvmFaultWindows(backend)) return
    val fault = bootstrapLlvmDeclare(
        backend, "abla_runtime_fault", backend.voidType, [backend.i64Type],
        false, []
    )
    LLVMSetLinkage(fault, llvmInternalLinkage())
    if (bootstrapLlvmStackGuardKernel(backend)) {
        // signal()'s BSD semantics by rt_sigaction: SA_RESTART | SA_RESTORER.
        val action = bootstrapLlvmStackGuardKernelAction(
            backend, fault, 335544320, bootstrapLlvmSigreturnRestorer(backend), "fault.action"
        )
        for (signal in bootstrapLlvmDebugFaultSignals(backend)) {
            bootstrapLlvmStackGuardKernelSigaction(
                backend, LLVMConstInt(backend.i64Type, signal, 0), action
            )
        }
        return
    }
    if (bootstrapLlvmFaultDarwin(backend)) {
        // signal()'s BSD semantics: SA_RESTART (2).
        for (signal in bootstrapLlvmDebugFaultSignals(backend)) {
            bootstrapLlvmDarwinSigaction(
                backend, LLVMConstInt(backend.i64Type, signal, 0), fault, 2
            )
        }
        return
    }
    for (signal in bootstrapLlvmDebugFaultSignals(backend)) {
        bootstrapLlvmDebugCall(
            backend, "signal", backend.pointerType,
            [backend.i64Type, backend.pointerType],
            [LLVMConstInt(backend.i64Type, signal, 0), fault]
        )
    }
    return
}

// --- stack overflow ---------------------------------------------------------
// A hosted executable (macOS or Linux, with libc) turns a stack overflow into
// a panic: "panic: stack overflow" on standard error (and the stack in a debug
// build), exit status 101. Main records its frame address and installs a
// SIGSEGV/SIGBUS handler that runs on an alternate signal stack (a static
// buffer), since the overflowed stack has no room left for it. The handler
// calls a fault an overflow when its address lies at the far end of the stack:
// below the thread's stack base (macOS), or of RLIMIT_STACK below main's frame
// (Linux). Any other fault keeps its course (the debug fault report, else the
// default action). Nothing runs on the normal path. The toolchain sets
// bootstrapLlvmStackGuard for hosted, non-Wasm targets.

var bootstrapLlvmStackGuard: bool = false

// Emit the program's own entry and thread block routines (exports.ab, #806): set
// by the toolchain for every hosted x86-64 Linux executable.
var bootstrapLlvmFreestandingStart: bool = false

// Set by the toolchain for an executable of the cross target aarch64-linux (#811): its own
// start-up, system call translator and routines. Objects another build defines for an
// AArch64 Linux triple keep libc's.
var bootstrapLlvmAarch64Hosted: bool = false

// Calls C function `name` with the given signature, declaring it if the module
// doesn't have it yet. The call carries its own type, so a declaration the
// program made with other integer widths (`extern:"c" fun raise(signal: int)`)
// doesn't clash.
fun bootstrapLlvmStackGuardCall(
    backend: BootstrapLlvmBackend,
    name: string,
    result: i64*,
    parameters: array<i64*>,
    arguments: array<i64*>
): i64* {
    var function = LLVMGetNamedFunction(backend.module, name)
    if (pointerIsNull(function)) {
        function = bootstrapLlvmDeclare(
            backend, name, result, parameters, false, []
        )
    }
    bootstrapLlvmCallTyped(
        backend, bootstrapLlvmFunctionType(backend, result, parameters),
        function, arguments, ""
    )
}

fun bootstrapLlvmStackGuardRuntime(backend: BootstrapLlvmBackend): bool =
    bootstrapLlvmStackGuard &&
    !bootstrapTextContains(backend.targetTriple, "wasm") &&
    (backend.macOS || bootstrapTextContains(backend.targetTriple, "linux") || bootstrapLlvmFaultWindows(backend))

fun bootstrapLlvmSignalStackBytes(): int = 65536

// x86-64 Linux (not x32): the stack guard talks to the kernel directly, with
// sigaltstack and rt_sigaction (#806), so it needs neither libc's sigaction
// nor its restorer.
fun bootstrapLlvmStackGuardKernel(backend: BootstrapLlvmBackend): bool =
    !backend.macOS &&
    ((bootstrapTextContains(backend.targetTriple, "x86_64") &&
      bootstrapTextContains(backend.targetTriple, "linux") &&
      !bootstrapTextContains(backend.targetTriple, "gnux32")) ||
     bootstrapLlvmAarch64LinuxExecutable(backend))

// What the debug report writes to standard error and how it lists the stack: by the kernel's write and a walk of the
// frame pointers where the fault handlers are by system call too, and also in an arm64 Android library, which has
// no handlers of its own but must not import more of bionic than it needs: `backtrace` is API 33 and later, and
// its symbolised output would need libc's write (#811).
fun bootstrapLlvmDebugKernelOutput(backend: BootstrapLlvmBackend): bool =
    bootstrapLlvmStackGuardKernel(backend) || bootstrapLlvmAndroidArm64Library(backend)

// The kernel's struct sigaction on x86-64: handler, flags (SA_SIGINFO |
// SA_ONSTACK | SA_RESTORER), restorer, and an 8-byte signal mask.
fun bootstrapLlvmStackGuardKernelAction(
    backend: BootstrapLlvmBackend,
    handler: i64*,
    flags: int,
    restorer: i64*,
    name: string
): i64* {
    val actionType = LLVMArrayType2(backend.i8Type, 32)
    val action = LLVMBuildAlloca(backend.builder, actionType, name)
    LLVMBuildStore(backend.builder, LLVMConstNull(actionType), action)
    LLVMBuildStore(backend.builder, handler, action)
    LLVMBuildStore(
        backend.builder, LLVMConstInt(backend.i64Type, flags, 0),
        bootstrapLlvmByteAt(backend, action, 32, 8)
    )
    // (AArch64's kernel struct has the same fields; its restorer is ignored and null here.)
    LLVMBuildStore(
        backend.builder, restorer, bootstrapLlvmByteAt(backend, action, 32, 16)
    )
    action
}

// The rt_sigreturn trampoline an x86-64 Linux signal handler returns through
// (the kernel's SA_RESTORER), declared on first use.
fun bootstrapLlvmSigreturnRestorer(backend: BootstrapLlvmBackend): i64* {
    if (bootstrapLlvmAarch64LinuxExecutable(backend)) {
        return LLVMConstNull(backend.pointerType)
    }
    var restorer = LLVMGetNamedFunction(backend.module, "abla_runtime_sigreturn")
    if (pointerIsNull(restorer)) {
        restorer = bootstrapLlvmDeclare(
            backend, "abla_runtime_sigreturn", backend.voidType, [], false, []
        )
        LLVMSetLinkage(restorer, llvmInternalLinkage())
    }
    restorer
}

// Defines the trampoline when something took its address: no frame, just
// rt_sigreturn (15).
fun bootstrapLlvmEmitSigreturnRestorer(backend: BootstrapLlvmBackend): void {
    bootstrapLlvmEmitDarwinSigtramp(backend)
    val restorer = LLVMGetNamedFunction(backend.module, "abla_runtime_sigreturn")
    if (pointerIsNull(restorer) || LLVMIsDeclaration(restorer) == 0) return
    LLVMPositionBuilderAtEnd(
        backend.builder,
        LLVMAppendBasicBlockInContext(backend.context, restorer, "entry")
    )
    bootstrapLlvmAddFunctionAttribute(backend, restorer, "naked")
    bootstrapLlvmAddFunctionAttribute(backend, restorer, "noinline")
    bootstrapLlvmAddFunctionAttribute(backend, restorer, "nounwind")
    val restorerType = bootstrapLlvmFunctionType(backend, backend.voidType, [])
    val trampoline = "movq $$15, %rax\n\tsyscall"
    bootstrapLlvmCallTyped(
        backend, restorerType,
        LLVMGetInlineAsm(restorerType, trampoline, trampoline.size, "", 0, 1, 0, 0, 0),
        [], ""
    )
    LLVMBuildUnreachable(backend.builder)
    return
}

// write(descriptor, text, size) on standard error or another descriptor: the
// system call on x86-64 Linux, libc's write elsewhere.
fun bootstrapLlvmRuntimeWrite(
    backend: BootstrapLlvmBackend,
    descriptor: int,
    text: i64*,
    size: i64*
): void {
    val fd = LLVMConstInt(backend.i64Type, descriptor, 0)
    if (bootstrapLlvmDebugKernelOutput(backend)) {
        bootstrapLlvmLinuxX64Syscall(backend, 1, [fd, text, size])
    } else if (bootstrapLlvmFaultDarwin(backend)) {
        bootstrapLlvmDarwinSyscallBy(backend, 4, [fd, text, size])
    } else if (bootstrapLlvmFaultWindows(backend)) {
        // kernel32's WriteFile on the standard handle (-12 error, -11 output), the count written to a word of its own
        // (an exception handler need not be reentrant with the program's writes).
        val handle = bootstrapLlvmWindowsCall(backend, "GetStdHandle",
            [LLVMConstInt(backend.i64Type, if (descriptor == 2) -12 else -11, 1)])
        val i64 = backend.i64Type
        bootstrapLlvmWindowsCall(backend, "WriteFile", [handle, LLVMBuildPtrToInt(backend.builder, text, i64, ""), size,
            LLVMBuildPtrToInt(backend.builder, bootstrapLlvmFaultWord(backend, "abla_runtime_windows_written"), i64, ""),
            LLVMConstInt(i64, 0, 0)])
    } else {
        bootstrapLlvmDebugCall(
            backend, "write", backend.i64Type,
            [backend.i64Type, backend.pointerType, backend.i64Type],
            [fd, text, size]
        )
    }
    return
}

// rt_sigaction(signal, action, NULL, sizeof the kernel's signal mask).
fun bootstrapLlvmStackGuardKernelSigaction(
    backend: BootstrapLlvmBackend,
    signal: i64*,
    action: i64*
): void {
    val zero = LLVMConstInt(backend.i64Type, 0, 0)
    bootstrapLlvmLinuxX64Syscall(
        backend, 13, [signal, action, zero, LLVMConstInt(backend.i64Type, 8, 0)]
    )
    return
}

// macOS (#811 group 6): the fault handlers are installed by the BSD system calls
// sigaltstack (53) and sigaction (46), with the program's own signal trampoline
// instead of libSystem's. The kernel's struct __sigaction is {handler (8), trampoline
// (8), mask (4), flags (4)}; the trampoline is entered with the handler, the
// info style, the signal, the siginfo and the ucontext, calls handler(signal,
// info, ucontext) and returns through sigreturn (184) with the ucontext and
// the style. Unverified until the macOS job runs: those numbers, that layout and the
// trampoline's register use.
fun bootstrapLlvmFaultDarwin(backend: BootstrapLlvmBackend): bool =
    bootstrapLlvmDarwinSyscallTarget(backend)

fun bootstrapLlvmDarwinSyscallBy(
    backend: BootstrapLlvmBackend,
    number: int,
    arguments: array<i64*>
): i64* {
    val values: array<i64*> = [LLVMConstInt(backend.i64Type, number, 0)]
    for (argument in arguments) {
        values.append(if (LLVMTypeOf(argument) == backend.pointerType) {
            LLVMBuildPtrToInt(backend.builder, argument, backend.i64Type, "syscall.pointer")
        } else argument)
    }
    while (values.size < 7) values.append(LLVMConstInt(backend.i64Type, 0, 0))
    bootstrapLlvmInlineDarwinSyscall(backend, values, "darwin.fault.syscall")
}

// The trampoline's address, declared on first use.
fun bootstrapLlvmDarwinSigtramp(backend: BootstrapLlvmBackend): i64* {
    var tramp = LLVMGetNamedFunction(backend.module, "abla_runtime_sigtramp")
    if (pointerIsNull(tramp)) {
        tramp = bootstrapLlvmDeclare(
            backend, "abla_runtime_sigtramp", backend.voidType, [], false, []
        )
        LLVMSetLinkage(tramp, llvmInternalLinkage())
    }
    tramp
}

// Defines the trampoline when something took its address. arm64 receives
// x0 handler, x1 style, x2 signal, x3 info, x4 ucontext; x86-64 rdi, esi, edx,
// rcx, r8. Neither returns, so the registers it keeps across the handler call are
// free to clobber.
fun bootstrapLlvmEmitDarwinSigtramp(backend: BootstrapLlvmBackend): void {
    val tramp = LLVMGetNamedFunction(backend.module, "abla_runtime_sigtramp")
    if (pointerIsNull(tramp) || LLVMIsDeclaration(tramp) == 0) return
    LLVMPositionBuilderAtEnd(
        backend.builder,
        LLVMAppendBasicBlockInContext(backend.context, tramp, "entry")
    )
    bootstrapLlvmAddFunctionAttribute(backend, tramp, "naked")
    bootstrapLlvmAddFunctionAttribute(backend, tramp, "noinline")
    bootstrapLlvmAddFunctionAttribute(backend, tramp, "nounwind")
    val type = bootstrapLlvmFunctionType(backend, backend.voidType, [])
    val arm = !bootstrapTextContains(backend.targetTriple, "x86_64")
    val code = if (arm)
        "mov x19, x4\n\tmov x20, x1\n\tmov x5, x0\n\tmov x0, x2\n\tmov x1, x3\n\tmov x2, x4\n\tblr x5\n\tmov x0, x19\n\tmov x1, x20\n\tmov x16, #184\n\tsvc #0x80\n\tbrk #1"
        else "movq %r8, %r12\n\tmovl %esi, %r13d\n\tmovq %rdi, %rax\n\tmovl %edx, %edi\n\tmovq %rcx, %rsi\n\tmovq %r12, %rdx\n\tandq $$-16, %rsp\n\tcallq *%rax\n\tmovq %r12, %rdi\n\tmovl %r13d, %esi\n\tmovl $$33554616, %eax\n\tsyscall\n\tud2"
    bootstrapLlvmCallTyped(
        backend, type,
        LLVMGetInlineAsm(type, code, code.size, "", 0, 1, 0, 0, 0),
        [], ""
    )
    LLVMBuildUnreachable(backend.builder)
    return
}

// sigaction(signal, {handler, trampoline, mask 0, flags}, NULL).
fun bootstrapLlvmDarwinSigaction(
    backend: BootstrapLlvmBackend,
    signal: i64*,
    handler: i64*,
    flags: int
): void {
    val actionType = LLVMArrayType2(backend.i8Type, 24)
    val action = LLVMBuildAlloca(backend.builder, actionType, "darwin.action")
    LLVMBuildStore(backend.builder, LLVMConstNull(actionType), action)
    LLVMBuildStore(backend.builder, handler, action)
    LLVMBuildStore(
        backend.builder, bootstrapLlvmDarwinSigtramp(backend),
        bootstrapLlvmByteAt(backend, action, 24, 8)
    )
    LLVMBuildStore(
        backend.builder, LLVMConstInt(backend.i32Type, flags, 0),
        bootstrapLlvmByteAt(backend, action, 24, 20)
    )
    bootstrapLlvmDarwinSyscallBy(
        backend, 46, [signal, action, LLVMConstInt(backend.i64Type, 0, 0)]
    )
    return
}

// signal(signal, SIG_DFL) by sigaction: an all-zero struct.
fun bootstrapLlvmDarwinSigDefault(backend: BootstrapLlvmBackend, signal: i64*): void {
    val actionType = LLVMArrayType2(backend.i8Type, 24)
    val action = LLVMBuildAlloca(backend.builder, actionType, "darwin.default")
    LLVMBuildStore(backend.builder, LLVMConstNull(actionType), action)
    bootstrapLlvmDarwinSyscallBy(
        backend, 46, [signal, action, LLVMConstInt(backend.i64Type, 0, 0)]
    )
    return
}

// The address `offset` bytes into a byte buffer of `bytes` bytes.
fun bootstrapLlvmByteAt(
    backend: BootstrapLlvmBackend,
    buffer: i64*,
    bytes: int,
    offset: int
): i64* = bootstrapLlvmArrayElement(
    backend, LLVMArrayType2(backend.i8Type, bytes), buffer, offset, ""
)

fun bootstrapLlvmStackGuardGlobal(
    backend: BootstrapLlvmBackend,
    name: string,
    type: i64*
): i64* {
    var global = LLVMGetNamedGlobal(backend.module, name)
    if (pointerIsNull(global)) {
        global = LLVMAddGlobal(backend.module, type, name)
        LLVMSetInitializer(global, LLVMConstNull(type))
        LLVMSetLinkage(global, llvmInternalLinkage())
        LLVMSetAlignment(global, 16)
    }
    global
}

// In the C `main`, before any Abla code runs: record the stack top, give the
// thread an alternate signal stack and route SIGSEGV and SIGBUS to
// abla_runtime_stack_fault (defined after every other body).
fun bootstrapLlvmInstallStackGuard(backend: BootstrapLlvmBackend): void {
    if (!bootstrapLlvmStackGuardRuntime(backend)) return
    if (bootstrapLlvmFaultWindows(backend)) {
        // AddVectoredExceptionHandler(1: first in the chain, abla_runtime_windows_fault).
        val handler = bootstrapLlvmDeclare(
            backend, "abla_runtime_windows_fault", backend.i32Type, [backend.pointerType], false, []
        )
        LLVMSetLinkage(handler, llvmInternalLinkage())
        bootstrapLlvmWindowsCall(backend, "AddVectoredExceptionHandler", [LLVMConstInt(backend.i64Type, 1, 0),
            LLVMBuildPtrToInt(backend.builder, handler, backend.i64Type, "")])
        return
    }
    val mac = backend.macOS
    val top = bootstrapLlvmStackGuardGlobal(
        backend, "abla_runtime_stack_top", backend.i64Type
    )
    val frame = bootstrapLlvmStackGuardCall(
        backend, "llvm.frameaddress.p0", backend.pointerType,
        [backend.i32Type], [LLVMConstInt(backend.i32Type, 0, 0)]
    )
    LLVMBuildStore(
        backend.builder,
        LLVMBuildPtrToInt(backend.builder, frame, backend.i64Type, ""),
        top
    )
    // stack_t: macOS {sp, size, flags}, Linux {sp, flags, size}.
    val signalStack = bootstrapLlvmStackGuardGlobal(
        backend, "abla_runtime_signal_stack",
        LLVMArrayType2(backend.i8Type, bootstrapLlvmSignalStackBytes())
    )
    val stackType = LLVMArrayType2(backend.i8Type, 32)
    val stack = LLVMBuildAlloca(backend.builder, stackType, "signal.stack")
    LLVMBuildStore(
        backend.builder, LLVMConstNull(stackType), stack
    )
    LLVMBuildStore(backend.builder, signalStack, stack)
    LLVMBuildStore(
        backend.builder,
        LLVMConstInt(backend.i64Type, bootstrapLlvmSignalStackBytes(), 0),
        bootstrapLlvmByteAt(backend, stack, 32, if (mac) 8 else 16)
    )
    val kernel = bootstrapLlvmStackGuardKernel(backend)
    if (kernel) {
        bootstrapLlvmLinuxX64Syscall(
            backend, 131, [stack, LLVMConstInt(backend.i64Type, 0, 0)]
        )
    } else if (bootstrapLlvmFaultDarwin(backend)) {
        bootstrapLlvmDarwinSyscallBy(
            backend, 53, [stack, LLVMConstInt(backend.i64Type, 0, 0)]
        )
    } else {
        bootstrapLlvmStackGuardCall(
            backend, "sigaltstack", backend.i32Type,
            [backend.pointerType, backend.pointerType],
            [stack, LLVMConstNull(backend.pointerType)]
        )
    }
    // struct sigaction: the handler first; sa_flags at 12 (macOS) or 136
    // (Linux, after a 128-byte mask). SA_SIGINFO | SA_ONSTACK.
    val actionType = LLVMArrayType2(backend.i8Type, 160)
    val action = LLVMBuildAlloca(backend.builder, actionType, "signal.action")
    LLVMBuildStore(backend.builder, LLVMConstNull(actionType), action)
    val handler = bootstrapLlvmDeclare(
        backend, "abla_runtime_stack_fault", backend.voidType,
        [backend.i32Type, backend.pointerType, backend.pointerType],
        false, []
    )
    LLVMSetLinkage(handler, llvmInternalLinkage())
    if (bootstrapLlvmCompactLinuxRuntime(backend)) {
        bootstrapLlvmAddFunctionAttribute(backend, handler, "optsize")
        bootstrapLlvmAddFunctionAttribute(backend, handler, "minsize")
    }
    if (kernel) {
        // SA_SIGINFO (4) | SA_ONSTACK (0x08000000) | SA_RESTORER (0x04000000):
        // the handler returns through abla_runtime_sigreturn, rt_sigreturn.
        val restorer = bootstrapLlvmSigreturnRestorer(backend)
        val kernelAction = bootstrapLlvmStackGuardKernelAction(
            backend, handler,
            if (bootstrapLlvmAarch64LinuxExecutable(backend)) 134217732 else 201326596,
            restorer, "signal.kernel.action"
        )
        for (signal in [11, 7]) {
            bootstrapLlvmStackGuardKernelSigaction(
                backend, LLVMConstInt(backend.i64Type, signal, 0), kernelAction
            )
        }
        return
    }
    if (bootstrapLlvmFaultDarwin(backend)) {
        // SA_SIGINFO (0x40) | SA_ONSTACK (1).
        for (signal in [11, 10]) {
            bootstrapLlvmDarwinSigaction(
                backend, LLVMConstInt(backend.i64Type, signal, 0), handler, 65
            )
        }
        return
    }
    LLVMBuildStore(backend.builder, handler, action)
    LLVMBuildStore(
        backend.builder,
        LLVMConstInt(backend.i32Type, if (mac) 65 else 134217732, 0),
        bootstrapLlvmByteAt(backend, action, 160, if (mac) 12 else 136)
    )
    for (signal in [11, if (mac) 10 else 7]) {
        bootstrapLlvmStackGuardCall(
            backend, "sigaction", backend.i32Type,
            [backend.i32Type, backend.pointerType, backend.pointerType],
            [LLVMConstInt(backend.i32Type, signal, 0), action,
             LLVMConstNull(backend.pointerType)]
        )
    }
    return
}

// --- Windows (x86_64-windows-hosted, W1c) -------------------------------------------------------------------------
// A Windows executable has no signals. Main installs a vectored exception handler first in the chain
// (bootstrapLlvmInstallStackGuard), abla_runtime_windows_fault, which reports an exception the program's own code
// raised: its address (ExceptionAddress) inside the image, from __ImageBase to the image's SizeOfImage, and its code an
// error or a warning (bit 31). Any other exception (one a system library raises and handles itself, a debugger's
// breakpoint in its code) continues the search. The report is Linux's:
//   - a stack overflow (STATUS_STACK_OVERFLOW, 0xC00000FD): "panic: stack overflow", exit status 101 (without the
//     stack: the handler runs on what is left of the overflowed one);
//   - an access violation (0xC0000005): "fatal signal: a bad memory access at 0x...", the address its
//     ExceptionInformation[1] names;
//   - any other: "fatal signal: Windows exception 0x..." with its code;
// then, in a -g or --backtrace build, the stack from the interrupted context (bootstrapLlvmEmitWindowsStackWalk). The
// process ends by TerminateProcess with the exception's code as its status, as Windows' default action would end it,
// without the system's error reporting (or, under Wine, winedbg).

fun bootstrapLlvmFaultWindows(backend: BootstrapLlvmBackend): bool = bootstrapLlvmTargetIsWindows(backend.targetTriple)

// A kernel32 function taking and returning integers (a pointer as its address), declared on first use, as the
// runtime's own declarations (platform/windows/entry.ab) have them.
fun bootstrapLlvmWindowsCall(backend: BootstrapLlvmBackend, name: string, arguments: array<i64*>): i64* {
    val parameters: array<i64*> = []
    for (argument in arguments) parameters.append(backend.i64Type)
    bootstrapLlvmStackGuardCall(backend, name, backend.i64Type, parameters, arguments)
}

// The value of `type` at `address` (an integer).
fun bootstrapLlvmLoadAddress(backend: BootstrapLlvmBackend, type: i64*, address: i64*): i64* =
    LLVMBuildLoad2(backend.builder, type, LLVMBuildIntToPtr(backend.builder, address, backend.pointerType, ""), "")

// The image's load address: the linker's __ImageBase (its DOS header).
fun bootstrapLlvmWindowsImageBase(backend: BootstrapLlvmBackend): i64* {
    var base = LLVMGetNamedGlobal(backend.module, "__ImageBase")
    if (pointerIsNull(base)) {
        base = LLVMAddGlobal(backend.module, backend.i8Type, "__ImageBase")
        // Hidden: in this image, reached directly (dso_local).
        LLVMSetVisibility(base, llvmHiddenVisibility())
    }
    LLVMBuildPtrToInt(backend.builder, base, backend.i64Type, "image.base")
}

// The address just past the image: __ImageBase + SizeOfImage, the optional header's (at 0x50 in the NT headers, which
// e_lfanew at 0x3C places).
fun bootstrapLlvmWindowsImageEnd(backend: BootstrapLlvmBackend): i64* {
    val i64 = backend.i64Type
    val builder = backend.builder
    val base = bootstrapLlvmWindowsImageBase(backend)
    val headers = LLVMBuildAdd(builder, base, LLVMBuildZExt(builder, bootstrapLlvmLoadAddress(backend, backend.i32Type,
        LLVMBuildAdd(builder, base, LLVMConstInt(i64, 60, 0), "")), i64, ""), "")
    val size = LLVMBuildZExt(builder, bootstrapLlvmLoadAddress(backend, backend.i32Type,
        LLVMBuildAdd(builder, headers, LLVMConstInt(i64, 80, 0), "")), i64, "")
    LLVMBuildAdd(builder, base, size, "image.end")
}

// A word of the thread's TEB, by the gs segment (address space 256): the stack's base (highest address) at 8, its
// limit at 16.
fun bootstrapLlvmWindowsThreadWord(backend: BootstrapLlvmBackend, offset: int): i64* {
    val segment = LLVMPointerTypeInContext(backend.context, i32(256))
    LLVMBuildLoad2(backend.builder, backend.i64Type,
        LLVMBuildIntToPtr(backend.builder, LLVMConstInt(backend.i64Type, offset, 0), segment, ""), "")
}

// abla_runtime_windows_fault(EXCEPTION_POINTERS*), when main installed it: EXCEPTION_POINTERS {ExceptionRecord,
// ContextRecord}, EXCEPTION_RECORD {ExceptionCode (32 bits) at 0, ExceptionAddress at 16, NumberParameters (32 bits) at
// 24, ExceptionInformation at 32}. Returns 0 (EXCEPTION_CONTINUE_SEARCH) for an exception it does not report.
fun bootstrapLlvmEmitWindowsFaultHandler(backend: BootstrapLlvmBackend): void {
    val handler = LLVMGetNamedFunction(backend.module, "abla_runtime_windows_fault")
    if (pointerIsNull(handler) || LLVMIsDeclaration(handler) == 0) return
    val i64 = backend.i64Type
    val i32 = backend.i32Type
    val builder = backend.builder
    LLVMPositionBuilderAtEnd(builder, LLVMAppendBasicBlockInContext(backend.context, handler, "entry"))
    val pointers = LLVMGetParam(handler, 0)
    val record = LLVMBuildLoad2(builder, backend.pointerType, pointers, "record")
    val context = LLVMBuildLoad2(builder, backend.pointerType, bootstrapLlvmByteAt(backend, pointers, 16, 8), "context")
    val code = LLVMBuildZExt(builder, LLVMBuildLoad2(builder, i32, record, "code"), i64, "")
    val at = LLVMBuildLoad2(builder, i64, bootstrapLlvmByteAt(backend, record, 152, 16), "at")
    val base = bootstrapLlvmWindowsImageBase(backend)
    // ULT (36), NE (33), EQ (32), UGE (35).
    val inImage = LLVMBuildICmp(builder, 36, LLVMBuildSub(builder, at, base, ""),
        LLVMBuildSub(builder, bootstrapLlvmWindowsImageEnd(backend), base, ""), "in.image")
    val severe = LLVMBuildICmp(builder, 33, LLVMBuildAnd(builder, code, LLVMConstInt(i64, 2147483648, 0), ""),
        LLVMConstInt(i64, 0, 0), "severe")
    val report = LLVMAppendBasicBlockInContext(backend.context, handler, "report")
    val pass = LLVMAppendBasicBlockInContext(backend.context, handler, "pass")
    LLVMBuildCondBr(builder, LLVMBuildAnd(builder, inImage, severe, ""), report, pass)
    LLVMPositionBuilderAtEnd(builder, pass)
    LLVMBuildRet(builder, LLVMConstInt(i32, 0, 0))
    LLVMPositionBuilderAtEnd(builder, report)
    val overflowed = LLVMAppendBasicBlockInContext(backend.context, handler, "overflow")
    val fault = LLVMAppendBasicBlockInContext(backend.context, handler, "fault")
    // The current process (the pseudo-handle -1).
    val process = LLVMConstInt(i64, -1, 1)
    LLVMBuildCondBr(builder, LLVMBuildICmp(builder, 32, code, LLVMConstInt(i64, 3221225725, 0), ""), overflowed, fault)
    LLVMPositionBuilderAtEnd(builder, overflowed)
    bootstrapLlvmDebugWrite(backend, "panic: stack overflow\n", "abla.stack.overflow.windows")
    bootstrapLlvmWindowsCall(backend, "TerminateProcess", [process, LLVMConstInt(i64, 101, 0)])
    LLVMBuildUnreachable(builder)
    LLVMPositionBuilderAtEnd(builder, fault)
    val hosted = bootstrapLlvmDebugHostedRuntime(backend)
    // A debug report starts on a line of its own, as Linux's (abla_runtime_fault).
    val lead = if (hosted) "\n" else ""
    val named = LLVMAppendBasicBlockInContext(backend.context, handler, "fault.access")
    val generic = LLVMAppendBasicBlockInContext(backend.context, handler, "fault.generic")
    val stack = LLVMAppendBasicBlockInContext(backend.context, handler, "fault.stack")
    val parameterCount = LLVMBuildZExt(builder,
        LLVMBuildLoad2(builder, i32, bootstrapLlvmByteAt(backend, record, 152, 24), ""), i64, "")
    val access = LLVMBuildAnd(builder, LLVMBuildICmp(builder, 32, code, LLVMConstInt(i64, 3221225477, 0), ""),
        LLVMBuildICmp(builder, 35, parameterCount, LLVMConstInt(i64, 2, 0), ""), "access")
    LLVMBuildCondBr(builder, access, named, generic)
    LLVMPositionBuilderAtEnd(builder, named)
    bootstrapLlvmDebugWrite(backend, "${lead}fatal signal: a bad memory access at ", "abla.fault.access.windows")
    bootstrapLlvmWriteHexCompact(backend, LLVMBuildLoad2(builder, i64, bootstrapLlvmByteAt(backend, record, 152, 40), ""))
    LLVMBuildBr(builder, stack)
    LLVMPositionBuilderAtEnd(builder, generic)
    bootstrapLlvmDebugWrite(backend, "${lead}fatal signal: Windows exception ", "abla.fault.exception.windows")
    bootstrapLlvmWriteHexCompact(backend, code)
    LLVMBuildBr(builder, stack)
    LLVMPositionBuilderAtEnd(builder, stack)
    if (hosted) {
        // The walk starts at the faulting instruction (abla_runtime_fault_pc, printed first) and unwinds from the
        // interrupted context (abla_runtime_fault_context).
        LLVMBuildStore(builder, at, bootstrapLlvmFaultPcGlobal(backend))
        LLVMBuildStore(builder, LLVMBuildPtrToInt(builder, context, i64, ""),
            bootstrapLlvmFaultWord(backend, "abla_runtime_fault_context"))
        bootstrapLlvmStackGuardCall(backend, "abla_runtime_print_stack", backend.voidType, [], [])
    }
    bootstrapLlvmWindowsCall(backend, "TerminateProcess", [process, code])
    LLVMBuildRet(builder, LLVMConstInt(i32, 0, 0))
    return
}

// The stack on Windows, by the system's unwinder over the image's unwind data (.pdata: every function of a -g or
// --backtrace image has it, bootstrapLlvmWindowsUnwindTables): a CONTEXT (1232 bytes, 16-aligned; Rsp at 152, Rip at
// 248), the fault's (abla_runtime_fault_context) or this function's own (RtlCaptureContext), is stepped a frame at a
// time by RtlLookupFunctionEntry and RtlVirtualUnwind, and each return address is printed less one, so it falls inside
// the call, as Linux's walk prints them. (Win64 code does not keep a frame-pointer chain: LLVM's rbp points into the
// frame, not at the saved rbp.) A function without unwind data is a leaf, its return address at the stack pointer,
// read only within this thread's stack (the TEB's bounds). The walk skips the context's own frame (the faulting
// instruction, printed first, or this function), and ends at a null pc, a stack pointer that does not rise, or after 64
// frames.
fun bootstrapLlvmEmitWindowsStackWalk(backend: BootstrapLlvmBackend, printStack: i64*): void {
    val i64 = backend.i64Type
    val builder = backend.builder
    bootstrapLlvmDebugWrite(
        backend,
        "stack (return addresses: subtract the load address, then llvm-symbolizer on the program gives file:line):\n",
        "abla.stack.header"
    )
    bootstrapLlvmWalkFaultPc(backend, printStack)
    val context = LLVMBuildAlloca(builder, LLVMArrayType2(backend.i8Type, 1232), "context")
    LLVMSetAlignment(context, 16)
    val contextAddress = LLVMBuildPtrToInt(builder, context, i64, "")
    val imageBase = LLVMBuildAlloca(builder, i64, "unwind.base")
    val handlerData = LLVMBuildAlloca(builder, i64, "unwind.data")
    val establisher = LLVMBuildAlloca(builder, i64, "unwind.frame")
    val skip = LLVMBuildAlloca(builder, i64, "skip")
    LLVMBuildStore(builder, LLVMConstInt(i64, 1, 0), skip)
    val counter = LLVMBuildAlloca(builder, i64, "n")
    LLVMBuildStore(builder, LLVMConstInt(i64, 0, 0), counter)
    val faultContext = LLVMBuildLoad2(builder, i64, bootstrapLlvmFaultWord(backend, "abla_runtime_fault_context"), "")
    val copy = LLVMAppendBasicBlockInContext(backend.context, printStack, "context.copy")
    val capture = LLVMAppendBasicBlockInContext(backend.context, printStack, "context.capture")
    val loop = LLVMAppendBasicBlockInContext(backend.context, printStack, "walk")
    val body = LLVMAppendBasicBlockInContext(backend.context, printStack, "frame")
    val show = LLVMAppendBasicBlockInContext(backend.context, printStack, "show")
    val step = LLVMAppendBasicBlockInContext(backend.context, printStack, "step")
    val unwind = LLVMAppendBasicBlockInContext(backend.context, printStack, "unwind")
    val leaf = LLVMAppendBasicBlockInContext(backend.context, printStack, "leaf")
    val leafRead = LLVMAppendBasicBlockInContext(backend.context, printStack, "leaf.read")
    val moved = LLVMAppendBasicBlockInContext(backend.context, printStack, "moved")
    val stop = LLVMAppendBasicBlockInContext(backend.context, printStack, "stop")
    val done = LLVMAppendBasicBlockInContext(backend.context, printStack, "walked")
    // NE (33), ULT (36), ULE (37).
    LLVMBuildCondBr(builder, LLVMBuildICmp(builder, 33, faultContext, LLVMConstInt(i64, 0, 0), ""), copy, capture)
    LLVMPositionBuilderAtEnd(builder, copy)
    LLVMBuildMemCpy(builder, context, i32(16), LLVMBuildIntToPtr(builder, faultContext, backend.pointerType, ""), i32(16),
        LLVMConstInt(i64, 1232, 0))
    LLVMBuildBr(builder, loop)
    LLVMPositionBuilderAtEnd(builder, capture)
    bootstrapLlvmWindowsCall(backend, "RtlCaptureContext", [contextAddress])
    LLVMBuildBr(builder, loop)
    LLVMPositionBuilderAtEnd(builder, loop)
    val pc = LLVMBuildLoad2(builder, i64, bootstrapLlvmByteAt(backend, context, 1232, 248), "pc")
    val count = LLVMBuildLoad2(builder, i64, counter, "")
    LLVMBuildCondBr(builder, LLVMBuildAnd(builder,
        LLVMBuildICmp(builder, 33, pc, LLVMConstInt(i64, 0, 0), ""),
        LLVMBuildICmp(builder, 36, count, LLVMConstInt(i64, 64, 0), ""), ""), body, done)
    LLVMPositionBuilderAtEnd(builder, body)
    val skipping = LLVMBuildLoad2(builder, i64, skip, "")
    LLVMBuildStore(builder, LLVMConstInt(i64, 0, 0), skip)
    LLVMBuildCondBr(builder, LLVMBuildICmp(builder, 33, skipping, LLVMConstInt(i64, 0, 0), ""), step, show)
    LLVMPositionBuilderAtEnd(builder, show)
    val inCall = LLVMBuildSub(builder, pc, LLVMConstInt(i64, 1, 0), "")
    bootstrapLlvmDebugWriteHex(backend, inCall)
    if (bootstrapLlvmBacktrace) {
        bootstrapLlvmCall(backend, bootstrapLlvmBacktraceNameFunction(backend), [inCall], "", false, [])
    }
    bootstrapLlvmDebugWrite(backend, "\n", "abla.stack.end")
    LLVMBuildStore(builder, LLVMBuildAdd(builder, count, LLVMConstInt(i64, 1, 0), ""), counter)
    LLVMBuildBr(builder, step)
    LLVMPositionBuilderAtEnd(builder, step)
    val stackPointerAt = bootstrapLlvmByteAt(backend, context, 1232, 152)
    val pcAt = bootstrapLlvmByteAt(backend, context, 1232, 248)
    val stackPointer = LLVMBuildLoad2(builder, i64, stackPointerAt, "sp")
    val entry = bootstrapLlvmWindowsCall(backend, "RtlLookupFunctionEntry",
        [pc, LLVMBuildPtrToInt(builder, imageBase, i64, ""), LLVMConstInt(i64, 0, 0)])
    LLVMBuildCondBr(builder, LLVMBuildICmp(builder, 33, entry, LLVMConstInt(i64, 0, 0), ""), unwind, leaf)
    LLVMPositionBuilderAtEnd(builder, unwind)
    // RtlVirtualUnwind(UNW_FLAG_NHANDLER, image base, pc, entry, context, &handler data, &establisher frame, NULL).
    bootstrapLlvmWindowsCall(backend, "RtlVirtualUnwind", [LLVMConstInt(i64, 0, 0),
        LLVMBuildLoad2(builder, i64, imageBase, ""), pc, entry, contextAddress,
        LLVMBuildPtrToInt(builder, handlerData, i64, ""), LLVMBuildPtrToInt(builder, establisher, i64, ""),
        LLVMConstInt(i64, 0, 0)])
    LLVMBuildBr(builder, moved)
    LLVMPositionBuilderAtEnd(builder, leaf)
    val limit = bootstrapLlvmWindowsThreadWord(backend, 16)
    val inside = LLVMBuildICmp(builder, 36, LLVMBuildSub(builder, stackPointer, limit, ""),
        LLVMBuildSub(builder, LLVMBuildSub(builder, bootstrapLlvmWindowsThreadWord(backend, 8), limit, ""),
            LLVMConstInt(i64, 8, 0), ""), "")
    LLVMBuildCondBr(builder, inside, leafRead, stop)
    LLVMPositionBuilderAtEnd(builder, leafRead)
    LLVMBuildStore(builder, bootstrapLlvmLoadAddress(backend, i64, stackPointer), pcAt)
    LLVMBuildStore(builder, LLVMBuildAdd(builder, stackPointer, LLVMConstInt(i64, 8, 0), ""), stackPointerAt)
    LLVMBuildBr(builder, moved)
    LLVMPositionBuilderAtEnd(builder, moved)
    // Only upward: a stack pointer that did not rise ends the walk.
    LLVMBuildCondBr(builder, LLVMBuildICmp(builder, 37, LLVMBuildLoad2(builder, i64, stackPointerAt, ""), stackPointer, ""),
        stop, loop)
    LLVMPositionBuilderAtEnd(builder, stop)
    LLVMBuildStore(builder, LLVMConstInt(i64, 0, 0), pcAt)
    LLVMBuildBr(builder, loop)
    LLVMPositionBuilderAtEnd(builder, done)
    bootstrapLlvmDebugWrite(backend, "load address ", "abla.stack.load")
    bootstrapLlvmDebugWriteHex(backend, bootstrapLlvmWindowsImageBase(backend))
    bootstrapLlvmDebugWrite(backend, "\n", "abla.stack.end")
    return
}

// Unwind data (.pdata, .xdata) for every function the module defines (uwtable, asynchronous): what the walk steps
// through frames by. Code without it is taken for a leaf.
fun bootstrapLlvmWindowsUnwindTables(backend: BootstrapLlvmBackend): void {
    val kind = bootstrapLlvmAttributeKind("uwtable")
    var function = LLVMGetFirstFunction(backend.module)
    while (!pointerIsNull(function)) {
        if (LLVMIsDeclaration(function) == 0) {
            LLVMAddAttributeAtIndex(function, -1, LLVMCreateEnumAttribute(backend.context, kind, 2))
        }
        function = LLVMGetNextFunction(function)
    }
    return
}

// abla_runtime_stack_fault(signal, siginfo, context), when main installed it.
// Whether the kernel raised the fault the stack guard's handler is in (true: its si_addr is the bad address), not a
// process sending it (raise, kill): si_code (at 8 in `info`, Linux and macOS) a fault's own code, 1 to 15 (SEGV_MAPERR
// 1, ... BUS_OBJERR 3; Linux's go to 9), not SI_USER (0 on Linux, 0x10001 on macOS), another sender's or Linux's
// SI_KERNEL (0x80). On Apple Silicon, XNU gives every SIGSEGV and SIGBUS a fault's code and the fault address
// register, sent or not (CI, both arm64 runs: a raised SIGSEGV named an address); there the machine context's
// exception syndrome (`machine`, the mcontext: __es.__esr at 8) tells them apart. A fault's exception class (ESR bits
// 26 to 31) is an abort: instruction 0x20, PC alignment 0x22, data 0x24, SP alignment 0x26 (ec & 0x39 == 0x20); a
// sent signal arrives after a system call (SVC, 0x15).
fun bootstrapLlvmFaultRaised(backend: BootstrapLlvmBackend, info: i64*, machine: i64*): i64* {
    val i32 = backend.i32Type
    val code = LLVMBuildLoad2(backend.builder, i32, bootstrapLlvmByteAt(backend, info, 32, 8), "fault.code")
    // code - 1 ULT (36) 15: 1 to 15.
    val faultCode = LLVMBuildICmp(backend.builder, 36,
        LLVMBuildSub(backend.builder, code, LLVMConstInt(i32, 1, 0), ""), LLVMConstInt(i32, 15, 0), "")
    if (!(backend.macOS && bootstrapLlvmMachOIsArm(backend.targetTriple))) return faultCode
    val syndrome = LLVMBuildLoad2(backend.builder, i32, bootstrapLlvmByteAt(backend, machine, 16, 8), "fault.esr")
    val exceptionClass = LLVMBuildLShr(backend.builder, syndrome, LLVMConstInt(i32, 26, 0), "")
    // EQ (32).
    val abort = LLVMBuildICmp(backend.builder, 32,
        LLVMBuildAnd(backend.builder, exceptionClass, LLVMConstInt(i32, 57, 0), ""), LLVMConstInt(i32, 32, 0), "")
    LLVMBuildAnd(backend.builder, faultCode, abort, "fault.raised")
}

fun bootstrapLlvmEmitStackGuardHandler(backend: BootstrapLlvmBackend): void {
    bootstrapLlvmEmitWindowsFaultHandler(backend)
    val handler = LLVMGetNamedFunction(
        backend.module, "abla_runtime_stack_fault"
    )
    if (pointerIsNull(handler) || LLVMIsDeclaration(handler) == 0) return
    bootstrapLlvmEmitSigreturnRestorer(backend)
    val mac = backend.macOS
    val i64 = backend.i64Type
    LLVMPositionBuilderAtEnd(
        backend.builder,
        LLVMAppendBasicBlockInContext(backend.context, handler, "entry")
    )
    // si_addr: offset 24 on macOS, 16 on Linux.
    val info = LLVMGetParam(handler, 1)
    val address = LLVMBuildPtrToInt(
        backend.builder,
        LLVMBuildLoad2(
            backend.builder, backend.pointerType,
            bootstrapLlvmByteAt(backend, info, 32, if (mac) 24 else 16),
            "fault.address"
        ),
        i64, ""
    )
    var low = nativeNullPointer()
    var window = 0
    if (!mac) {
        // RLIMIT_STACK (3) below main's frame; an unlimited stack (all
        // ones) counts as 64 GiB.
        val limitType = LLVMArrayType2(backend.i8Type, 16)
        val limit = LLVMBuildAlloca(backend.builder, limitType, "stack.limit")
        if (bootstrapLlvmStackGuardKernel(backend)) {
            // prlimit64(0, RLIMIT_STACK, NULL, &limit), the operation libc's
            // getrlimit uses on modern Linux; its two limits are 64-bit.
            bootstrapLlvmLinuxX64Syscall(backend, 302, [
                LLVMConstInt(i64, 0, 0), LLVMConstInt(i64, 3, 0),
                LLVMConstInt(i64, 0, 0), limit
            ])
        } else {
            bootstrapLlvmStackGuardCall(
                backend, "getrlimit", backend.i32Type,
                [backend.i32Type, backend.pointerType],
                [LLVMConstInt(backend.i32Type, 3, 0), limit]
            )
        }
        val current = LLVMBuildLoad2(backend.builder, i64, limit, "")
        val size = LLVMBuildSelect(
            backend.builder,
            LLVMBuildICmp(
                backend.builder, llvmIntEqual(), current,
                LLVMConstInt(i64, -1, 1), ""
            ),
            LLVMConstInt(i64, 68719476736, 0), current, ""
        )
        low = LLVMBuildSub(
            backend.builder,
            LLVMBuildLoad2(
                backend.builder, i64,
                LLVMGetNamedGlobal(backend.module, "abla_runtime_stack_top"),
                ""
            ),
            size, ""
        )
        // main's frame sits below the environment and arguments.
        window = 2097152
    }
    // low - window <= address < low + window (unsigned: address - (low -
    // window) < 2 * window); macOS has no such window (below).
    var overflow = if (mac) LLVMConstInt(backend.i1Type, 0, 0) else LLVMBuildICmp(
        backend.builder, llvmIntUnsignedLessThan(),
        LLVMBuildSub(
            backend.builder, address,
            LLVMBuildSub(backend.builder, low, LLVMConstInt(i64, window, 0), ""),
            ""
        ),
        LLVMConstInt(i64, 2 * window, 0), "stack.overflow"
    )
    // Any thread's stack: a fault within 64 KiB of the interrupted stack pointer, which an overflow's call or
    // probe touches just below it (#831). The ucontext's saved stack pointer: on Linux gregs[REG_RSP] at 160 on
    // x86-64, sigcontext.sp at 432 on AArch64; on macOS (#811 G2: no libpthread bounds) through the mcontext
    // pointer at ucontext + 48, __ss.__sp at 264 on arm64 (the CI probe on 6409ecd4) and __ss.__rsp at 72 on
    // x86-64 (after the 16-byte exception state, the eighth register). It is the only rule there: the main
    // thread's overflow faults just below its stack (SIGSEGV), a pthread's just below its 524 KiB one (SIGBUS).
    val signalContext = LLVMGetParam(handler, 2)
    val machine = if (mac) LLVMBuildLoad2(
        backend.builder, backend.pointerType, bootstrapLlvmByteAt(backend, signalContext, 56, 48), "mcontext"
    ) else signalContext
    val stackPointerAt = if (mac) (if (bootstrapLlvmMachOIsArm(backend.targetTriple)) 264 else 72)
        else if (bootstrapTextContains(backend.targetTriple, "aarch64")) 432 else 160
    val interrupted = LLVMBuildLoad2(
        backend.builder, i64,
        bootstrapLlvmByteAt(backend, machine, 512, stackPointerAt),
        "interrupted.sp"
    )
    val nearStack = LLVMBuildICmp(
        backend.builder, llvmIntUnsignedLessThan(),
        LLVMBuildSub(
            backend.builder, address,
            LLVMBuildSub(backend.builder, interrupted, LLVMConstInt(i64, 65536, 0), ""),
            ""
        ),
        LLVMConstInt(i64, 131072, 0), "thread.stack.overflow"
    )
    overflow = if (mac) nearStack else LLVMBuildOr(backend.builder, overflow, nearStack, "any.stack.overflow")
    val overflowed = LLVMAppendBasicBlockInContext(
        backend.context, handler, "overflow"
    )
    val other = LLVMAppendBasicBlockInContext(
        backend.context, handler, "other"
    )
    LLVMBuildCondBr(backend.builder, overflow, overflowed, other)
    LLVMPositionBuilderAtEnd(backend.builder, overflowed)
    val message = "panic: stack overflow\n"
    val messageArguments = [LLVMConstInt(i64, 2, 0),
        bootstrapLlvmGlobalStringPointer(backend, message, "abla.stack.overflow"),
        LLVMConstInt(i64, message.size, 0)]
    bootstrapLlvmRuntimeWrite(backend, 2, messageArguments[1], messageArguments[2])
    if (bootstrapLlvmDebugHostedRuntime(backend)) {
        bootstrapLlvmStackGuardCall(
            backend, "abla_runtime_print_stack", backend.voidType, [], []
        )
    }
    if (bootstrapLlvmStackGuardKernel(backend)) {
        // exit_group, as libc _exit: terminate the entire process, not just
        // the thread handling the fault.
        bootstrapLlvmLinuxX64Syscall(backend, 231, [LLVMConstInt(i64, 101, 0)])
    } else if (bootstrapLlvmFaultDarwin(backend)) {
        // exit (1) ends the process, as libSystem's _exit.
        bootstrapLlvmDarwinSyscallBy(backend, 1, [LLVMConstInt(i64, 101, 0)])
    } else {
        bootstrapLlvmStackGuardCall(
            backend, "_exit", backend.voidType, [backend.i64Type],
            [LLVMConstInt(backend.i64Type, 101, 0)]
        )
    }
    LLVMBuildUnreachable(backend.builder)
    LLVMPositionBuilderAtEnd(backend.builder, other)
    val signal = LLVMBuildZExt(
        backend.builder, LLVMGetParam(handler, 0), i64, ""
    )
    if (!bootstrapLlvmDebugHostedRuntime(backend)) {
        // A release build says what ended it (it has no stack to print): the bad access and its address, as
        // si_addr names it, when the kernel raised it: si_code (at 8 on Linux and macOS) a fault's own code, 1 to 15
        // (SEGV_MAPERR 1, SEGV_ACCERR 2, BUS_ADRALN 1, BUS_ADRERR 2, ...; Linux's go to 9). A signal sent (raise,
        // kill) has no address and ends the process as before: si_code SI_USER, 0 on Linux but 0x10001 on macOS,
        // or another sender's (negative on Linux, 0x1000x on macOS); nor does Linux's SI_KERNEL (0x80, si_addr 0).
        // (On Apple Silicon a sent one looks like a fault: bootstrapLlvmFaultRaised.) The debug report below prints
        // the stack instead.
        val reported = LLVMAppendBasicBlockInContext(backend.context, handler, "fault.report")
        val quiet = LLVMAppendBasicBlockInContext(backend.context, handler, "fault.default")
        LLVMBuildCondBr(backend.builder, bootstrapLlvmFaultRaised(backend, info, machine), reported, quiet)
        LLVMPositionBuilderAtEnd(backend.builder, reported)
        bootstrapLlvmDebugWrite(backend, "fatal signal: a bad memory access at ", "abla.fault.access")
        bootstrapLlvmWriteHexCompact(backend, address)
        LLVMBuildBr(backend.builder, quiet)
        LLVMPositionBuilderAtEnd(backend.builder, quiet)
    }
    if (bootstrapLlvmDebugHostedRuntime(backend)) {
        // The faulting instruction, which no frame's return address names: the stack starts at it
        // (abla_runtime_fault_pc, read by the walk). The interrupted pc in the ucontext: on Linux gregs[REG_RIP] at
        // 168 on x86-64, sigcontext.pc at 440 on AArch64; on macOS through the mcontext, __ss.__rip at 144 on x86-64
        // and __ss.__pc at 272 on arm64 (beside the stack pointers read above).
        val pcAt = if (mac) (if (bootstrapLlvmMachOIsArm(backend.targetTriple)) 272 else 144)
            else if (bootstrapTextContains(backend.targetTriple, "aarch64")) 440 else 168
        val faultPc = bootstrapLlvmFaultPcGlobal(backend)
        LLVMBuildStore(backend.builder, LLVMBuildLoad2(backend.builder, i64,
            bootstrapLlvmByteAt(backend, machine, 512, pcAt), "interrupted.pc"), faultPc)
        // And its frame pointer, where the walk starts (not this handler's frame, on the signal stack): gregs[REG_RBP]
        // at 120 and x29 at 416 on Linux, __rbp at 64 and __fp at 248 on macOS.
        val frameAt = if (mac) (if (bootstrapLlvmMachOIsArm(backend.targetTriple)) 248 else 64)
            else if (bootstrapTextContains(backend.targetTriple, "aarch64")) 416 else 120
        LLVMBuildStore(backend.builder, LLVMBuildLoad2(backend.builder, i64,
            bootstrapLlvmByteAt(backend, machine, 512, frameAt), "interrupted.frame"), bootstrapLlvmFaultFrameGlobal(backend))
        // A bad access the kernel raised (SIGSEGV or SIGBUS with a fault's own si_code, 1 to 15, as a release build
        // reports it; not a sent one, SI_USER 0x10001 on macOS): the report names its address
        // (abla_runtime_fault_access 1; si_addr in abla_runtime_fault_address, 0 included).
        // EQ (32).
        val access = LLVMBuildAnd(backend.builder, bootstrapLlvmFaultRaised(backend, info, machine),
            LLVMBuildOr(backend.builder, LLVMBuildICmp(backend.builder, 32, signal, LLVMConstInt(i64, 11, 0), ""),
                LLVMBuildICmp(backend.builder, 32, signal, LLVMConstInt(i64, if (mac) 10 else 7, 0), ""), ""), "")
        LLVMBuildStore(backend.builder, LLVMBuildZExt(backend.builder, access, i64, ""),
            bootstrapLlvmFaultWord(backend, "abla_runtime_fault_access"))
        LLVMBuildStore(backend.builder, address, bootstrapLlvmFaultWord(backend, "abla_runtime_fault_address"))
        // The debug report, which restores the default action.
        val fault = bootstrapLlvmDeclare(
            backend, "abla_runtime_fault", backend.voidType, [i64], false, []
        )
        LLVMSetLinkage(fault, llvmInternalLinkage())
        bootstrapLlvmCall(backend, fault, [signal], "", false, [])
    } else if (bootstrapLlvmStackGuardKernel(backend)) {
        // Restore SIG_DFL: rt_sigaction with an all-zero kernel struct.
        val defaultType = LLVMArrayType2(backend.i8Type, 32)
        val action = LLVMBuildAlloca(backend.builder, defaultType, "signal.default")
        LLVMBuildStore(backend.builder, LLVMConstNull(defaultType), action)
        bootstrapLlvmStackGuardKernelSigaction(backend, signal, action)
    } else if (bootstrapLlvmFaultDarwin(backend)) {
        bootstrapLlvmDarwinSigDefault(backend, signal)
    } else {
        bootstrapLlvmStackGuardCall(
            backend, "signal", backend.pointerType,
            [i64, backend.pointerType],
            [signal, LLVMConstNull(backend.pointerType)]
        )
    }
    // Back to the default action: the signal raised again (delivered once
    // the handler returns) or the faulting instruction run again ends the
    // process as before.
    if (bootstrapLlvmStackGuardKernel(backend)) {
        val process = bootstrapLlvmLinuxX64Syscall(backend, 39, [])
        val threadId = bootstrapLlvmLinuxX64Syscall(backend, 186, [])
        bootstrapLlvmLinuxX64Syscall(backend, 234, [process, threadId, signal])
    } else if (bootstrapLlvmFaultDarwin(backend)) {
        // kill(getpid(), signal): raise's process-directed form; the default action it
        // meets ends the process by the signal as before.
        val process = bootstrapLlvmDarwinSyscallBy(backend, 20, [])
        bootstrapLlvmDarwinSyscallBy(backend, 37, [process, signal, LLVMConstInt(i64, 1, 0)])
    } else {
        bootstrapLlvmStackGuardCall(
            backend, "raise", backend.i32Type, [backend.i32Type],
            [LLVMGetParam(handler, 0)]
        )
    }
    LLVMBuildRetVoid(backend.builder)
    return
}

fun bootstrapLlvmDebugWrite(
    backend: BootstrapLlvmBackend,
    text: string,
    name: string
): void {
    bootstrapLlvmRuntimeWrite(
        backend, 2, bootstrapLlvmGlobalStringPointer(backend, text, name),
        LLVMConstInt(backend.i64Type, text.size, 0)
    )
    return
}

// The byte at `index` (a value) of an i8 array or buffer.
fun bootstrapLlvmByteElement(backend: BootstrapLlvmBackend, bytes: i64*, index: i64*): i64* {
    val indices = llvmPointerVector(1)
    indices.set(0, index)
    val element = LLVMBuildGEP2(backend.builder, backend.i8Type, bytes, indices.pointer(), 1, "")
    indices.drop()
    element
}

// bootstrapLlvmDebugWriteHex as a loop over a digit table, for code every release build carries (the fault
// report): a fraction of the unrolled form's size. Ends the line.
fun bootstrapLlvmWriteHexCompact(backend: BootstrapLlvmBackend, value: i64*): void {
    val i64 = backend.i64Type
    val function = LLVMGetBasicBlockParent(LLVMGetInsertBlock(backend.builder))
    val buffer = LLVMBuildAlloca(backend.builder, LLVMArrayType2(backend.i8Type, 19), "hex")
    val digits = bootstrapLlvmGlobalStringPointer(backend, "0123456789abcdef", "abla.hex.digits")
    LLVMBuildStore(backend.builder, LLVMConstInt(backend.i8Type, 48, 0), buffer)
    LLVMBuildStore(backend.builder, LLVMConstInt(backend.i8Type, 120, 0),
        bootstrapLlvmByteElement(backend, buffer, LLVMConstInt(i64, 1, 0)))
    val cursor = LLVMBuildAlloca(backend.builder, i64, "hex.i")
    LLVMBuildStore(backend.builder, LLVMConstInt(i64, 0, 0), cursor)
    val loop = LLVMAppendBasicBlockInContext(backend.context, function, "hex.loop")
    val body = LLVMAppendBasicBlockInContext(backend.context, function, "hex.body")
    val done = LLVMAppendBasicBlockInContext(backend.context, function, "hex.done")
    LLVMBuildBr(backend.builder, loop)
    LLVMPositionBuilderAtEnd(backend.builder, loop)
    val index = LLVMBuildLoad2(backend.builder, i64, cursor, "")
    // ULT (36).
    LLVMBuildCondBr(backend.builder, LLVMBuildICmp(backend.builder, 36, index, LLVMConstInt(i64, 16, 0), ""),
        body, done)
    LLVMPositionBuilderAtEnd(backend.builder, body)
    // The digit of bits 60 - 4i down: the most significant first.
    val shift = LLVMBuildSub(backend.builder, LLVMConstInt(i64, 60, 0),
        LLVMBuildShl(backend.builder, index, LLVMConstInt(i64, 2, 0), ""), "")
    val nibble = LLVMBuildAnd(backend.builder, LLVMBuildLShr(backend.builder, value, shift, ""),
        LLVMConstInt(i64, 15, 0), "")
    val digit = LLVMBuildLoad2(backend.builder, backend.i8Type, bootstrapLlvmByteElement(backend, digits, nibble), "")
    LLVMBuildStore(backend.builder, digit, bootstrapLlvmByteElement(backend, buffer,
        LLVMBuildAdd(backend.builder, index, LLVMConstInt(i64, 2, 0), "")))
    LLVMBuildStore(backend.builder, LLVMBuildAdd(backend.builder, index, LLVMConstInt(i64, 1, 0), ""), cursor)
    LLVMBuildBr(backend.builder, loop)
    LLVMPositionBuilderAtEnd(backend.builder, done)
    LLVMBuildStore(backend.builder, LLVMConstInt(backend.i8Type, 10, 0),
        bootstrapLlvmByteElement(backend, buffer, LLVMConstInt(i64, 18, 0)))
    bootstrapLlvmRuntimeWrite(backend, 2, buffer, LLVMConstInt(i64, 19, 0))
    return
}

// Writes `value` to standard error as 0x and sixteen hexadecimal digits.
fun bootstrapLlvmDebugWriteHex(
    backend: BootstrapLlvmBackend,
    value: i64*
): void {
    val bufferType = LLVMArrayType2(backend.i8Type, 18)
    val buffer = LLVMBuildAlloca(backend.builder, bufferType, "hex")
    var digit = 0
    while (digit < 18) {
        val byte = if (digit == 0) LLVMConstInt(backend.i8Type, 48, 0)
        else if (digit == 1) LLVMConstInt(backend.i8Type, 120, 0)
        else {
            val shift = 60 - 4 * (digit - 2)
            val nibble = LLVMBuildTrunc(
                backend.builder,
                LLVMBuildAnd(
                    backend.builder,
                    LLVMBuildLShr(
                        backend.builder, value,
                        LLVMConstInt(backend.i64Type, shift, 0), ""
                    ),
                    LLVMConstInt(backend.i64Type, 15, 0), ""
                ),
                backend.i8Type, ""
            )
            // ULT (36): a digit below ten is '0' + n, else 'a' + n - 10.
            LLVMBuildSelect(
                backend.builder,
                LLVMBuildICmp(
                    backend.builder, 36, nibble,
                    LLVMConstInt(backend.i8Type, 10, 0), ""
                ),
                LLVMBuildAdd(
                    backend.builder, nibble,
                    LLVMConstInt(backend.i8Type, 48, 0), ""
                ),
                LLVMBuildAdd(
                    backend.builder, nibble,
                    LLVMConstInt(backend.i8Type, 87, 0), ""
                ),
                ""
            )
        }
        LLVMBuildStore(
            backend.builder, byte,
            bootstrapLlvmArrayElement(backend, bufferType, buffer, digit, "")
        )
        digit = digit + 1
    }
    bootstrapLlvmRuntimeWrite(
        backend, 2, buffer, LLVMConstInt(backend.i64Type, 18, 0)
    )
    return
}

// The stack on x86-64 Linux without libc's backtrace: walk the frame-pointer
// chain (a debug build keeps it in every function) and print each return
// address, less one so it falls inside the call, as 0x and sixteen hex digits,
// then the executable's load address (__ehdr_start) for a position-independent
// executable. Every frame is read with process_vm_readv on this process, which
// fails with EFAULT instead of faulting where the chain ends or is not a chain
// (a signal interrupted code without frame pointers), and the walk stops at 64
// frames, a null or misaligned frame, or one that does not move up the stack.
fun bootstrapLlvmEmitFramePointerWalk(
    backend: BootstrapLlvmBackend,
    printStack: i64*
): void {
    val i64 = backend.i64Type
    bootstrapLlvmDebugWrite(
        backend,
        "stack (return addresses: subtract the load address, then addr2line or gdb on the program gives file:line):\n",
        "abla.stack.header"
    )
    bootstrapLlvmWalkFaultPc(backend, printStack)
    val frame = bootstrapLlvmStackGuardCall(
        backend, "llvm.frameaddress.p0", backend.pointerType,
        [backend.i32Type], [LLVMConstInt(backend.i32Type, 0, 0)]
    )
    val cursor = LLVMBuildAlloca(backend.builder, i64, "fp")
    LLVMBuildStore(
        backend.builder, bootstrapLlvmWalkStart(backend, frame), cursor
    )
    val counter = LLVMBuildAlloca(backend.builder, i64, "n")
    LLVMBuildStore(backend.builder, LLVMConstInt(i64, 0, 0), counter)
    val record = LLVMBuildAlloca(backend.builder, LLVMArrayType2(backend.i8Type, 16), "record")
    val iov = LLVMBuildAlloca(backend.builder, LLVMArrayType2(backend.i8Type, 32), "iov")
    val process = bootstrapLlvmLinuxX64Syscall(backend, 39, [])
    val loop = LLVMAppendBasicBlockInContext(backend.context, printStack, "walk")
    val read = LLVMAppendBasicBlockInContext(backend.context, printStack, "read")
    val take = LLVMAppendBasicBlockInContext(backend.context, printStack, "take")
    val show = LLVMAppendBasicBlockInContext(backend.context, printStack, "show")
    val done = LLVMAppendBasicBlockInContext(backend.context, printStack, "walked")
    LLVMBuildBr(backend.builder, loop)
    LLVMPositionBuilderAtEnd(backend.builder, loop)
    val count = LLVMBuildLoad2(backend.builder, i64, counter, "")
    val current = LLVMBuildLoad2(backend.builder, i64, cursor, "")
    // ULT (36), NE (33), EQ (32).
    val inRange = LLVMBuildICmp(
        backend.builder, 36, count, LLVMConstInt(i64, 64, 0), ""
    )
    val present = LLVMBuildICmp(backend.builder, 33, current, LLVMConstInt(i64, 0, 0), "")
    val aligned = LLVMBuildICmp(
        backend.builder, 32,
        LLVMBuildAnd(backend.builder, current, LLVMConstInt(i64, 7, 0), ""),
        LLVMConstInt(i64, 0, 0), ""
    )
    LLVMBuildCondBr(
        backend.builder,
        LLVMBuildAnd(
            backend.builder, LLVMBuildAnd(backend.builder, inRange, present, ""), aligned, ""
        ),
        read, done
    )
    LLVMPositionBuilderAtEnd(backend.builder, read)
    // process_vm_readv(pid, &local, 1, &remote, 1, 0): the 16 bytes at the frame
    // (saved frame pointer, return address) into `record`.
    LLVMBuildStore(backend.builder, record, iov)
    LLVMBuildStore(
        backend.builder, LLVMConstInt(i64, 16, 0), bootstrapLlvmByteAt(backend, iov, 32, 8)
    )
    LLVMBuildStore(backend.builder, current, bootstrapLlvmByteAt(backend, iov, 32, 16))
    LLVMBuildStore(
        backend.builder, LLVMConstInt(i64, 16, 0), bootstrapLlvmByteAt(backend, iov, 32, 24)
    )
    val got = bootstrapLlvmLinuxX64Syscall(backend, 310, [
        process, iov, LLVMConstInt(i64, 1, 0),
        bootstrapLlvmByteAt(backend, iov, 32, 16), LLVMConstInt(i64, 1, 0),
        LLVMConstInt(i64, 0, 0)
    ])
    // Without process_vm_readv (qemu-user, a seccomp filter: ENOSYS) the record is read directly,
    // but only from the thread's own stack: between this function's frame and the recorded top.
    val stackTop = LLVMGetNamedGlobal(backend.module, "abla_runtime_stack_top")
    val direct = LLVMAppendBasicBlockInContext(backend.context, printStack, "direct")
    val fallback = LLVMAppendBasicBlockInContext(backend.context, printStack, "fallback")
    LLVMBuildCondBr(
        backend.builder,
        LLVMBuildICmp(backend.builder, 32, got, LLVMConstInt(i64, 16, 0), ""),
        take, fallback
    )
    LLVMPositionBuilderAtEnd(backend.builder, fallback)
    if (pointerIsNull(stackTop)) LLVMBuildBr(backend.builder, done)
    else {
        val first = LLVMBuildPtrToInt(backend.builder, frame, i64, "")
        val top = LLVMBuildLoad2(backend.builder, i64, stackTop, "")
        val inside = LLVMBuildAnd(
            backend.builder,
            LLVMBuildICmp(backend.builder, 32, got, LLVMConstInt(i64, -38, 1), ""),
            LLVMBuildICmp(
                backend.builder, 36, LLVMBuildSub(backend.builder, current, first, ""),
                LLVMBuildSub(backend.builder, top, first, ""), ""
            ),
            ""
        )
        LLVMBuildCondBr(backend.builder, inside, direct, done)
    }
    LLVMPositionBuilderAtEnd(backend.builder, direct)
    val savedFrame = LLVMBuildLoad2(
        backend.builder, i64, LLVMBuildIntToPtr(backend.builder, current, backend.pointerType, ""),
        ""
    )
    val savedReturn = LLVMBuildLoad2(
        backend.builder, i64,
        LLVMBuildIntToPtr(
            backend.builder, LLVMBuildAdd(backend.builder, current, LLVMConstInt(i64, 8, 0), ""),
            backend.pointerType, ""
        ),
        ""
    )
    LLVMBuildStore(backend.builder, savedFrame, record)
    LLVMBuildStore(backend.builder, savedReturn, bootstrapLlvmByteAt(backend, record, 16, 8))
    LLVMBuildBr(backend.builder, take)
    LLVMPositionBuilderAtEnd(backend.builder, take)
    val next = LLVMBuildLoad2(backend.builder, i64, record, "")
    val returnAddress = LLVMBuildLoad2(
        backend.builder, i64, bootstrapLlvmByteAt(backend, record, 16, 8), ""
    )
    LLVMBuildCondBr(
        backend.builder,
        LLVMBuildICmp(backend.builder, 33, returnAddress, LLVMConstInt(i64, 0, 0), ""),
        show, done
    )
    LLVMPositionBuilderAtEnd(backend.builder, show)
    val inCall = LLVMBuildSub(backend.builder, returnAddress, LLVMConstInt(i64, 1, 0), "")
    bootstrapLlvmDebugWriteHex(backend, inCall)
    // A --backtrace build names the frame from its table (a debug build's are named by ablac symbolize).
    if (bootstrapLlvmBacktrace) {
        bootstrapLlvmCall(backend, bootstrapLlvmBacktraceNameFunction(backend), [inCall], "", false, [])
    }
    bootstrapLlvmDebugWrite(backend, "\n", "abla.stack.end")
    LLVMBuildStore(
        backend.builder, LLVMBuildAdd(backend.builder, count, LLVMConstInt(i64, 1, 0), ""),
        counter
    )
    LLVMBuildStore(backend.builder, next, cursor)
    // Keep going only while the chain moves up (ULE (37): next <= current stops).
    LLVMBuildCondBr(
        backend.builder, LLVMBuildICmp(backend.builder, 37, next, current, ""), done, loop
    )
    LLVMPositionBuilderAtEnd(backend.builder, done)
    bootstrapLlvmDebugWrite(backend, "load address ", "abla.stack.load")
    var base = LLVMGetNamedGlobal(backend.module, "__ehdr_start")
    if (pointerIsNull(base)) base = LLVMAddGlobal(backend.module, backend.i8Type, "__ehdr_start")
    bootstrapLlvmDebugWriteHex(backend, LLVMBuildPtrToInt(backend.builder, base, i64, ""))
    bootstrapLlvmDebugWrite(backend, "\n", "abla.stack.end")
    return
}

// The stack on macOS without libSystem's backtrace (#811 group 6): the same frame-pointer
// walk as Linux's, reading each frame record (saved frame pointer, return address) directly.
// arm64 and x86-64 both lay the record out so, and a debug build keeps the frame pointer in
// every function. A frame is read only when it is aligned and lies between this function's
// frame and the stack top main recorded; the chain ends at a null or non-rising frame pointer
// and after 64 frames. The executable's load address is the Mach header, the linker's
// _mh_execute_header (Mach-O symbol __mh_execute_header) (atos -o <program> -l <load address> <address>). UNVERIFIED on macOS: that
// symbol, that the chain ends in a null frame pointer, and that a thread other than main's
// stops at the first frame outside [this frame, main's stack top).
fun bootstrapLlvmEmitDarwinFramePointerWalk(
    backend: BootstrapLlvmBackend,
    printStack: i64*
): void {
    val i64 = backend.i64Type
    bootstrapLlvmDebugWrite(
        backend,
        "stack (return addresses: atos -o <program> -l <load address> gives file:line):\n",
        "abla.stack.header"
    )
    bootstrapLlvmWalkFaultPc(backend, printStack)
    val frame = bootstrapLlvmStackGuardCall(
        backend, "llvm.frameaddress.p0", backend.pointerType,
        [backend.i32Type], [LLVMConstInt(backend.i32Type, 0, 0)]
    )
    val first = bootstrapLlvmWalkStart(backend, frame)
    val stackTop = LLVMGetNamedGlobal(backend.module, "abla_runtime_stack_top")
    val cursor = LLVMBuildAlloca(backend.builder, i64, "fp")
    LLVMBuildStore(backend.builder, first, cursor)
    val counter = LLVMBuildAlloca(backend.builder, i64, "n")
    LLVMBuildStore(backend.builder, LLVMConstInt(i64, 0, 0), counter)
    val loop = LLVMAppendBasicBlockInContext(backend.context, printStack, "walk")
    val read = LLVMAppendBasicBlockInContext(backend.context, printStack, "read")
    val show = LLVMAppendBasicBlockInContext(backend.context, printStack, "show")
    val done = LLVMAppendBasicBlockInContext(backend.context, printStack, "walked")
    LLVMBuildBr(backend.builder, loop)
    LLVMPositionBuilderAtEnd(backend.builder, loop)
    val count = LLVMBuildLoad2(backend.builder, i64, counter, "")
    val current = LLVMBuildLoad2(backend.builder, i64, cursor, "")
    // ULT (36), NE (33), EQ (32).
    var ok = LLVMBuildAnd(
        backend.builder,
        LLVMBuildICmp(backend.builder, 36, count, LLVMConstInt(i64, 64, 0), ""),
        LLVMBuildICmp(
            backend.builder, 32,
            LLVMBuildAnd(backend.builder, current, LLVMConstInt(i64, 7, 0), ""),
            LLVMConstInt(i64, 0, 0), ""
        ),
        ""
    )
    ok = LLVMBuildAnd(
        backend.builder, ok,
        LLVMBuildICmp(backend.builder, 33, current, LLVMConstInt(i64, 0, 0), ""), ""
    )
    if (!pointerIsNull(stackTop)) {
        val top = LLVMBuildLoad2(backend.builder, i64, stackTop, "")
        ok = LLVMBuildAnd(
            backend.builder, ok,
            LLVMBuildICmp(
                backend.builder, 36, LLVMBuildSub(backend.builder, current, first, ""),
                LLVMBuildSub(backend.builder, top, first, ""), ""
            ),
            ""
        )
    } else {
        // Without the recorded top only this frame itself is known to be readable.
        ok = LLVMBuildAnd(
            backend.builder, ok,
            LLVMBuildICmp(backend.builder, 32, count, LLVMConstInt(i64, 0, 0), ""), ""
        )
    }
    LLVMBuildCondBr(backend.builder, ok, read, done)
    LLVMPositionBuilderAtEnd(backend.builder, read)
    val next = LLVMBuildLoad2(
        backend.builder, i64, LLVMBuildIntToPtr(backend.builder, current, backend.pointerType, ""), ""
    )
    val returnAddress = LLVMBuildLoad2(
        backend.builder, i64,
        LLVMBuildIntToPtr(
            backend.builder, LLVMBuildAdd(backend.builder, current, LLVMConstInt(i64, 8, 0), ""),
            backend.pointerType, ""
        ),
        ""
    )
    LLVMBuildCondBr(
        backend.builder,
        LLVMBuildICmp(backend.builder, 33, returnAddress, LLVMConstInt(i64, 0, 0), ""),
        show, done
    )
    LLVMPositionBuilderAtEnd(backend.builder, show)
    // The return address less one falls inside the call.
    val inCall = LLVMBuildSub(backend.builder, returnAddress, LLVMConstInt(i64, 1, 0), "")
    bootstrapLlvmDebugWriteHex(backend, inCall)
    if (bootstrapLlvmBacktrace) {
        bootstrapLlvmCall(backend, bootstrapLlvmBacktraceNameFunction(backend), [inCall], "", false, [])
    }
    bootstrapLlvmDebugWrite(backend, "\n", "abla.stack.end")
    LLVMBuildStore(
        backend.builder, LLVMBuildAdd(backend.builder, count, LLVMConstInt(i64, 1, 0), ""),
        counter
    )
    LLVMBuildStore(backend.builder, next, cursor)
    // Keep going only while the chain moves up (ULE (37): next <= current stops).
    LLVMBuildCondBr(
        backend.builder, LLVMBuildICmp(backend.builder, 37, next, current, ""), done, loop
    )
    LLVMPositionBuilderAtEnd(backend.builder, done)
    bootstrapLlvmDebugWrite(backend, "load address ", "abla.stack.load")
    if (!pointerIsNull(stackTop)) {
        // An executable (the C main recorded the stack top): the linker's Mach header.
        var base = LLVMGetNamedGlobal(backend.module, "_mh_execute_header")
        if (pointerIsNull(base)) base = LLVMAddGlobal(backend.module, backend.i8Type, "_mh_execute_header")
        bootstrapLlvmDebugWriteHex(backend, LLVMBuildPtrToInt(backend.builder, base, i64, ""))
    } else {
        // A library has no _mh_execute_header (a dylib's header is another symbol): naming it left `ld` with an undefined symbol
        // for every --fast dylib (master CI, 2026-11-18). The addresses are the library's own; vmmap gives its load address.
        bootstrapLlvmDebugWrite(backend, "unknown (a library: see vmmap)", "abla.stack.library")
    }
    bootstrapLlvmDebugWrite(backend, "\n", "abla.stack.end")
    return
}

// Defines abla_runtime_print_stack (when the program calls it or a debug
// build needs it) and, in a debug build of a hosted executable,
// abla_runtime_fault. Runs after every other body is emitted.
fun bootstrapLlvmEmitDebugRuntime(backend: BootstrapLlvmBackend): void {
    bootstrapLlvmEmitSigreturnRestorer(backend)
    val hosted = bootstrapLlvmDebugHostedRuntime(backend)
    var printStack = LLVMGetNamedFunction(
        backend.module, "abla_runtime_print_stack"
    )
    val fault = LLVMGetNamedFunction(backend.module, "abla_runtime_fault")
    val faultNeeded = hosted && !pointerIsNull(fault) &&
        LLVMIsDeclaration(fault) != 0
    if (pointerIsNull(printStack) && !faultNeeded) return
    if (pointerIsNull(printStack)) printStack = bootstrapLlvmDeclare(
        backend, "abla_runtime_print_stack", backend.voidType, [], false, []
    )
    if (LLVMIsDeclaration(printStack) != 0) {
        LLVMSetLinkage(printStack, llvmInternalLinkage())
        LLVMPositionBuilderAtEnd(
            backend.builder,
            LLVMAppendBasicBlockInContext(backend.context, printStack, "entry")
        )
        if (hosted && bootstrapLlvmDebugKernelOutput(backend)) {
            bootstrapLlvmEmitFramePointerWalk(backend, printStack)
        } else if (hosted && bootstrapLlvmFaultDarwin(backend)) {
            bootstrapLlvmEmitDarwinFramePointerWalk(backend, printStack)
        } else if (hosted && bootstrapLlvmFaultWindows(backend)) {
            bootstrapLlvmEmitWindowsStackWalk(backend, printStack)
        } else if (hosted) {
            val framesType = LLVMArrayType2(backend.pointerType, 64)
            val frames = LLVMBuildAlloca(backend.builder, framesType, "frames")
            bootstrapLlvmDebugWrite(
                backend,
                "stack (lldb on the program, or atos/addr2line with the addresses, gives file:line):\n",
                "abla.stack.header"
            )
            val count = bootstrapLlvmDebugCall(
                backend, "backtrace", backend.i64Type,
                [backend.pointerType, backend.i64Type],
                [frames, LLVMConstInt(backend.i64Type, 64, 0)]
            )
            // Every frame but the innermost holds a return address: step it
            // back into the call, so its line is the call's line.
            val cursor = LLVMBuildAlloca(backend.builder, backend.i64Type, "i")
            LLVMBuildStore(
                backend.builder, LLVMConstInt(backend.i64Type, 1, 0), cursor
            )
            val loop = LLVMAppendBasicBlockInContext(
                backend.context, printStack, "loop"
            )
            val body = LLVMAppendBasicBlockInContext(
                backend.context, printStack, "body"
            )
            val done = LLVMAppendBasicBlockInContext(
                backend.context, printStack, "done"
            )
            LLVMBuildBr(backend.builder, loop)
            LLVMPositionBuilderAtEnd(backend.builder, loop)
            val index = LLVMBuildLoad2(
                backend.builder, backend.i64Type, cursor, ""
            )
            // SLT (40).
            LLVMBuildCondBr(
                backend.builder,
                LLVMBuildICmp(backend.builder, 40, index, count, ""),
                body, done
            )
            LLVMPositionBuilderAtEnd(backend.builder, body)
            val slot = bootstrapLlvmDebugPointerElement(
                backend, frames, index
            )
            val address = LLVMBuildPtrToInt(
                backend.builder,
                LLVMBuildLoad2(backend.builder, backend.pointerType, slot, ""),
                backend.i64Type, ""
            )
            LLVMBuildStore(
                backend.builder,
                LLVMBuildIntToPtr(
                    backend.builder,
                    LLVMBuildSub(
                        backend.builder, address,
                        LLVMConstInt(backend.i64Type, 1, 0), ""
                    ),
                    backend.pointerType, ""
                ),
                slot
            )
            LLVMBuildStore(
                backend.builder,
                LLVMBuildAdd(
                    backend.builder, index,
                    LLVMConstInt(backend.i64Type, 1, 0), ""
                ),
                cursor
            )
            LLVMBuildBr(backend.builder, loop)
            LLVMPositionBuilderAtEnd(backend.builder, done)
            bootstrapLlvmDebugCall(
                backend, "backtrace_symbols_fd", backend.voidType,
                [backend.pointerType, backend.i64Type, backend.i64Type],
                [frames, count, LLVMConstInt(backend.i64Type, 2, 0)]
            )
            if (backend.macOS) {
                // atos -o <program> -l <load address> <address>...
                bootstrapLlvmDebugWrite(
                    backend, "load address ", "abla.stack.load"
                )
                val header = bootstrapLlvmDebugCall(
                    backend, "_dyld_get_image_header", backend.pointerType,
                    [backend.i64Type], [LLVMConstInt(backend.i64Type, 0, 0)]
                )
                bootstrapLlvmDebugWriteHex(
                    backend,
                    LLVMBuildPtrToInt(
                        backend.builder, header, backend.i64Type, ""
                    )
                )
                bootstrapLlvmDebugWrite(backend, "\n", "abla.stack.end")
            }
        }
        LLVMBuildRetVoid(backend.builder)
    }
    if (faultNeeded) {
        LLVMPositionBuilderAtEnd(
            backend.builder,
            LLVMAppendBasicBlockInContext(backend.context, fault, "entry")
        )
        // A bad access names its address, as a release build does; any other fault says what it may be.
        val i64 = backend.i64Type
        val named = LLVMAppendBasicBlockInContext(backend.context, fault, "fault.access")
        val generic = LLVMAppendBasicBlockInContext(backend.context, fault, "fault.generic")
        val stack = LLVMAppendBasicBlockInContext(backend.context, fault, "fault.stack")
        val access = LLVMBuildLoad2(backend.builder, i64, bootstrapLlvmFaultWord(backend, "abla_runtime_fault_access"), "")
        // NE (33).
        LLVMBuildCondBr(backend.builder, LLVMBuildICmp(backend.builder, 33, access, LLVMConstInt(i64, 0, 0), ""),
            named, generic)
        LLVMPositionBuilderAtEnd(backend.builder, named)
        bootstrapLlvmDebugWrite(backend, "\nfatal signal: a bad memory access at ", "abla.fault.access.header")
        bootstrapLlvmWriteHexCompact(backend, LLVMBuildLoad2(backend.builder, i64,
            bootstrapLlvmFaultWord(backend, "abla_runtime_fault_address"), ""))
        LLVMBuildBr(backend.builder, stack)
        LLVMPositionBuilderAtEnd(backend.builder, generic)
        bootstrapLlvmDebugWrite(
            backend, "\nfatal signal: a trap, a bad memory access or an abort\n",
            "abla.fault.header"
        )
        LLVMBuildBr(backend.builder, stack)
        LLVMPositionBuilderAtEnd(backend.builder, stack)
        bootstrapLlvmCall(backend, printStack, [], "", false, [])
        // Back to the default action: returning re-runs the faulting
        // instruction (or abort raises again), which now ends the process.
        if (bootstrapLlvmStackGuardKernel(backend)) {
            val defaultType = LLVMArrayType2(backend.i8Type, 32)
            val action = LLVMBuildAlloca(backend.builder, defaultType, "fault.default")
            LLVMBuildStore(backend.builder, LLVMConstNull(defaultType), action)
            bootstrapLlvmStackGuardKernelSigaction(backend, LLVMGetParam(fault, 0), action)
        } else if (bootstrapLlvmFaultDarwin(backend)) {
            bootstrapLlvmDarwinSigDefault(backend, LLVMGetParam(fault, 0))
        } else {
            bootstrapLlvmDebugCall(
                backend, "signal", backend.pointerType,
                [backend.i64Type, backend.pointerType],
                [LLVMGetParam(fault, 0), LLVMConstNull(backend.pointerType)]
            )
        }
        LLVMBuildRetVoid(backend.builder)
    }
    if (hosted && bootstrapLlvmFaultWindows(backend)) bootstrapLlvmWindowsUnwindTables(backend)
    return
}
