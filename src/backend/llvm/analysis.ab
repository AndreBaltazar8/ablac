fun bootstrapLlvmFunctionSymbol(function: BootstrapIrFunction): string =
    "abla_fn_${bootstrapLlvmFunctionLinkFingerprint(
        function, 41, 269, 1000000007
    )}_${bootstrapLlvmFunctionLinkFingerprint(
        function, 101, 271, 1000000009
    )}"

fun bootstrapLlvmFunctionRuntimeId(function: BootstrapIrFunction): int =
    bootstrapLlvmFunctionLinkFingerprint(function, 151, 277, 1000000007)

// MCU code benefits from exposing fixed class-layout accesses to LLVM. These
// helpers are small, non-recursive, and receive declaration-order indexes, so
// inlining lets the target optimizer fold tag checks and address arithmetic.
// Keep the heuristic out of hosted builds where code size is less constrained.
fun bootstrapLlvmMcuRuntimeInline(
    targetTriple: string,
    name: string
): bool {
    val mcu = bootstrapTextContains(targetTriple, "xtensa") ||
        bootstrapTextContains(targetTriple, "riscv32") ||
        bootstrapTextContains(targetTriple, "thumb")
    mcu && (
        name == "__ablaRuntimeObjectAddress" ||
        name == "__ablaRuntimeFieldAddressIndexed" ||
        name == "__ablaRuntimeFieldGetIndexed" ||
        name == "__ablaRuntimeFieldGetIndexedI64" ||
        name == "__ablaRuntimeFieldGetIndexedBool" ||
        name == "__ablaRuntimeFieldSetIndexed" ||
        name == "__ablaRuntimeFieldSetIndexedI64" ||
        name == "__ablaRuntimeFieldSetIndexedBool"
    )
}

class BootstrapLlvmFunctionIdentities(
    val symbols: array<string>,
    val runtimeIds: array<int>,
    val collisions: int
)

fun bootstrapLlvmFunctionIdentities(
    program: BootstrapIrProgram
): BootstrapLlvmFunctionIdentities {
    val symbols: array<string> = []
    val runtimeIds: array<int> = []
    var collisions = 0
    var function = 0
    while (function < program.functions.size) {
        val symbol = bootstrapLlvmFunctionSymbol(program.functions[function])
        val runtimeId = bootstrapLlvmFunctionRuntimeId(
            program.functions[function]
        )
        var previous = 0
        while (previous < symbols.size) {
            if (symbols[previous] == symbol ||
                runtimeIds[previous] == runtimeId) collisions = collisions + 1
            previous = previous + 1
        }
        symbols.append(symbol)
        runtimeIds.append(runtimeId)
        function = function + 1
    }
    BootstrapLlvmFunctionIdentities(symbols, runtimeIds, collisions)
}

fun bootstrapLlvmStableNameId(name: string): int {
    var hash = bootstrapIrHashText(181, name, 281, 1000000007)
    if (hash < 0) hash = 0 - hash
    hash
}

fun bootstrapLlvmStableNameCollisions(names: array<string>): int {
    var collisions = 0
    var index = 0
    while (index < names.size) {
        val identity = bootstrapLlvmStableNameId(names[index])
        var previous = 0
        while (previous < index) {
            if (names[previous] != names[index] &&
                bootstrapLlvmStableNameId(names[previous]) == identity) {
                collisions = collisions + 1
            }
            previous = previous + 1
        }
        index = index + 1
    }
    collisions
}

fun bootstrapLlvmGlobalSymbol(name: string): string =
    "abla_global_${bootstrapIrHashText(
        191, name, 283, 1000000007
    )}_${bootstrapIrHashText(
        211, name, 293, 1000000009
    )}"

fun bootstrapLlvmStringSymbol(
    function: BootstrapIrFunction,
    result: int
): string = "abla_string_${bootstrapLlvmFunctionSymbol(function)}_$result"

fun bootstrapLlvmStringSymbolFrom(
    functionSymbol: string,
    result: int
): string = "abla_string_${functionSymbol}_$result"

fun bootstrapLlvmJsonEscape(value: string): string {
    var output = ""
    var index = 0
    while (index < value.size) {
        val byte = value[index]
        if (byte == 34) output = "$output\\\""
        else if (byte == 92) output = "$output\\\\"
        else if (byte == 10) output = "$output\\n"
        else if (byte == 13) output = "$output\\r"
        else if (byte == 9) output = "$output\\t"
        else output = "$output${value.slice(index, index + 1)}"
        index = index + 1
    }
    output
}

fun bootstrapLlvmExportAbi(
    exports: array<BootstrapExportRequest>
): string {
    var output = "["
    var index = 0
    while (index < exports.size) {
        val request = exports[index]
        var abi = request.resultType
        var ownership = "value"
        if (request.resultType == "bool") abi = "u8-bool"
        if (request.resultType == "void") ownership = "none"
        if (request.resultType == "string") {
            abi = "owned-bytes-handle"
            ownership = "owned"
        }
        if (index > 0) output = "$output,"
        var parameters = "["
        var parameter = 0
        while (parameter < request.parameterTypes.size) {
            if (parameter > 0) parameters = "$parameters,"
            var abi = request.parameterTypes[parameter]
            if (abi == "bool") abi = "u8-bool"
            if (abi == "string") {
                parameters = "$parameters{\"name\":\"${bootstrapLlvmJsonEscape(
                    request.parameterNames[parameter]
                )}\",\"abi\":\"bytes\",\"lowering\":[\"pointer\",\"u64\"],\"ownership\":\"borrowed\",\"calleeAction\":\"copy\",\"nullable\":false,\"nullPointerAllowedWhenEmpty\":true}"
            } else if (abi == "function:(i64)->i64") {
                parameters = "$parameters{\"name\":\"${bootstrapLlvmJsonEscape(
                    request.parameterNames[parameter]
                )}\",\"abi\":\"callback\",\"callingConvention\":\"c\",\"lowering\":[\"function-pointer\",\"context-pointer\"],\"signature\":{\"parameters\":[\"i64\"],\"result\":\"i64\"},\"ownership\":\"borrowed\",\"lifetime\":\"call\",\"retention\":\"forbidden\",\"invocation\":\"synchronous\",\"callbackNullable\":false,\"contextNullable\":true,\"unwind\":\"forbidden\"}"
            } else {
                parameters = "$parameters{\"name\":\"${bootstrapLlvmJsonEscape(
                    request.parameterNames[parameter]
                )}\",\"abi\":\"$abi\",\"ownership\":\"value\",\"nullable\":false}"
            }
            parameter = parameter + 1
        }
        parameters = "$parameters]"
        var result = "{\"abi\":\"$abi\",\"ownership\":\"$ownership\",\"nullable\":false}"
        if (request.resultType == "string") {
            result = "{\"abi\":\"owned-bytes-handle\",\"ownership\":\"owned\",\"nullable\":false,\"data\":\"abla_owned_bytes_data\",\"length\":\"abla_owned_bytes_length\",\"release\":\"abla_owned_bytes_release\",\"releaseExactlyOnce\":true,\"validUntilRelease\":true}"
        }
        if (request.checked && request.resultType != "void") {
            result = bootstrapLlvmReplaceAll(
                result,
                "{\"abi\":",
                "{\"lowering\":[\"out-pointer\"],\"abi\":"
            )
        }
        var failure = "{\"panic\":\"not-contained\"}"
        if (request.checked) {
            failure = "{\"panic\":\"contained\",\"statusAbi\":\"i32\",\"status\":{\"success\":0,\"panic\":1,\"invalidArguments\":2},\"message\":{\"data\":\"caller-buffer\",\"capacity\":\"u64\",\"requiredLength\":\"u64-out\",\"encoding\":\"bytes\",\"truncation\":\"prefix\"},\"cleanup\":\"abortive\",\"sideEffectsRolledBack\":false,\"concurrency\":\"single-threaded\"}"
        }
        output = "$output\n    {\"source\":\"${bootstrapLlvmJsonEscape(
            request.source
        )}\",\"symbol\":\"${request.name}\",\"parameters\":$parameters,\"result\":$result,\"failure\":$failure}"
        index = index + 1
    }
    if (exports.size > 0) output = "$output\n  "
    "$output]"
}
