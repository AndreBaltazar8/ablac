import "../../ir.ab"

class BootstrapLlvmEmission(
    val output: string,
    val errors: int,
    val abiExports: string
)

class BootstrapLlvmCompilation(
    val output: string,
    val errors: int,
    val parserErrors: int,
    val extensionErrors: int,
    val semanticErrors: int,
    val irErrors: int,
    val diagnostics: string,
    val linkLlvm: bool,
    val linkHost: bool,
    val compileInputPaths: array<string>,
    val compileInputContents: array<string>,
    val abiExports: string
)

fun bootstrapLlvmNeedsLlvm(program: BootstrapIrProgram): bool {
    var needed = false
    var index = 0
    while (index < program.natives.size) {
        val name = program.natives[index].name
        if (name.size >= 4 && name.slice(0, 4) == "LLVM") needed = true
        index = index + 1
    }
    needed
}

// Host-created arrays and strings must share the tracked allocator with the
// emitted value runtime. Programs with no host capabilities can instead keep
// allocation and panic entirely inside their generated LLVM module.
fun bootstrapLlvmNeedsHostRuntime(program: BootstrapIrProgram): bool {
    var needed = false
    var index = 0
    while (index < program.instructions.size) {
        val opcode = program.instructions[index].opcode
        if (opcode == "extern.host" ||
            opcode == "generator.create" || opcode == "task.create" ||
            opcode == "thread.create") needed = true
        index = index + 1
    }
    var functionIndex = 0
    while (functionIndex < program.functions.size) {
        val function = program.functions[functionIndex]
        var instructionIndex = 0
        while (instructionIndex < function.instructions.size) {
            val opcode = function.instructions[instructionIndex].opcode
            if (opcode == "extern.host" || opcode == "generator.create" ||
                opcode == "generator.next" || opcode == "generator.yield" ||
                opcode == "task.create" || opcode == "thread.create" ||
                opcode == "await") {
                needed = true
            }
            instructionIndex = instructionIndex + 1
        }
        functionIndex = functionIndex + 1
    }
    needed
}

fun bootstrapLlvmInstructionNeedsSharedRuntime(
    instruction: BootstrapInstruction
): bool =
    instruction.opcode == "shared.create" ||
    instruction.opcode == "shared.clone" ||
    instruction.opcode == "shared.get" ||
    instruction.opcode == "shared.lock" ||
    instruction.opcode == "shared.unlock" ||
    instruction.opcode == "shared.release" ||
    instruction.opcode == "weak.create" ||
    instruction.opcode == "weak.clone" ||
    instruction.opcode == "weak.upgrade" ||
    instruction.opcode == "weak.alive" ||
    instruction.opcode == "weak.release"

fun bootstrapLlvmNeedsSharedRuntime(program: BootstrapIrProgram): bool {
    var needed = false
    var index = 0
    while (index < program.instructions.size) {
        if (bootstrapLlvmInstructionNeedsSharedRuntime(
            program.instructions[index]
        )) needed = true
        index = index + 1
    }
    var functionIndex = 0
    while (functionIndex < program.functions.size) {
        val function = program.functions[functionIndex]
        var instructionIndex = 0
        while (instructionIndex < function.instructions.size) {
            if (bootstrapLlvmInstructionNeedsSharedRuntime(
                function.instructions[instructionIndex]
            )) needed = true
            instructionIndex = instructionIndex + 1
        }
        functionIndex = functionIndex + 1
    }
    needed
}

fun bootstrapLlvmNeedsCollector(program: BootstrapIrProgram): bool {
    val names: array<string> = []
    var function = 0
    while (function < program.functions.size) {
        names.append(program.functions[function].name)
        function = function + 1
    }
    val functionIndex = bootstrapLlvmNameIndex(names)
    val addressTaken = bootstrapLlvmAddressTaken(program, functionIndex)
    val reachable: array<bool> = []
    function = 0
    while (function < program.functions.size) {
        reachable.append(program.functions[function].name == "main" ||
            program.functions[function].name == "__bootstrap_globals")
        function = function + 1
    }
    val pending: array<int> = []
    function = 0
    while (function < reachable.size) {
        if (reachable[function]) pending.append(function)
        function = function + 1
    }
    var cursor = 0
    var needed = false
    while (cursor < pending.size && !needed) {
        function = pending[cursor]
        cursor = cursor + 1
        var instruction = 0
        while (instruction <
               program.functions[function].instructions.size) {
            val candidate =
                program.functions[function].instructions[instruction]
            if (candidate.opcode == "call" &&
                (candidate.text == "runtimeMemoryCollect" ||
                 candidate.text == "runtimeMemorySetLimit")) {
                needed = true
            }
            if (candidate.opcode == "call") {
                val called = functionIndex.find(candidate.text)
                if (called >= 0 && !reachable[called]) {
                    reachable[called] = true
                    pending.append(called)
                }
            }
            if (candidate.opcode == "call.indirect" ||
                candidate.opcode == "call.indirect.once") {
                var target = 0
                while (target < addressTaken.size) {
                    if (addressTaken[target] && !reachable[target]) {
                        reachable[target] = true
                        pending.append(target)
                    }
                    target = target + 1
                }
            }
            instruction = instruction + 1
        }
    }
    needed
}

class BootstrapLlvmNameIndex(
    val names: array<string>,
    val values: array<int>,
    val slots: array<int>
)

fun bootstrapLlvmHash(name: string): int {
    var hash = 0
    var index = 0
    while (index < name.size) {
        hash = hash * 131 + name[index]
        hash = hash - hash / 2147483647 * 2147483647
        index = index + 1
    }
    hash
}

fun bootstrapLlvmNameValueIndex(
    names: array<string>,
    values: array<int>
): BootstrapLlvmNameIndex {
    var capacity = 8
    while (capacity < names.size * 2 + 1) capacity = capacity * 2
    val slots: array<int> = []
    var index = 0
    while (index < capacity) {
        slots.append(-1)
        index = index + 1
    }
    index = 0
    while (index < names.size) {
        var slot = bootstrapLlvmHash(names[index])
        slot = slot - slot / capacity * capacity
        var placed = false
        while (!placed) {
            val existing = slots[slot]
            if (existing < 0 || names[existing] == names[index]) {
                slots[slot] = index
                placed = true
                placed = placed
            } else {
                slot = slot + 1
                if (slot == capacity) slot = 0
                placed = placed
            }
        }
        index = index + 1
    }
    BootstrapLlvmNameIndex(names, values, slots)
}

fun bootstrapLlvmNameIndex(names: array<string>): BootstrapLlvmNameIndex {
    val values: array<int> = []
    var index = 0
    while (index < names.size) {
        values.append(index)
        index = index + 1
    }
    bootstrapLlvmNameValueIndex(names, values)
}

fun BootstrapLlvmNameIndex.find(name: string): int {
    var result = -1
    var slot = bootstrapLlvmHash(name)
    slot = slot - slot / this.slots.size * this.slots.size
    var probes = 0
    var searching = true
    while (searching && probes < this.slots.size) {
        val existing = this.slots[slot]
        if (existing < 0) {
            searching = false
            searching = searching
        } else if (this.names[existing] == name) {
            result = this.values[existing]
            searching = false
            searching = searching
        } else {
            slot = slot + 1
            if (slot == this.slots.size) slot = 0
            probes = probes + 1
            searching = searching
        }
    }
    result
}

fun bootstrapLlvmNativeParameterType(
    program: BootstrapIrProgram,
    nativeIndex: BootstrapLlvmNameIndex,
    name: string,
    parameter: int
): string {
    var result = "unknown"
    val native = nativeIndex.find(name)
    if (native >= 0 && parameter >= 0 &&
        parameter < program.natives[native].parameterTypes.size) {
        result = program.natives[native].parameterTypes[parameter]
    }
    result
}

fun bootstrapLlvmNativeResultType(
    program: BootstrapIrProgram,
    nativeIndex: BootstrapLlvmNameIndex,
    name: string
): string {
    var result = "unknown"
    val native = nativeIndex.find(name)
    if (native >= 0) result = program.natives[native].resultType
    result
}

fun bootstrapLlvmNativeNoEscape(
    program: BootstrapIrProgram,
    nativeIndex: BootstrapLlvmNameIndex,
    name: string
): bool {
    val native = nativeIndex.find(name)
    native >= 0 && program.natives[native].isNoEscape
}

fun bootstrapLlvmIsPointerType(type: string): bool =
    type.size > 1 && type.slice(type.size - 1, type.size) == "*"

fun bootstrapLlvmNativeType(type: string): string {
    var result = "unknown"
    if (type == "i8" || type == "u8" || type == "char") result = "i8"
    if (type == "i16" || type == "u16") result = "i16"
    if (type == "i32" || type == "u32") result = "i32"
    if (type == "i64" || type == "u64") result = "i64"
    if (type == "f32") result = "f32"
    if (type == "f64") result = "f64"
    if (type == "bool") result = "i1"
    if (type == "cstring" || bootstrapLlvmIsPointerType(type)) result = "ptr"
    if (type == "void") result = "void"
    result
}

fun bootstrapLlvmIsNarrowNativeInteger(type: string): bool =
    type == "i8" || type == "u8" || type == "char" ||
    type == "i16" || type == "u16" ||
    type == "i32" || type == "u32"

fun bootstrapLlvmIsNativeInteger(type: string): bool =
    bootstrapLlvmIsNarrowNativeInteger(type) ||
    type == "i64" || type == "u64"

fun bootstrapLlvmIsUnsignedNativeInteger(type: string): bool =
    type == "char" || type == "u8" || type == "u16" ||
    type == "u32" || type == "u64"

fun bootstrapLlvmScalarBitWidth(type: string): int {
    var result = 0
    if (type == "bool") result = 1
    if (type == "i8" || type == "u8" || type == "char") result = 8
    if (type == "i16" || type == "u16") result = 16
    if (type == "i32" || type == "u32" || type == "f32") result = 32
    if (type == "i64" || type == "u64" || type == "f64") result = 64
    result
}

fun bootstrapLlvmScalarAlignment(type: string): int {
    val width = bootstrapLlvmScalarBitWidth(type)
    if (width <= 8) 1 else if (width <= 16) 2 else if (width <= 32) 4 else 8
}

fun bootstrapLlvmAddressTaken(
    program: BootstrapIrProgram,
    functionIndex: BootstrapLlvmNameIndex
): array<bool> {
    val taken: array<bool> = []
    var function = 0
    while (function < program.functions.size) {
        taken.append(false)
        function = function + 1
    }
    var owner = 0
    while (owner < program.functions.size) {
        var instructionIndex = 0
        while (instructionIndex < program.functions[owner].instructions.size) {
            val instruction = program.functions[owner].instructions[instructionIndex]
            if (instruction.opcode == "function.ref" ||
                instruction.opcode == "closure.create") {
                val found = functionIndex.find(instruction.text)
                if (found >= 0) taken[found] = true
            }
            instructionIndex = instructionIndex + 1
        }
        owner = owner + 1
    }
    taken
}

fun bootstrapLlvmXtensaInterruptHandlerRoots(
    program: BootstrapIrProgram,
    functionIndex: BootstrapLlvmNameIndex
): array<bool> {
    val roots: array<bool> = []
    var function = 0
    while (function < program.functions.size) {
        roots.append(false)
        function = function + 1
    }
    function = 0
    while (function < program.functions.size) {
        var instruction = 0
        while (instruction < program.functions[function].instructions.size) {
            val candidate =
                program.functions[function].instructions[instruction]
            if (candidate.opcode ==
                "native.xtensa.interrupt.handler.address") {
                val target = functionIndex.find(candidate.text)
                if (target >= 0) roots[target] = true
            }
            instruction = instruction + 1
        }
        function = function + 1
    }
    roots
}

// A handler can execute while flash is unavailable. Keep its complete direct
// Abla call graph resident in IRAM automatically; no source annotation is
// needed and ordinary functions remain in their normal section.
fun bootstrapLlvmXtensaInterruptCode(
    program: BootstrapIrProgram,
    functionIndex: BootstrapLlvmNameIndex,
    roots: array<bool>,
    exports: array<BootstrapExportRequest>
): array<bool> {
    val resident: array<bool> = []
    var function = 0
    while (function < roots.size) {
        resident.append(roots[function])
        function = function + 1
    }
    var exported = 0
    while (exported < exports.size) {
        if (exports[exported].name == "xt_unhandled_interrupt") {
            val target = functionIndex.find(exports[exported].source)
            if (target >= 0) resident[target] = true
        }
        exported = exported + 1
    }
    var changed = true
    while (changed) {
        changed = false
        function = 0
        while (function < program.functions.size) {
            if (function < resident.size && resident[function]) {
                var instruction = 0
                while (instruction <
                       program.functions[function].instructions.size) {
                    val candidate =
                        program.functions[function].instructions[instruction]
                    if (candidate.opcode == "call") {
                        val target = functionIndex.find(candidate.text)
                        if (target >= 0 && !resident[target]) {
                            resident[target] = true
                            changed = true
                        }
                    }
                    instruction = instruction + 1
                }
            }
            function = function + 1
        }
    }
    resident
}

fun bootstrapLlvmInstructionMayCollect(
    instruction: BootstrapInstruction,
    functionIndex: BootstrapLlvmNameIndex,
    mayCollect: array<bool>
): bool {
    var result = false
    if (instruction.opcode == "call" &&
        instruction.text == "runtimeMemoryCollect") result = true
    if (instruction.opcode == "call.indirect" ||
        instruction.opcode == "call.indirect.once") result = true
    if (instruction.opcode == "generator.create" ||
        instruction.opcode == "generator.next" ||
        instruction.opcode == "generator.yield" ||
        instruction.opcode == "generator.drop" ||
        instruction.opcode == "task.create" ||
        instruction.opcode == "task.drop" ||
        instruction.opcode == "thread.create" ||
        instruction.opcode == "thread.drop" ||
        instruction.opcode == "await") result = true
    if (instruction.opcode == "call") {
        val called = functionIndex.find(instruction.text)
        if (called >= 0 && called < mayCollect.size) result = mayCollect[called]
    }
    result
}

fun bootstrapLlvmInstructionMayAllocate(
    instruction: BootstrapInstruction
): bool {
    var result = false
    if (instruction.opcode == "array.create" ||
        instruction.opcode == "array.append" ||
        instruction.opcode == "cell.create" ||
        instruction.opcode == "closure.create" ||
        instruction.opcode == "generator.create" ||
        instruction.opcode == "task.create" ||
        instruction.opcode == "thread.create" ||
        instruction.opcode == "field.set" ||
        instruction.opcode == "field.set.indexed" ||
        instruction.opcode == "object.allocate" ||
        instruction.opcode == "object.create" ||
        instruction.opcode == "shared.create" ||
        instruction.opcode == "string.concat" ||
        instruction.opcode == "string.slice" ||
        instruction.opcode == "to.string") result = true
    // String inspection may lazily flatten ropes. Host/native boundaries may
    // materialize returned heap values.
    if (instruction.opcode == "==" || instruction.opcode == "!=" ||
        instruction.opcode == "string.equal" ||
        instruction.opcode == "string.not.equal" ||
        instruction.opcode == "index.get" ||
        instruction.opcode == "string.get" ||
        instruction.opcode == "extern.c" ||
        instruction.opcode == "extern.host") result = true
    if (instruction.opcode == "call" &&
        instruction.text == "ablaUnsafeAllocate") result = true
    result
}

fun bootstrapLlvmCollectingFunctions(
    program: BootstrapIrProgram,
    functionIndex: BootstrapLlvmNameIndex,
    addressTaken: array<bool>
): array<bool> {
    val automaticPressure = bootstrapLlvmNeedsCollector(program)
    val result: array<bool> = []
    var function = 0
    while (function < program.functions.size) {
        var direct = program.functions[function].name ==
            "runtimeMemoryCollect" ||
            program.functions[function].name ==
                "__ablaRuntimePlatformMemoryCollect"
        var instruction = 0
        while (instruction < program.functions[function].instructions.size) {
            val candidate = program.functions[function].instructions[instruction]
            if (candidate.opcode == "generator.create" ||
                candidate.opcode == "generator.next" ||
                candidate.opcode == "generator.yield" ||
                candidate.opcode == "generator.drop" ||
                candidate.opcode == "task.create" ||
                candidate.opcode == "task.drop" ||
                candidate.opcode == "thread.create" ||
                candidate.opcode == "thread.drop" ||
                candidate.opcode == "await") direct = true
            if (automaticPressure &&
                bootstrapLlvmInstructionMayAllocate(candidate)) direct = true
            instruction = instruction + 1
        }
        result.append(direct)
        function = function + 1
    }
    var changed = true
    while (changed) {
        changed = false
        var indirectMayCollect = false
        function = 0
        while (function < result.size && function < addressTaken.size) {
            if (result[function] && addressTaken[function]) {
                indirectMayCollect = true
            }
            function = function + 1
        }
        function = 0
        while (function < program.functions.size) {
            if (!result[function]) {
                var instruction = 0
                while (instruction <
                       program.functions[function].instructions.size) {
                    val candidate =
                        program.functions[function].instructions[instruction]
                    if (candidate.opcode == "call") {
                        val called = functionIndex.find(candidate.text)
                        if (called >= 0 && result[called]) {
                            result[function] = true
                            changed = true
                        }
                    }
                    if ((candidate.opcode == "call.indirect" ||
                         candidate.opcode == "call.indirect.once") &&
                        indirectMayCollect) {
                        result[function] = true
                        changed = true
                    }
                    instruction = instruction + 1
                }
            }
            function = function + 1
        }
    }
    result
}

fun bootstrapLlvmGcRootPlan(
    function: BootstrapIrFunction,
    functionIndex: BootstrapLlvmNameIndex,
    mayCollect: array<bool>
): array<bool> {
    var valueCount = 0
    var instruction = 0
    while (instruction < function.instructions.size) {
        val candidate = function.instructions[instruction]
        if (candidate.result >= valueCount) valueCount = candidate.result + 1
        if (candidate.left >= valueCount) valueCount = candidate.left + 1
        if (candidate.right >= valueCount) valueCount = candidate.right + 1
        var operand = 0
        while (operand < candidate.operands.size) {
            if (candidate.operands[operand] >= valueCount) {
                valueCount = candidate.operands[operand] + 1
            }
            operand = operand + 1
        }
        instruction = instruction + 1
    }

    val definitions: array<int> = []
    val lastUses: array<int> = []
    val result: array<bool> = []
    var value = 0
    while (value < valueCount) {
        definitions.append(-1)
        lastUses.append(-1)
        result.append(false)
        value = value + 1
    }

    // collectorPrefix[n] counts collection-capable instructions before n.
    // That makes the old strict interval (definition, last use) an O(1)
    // lookup for every SSA value instead of rescanning the whole function.
    val collectorPrefix: array<int> = []
    collectorPrefix.append(0)
    instruction = 0
    while (instruction < function.instructions.size) {
        val candidate = function.instructions[instruction]
        if (candidate.result >= 0 &&
            definitions[candidate.result] < 0) {
            definitions[candidate.result] = instruction
        }
        if (candidate.left >= 0) lastUses[candidate.left] = instruction
        if (candidate.right >= 0) lastUses[candidate.right] = instruction
        var operand = 0
        while (operand < candidate.operands.size) {
            val used = candidate.operands[operand]
            if (used >= 0) lastUses[used] = instruction
            operand = operand + 1
        }
        var collectorCount = collectorPrefix[instruction]
        if (bootstrapLlvmInstructionMayCollect(
            candidate,
            functionIndex,
            mayCollect
        )) collectorCount = collectorCount + 1
        collectorPrefix.append(collectorCount)
        instruction = instruction + 1
    }

    value = 0
    while (value < valueCount) {
        val definition = definitions[value]
        val lastUse = lastUses[value]
        if (definition >= 0 && lastUse > definition &&
            collectorPrefix[lastUse] > collectorPrefix[definition + 1]) {
            result[value] = true
        }
        value = value + 1
    }
    result
}

fun bootstrapLlvmParameterId(
    function: BootstrapIrFunction,
    name: string
): int {
    var result = -1
    var index = 0
    while (index < function.parameters.size) {
        if (function.parameters[index] == name) result = index
        index = index + 1
    }
    result
}

class BootstrapLlvmScalarPlan(
    val valueTypes: array<string>,
    val localTypes: array<string>,
    val boxedValues: array<bool>
)

fun bootstrapLlvmValueLayoutIntrinsic(name: string): bool =
    name == "ablaRuntimeValueAddress" ||
    name == "ablaRuntimeMakeValue" ||
    name == "ablaRuntimeLoadI32" ||
    name == "ablaRuntimeStoreI32" ||
    name == "ablaRuntimeLoadI64" ||
    name == "ablaRuntimeStoreI64" ||
    name == "ablaRuntimeLoadU8" ||
    name == "ablaRuntimeStoreU8"

// Keep these classifiers bounded. The self-hosted compile-time evaluator
// visits boolean chains recursively, so one ever-growing intrinsic list can
// otherwise exhaust the host stack as new native signatures are added.
fun bootstrapLlvmUnsafeBulkVoidCallIntrinsic(name: string): bool =
    name == "ablaUnsafeCallVoidPointerI32PointerI32Pointer" ||
    name == "ablaUnsafeCallVoidPointerI32PointerI32I64I32" ||
    name == "ablaUnsafeCallVoidPointerI32I32PointerPointerPointerPointer" ||
    name == "ablaUnsafeCallVoidPointerI64I64I64" ||
    name == "ablaUnsafeCallVoidPointerI32I64I32I32Pointer" ||
    name == "ablaUnsafeCallVoidPointerI32I64I64Pointer"

fun bootstrapLlvmUnsafeCoreVoidCallIntrinsicA(name: string): bool =
    name == "ablaUnsafeCallVoidPointerPointerI32" ||
    name == "ablaUnsafeCallVoidPointerI32I64I32I32PointerI32Pointer" ||
    name == "ablaUnsafeCallVoidPointerI64I32I64I32Pointer" ||
    name == "ablaUnsafeCallVoidPointerI64I32I32I64I64I64I32" ||
    name == "ablaUnsafeCallVoidPointerI32I32I32I32PointerI32PointerI32Pointer" ||
    name == "ablaUnsafeCallVoidPointerI64I32I32I32Pointer" ||
    name == "ablaUnsafeCallVoidPointerI32PointerI32I32I32PointerI32PointerI32Pointer"

fun bootstrapLlvmUnsafeFinalVoidCallIntrinsic1(name: string): bool =
    name == "ablaUnsafeCallVoidPointerPointerI64I64I32I64I64I64I64" ||
    name == "ablaUnsafeCallVoidPointerI32PointerPointerPointerPointer" ||
    name == "ablaUnsafeCallVoidPointerI64I32I32I64I32Pointer" ||
    name == "ablaUnsafeCallVoidPointerI64I32I32PointerI32I32" ||
    name == "ablaUnsafeCallVoidPointerI64I64I64I32I32" ||
    name == "ablaUnsafeCallVoidPointerI32I32PointerI32I32"

fun bootstrapLlvmUnsafeFinalVoidCallIntrinsic2(name: string): bool =
    name == "ablaUnsafeCallVoidPointerI32I32I64I64I32I32" ||
    name == "ablaUnsafeCallVoidPointerPointerI32I32" ||
    name == "ablaUnsafeCallVoidPointerI32I64I32I32PointerPointer" ||
    name == "ablaUnsafeCallVoidPointer5I64" ||
    name == "ablaUnsafeCallVoidPointer5I32I32I32" ||
    name == "ablaUnsafeCallVoidPointerI64I64I64I64I64I64I64I64I64I64I64I32I32I32"

fun bootstrapLlvmUnsafeFinalVoidCallIntrinsic3(name: string): bool =
    name == "ablaUnsafeCallVoidPointerPointerI32I64Pointer" ||
    name == "ablaUnsafeCallVoidPointerI32I64I64I32" ||
    name == "ablaUnsafeCallVoidPointerI32I32I64I64I32PointerPointer" ||
    name == "ablaUnsafeCallVoidI64PointerPointer" ||
    name == "ablaUnsafeCallVoidPointerI32I16"

fun bootstrapLlvmUnsafeFinalResultCallIntrinsic1(name: string): bool =
    name == "ablaUnsafeCallI32PointerI32I64" ||
    name == "ablaUnsafeCallI32PointerI64I32I64I32" ||
    name == "ablaUnsafeCallI64PointerI64I64" ||
    name == "ablaUnsafeCallAddressPointerPointer" ||
    name == "ablaUnsafeCallI32PointerI32I32Pointer" ||
    name == "ablaUnsafeCallI64PointerI32"

fun bootstrapLlvmUnsafeFinalResultCallIntrinsic2(name: string): bool =
    name == "ablaUnsafeCallI32PointerI32I32I32I32I32I32Pointer" ||
    name == "ablaUnsafeCallI32PointerI64I32I32PointerPointer" ||
    name == "ablaUnsafeCallI32PointerI64PointerPointerI32" ||
    name == "ablaUnsafeCallI32PointerI32PointerI32" ||
    name == "ablaUnsafeCallI32PointerPointerI64Pointer"

fun bootstrapLlvmUnsafeCoreVoidCallIntrinsicB(name: string): bool =
    name == "ablaUnsafeCallVoidPointerI64I32I32I32" ||
    name == "ablaUnsafeCallVoidPointerI32I32PointerPointerPointer" ||
    name == "ablaUnsafeCallVoidPointerI32PointerI32I32I32" ||
    name == "ablaUnsafeCallVoidPointerI32PointerI32I32I32Pointer" ||
    name == "ablaUnsafeCallVoidPointerI32PointerPointerPointer" ||
    name == "ablaUnsafeCallVoidPointerI32I32I32I32I32PointerPointer"

fun bootstrapLlvmUnsafeVoidCallIntrinsic(name: string): bool =
    name == "ablaUnsafeCallVoid0" ||
    name == "ablaUnsafeCallVoidI32" ||
    name == "ablaUnsafeCallVoidI32I32" ||
    name == "ablaUnsafeCallVoidPointerI32" ||
    name == "ablaUnsafeCallVoidPointer" ||
    name == "ablaUnsafeCallVoidPointerI32I32" ||
    name == "ablaUnsafeCallVoidPointerI64I32" ||
    name == "ablaUnsafeCallVoidPointerI64I32I32" ||
    name == "ablaUnsafeCallVoidPointerI64I64" ||
    name == "ablaUnsafeCallVoidPointerI64I64I32" ||
    name == "ablaUnsafeCallVoidPointerI64I64I32Pointer" ||
    name == "ablaUnsafeCallVoidPointerI64I64I64I32" ||
    name == "ablaUnsafeCallVoidPointerI64I64I64Pointer" ||
    name == "ablaUnsafeCallVoidPointerI64I64I32I32" ||
    name == "ablaUnsafeCallVoidPointerI64I64I64I64I32I32" ||
    name == "ablaUnsafeCallVoidPointerI64" ||
    name == "ablaUnsafeCallVoidPointerI32I64" ||
    name == "ablaUnsafeCallVoidPointerI32I64I32" ||
    name == "ablaUnsafeCallVoidPointerI32I32I32" ||
    name == "ablaUnsafeCallVoidPointerI32I32I32I32" ||
    name == "ablaUnsafeCallVoidPointerI32I32I32I32I32" ||
    name == "ablaUnsafeCallVoidPointerI32I32I32I32I32I32" ||
    name == "ablaUnsafeCallVoidPointerI32PointerPointer" ||
    name == "ablaUnsafeCallVoidPointerI32I32PointerPointer" ||
    name == "ablaUnsafeCallVoidPointerF32" ||
    name == "ablaUnsafeCallVoidPointerF32F32" ||
    name == "ablaUnsafeCallVoidPointerF32F32F32" ||
    name == "ablaUnsafeCallVoidPointerI64F32" ||
    name == "ablaUnsafeCallVoidPointerI64I64I32I32Pointer" ||
    name == "ablaUnsafeCallVoidPointerI64I32I64I32I32Pointer" ||
    name == "ablaUnsafeCallVoidPointerI64I32I64I32I32PointerI32" ||
    name == "ablaUnsafeCallVoidPointerI64I32PointerI32Pointer" ||
    name == "ablaUnsafeCallVoidPointerI64PointerPointer" ||
    name == "ablaUnsafeCallVoidPointer4" ||
    name == "ablaUnsafeCallVoidPointerI32I32I32Pointer" ||
    name == "ablaUnsafeCallVoidPointerI64I32Pointer" ||
    name == "ablaUnsafeCallVoidPointerI64I64Pointer" ||
    name == "ablaUnsafeCallVoidPointerPointerI64Pointer" ||
    name == "ablaUnsafeCallVoidPointerPointer" ||
    name == "ablaUnsafeCallVoidPointerI32Pointer" ||
    name == "ablaUnsafeCallVoidPointer3" ||
    name == "ablaUnsafeCallVoidPointerIntPointer" ||
    name == "ablaUnsafeCallVoidPointerIntIntPointer" ||
    bootstrapLlvmUnsafeBulkVoidCallIntrinsic(name) ||
    bootstrapLlvmUnsafeCoreVoidCallIntrinsicA(name) ||
    bootstrapLlvmUnsafeCoreVoidCallIntrinsicB(name) ||
    bootstrapLlvmUnsafeFinalVoidCallIntrinsic1(name) ||
    bootstrapLlvmUnsafeFinalVoidCallIntrinsic2(name) ||
    bootstrapLlvmUnsafeFinalVoidCallIntrinsic3(name)

fun bootstrapLlvmUnsafeBulkStatusCallIntrinsic(name: string): bool =
    name == "ablaUnsafeCallI32PointerI32PointerPointer" ||
    name == "ablaUnsafeCallI32Pointer5" ||
    name == "ablaUnsafeCallI32PointerI64I32PointerPointer" ||
    name == "ablaUnsafeCallI32PointerI64PointerPointerPointer" ||
    name == "ablaUnsafeCallI32PointerI32PointerPointerPointerPointer" ||
    name == "ablaUnsafeCallI32PointerPointerI32Pointer" ||
    name == "ablaUnsafeCallI32PointerI32I64I64I64" ||
    name == "ablaUnsafeCallI32PointerI32PointerI32I64PointerI64"

fun bootstrapLlvmUnsafeCoreStatusCallIntrinsic(name: string): bool =
    name == "ablaUnsafeCallI32PointerI64I64I64I64Pointer" ||
    name == "ablaUnsafeCallI32PointerI32I32I32I32I32Pointer" ||
    name == "ablaUnsafeCallI32PointerI32I64Pointer" ||
    name == "ablaUnsafeCallI32PointerI64I32I32I64PointerI64I32" ||
    name == "ablaUnsafeCallI32PointerI64I64I64I32Pointer" ||
    name == "ablaUnsafeCallI32PointerI64I64Pointer" ||
    name == "ablaUnsafeCallI64PointerI64I32I32"

fun bootstrapLlvmUnsafeStatusCallIntrinsic(name: string): bool =
    name == "ablaUnsafeCallI32Pointer" ||
    name == "ablaUnsafeCallI32PointerI64" ||
    name == "ablaUnsafeCallI32PointerI64Pointer" ||
    name == "ablaUnsafeCallI32PointerI64PointerPointer" ||
    name == "ablaUnsafeCallI32PointerPointerI64" ||
    name == "ablaUnsafeCallI32PointerI32PointerI64" ||
    name == "ablaUnsafeCallI32PointerI64I64I64" ||
    name == "ablaUnsafeCallI64PointerPointer" ||
