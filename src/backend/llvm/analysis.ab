fun bootstrapLlvmUnsafeCallIntrinsic(name: string): bool =
    name == "ablaUnsafeCallMain" ||
    bootstrapLlvmUnsafeVoidCallIntrinsic(name) ||
    bootstrapLlvmUnsafeStatusCallIntrinsic(name)

// These declarations have a direct LLVM lowering. Other
// extern:"intrinsic" functions are portable boxed runtime bridges.
fun bootstrapLlvmNativeIntrinsic(name: string): bool =
    bootstrapLlvmValueLayoutIntrinsic(name) ||
    name == "ablaRuntimeTrap" ||
    name == "ablaRuntimePointerAddress" ||
    name == "ablaRuntimePointerFromAddress" ||
    name == "nativeStackAllocate" ||
    name == "nativeStaticAllocate" ||
    name == "nativeXtensaCoreId" ||
    name == "nativeXtensaCycleCounter" ||
    name == "nativeXtensaDelayCycles" ||
    name == "nativeXtensaInterruptsEnable" ||
    name == "nativeXtensaInterruptsDisable" ||
    name == "nativeXtensaInterruptTableAddress" ||
    name == "nativeXtensaExceptionTableAddress" ||
    name == "nativeXtensaInterruptLevelTableAddress" ||
    name == "nativeXtensaUnhandledInterruptAddress" ||
    name == "nativeXtensaUnhandledExceptionAddress" ||
    name == "nativeXtensaOwnedDispatcherTableAddress" ||
    name == "ablaUnsafeLoadI64" ||
    name == "ablaUnsafeStoreI64" ||
    name == "ablaUnsafeAtomicFetchAddI64" ||
    name == "ablaUnsafeLoadPointer" ||
    name == "ablaUnsafeStorePointer" ||
    name == "ablaUnsafeNullPointer" ||
    name == "ablaUnsafePointerIsNull" ||
    bootstrapLlvmUnsafeCallIntrinsic(name) ||
    name == "ablaUnsafeCStringAddress" ||
    name == "ablaUnsafeStringAddress" ||
    name == "ablaUnsafePointerAddress" ||
    name == "ablaUnsafePointerOffset" ||
    name == "ablaUnsafeLoadU8" ||
    name == "ablaUnsafeLoadU16" ||
    name == "ablaUnsafeLoadU32" ||
    name == "ablaUnsafeStoreU8" ||
    name == "ablaUnsafeStoreU16" ||
    name == "ablaUnsafeStoreU32" ||
    name == "ablaUnsafeSetMemory" ||
    name == "ablaUnsafeVolatileLoadU8" ||
    name == "ablaUnsafeVolatileLoadU16" ||
    name == "ablaUnsafeVolatileLoadU32" ||
    name == "ablaUnsafeVolatileLoadU64" ||
    name == "ablaUnsafeVolatileStoreU8" ||
    name == "ablaUnsafeVolatileStoreU16" ||
    name == "ablaUnsafeVolatileStoreU32" ||
    name == "ablaUnsafeVolatileStoreU64" ||
    name == "ablaUnsafeAdoptString" ||
    name == "ablaUnsafeBorrowCString" ||
    name == "ablaBitF64ToI64" ||
    name == "ablaBitI64ToF64" ||
    name == "ablaConvertI64ToF64" ||
    name == "ablaHostIsMacOS" ||
    name == "ablaHostValueArgumentsIndirect" ||
    name == "ablaLinuxArgumentCount" ||
    name == "ablaLinuxArgument" ||
    name == "ablaLinuxEnvironmentPointer" ||
    name == "ablaLinuxSyscall" ||
    name == "ablaRuntimeWasmHeapBase" ||
    name == "ablaRuntimeWasmMemorySize" ||
    name == "ablaRuntimeWasmMemoryGrow"

fun bootstrapLlvmScalarValueCount(function: BootstrapIrFunction): int {
    var count = 0
    var instruction = 0
    while (instruction < function.instructions.size) {
        val candidate = function.instructions[instruction]
        if (candidate.result >= count) count = candidate.result + 1
        if (candidate.left >= count) count = candidate.left + 1
        if (candidate.right >= count) count = candidate.right + 1
        var operand = 0
        while (operand < candidate.operands.size) {
            if (candidate.operands[operand] >= count) {
                count = candidate.operands[operand] + 1
            }
            operand = operand + 1
        }
        instruction = instruction + 1
    }
    count
}

fun bootstrapLlvmScalarType(type: string): string {
    val normalized = bootstrapNormalizeType(type)
    if (bootstrapIsIntegerScalarType(normalized)) normalized
    else if (normalized == "bool") "bool"
    else if (normalized == "f32" || normalized == "f64") normalized
    else ""
}

fun bootstrapLlvmInferScalarValues(
    program: BootstrapIrProgram,
    function: BootstrapIrFunction,
    functionIndex: BootstrapLlvmNameIndex,
    nativeIndex: BootstrapLlvmNameIndex,
    localIndex: BootstrapLlvmNameIndex,
    localTypes: array<string>
): array<string> {
    val types: array<string> = []
    var value = 0
    while (value < bootstrapLlvmScalarValueCount(function)) {
        types.append("")
        value = value + 1
    }
    var changed = true
    while (changed) {
        changed = false
        var position = 0
        while (position < function.instructions.size) {
            val instruction = function.instructions[position]
            var inferred = ""
            if (instruction.opcode == "const.i64") inferred = "i64"
            if (instruction.opcode == "const.f64") inferred = "f64"
            if (instruction.opcode == "const.bool") inferred = "bool"
            if (instruction.opcode == "scalar.cast") {
                inferred = bootstrapLlvmScalarType(instruction.text)
            }
            if (instruction.opcode == "string.length" ||
                instruction.opcode == "string.get" ||
                instruction.opcode == "array.length" ||
                instruction.opcode == "array.get.i64") inferred = "i64"
            if (instruction.opcode == "array.get.bool" ||
                instruction.opcode == "field.get.indexed.bool" ||
                instruction.opcode == "string.equal" ||
                instruction.opcode == "string.not.equal") inferred = "bool"
            if (instruction.opcode == "field.get.indexed.i64") {
                inferred = "i64"
            }
            if (instruction.opcode == "array.get.f64" ||
                instruction.opcode == "field.get.indexed.f64") {
                inferred = "f64"
            }
            if (instruction.opcode == "field.set.indexed.i64") {
                inferred = "i64"
            }
            if (instruction.opcode == "field.set.indexed.bool") {
                inferred = "bool"
            }
            if (instruction.opcode == "field.set.indexed.f64") {
                inferred = "f64"
            }
            if (instruction.opcode == "parameter.load") {
                val parameter = bootstrapLlvmParameterId(
                    function, instruction.text
                )
                if (parameter >= 0 &&
                    parameter < function.parameterTypes.size) {
                    inferred = bootstrapLlvmScalarType(
                        function.parameterTypes[parameter]
                    )
                }
            }
            if (instruction.opcode == "global.load" ||
                instruction.opcode == "global.assign" ||
                instruction.opcode == "global.store") {
                inferred = bootstrapLlvmGlobalScalarType(
                    program, instruction.text
                )
            }
            if (instruction.opcode == "local.load" ||
                instruction.opcode == "resource.peek" ||
                instruction.opcode == "place.root") {
                val local = localIndex.find(instruction.text)
                if (local >= 0 && local < localTypes.size) {
                    inferred = localTypes[local]
                }
            }
            if (instruction.opcode == "local.declare" ||
                instruction.opcode == "local.assign") {
                val local = localIndex.find(instruction.text)
                if (local >= 0 && local < localTypes.size &&
                    localTypes[local] != "" &&
                    instruction.left >= 0 &&
                    instruction.left < types.size) {
                    inferred = types[instruction.left]
                }
            }
            if (instruction.opcode == "call") {
                val called = functionIndex.find(instruction.text)
                if (called >= 0 && called < program.functions.size) {
                    inferred = bootstrapLlvmScalarType(
                        program.functions[called].resultType
                    )
                }
            }
            if (instruction.opcode ==
                "native.xtensa.interrupt.handler.address") {
                inferred = "u32"
            }
            if (instruction.opcode == "inline.assembly") {
                inferred = bootstrapLlvmScalarType(instruction.text)
            }
            if (instruction.opcode == "extern.c" ||
                (instruction.opcode == "extern.intrinsic" &&
                 bootstrapLlvmNativeIntrinsic(instruction.text))) {
                val native = nativeIndex.find(instruction.text)
                if (native >= 0 && native < program.natives.size) {
                    inferred = bootstrapLlvmScalarType(
                        program.natives[native].resultType
                    )
                }
            }
            if (instruction.opcode == "+" ||
                instruction.opcode == "-" ||
                instruction.opcode == "*" ||
                instruction.opcode == "/" ||
                instruction.opcode == "neg") {
                if (instruction.left >= 0 &&
                    instruction.left < types.size &&
                    (bootstrapIsIntegerScalarType(types[instruction.left]) ||
                     types[instruction.left] == "f64")) {
                    inferred = types[instruction.left]
                }
            }
            if (instruction.opcode == "&" ||
                instruction.opcode == "|" ||
                instruction.opcode == "^" ||
                instruction.opcode == "bit.not" ||
                instruction.opcode == "<<" ||
                instruction.opcode == ">>" ||
                instruction.opcode == ">>>") {
                if (instruction.left >= 0 &&
                    instruction.left < types.size &&
                    bootstrapIsIntegerScalarType(types[instruction.left])) {
                    inferred = types[instruction.left]
                }
            }
            if (instruction.opcode == "not" ||
                instruction.opcode == "&&" ||
                instruction.opcode == "||") inferred = "bool"
            if (instruction.opcode == "==" ||
                instruction.opcode == "!=") {
                if (instruction.left >= 0 && instruction.right >= 0 &&
                    instruction.left < types.size &&
                    instruction.right < types.size &&
                    types[instruction.left] != "" &&
                    (types[instruction.left] == types[instruction.right] ||
                     (bootstrapIsIntegerScalarType(
                        types[instruction.left]
                      ) && bootstrapIsIntegerScalarType(
                        types[instruction.right]
                      )))) {
                    inferred = "bool"
                }
            }
            if (instruction.opcode == "<" ||
                instruction.opcode == "<=" ||
                instruction.opcode == ">" ||
                instruction.opcode == ">=") {
                if (instruction.left >= 0 && instruction.right >= 0 &&
                    instruction.left < types.size &&
                    instruction.right < types.size &&
                    ((types[instruction.left] == types[instruction.right] &&
                      types[instruction.left] == "f64") ||
                     (bootstrapIsIntegerScalarType(types[instruction.left]) &&
                      bootstrapIsIntegerScalarType(
                        types[instruction.right]
                      )))) inferred = "bool"
            }
            if (instruction.result >= 0 &&
                instruction.result < types.size && inferred != "" &&
                types[instruction.result] == "") {
                types[instruction.result] = inferred
                changed = true
            }
            position = position + 1
        }
    }
    types
}

fun bootstrapLlvmBuildScalarPlan(
    program: BootstrapIrProgram,
    function: BootstrapIrFunction,
    functionIndex: BootstrapLlvmNameIndex,
    nativeIndex: BootstrapLlvmNameIndex
): BootstrapLlvmScalarPlan {
    val localIndex = bootstrapLlvmLocalIndex(function)
    val localTypes: array<string> = []
    var instruction = 0
    while (instruction < function.instructions.size) {
        localTypes.append("")
        instruction = instruction + 1
    }
    var local = 0
    while (local < function.locals.size &&
        local < function.localTypes.size) {
        val declaration = function.locals[local].declaration
        if (declaration >= 0 && declaration < localTypes.size) {
            localTypes[declaration] = bootstrapLlvmScalarType(
                function.localTypes[local]
            )
        }
        local = local + 1
    }
    var valueTypes = bootstrapLlvmInferScalarValues(
        program, function, functionIndex, nativeIndex,
        localIndex, localTypes
    )
    instruction = 0
    while (instruction < function.instructions.size) {
        val candidate = function.instructions[instruction]
        if (candidate.opcode == "local.zero.i64") {
            localTypes[instruction] = "i64"
        }
        if (candidate.opcode == "local.zero.u64") {
            localTypes[instruction] = "u64"
        }
        if (candidate.opcode == "local.zero.i32") {
            localTypes[instruction] = "i32"
        }
        if (candidate.opcode == "local.zero.u32") {
            localTypes[instruction] = "u32"
        }
        if (candidate.opcode == "local.zero.i16") {
            localTypes[instruction] = "i16"
        }
        if (candidate.opcode == "local.zero.u16") {
            localTypes[instruction] = "u16"
        }
        if (candidate.opcode == "local.zero.i8") {
            localTypes[instruction] = "i8"
        }
        if (candidate.opcode == "local.zero.u8") {
            localTypes[instruction] = "u8"
        }
        if (candidate.opcode == "local.zero.char") {
            localTypes[instruction] = "char"
        }
        if (candidate.opcode == "local.zero.bool") {
            localTypes[instruction] = "bool"
        }
        if (candidate.opcode == "local.declare" &&
            localTypes[instruction] == "" &&
            candidate.left >= 0 && candidate.left < valueTypes.size) {
            localTypes[instruction] = valueTypes[candidate.left]
        }
        instruction = instruction + 1
    }
    var stable = false
    while (!stable) {
        valueTypes = bootstrapLlvmInferScalarValues(
            program, function, functionIndex, nativeIndex,
            localIndex, localTypes
        )
        stable = true
        instruction = 0
        while (instruction < function.instructions.size) {
            val candidate = function.instructions[instruction]
            if (candidate.opcode == "local.declare" ||
                candidate.opcode == "local.assign" ||
                candidate.opcode == "local.set") {
                val local = localIndex.find(candidate.text)
                if (local >= 0 && local < localTypes.size &&
                    localTypes[local] != "") {
                    var assigned = ""
                    if (candidate.left >= 0 &&
                        candidate.left < valueTypes.size) {
                        assigned = valueTypes[candidate.left]
                    }
                    if (assigned != localTypes[local]) {
                        localTypes[local] = ""
                        stable = false
                    }
                }
            }
            if (candidate.opcode == "local.allocate") {
                val local = localIndex.find(candidate.text)
                if (local >= 0 && local < localTypes.size &&
                    localTypes[local] != "") {
                    localTypes[local] = ""
                    stable = false
                }
            }
            instruction = instruction + 1
        }
    }
    valueTypes = bootstrapLlvmInferScalarValues(
        program, function, functionIndex, nativeIndex,
        localIndex, localTypes
    )
    val boxedValues: array<bool> = []
    var value = 0
    while (value < valueTypes.size) {
        boxedValues.append(false)
        value = value + 1
    }
    instruction = 0
    while (instruction < function.instructions.size) {
        val candidate = function.instructions[instruction]
        var nativeInputs = false
        if (candidate.opcode == "+" || candidate.opcode == "-" ||
            candidate.opcode == "*" || candidate.opcode == "/" ||
            candidate.opcode == "neg" ||
            candidate.opcode == "&" || candidate.opcode == "|" ||
            candidate.opcode == "^" || candidate.opcode == "bit.not" ||
            candidate.opcode == "<<" || candidate.opcode == ">>" ||
            candidate.opcode == ">>>" ||
            candidate.opcode == "not" || candidate.opcode == "&&" ||
            candidate.opcode == "||" || candidate.opcode == "==" ||
            candidate.opcode == "!=" || candidate.opcode == "<" ||
            candidate.opcode == "<=" || candidate.opcode == ">" ||
            candidate.opcode == ">=") {
            nativeInputs = candidate.result >= 0 &&
                candidate.result < valueTypes.size &&
                valueTypes[candidate.result] != ""
        }
        if (candidate.opcode == "scalar.cast") nativeInputs = true
        if (candidate.opcode == "branch") nativeInputs =
            candidate.left >= 0 && candidate.left < valueTypes.size &&
            valueTypes[candidate.left] == "bool"
        if (candidate.opcode == "string.length" ||
            candidate.opcode == "string.get" ||
            candidate.opcode == "array.length" ||
            candidate.opcode == "array.get.i64" ||
            candidate.opcode == "array.get.bool" ||
            candidate.opcode == "array.get.f64") {
            nativeInputs = true
            if (candidate.left >= 0 &&
                candidate.left < boxedValues.size) {
                boxedValues[candidate.left] = true
            }
        }
        if (candidate.opcode == "string.equal" ||
            candidate.opcode == "string.not.equal") {
            nativeInputs = true
            if (candidate.left >= 0 &&
                candidate.left < boxedValues.size) {
                boxedValues[candidate.left] = true
            }
            if (candidate.right >= 0 &&
                candidate.right < boxedValues.size) {
                boxedValues[candidate.right] = true
            }
        }
        if (candidate.opcode == "field.get.indexed.i64" ||
            candidate.opcode == "field.get.indexed.bool" ||
            candidate.opcode == "field.get.indexed.f64") {
            nativeInputs = true
            if (candidate.left >= 0 &&
                candidate.left < boxedValues.size) {
                boxedValues[candidate.left] = true
            }
        }
        if (candidate.opcode == "field.set.indexed.i64" ||
            candidate.opcode == "field.set.indexed.bool" ||
            candidate.opcode == "field.set.indexed.f64") {
            nativeInputs = true
            if (candidate.left >= 0 &&
                candidate.left < boxedValues.size) {
                boxedValues[candidate.left] = true
            }
        }
        if (candidate.opcode == "return") nativeInputs =
            bootstrapLlvmScalarType(function.resultType) != ""
        if (candidate.opcode == "local.declare" ||
            candidate.opcode == "local.assign" ||
            candidate.opcode == "local.set") {
            val local = localIndex.find(candidate.text)
            nativeInputs = local >= 0 && local < localTypes.size &&
                localTypes[local] != ""
        }
        if (candidate.opcode == "call") {
            val called = functionIndex.find(candidate.text)
            var operand = 0
            while (operand < candidate.operands.size) {
                val used = candidate.operands[operand]
                var native = false
                if (called >= 0 && called < program.functions.size &&
                    operand < program.functions[called].parameterTypes.size) {
                    native = bootstrapLlvmScalarType(
                        program.functions[called].parameterTypes[operand]
                    ) != ""
                }
                if (!native && used >= 0 && used < boxedValues.size) {
                    boxedValues[used] = true
                }
                operand = operand + 1
            }
            nativeInputs = true
        }
        if (candidate.opcode == "extern.c" ||
            (candidate.opcode == "extern.intrinsic" &&
             bootstrapLlvmNativeIntrinsic(candidate.text))) {
            val native = nativeIndex.find(candidate.text)
            var operand = 0
            while (operand < candidate.operands.size) {
                val used = candidate.operands[operand]
                var direct = false
                if (native >= 0 && native < program.natives.size &&
                    operand < program.natives[native].parameterTypes.size) {
                    direct = bootstrapLlvmScalarType(
                        program.natives[native].parameterTypes[operand]
                    ) != ""
                }
                if (candidate.opcode == "extern.intrinsic" &&
                    bootstrapLlvmValueLayoutIntrinsic(candidate.text) &&
                    used >= 0 && used < valueTypes.size &&
                    valueTypes[used] != "") direct = true
                if (!direct && used >= 0 && used < boxedValues.size) {
                    boxedValues[used] = true
                }
                operand = operand + 1
            }
            nativeInputs = true
        }
        if (candidate.opcode == "inline.assembly") {
            var operand = 0
            while (operand < candidate.operands.size) {
                val used = candidate.operands[operand]
                if (used >= 0 && used < boxedValues.size &&
                    (used >= valueTypes.size || valueTypes[used] == "")) {
                    boxedValues[used] = true
                }
                operand = operand + 1
            }
            nativeInputs = true
        }
        if (!nativeInputs) {
            if (candidate.operands.size > 0) {
                var operand = 0
                while (operand < candidate.operands.size) {
                    val used = candidate.operands[operand]
                    if (used >= 0 && used < boxedValues.size) {
                        boxedValues[used] = true
                    }
                    operand = operand + 1
                }
            } else {
                if (candidate.left >= 0 &&
                    candidate.left < boxedValues.size) {
                    boxedValues[candidate.left] = true
                }
                if (candidate.right >= 0 &&
                    candidate.right < boxedValues.size) {
                    boxedValues[candidate.right] = true
                }
            }
        }
        instruction = instruction + 1
    }
    BootstrapLlvmScalarPlan(valueTypes, localTypes, boxedValues)
}

fun bootstrapLlvmLocalIndex(
    function: BootstrapIrFunction
): BootstrapLlvmNameIndex {
    val names: array<string> = []
    val values: array<int> = []
    var index = 0
    while (index < function.instructions.size) {
        val instruction = function.instructions[index]
        if (instruction.opcode == "local.declare" ||
            bootstrapIrIsLocalZero(instruction.opcode) ||
            instruction.opcode == "local.allocate") {
            names.append(instruction.text)
            values.append(index)
        }
        index = index + 1
    }
    bootstrapLlvmNameValueIndex(names, values)
}

fun bootstrapLlvmGlobalIndex(
    program: BootstrapIrProgram
): BootstrapLlvmNameIndex {
    val names: array<string> = []
    val values: array<int> = []
    var index = 0
    while (index < program.instructions.size) {
        val instruction = program.instructions[index]
        if (instruction.opcode == "global.store") {
            names.append(instruction.text)
            values.append(index)
        }
        index = index + 1
    }
    bootstrapLlvmNameValueIndex(names, values)
}

fun bootstrapLlvmGlobalScalarType(
    program: BootstrapIrProgram,
    name: string
): string {
    var result = ""
    var index = 0
    while (index < program.globalNames.size &&
        index < program.globalTypes.size) {
        if (program.globalNames[index] == name) {
            result = bootstrapLlvmScalarType(program.globalTypes[index])
        }
        index = index + 1
    }
    result
}

fun bootstrapLlvmGlobalKind(
    program: BootstrapIrProgram,
    name: string
): string {
    var result = ""
    var index = 0
    while (index < program.globalNames.size &&
        index < program.globalKinds.size) {
        if (program.globalNames[index] == name) {
            result = program.globalKinds[index]
        }
        index = index + 1
    }
    result
}

fun bootstrapLlvmGlobalStoreInstruction(
    program: BootstrapIrProgram,
    name: string
): int {
    var result = -1
    var index = 0
    while (index < program.instructions.size) {
        val instruction = program.instructions[index]
        if (instruction.opcode == "global.store" &&
            instruction.text == name) result = index
        index = index + 1
    }
    result
}

fun bootstrapLlvmInstructionProducing(
    program: BootstrapIrProgram,
    value: int
): int {
    var result = -1
    var index = 0
    while (index < program.instructions.size) {
        if (program.instructions[index].result == value) result = index
        index = index + 1
    }
    result
}

fun bootstrapLlvmScalarInstructionConstant(
    backend: BootstrapLlvmBackend,
    program: BootstrapIrProgram,
    valueId: int,
    scalar: string,
    depth: int,
    initializing: bool
): i64* {
    var result = nativeNullPointer()
    if (depth > program.globalNames.size + 1) return result
    val valueIndex = bootstrapLlvmInstructionProducing(program, valueId)
    if (valueIndex < 0) return result
    val value = program.instructions[valueIndex]
    if (bootstrapIsIntegerScalarType(scalar) &&
        value.opcode == "const.i64") result =
        LLVMConstInt(
            backend.type(scalar),
            bootstrapLlvmParseInteger(value.text), 1
        )
    if (value.opcode == "scalar.cast" && value.text == scalar) {
        val operandIndex = bootstrapLlvmInstructionProducing(
            program, value.left
        )
        if (operandIndex >= 0) {
            val operand = program.instructions[operandIndex]
            if (bootstrapIsIntegerScalarType(scalar) &&
                operand.opcode == "const.i64") {
                result = LLVMConstInt(
                    backend.type(scalar),
                    bootstrapLlvmParseInteger(operand.text), 1
                )
            }
        }
    }
    if (scalar == "bool" && value.opcode == "const.bool") result =
        LLVMConstInt(
            backend.i1Type,
            if (value.text == "true") 1 else 0, 0
        )
    if (scalar == "f64" && value.opcode == "const.f64") result =
        LLVMConstRealOfStringAndSize(
            backend.f64Type, value.text, value.text.size
        )
    if (value.opcode == "global.load" &&
        bootstrapLlvmGlobalScalarType(program, value.text) == scalar) {
        result = if (initializing) {
            bootstrapLlvmScalarGlobalInitializerAtDepth(
                backend, program, value.text, depth + 1
            )
        } else bootstrapLlvmScalarGlobalConstantAtDepth(
            backend, program, value.text, depth + 1
        )
    }
    if ((bootstrapIsIntegerScalarType(scalar) || scalar == "bool") &&
        (value.opcode == "neg" || value.opcode == "bit.not" ||
         value.opcode == "not")) {
        val operand = bootstrapLlvmScalarInstructionConstant(
            backend, program, value.left, scalar, depth + 1, initializing
        )
        if (!pointerIsNull(operand)) result =
            if (value.opcode == "neg") LLVMConstNeg(operand)
            else LLVMConstNot(operand)
    }
    if (bootstrapIsIntegerScalarType(scalar) &&
        (value.opcode == "+" || value.opcode == "-" ||
         value.opcode == "^")) {
        val left = bootstrapLlvmScalarInstructionConstant(
            backend, program, value.left, scalar, depth + 1, initializing
        )
        val right = bootstrapLlvmScalarInstructionConstant(
            backend, program, value.right, scalar, depth + 1, initializing
        )
        if (!pointerIsNull(left) && !pointerIsNull(right)) {
            if (value.opcode == "+") result = LLVMConstAdd(left, right)
            if (value.opcode == "-") result = LLVMConstSub(left, right)
            if (value.opcode == "^") result = LLVMConstXor(left, right)
        }
    }
    result
}

fun bootstrapLlvmScalarGlobalConstantAtDepth(
    backend: BootstrapLlvmBackend,
    program: BootstrapIrProgram,
    name: string,
    depth: int
): i64* {
    var result = nativeNullPointer()
    val scalar = bootstrapLlvmGlobalScalarType(program, name)
    val storeIndex = bootstrapLlvmGlobalStoreInstruction(program, name)
    if (scalar != "" && bootstrapLlvmGlobalKind(program, name) == "val" &&
        storeIndex >= 0) {
        result = bootstrapLlvmScalarInstructionConstant(
            backend, program, program.instructions[storeIndex].left,
            scalar, depth, false
        )
    }
    result
}

// A scalar module val whose complete initializer graph is proven constant is
// immutable for the entire program. Emit it as an LLVM constant initializer
// instead of a zero-filled cell plus a lazy first-call store.
fun bootstrapLlvmScalarGlobalConstant(
    backend: BootstrapLlvmBackend,
    program: BootstrapIrProgram,
    name: string
): i64* = bootstrapLlvmScalarGlobalConstantAtDepth(
    backend, program, name, 0
)

fun bootstrapLlvmScalarGlobalInitializerAtDepth(
    backend: BootstrapLlvmBackend,
    program: BootstrapIrProgram,
    name: string,
    depth: int
): i64* {
    var result = nativeNullPointer()
    val scalar = bootstrapLlvmGlobalScalarType(program, name)
    val storeIndex = bootstrapLlvmGlobalStoreInstruction(program, name)
    if (scalar != "" && storeIndex >= 0) {
        result = bootstrapLlvmScalarInstructionConstant(
            backend, program, program.instructions[storeIndex].left,
            scalar, depth, true
        )
    }
    result
}

// A scalar module var is still mutable after startup, but a proven constant
// initializer belongs in its ELF/Wasm data initializer rather than a lazy
// first-export store. This removes the export initialization guard only when
// every module global can be initialized without executing Abla code.
fun bootstrapLlvmScalarGlobalInitializer(
    backend: BootstrapLlvmBackend,
    program: BootstrapIrProgram,
    name: string
): i64* = bootstrapLlvmScalarGlobalInitializerAtDepth(
    backend, program, name, 0
)

fun bootstrapLlvmHasRuntimeGlobals(
    backend: BootstrapLlvmBackend,
    program: BootstrapIrProgram
): bool {
    var found = false
    var index = 0
    while (!found && index < program.globalNames.size) {
        found = pointerIsNull(
            if (backend.constantScalarVarInitializers) {
                bootstrapLlvmScalarGlobalInitializer(
                    backend, program, program.globalNames[index]
                )
            } else bootstrapLlvmScalarGlobalConstant(
                backend, program, program.globalNames[index]
            )
        )
        index = index + 1
    }
    found
}

fun bootstrapLlvmClassIndex(
    program: BootstrapIrProgram
): BootstrapLlvmNameIndex {
    val names: array<string> = []
    val values: array<int> = []
    var index = 0
    while (index < program.classes.size) {
        names.append(program.classes[index].name)
        values.append(program.classes[index].id)
        index = index + 1
    }
    bootstrapLlvmNameValueIndex(names, values)
}

fun bootstrapLlvmFieldIndex(
    program: BootstrapIrProgram
): BootstrapLlvmNameIndex {
    val names: array<string> = []
    val values: array<int> = []
    var next = 0
    var classIndex = 0
    while (classIndex < program.classes.size) {
        var fieldIndex = 0
        while (fieldIndex < program.classes[classIndex].fields.size) {
            names.append(program.classes[classIndex].fields[fieldIndex])
            values.append(next)
            next = next + 1
            fieldIndex = fieldIndex + 1
        }
        classIndex = classIndex + 1
    }
    bootstrapLlvmNameValueIndex(names, values)
}

fun bootstrapLlvmHexDigit(value: int): string =
    "0123456789ABCDEF".slice(value, value + 1)

fun bootstrapLlvmBytes(value: string): string {
    var output = ""
    var index = 0
    while (index < value.size) {
        val byte = value[index]
        output =
            "$output\\${bootstrapLlvmHexDigit(byte / 16)}${bootstrapLlvmHexDigit(byte - byte / 16 * 16)}"
        index = index + 1
    }
    "$output\\00"
}

fun bootstrapLlvmRuntimeBinary(opcode: string): string {
    var result = ""
    if (opcode == "+") result = "abla_add"
    if (opcode == "-") result = "abla_subtract"
    if (opcode == "*") result = "abla_multiply"
    if (opcode == "/") result = "abla_divide"
    if (opcode == "==") result = "abla_equal"
    if (opcode == "!=") result = "abla_not_equal"
    if (opcode == "<") result = "abla_less"
    if (opcode == "<=") result = "abla_less_equal"
    if (opcode == ">") result = "abla_greater"
    if (opcode == ">=") result = "abla_greater_equal"
    if (opcode == "&") result = "ablaBitAnd"
    if (opcode == "|") result = "ablaBitOr"
    if (opcode == "^") result = "ablaBitXor"
    if (opcode == "<<") result = "ablaBitShiftLeft"
    if (opcode == ">>") result = "ablaBitShiftRight"
    if (opcode == ">>>") result = "ablaBitShiftRightUnsigned"
    result
}

fun bootstrapLlvmReplaceAll(
    source: string,
    expected: string,
    replacement: string
): string {
    var output = ""
    var segment = 0
    var index = 0
    while (index + expected.size <= source.size) {
        if (source.slice(index, index + expected.size) == expected) {
            output = "$output${source.slice(segment, index)}$replacement"
            index = index + expected.size
            segment = index
        } else index = index + 1
    }
    "$output${source.slice(segment, source.size)}"
}

fun bootstrapLlvmIsBinary(opcode: string): bool =
    opcode == "+" || opcode == "-" || opcode == "*" || opcode == "/" ||
    opcode == "==" || opcode == "!=" || opcode == "<" ||
    opcode == "<=" || opcode == ">" || opcode == ">=" ||
    opcode == "&" || opcode == "|" || opcode == "^" ||
    opcode == "<<" || opcode == ">>" || opcode == ">>>"

fun bootstrapLlvmFunctionFingerprint(
    function: BootstrapIrFunction,
    seed: int,
    factor: int,
    modulus: int
): int {
    var hash = bootstrapIrHashText(seed, function.name, factor, modulus)
    var parameter = 0
    while (parameter < function.parameters.size) {
        hash = bootstrapIrHashText(
            hash,
            function.parameters[parameter],
            factor,
            modulus
        )
        if (parameter < function.parameterTypes.size) {
            hash = bootstrapIrHashText(
                hash,
                function.parameterTypes[parameter],
                factor,
                modulus
            )
        }
        parameter = parameter + 1
    }
    hash = bootstrapIrHashText(
        hash, function.resultType, factor, modulus
    )
    hash = bootstrapIrHashText(
        hash, if (function.inlineHint) "inline" else "call", factor, modulus
    )
    if (function.noinlineHint) hash = bootstrapIrHashText(
        hash, "noinline", factor, modulus
    )
    hash = bootstrapIrHashText(
        hash, if (function.naked) "naked" else "framed", factor, modulus
    )
    hash = bootstrapIrHashText(hash, function.section, factor, modulus)
    var local = 0
    while (local < function.localTypes.size) {
        hash = bootstrapIrHashText(
            hash, function.localTypes[local], factor, modulus
        )
        local = local + 1
    }
    hash = hash * factor + function.result + 2
    hash = hash - (hash / modulus) * modulus
    var instruction = 0
    while (instruction < function.instructions.size) {
        val found = function.instructions[instruction]
        hash = bootstrapIrHashText(hash, found.opcode, factor, modulus)
        hash = bootstrapIrHashText(hash, found.text, factor, modulus)
        hash = hash * factor + found.result + 2
        hash = hash - (hash / modulus) * modulus
        hash = hash * factor + found.left + 2
        hash = hash - (hash / modulus) * modulus
        hash = hash * factor + found.right + 2
        hash = hash - (hash / modulus) * modulus
        hash = hash * factor + found.target + 2
        hash = hash - (hash / modulus) * modulus
        hash = hash * factor + found.alternate + 2
        hash = hash - (hash / modulus) * modulus
        var operand = 0
        while (operand < found.operands.size) {
            hash = hash * factor + found.operands[operand] + 2
            hash = hash - (hash / modulus) * modulus
            operand = operand + 1
        }
        instruction = instruction + 1
    }
    if (hash < 0) 0 - hash else hash
}

// Linkage identities describe declarations, not implementations. A body edit
// must leave callers' relocation targets intact so their native objects remain
// reusable. The extracted LLVM partition is hashed separately by the
// toolchain, which invalidates the object that actually contains the edit.
fun bootstrapLlvmFunctionLinkFingerprint(
    function: BootstrapIrFunction,
    seed: int,
    factor: int,
    modulus: int
): int {
    var hash = bootstrapIrHashText(seed, function.name, factor, modulus)
    var parameter = 0
    while (parameter < function.parameters.size) {
        hash = bootstrapIrHashText(
            hash,
            function.parameters[parameter],
            factor,
            modulus
        )
        if (parameter < function.parameterTypes.size) {
            hash = bootstrapIrHashText(
                hash,
                function.parameterTypes[parameter],
                factor,
                modulus
            )
        }
        parameter = parameter + 1
    }
    hash = bootstrapIrHashText(
        hash, function.resultType, factor, modulus
    )
    if (hash < 0) 0 - hash else hash
}

