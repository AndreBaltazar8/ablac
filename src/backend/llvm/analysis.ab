    name == "ablaUnsafeCallI32PointerI64I32" ||
    name == "ablaUnsafeCallI32PointerI64I32I32I64Pointer" ||
    name == "ablaUnsafeCallI32PointerI32PointerPointerPointer" ||
    name == "ablaUnsafeCallI32PointerI32PointerI32I64" ||
    name == "ablaUnsafeCallI32PointerI64I32PointerPointerPointer" ||
    name == "ablaUnsafeCallI32PointerI64I64I32PointerPointerPointer" ||
    name == "ablaUnsafeCallI32PointerI64I32Pointer" ||
