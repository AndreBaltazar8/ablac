import "dispatch.ab"

fun bootstrapLlvmDeclareProgramBoundaries(
    backend: BootstrapLlvmBackend,
    program: BootstrapIrProgram,
    exports: array<BootstrapExportRequest>
): void {
    val exportNames: array<string> = []
    var export = 0
    while (export < exports.size) {
        exportNames.append(exports[export].name)
        export = export + 1
    }
    val exportIndex = bootstrapLlvmNameIndex(exportNames)
    var function = 0
    while (function < program.functions.size) {
        var instruction = 0
        while (instruction < program.functions[function].instructions.size) {
            val candidate =
                program.functions[function].instructions[instruction]
            if (candidate.opcode == "extern.host" ||
                (candidate.opcode == "extern.intrinsic" &&
                 !bootstrapLlvmCoreIntrinsic(candidate.text))) {
                val requestIndex = exportIndex.find(candidate.text)
                if (requestIndex >= 0) {
                    val request = exports[requestIndex]
                    val parameters = bootstrapLlvmExportParameterTypes(
                        backend, request, request.checked
                    )
                    bootstrapLlvmDeclare(
                        backend,
                        request.name,
                        if (request.checked) backend.i32Type else
                            bootstrapLlvmExportResultType(
                                backend, request.resultType
                            ),
                        parameters,
                        false,
                        bootstrapLlvmFalseFlags(parameters.size)
                    )
                } else bootstrapLlvmDeclareValueRuntime(
                    backend, candidate.text, candidate.operands.size
                )
            }
            instruction = instruction + 1
        }
        function = function + 1
    }
    if (false) LLVMDisposeMessage(nativeNullPointer())
}

fun bootstrapLlvmEmitGlobals(
    backend: BootstrapLlvmBackend,
    program: BootstrapIrProgram
): void {
    var instruction = 0
    while (instruction < program.instructions.size) {
        val candidate = program.instructions[instruction]
        if (candidate.opcode == "global.store") {
            val name = bootstrapLlvmGlobalSymbol(candidate.text)
            if (pointerIsNull(LLVMGetNamedGlobal(backend.module, name))) {
                val scalar = bootstrapLlvmGlobalScalarType(
                    program, candidate.text
                )
                val type = if (scalar == "") backend.valueType
                    else backend.type(scalar)
                val global = LLVMAddGlobal(
                    backend.module, type, name
                )
                val initializer =
                    if (backend.constantScalarVarInitializers) {
                        bootstrapLlvmScalarGlobalInitializer(
                            backend, program, candidate.text
                        )
                    } else bootstrapLlvmScalarGlobalConstant(
                        backend, program, candidate.text
                    )
                LLVMSetInitializer(
                    global,
                    if (pointerIsNull(initializer)) LLVMConstNull(type)
                    else initializer
                )
                if (!pointerIsNull(initializer) &&
                    bootstrapLlvmGlobalKind(
                        program, candidate.text
                    ) == "val") {
                    LLVMSetGlobalConstant(global, 1)
                }
                LLVMSetAlignment(
                    global, bootstrapLlvmScalarAlignment(scalar)
                )
                LLVMSetLinkage(global, llvmInternalLinkage())
            }
        }
        instruction = instruction + 1
    }
    if (false) LLVMDisposeMessage(nativeNullPointer())
}

fun bootstrapLlvmExportResultType(
    backend: BootstrapLlvmBackend,
    type: string
): i64* {
    var result = backend.voidType
    if (bootstrapExportScalarTypeValid(type) && type != "bool") {
        result = backend.type(type)
    }
    if (type == "bool") result = backend.i8Type
    if (type == "string") result = backend.pointerType
    result
}

fun bootstrapLlvmExportParameterTypes(
    backend: BootstrapLlvmBackend,
    request: BootstrapExportRequest,
    checked: bool
): array<i64*> {
    val result: array<i64*> = []
    var parameter = 0
    while (parameter < request.parameterTypes.size) {
        val type = request.parameterTypes[parameter]
        if (type == "string") {
            result.append(backend.pointerType)
            result.append(backend.i64Type)
        } else if (type == "function:(i64)->i64") {
            result.append(backend.pointerType)
            result.append(backend.pointerType)
        } else if (type == "bool") result.append(backend.i8Type)
        else result.append(backend.type(type))
        parameter = parameter + 1
    }
    if (checked) {
        if (request.resultType != "void") {
            result.append(backend.pointerType)
        }
        result.append(backend.pointerType)
        result.append(backend.i64Type)
        result.append(backend.pointerType)
    }
    result
}

fun bootstrapLlvmFalseFlags(count: int): array<bool> {
    val result: array<bool> = []
    var index = 0
    while (index < count) {
        result.append(false)
        index = index + 1
    }
    result
}

fun bootstrapLlvmExportUsesDirectScalarAbi(
    request: BootstrapExportRequest
): bool {
    var direct = !request.checked &&
        (request.resultType == "void" ||
         bootstrapExportScalarTypeValid(request.resultType))
    var parameter = 0
    while (direct && parameter < request.parameterTypes.size) {
        direct = bootstrapExportScalarTypeValid(
            request.parameterTypes[parameter]
        )
        parameter = parameter + 1
    }
    direct
}

// When the native ABI and direct Abla ABI are identical, the linker name can
// be an alias of the implementation. This avoids a call-only entry thunk while
// retaining exactly the linkage requested by exportFunction/internalFunction.
// Defaults and bool use different native representations and still need their
// adapters; runtime-initialized paths still need the initialization guard.
fun bootstrapLlvmExportCanAliasDirect(
    request: BootstrapExportRequest,
    function: BootstrapIrFunction,
    initializationRequired: bool
): bool {
    // A naked function's direct LLVM signature still uses the same scalar
    // target ABI as its foreign entry name.  Alias that one definition rather
    // than copying its inline assembly into an export thunk: recovered
    // assembly commonly owns local labels and data which may only be defined
    // once in a monolithic module.
    var exact = !initializationRequired &&
        bootstrapLlvmExportUsesDirectScalarAbi(request) &&
        !bootstrapLlvmDirectNeedsArgumentCount(function) &&
        request.name != "xt_unhandled_interrupt" &&
        request.resultType != "bool"
    var parameter = 0
    while (exact && parameter < request.parameterTypes.size) {
        exact = request.parameterTypes[parameter] != "bool"
        parameter = parameter + 1
    }
    exact
}

fun bootstrapLlvmEmitDirectScalarExport(
    backend: BootstrapLlvmBackend,
    request: BootstrapExportRequest,
    function: i64*,
    direct: i64*,
    sourceFunction: BootstrapIrFunction
): void {
    val arguments: array<i64*> = []
    if (bootstrapLlvmDirectNeedsArgumentCount(sourceFunction)) {
        arguments.append(LLVMConstInt(
            backend.i64Type, request.parameterTypes.size, 0
        ))
    }
    var parameter = 0
    while (parameter < request.parameterTypes.size) {
        val type = request.parameterTypes[parameter]
        var value = LLVMGetParam(function, parameter)
        if (type == "bool") value = LLVMBuildTrunc(
            backend.builder, value, backend.i1Type, "export.bool"
        )
        arguments.append(value)
        parameter = parameter + 1
    }
    val returnsVoid = request.resultType == "void"
    var result = bootstrapLlvmCall(
        backend, direct, arguments,
        if (returnsVoid) "" else "export.direct.scalar",
        false, bootstrapLlvmFalseFlags(arguments.size)
    )
    if (returnsVoid) LLVMBuildRetVoid(backend.builder)
    else {
        if (request.resultType == "bool") result = LLVMBuildZExt(
            backend.builder, result, backend.i8Type, "export.u8"
        )
        LLVMBuildRet(backend.builder, result)
    }
    return
}

fun bootstrapLlvmNativeFunctionAddressRoots(
    program: BootstrapIrProgram,
    functionIndex: BootstrapLlvmNameIndex
): array<bool> {
    val roots: array<bool> = []
    var index = 0
    while (index < program.functions.size) {
        roots.append(false)
        index = index + 1
    }
    index = 0
    while (index < program.functions.size) {
        var instruction = 0
        while (instruction < program.functions[index].instructions.size) {
            val candidate = program.functions[index].instructions[instruction]
            if (candidate.opcode == "native.function.address") {
                val target = functionIndex.find(candidate.text)
                if (target >= 0) roots[target] = true
            }
            instruction = instruction + 1
        }
        index = index + 1
    }
    roots
}

fun bootstrapLlvmNativeFunctionRequest(
    function: BootstrapIrFunction
): BootstrapExportRequest = BootstrapExportRequest(
    function.name, "", function.resultType,
    function.parameters, function.parameterTypes, false, false
)

fun bootstrapLlvmAssemblySymbolByte(byte: int): bool =
    (byte >= 65 && byte <= 90) ||
    (byte >= 97 && byte <= 122) ||
    (byte >= 48 && byte <= 57) ||
    byte == 95 || byte == 46 || byte == 36

fun bootstrapLlvmAssemblyTokenEquals(
    assembly: string,
    begin: int,
    end: int,
    expected: string
): bool {
    if (end - begin != expected.size) return false
    var index = 0
    while (index < expected.size) {
        if (assembly[begin + index] != expected[index]) return false
        index = index + 1
    }
    true
}

fun bootstrapLlvmAssemblyLinkerName(token: string): string {
    // LLVM inline assembly spells a literal `$` as `$$`, while the object
    // symbol itself contains one dollar. Collapse that quoting before looking
    // up the exact linker identifier. No other assembler syntax is accepted
    // by internalFunction, so tokenization remains target-neutral.
    var escapedDollar = false
    var probe = 0
    while (!escapedDollar && probe + 1 < token.size) {
        escapedDollar = token[probe] == 36 && token[probe + 1] == 36
        probe = probe + 1
    }
    // Assembly overwhelmingly consists of ordinary tokens. Preserve their
    // existing string view instead of rebuilding every byte into a fresh
    // allocation during both definition indexing and graph traversal.
    if (!escapedDollar) return token
    var result = ""
    var index = 0
    while (index < token.size) {
        result = "$result${token.slice(index, index + 1)}"
        if (token[index] == 36 && index + 1 < token.size &&
            token[index + 1] == 36) index = index + 1
        index = index + 1
    }
    result
}

fun bootstrapLlvmAssemblyTokenHash(
    assembly: string,
    begin: int,
    end: int
): int {
    var hash = 0
    var index = begin
    while (index < end) {
        hash = hash * 131 + assembly[index]
        hash = hash - hash / 2147483647 * 2147483647
        if (assembly[index] == 36 && index + 1 < end &&
            assembly[index + 1] == 36) index = index + 1
        index = index + 1
    }
    hash
}

fun bootstrapLlvmAssemblyTokenMatchesName(
    assembly: string,
    begin: int,
    end: int,
    name: string
): bool {
    var source = begin
    var target = 0
    while (source < end && target < name.size) {
        if (assembly[source] != name[target]) return false
        if (assembly[source] == 36 && source + 1 < end &&
            assembly[source + 1] == 36) source = source + 1
        source = source + 1
        target = target + 1
    }
    source == end && target == name.size
}

// Look up a token directly in the assembly buffer. Recovered firmware has
// millions of mnemonic/register tokens; allocating a temporary string for
// each one made reachability's peak memory proportional to all scanned text.
fun BootstrapLlvmNameIndex.findAssemblyToken(
    assembly: string,
    begin: int,
    end: int
): int {
    var result = -1
    var slot = bootstrapLlvmAssemblyTokenHash(assembly, begin, end)
    slot = slot - slot / this.slots.size * this.slots.size
    var probes = 0
    var searching = true
    while (searching && probes < this.slots.size) {
        val existing = this.slots[slot]
        if (existing < 0) {
            searching = false
        } else if (bootstrapLlvmAssemblyTokenMatchesName(
            assembly, begin, end, this.names[existing]
        )) {
            result = this.values[existing]
            searching = false
        } else {
            slot = slot + 1
            if (slot == this.slots.size) slot = 0
            probes = probes + 1
        }
    }
    result
}

class BootstrapLlvmExportReachability(
    val exports: array<BootstrapExportRequest>,
    val functions: array<bool>,
    // A reachable assembly block can refer to a label defined inside another
    // Abla function's assembly block without going through an exported linker
    // name. Keep that owning function internal, but alive, so its section-local
    // code or data is emitted into the same module.
    val assemblyOwners: array<bool>,
    val assemblyRegionInstructions: array<int>,
    val assemblyRegionOrdinals: array<int>,
    val assemblyRegionReachable: array<bool>,
    val assemblyRegionStarts: array<int>,
    val assemblyRegionEnds: array<int>
)

class BootstrapLlvmAssemblyRegion(
    val assembly: string,
    val ordinal: int,
    val owner: int,
    val instruction: int,
    val begin: int,
    var end: int
)

fun bootstrapLlvmTraverseAssemblyRegion(
    assembly: string,
    selectedRegion: int,
    scanBegin: int,
    scanEnd: int,
    exportIndex: BootstrapLlvmNameIndex,
    exports: array<BootstrapExportRequest>,
    functionIndex: BootstrapLlvmNameIndex,
    assemblyDefinitionIndex: BootstrapLlvmNameIndex,
    assemblyRegions: array<BootstrapLlvmAssemblyRegion>,
    var reachableExports: array<bool>,
    var reachableFunctions: array<bool>,
    var reachableAssemblyOwners: array<bool>,
    var reachableAssemblyRegions: array<bool>,
    var pendingFunctions: array<int>,
    var pendingRegions: array<int>
): void {
    val regionStack: array<int> = []
    var regionDepth = 0
    // A selected collectable region starts at its own pushsection. Start its
    // ordinal counter there instead of rescanning the complete (potentially
    // multi-megabyte) recovered source for every live function/data record.
    // Besides being linear rather than quadratic, this avoids retaining an
    // arena allocation for every token in every repeated whole-string scan.
    var nextRegion = if (selectedRegion >= 0) selectedRegion else 0
    var begin = scanBegin
    var offset = scanBegin
    while (offset <= scanEnd) {
        val symbolByte = offset < scanEnd &&
            bootstrapLlvmAssemblySymbolByte(assembly[offset])
        if (!symbolByte) {
            if (offset > begin) {
                if (bootstrapLlvmAssemblyTokenEquals(
                    assembly, begin, offset, ".pushsection"
                )) {
                    if (regionDepth < regionStack.size) {
                        regionStack[regionDepth] = nextRegion
                    } else regionStack.append(nextRegion)
                    regionDepth = regionDepth + 1
                    nextRegion = nextRegion + 1
                } else if (bootstrapLlvmAssemblyTokenEquals(
                    assembly, begin, offset, ".popsection"
                )) {
                    if (regionDepth > 0) regionDepth = regionDepth - 1
                } else {
                    val activeRegion = if (regionDepth == 0) -1
                        else regionStack[regionDepth - 1]
                    if (activeRegion == selectedRegion) {
                        val request = exportIndex.findAssemblyToken(
                            assembly, begin, offset
                        )
                        if (request >= 0 && !reachableExports[request]) {
                            reachableExports[request] = true
                            val source = functionIndex.find(
                                exports[request].source
                            )
                            if (source >= 0 &&
                                !reachableFunctions[source]) {
                                reachableFunctions[source] = true
                                pendingFunctions.append(source)
                            }
                        }
                        val definition =
                            assemblyDefinitionIndex.findAssemblyToken(
                                assembly, begin, offset
                            )
                        if (definition >= 0) {
                            // Root-region definitions are encoded as their
                            // function owner. Pushsection definitions use a
                            // negative region id so only that independently
                            // collectable section contributes dependencies.
                            if (!reachableFunctions[definition]) {
                                reachableFunctions[definition] = true
                                pendingFunctions.append(definition)
                            }
                            reachableAssemblyOwners[definition] = true
                        } else if (definition < -1) {
                            val regionIndex = -definition - 2
                            if (!reachableAssemblyRegions[regionIndex]) {
                                reachableAssemblyRegions[regionIndex] = true
                                pendingRegions.append(regionIndex)
                                val owner =
                                    assemblyRegions[regionIndex].owner
                                reachableAssemblyOwners[owner] = true
                                if (!reachableFunctions[owner]) {
                                    reachableFunctions[owner] = true
                                    pendingFunctions.append(owner)
                                }
                            }
                        }
                    }
                }
            }
            begin = offset + 1
        }
        offset = offset + 1
    }
}

// Inline assembly references are opaque to LLVM's ordinary call graph. Build
// the missing edges from exact linker-symbol tokens so internalFunction keeps
// only symbols reachable from a real program/public root. This is what makes
// internal linkage useful in one large firmware module: unused reconstructed
// functions can be removed by globaldce instead of all being pinned in
// llvm.compiler.used.
fun bootstrapLlvmReachableExports(
    program: BootstrapIrProgram,
    exports: array<BootstrapExportRequest>,
    functionIndex: BootstrapLlvmNameIndex,
    addressTaken: array<bool>,
    interruptRoots: array<bool>,
    nativeRoots: array<bool>
): BootstrapLlvmExportReachability {
    val exportNames: array<string> = []
    val reachableExports: array<bool> = []
    var index = 0
    while (index < exports.size) {
        exportNames.append(exports[index].name)
        reachableExports.append(!exports[index].internal)
        index = index + 1
    }
    val exportIndex = bootstrapLlvmNameIndex(exportNames)
    val assemblyDefinitionNames: array<string> = []
    val assemblyDefinitionOwners: array<int> = []
    val assemblyRegions: array<BootstrapLlvmAssemblyRegion> = []
    val assemblyRegionStarts: array<int> = []
    val assemblyRegionEnds: array<int> = []
    while (assemblyRegionStarts.size < program.functions.size) {
        assemblyRegionStarts.append(-1)
        assemblyRegionEnds.append(-1)
    }
    index = 0
    while (index < program.functions.size) {
        var instructionIndex = 0
        while (instructionIndex <
               program.functions[index].instructions.size) {
            val instruction =
                program.functions[index].instructions[instructionIndex]
            if (instruction.opcode == "inline.assembly" &&
                instruction.texts.size > 1) {
                val assembly = instruction.texts[1]
                val regionStack: array<int> = []
                var regionDepth = 0
                var nextRegion = 0
                var sectionNameExpected = false
                var aliasNameExpected = false
                var begin = 0
                var offset = 0
                while (offset <= assembly.size) {
                    val symbolByte = offset < assembly.size &&
                        bootstrapLlvmAssemblySymbolByte(assembly[offset])
                    if (!symbolByte) {
                        if (offset > begin) {
                            if (bootstrapLlvmAssemblyTokenEquals(
                                assembly, begin, offset, ".pushsection"
                            )) {
                                val regionIndex = assemblyRegions.size
                                assemblyRegions.append(
                                    BootstrapLlvmAssemblyRegion(
                                        assembly, nextRegion, index,
                                        instructionIndex, begin,
                                        assembly.size
                                    )
                                )
                                if (assemblyRegionStarts[index] < 0) {
                                    assemblyRegionStarts[index] = regionIndex
                                }
                                assemblyRegionEnds[index] = regionIndex + 1
                                if (regionDepth < regionStack.size) {
                                    regionStack[regionDepth] = regionIndex
                                } else regionStack.append(regionIndex)
                                regionDepth = regionDepth + 1
                                nextRegion = nextRegion + 1
                                sectionNameExpected = true
                                aliasNameExpected = false
                            } else if (bootstrapLlvmAssemblyTokenEquals(
                                assembly, begin, offset, ".popsection"
                            )) {
                                if (regionDepth > 0) {
                                    assemblyRegions[
                                        regionStack[regionDepth - 1]
                                    ].end = offset
                                    regionDepth = regionDepth - 1
                                }
                                sectionNameExpected = false
                                aliasNameExpected = false
                            } else if (bootstrapLlvmAssemblyTokenEquals(
                                assembly, begin, offset, ".set"
                            ) || bootstrapLlvmAssemblyTokenEquals(
                                assembly, begin, offset, ".equ"
                            )) {
                                // A generic assembler alias is a real symbol
                                // definition too. Index its first operand so
                                // one collectable region can publish another
                                // region's data without copying it or forcing
                                // a separate object-file boundary.
                                aliasNameExpected = true
                            } else if (sectionNameExpected &&
                                       regionDepth > 0) {
                                // ELF permits relocations against a section
                                // symbol (for example `.bss.cache$2`) rather
                                // than a label inside it. Treat the section
                                // name as another definition owned by this
                                // collectable assembly region.
                                assemblyDefinitionNames.append(
                                    bootstrapLlvmAssemblyLinkerName(
                                        assembly.slice(begin, offset)
                                    )
                                )
                                assemblyDefinitionOwners.append(
                                    -regionStack[regionDepth - 1] - 2
                                )
                                sectionNameExpected = false
                            } else if (aliasNameExpected) {
                                assemblyDefinitionNames.append(
                                    bootstrapLlvmAssemblyLinkerName(
                                        assembly.slice(begin, offset)
                                    )
                                )
                                if (regionDepth == 0) {
                                    assemblyDefinitionOwners.append(index)
                                } else {
                                    assemblyDefinitionOwners.append(
                                        -regionStack[regionDepth - 1] - 2
                                    )
                                }
                                aliasNameExpected = false
                            } else if (offset < assembly.size &&
                                       assembly[offset] == 58) {
                                // An assembler label is the exact preceding
                                // token. References omit the trailing colon.
                                assemblyDefinitionNames.append(
                                    bootstrapLlvmAssemblyLinkerName(
                                        assembly.slice(begin, offset)
                                    )
                                )
                                if (regionDepth == 0) {
                                    assemblyDefinitionOwners.append(index)
                                } else {
                                    // -1 is the name index's not-found value,
                                    // so region zero begins at -2.
                                    assemblyDefinitionOwners.append(
                                        -regionStack[regionDepth - 1] - 2
                                    )
                                }
                            }
                        }
                        begin = offset + 1
                    }
                    offset = offset + 1
                }
            }
            instructionIndex = instructionIndex + 1
        }
        index = index + 1
    }
    val assemblyDefinitionIndex = bootstrapLlvmNameValueIndex(
        assemblyDefinitionNames, assemblyDefinitionOwners
    )
    val reachableFunctions: array<bool> = []
    val reachableAssemblyOwners: array<bool> = []
    val reachableAssemblyRegions: array<bool> = []
    val pending: array<int> = []
    val pendingRegions: array<int> = []
    while (reachableAssemblyRegions.size < assemblyRegions.size) {
        reachableAssemblyRegions.append(false)
    }
    index = 0
    while (index < program.functions.size) {
        val runtimePrefix = "__ablaRuntime"
        val functionName = program.functions[index].name
        val runtimeImplementation =
            functionName.size >= runtimePrefix.size &&
            functionName.slice(0, runtimePrefix.size) == runtimePrefix
        val root = program.functions[index].name == "main" ||
            program.functions[index].name == "__bootstrap_globals" ||
            runtimeImplementation ||
            (index < interruptRoots.size && interruptRoots[index]) ||
            (index < nativeRoots.size && nativeRoots[index])
        reachableFunctions.append(root)
        reachableAssemblyOwners.append(false)
        if (root) pending.append(index)
        index = index + 1
    }
    index = 0
    while (index < exports.size) {
        if (reachableExports[index]) {
            val source = functionIndex.find(exports[index].source)
            if (source >= 0 && !reachableFunctions[source]) {
                reachableFunctions[source] = true
                pending.append(source)
            }
        }
        index = index + 1
    }
    var cursor = 0
    var regionCursor = 0
    while (cursor < pending.size || regionCursor < pendingRegions.size) {
        if (cursor >= pending.size) {
            val regionIndex = pendingRegions[regionCursor]
            regionCursor = regionCursor + 1
            bootstrapLlvmTraverseAssemblyRegion(
                assemblyRegions[regionIndex].assembly,
                assemblyRegions[regionIndex].ordinal,
                assemblyRegions[regionIndex].begin,
                assemblyRegions[regionIndex].end,
                exportIndex, exports, functionIndex,
                assemblyDefinitionIndex, assemblyRegions,
                reachableExports, reachableFunctions,
                reachableAssemblyOwners, reachableAssemblyRegions,
                pending, pendingRegions
            )
            continue
        }
        val owner = pending[cursor]
        cursor = cursor + 1
        var instructionIndex = 0
        while (instructionIndex <
               program.functions[owner].instructions.size) {
            val instruction =
                program.functions[owner].instructions[instructionIndex]
            if (instruction.opcode == "call" ||
                instruction.opcode == "function.ref" ||
                instruction.opcode == "closure.create") {
                val target = functionIndex.find(instruction.text)
                if (target >= 0 && !reachableFunctions[target]) {
                    reachableFunctions[target] = true
                    pending.append(target)
                }
                if (instruction.opcode == "closure.create") {
                    val drop = functionIndex.find(
                        bootstrapClosureDropFunctionName(instruction.text)
                    )
                    if (drop >= 0 && !reachableFunctions[drop]) {
                        reachableFunctions[drop] = true
                        pending.append(drop)
                    }
                }
            }
            if (instruction.opcode == "call.indirect" ||
                instruction.opcode == "call.indirect.once") {
                var target = 0
                while (target < addressTaken.size) {
                    if (addressTaken[target] &&
                        !reachableFunctions[target]) {
                        reachableFunctions[target] = true
                        pending.append(target)
                    }
                    target = target + 1
                }
            }
            // Native declarations are another exact-symbol edge inside a
            // monolithic module. If internalFunction owns that name, bind the
            // declaration to the Abla definition instead of leaving an
            // unresolved foreign call or forcing public linkage merely to
            // make two parts of the same LLVM module meet.
            if (instruction.opcode == "extern.c" ||
                instruction.opcode == "extern.host" ||
                (instruction.opcode == "extern.intrinsic" &&
                 !bootstrapLlvmCoreIntrinsic(instruction.text))) {
                val request = exportIndex.find(instruction.text)
                if (request >= 0 && !reachableExports[request]) {
                    reachableExports[request] = true
                    val source = functionIndex.find(
                        exports[request].source
                    )
                    if (source >= 0 && !reachableFunctions[source]) {
                        reachableFunctions[source] = true
                        pending.append(source)
                    }
                }
            }
            if (instruction.opcode == "inline.assembly" &&
                instruction.texts.size > 1) {
                bootstrapLlvmTraverseAssemblyRegion(
                    instruction.texts[1], -1,
                    0, instruction.texts[1].size,
                    exportIndex, exports, functionIndex,
                    assemblyDefinitionIndex, assemblyRegions,
                    reachableExports, reachableFunctions,
                    reachableAssemblyOwners, reachableAssemblyRegions,
                    pending, pendingRegions
                )
            }
            instructionIndex = instructionIndex + 1
        }
    }
    val selected: array<BootstrapExportRequest> = []
    index = 0
    while (index < exports.size) {
        if (reachableExports[index]) {
            selected.append(exports[index])
            // The selected export already retains or materializes this naked
            // source. Keeping its direct function as an additional assembly
            // owner would emit the same local labels twice.
            val source = functionIndex.find(exports[index].source)
            if (source >= 0) reachableAssemblyOwners[source] = false
        }
        index = index + 1
    }
    val assemblyRegionInstructions: array<int> = []
    val assemblyRegionOrdinals: array<int> = []
    index = 0
    while (index < assemblyRegions.size) {
        assemblyRegionInstructions.append(
            assemblyRegions[index].instruction
        )
        assemblyRegionOrdinals.append(assemblyRegions[index].ordinal)
        index = index + 1
    }
    BootstrapLlvmExportReachability(
        selected, reachableFunctions, reachableAssemblyOwners,
        assemblyRegionInstructions, assemblyRegionOrdinals,
        reachableAssemblyRegions,
        assemblyRegionStarts, assemblyRegionEnds
    )
}

fun bootstrapLlvmDeclareNativeFunctionAdapters(
    backend: BootstrapLlvmBackend,
    program: BootstrapIrProgram,
    roots: array<bool>,
    identities: BootstrapLlvmFunctionIdentities
): void {
    var index = 0
    while (index < program.functions.size) {
        if (index < roots.size && roots[index]) {
            val request = bootstrapLlvmNativeFunctionRequest(
                program.functions[index]
            )
            val parameters = bootstrapLlvmExportParameterTypes(
                backend, request, false
            )
            val adapter = bootstrapLlvmDeclare(
                backend,
                bootstrapLlvmNativeFunctionAdapterSymbol(
                    identities.symbols[index]
                ),
                bootstrapLlvmExportResultType(backend, request.resultType),
                parameters, false,
                bootstrapLlvmFalseFlags(parameters.size)
            )
            LLVMSetLinkage(adapter, llvmInternalLinkage())
        }
        index = index + 1
    }
    return
}

fun bootstrapLlvmGlobalNeedsRuntimeInitialization(
    backend: BootstrapLlvmBackend,
    program: BootstrapIrProgram,
    name: string
): bool = pointerIsNull(
    if (backend.constantScalarVarInitializers) {
        bootstrapLlvmScalarGlobalInitializer(backend, program, name)
    } else bootstrapLlvmScalarGlobalConstant(backend, program, name)
)

// Export initialization is a property of the reachable function path, not of
// the whole linked Abla program. A pure firmware ABI entry should not pay a
// lazy-global guard because some unrelated application module owns state.
// Indirect calls remain conservative; direct calls and captured function
// references propagate the requirement to their callers.
fun bootstrapLlvmExportInitializationRequirements(
    backend: BootstrapLlvmBackend,
    program: BootstrapIrProgram,
    functionIndex: BootstrapLlvmNameIndex
): array<bool> {
    val required: array<bool> = []
    var function = 0
    while (function < program.functions.size) {
        var needsInitialization = false
        var instruction = 0
        while (instruction <
               program.functions[function].instructions.size) {
            val candidate =
                program.functions[function].instructions[instruction]
            if ((candidate.opcode == "global.load" ||
                 candidate.opcode == "global.assign" ||
                 candidate.opcode == "global.store") &&
                bootstrapLlvmGlobalNeedsRuntimeInitialization(
                    backend, program, candidate.text
                )) needsInitialization = true
            if (candidate.opcode == "call.indirect" ||
                candidate.opcode == "call.indirect.once") {
                needsInitialization = true
            }
            instruction = instruction + 1
        }
        required.append(needsInitialization)
        function = function + 1
    }
    var changed = true
    while (changed) {
        changed = false
        function = 0
        while (function < program.functions.size) {
            if (!required[function]) {
                var instruction = 0
                while (instruction <
                       program.functions[function].instructions.size) {
                    val candidate =
                        program.functions[function].instructions[instruction]
                    if (candidate.opcode == "call" ||
                        candidate.opcode == "function.ref" ||
                        candidate.opcode == "closure.create" ||
                        candidate.opcode == "native.function.address") {
                        val target = functionIndex.find(candidate.text)
                        if (target >= 0 && target < required.size &&
                            required[target]) {
                            required[function] = true
                            changed = true
                        }
                    }
                    instruction = instruction + 1
                }
            }
            function = function + 1
        }
    }
    required
}

fun bootstrapLlvmEmitNativeFunctionAdapters(
    backend: BootstrapLlvmBackend,
    program: BootstrapIrProgram,
    roots: array<bool>,
    identities: BootstrapLlvmFunctionIdentities,
    initializationRequired: array<bool>
): void {
    var index = 0
    while (index < program.functions.size) {
        if (index < roots.size && roots[index]) {
            val request = bootstrapLlvmNativeFunctionRequest(
                program.functions[index]
            )
            val adapter = LLVMGetNamedFunction(
                backend.module,
                bootstrapLlvmNativeFunctionAdapterSymbol(
                    identities.symbols[index]
                )
            )
            val entry = LLVMAppendBasicBlockInContext(
                backend.context, adapter, "entry"
            )
            LLVMPositionBuilderAtEnd(backend.builder, entry)
            if (index < initializationRequired.size &&
                initializationRequired[index] &&
                !pointerIsNull(LLVMGetNamedFunction(
                backend.module, "abla_export_ensure_initialized"
            ))) bootstrapLlvmCallNamed(
                backend, "abla_export_ensure_initialized", [],
                "", false, []
            )
            bootstrapLlvmEmitDirectScalarExport(
                backend, request, adapter,
                LLVMGetNamedFunction(
                    backend.module,
                    bootstrapLlvmDirectFunctionSymbol(
                        identities.symbols[index]
                    )
                ), program.functions[index]
            )
        }
        index = index + 1
    }
    return
}

class BootstrapLlvmExportArguments(
    val pointer: i64*,
    val callbacks: array<i64*>,
    val nextNative: int
)

fun bootstrapLlvmBoxExportArguments(
    backend: BootstrapLlvmBackend,
    request: BootstrapExportRequest,
    function: i64*
): BootstrapLlvmExportArguments {
    val callbacks: array<i64*> = []
    var arguments = LLVMConstNull(backend.pointerType)
    var native = 0
    var storage = nativeNullPointer()
    var storageType = nativeNullPointer()
    if (request.parameterTypes.size > 0) {
        storageType = LLVMArrayType2(
            backend.valueType, request.parameterTypes.size
        )
        storage = LLVMBuildAlloca(
            backend.builder, storageType, "export.arguments"
        )
        LLVMSetAlignment(storage, 8)
        var parameter = 0
        while (parameter < request.parameterTypes.size) {
            val slot = bootstrapLlvmArrayElement(
                backend, storageType, storage, parameter,
                "export.argument"
            )
            val type = request.parameterTypes[parameter]
            if (type == "bool") {
                val value = LLVMBuildTrunc(
                    backend.builder, LLVMGetParam(function, native),
                    backend.i1Type, "export.bool"
                )
                bootstrapLlvmCallNamed(
                    backend, "abla_bool", [slot, value],
                    "", true, [false, false]
                )
                native = native + 1
            } else if (type == "string") {
                bootstrapLlvmCallNamed(
                    backend, "abla_string_static",
                    [slot, LLVMGetParam(function, native),
                     LLVMGetParam(function, native + 1)],
                    "", true, [false, false, false]
                )
                native = native + 2
            } else if (type == "function:(i64)->i64") {
                val capturesType = LLVMArrayType2(backend.valueType, 2)
                val captures = LLVMBuildAlloca(
                    backend.builder, capturesType, "callback.captures"
                )
                val callback = bootstrapLlvmArrayElement(
                    backend, capturesType, captures, 0, "callback.function"
                )
                val context = bootstrapLlvmArrayElement(
                    backend, capturesType, captures, 1, "callback.context"
                )
                val callbackAddress = LLVMBuildPtrToInt(
                    backend.builder, LLVMGetParam(function, native),
                    backend.i64Type, "callback.address"
                )
                val contextAddress = LLVMBuildPtrToInt(
                    backend.builder, LLVMGetParam(function, native + 1),
                    backend.i64Type, "callback.context.address"
                )
                bootstrapLlvmCallNamed(
                    backend, "abla_i64", [callback, callbackAddress],
                    "", true, [false, false]
                )
                bootstrapLlvmCallNamed(
                    backend, "abla_i64", [context, contextAddress],
                    "", true, [false, false]
                )
                val capturesPointer = bootstrapLlvmArrayElement(
                    backend, capturesType, captures, 0,
                    "callback.captures.pointer"
                )
                bootstrapLlvmCallNamed(
                    backend, "abla_closure",
                    [slot, LLVMConstInt(backend.i32Type, -1, 1),
                     capturesPointer, LLVMConstInt(backend.i64Type, 2, 0)],
                    "", true, [false, false, false, false]
                )
                callbacks.append(slot)
                native = native + 2
            } else if (type == "f64") {
                bootstrapLlvmBoxScalar(
                    backend, slot, LLVMGetParam(function, native), type
                )
                native = native + 1
            } else {
                var value = LLVMGetParam(function, native)
                if (bootstrapLlvmIsNarrowNativeInteger(type)) {
                    value = if (bootstrapLlvmIsUnsignedNativeInteger(type) ||
                        type == "char") LLVMBuildZExt(
                        backend.builder, value, backend.i64Type,
                        "export.integer.zero-extend"
                    ) else LLVMBuildSExt(
                        backend.builder, value, backend.i64Type,
                        "export.integer.sign-extend"
                    )
                }
                bootstrapLlvmCallNamed(
                    backend, "abla_i64",
                    [slot, value],
                    "", true, [false, false]
                )
                native = native + 1
            }
            parameter = parameter + 1
        }
        arguments = bootstrapLlvmArrayElement(
            backend, storageType, storage, 0, "export.arguments.pointer"
        )
    }
    BootstrapLlvmExportArguments(arguments, callbacks, native)
}

fun bootstrapLlvmReleaseExportCallbacks(
    backend: BootstrapLlvmBackend,
    callbacks: array<i64*>
): void {
    var index = 0
    while (index < callbacks.size) {
        bootstrapLlvmCallNamed(
            backend, "abla_closure_release", [callbacks[index]],
            "", false, [true]
        )
        index = index + 1
    }
    if (false) LLVMDisposeMessage(nativeNullPointer())
}

fun bootstrapLlvmReturnExportValue(
    backend: BootstrapLlvmBackend,
    result: i64*,
    type: string,
    destination: i64*,
    checked: bool
): void {
    var native = nativeNullPointer()
    if (bootstrapExportScalarTypeValid(type)) {
        val payload = LLVMBuildStructGEP2(
            backend.builder, backend.valueType,
            result, 2, "export.payload"
        )
        val first = LLVMBuildStructGEP2(
            backend.builder, backend.payloadType,
            payload, 0, "export.word0"
        )
        native = LLVMBuildLoad2(
            backend.builder, backend.i64Type,
            first, "export.scalar"
        )
        LLVMSetAlignment(native, 8)
        if (type == "f64") native = LLVMBuildBitCast(
            backend.builder, native, backend.f64Type, "export.f64"
        )
        if (type == "bool") native = LLVMBuildICmp(
            backend.builder, llvmIntNotEqual(), native,
            LLVMConstInt(backend.i64Type, 0, 0), "export.bool"
        )
        if (bootstrapLlvmIsNarrowNativeInteger(type)) {
            native = LLVMBuildTrunc(
                backend.builder, native, backend.type(type),
                "export.integer.truncate"
            )
        }
    }
    if (type == "bool") {
        native = LLVMBuildZExt(
            backend.builder, native, backend.i8Type, "export.u8"
        )
    }
    if (type == "string") native = bootstrapLlvmCallNamed(
        backend, "abla_owned_bytes_from_value", [result],
        "export.bytes", false, [true]
    )
    if (type == "void" && !checked) LLVMBuildRetVoid(backend.builder)
    if (type != "void" && checked) {
        LLVMBuildStore(backend.builder, native, destination)
    }
    if (type != "void" && !checked) LLVMBuildRet(backend.builder, native)
    if (false) LLVMDisposeMessage(nativeNullPointer())
}

fun bootstrapLlvmEmitExportInitializer(
    backend: BootstrapLlvmBackend,
    program: BootstrapIrProgram,
    functionIndex: BootstrapLlvmNameIndex,
    identities: BootstrapLlvmFunctionIdentities
): void {
    val globals = functionIndex.find("__bootstrap_globals")
    if (globals >= 0 && bootstrapLlvmHasRuntimeGlobals(backend, program)) {
        val initialized = LLVMAddGlobal(
            backend.module, backend.i1Type, "abla.exports.initialized"
        )
        LLVMSetInitializer(initialized, LLVMConstInt(backend.i1Type, 0, 0))
        LLVMSetLinkage(initialized, llvmInternalLinkage())
        val initialize = bootstrapLlvmDeclare(
            backend, "abla_export_ensure_initialized", backend.voidType,
            [], false, []
        )
        LLVMSetLinkage(initialize, llvmInternalLinkage())
        val entry = LLVMAppendBasicBlockInContext(
            backend.context, initialize, "entry"
        )
        val run = LLVMAppendBasicBlockInContext(
            backend.context, initialize, "run"
        )
        val done = LLVMAppendBasicBlockInContext(
            backend.context, initialize, "done"
        )
        LLVMPositionBuilderAtEnd(backend.builder, entry)
        val state = LLVMBuildLoad2(
            backend.builder, backend.i1Type, initialized, "initialized"
        )
        LLVMBuildCondBr(backend.builder, state, done, run)
        LLVMPositionBuilderAtEnd(backend.builder, run)
        LLVMBuildStore(
            backend.builder, LLVMConstInt(backend.i1Type, 1, 0), initialized
        )
        val result = LLVMBuildAlloca(
            backend.builder, backend.valueType, "global.result"
        )
        bootstrapLlvmCall(
            backend,
            LLVMGetNamedFunction(
                backend.module, identities.symbols[globals]
            ),
            [result, LLVMConstNull(backend.pointerType),
             LLVMConstInt(backend.i64Type, 0, 0)],
            "", true, [false, false, false]
        )
        LLVMBuildBr(backend.builder, done)
        LLVMPositionBuilderAtEnd(backend.builder, done)
        LLVMBuildRetVoid(backend.builder)
    }
    if (false) LLVMDisposeMessage(nativeNullPointer())
}

fun bootstrapLlvmEmitExports(
    backend: BootstrapLlvmBackend,
    program: BootstrapIrProgram,
    exports: array<BootstrapExportRequest>,
    functionIndex: BootstrapLlvmNameIndex,
    identities: BootstrapLlvmFunctionIdentities,
    initializationRequired: array<bool>,
    assemblyOwners: array<bool>
): int {
    var errors = 0
    val retained: array<i64*> = []
    var owner = 0
    while (owner < assemblyOwners.size) {
        if (assemblyOwners[owner]) retained.append(
            LLVMGetNamedFunction(
                backend.module,
                bootstrapLlvmDirectFunctionSymbol(
                    identities.symbols[owner]
                )
            )
        )
        owner = owner + 1
    }
    if (exports.size > 0) bootstrapLlvmEmitExportInitializer(
        backend, program, functionIndex, identities
    )
    var index = 0
    while (index < exports.size) {
        val request = exports[index]
        val source = functionIndex.find(request.source)
        if (source < 0) errors = errors + 1
        if (source >= 0) {
            val nakedAssembly = bootstrapLlvmNakedAssemblyIndex(
                program.functions[source]
            )
            var nakedAlias = -1
            var previous = 0
            while (nakedAssembly >= 0 && previous < index &&
                   nakedAlias < 0) {
                if (exports[previous].source == request.source &&
                    exports[previous].checked == request.checked) {
                    nakedAlias = previous
                }
                previous = previous + 1
            }
            val directAlias = bootstrapLlvmExportCanAliasDirect(
                request,
                program.functions[source],
                source < initializationRequired.size &&
                    initializationRequired[source]
            )
            if (nakedAlias >= 0 && !request.internal) {
                val aliasName = exports[nakedAlias].name
                var aliasee = LLVMGetNamedGlobalAlias(
                    backend.module, aliasName, aliasName.size
                )
                if (pointerIsNull(aliasee)) aliasee = LLVMGetNamedFunction(
                    backend.module, exports[nakedAlias].name
                )
                if (pointerIsNull(aliasee)) errors = errors + 1
                else LLVMAddAlias2(
                        backend.module,
                        LLVMGlobalGetValueType(aliasee),
                        0,
                        aliasee,
                        request.name
                    )
            } else if (directAlias) {
                val direct = LLVMGetNamedFunction(
                    backend.module,
                    bootstrapLlvmDirectFunctionSymbol(
                        identities.symbols[source]
                    )
                )
                // Native calls may have introduced a declaration with the
                // public name before late export materialization. Preserve
                // that declaration's function type on the alias: naked
                // assembly receives its real ABI through target registers,
                // so its intentionally argument-free Abla signature need not
                // describe the foreign entry type.
                val shadow = LLVMGetNamedFunction(
                    backend.module, request.name
                )
                var alias: i64* = nativeNullPointer()
                if (!pointerIsNull(shadow) &&
                    (nakedAssembly >= 0 ||
                     bootstrapLlvmTargetUses32BitPointers(
                         backend.targetTriple
                     ) ||
                     nativePointerAddress(LLVMGlobalGetValueType(shadow)) ==
                     nativePointerAddress(LLVMGlobalGetValueType(direct)))) {
                    val shadowType = LLVMGlobalGetValueType(shadow)
                    val temporaryName =
                        "abla.export.shadow.${index}"
                    LLVMSetValueName2(
                        shadow, temporaryName, temporaryName.size
                    )
                    alias = LLVMAddAlias2(
                        backend.module,
                        shadowType,
                        0,
                        direct,
                        request.name
                    )
                    LLVMReplaceAllUsesWith(shadow, alias)
                    LLVMDeleteFunction(shadow)
                }
                if (pointerIsNull(alias)) alias = LLVMAddAlias2(
                        backend.module,
                        LLVMGlobalGetValueType(direct),
                        0,
                        direct,
                        request.name
                    )
                if (request.internal) {
                    LLVMSetLinkage(alias, llvmInternalLinkage())
                    retained.append(alias)
                }
            } else {
            val parameters = bootstrapLlvmExportParameterTypes(
                backend, request, request.checked
            )
            val resultType = if (request.checked) backend.i32Type else
                bootstrapLlvmExportResultType(backend, request.resultType)
            val function = bootstrapLlvmDeclare(
                backend, request.name, resultType,
                parameters, false,
                bootstrapLlvmFalseFlags(parameters.size)
            )
            if (request.internal) {
                LLVMSetLinkage(function, llvmInternalLinkage())
                retained.append(function)
            }
            if (request.name == "xt_unhandled_interrupt" &&
                bootstrapTextContains(backend.targetTriple, "xtensa")) {
                LLVMSetSection(function, ".iram1.text")
            } else if (program.functions[source].section != "") {
                LLVMSetSection(
                    function,
                    program.functions[source].section
                )
            }
            val entry = LLVMAppendBasicBlockInContext(
                backend.context, function, "entry"
            )
            LLVMPositionBuilderAtEnd(backend.builder, entry)
            if (nakedAssembly >= 0) {
                bootstrapLlvmEmitNakedAssemblyBody(
                    backend,
                    function,
                    program.functions[source].instructions[nakedAssembly]
                )
            } else {
            if (source < initializationRequired.size &&
                initializationRequired[source] &&
                !pointerIsNull(LLVMGetNamedFunction(
                backend.module, "abla_export_ensure_initialized"
            ))) bootstrapLlvmCallNamed(
                backend, "abla_export_ensure_initialized", [],
                "", false, []
            )
            val directScalar = bootstrapLlvmExportUsesDirectScalarAbi(request)
            if (directScalar) {
                bootstrapLlvmEmitDirectScalarExport(
                    backend, request, function,
                    LLVMGetNamedFunction(
                        backend.module,
                        bootstrapLlvmDirectFunctionSymbol(
                            identities.symbols[source]
                        )
                    ), program.functions[source]
                )
            } else {
                val boxed = bootstrapLlvmBoxExportArguments(
                    backend, request, function
                )
                val result = LLVMBuildAlloca(
                    backend.builder, backend.valueType, "export.result"
                )
            if (!request.checked) {
                bootstrapLlvmCall(
                    backend,
                    LLVMGetNamedFunction(
                        backend.module, identities.symbols[source]
                    ),
                    [result, boxed.pointer, LLVMConstInt(
                        backend.i64Type, request.parameterTypes.size, 0
                    )],
                    "", true, [false, false, false]
                )
                bootstrapLlvmReleaseExportCallbacks(
                    backend, boxed.callbacks
                )
                bootstrapLlvmReturnExportValue(
                    backend, result, request.resultType,
                    nativeNullPointer(), false
                )
            } else {
                val nativeResultIndex = boxed.nextNative
                val errorDataIndex = nativeResultIndex +
                    if (request.resultType == "void") 0 else 1
                val errorCapacityIndex = errorDataIndex + 1
                val errorLengthIndex = errorDataIndex + 2
                val status = bootstrapLlvmCallNamed(
                    backend, "abla_checked_invoke",
                    [LLVMGetNamedFunction(
                        backend.module, identities.symbols[source]
                     ), boxed.pointer, LLVMConstInt(
                        backend.i64Type, request.parameterTypes.size, 0
                     ), result, LLVMGetParam(function, errorDataIndex),
                     LLVMGetParam(function, errorCapacityIndex),
                     LLVMGetParam(function, errorLengthIndex)],
                    "export.status", false,
                    [false, false, false, false, false, false, false]
                )
                bootstrapLlvmReleaseExportCallbacks(
                    backend, boxed.callbacks
                )
                val success = LLVMAppendBasicBlockInContext(
                    backend.context, function, "success"
                )
                val failed = LLVMAppendBasicBlockInContext(
                    backend.context, function, "failed"
                )
                val validResult = if (request.resultType == "void")
                    LLVMConstInt(backend.i1Type, 1, 0)
                else LLVMBuildICmp(
                    backend.builder, llvmIntNotEqual(),
                    LLVMGetParam(function, nativeResultIndex),
                    LLVMConstNull(backend.pointerType), "result.valid"
                )
                val invoked = LLVMBuildICmp(
                    backend.builder, llvmIntEqual(), status,
                    LLVMConstInt(backend.i32Type, 0, 0), "invoke.success"
                )
                val okay = LLVMBuildAnd(
                    backend.builder, invoked, validResult, "export.success"
                )
                LLVMBuildCondBr(backend.builder, okay, success, failed)
                LLVMPositionBuilderAtEnd(backend.builder, success)
                bootstrapLlvmReturnExportValue(
                    backend, result, request.resultType,
                    if (request.resultType == "void") nativeNullPointer()
                    else LLVMGetParam(function, nativeResultIndex),
                    true
                )
                LLVMBuildRet(
                    backend.builder, LLVMConstInt(backend.i32Type, 0, 0)
                )
                LLVMPositionBuilderAtEnd(backend.builder, failed)
                val invalidResult = LLVMBuildAnd(
                    backend.builder, invoked,
                    LLVMBuildXor(
                        backend.builder, validResult,
                        LLVMConstInt(backend.i1Type, 1, 0), "result.invalid"
                    ), "invalid.result"
                )
                LLVMBuildRet(
                    backend.builder,
                    LLVMBuildSelect(
                        backend.builder, invalidResult,
                        LLVMConstInt(backend.i32Type, 2, 0),
                        status, "failure.status"
                    )
                )
            }
            }
            }
            }
        }
        index = index + 1
    }
    if (retained.size > 0) {
        val values = llvmPointerVector(retained.size)
        var retainedIndex = 0
        while (retainedIndex < retained.size) {
            values.set(retainedIndex, retained[retainedIndex])
            retainedIndex = retainedIndex + 1
        }
        val type = LLVMArrayType2(backend.pointerType, retained.size)
        val initializer = LLVMConstArray2(
            backend.pointerType, values.pointer(), retained.size
        )
        values.drop()
        val used = LLVMAddGlobal(
            backend.module, type, "llvm.compiler.used"
        )
        LLVMSetInitializer(used, initializer)
        LLVMSetLinkage(used, llvmAppendingLinkage())
        LLVMSetSection(used, "llvm.metadata")
        LLVMSetGlobalConstant(used, 1)
    }
    errors
}

fun bootstrapLlvmEmitMain(
    backend: BootstrapLlvmBackend,
    program: BootstrapIrProgram,
    functionIndex: BootstrapLlvmNameIndex,
    identities: BootstrapLlvmFunctionIdentities,
    globalIndex: BootstrapLlvmNameIndex,
    exports: array<BootstrapExportRequest>,
    requireMain: bool
): int {
    val mainId = functionIndex.find("main")
    val globalsId = functionIndex.find("__bootstrap_globals")
    var errors = 0
    if (mainId >= 0) {
        val main = bootstrapLlvmDeclare(
            backend, "main", backend.i32Type,
            [backend.i32Type, backend.pointerType], false, [false, false]
        )
        val entry = LLVMAppendBasicBlockInContext(
            backend.context, main, "entry"
        )
        LLVMPositionBuilderAtEnd(backend.builder, entry)
        val argc = LLVMGetParam(main, 0)
        val argv = LLVMGetParam(main, 1)
        bootstrapLlvmCallNamed(
            backend, "abla_runtime_set_arguments", [argc, argv],
            "", false, [false, false]
        )
        var globalFrame: i64* = nativeNullPointer()
        var globalRoots: i64* = nativeNullPointer()
        var globalRootsType: i64* = nativeNullPointer()
        var globalRootCount = 0
        var global = 0
        while (global < globalIndex.names.size) {
            if (bootstrapLlvmGlobalScalarType(
                program, globalIndex.names[global]
            ) == "") globalRootCount = globalRootCount + 1
            global = global + 1
        }
        if (globalRootCount > 0) {
            globalFrame = LLVMBuildAlloca(
                backend.builder, backend.rootFrameType, "global.gc.frame"
            )
            globalRootsType = LLVMArrayType2(
                backend.pointerType, globalRootCount
            )
            globalRoots = LLVMBuildAlloca(
                backend.builder, globalRootsType, "global.gc.roots"
            )
            var root = 0
            global = 0
            while (global < globalIndex.names.size) {
                if (bootstrapLlvmGlobalScalarType(
                    program, globalIndex.names[global]
                ) == "") {
                    val slot = bootstrapLlvmArrayElement(
                        backend, globalRootsType, globalRoots, root,
                        "global.gc.root"
                    )
                    LLVMBuildStore(
                        backend.builder,
                        LLVMGetNamedGlobal(
                            backend.module,
                            bootstrapLlvmGlobalSymbol(
                                globalIndex.names[global]
                            )
                        ),
                        slot
                    )
                    root = root + 1
                }
                global = global + 1
            }
        }
        val runtimeGlobals = bootstrapLlvmHasRuntimeGlobals(backend, program)
        if (globalsId >= 0 && exports.size == 0 && runtimeGlobals) {
            val globalResult = LLVMBuildAlloca(
                backend.builder, backend.valueType, "global.result"
            )
            bootstrapLlvmCall(
                backend,
                LLVMGetNamedFunction(
                    backend.module, identities.symbols[globalsId]
                ),
                [globalResult, LLVMConstNull(backend.pointerType),
                 LLVMConstInt(backend.i64Type, 0, 0)],
                "", true, [false, false, false]
            )
        }
        if (globalsId >= 0 && exports.size > 0 && runtimeGlobals) {
            bootstrapLlvmCallNamed(
                backend,
                "abla_export_ensure_initialized",
                [],
                "",
                false,
                []
            )
        }
        // Global initialization may initialize the Abla-authored collector's
        // own root-frame head. Publish global roots only after that bootstrap
        // has completed; collection is deliberately suppressed inside the
        // bootstrap function itself.
        if (globalRootCount > 0) {
            val rootsPointer = bootstrapLlvmArrayElement(
                backend, globalRootsType, globalRoots, 0,
                "global.gc.roots.pointer"
            )
            bootstrapLlvmCallNamed(
                backend, "abla_runtime_roots_push",
                [globalFrame, rootsPointer,
                 LLVMConstInt(
                    backend.i64Type, globalRootCount, 0
                 )],
                "", false, [false, false, false]
            )
        }
        val mainResult = LLVMBuildAlloca(
            backend.builder, backend.valueType, "main.result"
        )
        bootstrapLlvmCall(
            backend,
            LLVMGetNamedFunction(
                backend.module, identities.symbols[mainId]
            ),
            [mainResult, LLVMConstNull(backend.pointerType),
             LLVMConstInt(backend.i64Type, 0, 0)],
            "", true, [false, false, false]
        )
        val status = bootstrapLlvmCallNamed(
            backend, "abla_as_i64", [mainResult],
            "main.status.i64", false, [true]
        )
        if (globalRootCount > 0) {
            bootstrapLlvmCallNamed(
                backend, "abla_runtime_roots_pop", [globalFrame],
                "", false, [false]
            )
        }
        LLVMBuildRet(
            backend.builder,
            LLVMBuildTrunc(
                backend.builder, status, backend.i32Type, "main.status"
            )
        )
    }
    if (requireMain && mainId < 0 && exports.size == 0) errors = errors + 1
    errors
}
