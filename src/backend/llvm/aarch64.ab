import "./bindings.ab"
import "core.ab"

// AArch64 Linux (#811). The stdlib and the backend call system calls by their
// x86-64 numbers and with x86-64 structures; this routine is the whole of what an
// AArch64 program needs to keep that contract: abla_x64_syscall(number, a0..a5) in
// the C calling convention (x0 = number, x1-x6 = arguments, result in x0, -errno on
// failure). The numbers x86-64 and AArch64 share by name are a table; the calls
// AArch64 has no number for (open, stat, poll, dup2, fork, pipe, rename, mkdir, unlink,
// ...) are made with their *at, dup3, ppoll, clone and pipe2 forms; the structures
// differ in three places that are converted here: the stat result (field order), the
// open flags (O_DIRECTORY, O_NOFOLLOW, O_DIRECT, O_LARGEFILE are different bits) and
// utimes/poll's time arguments. An x86-64 number without a counterpart returns -ENOSYS.
// The table below comes from the kernel's x86-64 and asm-generic system call lists: an
// entry is the AArch64 number, 0xFFFF (none), or 0x8000 + the index of a handler.
fun bootstrapLlvmAarch64SyscallAssembly(): string {
    ".text\n.p2align 2\n" +
    bootstrapLlvmAssemblyHiddenFunction("abla_x64_syscall") +
    "abla_x64_syscall:\n" +
    "    cmp x0, #335\n" +
    "    b.hs 3f\n" +
    "    adr x7, 4f\n" +
    "    ldrh w7, [x7, x0, lsl #1]\n" +
    "    tbnz w7, #15, 2f\n" +
    "    mov x8, x7\n" +
    "    mov x0, x1\n    mov x1, x2\n    mov x2, x3\n    mov x3, x4\n    mov x4, x5\n    mov x5, x6\n" +
    "    svc #0\n" +
    "    ret\n" +
    "2:  mov w9, #0xffff\n" +
    "    cmp w7, w9\n" +
    "    b.eq 3f\n" +
    "    and w7, w7, #0x7fff\n" +
    "    adr x9, 5f\n" +
    "    ldr w10, [x9, x7, lsl #2]\n" +
    "    add x9, x9, w10, sxtw\n" +
    "    br x9\n" +
    "3:  mov x0, #-38\n" +
    "    ret\n" +
    ".p2align 1\n" +
    "4:\n" +
    ".hword 63,64,32768,57,32769,32770,32771,32772,62,222,226,215,214,134,135,139\n" +
    ".hword 29,67,68,65,66,32773,32774,65535,124,216,227,232,233,194,196,195\n" +
    ".hword 23,32775,65535,101,102,65535,103,172,71,198,203,202,206,207,211,212\n" +
    ".hword 210,200,201,204,205,199,208,209,32789,32776,32776,221,93,260,129,160\n" +
    ".hword 190,193,191,197,186,189,188,187,25,32,82,83,45,46,65535,17\n" +
    ".hword 49,50,32777,32778,32779,65535,32780,32781,32782,32783,32784,52,32785,55,32786,166\n" +
    ".hword 169,163,165,179,153,117,174,116,176,146,144,175,177,154,173,32787\n" +
    ".hword 157,145,143,158,159,147,148,149,150,155,151,152,156,90,91,136\n" +
    ".hword 137,138,133,132,65535,65535,65535,92,65535,43,44,65535,141,140,118,121\n" +
    ".hword 119,120,125,126,127,228,229,230,231,58,65535,41,65535,167,65535,171\n" +
    ".hword 164,51,81,89,170,40,39,224,225,142,161,162,65535,65535,65535,105\n" +
    ".hword 106,65535,65535,60,42,65535,65535,65535,65535,65535,178,213,5,6,7,8\n" +
    ".hword 9,10,11,12,13,14,15,16,130,65535,98,122,123,65535,0,1\n" +
    ".hword 4,2,3,65535,18,32792,65535,65535,234,61,96,128,192,223,107,110\n" +
    ".hword 108,109,111,112,113,114,115,94,32793,32794,131,32788,65535,235,237,236\n" +
    ".hword 180,181,182,183,184,185,104,95,217,218,219,30,31,65535,27,28\n" +
    ".hword 238,32790,34,33,54,65535,32791,35,38,37,36,78,53,48,72,73\n" +
    ".hword 97,99,100,76,77,84,75,239,88,32795,65535,85,65535,47,86,87\n" +
    ".hword 242,74,19,20,24,59,26,69,70,240,241,243,262,263,261,264\n" +
    ".hword 265,266,267,269,268,168,270,271,272,273,274,275,276,277,278,279\n" +
    ".hword 294,280,281,282,283,284,285,286,287,288,289,290,291,292,293\n" +
    ".p2align 2\n" +
    "5:\n" +
    ".word .Lx64_open - 5b, .Lx64_stat - 5b, .Lx64_fstat - 5b, .Lx64_lstat - 5b, .Lx64_poll - 5b\n" +
    ".word .Lx64_access - 5b, .Lx64_pipe - 5b, .Lx64_dup2 - 5b, .Lx64_fork - 5b, .Lx64_rename - 5b\n" +
    ".word .Lx64_mkdir - 5b, .Lx64_rmdir - 5b, .Lx64_link - 5b, .Lx64_unlink - 5b, .Lx64_symlink - 5b\n" +
    ".word .Lx64_readlink - 5b, .Lx64_chmod - 5b, .Lx64_chown - 5b, .Lx64_lchown - 5b, .Lx64_getpgrp - 5b\n" +
    ".word .Lx64_utimes - 5b, .Lx64_clone - 5b, .Lx64_openat - 5b, .Lx64_newfstatat - 5b, .Lx64_epoll_create - 5b\n" +
    ".word .Lx64_epoll_wait - 5b, .Lx64_epoll_ctl - 5b, .Lx64_epoll_pwait - 5b\n" +
    // open(path, flags, mode) -> openat(AT_FDCWD, path, flags', mode)
    ".Lx64_open:\n" +
    "    mov x0, #-100\n" +
    bootstrapLlvmAarch64OpenFlags() +
    "    mov x8, #56\n    svc #0\n    ret\n" +
    // openat(dirfd, path, flags, mode)
    ".Lx64_openat:\n" +
    "    mov x0, x1\n    mov x1, x2\n    mov x2, x3\n    mov x3, x4\n" +
    bootstrapLlvmAarch64OpenFlags() +
    "    mov x8, #56\n    svc #0\n    ret\n" +
    // The stat family: the AArch64 result is converted to x86-64's field order in place.
    ".Lx64_stat:\n" +
    "    mov x9, x2\n    mov x0, #-100\n    mov x3, #0\n    mov x8, #79\n    svc #0\n    b .Lx64_convert_stat\n" +
    ".Lx64_lstat:\n" +
    "    mov x9, x2\n    mov x0, #-100\n    mov x3, #0x100\n    mov x8, #79\n    svc #0\n    b .Lx64_convert_stat\n" +
    ".Lx64_fstat:\n" +
    "    mov x9, x2\n    mov x0, x1\n    mov x1, x2\n    mov x8, #80\n    svc #0\n    b .Lx64_convert_stat\n" +
    ".Lx64_newfstatat:\n" +
    "    mov x9, x3\n    mov x0, x1\n    mov x1, x2\n    mov x2, x3\n    mov x3, x4\n    mov x8, #79\n    svc #0\n" +
    ".Lx64_convert_stat:\n" +
    "    cbnz x0, 1f\n" +
    "    ldr w10, [x9, #16]\n    ldr w11, [x9, #20]\n    ldr w12, [x9, #24]\n    ldr w13, [x9, #28]\n" +
    "    ldr x14, [x9, #32]\n    ldr w15, [x9, #56]\n" +
    "    str x11, [x9, #16]\n    str w10, [x9, #24]\n    str w12, [x9, #28]\n    str w13, [x9, #32]\n" +
    "    str wzr, [x9, #36]\n    str x14, [x9, #40]\n    str x15, [x9, #56]\n" +
    "1:  ret\n" +
    // poll(fds, nfds, milliseconds) -> ppoll(fds, nfds, timespec or NULL, NULL, 8)
    ".Lx64_poll:\n" +
    "    sub sp, sp, #16\n" +
    "    sxtw x3, w3\n" +
    "    mov x0, x1\n    mov x1, x2\n" +
    "    tbnz x3, #63, 1f\n" +
    "    mov x9, #1000\n    sdiv x10, x3, x9\n    msub x11, x10, x9, x3\n    movz x12, #0x4240\n    movk x12, #0xf, lsl #16\n    mul x11, x11, x12\n" +
    "    stp x10, x11, [sp]\n    mov x2, sp\n    b 2f\n" +
    "1:  mov x2, #0\n" +
    "2:  mov x3, #0\n    mov x4, #8\n    mov x8, #73\n    svc #0\n    add sp, sp, #16\n    ret\n" +
    ".Lx64_access:\n    mov x0, #-100\n    mov x8, #48\n    svc #0\n    ret\n" +
    ".Lx64_pipe:\n    mov x0, x1\n    mov x1, #0\n    mov x8, #59\n    svc #0\n    ret\n" +
    // dup2(old, new): dup3 with no flags; equal descriptors only check that old is open.
    ".Lx64_dup2:\n" +
    "    cmp x1, x2\n    b.ne 1f\n" +
    "    mov x0, x1\n    mov x1, #1\n    mov x8, #25\n    svc #0\n" +
    "    tbnz x0, #63, 2f\n    mov x0, x2\n2:  ret\n" +
    "1:  mov x0, x1\n    mov x1, x2\n    mov x2, #0\n    mov x8, #24\n    svc #0\n    ret\n" +
    // fork and vfork: clone(SIGCHLD) without sharing anything.
    ".Lx64_fork:\n    mov x0, #17\n    mov x1, #0\n    mov x2, #0\n    mov x3, #0\n    mov x4, #0\n    mov x8, #220\n    svc #0\n    ret\n" +
    ".Lx64_rename:\n    mov x3, x2\n    mov x2, #-100\n    mov x0, #-100\n    mov x4, #0\n    mov x8, #276\n    svc #0\n    ret\n" +
    ".Lx64_mkdir:\n    mov x0, #-100\n    mov x8, #34\n    svc #0\n    ret\n" +
    ".Lx64_rmdir:\n    mov x0, #-100\n    mov x2, #0x200\n    mov x8, #35\n    svc #0\n    ret\n" +
    ".Lx64_unlink:\n    mov x0, #-100\n    mov x2, #0\n    mov x8, #35\n    svc #0\n    ret\n" +
    ".Lx64_link:\n    mov x3, x2\n    mov x2, #-100\n    mov x0, #-100\n    mov x4, #0\n    mov x8, #37\n    svc #0\n    ret\n" +
    ".Lx64_symlink:\n    mov x0, x1\n    mov x1, #-100\n    mov x8, #36\n    svc #0\n    ret\n" +
    ".Lx64_readlink:\n    mov x0, #-100\n    mov x8, #78\n    svc #0\n    ret\n" +
    ".Lx64_chmod:\n    mov x0, #-100\n    mov x8, #53\n    svc #0\n    ret\n" +
    ".Lx64_chown:\n    mov x0, #-100\n    mov x4, #0\n    mov x8, #54\n    svc #0\n    ret\n" +
    ".Lx64_lchown:\n    mov x0, #-100\n    mov x4, #0x100\n    mov x8, #54\n    svc #0\n    ret\n" +
    ".Lx64_getpgrp:\n    mov x0, #0\n    mov x8, #155\n    svc #0\n    ret\n" +
    // utimes(path, struct timeval[2]) -> utimensat(AT_FDCWD, path, struct timespec[2], 0)
    ".Lx64_utimes:\n" +
    "    sub sp, sp, #32\n" +
    "    cbz x2, 1f\n" +
    "    mov x11, #1000\n" +
    "    ldp x9, x10, [x2]\n    mul x10, x10, x11\n    stp x9, x10, [sp]\n" +
    "    ldp x9, x10, [x2, #16]\n    mul x10, x10, x11\n    stp x9, x10, [sp, #16]\n" +
    "    mov x2, sp\n    b 2f\n" +
    "1:  mov x2, #0\n" +
    "2:  mov x0, #-100\n    mov x3, #0\n    mov x8, #88\n    svc #0\n    add sp, sp, #32\n    ret\n" +
    // clone(flags, stack, ptid, ctid, tls) -> clone(flags, stack, ptid, tls, ctid)
    ".Lx64_clone:\n    mov x0, x1\n    mov x1, x2\n    mov x2, x3\n    mov x3, x5\n    mov x8, #220\n    svc #0\n    ret\n" +
    ".Lx64_epoll_create:\n    mov x0, #0\n    mov x8, #20\n    svc #0\n    ret\n" +
    // epoll_event is packed on x86-64 (4-byte events, 8-byte data: 12 bytes) and 16 bytes on
    // AArch64 (data at 8): epoll_ctl converts the one event it passes in, and epoll_wait and
    // epoll_pwait receive into a stack buffer (at most 64 events, which a caller may take as
    // a short answer) and convert them into the caller's packed array, in place and forward.
    ".Lx64_epoll_ctl:\n" +
    "    sub sp, sp, #16\n    cbz x4, 1f\n" +
    "    ldr w9, [x4]\n    ldr x10, [x4, #4]\n    str w9, [sp]\n    str x10, [sp, #8]\n    mov x4, sp\n" +
    "1:  mov x0, x1\n    mov x1, x2\n    mov x2, x3\n    mov x3, x4\n    mov x8, #21\n    svc #0\n    add sp, sp, #16\n    ret\n" +
    ".Lx64_epoll_wait:\n    mov x5, #0\n    mov x6, #8\n" +
    ".Lx64_epoll_pwait:\n" +
    "    sub sp, sp, #1040\n" +
    "    mov x9, #64\n    cmp x3, x9\n    csel x3, x9, x3, gt\n" +
    "    mov x7, x2\n    mov x0, x1\n    mov x1, sp\n    mov x2, x3\n    mov x3, x4\n    mov x4, x5\n    mov x5, x6\n" +
    "    mov x8, #22\n    svc #0\n" +
    "    cmp x0, #0\n    b.le 2f\n    mov x9, #0\n    mov x10, sp\n" +
    "1:  ldr w11, [x10]\n    ldr x12, [x10, #8]\n    str w11, [x7]\n    str x12, [x7, #4]\n" +
    "    add x10, x10, #16\n    add x7, x7, #12\n    add x9, x9, #1\n    cmp x9, x0\n    b.lt 1b\n" +
    "2:  add sp, sp, #1040\n    ret\n" +
    ".size abla_x64_syscall, . - abla_x64_syscall\n"
}

// x86-64's O_DIRECT, O_LARGEFILE, O_DIRECTORY, O_NOFOLLOW are bits 14 to 17; AArch64's
// O_DIRECTORY, O_NOFOLLOW, O_DIRECT, O_LARGEFILE are the same bits in that order: the
// four-bit field rotates by two. The flags are in w2.
fun bootstrapLlvmAarch64OpenFlags(): string =
    "    ubfx w10, w2, #14, #4\n    lsr w11, w10, #2\n    and w12, w10, #3\n    lsl w12, w12, #2\n" +
    "    orr w10, w11, w12\n    bfi w2, w10, #14, #4\n"

fun bootstrapLlvmEmitAarch64Routines(backend: BootstrapLlvmBackend): void {
    val assembly = bootstrapLlvmAarch64SyscallAssembly() + bootstrapLlvmAarch64StartAssembly() +
        bootstrapLlvmAarch64JumpAssembly() +
        bootstrapLlvmAarch64MemoryAssembly() +
        bootstrapLlvmAarch64ThreadAssembly()
    LLVMAppendModuleInlineAsm(backend.module, assembly, assembly.size)
    return
}

// The process entry of a static AArch64 Linux executable, linked with -e abla_start: the
// kernel hands over sp -> argc, argv..., NULL, envp..., NULL, auxv. It finds the program
// headers in the auxiliary vector (AT_PHDR 3, AT_PHNUM 5), maps and fills the thread's
// TLS block (variant I: the thread pointer points at a 16-byte thread control block and
// the TLS image follows at the next multiple of its alignment, as ld.lld lays out
// local-exec accesses), points tpidr_el0 at it, runs the init_array entries, calls
// main(argc, argv, envp) and exits with its status.
fun bootstrapLlvmAarch64StartAssembly(): string {
    ".text\n.p2align 2\n" +
    ".pushsection .bss\n.p2align 3\n" +
    ".globl abla_start_phdr\n.globl abla_start_phnum\n.globl abla_start_base\n" +
    "abla_start_phdr: .zero 8\nabla_start_phnum: .zero 8\nabla_start_base: .zero 8\n" +
    ".popsection\n" +
    ".globl abla_start\n.hidden abla_start\n.type abla_start,@function\n" +
    "abla_start:\n" +
    "    mov x29, #0\n    mov x30, #0\n" +
    "    mov x19, sp\n" +
    "    ldr x20, [x19]\n" +
    "    add x21, x19, #8\n" +
    "    add x22, x21, x20, lsl #3\n    add x22, x22, #8\n" +
    "    mov x23, x22\n" +
    "1:  ldr x0, [x23], #8\n    cbnz x0, 1b\n" +
    "    mov x24, #0\n    mov x25, #0\n" +
    "2:  ldp x0, x1, [x23], #16\n    cbz x0, 3f\n" +
    "    cmp x0, #3\n    csel x24, x1, x24, eq\n" +
    "    cmp x0, #5\n    csel x25, x1, x25, eq\n" +
    "    b 2b\n" +
    "3:  adrp x9, abla_start_phdr\n    str x24, [x9, :lo12:abla_start_phdr]\n" +
    "    adrp x9, abla_start_phnum\n    str x25, [x9, :lo12:abla_start_phnum]\n" +
    // A static-pie image moves: the load bias is the runtime address of the program headers
    // less the PT_PHDR address the linker gave them (0 for a non-PIE image, whose headers
    // have no PT_PHDR); PT_DYNAMIC (2) holds the relocations and the init_array.
    "    mov x28, #0\n    mov x9, #0\n    mov x0, x24\n    mov x1, x25\n" +
    "20: cbz x1, 23f\n    ldr w2, [x0]\n    cmp w2, #6\n    b.ne 21f\n    ldr x3, [x0, #16]\n    sub x28, x24, x3\n" +
    "21: cmp w2, #2\n    b.ne 22f\n    ldr x9, [x0, #16]\n" +
    "22: add x0, x0, #56\n    sub x1, x1, #1\n    b 20b\n" +
    "23: adrp x10, abla_start_base\n    str x28, [x10, :lo12:abla_start_base]\n" +
    "    mov x10, #0\n    mov x11, #0\n    mov x26, #0\n    mov x27, #0\n" +
    "    cbz x9, 27f\n    add x9, x9, x28\n" +
    "24: ldp x0, x1, [x9], #16\n    cbz x0, 25f\n" +
    "    cmp x0, #7\n    csel x10, x1, x10, eq\n" +
    "    cmp x0, #8\n    csel x11, x1, x11, eq\n" +
    "    cmp x0, #25\n    csel x26, x1, x26, eq\n" +
    "    cmp x0, #27\n    csel x27, x1, x27, eq\n" +
    "    cmp x0, #36\n    b.eq 99f\n    cmp x0, #17\n    b.eq 99f\n" +
    "    b 24b\n" +
    // Only R_AARCH64_RELATIVE (1027): *(bias + offset) = bias + addend.
    "25: cbz x10, 26f\n    add x10, x10, x28\n" +
    "251: cbz x11, 26f\n    ldp x0, x1, [x10]\n    ldr x2, [x10, #16]\n    mov x3, #0x403\n    cmp x1, x3\n    b.ne 99f\n" +
    "    add x0, x0, x28\n    add x2, x2, x28\n    str x2, [x0]\n    add x10, x10, #24\n    sub x11, x11, #24\n    b 251b\n" +
    "26: add x26, x26, x28\n    add x27, x26, x27\n    b 28f\n" +
    // No dynamic section: no relocations and no init_array.
    "27:\n" +
    "28:\n" +
    // The main thread's TLS block: mapped here, never unmapped.
    "    mov x0, x24\n    mov x1, x25\n    bl abla_tls_bytes\n" +
    "    tbnz x0, #63, 99f\n" +
    "    mov x1, x0\n    mov x0, #0\n    mov x2, #3\n    mov x3, #0x22\n    mov x4, #-1\n    mov x5, #0\n    mov x8, #222\n    svc #0\n" +
    "    cmn x0, #4095\n    b.hs 99f\n" +
    "    mov x1, x24\n    mov x2, x25\n    bl abla_tls_init\n" +
    "    msr tpidr_el0, x0\n" +
    "10: cmp x26, x27\n    b.hs 11f\n    ldr x11, [x26], #8\n" +
    "    mov x0, x20\n    mov x1, x21\n    mov x2, x22\n    blr x11\n    b 10b\n" +
    "11: mov x0, x20\n    mov x1, x21\n    mov x2, x22\n    bl main\n" +
    "    mov x8, #94\n    svc #0\n" +
    "99: mov x0, #127\n    mov x8, #94\n    svc #0\n" +
    ".size abla_start, . - abla_start\n" +
    // abla_tls_bytes(phdr, phnum): the bytes of one thread's TLS block (a page for the thread
    // control block, the image after it at its alignment, rounded to a page), or -1.
    ".p2align 2\n.globl abla_tls_bytes\n.hidden abla_tls_bytes\n.type abla_tls_bytes,@function\n" +
    "abla_tls_bytes:\n" +
    "    mov x2, #0\n" +
    "1:  cbz x1, 2f\n    ldr w3, [x0]\n    cmp w3, #7\n    csel x2, x0, x2, eq\n    add x0, x0, #56\n    sub x1, x1, #1\n    b 1b\n" +
    "2:  mov x3, #16\n    mov x4, #0\n    cbz x2, 3f\n    ldr x5, [x2, #48]\n    cmp x5, x3\n    csel x3, x5, x3, hi\n    ldr x4, [x2, #40]\n" +
    "3:  cmp x3, #4096\n    b.hi 4f\n" +
    "    sub x5, x3, #1\n    add x6, x5, #16\n    bic x6, x6, x5\n" +
    "    add x0, x6, x4\n    add x0, x0, #4095\n    add x0, x0, #4096\n    and x0, x0, #-4096\n    ret\n" +
    "4:  mov x0, #-1\n    ret\n" +
    ".size abla_tls_bytes, . - abla_tls_bytes\n" +
    // abla_tls_init(buffer, phdr, phnum): the thread pointer for a zeroed, page-aligned buffer
    // of abla_tls_bytes: the image is copied to the offset the linker laid out for it (the
    // buffer itself is the 16-byte thread control block).
    ".p2align 2\n.globl abla_tls_init\n.hidden abla_tls_init\n.type abla_tls_init,@function\n" +
    "abla_tls_init:\n" +
    "    mov x9, x0\n    mov x3, #0\n" +
    "1:  cbz x2, 2f\n    ldr w4, [x1]\n    cmp w4, #7\n    csel x3, x1, x3, eq\n    add x1, x1, #56\n    sub x2, x2, #1\n    b 1b\n" +
    "2:  cbz x3, 9f\n" +
    "    mov x4, #16\n    ldr x5, [x3, #48]\n    cmp x5, x4\n    csel x4, x5, x4, hi\n" +
    "    sub x5, x4, #1\n    add x6, x5, #16\n    bic x6, x6, x5\n" +
    "    ldr x10, [x3, #16]\n    adrp x14, abla_start_base\n    ldr x14, [x14, :lo12:abla_start_base]\n    add x10, x10, x14\n    ldr x11, [x3, #32]\n    add x12, x9, x6\n" +
    "3:  cbz x11, 9f\n    ldrb w13, [x10], #1\n    strb w13, [x12], #1\n    sub x11, x11, #1\n    b 3b\n" +
    "9:  mov x0, x9\n    ret\n" +
    ".size abla_tls_init, . - abla_tls_init\n"
}

// _setjmp and _longjmp for AArch64 Linux, in a format of their own (nothing else reads a
// jmp_buf here): x19-x30 in words 0-11, sp in word 12, d8-d15 in words 13-20. No signal
// mask is saved or restored. _longjmp returns its value, or 1 for 0.
fun bootstrapLlvmAarch64JumpAssembly(): string {
    ".text\n.p2align 2\n" +
    bootstrapLlvmAssemblyHiddenFunction("_setjmp") +
    "_setjmp:\n" +
    "    stp x19, x20, [x0, #0]\n    stp x21, x22, [x0, #16]\n    stp x23, x24, [x0, #32]\n" +
    "    stp x25, x26, [x0, #48]\n    stp x27, x28, [x0, #64]\n    stp x29, x30, [x0, #80]\n" +
    "    mov x2, sp\n    str x2, [x0, #96]\n" +
    "    stp d8, d9, [x0, #104]\n    stp d10, d11, [x0, #120]\n    stp d12, d13, [x0, #136]\n    stp d14, d15, [x0, #152]\n" +
    "    mov x0, #0\n    ret\n" +
    ".size _setjmp, . - _setjmp\n" +
    bootstrapLlvmAssemblyHiddenFunction("_longjmp") +
    "_longjmp:\n" +
    "    ldp x19, x20, [x0, #0]\n    ldp x21, x22, [x0, #16]\n    ldp x23, x24, [x0, #32]\n" +
    "    ldp x25, x26, [x0, #48]\n    ldp x27, x28, [x0, #64]\n    ldp x29, x30, [x0, #80]\n" +
    "    ldr x2, [x0, #96]\n    mov sp, x2\n" +
    "    ldp d8, d9, [x0, #104]\n    ldp d10, d11, [x0, #120]\n    ldp d12, d13, [x0, #136]\n    ldp d14, d15, [x0, #152]\n" +
    "    cmp w1, #0\n    mov w2, #1\n    csel w0, w2, w1, eq\n" +
    "    ret\n" +
    ".size _longjmp, . - _longjmp\n"
}

// memmove, memcpy, memset, memcmp, bcmp and strlen for AArch64 Linux, hidden module
// assembly like the x86-64 ones (LLVM lowers llvm.memcpy and friends to calls of these
// names): 16 bytes a step with ldp/stp, then bytes. memmove copies backwards when the
// destination lies inside the source.
fun bootstrapLlvmAarch64MemoryAssembly(): string {
    ".text\n.p2align 2\n" +
    bootstrapLlvmAssemblyHiddenFunction("memmove") +
    "memmove:\n" +
    "    cmp x0, x1\n    b.ls memcpy\n" +
    "    add x3, x1, x2\n    cmp x0, x3\n    b.hs memcpy\n" +
    "    add x4, x0, x2\n    add x5, x1, x2\n" +
    "1:  cmp x2, #16\n    b.lo 3f\n    ldp x6, x7, [x5, #-16]!\n    stp x6, x7, [x4, #-16]!\n    sub x2, x2, #16\n    b 1b\n" +
    "3:  cbz x2, 9f\n" +
    "4:  ldrb w6, [x5, #-1]!\n    strb w6, [x4, #-1]!\n    subs x2, x2, #1\n    b.ne 4b\n" +
    "9:  ret\n" +
    ".size memmove, . - memmove\n" +
    bootstrapLlvmAssemblyHiddenFunction("memcpy") +
    "memcpy:\n" +
    "    mov x4, x0\n" +
    "1:  cmp x2, #16\n    b.lo 2f\n    ldp x6, x7, [x1], #16\n    stp x6, x7, [x4], #16\n    sub x2, x2, #16\n    b 1b\n" +
    "2:  cbz x2, 9f\n" +
    "3:  ldrb w6, [x1], #1\n    strb w6, [x4], #1\n    subs x2, x2, #1\n    b.ne 3b\n" +
    "9:  ret\n" +
    ".size memcpy, . - memcpy\n" +
    bootstrapLlvmAssemblyHiddenFunction("memset") +
    "memset:\n" +
    "    and x1, x1, #0xff\n    mov x3, #0x0101010101010101\n    mul x3, x1, x3\n    mov x4, x0\n" +
    "1:  cmp x2, #16\n    b.lo 2f\n    stp x3, x3, [x4], #16\n    sub x2, x2, #16\n    b 1b\n" +
    "2:  cbz x2, 9f\n" +
    "3:  strb w1, [x4], #1\n    subs x2, x2, #1\n    b.ne 3b\n" +
    "9:  ret\n" +
    ".size memset, . - memset\n" +
    bootstrapLlvmAssemblyHiddenFunction("memcmp") +
    bootstrapLlvmAssemblyHiddenFunction("bcmp") +
    "memcmp:\nbcmp:\n" +
    "1:  cbz x2, 2f\n    ldrb w3, [x0], #1\n    ldrb w4, [x1], #1\n    subs w3, w3, w4\n    b.ne 3f\n    sub x2, x2, #1\n    b 1b\n" +
    "2:  mov w0, #0\n    ret\n" +
    "3:  mov w0, w3\n    ret\n" +
    ".size memcmp, . - memcmp\n.size bcmp, . - bcmp\n" +
    bootstrapLlvmAssemblyHiddenFunction("strlen") +
    "strlen:\n" +
    "    mov x1, x0\n" +
    "1:  ldrb w2, [x1], #1\n    cbnz w2, 1b\n" +
    "    sub x0, x1, x0\n    sub x0, x0, #1\n    ret\n" +
    ".size strlen, . - strlen\n"
}

// pthread_create and pthread_join as abla_clone_create/abla_clone_join (the link
// defines the pthread names as these), the AArch64 twins of the x86-64 routines: one
// mapping per thread, a guard page, the stack, 64 KiB for its alternate signal stack, its
// TLS block and a control page at the very top holding {tid word (the kernel clears it
// and wakes futex waiters when the thread exits), mapping base, mapping size, entry,
// argument, stack top}. The stack size is the RLIMIT_STACK soft limit, 8 MiB when that
// is unlimited or unreadable. abla_clone_create(handle*, attr, entry, argument) stores
// the control page's address in *handle and returns 0, or an errno.
fun bootstrapLlvmAarch64ThreadAssembly(): string {
    ".text\n.p2align 2\n" +
    bootstrapLlvmAssemblyHiddenFunction("abla_clone_create") +
    "abla_clone_create:\n" +
    "    stp x29, x30, [sp, #-96]!\n    mov x29, sp\n" +
    "    stp x19, x20, [sp, #16]\n    stp x21, x22, [sp, #32]\n    stp x23, x24, [sp, #48]\n" +
    "    stp x25, x26, [sp, #64]\n    str x27, [sp, #80]\n" +
    "    mov x19, x0\n    mov x20, x2\n    mov x21, x3\n" +
    // prlimit64(0, RLIMIT_STACK, NULL, &limit)
    "    sub sp, sp, #16\n    mov x0, #0\n    mov x1, #3\n    mov x2, #0\n    mov x3, sp\n    mov x8, #261\n    svc #0\n" +
    "    ldr x22, [sp]\n    add sp, sp, #16\n" +
    "    cbnz x0, 1f\n    cmn x22, #1\n    b.eq 1f\n    cmp x22, #65536\n    b.hs 2f\n" +
    "1:  mov x22, #0x800000\n" +
    "2:  add x22, x22, #4095\n    and x22, x22, #-4096\n" +
    "    adrp x0, abla_start_phdr\n    ldr x0, [x0, :lo12:abla_start_phdr]\n" +
    "    adrp x1, abla_start_phnum\n    ldr x1, [x1, :lo12:abla_start_phnum]\n" +
    "    bl abla_tls_bytes\n    tbnz x0, #63, 90f\n" +
    "    add x23, x0, #4095\n    and x23, x23, #-4096\n" +
    "    add x25, x22, x23\n    add x25, x25, #73728\n" +
    // mmap(0, total, PROT_READ|PROT_WRITE, MAP_PRIVATE|MAP_ANONYMOUS|MAP_STACK, -1, 0)
    "    mov x0, #0\n    mov x1, x25\n    mov x2, #3\n    mov x3, #0x22\n    movk x3, #2, lsl #16\n    mov x4, #-1\n    mov x5, #0\n    mov x8, #222\n    svc #0\n" +
    "    cmn x0, #4095\n    b.hs 91f\n" +
    "    mov x24, x0\n" +
    "    mov x0, x24\n    mov x1, #4096\n    mov x2, #0\n    mov x8, #226\n    svc #0\n" +
    "    add x26, x24, x25\n    sub x26, x26, #4096\n" +
    "    add x9, x24, #4096\n    add x9, x9, x22\n" +
    "    str xzr, [x26]\n    str x24, [x26, #8]\n    str x25, [x26, #16]\n    str x20, [x26, #24]\n    str x21, [x26, #32]\n    str x9, [x26, #40]\n" +
    "    add x0, x9, #16, lsl #12\n" +
    "    adrp x1, abla_start_phdr\n    ldr x1, [x1, :lo12:abla_start_phdr]\n" +
    "    adrp x2, abla_start_phnum\n    ldr x2, [x2, :lo12:abla_start_phnum]\n" +
    "    bl abla_tls_init\n    mov x27, x0\n" +
    "    ldr x9, [x26, #40]\n" +
    // clone(CLONE_VM|FS|FILES|SIGHAND|THREAD|SYSVSEM|SETTLS|PARENT_SETTID|CHILD_CLEARTID, stack, ptid, tls, ctid)
    "    mov x0, #0x0f00\n    movk x0, #0x3d, lsl #16\n    sub x1, x9, #16\n    mov x2, x26\n    mov x3, x27\n    mov x4, x26\n    mov x8, #220\n    svc #0\n" +
    "    cbz x0, 5f\n    tbnz x0, #63, 92f\n" +
    "    str x26, [x19]\n    mov x0, #0\n    b 99f\n" +
    // The thread: its own alternate signal stack above its stack, then entry(argument).
    "5:  mov x29, #0\n    sub sp, sp, #32\n    ldr x9, [x26, #40]\n    str x9, [sp]\n    str xzr, [sp, #8]\n    mov x10, #65536\n    str x10, [sp, #16]\n" +
    "    mov x0, sp\n    mov x1, #0\n    mov x8, #132\n    svc #0\n    add sp, sp, #32\n" +
    "    ldr x0, [x26, #32]\n    ldr x1, [x26, #24]\n    blr x1\n" +
    "6:  mov x0, #0\n    mov x8, #93\n    svc #0\n    b 6b\n" +
    "92: neg x0, x0\n    mov x19, x0\n    mov x0, x24\n    mov x1, x25\n    mov x8, #215\n    svc #0\n    mov x0, x19\n    b 99f\n" +
    "91: neg x0, x0\n    b 99f\n" +
    "90: mov x0, #22\n" +
    "99: ldp x19, x20, [sp, #16]\n    ldp x21, x22, [sp, #32]\n    ldp x23, x24, [sp, #48]\n" +
    "    ldp x25, x26, [sp, #64]\n    ldr x27, [sp, #80]\n    ldp x29, x30, [sp], #96\n    ret\n" +
    ".size abla_clone_create, . - abla_clone_create\n" +
    bootstrapLlvmAssemblyHiddenFunction("abla_clone_join") +
    "abla_clone_join:\n" +
    "    mov x9, x0\n" +
    "1:  ldr w2, [x9]\n    cbz w2, 2f\n    mov x0, x9\n    mov x1, #0\n    mov x3, #0\n    mov x8, #98\n    svc #0\n    b 1b\n" +
    "2:  ldr x0, [x9, #8]\n    ldr x1, [x9, #16]\n    mov x8, #215\n    svc #0\n    mov x0, #0\n    ret\n" +
    ".size abla_clone_join, . - abla_clone_join\n"
}
