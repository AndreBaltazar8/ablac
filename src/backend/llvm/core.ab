import "analysis.ab"
import "bindings.ab"
import "../../simd_types.ab"
import "simd.ab"
import "abla/llvm/orc"
import "../../sema.ab"
import "debug.ab"
import "abla/unsafe/memory/raw"
import "abla/unsafe/memory"
import "abla/text"

// The direct backend owns one LLVM context and constructs every declaration,
// global, block, and instruction through LLVM's C API. Text is produced only
// as the serialized view of the finished, verified module.
class BootstrapLlvmBackend(
    val targetTriple: string,
    // Darwin ABI/syscall adapter; OS queries distinguish macOS from iOS.
    val macOS: bool,
    val valueArgumentsIndirect: bool,
    var constantScalarVarInitializers: bool,
    // Collection under allocation pressure: allocating functions call the
    // runtime's pressure check on entry (see bootstrapLlvmNeedsCollector).
    var pressureSafePoints: bool,
    val context: i64*,
    val module: i64*,
    val builder: i64*,
    val voidType: i64*,
    val i1Type: i64*,
    val i8Type: i64*,
    val i32Type: i64*,
    val i64Type: i64*,
    val f32Type: i64*,
    val f64Type: i64*,
    val pointerType: i64*,
    val payloadType: i64*,
    val valueType: i64*,
    val rootFrameType: i64*,
    // The TBAA access tags (bootstrapLlvmTagAccess), made with the context.
    val aliasKind: i32,
    val aliasSlot: i64*,
    val aliasRaw: i64*,
    val aliasStackValue: i64*,
    val aliasArrayHeader: i64*,
    val aliasArrayElement: i64*,
    // Immutable, context-owned attributes shared by declarations and calls.
    val sretAttribute: i64*,
    val byvalAttribute: i64*,
    val pointerScratch: i64*,
    // Static executable TLS can use the initial-exec model. Object/shared
    // outputs and externally named TLS keep their general-dynamic model.
    var executableTls: bool = false,
    var noPanicRecovery: bool = false
)

fun bootstrapLlvmBackend(targetTriple: string): BootstrapLlvmBackend {
    val context = LLVMContextCreate()
    // Held native fast codegen discards local IR names before emission anyway.
    // Keep names for text/release paths; DWARF variables use separate DI metadata.
    if (bootstrapLlvmStoreBoxes && bootstrapLlvmHoldModule) {
        LLVMContextSetDiscardValueNames(context, 1)
    }
    val module = LLVMModuleCreateWithNameInContext("abla", context)
    val builder = LLVMCreateBuilderInContext(context)
    val voidType = LLVMVoidTypeInContext(context)
    val i1Type = LLVMInt1TypeInContext(context)
    val i8Type = LLVMInt8TypeInContext(context)
    val i32Type = LLVMInt32TypeInContext(context)
    val i64Type = LLVMInt64TypeInContext(context)
    val f32Type = LLVMFloatTypeInContext(context)
    val f64Type = LLVMDoubleTypeInContext(context)
    val pointerType = LLVMPointerTypeInContext(context, 0)
    val payloadType = LLVMStructCreateNamed(context, "AblaPayload")
    val payloadFields = llvmPointerVector(2)
    var field = 0
    while (field < 2) {
        payloadFields.set(field, i64Type)
        field = field + 1
    }
    LLVMStructSetBody(payloadType, payloadFields.pointer(), 2, 0)
    payloadFields.drop()
    val valueType = LLVMStructCreateNamed(context, "AblaValue")
    val valueFields = llvmPointerVector(3)
    valueFields.set(0, i32Type)
    valueFields.set(1, i32Type)
    valueFields.set(2, payloadType)
    LLVMStructSetBody(valueType, valueFields.pointer(), 3, 0)
    valueFields.drop()
    val rootFrameType = LLVMStructCreateNamed(context, "AblaRootFrame")
    val rootFields = llvmPointerVector(3)
    rootFields.set(0, pointerType)
    rootFields.set(1, pointerType)
    rootFields.set(2, i64Type)
    LLVMStructSetBody(rootFrameType, rootFields.pointer(), 3, 0)
    rootFields.drop()
    BootstrapLlvmBackend(
        targetTriple,
        bootstrapTextContains(targetTriple, "apple-macos") ||
            bootstrapTextContains(targetTriple, "apple-darwin") ||
            bootstrapTextContains(targetTriple, "apple-ios"),
        bootstrapTextContains(targetTriple, "arm64-apple-macos") ||
            bootstrapTextContains(targetTriple, "aarch64-apple-macos") ||
            bootstrapTextContains(targetTriple, "arm64-apple-darwin") ||
            bootstrapTextContains(targetTriple, "aarch64-apple-darwin") ||
            bootstrapTextContains(targetTriple, "arm64-apple-ios") ||
            bootstrapTextContains(targetTriple, "aarch64-apple-ios"),
        false,
        false,
        context, module, builder, voidType, i1Type, i8Type, i32Type,
        i64Type, f32Type, f64Type, pointerType, payloadType, valueType,
        rootFrameType, LLVMGetMDKindIDInContext(context, "tbaa", i32(4)),
        bootstrapLlvmAliasTag(context, i64Type, "abla field slot"),
        bootstrapLlvmAliasTag(context, i64Type, "abla raw memory"),
        bootstrapLlvmAliasTag(context, i64Type, "abla stack value", "abla raw memory"),
        bootstrapLlvmAliasTag(context, i64Type, "abla dense array header", "abla raw memory"),
        bootstrapLlvmAliasTag(context, i64Type, "abla dense array element", "abla raw memory"),
        LLVMCreateTypeAttribute(context, bootstrapLlvmAttributeKind("sret"), valueType),
        LLVMCreateTypeAttribute(context, bootstrapLlvmAttributeKind("byval"), valueType),
        bootstrapLlvmCreatePointerScratch()
    )
}

// LLVM's opaque pointer type does not expose the target address width. Keep
// the small set of 32-bit triples in one target-neutral predicate so C ABI
// helpers use size_t rather than accidentally retaining the host's i64 ABI.
// (Asked for each instruction that may allocate: the last triple's answer is kept, as eight searches of it were 1% of
// emitting the client of #1022.)
var bootstrapLlvmPointerWidthTriple: string = ""
var bootstrapLlvmPointerWidthAnswer: bool = false

fun bootstrapLlvmTargetUses32BitPointers(targetTriple: string): bool {
    if (targetTriple != bootstrapLlvmPointerWidthTriple || targetTriple == "") {
        bootstrapLlvmPointerWidthAnswer = bootstrapLlvmTripleUses32BitPointers(targetTriple)
        bootstrapLlvmPointerWidthTriple = targetTriple
    }
    bootstrapLlvmPointerWidthAnswer
}

fun bootstrapLlvmTripleUses32BitPointers(targetTriple: string): bool =
    bootstrapTextContains(targetTriple, "xtensa") ||
    bootstrapTextContains(targetTriple, "riscv32") ||
    bootstrapTextContains(targetTriple, "thumb") ||
    bootstrapTextContains(targetTriple, "wasm32") ||
    bootstrapTextContains(targetTriple, "i386") ||
    bootstrapTextContains(targetTriple, "i486") ||
    bootstrapTextContains(targetTriple, "i586") ||
    bootstrapTextContains(targetTriple, "i686")

// LLVM's upstream optimizer does not register Espressif's out-of-tree Xtensa
// target, so a triple alone leaves the module without a data layout. In that
// state opaque-pointer arithmetic is optimized as if pointers were 64-bit and
// the final 32-bit backend must undo the resulting casts. This is the canonical
// layout emitted by Espressif Clang 21 for xtensa-esp-unknown-elf.
fun bootstrapLlvmTargetDataLayout(targetTriple: string): string {
    if (bootstrapTextContains(targetTriple, "xtensa")) {
        return "e-m:e-p:32:32-v1:8:8-i64:64-i128:128-n32"
    }
    return ""
}

// llvm.fma.f64 is one instruction on AArch64. Baseline x86-64 (the target CPU
// here) has no FMA3, where LLVM would call the C library's fma, and Wasm and
// the freestanding targets have no instruction either: abla/math computes a
// fused multiply-add in software on all of those.
// llvm.floor, ceil, trunc and roundeven are instructions on AArch64 (frint*)
// and Wasm (f64.floor and friends); baseline x86-64 needs SSE4.1's roundsd,
// so there the backend builds them from additions instead of letting LLVM call
// the C library.
fun bootstrapLlvmTargetHasRoundingInstructions(targetTriple: string): bool =
    !bootstrapTextContains(targetTriple, "x86_64")

fun bootstrapLlvmTargetHasFusedMultiplyAdd(targetTriple: string): bool =
    bootstrapTextContains(targetTriple, "aarch64") ||
    bootstrapTextContains(targetTriple, "arm64")

fun bootstrapLlvmTargetIsIOS(targetTriple: string): bool =
    bootstrapTextContains(targetTriple, "-apple-ios")

// Hosted programs can reach methods through runtime-owned reflection tables
// that are deliberately broader than the static call graph. Freestanding ELF,
// bare Wasm and non-hosted iOS libraries have explicit export boundaries.
// Initializers, runtime helpers, callbacks, drops and native addresses are roots.
fun bootstrapLlvmTargetHasClosedProgramBoundary(
    targetTriple: string
): bool = bootstrapTextContains(targetTriple, "unknown-elf") ||
    bootstrapTextContains(targetTriple, "unknown-none") ||
    bootstrapTextContains(targetTriple, "wasm32-unknown-unknown") ||
    bootstrapLlvmTargetIsWasi(targetTriple) ||
    bootstrapLlvmTargetIsIOS(targetTriple)

// A wasm32 target with no system interface (wasm32-unknown-unknown, a page's
// module): its system calls go to the browser host ABI
// (stdlib/abla/runtime/platform/wasm.ab).
fun bootstrapLlvmTargetIsBareWasm(targetTriple: string): bool =
    bootstrapTextContains(targetTriple, "wasm32") &&
    !bootstrapTextContains(targetTriple, "wasi")

fun bootstrapLlvmTargetIsWasi(targetTriple: string): bool =
    targetTriple == "wasm32-unknown-wasip1"

// An x86-64 Linux executable defines the C library's memory and string
// routines itself (#806: Abla should not require libc): LLVM lowers its
// memcpy/memmove/memset intrinsics, and comparisons it recognizes, to calls
// of these names, and the runtime reads argv and environment strings with
// strlen. They are module assembly, so LLVM's idiom recognition never sees a
// loop it could turn back into a call of the same name, and hidden, so they
// bind inside the executable only: shared libraries (libLLVM, OpenSSL) keep
// the C library's. Each is the C function's contract. memcpy is memmove, as
// glibc's is on x86-64, so a C caller that copies overlapping ranges with
// memcpy keeps working (no Abla runtime copy overlaps: #809 ran the stage
// builds and the suite with a memcpy that trapped on overlap). Abla's own copies
// (ablaUnsafeCopyMemory) are llvm.memmove all the same, so a copy of overlapping ranges is defined whatever its size
// is, and LLVM may not expand a small constant one as if the ranges were apart. Up to 64 bytes every byte is loaded before
// one is stored; a larger forward copy and a large fill use the string
// instructions (`rep movsb`/`rep stosb`; the direction flag is clear on entry
// by the ABI), a copy onto a later overlapping range goes backward in 32-byte
// blocks. Unit 0 alone keeps a split module's assembly
// (bootstrapCodegenUnitStrip), so each is defined once.
// The constant behind ablaHostOwnsRuntime() (#811): the target is one whose hosted runtime is
// the toolchain's own on the Linux kernel: its direct system calls, futex locks and Abla heap
// instead of libc's. x86-64 Linux today (neither Apple, whose triples differ, nor Android,
// whose bionic library loads ours, nor WebAssembly) and the executables of the aarch64-linux
// cross target, not other objects built for an AArch64 Linux triple. A library for aarch64 Android is the exception to
// the Android rule: it brings its own heap, locks, memory and system call routines, and takes nothing of bionic's but
// what the NDK's emulated TLS needs (#811).
fun bootstrapLlvmTargetOwnsRuntime(backend: BootstrapLlvmBackend): bool =
    !backend.macOS && bootstrapTextContains(backend.targetTriple, "linux") &&
    !bootstrapTextContains(backend.targetTriple, "wasm") &&
    ((!bootstrapTextContains(backend.targetTriple, "android") &&
      (bootstrapTextContains(backend.targetTriple, "x86_64") ||
       bootstrapLlvmAarch64LinuxExecutable(backend) ||
       bootstrapLlvmRiscv64LinuxExecutable(backend))) ||
     bootstrapLlvmAndroidArm64Library(backend)) ||
    bootstrapLlvmTargetIsWindows(backend.targetTriple)

fun bootstrapLlvmTargetIsWindows(targetTriple: string): bool =
    bootstrapTextContains(targetTriple, "windows") &&
    (targetTriple.startsWith("x86_64-") || targetTriple.startsWith("aarch64-"))

fun bootstrapLlvmTargetIsX8664Linux(targetTriple: string): bool =
    bootstrapTextContains(targetTriple, "x86_64") &&
    bootstrapTextContains(targetTriple, "linux")

// x86-64 numbers mapped to asm-generic Linux. A high bit names a layout or
// compatibility handler in the architecture dispatcher, or 0xffff for ENOSYS.
fun bootstrapLlvmLinuxGenericSyscallNumbers(): string {
    ".hword 63,64,32768,57,32769,32770,32771,32772,62,222,226,215,214,134,135,139\n" +
    ".hword 29,67,68,65,66,32773,32774,65535,124,216,227,232,233,194,196,195\n" +
    ".hword 23,32775,65535,101,102,65535,103,172,71,198,203,202,206,207,211,212\n" +
    ".hword 210,200,201,204,205,199,208,209,32789,32776,32776,221,93,260,129,160\n" +
    ".hword 190,193,191,197,186,189,188,187,25,32,82,83,45,46,65535,17\n" +
    ".hword 49,50,32777,32778,32779,65535,32780,32781,32782,32783,32784,52,32785,55,32786,166\n" +
    ".hword 169,163,165,179,153,117,174,116,176,146,144,175,177,154,173,32787\n" +
    ".hword 157,145,143,158,159,147,148,149,150,155,151,152,156,90,91,136\n" +
    ".hword 137,138,133,132,65535,65535,65535,92,65535,43,44,65535,141,140,118,121\n" +
    ".hword 119,120,125,126,127,228,229,230,231,58,65535,41,65535,167,65535,171\n" +
    ".hword 164,51,81,89,170,40,39,224,225,142,161,162,65535,65535,65535,105\n" +
    ".hword 106,65535,65535,60,42,65535,65535,65535,65535,65535,178,213,5,6,7,8\n" +
    ".hword 9,10,11,12,13,14,15,16,130,65535,98,122,123,65535,0,1\n" +
    ".hword 4,2,3,65535,18,32792,65535,65535,234,61,96,128,192,223,107,110\n" +
    ".hword 108,109,111,112,113,114,115,94,32793,32794,131,32788,65535,235,237,236\n" +
    ".hword 180,181,182,183,184,185,104,95,217,218,219,30,31,65535,27,28\n" +
    ".hword 238,32790,34,33,54,65535,32791,35,38,37,36,78,53,48,72,73\n" +
    ".hword 97,99,100,76,77,84,75,239,88,32795,65535,85,65535,47,86,87\n" +
    ".hword 242,74,19,20,24,59,26,69,70,240,241,243,262,263,261,264\n" +
    ".hword 265,266,267,269,268,168,270,271,272,273,274,275,276,277,278,279\n" +
    ".hword 294,280,281,282,283,284,285,286,287,288,289,290,291,292,293\n"
}

fun bootstrapLlvmAssemblyHiddenFunction(name: string): string =
    ".globl $name\n.hidden $name\n.type $name,@function\n"

// An executable for the cross target aarch64-linux: the objects another build defines for
// an AArch64 Linux triple (a freestanding guest with its own start-up and C stubs) keep
// libc's syscall.
fun bootstrapLlvmAarch64LinuxExecutable(backend: BootstrapLlvmBackend): bool =
    bootstrapLlvmAarch64Hosted && backend.executableTls &&
    bootstrapLlvmTargetIsAarch64Linux(backend.targetTriple)

var bootstrapLlvmRiscv64Hosted: bool = false

fun bootstrapLlvmRiscv64LinuxExecutable(backend: BootstrapLlvmBackend): bool =
    bootstrapLlvmRiscv64Hosted && backend.executableTls &&
    backend.targetTriple.startsWith("riscv64-") &&
    bootstrapTextContains(backend.targetTriple, "linux")

// A library for aarch64 Android (#811): loaded by bionic into a process that has its own start-up, TLS, threads and
// signal handlers, so it gets the system call translator, the memory and the jump routines (hidden, one copy per library)
// and nothing else of aarch64.ab.
fun bootstrapLlvmAndroidArm64Library(backend: BootstrapLlvmBackend): bool =
    !backend.executableTls && bootstrapTextContains(backend.targetTriple, "aarch64") &&
    bootstrapTextContains(backend.targetTriple, "android")

// Whether the system calls go by their x86-64 numbers to the module's abla_x64_syscall.
fun bootstrapLlvmTranslatedLinuxSyscalls(backend: BootstrapLlvmBackend): bool =
    bootstrapLlvmAarch64LinuxExecutable(backend) || bootstrapLlvmAndroidArm64Library(backend) ||
    bootstrapLlvmRiscv64LinuxExecutable(backend)

// The cross target aarch64-linux (aarch64-unknown-linux-gnu): not Android (a shared library
// loaded by bionic, whose start-up, TLS and threads are the host process's).
fun bootstrapLlvmTargetIsAarch64Linux(targetTriple: string): bool =
    bootstrapTextContains(targetTriple, "aarch64") &&
    bootstrapTextContains(targetTriple, "linux") &&
    !bootstrapTextContains(targetTriple, "android")

fun bootstrapLlvmLinuxMemoryRoutinesAssembly(): string {
    ".text\n.p2align 4\n" +
    bootstrapLlvmAssemblyHiddenFunction("memmove") +
    bootstrapLlvmAssemblyHiddenFunction("memcpy") +
    "memmove:\n" +
    "memcpy:\n" +
    "    movq %rdi, %rax\n" +
    "    cmpq \$64, %rdx\n" +
    "    jbe .Labla_mem_small\n" +
    "    cmpq \$256, %rdx\n" +
    "    jbe .Labla_mem_65\n" +
    "    movq %rdi, %rcx\n" +
    "    subq %rsi, %rcx\n" +
    "    cmpq %rdx, %rcx\n" +
    "    jae .Labla_mem_forward\n" +
    // The destination starts inside the source: 32-byte blocks from the end
    // (each loaded before it is stored, above every block still to load),
    // then the first 32 bytes, loaded before any store.
    "    movups (%rsi), %xmm4\n" +
    "    movups 16(%rsi), %xmm5\n" +
    "    leaq (%rsi,%rdx), %rsi\n" +
    "    leaq (%rdi,%rdx), %rcx\n" +
    ".Labla_mem_backward:\n" +
    "    movups -32(%rsi), %xmm0\n" +
    "    movups -16(%rsi), %xmm1\n" +
    "    movups %xmm0, -32(%rcx)\n" +
    "    movups %xmm1, -16(%rcx)\n" +
    "    subq \$32, %rsi\n" +
    "    subq \$32, %rcx\n" +
    "    subq \$32, %rdx\n" +
    "    cmpq \$32, %rdx\n" +
    "    ja .Labla_mem_backward\n" +
    "    movups %xmm4, (%rdi)\n" +
    "    movups %xmm5, 16(%rdi)\n" +
    "    ret\n" +
    ".Labla_mem_small:\n" +
    "    cmpq \$16, %rdx\n" +
    "    ja .Labla_mem_17\n" +
    "    cmpq \$8, %rdx\n" +
    "    jb .Labla_mem_lt8\n" +
    "    movq (%rsi), %rcx\n" +
    "    movq -8(%rsi,%rdx), %r8\n" +
    "    movq %rcx, (%rdi)\n" +
    "    movq %r8, -8(%rdi,%rdx)\n" +
    "    ret\n" +
    ".Labla_mem_lt8:\n" +
    "    cmpq \$4, %rdx\n" +
    "    jb .Labla_mem_lt4\n" +
    "    movl (%rsi), %ecx\n" +
    "    movl -4(%rsi,%rdx), %r8d\n" +
    "    movl %ecx, (%rdi)\n" +
    "    movl %r8d, -4(%rdi,%rdx)\n" +
    "    ret\n" +
    ".Labla_mem_lt4:\n" +
    "    testq %rdx, %rdx\n" +
    "    je .Labla_mem_done\n" +
    "    movq %rdx, %r9\n" +
    "    shrq %r9\n" +
    "    movzbl (%rsi), %ecx\n" +
    "    movzbl -1(%rsi,%rdx), %r8d\n" +
    "    movzbl (%rsi,%r9), %r10d\n" +
    "    movb %cl, (%rdi)\n" +
    "    movb %r8b, -1(%rdi,%rdx)\n" +
    "    movb %r10b, (%rdi,%r9)\n" +
    ".Labla_mem_done:\n" +
    "    ret\n" +
    ".Labla_mem_17:\n" +
    "    cmpq \$32, %rdx\n" +
    "    ja .Labla_mem_33\n" +
    "    movups (%rsi), %xmm0\n" +
    "    movups -16(%rsi,%rdx), %xmm1\n" +
    "    movups %xmm0, (%rdi)\n" +
    "    movups %xmm1, -16(%rdi,%rdx)\n" +
    "    ret\n" +
    ".Labla_mem_33:\n" +
    "    movups (%rsi), %xmm0\n" +
    "    movups 16(%rsi), %xmm1\n" +
    "    movups -32(%rsi,%rdx), %xmm2\n" +
    "    movups -16(%rsi,%rdx), %xmm3\n" +
    "    movups %xmm0, (%rdi)\n" +
    "    movups %xmm1, 16(%rdi)\n" +
    "    movups %xmm2, -32(%rdi,%rdx)\n" +
    "    movups %xmm3, -16(%rdi,%rdx)\n" +
    "    ret\n" +
    // 65 to 256 bytes: the first and the last 64 (or 128) bytes, all loaded before one is stored, so any overlap is safe.
    ".Labla_mem_65:\n" +
    "    cmpq \$128, %rdx\n" +
    "    ja .Labla_mem_129\n" +
    "    movups (%rsi), %xmm0\n" +
    "    movups 16(%rsi), %xmm1\n" +
    "    movups 32(%rsi), %xmm2\n" +
    "    movups 48(%rsi), %xmm3\n" +
    "    movups -64(%rsi,%rdx), %xmm4\n" +
    "    movups -48(%rsi,%rdx), %xmm5\n" +
    "    movups -32(%rsi,%rdx), %xmm6\n" +
    "    movups -16(%rsi,%rdx), %xmm7\n" +
    "    movups %xmm0, (%rdi)\n" +
    "    movups %xmm1, 16(%rdi)\n" +
    "    movups %xmm2, 32(%rdi)\n" +
    "    movups %xmm3, 48(%rdi)\n" +
    "    movups %xmm4, -64(%rdi,%rdx)\n" +
    "    movups %xmm5, -48(%rdi,%rdx)\n" +
    "    movups %xmm6, -32(%rdi,%rdx)\n" +
    "    movups %xmm7, -16(%rdi,%rdx)\n" +
    "    ret\n" +
    ".Labla_mem_129:\n" +
    "    movups (%rsi), %xmm0\n" +
    "    movups 16(%rsi), %xmm1\n" +
    "    movups 32(%rsi), %xmm2\n" +
    "    movups 48(%rsi), %xmm3\n" +
    "    movups 64(%rsi), %xmm4\n" +
    "    movups 80(%rsi), %xmm5\n" +
    "    movups 96(%rsi), %xmm6\n" +
    "    movups 112(%rsi), %xmm7\n" +
    "    movups -128(%rsi,%rdx), %xmm8\n" +
    "    movups -112(%rsi,%rdx), %xmm9\n" +
    "    movups -96(%rsi,%rdx), %xmm10\n" +
    "    movups -80(%rsi,%rdx), %xmm11\n" +
    "    movups -64(%rsi,%rdx), %xmm12\n" +
    "    movups -48(%rsi,%rdx), %xmm13\n" +
    "    movups -32(%rsi,%rdx), %xmm14\n" +
    "    movups -16(%rsi,%rdx), %xmm15\n" +
    "    movups %xmm0, (%rdi)\n" +
    "    movups %xmm1, 16(%rdi)\n" +
    "    movups %xmm2, 32(%rdi)\n" +
    "    movups %xmm3, 48(%rdi)\n" +
    "    movups %xmm4, 64(%rdi)\n" +
    "    movups %xmm5, 80(%rdi)\n" +
    "    movups %xmm6, 96(%rdi)\n" +
    "    movups %xmm7, 112(%rdi)\n" +
    "    movups %xmm8, -128(%rdi,%rdx)\n" +
    "    movups %xmm9, -112(%rdi,%rdx)\n" +
    "    movups %xmm10, -96(%rdi,%rdx)\n" +
    "    movups %xmm11, -80(%rdi,%rdx)\n" +
    "    movups %xmm12, -64(%rdi,%rdx)\n" +
    "    movups %xmm13, -48(%rdi,%rdx)\n" +
    "    movups %xmm14, -32(%rdi,%rdx)\n" +
    "    movups %xmm15, -16(%rdi,%rdx)\n" +
    "    ret\n" +
    // Forward (the ranges do not overlap, or the destination is below the source): 257 to 2048 bytes in 64-byte steps (each step
    // loads its 64 bytes before storing them, above nothing still to load), the last 64 bytes loaded first and stored last;
    // more by the string instruction.
    ".Labla_mem_forward:\n" +
    "    cmpq \$2048, %rdx\n" +
    "    ja .Labla_mem_rep\n" +
    "    movups -64(%rsi,%rdx), %xmm4\n" +
    "    movups -48(%rsi,%rdx), %xmm5\n" +
    "    movups -32(%rsi,%rdx), %xmm6\n" +
    "    movups -16(%rsi,%rdx), %xmm7\n" +
    "    leaq (%rdi,%rdx), %r8\n" +
    ".Labla_mem_step:\n" +
    "    movups (%rsi), %xmm0\n" +
    "    movups 16(%rsi), %xmm1\n" +
    "    movups 32(%rsi), %xmm2\n" +
    "    movups 48(%rsi), %xmm3\n" +
    "    movups %xmm0, (%rdi)\n" +
    "    movups %xmm1, 16(%rdi)\n" +
    "    movups %xmm2, 32(%rdi)\n" +
    "    movups %xmm3, 48(%rdi)\n" +
    "    addq \$64, %rsi\n" +
    "    addq \$64, %rdi\n" +
    "    subq \$64, %rdx\n" +
    "    cmpq \$64, %rdx\n" +
    "    ja .Labla_mem_step\n" +
    "    movups %xmm4, -64(%r8)\n" +
    "    movups %xmm5, -48(%r8)\n" +
    "    movups %xmm6, -32(%r8)\n" +
    "    movups %xmm7, -16(%r8)\n" +
    "    ret\n" +
    ".Labla_mem_rep:\n" +
    "    movq %rdx, %rcx\n" +
    "    rep movsb\n" +
    "    ret\n" +
    ".size memmove, .-memmove\n" +
    ".size memcpy, .-memcpy\n" +
    ".p2align 4\n" +
    bootstrapLlvmAssemblyHiddenFunction("memset") +
    "memset:\n" +
    "    movq %rdi, %rax\n" +
    "    movzbl %sil, %ecx\n" +
    "    movabsq \$0x0101010101010101, %r8\n" +
    "    imulq %r8, %rcx\n" +
    "    cmpq \$16, %rdx\n" +
    "    ja .Labla_set_17\n" +
    "    cmpq \$8, %rdx\n" +
    "    jb .Labla_set_lt8\n" +
    "    movq %rcx, (%rdi)\n" +
    "    movq %rcx, -8(%rdi,%rdx)\n" +
    "    ret\n" +
    ".Labla_set_lt8:\n" +
    "    cmpq \$4, %rdx\n" +
    "    jb .Labla_set_lt4\n" +
    "    movl %ecx, (%rdi)\n" +
    "    movl %ecx, -4(%rdi,%rdx)\n" +
    "    ret\n" +
    ".Labla_set_lt4:\n" +
    "    testq %rdx, %rdx\n" +
    "    je .Labla_set_done\n" +
    "    movq %rdx, %r9\n" +
    "    shrq %r9\n" +
    "    movb %cl, (%rdi)\n" +
    "    movb %cl, -1(%rdi,%rdx)\n" +
    "    movb %cl, (%rdi,%r9)\n" +
    ".Labla_set_done:\n" +
    "    ret\n" +
    ".Labla_set_17:\n" +
    "    movq %rcx, %xmm0\n" +
    "    punpcklqdq %xmm0, %xmm0\n" +
    "    cmpq \$32, %rdx\n" +
    "    ja .Labla_set_33\n" +
    "    movups %xmm0, (%rdi)\n" +
    "    movups %xmm0, -16(%rdi,%rdx)\n" +
    "    ret\n" +
    ".Labla_set_33:\n" +
    "    cmpq \$64, %rdx\n" +
    "    ja .Labla_set_65\n" +
    "    movups %xmm0, (%rdi)\n" +
    "    movups %xmm0, 16(%rdi)\n" +
    "    movups %xmm0, -32(%rdi,%rdx)\n" +
    "    movups %xmm0, -16(%rdi,%rdx)\n" +
    "    ret\n" +
    // 65 to 256 bytes: the first and the last 64 (or 128) bytes, overlapping in the middle.
    ".Labla_set_65:\n" +
    "    cmpq \$256, %rdx\n" +
    "    ja .Labla_set_large\n" +
    "    movups %xmm0, (%rdi)\n" +
    "    movups %xmm0, 16(%rdi)\n" +
    "    movups %xmm0, 32(%rdi)\n" +
    "    movups %xmm0, 48(%rdi)\n" +
    "    movups %xmm0, -64(%rdi,%rdx)\n" +
    "    movups %xmm0, -48(%rdi,%rdx)\n" +
    "    movups %xmm0, -32(%rdi,%rdx)\n" +
    "    movups %xmm0, -16(%rdi,%rdx)\n" +
    "    cmpq \$128, %rdx\n" +
    "    jbe .Labla_set_65_done\n" +
    "    movups %xmm0, 64(%rdi)\n" +
    "    movups %xmm0, 80(%rdi)\n" +
    "    movups %xmm0, 96(%rdi)\n" +
    "    movups %xmm0, 112(%rdi)\n" +
    "    movups %xmm0, -128(%rdi,%rdx)\n" +
    "    movups %xmm0, -112(%rdi,%rdx)\n" +
    "    movups %xmm0, -96(%rdi,%rdx)\n" +
    "    movups %xmm0, -80(%rdi,%rdx)\n" +
    ".Labla_set_65_done:\n" +
    "    ret\n" +
    ".Labla_set_large:\n" +
    "    movq %rdi, %r9\n" +
    "    movl %ecx, %eax\n" +
    "    movq %rdx, %rcx\n" +
    "    rep stosb\n" +
    "    movq %r9, %rax\n" +
    "    ret\n" +
    ".size memset, .-memset\n" +
    ".p2align 4\n" +
    bootstrapLlvmAssemblyHiddenFunction("memcmp") +
    bootstrapLlvmAssemblyHiddenFunction("bcmp") +
    "memcmp:\n" +
    "bcmp:\n" +
    "    cmpq \$8, %rdx\n" +
    "    jb .Labla_cmp_bytes\n" +
    ".Labla_cmp_words:\n" +
    "    movq (%rdi), %rax\n" +
    "    movq (%rsi), %rcx\n" +
    "    cmpq %rcx, %rax\n" +
    "    jne .Labla_cmp_word_differs\n" +
    "    addq \$8, %rdi\n" +
    "    addq \$8, %rsi\n" +
    "    subq \$8, %rdx\n" +
    "    cmpq \$8, %rdx\n" +
    "    jae .Labla_cmp_words\n" +
    ".Labla_cmp_bytes:\n" +
    "    testq %rdx, %rdx\n" +
    "    je .Labla_cmp_equal\n" +
    ".Labla_cmp_byte:\n" +
    "    movzbl (%rdi), %eax\n" +
    "    movzbl (%rsi), %ecx\n" +
    "    subl %ecx, %eax\n" +
    "    jne .Labla_cmp_done\n" +
    "    incq %rdi\n" +
    "    incq %rsi\n" +
    "    decq %rdx\n" +
    "    jne .Labla_cmp_byte\n" +
    ".Labla_cmp_equal:\n" +
    "    xorl %eax, %eax\n" +
    ".Labla_cmp_done:\n" +
    "    ret\n" +
    // The first differing byte is the lowest differing one (little endian);
    // the result is the difference of those bytes, as glibc's.
    ".Labla_cmp_word_differs:\n" +
    "    xorq %rax, %rcx\n" +
    "    bsfq %rcx, %rcx\n" +
    "    shrq \$3, %rcx\n" +
    "    movzbl (%rdi,%rcx), %eax\n" +
    "    movzbl (%rsi,%rcx), %edx\n" +
    "    subl %edx, %eax\n" +
    "    ret\n" +
    ".size memcmp, .-memcmp\n" +
    ".size bcmp, .-bcmp\n" +
    ".p2align 4\n" +
    bootstrapLlvmAssemblyHiddenFunction("strlen") +
    "strlen:\n" +
    // 16 bytes at a step from the 16-byte block holding the start (an aligned load never crosses a page, so it never reads
    // past the string's own page); the bytes before the start are shifted out of the first mask.
    "    movq %rdi, %rax\n" +
    "    andq \$-16, %rax\n" +
    "    pxor %xmm0, %xmm0\n" +
    "    movdqa (%rax), %xmm1\n" +
    "    pcmpeqb %xmm0, %xmm1\n" +
    "    pmovmskb %xmm1, %edx\n" +
    "    movl %edi, %ecx\n" +
    "    andl \$15, %ecx\n" +
    "    shrl %cl, %edx\n" +
    "    testl %edx, %edx\n" +
    "    jz .Labla_strlen_next\n" +
    "    bsfl %edx, %eax\n" +
    "    ret\n" +
    ".Labla_strlen_next:\n" +
    "    addq \$16, %rax\n" +
    "    movdqa (%rax), %xmm1\n" +
    "    pcmpeqb %xmm0, %xmm1\n" +
    "    pmovmskb %xmm1, %edx\n" +
    "    testl %edx, %edx\n" +
    "    jz .Labla_strlen_next\n" +
    "    bsfl %edx, %edx\n" +
    "    addq %rdx, %rax\n" +
    "    subq %rdi, %rax\n" +
    "    ret\n" +
    ".size strlen, .-strlen\n"
}

// Set by the toolchain while it builds a hosted x86-64 Linux executable
// (bootstrapNativeBuildWithEmitterStateCache), and only then: a module ORC JITs in process must
// not define them (LLJIT refuses definitions its IR does not declare, and
// the compiler process has the C library's).
var bootstrapLlvmOwnMemoryRoutines = false
var bootstrapLlvmFastRuntimeExports: array<string> = []
// An x86-64 Linux shared library defines the memory and jump routines (not the entry or thread routines).
var bootstrapLlvmLibraryRoutines = false

// An x86-64 Linux executable linked without libc (#806) creates and joins its
// threads itself: the libc-free link (toolchain.ab) binds the runtime's
// pthread_create and pthread_join (platform/host.ab) to these two with
// --defsym; a hosted link uses libpthread's and drops these (each has its own
// section). Its locks are futexes already. abla_clone_create(handle,
// attributes ignored, entry, argument) maps, in one region: a guard page, a
// stack the size of the soft stack limit (prlimit64; 8 MiB when unlimited or
// under 64 KiB), a 64 KiB alternate signal stack, the TLS block
// (abla_tls_bytes/abla_tls_init from the saved program headers) and a control
// page: tid word, region base and size, entry, argument, signal stack. clone
// with CLONE_VM|FS|FILES|SIGHAND|THREAD|SYSVSEM|SETTLS|PARENT_SETTID|
// CHILD_CLEARTID: the child installs its signal stack, calls entry(argument)
// and exits that thread only. *handle is the control page. abla_clone_join
// waits on the tid word, which the kernel clears (and wakes) when the thread
// has left its stack, then unmaps the region. Both return 0 or a positive
// errno, as libpthread's. A raw clone thread can't run C library code, so a
// hosted program never uses them.
fun bootstrapLlvmLinuxThreadRoutinesAssembly(): string =
    ".section .text.abla_clone_create,\"ax\",@progbits\n.p2align 4\n" +
    bootstrapLlvmAssemblyHiddenFunction("abla_clone_create") +
    "abla_clone_create:\n" +
    "    pushq %rbx\n" +
    "    pushq %rbp\n" +
    "    pushq %r12\n" +
    "    pushq %r13\n" +
    "    pushq %r14\n" +
    "    pushq %r15\n" +
    "    subq \$24, %rsp\n" +
    "    movq %rdi, %r12\n" +
    "    movq %rdx, %r13\n" +
    "    movq %rcx, %r14\n" +
    "    xorl %edi, %edi\n" +
    "    movl \$3, %esi\n" +
    "    xorl %edx, %edx\n" +
    "    movq %rsp, %r10\n" +
    "    movl \$302, %eax\n" +
    "    syscall\n" +
    "    movq (%rsp), %rbx\n" +
    "    testq %rax, %rax\n" +
    "    jnz .Labla_thread_default\n" +
    "    cmpq \$-1, %rbx\n" +
    "    je .Labla_thread_default\n" +
    "    cmpq \$65536, %rbx\n" +
    "    jae .Labla_thread_sized\n" +
    ".Labla_thread_default:\n" +
    "    movl \$8388608, %ebx\n" +
    ".Labla_thread_sized:\n" +
    "    addq \$4095, %rbx\n" +
    "    andq \$-4096, %rbx\n" +
    "    movq abla_start_phdr(%rip), %rdi\n" +
    "    movq abla_start_phnum(%rip), %rsi\n" +
    "    callq abla_tls_bytes\n" +
    "    testq %rax, %rax\n" +
    "    js .Labla_thread_invalid\n" +
    "    addq \$4095, %rax\n" +
    "    andq \$-4096, %rax\n" +
    "    movq %rax, %r15\n" +
    "    leaq (%rbx,%r15), %rsi\n" +
    "    addq \$73728, %rsi\n" +
    "    movq %rsi, 8(%rsp)\n" +
    "    xorl %edi, %edi\n" +
    "    movl \$3, %edx\n" +
    "    movl \$131106, %r10d\n" +
    "    movq \$-1, %r8\n" +
    "    xorl %r9d, %r9d\n" +
    "    movl \$9, %eax\n" +
    "    syscall\n" +
    "    cmpq \$-4095, %rax\n" +
    "    jae .Labla_thread_errno\n" +
    "    movq %rax, %rbp\n" +
    "    movq %rbp, %rdi\n" +
    "    movl \$4096, %esi\n" +
    "    xorl %edx, %edx\n" +
    "    movl \$10, %eax\n" +
    "    syscall\n" +
    "    movq 8(%rsp), %rax\n" +
    "    leaq -4096(%rbp,%rax), %rcx\n" +
    "    movq %rbp, 8(%rcx)\n" +
    "    movq %rax, 16(%rcx)\n" +
    "    movq %r13, 24(%rcx)\n" +
    "    movq %r14, 32(%rcx)\n" +
    "    leaq 4096(%rbp,%rbx), %rdx\n" +
    "    movq %rdx, 40(%rcx)\n" +
    "    movq %rcx, %r13\n" +
    "    leaq 65536(%rdx), %rdi\n" +
    "    movq abla_start_phdr(%rip), %rsi\n" +
    "    movq abla_start_phnum(%rip), %rdx\n" +
    "    movq abla_start_random(%rip), %rcx\n" +
    "    callq abla_tls_init\n" +
    "    movq %rax, %r8\n" +
    "    leaq 4096(%rbp,%rbx), %rsi\n" +
    "    subq \$16, %rsi\n" +
    "    movq %r13, (%rsi)\n" +
    "    movl \$4001536, %edi\n" +
    "    movq %r13, %rdx\n" +
    "    movq %r13, %r10\n" +
    "    movl \$56, %eax\n" +
    "    syscall\n" +
    "    testq %rax, %rax\n" +
    "    jz .Labla_thread_child\n" +
    "    js .Labla_thread_clone_failed\n" +
    "    movq %r13, (%r12)\n" +
    "    xorl %eax, %eax\n" +
    "    jmp .Labla_thread_return\n" +
    ".Labla_thread_child:\n" +
    "    xorl %ebp, %ebp\n" +
    "    movq (%rsp), %rbx\n" +
    "    subq \$32, %rsp\n" +
    "    movq 40(%rbx), %rax\n" +
    "    movq %rax, (%rsp)\n" +
    "    movq \$0, 8(%rsp)\n" +
    "    movq \$65536, 16(%rsp)\n" +
    "    movq %rsp, %rdi\n" +
    "    xorl %esi, %esi\n" +
    "    movl \$131, %eax\n" +
    "    syscall\n" +
    "    addq \$32, %rsp\n" +
    "    movq 32(%rbx), %rdi\n" +
    "    callq *24(%rbx)\n" +
    ".Labla_thread_exit:\n" +
    "    xorl %edi, %edi\n" +
    "    movl \$60, %eax\n" +
    "    syscall\n" +
    "    jmp .Labla_thread_exit\n" +
    ".Labla_thread_clone_failed:\n" +
    "    negq %rax\n" +
    "    movq %rax, %r12\n" +
    "    movq %rbp, %rdi\n" +
    "    movq 8(%rsp), %rsi\n" +
    "    movl \$11, %eax\n" +
    "    syscall\n" +
    "    movq %r12, %rax\n" +
    "    jmp .Labla_thread_return\n" +
    ".Labla_thread_errno:\n" +
    "    negq %rax\n" +
    "    jmp .Labla_thread_return\n" +
    ".Labla_thread_invalid:\n" +
    "    movl \$22, %eax\n" +
    ".Labla_thread_return:\n" +
    "    addq \$24, %rsp\n" +
    "    popq %r15\n" +
    "    popq %r14\n" +
    "    popq %r13\n" +
    "    popq %r12\n" +
    "    popq %rbp\n" +
    "    popq %rbx\n" +
    "    ret\n" +
    ".size abla_clone_create, .-abla_clone_create\n" +
    ".section .text.abla_clone_join,\"ax\",@progbits\n.p2align 4\n" +
    bootstrapLlvmAssemblyHiddenFunction("abla_clone_join") +
    "abla_clone_join:\n" +
    "    pushq %rbx\n" +
    "    movq %rdi, %rbx\n" +
    ".Labla_join_wait:\n" +
    "    movl (%rbx), %edx\n" +
    "    testl %edx, %edx\n" +
    "    jz .Labla_join_done\n" +
    "    movq %rbx, %rdi\n" +
    "    xorl %esi, %esi\n" +
    "    xorl %r10d, %r10d\n" +
    "    movl \$202, %eax\n" +
    "    syscall\n" +
    "    jmp .Labla_join_wait\n" +
    ".Labla_join_done:\n" +
    "    movq 8(%rbx), %rdi\n" +
    "    movq 16(%rbx), %rsi\n" +
    "    movl \$11, %eax\n" +
    "    syscall\n" +
    "    xorl %eax, %eax\n" +
    "    popq %rbx\n" +
    "    ret\n" +
    ".size abla_clone_join, .-abla_clone_join\n" +
    ".text\n"

fun bootstrapLlvmEmitLinuxThreadRoutines(backend: BootstrapLlvmBackend): void {
    val assembly = bootstrapLlvmLinuxThreadRoutinesAssembly()
    LLVMAppendModuleInlineAsm(backend.module, assembly, assembly.size)
    return
}

fun bootstrapLlvmEmitLinuxMemoryRoutines(backend: BootstrapLlvmBackend): void {
    val assembly = bootstrapLlvmLinuxMemoryRoutinesAssembly()
    LLVMAppendModuleInlineAsm(backend.module, assembly, assembly.size)
    return
}

// ---- macOS (#811): the memory and C-runtime routines of a Mach-O executable ----
// A macOS executable defines memcpy, memmove, memset, memcmp, bcmp, strlen, strcmp, memchr and
// bzero itself (hidden: `.private_extern`, so the executable binds its own copy and libSystem keeps
// the process's), from the x86-64 Linux routines and the AArch64 ones above, rewritten for Mach-O:
// the names take the underscore, `.hidden` becomes `.private_extern`, the ELF `.type` and `.size`
// directives go. Only an ahead-of-time executable or dylib gets them (the flag is set by the toolchain, #833);
// the compiler's in-process JIT keeps libSystem's.
var bootstrapLlvmOwnMachORoutines = false

// `ablac run --live` (live.ab): set around the program's build; only a module with `main` takes it.
// The generation is 0 for the program as it starts and N for the Nth reload's build.
var bootstrapLlvmLiveRun = false
var bootstrapLlvmLiveGeneration = 0
// The runtime id of each function the running program has, by symbol (live.ab records them): a reload keeps
// them, and gives a function it adds an id none of them has (bootstrapLlvmFunctionIdentities). A function
// value the running code made holds its id, so an id that moved would call another body.
var bootstrapLlvmLiveRuntimeIds: Map<string, int> = Map()
var bootstrapLlvmLiveRuntimeIdsTaken: Map<int, int> = Map()

// The C symbols of the module's `@hostImport` declarations (the loading application defines them), set at the start
// of a program's emission: the toolchain lets a macOS dylib leave them undefined (-U) and keeps the list with a
// cached object.
var bootstrapLlvmHostImportSymbols: array<string> = []

// A macOS triple as the compiler names it ("-apple-macosx11.0.0") or as LLVM names the host the compile-time JIT runs on
// ("arm64-apple-darwin24.1.0"): both are macOS, and the JIT module must take the same dispatcher and system-call
// lowering as the program, or its heap would map memory through the C adapter (#811).
fun bootstrapLlvmTriplePlainMacOS(targetTriple: string): bool =
    bootstrapTextContains(targetTriple, "macosx") || bootstrapTextContains(targetTriple,
        "apple-darwin")

fun bootstrapLlvmTargetIsMacOS(targetTriple: string): bool =
    bootstrapTextContains(targetTriple, "macosx") &&
    (bootstrapTextContains(targetTriple, "x86_64") ||
     bootstrapTextContains(targetTriple, "arm64") ||
     bootstrapTextContains(targetTriple, "aarch64"))

fun bootstrapLlvmMachOIsArm(targetTriple: string): bool = !bootstrapTextContains(targetTriple,
    "x86_64")

fun bootstrapLlvmMachORoutineName(name: string): bool =
    name == "memmove" || name == "memcpy" || name == "memset" || name == "memcmp" ||
    name == "bcmp" || name == "strlen" || name == "_setjmp" || name == "_longjmp"

// A function's `@section` name for the target. ELF takes it as written. Mach-O names a section by segment and section
// ("__TEXT,__name"; the section name is 16 characters with its "__"), so a name in the ELF style maps by one rule:
// ".text.NAME" becomes "__TEXT,__NAME,regular,pure_instructions" (code), any other ".kind.NAME" "__DATA,__NAME";
// dots in NAME become underscores and NAME is cut to 14 characters. A name with a comma is already a Mach-O specifier
// and stays as it is.
fun bootstrapLlvmFunctionSection(backend: BootstrapLlvmBackend, section: string): string {
    if (!backend.macOS || bootstrapTextContains(section,
        ",") || !section.startsWith(".")) return section
    val code = section.startsWith(".text.")
    val first = section.indexOf(".", 1)
    var name = ""
    var index = if (first < 0) 1 else first + 1
    while (index < section.size && name.size < 14) {
        val character = section.slice(index, index + 1)
        name = name + (if (character == ".") "_" else character)
        index = index + 1
    }
    if (code) "__TEXT,__" + name + ",regular,pure_instructions" else "__DATA,__" + name
}

// An ELF assembly text of those routines as Mach-O assembly (see above).
fun bootstrapLlvmMachOAssembly(text: string): string {
    var result = ""
    var start = 0
    while (start < text.size) {
        var end = text.indexOf("\n", start)
        if (end < 0) end = text.size
        // ".L" is not an assembler-private prefix on Mach-O ("L" is): a ".Labla_x" label would be a symbol, an atom the
        // linker may dead-strip when only the code before it falls into it.
        val line = text.slice(start, end).replace(".Labla_", "Labla_")
        start = end + 1
        if (line.startsWith(".type ") || line.startsWith(".size ")) continue
        if (line.startsWith(".globl ")) {
            result = result + ".globl _" + line.slice(7, line.size) + "\n"
        } else if (line.startsWith(".hidden ")) {
            result = result + ".private_extern _" + line.slice(8, line.size) + "\n"
        } else if (line.endsWith(":") && bootstrapLlvmMachORoutineName(line.slice(0,
            line.size - 1))) {
            result = result + "_" + line + "\n"
        } else if (line.endsWith(" memcpy") && line.startsWith("    b.ls ")) {
            // A conditional branch cannot reach an external symbol on Mach-O: the inverse over a plain branch.
            result = result + "    b.hi 7f\n    b _memcpy\n7:\n"
        } else if (line.endsWith(" memcpy") && line.startsWith("    b.hs ")) {
            result = result + "    b.lo 7f\n    b _memcpy\n7:\n"
        } else if (line.endsWith(" memcpy")) {
            result = result + line.slice(0, line.size - 6) + "_memcpy\n"
        } else result = result + line + "\n"
    }
    result
}

// strcmp, memchr and bzero (and LLVM's __bzero on Darwin x86-64), plain byte loops.
fun bootstrapLlvmMachOExtraAssembly(arm: bool): string {
    if (arm) return ".text\n.p2align 2\n" +
        ".globl _strcmp\n.private_extern _strcmp\n_strcmp:\n" +
        "0:  ldrb w2, [x0], #1\n    ldrb w3, [x1], #1\n    subs w2, w2, w3\n    b.ne 1f\n    cbnz w3, 0b\n" +
        "1:  mov w0, w2\n    ret\n" +
        ".globl _memchr\n.private_extern _memchr\n_memchr:\n" +
        "    and w1, w1, #0xff\n" +
        "0:  cbz x2, 2f\n    ldrb w3, [x0]\n    cmp w3, w1\n    b.eq 1f\n    add x0, x0, #1\n    sub x2, x2, #1\n    b 0b\n" +
        "2:  mov x0, #0\n1:  ret\n" +
        ".globl _bzero\n.private_extern _bzero\n_bzero:\n" +
        "    mov x2, x1\n    mov w1, #0\n    b _memset\n" +
        ".globl ___bzero\n.private_extern ___bzero\n___bzero:\n" +
        "    mov x2, x1\n    mov w1, #0\n    b _memset\n"
    ".text\n.p2align 4\n" +
        ".globl _strcmp\n.private_extern _strcmp\n_strcmp:\n" +
        "0:  movzbl (%rdi), %eax\n    movzbl (%rsi), %ecx\n    subl %ecx, %eax\n    jne 1f\n" +
        "    incq %rdi\n    incq %rsi\n    testl %ecx, %ecx\n    jne 0b\n" +
        "1:  ret\n" +
        ".globl _memchr\n.private_extern _memchr\n_memchr:\n" +
        "    movzbl %sil, %esi\n" +
        "0:  testq %rdx, %rdx\n    je 2f\n    movzbl (%rdi), %eax\n    cmpl %esi, %eax\n    je 1f\n" +
        "    incq %rdi\n    decq %rdx\n    jmp 0b\n" +
        "2:  xorl %edi, %edi\n1:  movq %rdi, %rax\n    ret\n" +
        ".globl _bzero\n.private_extern _bzero\n_bzero:\n" +
        ".globl ___bzero\n.private_extern ___bzero\n___bzero:\n" +
        "    movq %rsi, %rdx\n    xorl %esi, %esi\n    jmp _memset\n"
}

// _setjmp and _longjmp, defined the same way (hidden module assembly of an
// x86-64 Linux executable), in glibc's own jmp_buf format so that a buffer set
// by one and left by the other still works: the compiler's native code is built
// with these, but the code ORC JITs in its process resolves the C library's.
// __jmp_buf is rbx, rbp, r12, r13, r14, r15, rsp, pc (words 0 to 7), with rbp,
// rsp and pc mangled by the pointer guard (`xor %fs:0x30` then rotate left 17,
// undone the other way round) and the mask-saved flag at offset 64 left 0: no
// signal mask is saved or restored. rsp is the caller's stack pointer after the
// return, pc the return address; _longjmp returns its value, or 1 for 0.
fun bootstrapLlvmLinuxJumpRoutinesAssembly(): string {
    ".text\n.p2align 4\n" +
    bootstrapLlvmAssemblyHiddenFunction("_setjmp") +
    "_setjmp:\n" +
    "    movq %rbx, (%rdi)\n" +
    "    movq %rbp, %rax\n" +
    "    xorq %fs:0x30, %rax\n" +
    "    rolq \$0x11, %rax\n" +
    "    movq %rax, 8(%rdi)\n" +
    "    movq %r12, 16(%rdi)\n" +
    "    movq %r13, 24(%rdi)\n" +
    "    movq %r14, 32(%rdi)\n" +
    "    movq %r15, 40(%rdi)\n" +
    "    leaq 8(%rsp), %rdx\n" +
    "    xorq %fs:0x30, %rdx\n" +
    "    rolq \$0x11, %rdx\n" +
    "    movq %rdx, 48(%rdi)\n" +
    "    movq (%rsp), %rax\n" +
    "    xorq %fs:0x30, %rax\n" +
    "    rolq \$0x11, %rax\n" +
    "    movq %rax, 56(%rdi)\n" +
    "    movl \$0, 64(%rdi)\n" +
    "    xorl %eax, %eax\n" +
    "    ret\n" +
    ".size _setjmp, .-_setjmp\n" +
    ".p2align 4\n" +
    bootstrapLlvmAssemblyHiddenFunction("_longjmp") +
    "_longjmp:\n" +
    "    movq (%rdi), %rbx\n" +
    "    movq 8(%rdi), %rbp\n" +
    "    rorq \$0x11, %rbp\n" +
    "    xorq %fs:0x30, %rbp\n" +
    "    movq 16(%rdi), %r12\n" +
    "    movq 24(%rdi), %r13\n" +
    "    movq 32(%rdi), %r14\n" +
    "    movq 40(%rdi), %r15\n" +
    "    movq 48(%rdi), %rdx\n" +
    "    rorq \$0x11, %rdx\n" +
    "    xorq %fs:0x30, %rdx\n" +
    "    movq 56(%rdi), %rcx\n" +
    "    rorq \$0x11, %rcx\n" +
    "    xorq %fs:0x30, %rcx\n" +
    "    movl %esi, %eax\n" +
    "    testl %eax, %eax\n" +
    "    jne .Labla_jump_go\n" +
    "    incl %eax\n" +
    ".Labla_jump_go:\n" +
    "    movq %rdx, %rsp\n" +
    "    jmp *%rcx\n" +
    ".size _longjmp, .-_longjmp\n"
}

fun bootstrapLlvmEmitLinuxJumpRoutines(backend: BootstrapLlvmBackend): void {
    val assembly = bootstrapLlvmLinuxJumpRoutinesAssembly()
    LLVMAppendModuleInlineAsm(backend.module, assembly, assembly.size)
    return
}

fun BootstrapLlvmBackend.nativeSizeType(): i64* =
    if (bootstrapLlvmTargetUses32BitPointers(this.targetTriple)) {
    this.i32Type
} else this.i64Type

fun BootstrapLlvmBackend.type(code: string): i64* {
    var result = this.pointerType
    if (code == "void") result = this.voidType
    if (code == "i1" || code == "bool") result = this.i1Type
    if (code == "i8" || code == "u8" || code == "char") {
        result = this.i8Type
    }
    if (code == "i16" || code == "u16") {
        result = LLVMIntTypeInContext(this.context, 16)
    }
    if (code == "i32" || code == "u32") result = this.i32Type
    if (code == "i64" || code == "u64" || code == "int") {
        result = this.i64Type
    }
    if (code == "f32") result = this.f32Type
    if (code == "f64") result = this.f64Type
    if (bootstrapIsVectorType(code)) result = bootstrapLlvmVectorType(this, code)
    if (bootstrapIsWideIntType(code)) result = LLVMIntTypeInContext(this.context,
        i32(bootstrapWideIntBits(code)))
    result
}

// LLVM copies operand/type arrays before returning (the previous vectors
// were freed immediately). Emission is sequential within a backend. Keep a
// small native buffer across calls; larger signatures get a temporary one.
val BOOTSTRAP_LLVM_POINTER_SCRATCH = 16

trusted fun bootstrapLlvmCreatePointerScratch(): i64* =
    ablaUnsafeAllocate(BOOTSTRAP_LLVM_POINTER_SCRATCH * 8)

trusted fun bootstrapLlvmDropPointerScratch(backend: BootstrapLlvmBackend): void {
    ablaUnsafeFree(backend.pointerScratch)
    return
}

trusted fun bootstrapLlvmPointerArguments(
    backend: BootstrapLlvmBackend, arguments: array<i64*>
): i64* {
    val count = arguments.size
    val values = if (count <= BOOTSTRAP_LLVM_POINTER_SCRATCH) backend.pointerScratch
        else ablaUnsafeAllocate(count * 8)
    var index = 0
    while (index < count) {
        ablaUnsafeStorePointer(ablaUnsafePointerOffset(values, index * 8), arguments[index])
        index = index + 1
    }
    values
}

trusted fun bootstrapLlvmDropPointerArguments(
    backend: BootstrapLlvmBackend, values: i64*
): void {
    if (values != backend.pointerScratch) ablaUnsafeFree(values)
    return
}

fun bootstrapLlvmFunctionType(
    backend: BootstrapLlvmBackend,
    result: i64*,
    parameters: array<i64*>
): i64* {
    val types = bootstrapLlvmPointerArguments(backend, parameters)
    val resultType = LLVMFunctionType(result, types, i32(parameters.size), 0)
    bootstrapLlvmDropPointerArguments(backend, types)
    resultType
}

noescape extern:"c" fun LLVMMDStringInContext2(context: i64*, text: cstring, length: int): i64*
noescape extern:"c" fun LLVMMDNodeInContext2(context: i64*, nodes: i64*, count: int): i64*
noescape extern:"c" fun LLVMMetadataAsValue(context: i64*, metadata: i64*): i64*
noescape extern:"c" fun LLVMGetMDKindIDInContext(context: i64*, name: cstring, length: i32): i32
noescape extern:"c" fun LLVMSetMetadata(value: i64*, kind: i32, node: i64*): void
noescape extern:"c" fun LLVMAddNamedMetadataOperand(module: i64*, name: cstring, node: i64*): void
noescape extern:"c" fun LLVMGetNamedMetadataNumOperands(module: i64*, name: cstring): i32

val BOOTSTRAP_LLVM_SMALL_LOOP_NEST = "abla.small_loop_nest"
val BOOTSTRAP_LLVM_RECURSIVE_CLASS_ARGUMENT = "abla.recursive_class_argument"
var bootstrapLlvmDetectReleaseOptimizations = false

// Two kinds of memory that never overlap, as TBAA access tags under one root:
// a declared field's slot, which only the runtime's typed field accessors
// touch through ablaRuntimeLoadSlot*/StoreSlot*, and the raw memory programs
// reach through abla/unsafe (a column's bytes), along with checked reads in
// array storage and loads from compiler-owned stack slots. Raw addresses
// come from raw, C, stack and static allocations and string bytes; nothing outside the
// runtime can take an object's address. Every other access (the collector,
// by-name field access, extension fields, value cells) has neither tag and
// may alias both. Each backend makes its tags with its own context: metadata
// never outlives the context it belongs to, and compile-time evaluation makes
// and disposes contexts all the time. Compiler-owned value slots, dense array
// headers and dense array payload elements occupy disjoint regions. They are
// children of raw memory so a general raw access can still alias any of them.

fun bootstrapLlvmMetadataNode(context: i64*, nodes: array<i64*>): i64* {
    val vector = llvmPointerVector(nodes.size)
    for (index in 0 until nodes.size) vector.set(index, nodes[index])
    val node = LLVMMDNodeInContext2(context, vector.pointer(), nodes.size)
    vector.drop()
    node
}

fun bootstrapLlvmAliasTag(
    context: i64*, i64Type: i64*, name: string, parentName: string = ""
): i64* {
    val rootName = "abla memory"
    val root = bootstrapLlvmMetadataNode(
        context, [LLVMMDStringInContext2(context, rootName, rootName.size)]
    )
    val zero = LLVMValueAsMetadata(LLVMConstInt(i64Type, 0, 0))
    val parent = if (parentName == "") root else bootstrapLlvmMetadataNode(
        context, [LLVMMDStringInContext2(context, parentName, parentName.size), root, zero]
    )
    val type = bootstrapLlvmMetadataNode(
        context, [LLVMMDStringInContext2(context, name, name.size), parent, zero]
    )
    LLVMMetadataAsValue(context, bootstrapLlvmMetadataNode(context, [type, type, zero]))
}

/** Tag `access` (a load or store) as touching a field slot, or else raw memory. */
fun bootstrapLlvmTagAccess(backend: BootstrapLlvmBackend, access: i64*, slot: bool): void =
    LLVMSetMetadata(access, backend.aliasKind, if (slot) backend.aliasSlot else backend.aliasRaw)

fun bootstrapLlvmAttributeKind(name: string): i32 =
    LLVMGetEnumAttributeKindForName(name, name.size)

fun bootstrapLlvmAddFunctionAttribute(
    backend: BootstrapLlvmBackend,
    value: i64*,
    name: string
): void {
    val attribute = LLVMCreateEnumAttribute(
        backend.context,
        bootstrapLlvmAttributeKind(name),
        0
    )
    // LLVMAttributeFunctionIndex is the all-ones unsigned index. The C API
    // accepts the same bit pattern through its signed i32 binding.
    LLVMAddAttributeAtIndex(value, -1, attribute)
}

/** An enum attribute on `function`'s parameter `parameter` (0-based). */
fun bootstrapLlvmAddParameterAttribute(
    backend: BootstrapLlvmBackend,
    function: i64*,
    parameter: int,
    name: string
): void {
    val attribute = LLVMCreateEnumAttribute(
        backend.context, bootstrapLlvmAttributeKind(name), 0
    )
    LLVMAddAttributeAtIndex(function, i32(parameter + 1), attribute)
}

fun bootstrapLlvmAddStringFunctionAttribute(
    backend: BootstrapLlvmBackend,
    function: i64*,
    name: string,
    value: string
): void {
    val attribute = LLVMCreateStringAttribute(
        backend.context, name, name.size, value, value.size
    )
    LLVMAddAttributeAtIndex(function, -1, attribute)
}

fun bootstrapLlvmAddSret(
    backend: BootstrapLlvmBackend,
    value: i64*,
    callSite: bool
): void {
    if (callSite) LLVMAddCallSiteAttribute(value, 1, backend.sretAttribute)
    else LLVMAddAttributeAtIndex(value, 1, backend.sretAttribute)
}

fun bootstrapLlvmAddByval(
    backend: BootstrapLlvmBackend,
    value: i64*,
    parameter: int,
    callSite: bool
): void {
    if (!backend.valueArgumentsIndirect) {
        if (callSite) {
            LLVMAddCallSiteAttribute(value, i32(parameter + 1), backend.byvalAttribute)
        } else LLVMAddAttributeAtIndex(value, i32(parameter + 1), backend.byvalAttribute)
    }
}

fun bootstrapLlvmDeclare(
    backend: BootstrapLlvmBackend,
    name: string,
    result: i64*,
    parameters: array<i64*>,
    sret: bool,
    byval: array<bool>
): i64* {
    var function = LLVMGetNamedFunction(backend.module, name)
    if (pointerIsNull(function)) {
        function = LLVMAddFunction(
            backend.module,
            name,
            bootstrapLlvmFunctionType(backend, result, parameters)
        )
        if (sret) bootstrapLlvmAddSret(backend, function, false)
        var parameter = 0
        while (parameter < byval.size) {
            if (byval[parameter]) {
                bootstrapLlvmAddByval(
                    backend, function, parameter, false
                )
            }
            parameter = parameter + 1
        }
    }
    function
}

fun bootstrapLlvmCall(
    backend: BootstrapLlvmBackend,
    function: i64*,
    arguments: array<i64*>,
    name: string,
    sret: bool,
    byval: array<bool>
): i64* {
    val values = bootstrapLlvmPointerArguments(backend, arguments)
    val call = LLVMBuildCall2(
        backend.builder,
        LLVMGlobalGetValueType(function),
        function,
        values,
        i32(arguments.size),
        name
    )
    bootstrapLlvmDropPointerArguments(backend, values)
    if (sret) bootstrapLlvmAddSret(backend, call, true)
    var index = 0
    while (index < byval.size) {
        if (byval[index]) bootstrapLlvmAddByval(backend, call, index, true)
        index = index + 1
    }
    call
}

fun bootstrapLlvmCallTyped(
    backend: BootstrapLlvmBackend,
    type: i64*,
    function: i64*,
    arguments: array<i64*>,
    name: string
): i64* {
    val values = bootstrapLlvmPointerArguments(backend, arguments)
    val call = LLVMBuildCall2(
        backend.builder, type, function, values,
        i32(arguments.size), name
    )
    bootstrapLlvmDropPointerArguments(backend, values)
    call
}

// Reuse libc's syscall entry on the Linux x86-64 fatal paths. The typed call
// accepts only the kernel arguments the operation uses, even when ordinary
// Linux intrinsics declared the same C symbol with seven integer parameters.
// Other targets and debug reporting keep their established libc wrappers.
fun bootstrapLlvmCompactLinuxRuntime(backend: BootstrapLlvmBackend): bool =
    !backend.macOS && !bootstrapLlvmDebugHostedRuntime(backend) &&
    bootstrapTextContains(backend.targetTriple, "x86_64") &&
    bootstrapTextContains(backend.targetTriple, "linux") &&
    !bootstrapTextContains(backend.targetTriple, "gnux32")

// x86-64 Linux (not the x32 ABI) issues system calls with the `syscall`
// instruction itself, so a program needs neither libc's syscall() nor its errno:
// the kernel's result comes back as is, and a failure is -errno (-4095..-1).
fun bootstrapLlvmInlineLinuxSyscallTarget(backend: BootstrapLlvmBackend): bool =
    !backend.macOS &&
    bootstrapTextContains(backend.targetTriple, "x86_64") &&
    bootstrapTextContains(backend.targetTriple, "linux") &&
    !bootstrapTextContains(backend.targetTriple, "gnux32")

// `values` are the system call number and its six arguments, all i64.
fun bootstrapLlvmInlineLinuxSyscall(
    backend: BootstrapLlvmBackend,
    values: array<i64*>,
    name: string
): i64* {
    val types: array<i64*> = []
    while (types.size < 7) types.append(backend.i64Type)
    val type = bootstrapLlvmFunctionType(backend, backend.i64Type, types)
    val assembly = "syscall"
    val constraints =
        "={ax},{ax},{di},{si},{dx},{r10},{r8},{r9},~{rcx},~{r11},~{memory},~{dirflag},~{fpsr},~{flags}"
    bootstrapLlvmCallTyped(
        backend, type,
        LLVMGetInlineAsm(type, assembly, assembly.size, constraints, constraints.size, 1, 0, 0, 0),
        values, name
    )
}

// A macOS (not iOS) program issues BSD system calls with the instruction itself
// (#811): arm64 `svc #0x80` with the number in x16, x86-64 `syscall` with the
// number in rax or'ed with the 0x2000000 BSD class here. The kernel signals
// failure with the carry flag and a positive errno in the result register; this
// returns -errno then, like the Linux form. The second result register (x1, rdx:
// fork's child flag, pipe's second descriptor) is declared as an output so the
// compiler knows it changes; only the first is used.
fun bootstrapLlvmDarwinSyscallTarget(backend: BootstrapLlvmBackend): bool =
    backend.macOS && bootstrapLlvmTriplePlainMacOS(backend.targetTriple) &&
    (bootstrapTextContains(backend.targetTriple, "arm64") ||
     bootstrapTextContains(backend.targetTriple, "aarch64") ||
     bootstrapTextContains(backend.targetTriple, "x86_64"))

// `values` are the BSD system call number and its six arguments, all i64.
fun bootstrapLlvmInlineDarwinSyscallPair(
    backend: BootstrapLlvmBackend,
    values: array<i64*>,
    name: string
): i64* {
    val types: array<i64*> = []
    while (types.size < 7) types.append(backend.i64Type)
    val elements = bootstrapLlvmPointerArguments(backend, [backend.i64Type, backend.i64Type])
    val pair = LLVMStructTypeInContext(backend.context, elements, i32(2), i32(0))
    bootstrapLlvmDropPointerArguments(backend, elements)
    val type = bootstrapLlvmFunctionType(backend, pair, types)
    val arm = !bootstrapTextContains(backend.targetTriple, "x86_64")
    val assembly = if (arm) "svc #0x80\n\tb.cc 1f\n\tneg x0, x0\n1:"
        else "syscall\n\tjnc 1f\n\tnegq %rax\n1:"
    val constraints = if (arm)
        "={x0},={x1},{x16},{x0},{x1},{x2},{x3},{x4},{x5},~{memory},~{cc}"
        else "={ax},={dx},{ax},{di},{si},{dx},{r10},{r8},{r9},~{rcx},~{r11},~{memory},~{dirflag},~{fpsr},~{flags}"
    val arguments: array<i64*> = []
    for (value in values) arguments.append(value)
    if (!arm) arguments[0] = LLVMBuildOr(
        backend.builder, values[0], LLVMConstInt(backend.i64Type, 33554432, 0), "$name.class"
    )
    val pairValue = bootstrapLlvmCallTyped(
        backend, type,
        LLVMGetInlineAsm(type, assembly, assembly.size, constraints, constraints.size, 1, 0, 0, 0),
        arguments, name
    )
    pairValue
}

// The first result of the call (the form `ablaDarwinSyscall` takes).
fun bootstrapLlvmInlineDarwinSyscall(
    backend: BootstrapLlvmBackend,
    values: array<i64*>,
    name: string
): i64* = LLVMBuildExtractValue(
    backend.builder, bootstrapLlvmInlineDarwinSyscallPair(backend, values, name), i32(0),
    "$name.result"
)

// AArch64 Linux has no libc to call and its own system call numbers: a call by its
// x86-64 number goes to the module's abla_x64_syscall routine (aarch64.ab).
fun bootstrapLlvmTranslatedLinuxSyscall(
    backend: BootstrapLlvmBackend,
    values: array<i64*>,
    name: string
): i64* {
    val types: array<i64*> = []
    while (types.size < 7) types.append(backend.i64Type)
    var function = LLVMGetNamedFunction(backend.module, "abla_x64_syscall")
    if (pointerIsNull(function)) function = bootstrapLlvmDeclare(
        backend, "abla_x64_syscall", backend.i64Type, types, false, []
    )
    bootstrapLlvmCallTyped(
        backend, bootstrapLlvmFunctionType(backend, backend.i64Type, types),
        function, values, name
    )
}

fun bootstrapLlvmLinuxX64Syscall(
    backend: BootstrapLlvmBackend,
    number: int,
    arguments: array<i64*>
): i64* {
    val types: array<i64*> = [backend.i64Type]
    val values: array<i64*> = [LLVMConstInt(backend.i64Type, number, 0)]
    for (argument in arguments) {
        types.append(backend.i64Type)
        val type = LLVMTypeOf(argument)
        values.append(if (type == backend.pointerType) {
            LLVMBuildPtrToInt(backend.builder, argument, backend.i64Type, "syscall.pointer")
        } else if (type == backend.i64Type) argument
            else if (LLVMGetIntTypeWidth(type) < 64) {
                LLVMBuildZExt(backend.builder, argument, backend.i64Type, "syscall.integer")
            } else LLVMBuildTrunc(backend.builder, argument, backend.i64Type, "syscall.integer"))
    }
    if (bootstrapLlvmTranslatedLinuxSyscalls(backend)) {
        while (values.size < 7) values.append(LLVMConstInt(backend.i64Type, 0, 0))
        return bootstrapLlvmTranslatedLinuxSyscall(backend, values, "linux.runtime.syscall")
    }
    if (bootstrapLlvmInlineLinuxSyscallTarget(backend)) {
        while (values.size < 7) values.append(LLVMConstInt(backend.i64Type, 0, 0))
        return bootstrapLlvmInlineLinuxSyscall(backend, values, "linux.runtime.syscall")
    }
    var function = LLVMGetNamedFunction(backend.module, "syscall")
    if (pointerIsNull(function)) function = bootstrapLlvmDeclare(
        backend, "syscall", backend.i64Type,
        [backend.i64Type, backend.i64Type, backend.i64Type, backend.i64Type,
         backend.i64Type, backend.i64Type, backend.i64Type], false, []
    )
    bootstrapLlvmCallTyped(
        backend, bootstrapLlvmFunctionType(backend, backend.i64Type, types),
        function, values, "linux.runtime.syscall"
    )
}

fun bootstrapLlvmCallNamed(
    backend: BootstrapLlvmBackend,
    name: string,
    arguments: array<i64*>,
    resultName: string,
    sret: bool,
    byval: array<bool>
): i64* =
    if (bootstrapLlvmStoreBoxes && name == "abla_i64" && arguments.size == 2 &&
        LLVMTypeOf(arguments[1]) == backend.i64Type) {
    bootstrapLlvmStoreScalarValue(backend, arguments[0], 2, arguments[1])
} else if (bootstrapLlvmStoreBoxes && name == "abla_bool" && arguments.size == 2 &&
        LLVMTypeOf(arguments[1]) == backend.i1Type) {
    bootstrapLlvmStoreScalarValue(
            backend, arguments[0], 3,
            LLVMBuildZExt(backend.builder, arguments[1], backend.i64Type, "boxed.bool")
        )
} else if (bootstrapLlvmStoreBoxes && (name == "abla_void" || name == "abla_null") && arguments.size == 1) {
    bootstrapLlvmStoreValueWords(
        backend, arguments[0], if (name == "abla_void") 0 else 1,
        LLVMConstInt(backend.i64Type, 0, 0), LLVMConstInt(backend.i64Type, 0, 0)
    )
} else if (bootstrapLlvmStoreBoxes && name == "abla_string_static" && arguments.size == 3 &&
        LLVMIsConstant(arguments[1]) != i32(0) && LLVMTypeOf(arguments[2]) == backend.i64Type) {
    // A constant's data is a global's address, never null: __ablaRuntimeStringStatic's trap cannot fire.
    bootstrapLlvmStoreValueWords(
        backend, arguments[0], 4,
        LLVMBuildPtrToInt(backend.builder, arguments[1], backend.i64Type, "boxed.string.data"), arguments[2]
    )
} else bootstrapLlvmCall(
        backend,
        LLVMGetNamedFunction(backend.module, name),
        arguments,
        resultName,
        sret,
        byval
    )

// Set by the driver for one build: a native development build, which inlines nothing,
// boxes an int or a bool by writing its fields (bootstrapLlvmStoreScalarValue) instead of
// calling abla_i64 or abla_bool, each two calls there (39% of an integer-heavy test's run,
// a third of it after). A release build keeps the calls: its inliner takes them, and the
// stores in their place gave its passes 3% more to do. Void, null and a constant string are
// written the same way (2026-11-19, --fast run instructions: trees -14.3%, strings -6.2%,
// json-readers -5.1%, maps -1.9%, fib and dispatch unchanged; the builds 0.2-0.4% more and
// 2-3% larger).
var bootstrapLlvmStoreBoxes: bool = false
// NativeBuild saves/restores this, excluding raw/libc-free and cross --fast.
var bootstrapLlvmAllowBulkObjectZero: bool = true
// Whether the program being emitted may erase a float to `any`, so that `==` through `any`
// must compare erased floats by kind (__ablaRuntimeEqualFloatKinds). True unless the
// semantic probe of a whole program saw no float erased (bootstrapFloatOriginProbe).
var bootstrapLlvmFloatKindEquality: bool = true

// A boxed int (tag 2) or bool (3) of `word` written into `destination`, field by field, as
// __ablaRuntimeI64 and __ablaRuntimeBool write it.
fun bootstrapLlvmStoreScalarValue(
    backend: BootstrapLlvmBackend,
    destination: i64*,
    tag: int,
    word: i64*
): i64* = bootstrapLlvmStoreValueWords(backend, destination, tag, word, LLVMConstInt(backend.i64Type, 0, 0))

// A box written field by field (ablaRuntimeMakeValue's layout: tag, auxiliary 0, two payload words).
fun bootstrapLlvmStoreValueWords(
    backend: BootstrapLlvmBackend,
    destination: i64*,
    tag: int,
    word: i64*,
    second: i64*
): i64* {
    LLVMBuildStore(
        backend.builder, LLVMConstInt(backend.i32Type, tag, 0),
        LLVMBuildStructGEP2(backend.builder, backend.valueType, destination, 0, "boxed.tag")
    )
    LLVMBuildStore(
        backend.builder, LLVMConstInt(backend.i32Type, 0, 0),
        LLVMBuildStructGEP2(backend.builder, backend.valueType, destination, 1, "boxed.auxiliary")
    )
    val payload = LLVMBuildStructGEP2(
        backend.builder, backend.valueType, destination, 2, "boxed.payload"
    )
    LLVMBuildStore(
        backend.builder, word,
        LLVMBuildStructGEP2(backend.builder, backend.payloadType, payload, 0, "boxed.word0")
    )
    LLVMBuildStore(
        backend.builder, second,
        LLVMBuildStructGEP2(backend.builder, backend.payloadType, payload, 1, "boxed.word1")
    )
}

fun bootstrapLlvmValueParameters(
    backend: BootstrapLlvmBackend,
    count: int
): array<i64*> {
    val result: array<i64*> = []
    var index = 0
    while (index < count) {
        result.append(backend.pointerType)
        index = index + 1
    }
    result
}

fun bootstrapLlvmValueByval(count: int, sret: bool): array<bool> {
    val result: array<bool> = []
    var index = 0
    while (index < count) {
        result.append(!sret || index > 0)
        index = index + 1
    }
    result
}

fun bootstrapLlvmDeclareValueRuntime(
    backend: BootstrapLlvmBackend,
    name: string,
    inputs: int
): i64* {
    val parameters = bootstrapLlvmValueParameters(backend, inputs + 1)
    bootstrapLlvmDeclare(
        backend, name, backend.voidType, parameters, true,
        bootstrapLlvmValueByval(inputs + 1, true)
    )
}

fun bootstrapLlvmRuntimeCall(
    backend: BootstrapLlvmBackend,
    name: string,
    output: i64*,
    inputs: array<i64*>
): i64* {
    val arguments: array<i64*> = [output]
    var index = 0
    while (index < inputs.size) {
        arguments.append(inputs[index])
        index = index + 1
    }
    bootstrapLlvmCallNamed(
        backend, name, arguments, "", true,
        bootstrapLlvmValueByval(arguments.size, true)
    )
}

fun bootstrapLlvmCopyValue(
    backend: BootstrapLlvmBackend,
    source: i64*,
    destination: i64*,
    name: string,
    sourceIsStack: bool = false
): void {
    if (bootstrapLlvmStoreBoxes) {
        // Whole boxed slots are equal or disjoint, which is what llvm.memcpy allows (equal or
        // non-overlapping). A constant memcpy keeps the IR compact and lets FastISel copy all 24
        // bytes without aggregate SSA (a memmove would be a libcall there).
        LLVMBuildMemCpy(
            backend.builder, destination, 8, source, 8,
            LLVMConstInt(backend.i64Type, 24, 0)
        )
        return
    }
    val value = LLVMBuildLoad2(
        backend.builder, backend.valueType, source, name
    )
    LLVMSetAlignment(value, 8)
    if (sourceIsStack) LLVMSetMetadata(value, backend.aliasKind, backend.aliasStackValue)
    val stored = LLVMBuildStore(backend.builder, value, destination)
    LLVMSetAlignment(stored, 8)
}

// FastISel inlines a small memcpy, but lowers memset to a libc call here.
// Keep zero initialization scalar, including the tag/auxiliary header word.
fun bootstrapLlvmZeroValueFast(backend: BootstrapLlvmBackend, destination: i64*): void {
    val payload = LLVMBuildStructGEP2(
        backend.builder, backend.valueType, destination, 2, "zero.payload"
    )
    val last = LLVMBuildStructGEP2(
        backend.builder, backend.payloadType, payload, 1, "zero.last"
    )
    val zero = LLVMConstInt(backend.i64Type, 0, 0)
    LLVMSetAlignment(LLVMBuildStore(backend.builder, zero, destination), 8)
    LLVMSetAlignment(LLVMBuildStore(backend.builder, zero, payload), 8)
    LLVMSetAlignment(LLVMBuildStore(backend.builder, zero, last), 8)
}

fun bootstrapLlvmArrayElement(
    backend: BootstrapLlvmBackend,
    arrayType: i64*,
    storage: i64*,
    index: int,
    name: string
): i64* {
    val indices = llvmPointerVector(2)
    indices.set(0, LLVMConstInt(backend.i64Type, 0, 0))
    indices.set(1, LLVMConstInt(backend.i64Type, index, 0))
    val result = LLVMBuildGEP2(
        backend.builder, arrayType, storage, indices.pointer(), 2, name
    )
    indices.drop()
    result
}

// LLVM 23.1 emits every unnamed_addr C string of a module into one shared
// `.rodata.str1.N` section even with --data-sections, so --gc-sections keeps
// all of them once one is used. On MCU targets an explicit per-global section
// keeps the string mergeable ("aMS", folded across objects by the linker) and
// lets the linker drop each one with its last user.
fun bootstrapLlvmSplitConstantSection(
    backend: BootstrapLlvmBackend,
    global: i64*
): void {
    if (bootstrapLlvmMcuTarget(backend.targetTriple)) {
        LLVMSetSection(
            global, ".rodata.abla.${bootstrapLlvmDebugValueName(global)}"
        )
    }
}

// LLVMBuildGlobalStringPtr takes a NUL-terminated host string and therefore
// cannot preserve embedded zero bytes. Constructing the constant with an
// explicit length keeps all 256 byte values intact while retaining LLVM's
// private, immutable global representation.
fun bootstrapLlvmGlobalStringPointer(
    backend: BootstrapLlvmBackend,
    value: string,
    name: string
): i64* {
    val constant = LLVMConstStringInContext2(
        backend.context, value, value.size, 0
    )
    val constantType = LLVMTypeOf(constant)
    val global = LLVMAddGlobal(backend.module, constantType, name)
    LLVMSetInitializer(global, constant)
    LLVMSetGlobalConstant(global, 1)
    LLVMSetAlignment(global, 1)
    LLVMSetUnnamedAddress(global, llvmHiddenVisibilityUnnamedAddress())
    LLVMSetLinkage(global, llvmPrivateLinkage())
    bootstrapLlvmSplitConstantSection(backend, global)
    val indices = llvmPointerVector(2)
    indices.set(0, LLVMConstInt(backend.i64Type, 0, 0))
    indices.set(1, LLVMConstInt(backend.i64Type, 0, 0))
    val pointer = LLVMBuildGEP2(
        backend.builder, constantType, global, indices.pointer(), 2,
        "$name.data"
    )
    indices.drop()
    pointer
}

// The raw-data counterpart to bootstrapLlvmGlobalStringPointer. LLVM string
// constants are a convenient byte container, but native static data must not
// gain the implicit C terminator used by an Abla string literal.
fun bootstrapLlvmGlobalBytes(
    backend: BootstrapLlvmBackend,
    value: string,
    name: string
): i64* {
    val constant = LLVMConstStringInContext2(
        backend.context, value, value.size, 1
    )
    val constantType = LLVMTypeOf(constant)
    var global = LLVMGetNamedGlobal(backend.module, name)
    if (pointerIsNull(global)) {
        global = LLVMAddGlobal(backend.module, constantType, name)
        LLVMSetInitializer(global, constant)
        LLVMSetGlobalConstant(global, 1)
        // Native byte regions are routinely consumed through typed
        // 16/32/64-bit loads after reconstruction. Match
        // nativeStaticAllocate's alignment so immutable flash data preserves
        // those accesses without target-specific unaligned-load assumptions.
        LLVMSetAlignment(global, 8)
        LLVMSetUnnamedAddress(global, llvmHiddenVisibilityUnnamedAddress())
        LLVMSetLinkage(global, llvmPrivateLinkage())
        bootstrapLlvmSplitConstantSection(backend, global)
    }
    global
}

fun bootstrapLlvmGlobalMutableBytes(
    backend: BootstrapLlvmBackend,
    value: string,
    name: string
): i64* {
    val initializer = LLVMConstStringInContext2(
        backend.context, value, value.size, 1
    )
    val type = LLVMTypeOf(initializer)
    var global = LLVMGetNamedGlobal(backend.module, name)
    if (pointerIsNull(global)) {
        global = LLVMAddGlobal(backend.module, type, name)
        LLVMSetInitializer(global, initializer)
        LLVMSetAlignment(global, 8)
        LLVMSetLinkage(global, llvmPrivateLinkage())
    }
    global
}

// Construct a relocation-capable native word table. LLVM constants retain
// pointer-to-integer expressions as object relocations, so an immutable Abla
// table does not need writable BSS plus a startup store for every entry.
fun bootstrapLlvmGlobalU32s(
    backend: BootstrapLlvmBackend,
    values: array<i64*>,
    name: string
): i64* {
    val type = LLVMArrayType2(backend.i32Type, values.size)
    var global = LLVMGetNamedGlobal(backend.module, name)
    if (pointerIsNull(global)) {
        val nativeValues = llvmPointerVector(values.size)
        var value = 0
        while (value < values.size) {
            nativeValues.set(value, values[value])
            value = value + 1
        }
        val initializer = LLVMConstArray2(
            backend.i32Type, nativeValues.pointer(), values.size
        )
        nativeValues.drop()
        global = LLVMAddGlobal(backend.module, type, name)
        LLVMSetInitializer(global, initializer)
        LLVMSetGlobalConstant(global, 1)
        LLVMSetAlignment(global, 4)
        LLVMSetUnnamedAddress(global, llvmHiddenVisibilityUnnamedAddress())
        LLVMSetLinkage(global, llvmPrivateLinkage())
    }
    global
}

// Mutable counterpart used for compile-time initialized native state. It has
// private linkage but deliberately no unnamed_addr promise: callers may keep
// and compare the stable address while mutating the words.
fun bootstrapLlvmGlobalMutableU32s(
    backend: BootstrapLlvmBackend,
    values: array<i64*>,
    name: string
): i64* {
    val type = LLVMArrayType2(backend.i32Type, values.size)
    var global = LLVMGetNamedGlobal(backend.module, name)
    if (pointerIsNull(global)) {
        val nativeValues = llvmPointerVector(values.size)
        var value = 0
        while (value < values.size) {
            nativeValues.set(value, values[value])
            value = value + 1
        }
        val initializer = LLVMConstArray2(
            backend.i32Type, nativeValues.pointer(), values.size
        )
        nativeValues.drop()
        global = LLVMAddGlobal(backend.module, type, name)
        LLVMSetInitializer(global, initializer)
        LLVMSetAlignment(global, 4)
        LLVMSetLinkage(global, llvmPrivateLinkage())
    }
    global
}

fun bootstrapLlvmGlobalZeroBytes(
    backend: BootstrapLlvmBackend,
    size: int,
    name: string
): i64* {
    val type = LLVMArrayType2(backend.i8Type, size)
    var global = LLVMGetNamedGlobal(backend.module, name)
    if (pointerIsNull(global)) {
        global = LLVMAddGlobal(backend.module, type, name)
        LLVMSetInitializer(global, LLVMConstNull(type))
        LLVMSetAlignment(global, 8)
        LLVMSetLinkage(global, llvmInternalLinkage())
    }
    global
}

fun bootstrapLlvmInternalSectionBytesGlobal(
    backend: BootstrapLlvmBackend,
    contents: string,
    name: string,
    section: string,
    alignment: int
): i64* {
    val initializer = LLVMConstStringInContext2(
        backend.context, contents, contents.size, 1
    )
    val type = LLVMTypeOf(initializer)
    var global = LLVMGetNamedGlobal(backend.module, name)
    if (pointerIsNull(global)) {
        global = LLVMAddGlobal(backend.module, type, name)
        LLVMSetInitializer(global, initializer)
        LLVMSetGlobalConstant(global, 1)
        LLVMSetAlignment(global, i32(alignment))
        LLVMSetLinkage(global, llvmInternalLinkage())
        LLVMSetSection(global, section)
    }
    global
}

fun bootstrapLlvmInternalSectionU32sGlobal(
    backend: BootstrapLlvmBackend,
    values: array<i64*>,
    name: string,
    section: string
): i64* {
    val type = LLVMArrayType2(backend.i32Type, values.size)
    var global = LLVMGetNamedGlobal(backend.module, name)
    if (pointerIsNull(global)) {
        val nativeValues = llvmPointerVector(values.size)
        var value = 0
        while (value < values.size) {
            nativeValues.set(value, values[value])
            value = value + 1
        }
        val initializer = LLVMConstArray2(
            backend.i32Type, nativeValues.pointer(), values.size
        )
        nativeValues.drop()
        global = LLVMAddGlobal(backend.module, type, name)
        LLVMSetInitializer(global, initializer)
        LLVMSetGlobalConstant(global, 1)
        LLVMSetAlignment(global, 4)
        LLVMSetLinkage(global, llvmInternalLinkage())
        LLVMSetSection(global, section)
    }
    global
}

fun bootstrapLlvmStringNeedsExplicitLength(value: string): bool {
    var index = 0
    var found = false
    while (!found && index < value.size) {
        if (value[index] == 0) found = true
        index = index + 1
    }
    found
}

trusted fun bootstrapLlvmValueElement(
    backend: BootstrapLlvmBackend,
    storage: i64*,
    index: int,
    name: string
): i64* {
    ablaUnsafeStorePointer(backend.pointerScratch, LLVMConstInt(backend.i64Type, index, 0))
    LLVMBuildGEP2(
        backend.builder, backend.valueType, storage,
        backend.pointerScratch, 1, name
    )
}
