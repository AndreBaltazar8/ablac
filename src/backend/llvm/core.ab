import "analysis.ab"
import "bindings.ab"
import "abla/platform/host"
import "abla/llvm/orc"
import "../../sema.ab"
import "debug.ab"
import "abla/unsafe/memory/raw"

// The direct backend owns one LLVM context and constructs every declaration,
// global, block, and instruction through LLVM's C API. Text is produced only
// as the serialized view of the finished, verified module.
class BootstrapLlvmBackend(
    val targetTriple: string,
    val macOS: bool,
    val valueArgumentsIndirect: bool,
    var constantScalarVarInitializers: bool,
    // Collection under allocation pressure: allocating functions call the
    // runtime's pressure check on entry (see bootstrapLlvmNeedsCollector).
    var pressureSafePoints: bool,
    val context: i64*,
    val module: i64*,
    val builder: i64*,
    val voidType: i64*,
    val i1Type: i64*,
    val i8Type: i64*,
    val i32Type: i64*,
    val i64Type: i64*,
    val f32Type: i64*,
    val f64Type: i64*,
    val pointerType: i64*,
    val payloadType: i64*,
    val valueType: i64*,
    val rootFrameType: i64*,
    // The TBAA access tags (bootstrapLlvmTagAccess), made with the context.
    val aliasKind: i32,
    val aliasSlot: i64*,
    val aliasRaw: i64*
)

fun bootstrapLlvmBackend(targetTriple: string): BootstrapLlvmBackend {
    val context = LLVMContextCreate()
    val module = LLVMModuleCreateWithNameInContext("abla", context)
    val builder = LLVMCreateBuilderInContext(context)
    val voidType = LLVMVoidTypeInContext(context)
    val i1Type = LLVMInt1TypeInContext(context)
    val i8Type = LLVMInt8TypeInContext(context)
    val i32Type = LLVMInt32TypeInContext(context)
    val i64Type = LLVMInt64TypeInContext(context)
    val f32Type = LLVMFloatTypeInContext(context)
    val f64Type = LLVMDoubleTypeInContext(context)
    val pointerType = LLVMPointerTypeInContext(context, 0)
    val payloadType = LLVMStructCreateNamed(context, "AblaPayload")
    val payloadFields = llvmPointerVector(2)
    var field = 0
    while (field < 2) {
        payloadFields.set(field, i64Type)
        field = field + 1
    }
    LLVMStructSetBody(payloadType, payloadFields.pointer(), 2, 0)
    payloadFields.drop()
    val valueType = LLVMStructCreateNamed(context, "AblaValue")
    val valueFields = llvmPointerVector(3)
    valueFields.set(0, i32Type)
    valueFields.set(1, i32Type)
    valueFields.set(2, payloadType)
    LLVMStructSetBody(valueType, valueFields.pointer(), 3, 0)
    valueFields.drop()
    val rootFrameType = LLVMStructCreateNamed(context, "AblaRootFrame")
    val rootFields = llvmPointerVector(3)
    rootFields.set(0, pointerType)
    rootFields.set(1, pointerType)
    rootFields.set(2, i64Type)
    LLVMStructSetBody(rootFrameType, rootFields.pointer(), 3, 0)
    rootFields.drop()
    BootstrapLlvmBackend(
        targetTriple,
        bootstrapTextContains(targetTriple, "apple-macos") ||
            bootstrapTextContains(targetTriple, "apple-darwin"),
        bootstrapTextContains(targetTriple, "arm64-apple-macos") ||
            bootstrapTextContains(targetTriple, "aarch64-apple-macos") ||
            bootstrapTextContains(targetTriple, "arm64-apple-darwin") ||
            bootstrapTextContains(targetTriple, "aarch64-apple-darwin"),
        false,
        false,
        context, module, builder, voidType, i1Type, i8Type, i32Type,
        i64Type, f32Type, f64Type, pointerType, payloadType, valueType,
        rootFrameType, LLVMGetMDKindIDInContext(context, "tbaa", i32(4)),
        bootstrapLlvmAliasTag(context, i64Type, "abla field slot"),
        bootstrapLlvmAliasTag(context, i64Type, "abla raw memory")
    )
}

// LLVM's opaque pointer type does not expose the target address width. Keep
// the small set of 32-bit triples in one target-neutral predicate so C ABI
// helpers use size_t rather than accidentally retaining the host's i64 ABI.
fun bootstrapLlvmTargetUses32BitPointers(targetTriple: string): bool =
    bootstrapTextContains(targetTriple, "xtensa") ||
    bootstrapTextContains(targetTriple, "riscv32") ||
    bootstrapTextContains(targetTriple, "thumb") ||
    bootstrapTextContains(targetTriple, "wasm32") ||
    bootstrapTextContains(targetTriple, "i386") ||
    bootstrapTextContains(targetTriple, "i486") ||
    bootstrapTextContains(targetTriple, "i586") ||
    bootstrapTextContains(targetTriple, "i686")

// LLVM's upstream optimizer does not register Espressif's out-of-tree Xtensa
// target, so a triple alone leaves the module without a data layout. In that
// state opaque-pointer arithmetic is optimized as if pointers were 64-bit and
// the final 32-bit backend must undo the resulting casts. This is the canonical
// layout emitted by Espressif Clang 21 for xtensa-esp-unknown-elf.
fun bootstrapLlvmTargetDataLayout(targetTriple: string): string {
    if (bootstrapTextContains(targetTriple, "xtensa")) {
        return "e-m:e-p:32:32-v1:8:8-i64:64-i128:128-n32"
    }
    return ""
}

// llvm.fma.f64 is one instruction on AArch64. Baseline x86-64 (the target CPU
// here) has no FMA3, where LLVM would call the C library's fma, and Wasm and
// the freestanding targets have no instruction either: abla/math computes a
// fused multiply-add in software on all of those.
fun bootstrapLlvmTargetHasFusedMultiplyAdd(targetTriple: string): bool =
    bootstrapTextContains(targetTriple, "aarch64") ||
    bootstrapTextContains(targetTriple, "arm64")

// Hosted programs can reach methods through runtime-owned reflection tables
// that are deliberately broader than the static call graph. Freestanding ELF
// and bare Wasm artifacts have a closed program boundary, so they can safely
// omit unreachable functions before asking LLVM to build the module.
fun bootstrapLlvmTargetHasClosedProgramBoundary(
    targetTriple: string
): bool = bootstrapTextContains(targetTriple, "unknown-elf") ||
    bootstrapTextContains(targetTriple, "unknown-none") ||
    bootstrapTextContains(targetTriple, "wasm32-unknown-unknown")

fun BootstrapLlvmBackend.nativeSizeType(): i64* =
    if (bootstrapLlvmTargetUses32BitPointers(this.targetTriple)) {
        this.i32Type
    } else this.i64Type

fun BootstrapLlvmBackend.type(code: string): i64* {
    var result = this.pointerType
    if (code == "void") result = this.voidType
    if (code == "i1" || code == "bool") result = this.i1Type
    if (code == "i8" || code == "u8" || code == "char") {
        result = this.i8Type
    }
    if (code == "i16" || code == "u16") {
        result = LLVMIntTypeInContext(this.context, 16)
    }
    if (code == "i32" || code == "u32") result = this.i32Type
    if (code == "i64" || code == "u64" || code == "int") {
        result = this.i64Type
    }
    if (code == "f32") result = this.f32Type
    if (code == "f64") result = this.f64Type
    result
}

fun bootstrapLlvmFunctionType(
    backend: BootstrapLlvmBackend,
    result: i64*,
    parameters: array<i64*>
): i64* {
    val types = llvmPointerVector(parameters.size)
    var index = 0
    while (index < parameters.size) {
        types.set(index, parameters[index])
        index = index + 1
    }
    val resultType = LLVMFunctionType(
        result, types.pointer(), i32(parameters.size), 0
    )
    types.drop()
    resultType
}

noescape extern:"c" fun LLVMMDStringInContext2(context: i64*, text: cstring, length: int): i64*
noescape extern:"c" fun LLVMMDNodeInContext2(context: i64*, nodes: i64*, count: int): i64*
noescape extern:"c" fun LLVMMetadataAsValue(context: i64*, metadata: i64*): i64*
noescape extern:"c" fun LLVMGetMDKindIDInContext(context: i64*, name: cstring, length: i32): i32
noescape extern:"c" fun LLVMSetMetadata(value: i64*, kind: i32, node: i64*): void

// Two kinds of memory that never overlap, as TBAA access tags under one root:
// a declared field's slot, which only the runtime's typed field accessors
// touch through ablaRuntimeLoadSlot*/StoreSlot*, and the raw memory programs
// reach through abla/unsafe (a column's bytes). Raw addresses come from raw,
// C, stack and static allocations and string bytes; nothing outside the
// runtime can take an object's address. Every other access (the collector,
// by-name field access, extension fields, value cells) has neither tag and
// may alias both. Each backend makes its tags with its own context: metadata
// never outlives the context it belongs to, and compile-time evaluation makes
// and disposes contexts all the time.

fun bootstrapLlvmMetadataNode(context: i64*, nodes: array<i64*>): i64* {
    val vector = llvmPointerVector(nodes.size)
    for (index in 0 until nodes.size) vector.set(index, nodes[index])
    val node = LLVMMDNodeInContext2(context, vector.pointer(), nodes.size)
    vector.drop()
    node
}

// The access tag for type `name` under the shared root, as a value.
fun bootstrapLlvmAliasTag(context: i64*, i64Type: i64*, name: string): i64* {
    val rootName = "abla memory"
    val root = bootstrapLlvmMetadataNode(
        context, [LLVMMDStringInContext2(context, rootName, rootName.size)]
    )
    val zero = LLVMValueAsMetadata(LLVMConstInt(i64Type, 0, 0))
    val type = bootstrapLlvmMetadataNode(
        context, [LLVMMDStringInContext2(context, name, name.size), root, zero]
    )
    LLVMMetadataAsValue(context, bootstrapLlvmMetadataNode(context, [type, type, zero]))
}

/** Tag `access` (a load or store) as touching a field slot, or else raw memory. */
fun bootstrapLlvmTagAccess(backend: BootstrapLlvmBackend, access: i64*, slot: bool): void =
    LLVMSetMetadata(access, backend.aliasKind, if (slot) backend.aliasSlot else backend.aliasRaw)

fun bootstrapLlvmAttributeKind(name: string): i32 =
    LLVMGetEnumAttributeKindForName(name, name.size)

fun bootstrapLlvmAddFunctionAttribute(
    backend: BootstrapLlvmBackend,
    value: i64*,
    name: string
): void {
    val attribute = LLVMCreateEnumAttribute(
        backend.context,
        bootstrapLlvmAttributeKind(name),
        0
    )
    // LLVMAttributeFunctionIndex is the all-ones unsigned index. The C API
    // accepts the same bit pattern through its signed i32 binding.
    LLVMAddAttributeAtIndex(value, -1, attribute)
}

/** An enum attribute on `function`'s parameter `parameter` (0-based). */
fun bootstrapLlvmAddParameterAttribute(
    backend: BootstrapLlvmBackend,
    function: i64*,
    parameter: int,
    name: string
): void {
    val attribute = LLVMCreateEnumAttribute(
        backend.context, bootstrapLlvmAttributeKind(name), 0
    )
    LLVMAddAttributeAtIndex(function, i32(parameter + 1), attribute)
}

fun bootstrapLlvmAddStringFunctionAttribute(
    backend: BootstrapLlvmBackend,
    function: i64*,
    name: string,
    value: string
): void {
    val attribute = LLVMCreateStringAttribute(
        backend.context, name, name.size, value, value.size
    )
    LLVMAddAttributeAtIndex(function, -1, attribute)
}

fun bootstrapLlvmAddSret(
    backend: BootstrapLlvmBackend,
    value: i64*,
    callSite: bool
): void {
    val attribute = LLVMCreateTypeAttribute(
        backend.context,
        bootstrapLlvmAttributeKind("sret"),
        backend.valueType
    )
    if (callSite) LLVMAddCallSiteAttribute(value, 1, attribute)
    else LLVMAddAttributeAtIndex(value, 1, attribute)
}

fun bootstrapLlvmAddByval(
    backend: BootstrapLlvmBackend,
    value: i64*,
    parameter: int,
    callSite: bool
): void {
    if (!backend.valueArgumentsIndirect) {
        val attribute = LLVMCreateTypeAttribute(
            backend.context,
            bootstrapLlvmAttributeKind("byval"),
            backend.valueType
        )
        if (callSite) {
            LLVMAddCallSiteAttribute(value, i32(parameter + 1), attribute)
        } else LLVMAddAttributeAtIndex(value, i32(parameter + 1), attribute)
    }
}

fun bootstrapLlvmDeclare(
    backend: BootstrapLlvmBackend,
    name: string,
    result: i64*,
    parameters: array<i64*>,
    sret: bool,
    byval: array<bool>
): i64* {
    var function = LLVMGetNamedFunction(backend.module, name)
    if (pointerIsNull(function)) {
        function = LLVMAddFunction(
            backend.module,
            name,
            bootstrapLlvmFunctionType(backend, result, parameters)
        )
        if (sret) bootstrapLlvmAddSret(backend, function, false)
        var parameter = 0
        while (parameter < byval.size) {
            if (byval[parameter]) {
                bootstrapLlvmAddByval(
                    backend, function, parameter, false
                )
            }
            parameter = parameter + 1
        }
    }
    function
}

fun bootstrapLlvmCall(
    backend: BootstrapLlvmBackend,
    function: i64*,
    arguments: array<i64*>,
    name: string,
    sret: bool,
    byval: array<bool>
): i64* {
    val values = llvmPointerVector(arguments.size)
    var index = 0
    while (index < arguments.size) {
        values.set(index, arguments[index])
        index = index + 1
    }
    val call = LLVMBuildCall2(
        backend.builder,
        LLVMGlobalGetValueType(function),
        function,
        values.pointer(),
        i32(arguments.size),
        name
    )
    values.drop()
    if (sret) bootstrapLlvmAddSret(backend, call, true)
    index = 0
    while (index < byval.size) {
        if (byval[index]) bootstrapLlvmAddByval(backend, call, index, true)
        index = index + 1
    }
    call
}

fun bootstrapLlvmCallTyped(
    backend: BootstrapLlvmBackend,
    type: i64*,
    function: i64*,
    arguments: array<i64*>,
    name: string
): i64* {
    val values = llvmPointerVector(arguments.size)
    var index = 0
    while (index < arguments.size) {
        values.set(index, arguments[index])
        index = index + 1
    }
    val call = LLVMBuildCall2(
        backend.builder, type, function, values.pointer(),
        i32(arguments.size), name
    )
    values.drop()
    call
}

fun bootstrapLlvmCallNamed(
    backend: BootstrapLlvmBackend,
    name: string,
    arguments: array<i64*>,
    resultName: string,
    sret: bool,
    byval: array<bool>
): i64* = bootstrapLlvmCall(
    backend,
    LLVMGetNamedFunction(backend.module, name),
    arguments,
    resultName,
    sret,
    byval
)

fun bootstrapLlvmValueParameters(
    backend: BootstrapLlvmBackend,
    count: int
): array<i64*> {
    val result: array<i64*> = []
    var index = 0
    while (index < count) {
        result.append(backend.pointerType)
        index = index + 1
    }
    result
}

fun bootstrapLlvmValueByval(count: int, sret: bool): array<bool> {
    val result: array<bool> = []
    var index = 0
    while (index < count) {
        result.append(!sret || index > 0)
        index = index + 1
    }
    result
}

fun bootstrapLlvmDeclareValueRuntime(
    backend: BootstrapLlvmBackend,
    name: string,
    inputs: int
): i64* {
    val parameters = bootstrapLlvmValueParameters(backend, inputs + 1)
    bootstrapLlvmDeclare(
        backend, name, backend.voidType, parameters, true,
        bootstrapLlvmValueByval(inputs + 1, true)
    )
}

fun bootstrapLlvmRuntimeCall(
    backend: BootstrapLlvmBackend,
    name: string,
    output: i64*,
    inputs: array<i64*>
): i64* {
    val arguments: array<i64*> = [output]
    var index = 0
    while (index < inputs.size) {
        arguments.append(inputs[index])
        index = index + 1
    }
    bootstrapLlvmCallNamed(
        backend, name, arguments, "", true,
        bootstrapLlvmValueByval(arguments.size, true)
    )
}

fun bootstrapLlvmCopyValue(
    backend: BootstrapLlvmBackend,
    source: i64*,
    destination: i64*,
    name: string
): void {
    val value = LLVMBuildLoad2(
        backend.builder, backend.valueType, source, name
    )
    LLVMSetAlignment(value, 8)
    val stored = LLVMBuildStore(backend.builder, value, destination)
    LLVMSetAlignment(stored, 8)
}

fun bootstrapLlvmArrayElement(
    backend: BootstrapLlvmBackend,
    arrayType: i64*,
    storage: i64*,
    index: int,
    name: string
): i64* {
    val indices = llvmPointerVector(2)
    indices.set(0, LLVMConstInt(backend.i64Type, 0, 0))
    indices.set(1, LLVMConstInt(backend.i64Type, index, 0))
    val result = LLVMBuildGEP2(
        backend.builder, arrayType, storage, indices.pointer(), 2, name
    )
    indices.drop()
    result
}

// LLVMBuildGlobalStringPtr takes a NUL-terminated host string and therefore
// cannot preserve embedded zero bytes. Constructing the constant with an
// explicit length keeps all 256 byte values intact while retaining LLVM's
// private, immutable global representation.
fun bootstrapLlvmGlobalStringPointer(
    backend: BootstrapLlvmBackend,
    value: string,
    name: string
): i64* {
    val constant = LLVMConstStringInContext2(
        backend.context, value, value.size, 0
    )
    val constantType = LLVMTypeOf(constant)
    val global = LLVMAddGlobal(backend.module, constantType, name)
    LLVMSetInitializer(global, constant)
    LLVMSetGlobalConstant(global, 1)
    LLVMSetAlignment(global, 1)
    LLVMSetUnnamedAddress(global, llvmHiddenVisibilityUnnamedAddress())
    LLVMSetLinkage(global, llvmPrivateLinkage())
    val indices = llvmPointerVector(2)
    indices.set(0, LLVMConstInt(backend.i64Type, 0, 0))
    indices.set(1, LLVMConstInt(backend.i64Type, 0, 0))
    val pointer = LLVMBuildGEP2(
        backend.builder, constantType, global, indices.pointer(), 2,
        "$name.data"
    )
    indices.drop()
    pointer
}

// The raw-data counterpart to bootstrapLlvmGlobalStringPointer. LLVM string
// constants are a convenient byte container, but native static data must not
// gain the implicit C terminator used by an Abla string literal.
fun bootstrapLlvmGlobalBytes(
    backend: BootstrapLlvmBackend,
    value: string,
    name: string
): i64* {
    val constant = LLVMConstStringInContext2(
        backend.context, value, value.size, 1
    )
    val constantType = LLVMTypeOf(constant)
    var global = LLVMGetNamedGlobal(backend.module, name)
    if (pointerIsNull(global)) {
        global = LLVMAddGlobal(backend.module, constantType, name)
        LLVMSetInitializer(global, constant)
        LLVMSetGlobalConstant(global, 1)
        // Native byte regions are routinely consumed through typed
        // 16/32/64-bit loads after reconstruction. Match
        // nativeStaticAllocate's alignment so immutable flash data preserves
        // those accesses without target-specific unaligned-load assumptions.
        LLVMSetAlignment(global, 8)
        LLVMSetUnnamedAddress(global, llvmHiddenVisibilityUnnamedAddress())
        LLVMSetLinkage(global, llvmPrivateLinkage())
    }
    global
}

fun bootstrapLlvmGlobalMutableBytes(
    backend: BootstrapLlvmBackend,
    value: string,
    name: string
): i64* {
    val initializer = LLVMConstStringInContext2(
        backend.context, value, value.size, 1
    )
    val type = LLVMTypeOf(initializer)
    var global = LLVMGetNamedGlobal(backend.module, name)
    if (pointerIsNull(global)) {
        global = LLVMAddGlobal(backend.module, type, name)
        LLVMSetInitializer(global, initializer)
        LLVMSetAlignment(global, 8)
        LLVMSetLinkage(global, llvmPrivateLinkage())
    }
    global
}

fun bootstrapLlvmGlobalBytesPointer(
    backend: BootstrapLlvmBackend,
    value: string,
    name: string
): i64* {
    val constant = LLVMConstStringInContext2(
        backend.context, value, value.size, 1
    )
    val constantType = LLVMTypeOf(constant)
    val global = bootstrapLlvmGlobalBytes(backend, value, name)
    val indices = llvmPointerVector(2)
    indices.set(0, LLVMConstInt(backend.i64Type, 0, 0))
    indices.set(1, LLVMConstInt(backend.i64Type, 0, 0))
    val pointer = LLVMBuildGEP2(
        backend.builder, constantType, global, indices.pointer(), 2,
        "$name.data"
    )
    indices.drop()
    pointer
}

// Construct a relocation-capable native word table. LLVM constants retain
// pointer-to-integer expressions as object relocations, so an immutable Abla
// table does not need writable BSS plus a startup store for every entry.
fun bootstrapLlvmGlobalU32s(
    backend: BootstrapLlvmBackend,
    values: array<i64*>,
    name: string
): i64* {
    val type = LLVMArrayType2(backend.i32Type, values.size)
    var global = LLVMGetNamedGlobal(backend.module, name)
    if (pointerIsNull(global)) {
        val nativeValues = llvmPointerVector(values.size)
        var value = 0
        while (value < values.size) {
            nativeValues.set(value, values[value])
            value = value + 1
        }
        val initializer = LLVMConstArray2(
            backend.i32Type, nativeValues.pointer(), values.size
        )
        nativeValues.drop()
        global = LLVMAddGlobal(backend.module, type, name)
        LLVMSetInitializer(global, initializer)
        LLVMSetGlobalConstant(global, 1)
        LLVMSetAlignment(global, 4)
        LLVMSetUnnamedAddress(global, llvmHiddenVisibilityUnnamedAddress())
        LLVMSetLinkage(global, llvmPrivateLinkage())
    }
    global
}

// Mutable counterpart used for compile-time initialized native state. It has
// private linkage but deliberately no unnamed_addr promise: callers may keep
// and compare the stable address while mutating the words.
fun bootstrapLlvmGlobalMutableU32s(
    backend: BootstrapLlvmBackend,
    values: array<i64*>,
    name: string
): i64* {
    val type = LLVMArrayType2(backend.i32Type, values.size)
    var global = LLVMGetNamedGlobal(backend.module, name)
    if (pointerIsNull(global)) {
        val nativeValues = llvmPointerVector(values.size)
        var value = 0
        while (value < values.size) {
            nativeValues.set(value, values[value])
            value = value + 1
        }
        val initializer = LLVMConstArray2(
            backend.i32Type, nativeValues.pointer(), values.size
        )
        nativeValues.drop()
        global = LLVMAddGlobal(backend.module, type, name)
        LLVMSetInitializer(global, initializer)
        LLVMSetAlignment(global, 4)
        LLVMSetLinkage(global, llvmPrivateLinkage())
    }
    global
}

fun bootstrapLlvmGlobalZeroBytes(
    backend: BootstrapLlvmBackend,
    size: int,
    name: string
): i64* {
    val type = LLVMArrayType2(backend.i8Type, size)
    var global = LLVMGetNamedGlobal(backend.module, name)
    if (pointerIsNull(global)) {
        global = LLVMAddGlobal(backend.module, type, name)
        LLVMSetInitializer(global, LLVMConstNull(type))
        LLVMSetAlignment(global, 8)
        LLVMSetLinkage(global, llvmInternalLinkage())
    }
    global
}

fun bootstrapLlvmInternalSectionBytesGlobal(
    backend: BootstrapLlvmBackend,
    contents: string,
    name: string,
    section: string,
    alignment: int
): i64* {
    val initializer = LLVMConstStringInContext2(
        backend.context, contents, contents.size, 1
    )
    val type = LLVMTypeOf(initializer)
    var global = LLVMGetNamedGlobal(backend.module, name)
    if (pointerIsNull(global)) {
        global = LLVMAddGlobal(backend.module, type, name)
        LLVMSetInitializer(global, initializer)
        LLVMSetGlobalConstant(global, 1)
        LLVMSetAlignment(global, i32(alignment))
        LLVMSetLinkage(global, llvmInternalLinkage())
        LLVMSetSection(global, section)
    }
    global
}

fun bootstrapLlvmInternalSectionU32sGlobal(
    backend: BootstrapLlvmBackend,
    values: array<i64*>,
    name: string,
    section: string
): i64* {
    val type = LLVMArrayType2(backend.i32Type, values.size)
    var global = LLVMGetNamedGlobal(backend.module, name)
    if (pointerIsNull(global)) {
        val nativeValues = llvmPointerVector(values.size)
        var value = 0
        while (value < values.size) {
            nativeValues.set(value, values[value])
            value = value + 1
        }
        val initializer = LLVMConstArray2(
            backend.i32Type, nativeValues.pointer(), values.size
        )
        nativeValues.drop()
        global = LLVMAddGlobal(backend.module, type, name)
        LLVMSetInitializer(global, initializer)
        LLVMSetGlobalConstant(global, 1)
        LLVMSetAlignment(global, 4)
        LLVMSetLinkage(global, llvmInternalLinkage())
        LLVMSetSection(global, section)
    }
    global
}

fun bootstrapLlvmStringNeedsExplicitLength(value: string): bool {
    var index = 0
    var found = false
    while (!found && index < value.size) {
        if (value[index] == 0) found = true
        index = index + 1
    }
    found
}

fun bootstrapLlvmValueElement(
    backend: BootstrapLlvmBackend,
    storage: i64*,
    index: int,
    name: string
): i64* {
    val indices = llvmPointerVector(1)
    indices.set(0, LLVMConstInt(backend.i64Type, index, 0))
    val result = LLVMBuildGEP2(
        backend.builder, backend.valueType, storage,
        indices.pointer(), 1, name
    )
    indices.drop()
    result
}
