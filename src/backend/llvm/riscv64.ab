import "bindings.ab"
import "core.ab"

// RISC-V Linux executable entry. Auxv locates the program headers and the
// relative relocations have to be applied before using any relocated data.
// The ELF TLS image starts at tp on RV64, unlike the AArch64 TCB prefix.
private fun bootstrapLlvmRiscv64StartAssembly(): string {
    """
    .text
    .p2align 2
    .pushsection .bss
    .p2align 3
    .globl abla_start_phdr
    .globl abla_start_phnum
    .globl abla_start_base
    abla_start_phdr: .zero 8
    abla_start_phnum: .zero 8
    abla_start_base: .zero 8
    .popsection
    .pushsection .data
    .p2align 3
    .globl __stack_chk_guard
    .type __stack_chk_guard,@object
    .size __stack_chk_guard,8
    __stack_chk_guard: .quad 0
    .popsection
    .globl abla_start
    .hidden abla_start
    .type abla_start,@function
    abla_start:
        .option push
        .option norelax
        lla gp, __global_pointer$
        .option pop
        li s0, 0
        li ra, 0
        ld s1, 0(sp)
        addi s2, sp, 8
        slli s3, s1, 3
        add s3, s3, s2
        addi s3, s3, 8
        mv t0, s3
    1:  ld t1, 0(t0)
        addi t0, t0, 8
        bnez t1, 1b
        li s4, 0
        li s5, 0
        li s9, 0
    2:  ld t1, 0(t0)
        ld t2, 8(t0)
        addi t0, t0, 16
        beqz t1, 4f
        li t3, 25
        bne t1, t3, 21f
        mv s9, t2
    21: li t3, 3
        bne t1, t3, 3f
        mv s4, t2
    3:  li t3, 5
        bne t1, t3, 2b
        mv s5, t2
        j 2b
    4:  lla t0, abla_start_phdr
        sd s4, 0(t0)
        lla t0, abla_start_phnum
        sd s5, 0(t0)
        li s6, 0
        li t2, 0
        mv t0, s4
        mv t1, s5
    5:  beqz t1, 8f
        lw t3, 0(t0)
        li t4, 6
        bne t3, t4, 6f
        ld t4, 16(t0)
        sub s6, s4, t4
    6:  li t4, 2
        bne t3, t4, 7f
        ld t2, 16(t0)
    7:  addi t0, t0, 56
        addi t1, t1, -1
        j 5b
    8:  lla t0, abla_start_base
        sd s6, 0(t0)
        li s7, 0
        li s8, 0
        li t0, 0
        li t1, 0
        beqz t2, 18f
        add t2, t2, s6
    9:  ld t3, 0(t2)
        ld t4, 8(t2)
        addi t2, t2, 16
        beqz t3, 15f
        li t5, 7
        bne t3, t5, 10f
        mv t0, t4
    10: li t5, 8
        bne t3, t5, 11f
        mv t1, t4
    11: li t5, 25
        bne t3, t5, 12f
        mv s7, t4
    12: li t5, 27
        bne t3, t5, 13f
        mv s8, t4
    13: li t5, 17
        beq t3, t5, 99f
        li t5, 36
        beq t3, t5, 99f
        j 9b
    15: beqz t0, 17f
        add t0, t0, s6
    16: beqz t1, 17f
        ld t2, 0(t0)
        ld t3, 8(t0)
        ld t4, 16(t0)
        li t5, 3
        bne t3, t5, 99f
        add t2, t2, s6
        add t4, t4, s6
        sd t4, 0(t2)
        addi t0, t0, 24
        addi t1, t1, -24
        j 16b
    17: add s7, s7, s6
        add s8, s8, s7
        # The stack protector's canary (__stack_chk_guard): AT_RANDOM's first 8 bytes with the low byte cleared, as glibc does. Stored after the
        # relocations and before the TLS block, the init_array constructors and main: no protected frame is live yet; threads read the same global;
        # a forked child keeps it; only exec gives a new one.
    18: beqz s9, 182f
        ld t0, 0(s9)
        srli t0, t0, 8
        slli t0, t0, 8
        lla t1, __stack_chk_guard
        sd t0, 0(t1)
    182: mv a0, s4
        mv a1, s5
        call abla_tls_bytes
        bltz a0, 99f
        mv a1, a0
        li a0, 0
        li a2, 3
        li a3, 34
        li a4, -1
        li a5, 0
        li a7, 222
        ecall
        li t0, -4095
        bgeu a0, t0, 99f
        mv a1, s4
        mv a2, s5
        call abla_tls_init
        mv tp, a0
    19: bgeu s7, s8, 20f
        ld t0, 0(s7)
        addi s7, s7, 8
        mv a0, s1
        mv a1, s2
        mv a2, s3
        jalr t0
        j 19b
    20: mv a0, s1
        mv a1, s2
        mv a2, s3
        call main
        li a7, 94
        ecall
    99: li a0, 127
        li a7, 94
        ecall
    .size abla_start, . - abla_start

    .globl abla_tls_bytes
    .hidden abla_tls_bytes
    .type abla_tls_bytes,@function
    abla_tls_bytes:
        li t2, 7
    1:  beqz a1, 3f
        lw t0, 0(a0)
        beq t0, t2, 2f
        addi a0, a0, 56
        addi a1, a1, -1
        j 1b
    2:  ld t0, 48(a0)
        li t1, 4096
        bgtu t0, t1, 4f
        ld t0, 40(a0)
        add t0, t0, t1
        addi t0, t0, -1
        neg t1, t1
        and a0, t0, t1
        bnez a0, 5f
    3:  li a0, 4096
    5:  ret
    4:  li a0, -1
        ret
    .size abla_tls_bytes, . - abla_tls_bytes

    .globl abla_tls_init
    .hidden abla_tls_init
    .type abla_tls_init,@function
    abla_tls_init:
        li t2, 7
    1:  beqz a2, 4f
        lw t0, 0(a1)
        beq t0, t2, 2f
        addi a1, a1, 56
        addi a2, a2, -1
        j 1b
    2:  ld t0, 16(a1)
        lla t1, abla_start_base
        ld t1, 0(t1)
        add t0, t0, t1
        ld t1, 32(a1)
        mv t2, a0
    3:  beqz t1, 4f
        lbu t3, 0(t0)
        sb t3, 0(t2)
        addi t0, t0, 1
        addi t2, t2, 1
        addi t1, t1, -1
        j 3b
    4:  ret
    .size abla_tls_init, . - abla_tls_init

    """
}

// LLVM can lower memory intrinsics to these calls, even without libc.
private fun bootstrapLlvmRiscv64MemoryAssembly(): string {
    """
    .text
    .p2align 2
    .globl memcpy
    .hidden memcpy
    .type memcpy,@function
    .globl memmove
    .hidden memmove
    .type memmove,@function
    memcpy:
    memmove:
        beqz a2, 4f
        mv t0, a0
        bleu a0, a1, 1f
        sub t1, a0, a1
        bgeu t1, a2, 1f
        add t0, a0, a2
        add a1, a1, a2
    2:  addi a1, a1, -1
        addi t0, t0, -1
        lbu t1, 0(a1)
        sb t1, 0(t0)
        addi a2, a2, -1
        bnez a2, 2b
        ret
    1:  lbu t1, 0(a1)
        sb t1, 0(t0)
        addi a1, a1, 1
        addi t0, t0, 1
        addi a2, a2, -1
        bnez a2, 1b
    4:  ret
    .size memmove, . - memmove
    .size memcpy, . - memcpy

    .globl memset
    .hidden memset
    .type memset,@function
    memset:
        mv t0, a0
    1:  beqz a2, 2f
        sb a1, 0(t0)
        addi t0, t0, 1
        addi a2, a2, -1
        j 1b
    2:  ret
    .size memset, . - memset

    .globl memcmp
    .hidden memcmp
    .type memcmp,@function
    .globl bcmp
    .hidden bcmp
    .type bcmp,@function
    memcmp:
    bcmp:
        beqz a2, 3f
    1:  lbu t0, 0(a0)
        lbu t1, 0(a1)
        bne t0, t1, 2f
        addi a0, a0, 1
        addi a1, a1, 1
        addi a2, a2, -1
        bnez a2, 1b
    3:  li a0, 0
        ret
    2:  sub a0, t0, t1
        ret
    .size memcmp, . - memcmp
    .size bcmp, . - bcmp

    .globl strlen
    .hidden strlen
    .type strlen,@function
    strlen:
        mv t0, a0
    1:  lbu t1, 0(t0)
        beqz t1, 2f
        addi t0, t0, 1
        j 1b
    2:  sub a0, t0, a0
        ret
    .size strlen, . - strlen

    """
}

// Internal recovery buffer for LP64D, with no saved signal mask.
private fun bootstrapLlvmRiscv64JumpAssembly(): string {
    """
    .text
    .p2align 2
    .globl _setjmp
    .hidden _setjmp
    .type _setjmp,@function
    _setjmp:
        sd ra, 0(a0)
        sd sp, 8(a0)
        sd s0, 16(a0)
        sd s1, 24(a0)
        sd s2, 32(a0)
        sd s3, 40(a0)
        sd s4, 48(a0)
        sd s5, 56(a0)
        sd s6, 64(a0)
        sd s7, 72(a0)
        sd s8, 80(a0)
        sd s9, 88(a0)
        sd s10, 96(a0)
        sd s11, 104(a0)
        fsd fs0, 112(a0)
        fsd fs1, 120(a0)
        fsd fs2, 128(a0)
        fsd fs3, 136(a0)
        fsd fs4, 144(a0)
        fsd fs5, 152(a0)
        fsd fs6, 160(a0)
        fsd fs7, 168(a0)
        fsd fs8, 176(a0)
        fsd fs9, 184(a0)
        fsd fs10, 192(a0)
        fsd fs11, 200(a0)
        li a0, 0
        ret
    .size _setjmp, . - _setjmp
    .globl _longjmp
    .hidden _longjmp
    .type _longjmp,@function
    _longjmp:
        ld ra, 0(a0)
        ld sp, 8(a0)
        ld s0, 16(a0)
        ld s1, 24(a0)
        ld s2, 32(a0)
        ld s3, 40(a0)
        ld s4, 48(a0)
        ld s5, 56(a0)
        ld s6, 64(a0)
        ld s7, 72(a0)
        ld s8, 80(a0)
        ld s9, 88(a0)
        ld s10, 96(a0)
        ld s11, 104(a0)
        fld fs0, 112(a0)
        fld fs1, 120(a0)
        fld fs2, 128(a0)
        fld fs3, 136(a0)
        fld fs4, 144(a0)
        fld fs5, 152(a0)
        fld fs6, 160(a0)
        fld fs7, 168(a0)
        fld fs8, 176(a0)
        fld fs9, 184(a0)
        fld fs10, 192(a0)
        fld fs11, 200(a0)
        snez t0, a1
        xori t0, t0, 1
        add a0, a1, t0
        ret
    .size _longjmp, . - _longjmp

    """
}

// The hosted stdlib uses x86-64 syscall numbers and layouts. This dispatcher
// translates the same contract as the AArch64 implementation.
private fun bootstrapLlvmRiscv64SyscallAssembly(): string {
    val dispatch = """
    .text
    .p2align 2
    .globl abla_x64_syscall
    .hidden abla_x64_syscall
    .type abla_x64_syscall,@function
    abla_x64_syscall:
        li t0, 335
        bgeu a0, t0, .Lrv_enosys
        mv t2, a0
        lla t0, .Lrv_numbers
        slli t1, a0, 1
        add t0, t0, t1
        lhu a7, 0(t0)
        mv a0, a1
        mv a1, a2
        mv a2, a3
        mv a3, a4
        mv a4, a5
        mv a5, a6
        li t0, 13
        beq t2, t0, .Lrv_sigaction
        li t0, 32768
        bltu a7, t0, .Lrv_call
        li t1, 65535
        beq a7, t1, .Lrv_enosys
        sub t1, a7, t0
        slli t1, t1, 2
        lla t0, .Lrv_handlers
        add t1, t1, t0
        lw t1, 0(t1)
        add t0, t0, t1
        jr t0
    .Lrv_call:
        ecall
        ret
    .Lrv_enosys:
        li a0, -38
        ret
    .p2align 1
    .Lrv_numbers:

    """
    val handlers = """
    .p2align 2
    .Lrv_handlers:
    .word .Lrv_open - .Lrv_handlers, .Lrv_stat - .Lrv_handlers, .Lrv_fstat - .Lrv_handlers, .Lrv_lstat - .Lrv_handlers
    .word .Lrv_poll - .Lrv_handlers, .Lrv_access - .Lrv_handlers, .Lrv_pipe - .Lrv_handlers, .Lrv_dup2 - .Lrv_handlers
    .word .Lrv_fork - .Lrv_handlers, .Lrv_rename - .Lrv_handlers, .Lrv_mkdir - .Lrv_handlers, .Lrv_rmdir - .Lrv_handlers
    .word .Lrv_link - .Lrv_handlers, .Lrv_unlink - .Lrv_handlers, .Lrv_symlink - .Lrv_handlers, .Lrv_readlink - .Lrv_handlers
    .word .Lrv_chmod - .Lrv_handlers, .Lrv_chown - .Lrv_handlers, .Lrv_lchown - .Lrv_handlers, .Lrv_getpgrp - .Lrv_handlers
    .word .Lrv_utimes - .Lrv_handlers, .Lrv_clone - .Lrv_handlers, .Lrv_openat - .Lrv_handlers, .Lrv_fstatat - .Lrv_handlers
    .word .Lrv_epoll_create - .Lrv_handlers, .Lrv_epoll_wait - .Lrv_handlers, .Lrv_epoll_ctl - .Lrv_handlers, .Lrv_epoll_pwait - .Lrv_handlers

    # RV64 shares x86-64's generic open flags.
    .Lrv_open:
        mv a3, a2
        mv a2, a1
        mv a1, a0
        li a0, -100
    .Lrv_openat:
        li a7, 56
        j .Lrv_call

    # Translate generic struct stat to the x86-64 layout in a caller-owned buffer.
    .Lrv_lstat:
        li a3, 256
        j 1f
    .Lrv_stat:
        li a3, 0
    1:  mv a2, a1
        mv a1, a0
        li a0, -100
    .Lrv_fstatat:
        mv t2, a2
        li a7, 79
        j .Lrv_stat_result
    .Lrv_fstat:
        mv t2, a1
        li a7, 80
    .Lrv_stat_result:
        ecall
        bnez a0, 1f
        lwu t0, 16(t2)
        lwu t1, 20(t2)
        lwu t3, 24(t2)
        lwu t4, 28(t2)
        ld t5, 32(t2)
        lw t6, 56(t2)
        sd t1, 16(t2)
        sw t0, 24(t2)
        sw t3, 28(t2)
        sw t4, 32(t2)
        sw zero, 36(t2)
        sd t5, 40(t2)
        sd t6, 56(t2)
    1:  ret

    # poll uses a millisecond timeout; ppoll takes a nullable timespec.
    .Lrv_poll:
        addi sp, sp, -16
        sext.w a2, a2
        bltz a2, 1f
        li t0, 1000
        div t1, a2, t0
        rem t2, a2, t0
        li t0, 1000000
        mul t2, t2, t0
        sd t1, 0(sp)
        sd t2, 8(sp)
        mv a2, sp
        j 2f
    1:  li a2, 0
    2:  li a3, 0
        li a4, 8
        li a7, 73
        ecall
        addi sp, sp, 16
        ret

    .Lrv_access:
        mv a2, a1
        mv a1, a0
        li a0, -100
        li a7, 48
        j .Lrv_call
    .Lrv_pipe:
        li a1, 0
        li a7, 59
        j .Lrv_call
    .Lrv_dup2:
        beq a0, a1, 1f
        li a2, 0
        li a7, 24
        j .Lrv_call
    1:  mv t0, a0
        li a1, 1
        li a7, 25
        ecall
        bltz a0, 2f
        mv a0, t0
    2:  ret
    .Lrv_fork:
        li a0, 17
        li a1, 0
        li a2, 0
        li a3, 0
        li a4, 0
        li a7, 220
        j .Lrv_call
    .Lrv_rename:
        mv a3, a1
        li a2, -100
        mv a1, a0
        li a0, -100
        li a4, 0
        li a7, 276
        j .Lrv_call
    .Lrv_mkdir:
        mv a2, a1
        mv a1, a0
        li a0, -100
        li a7, 34
        j .Lrv_call
    .Lrv_rmdir:
        li a2, 512
        j 1f
    .Lrv_unlink:
        li a2, 0
    1:  mv a1, a0
        li a0, -100
        li a7, 35
        j .Lrv_call
    .Lrv_link:
        mv a3, a1
        li a2, -100
        mv a1, a0
        li a0, -100
        li a4, 0
        li a7, 37
        j .Lrv_call
    .Lrv_symlink:
        mv a2, a1
        li a1, -100
        li a7, 36
        j .Lrv_call
    .Lrv_readlink:
        mv a3, a2
        mv a2, a1
        mv a1, a0
        li a0, -100
        li a7, 78
        j .Lrv_call
    .Lrv_chmod:
        mv a2, a1
        mv a1, a0
        li a0, -100
        li a7, 53
        j .Lrv_call
    .Lrv_chown:
        li a4, 0
        j 1f
    .Lrv_lchown:
        li a4, 256
    1:  mv a3, a2
        mv a2, a1
        mv a1, a0
        li a0, -100
        li a7, 54
        j .Lrv_call
    .Lrv_getpgrp:
        li a0, 0
        li a7, 155
        j .Lrv_call
    .Lrv_utimes:
        addi sp, sp, -32
        beqz a1, 1f
        li t4, 1000
        ld t0, 0(a1)
        ld t1, 8(a1)
        ld t2, 16(a1)
        ld t3, 24(a1)
        mul t1, t1, t4
        mul t3, t3, t4
        sd t0, 0(sp)
        sd t1, 8(sp)
        sd t2, 16(sp)
        sd t3, 24(sp)
        mv a1, sp
    1:  mv a2, a1
        mv a1, a0
        li a0, -100
        li a3, 0
        li a7, 88
        ecall
        addi sp, sp, 32
        ret
    .Lrv_clone:
        mv t0, a3
        mv a3, a4
        mv a4, t0
        li a7, 220
        j .Lrv_call

    # epoll has a 16-byte generic record and the x86-64 API uses a 12-byte record.
    .Lrv_epoll_create:
        li a0, 0
        li a7, 20
        j .Lrv_call
    .Lrv_epoll_ctl:
        addi sp, sp, -16
        beqz a3, 1f
        lw t0, 0(a3)
        lw t1, 4(a3)
        lw t2, 8(a3)
        sw t0, 0(sp)
        sw zero, 4(sp)
        sw t1, 8(sp)
        sw t2, 12(sp)
        mv a3, sp
    1:  li a7, 21
        ecall
        addi sp, sp, 16
        ret
    .Lrv_epoll_wait:
        li a4, 0
        li a5, 8
    .Lrv_epoll_pwait:
        addi sp, sp, -1024
        li t0, 64
        ble a2, t0, 1f
        mv a2, t0
    1:  mv t2, a1
        mv a1, sp
        li a7, 22
        ecall
        blez a0, 3f
        mv t0, sp
        mv t1, a0
    2:  lw t3, 0(t0)
        lw t4, 8(t0)
        lw t5, 12(t0)
        sw t3, 0(t2)
        sw t4, 4(t2)
        sw t5, 8(t2)
        addi t0, t0, 16
        addi t2, t2, 12
        addi t1, t1, -1
        bnez t1, 2b
    3:  addi sp, sp, 1024
        ret

    # Linux RV64 omits sa_restorer. Adapt both directions of the x86-64 ABI.
    .Lrv_sigaction:
        addi sp, sp, -64
        sd a2, 48(sp)
        beqz a1, 1f
        ld t0, 0(a1)
        ld t1, 8(a1)
        ld t2, 24(a1)
        li t3, -67108865
        and t1, t1, t3
        sd t0, 0(sp)
        sd t1, 8(sp)
        sd t2, 16(sp)
        mv a1, sp
    1:  beqz a2, 2f
        addi a2, sp, 24
    2:  li a7, 134
        ecall
        bnez a0, 3f
        ld t0, 48(sp)
        beqz t0, 3f
        ld t1, 24(sp)
        ld t2, 32(sp)
        ld t3, 40(sp)
        sd t1, 0(t0)
        sd t2, 8(t0)
        sd zero, 16(t0)
        sd t3, 24(t0)
    3:  addi sp, sp, 64
        ret
    .size abla_x64_syscall, . - abla_x64_syscall

    """
    dispatch + bootstrapLlvmLinuxGenericSyscallNumbers() + handlers
}

// clone and join follow the Linux clear-child-tid and futex protocol.
private fun bootstrapLlvmRiscv64ThreadAssembly(): string {
    """
    .text
    .p2align 2
    .globl abla_clone_create
    .hidden abla_clone_create
    .type abla_clone_create,@function
    abla_clone_create:
        addi sp, sp, -96
        sd ra, 88(sp)
        sd s1, 16(sp)
        sd s2, 24(sp)
        sd s3, 32(sp)
        sd s4, 40(sp)
        sd s5, 48(sp)
        sd s6, 56(sp)
        sd s7, 64(sp)
        sd s8, 72(sp)
        mv s1, a0
        mv s2, a2
        mv s3, a3
        # prlimit64(0, RLIMIT_STACK, NULL, &limit)
        li a0, 0
        li a1, 3
        li a2, 0
        mv a3, sp
        li a7, 261
        ecall
        bnez a0, 1f
        ld s4, 0(sp)
        li t0, -1
        beq s4, t0, 1f
        li t0, 65536
        bgeu s4, t0, 2f
    1:  li s4, 8388608
    2:  li t0, 4095
        add s4, s4, t0
        not t0, t0
        and s4, s4, t0
        lla a0, abla_start_phdr
        ld a0, 0(a0)
        lla a1, abla_start_phnum
        ld a1, 0(a1)
        call abla_tls_bytes
        bltz a0, 90f
        mv s5, a0
        add s6, s4, s5
        li t0, 73728
        add s6, s6, t0
        # One mapping for guard, stack, signal stack, TLS and control page.
        li a0, 0
        mv a1, s6
        li a2, 3
        li a3, 0x20022
        li a4, -1
        li a5, 0
        li a7, 222
        ecall
        li t0, -4095
        bgeu a0, t0, 91f
        mv s7, a0
        li a1, 4096
        li a2, 0
        li a7, 226
        ecall
        bltz a0, 92f
        li t0, 4096
        add s8, s7, s6
        sub s8, s8, t0
        add t1, s7, t0
        add t1, t1, s4
        sd zero, 0(s8)
        sd s7, 8(s8)
        sd s6, 16(s8)
        sd s2, 24(s8)
        sd s3, 32(s8)
        sd t1, 40(s8)
        li t0, 65536
        add a0, t1, t0
        lla a1, abla_start_phdr
        ld a1, 0(a1)
        lla a2, abla_start_phnum
        ld a2, 0(a2)
        call abla_tls_init
        mv a3, a0
        li a0, 0x3d0f00
        ld a1, 40(s8)
        mv a2, s8
        mv a4, s8
        li a7, 220
        ecall
        beqz a0, 5f
        bltz a0, 92f
        sd s8, 0(s1)
        li a0, 0
        j 99f
    5:  li s0, 0
        addi sp, sp, -32
        ld t0, 40(s8)
        sd t0, 0(sp)
        sd zero, 8(sp)
        li t0, 65536
        sd t0, 16(sp)
        mv a0, sp
        li a1, 0
        li a7, 132
        ecall
        addi sp, sp, 32
        ld a0, 32(s8)
        ld t0, 24(s8)
        jalr t0
    6:  li a0, 0
        li a7, 93
        ecall
        j 6b
    92: neg s1, a0
        mv a0, s7
        mv a1, s6
        li a7, 215
        ecall
        mv a0, s1
        j 99f
    91: neg a0, a0
        j 99f
    90: li a0, 22
    99: ld s1, 16(sp)
        ld s2, 24(sp)
        ld s3, 32(sp)
        ld s4, 40(sp)
        ld s5, 48(sp)
        ld s6, 56(sp)
        ld s7, 64(sp)
        ld s8, 72(sp)
        ld ra, 88(sp)
        addi sp, sp, 96
        ret
    .size abla_clone_create, . - abla_clone_create

    .globl abla_clone_join
    .hidden abla_clone_join
    .type abla_clone_join,@function
    abla_clone_join:
        mv t0, a0
    1:  lw a2, 0(t0)
        beqz a2, 2f
        mv a0, t0
        li a1, 0
        li a3, 0
        li a7, 98
        ecall
        j 1b
    2:  fence r, rw
        ld a0, 8(t0)
        ld a1, 16(t0)
        li a7, 215
        ecall
        li a0, 0
        ret
    .size abla_clone_join, . - abla_clone_join

    """
}

fun bootstrapLlvmEmitRiscv64Routines(backend: BootstrapLlvmBackend): void {
    // opt also parses module assembly when it looks for referenced globals.
    val assembly = ".option push\n.option arch, rv64gc\n" +
        bootstrapLlvmRiscv64SyscallAssembly() + bootstrapLlvmRiscv64StartAssembly() +
        bootstrapLlvmRiscv64MemoryAssembly() + bootstrapLlvmRiscv64JumpAssembly() +
        bootstrapLlvmRiscv64ThreadAssembly() + ".option pop\n"
    LLVMAppendModuleInlineAsm(backend.module, assembly, assembly.size)
    return
}
