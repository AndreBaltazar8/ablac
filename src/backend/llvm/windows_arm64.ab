// The CRT-free Windows ARM64 routines. Shared entry and TLS data live in windows.ab.
// The stack probe takes bytes / 16 in x15 and leaves SP and x15 intact.
// The private jump buffer holds the integer and FP nonvolatiles, SP and LR.
// The thread routines have COFF unwind records for their frames.
// The routines under C library names are weak externals, as on x64 (windows.ab, bootstrapLlvmWindowsLibraryFunction).
// abla_windows_redirect is x64's (windows.ab) on the ARM64 CONTEXT: Pc at 0x108, X0 at 8, X1 at 16, Sp (0x100) aligned down to 16;
// abla_windows_context_prepare sets ContextFlags (0) to CONTEXT_ARM64 | CONTROL | INTEGER (0x400003), abla_windows_context_pc reads Pc,
// abla_windows_stack_pointer returns the caller's SP.

fun bootstrapLlvmWindowsArm64Routines(): string {
    """
    .text
    .p2align 2
    .def memcpy
    .scl 2
    .type 32
    .endef
    .weak memcpy
    .def memmove
    .scl 2
    .type 32
    .endef
    .weak memmove
    memcpy:
    memmove:
        cbz x2, 4f
        cmp x0, x1
        b.ls 2f
        sub x3, x0, x1
        cmp x3, x2
        b.hs 2f
        add x3, x0, x2
        add x1, x1, x2
    1:  ldrb w4, [x1, #-1]!
        strb w4, [x3, #-1]!
        subs x2, x2, #1
        b.ne 1b
        ret
    2:  mov x3, x0
    3:  ldrb w4, [x1], #1
        strb w4, [x3], #1
        subs x2, x2, #1
        b.ne 3b
    4:  ret

    .def memset
    .scl 2
    .type 32
    .endef
    .weak memset
    memset:
        mov x3, x0
        cbz x2, 2f
    1:  strb w1, [x3], #1
        subs x2, x2, #1
        b.ne 1b
    2:  ret

    .def memcmp
    .scl 2
    .type 32
    .endef
    .weak memcmp
    .def bcmp
    .scl 2
    .type 32
    .endef
    .weak bcmp
    memcmp:
    bcmp:
        cbz x2, 3f
    1:  ldrb w3, [x0], #1
        ldrb w4, [x1], #1
        cmp w3, w4
        b.ne 2f
        subs x2, x2, #1
        b.ne 1b
    3:  mov w0, wzr
        ret
    2:  sub w0, w3, w4
        ret

    .def strlen
    .scl 2
    .type 32
    .endef
    .weak strlen
    strlen:
        mov x1, x0
    1:  ldrb w2, [x1], #1
        cbnz w2, 1b
        sub x0, x1, x0
        sub x0, x0, #1
        ret

    .def __chkstk
    .scl 2
    .type 32
    .endef
    .weak __chkstk
    __chkstk:
        mov x16, sp
        sub x17, sp, x15, lsl #4
    1:  sub x16, x16, #1, lsl #12
        cmp x16, x17
        b.ls 2f
        ldrb wzr, [x16]
        b 1b
    2:  ldrb wzr, [x17]
        ret

    .def abla_windows_redirect
    .scl 2
    .type 32
    .endef
    .globl abla_windows_redirect
    abla_windows_redirect:
        str x1, [x0, #0x108]
        str x2, [x0, #8]
        str x3, [x0, #16]
        ldr x16, [x0, #0x100]
        and x16, x16, #-16
        str x16, [x0, #0x100]
        ret

    .def abla_windows_context_prepare
    .scl 2
    .type 32
    .endef
    .globl abla_windows_context_prepare
    abla_windows_context_prepare:
        mov w16, #3
        movk w16, #0x40, lsl #16
        str w16, [x0]
        ret

    .def abla_windows_context_pc
    .scl 2
    .type 32
    .endef
    .globl abla_windows_context_pc
    abla_windows_context_pc:
        ldr x0, [x0, #0x108]
        ret

    .def abla_windows_stack_pointer
    .scl 2
    .type 32
    .endef
    .globl abla_windows_stack_pointer
    abla_windows_stack_pointer:
        mov x0, sp
        ret

    .def _setjmp
    .scl 2
    .type 32
    .endef
    .globl _setjmp
    .def abla_setjmp
    .scl 2
    .type 32
    .endef
    .globl abla_setjmp
    _setjmp:
    abla_setjmp:
        stp x19, x20, [x0]
        stp x21, x22, [x0, #16]
        stp x23, x24, [x0, #32]
        stp x25, x26, [x0, #48]
        stp x27, x28, [x0, #64]
        stp x29, x30, [x0, #80]
        mov x1, sp
        str x1, [x0, #96]
        stp d8, d9, [x0, #104]
        stp d10, d11, [x0, #120]
        stp d12, d13, [x0, #136]
        stp d14, d15, [x0, #152]
        mrs x1, fpcr
        str x1, [x0, #168]
        mov w0, wzr
        ret

    .def _longjmp
    .scl 2
    .type 32
    .endef
    .globl _longjmp
    .def abla_longjmp
    .scl 2
    .type 32
    .endef
    .globl abla_longjmp
    _longjmp:
    abla_longjmp:
        ldp x19, x20, [x0]
        ldp x21, x22, [x0, #16]
        ldp x23, x24, [x0, #32]
        ldp x25, x26, [x0, #48]
        ldp x27, x28, [x0, #64]
        ldp x29, x30, [x0, #80]
        ldr x2, [x0, #96]
        ldp d8, d9, [x0, #104]
        ldp d10, d11, [x0, #120]
        ldp d12, d13, [x0, #136]
        ldp d14, d15, [x0, #152]
        ldr x3, [x0, #168]
        msr fpcr, x3
        cmp w1, #0
        csinc w0, w1, wzr, ne
        mov sp, x2
        ret

    .seh_proc abla_win_thread_start
    abla_win_thread_start:
        stp x29, x30, [sp, #-32]!
        .seh_save_fplr_x 32
        str x19, [sp, #16]
        .seh_save_reg x19, 16
        mov x29, sp
        .seh_set_fp
        .seh_endprologue
        mov x19, x0
        ldp x16, x0, [x19]
        blr x16
        bl GetProcessHeap
        mov w1, wzr
        mov x2, x19
        bl HeapFree
        mov w0, wzr
        .seh_startepilogue
        ldr x19, [sp, #16]
        .seh_save_reg x19, 16
        ldp x29, x30, [sp], #32
        .seh_save_fplr_x 32
        .seh_endepilogue
        ret
        .seh_endproc

    .def pthread_create
    .scl 2
    .type 32
    .endef
    .globl pthread_create
    .seh_proc pthread_create
    pthread_create:
        stp x29, x30, [sp, #-48]!
        .seh_save_fplr_x 48
        stp x19, x20, [sp, #16]
        .seh_save_regp x19, 16
        stp x21, x22, [sp, #32]
        .seh_save_regp x21, 32
        mov x29, sp
        .seh_set_fp
        .seh_endprologue
        mov x19, x0
        mov x20, x2
        mov x21, x3
        bl GetProcessHeap
        mov w1, wzr
        mov x2, #16
        bl HeapAlloc
        cbz x0, 1f
        mov x22, x0
        stp x20, x21, [x22]
        mov x0, xzr
        mov x1, xzr
        adr x2, abla_win_thread_start
        mov x3, x22
        mov w4, wzr
        mov x5, xzr
        bl CreateThread
        cbnz x0, 2f
        bl GetProcessHeap
        mov w1, wzr
        mov x2, x22
        bl HeapFree
    1:  mov w0, #11
        b 3f
    2:  str x0, [x19]
        mov w0, wzr
    3:  .seh_startepilogue
        ldp x21, x22, [sp, #32]
        .seh_save_regp x21, 32
        ldp x19, x20, [sp, #16]
        .seh_save_regp x19, 16
        ldp x29, x30, [sp], #48
        .seh_save_fplr_x 48
        .seh_endepilogue
        ret
        .seh_endproc

    .def pthread_join
    .scl 2
    .type 32
    .endef
    .globl pthread_join
    .seh_proc pthread_join
    pthread_join:
        stp x29, x30, [sp, #-32]!
        .seh_save_fplr_x 32
        str x19, [sp, #16]
        .seh_save_reg x19, 16
        mov x29, sp
        .seh_set_fp
        .seh_endprologue
        mov x19, x0
        mov w1, #-1
        bl WaitForSingleObject
        mov x0, x19
        bl CloseHandle
        mov w0, wzr
        .seh_startepilogue
        ldr x19, [sp, #16]
        .seh_save_reg x19, 16
        ldp x29, x30, [sp], #32
        .seh_save_fplr_x 32
        .seh_endepilogue
        ret
        .seh_endproc

    """
}
