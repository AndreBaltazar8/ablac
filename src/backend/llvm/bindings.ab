    module: i64*,
    failureAction: i32,
    message: i64*
): i32
noescape extern:"c" fun LLVMVerifyFunction(
    function: i64*,
    failureAction: i32
): i32
noescape extern:"c" fun LLVMWriteBitcodeToFile(
    module: i64*,
    path: cstring
): i32

