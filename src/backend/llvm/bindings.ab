// LLVM enums used by the wrapper. They are pinned to LLVM 21.
fun llvmExternalLinkage(): int = 0
fun llvmPrivateLinkage(): int = 9
fun llvmInternalLinkage(): int = 8
fun llvmHiddenVisibility(): int = 1
fun llvmHiddenVisibilityUnnamedAddress(): int = 2
fun llvmVerifierReturnStatus(): int = 2
fun llvmIntEqual(): int = 32
fun llvmIntNotEqual(): int = 33
fun llvmIntUnsignedGreaterThan(): int = 34
fun llvmIntUnsignedGreaterOrEqual(): int = 35
fun llvmIntUnsignedLessThan(): int = 36
fun llvmIntUnsignedLessOrEqual(): int = 37
fun llvmIntSignedGreaterThan(): int = 38
fun llvmIntSignedGreaterOrEqual(): int = 39
fun llvmIntSignedLessThan(): int = 40
fun llvmIntSignedLessOrEqual(): int = 41
fun llvmRealOrderedEqual(): int = 1
fun llvmRealOrderedGreaterThan(): int = 2
fun llvmRealOrderedGreaterOrEqual(): int = 3
fun llvmRealOrderedLessThan(): int = 4
fun llvmRealOrderedLessOrEqual(): int = 5
fun llvmRealUnorderedNotEqual(): int = 14

resource class LlvmPointerVector(
    val storage: i64*,
    val size: int,
    var closed: bool
) {
    trusted fun pointer(): i64* = storage

    trusted fun set(index: int, value: i64*): bool {
        var stored = false
        if (!closed && index >= 0 && index < size) {
            ablaUnsafeStorePointer(
                ablaUnsafePointerOffset(storage, index * 8),
                value
            )
            stored = true
        }
        stored
    }

    trusted fun drop(): void {
        if (!closed) {
            ablaUnsafeFree(storage)
            closed = true
        }
    }
}

trusted fun llvmPointerVector(size: int): LlvmPointerVector {
    var count = size
    if (count < 0) count = 0
    LlvmPointerVector(ablaUnsafeAllocate(count * 8), count, false)
}

resource class LlvmOwnedModule(
    val context: i64*,
    var module: i64*,
    val status: int,
    var closed: bool
) {
    fun valid(): bool = status == 0 && !closed && !pointerIsNull(module)

    fun verify(): int {
        var result = status
        if (result == 0 && !closed && !pointerIsNull(module)) {
            val message = nativePointerCell(nativeNullPointer())
            if (LLVMVerifyModule(
                module,
                llvmVerifierReturnStatus(),
                message.address
            ) != 0) {
                result = 162
                if (!pointerIsNull(message.load())) {
                    linuxWriteStandardError(
                        "LLVM verifier: ${borrowNativeCString(message.load())}"
                    )
                }
            }
            if (!pointerIsNull(message.load())) {
                LLVMDisposeMessage(message.load())
            }
            message.close()
        }
        result
    }

    fun writeText(path: string): int {
        var result = status
        if (result == 0 && !closed && !pointerIsNull(module)) {
            val message = nativePointerCell(nativeNullPointer())
            if (LLVMPrintModuleToFile(module, path, message.address) != 0) {
                result = 163
            }
            if (!pointerIsNull(message.load())) {
                LLVMDisposeMessage(message.load())
            }
            message.close()
        }
        result
    }

    fun writeBitcode(path: string): int {
        var result = status
        if (result == 0 && !closed && !pointerIsNull(module) &&
            LLVMWriteBitcodeToFile(module, path) != 0) result = 164
        result
    }

    trusted fun render(): string {
        var result = ""
        if (status == 0 && !closed && !pointerIsNull(module)) {
            val printed = LLVMPrintModuleToString(module)
            if (!pointerIsNull(printed)) {
                var length = 0
                while (ablaUnsafeLoadU8(
                    ablaUnsafePointerOffset(printed, length)
                ) != 0) length = length + 1
                val copy = nativeByteBuffer(length + 1)
                var index = 0
                while (index < length) {
                    copy.store(index, ablaUnsafeLoadU8(
                        ablaUnsafePointerOffset(printed, index)
                    ))
                    index = index + 1
                }
                copy.store(length, 0)
                result = copy.adoptString(length)
                LLVMDisposeMessage(printed)
            }
        }
        result
    }

    fun drop(): void {
        if (!closed) {
            if (!pointerIsNull(module)) LLVMDisposeModule(module)
            LLVMContextDispose(context)
            module = nativeNullPointer()
            closed = true
        }
    }
}

resource class LlvmOwnedBuilder(
    val raw: i64*,
    var closed: bool
) {
    fun position(block: i64*): void {
        if (!closed) LLVMPositionBuilderAtEnd(raw, block)
    }

    fun drop(): void {
        if (!closed) {
            LLVMDisposeBuilder(raw)
            closed = true
        }
    }
}

fun llvmBuilder(context: i64*): LlvmOwnedBuilder =
    LlvmOwnedBuilder(LLVMCreateBuilderInContext(context), false)
