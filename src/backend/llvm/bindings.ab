// LLVM 21 C API boundary for the direct backend. Ownership wrappers for
// contexts, modules, builders, and temporary pointer vectors live here too.

import "abla/llvm/aot"
import "abla/unsafe/memory"
import "abla/sys/linux"

// Core module and verification API.
