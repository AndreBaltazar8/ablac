import "core.ab"
import "analysis.ab"
import "bindings.ab"
import "functions.ab"
import "live.ab"
import "../../ir.ab"
import "../../module_paths.ab"
import "abla/text"
import "abla/unsafe/memory/raw"

// New globals across generations of `ablac run --live` (docs/design/live-jit.md, "New globals"). A reload whose
// program has a variable the running one does not gets that variable's initializer run once, when the reload
// applies: the running program's own initializer (__bootstrap_globals) ran long ago and must not run again.
//
// Before the backend, the reload's initializer (__bootstrap_globals and the pieces it calls) is cut at its stores:
// each new global's range is its instructions after the previous store (or piece call) up to its own store, in
// declaration order (#1033). The ranges, renumbered one after the other, are a function of their own
// (`__bootstrap_globals_live`) that enters the runtime as an export's caller does (__ablaRuntimeLiveEnter: the
// --watch thread was never started by the program) and leaves it at the end. The backend wraps it in an entry the
// compiler calls once the module is linked and before the table is published (bootstrapLlvmLiveGlobalsEntry,
// live_reload.ab), which first publishes the new non-scalar globals as collector roots in a frame that is never
// popped (as an export's globals are). A range that reads a value from before it can't run alone: the reload is refused
// (E_LIVE_GLOBAL, naming the variable).

val bootstrapLlvmLiveGlobalsName = "__bootstrap_globals_live"

fun bootstrapLlvmLiveGlobalShifted(instruction: BootstrapInstruction, values: int,
    labels: int): BootstrapInstruction {
    val labelled = instruction.opcode == "label" || instruction.opcode == "jump" ||
        instruction.opcode == "branch"
    val operands: array<int> = []
    for (operand in instruction.operands) operands.append(if (operand >= 0) operand + values else operand)
    BootstrapInstruction(
        instruction.opcode,
        if (instruction.result >= 0) instruction.result + values else instruction.result,
        if (instruction.left >= 0) instruction.left + values else instruction.left,
        if (instruction.right >= 0) instruction.right + values else instruction.right,
        instruction.text,
        if (labelled && instruction.target >= 0) instruction.target + labels else instruction.target,
        if (instruction.opcode == "branch" && instruction.alternate >= 0) instruction.alternate + labels
            else instruction.alternate,
        operands,
        instruction.texts,
        instruction.position
    )
}

// Defined by the running program: the symbol as emitted, or as promoted to a hidden external name (live.ab).
fun bootstrapLlvmLiveGlobalDefined(symbol: string): bool =
    bootstrapLlvmLiveIsDefined(symbol) || bootstrapLlvmLiveIsDefined("__abla_unit.$symbol")

// A global of the program's own files (its store's position): the standard library's and the runtime's are not
// the program's to add, and some of them are no LLVM variable at all.
fun bootstrapLlvmLiveGlobalOwn(instruction: BootstrapInstruction, stdlibRoot: string): bool {
    val file = bootstrapIrSourcePositionFile(instruction.position)
    if (file < 0 || file >= bootstrapIrSourceFiles.size) return false
    val path = bootstrapNormalizeModulePath(bootstrapIrSourceFiles[file])
    !(stdlibRoot != "" && path.startsWith(stdlibRoot))
}

fun bootstrapLlvmLiveGlobalsPass(program: BootstrapIrProgram, stdlibRoot: string): BootstrapIrProgram {
    bootstrapLlvmLiveNewGlobals = Map()
    bootstrapLlvmLiveNewGlobalNames = []
    bootstrapLlvmLiveGlobalRefusals = []
    if (bootstrapLlvmLiveGeneration == 0) return program
    val fresh: Map<string, int> = Map()
    var freshCount = 0
    for (name in program.globalNames) {
        if (!bootstrapLlvmLiveGlobalDefined(bootstrapLlvmGlobalSymbol(name))) {
            fresh.set(name, 1)
            freshCount = freshCount + 1
        }
    }
    if (freshCount == 0) return program
    // The initializer's pieces first (they run first, in order), then __bootstrap_globals itself.
    val pieces: array<int> = []
    var main = -1
    var index = 0
    while (index < program.functions.size) {
        val name = program.functions[index].name
        if (name == "__bootstrap_globals") main = index
        else if (bootstrapLlvmModuleInitializer(name) && name != bootstrapLlvmLiveGlobalsName) pieces.append(index)
        index = index + 1
    }
    if (main < 0) return program
    pieces.append(main)
    val body: array<BootstrapInstruction> = []
    var values = 0
    var labels = 0
    for (piece in pieces) {
        val instructions = program.functions[piece].instructions
        var start = 0
        var at = 0
        while (at < instructions.size) {
            val instruction = instructions[at]
            if (instruction.opcode == "call" && bootstrapLlvmModuleInitializer(instruction.text)) {
                start = at + 1
            } else if (instruction.opcode == "global.store") {
                if (fresh.get(instruction.text) != null && bootstrapLlvmLiveGlobalOwn(instruction, stdlibRoot)) {
                    val range: array<BootstrapInstruction> = []
                    var taken = start
                    while (taken <= at) {
                        range.append(bootstrapLlvmLiveGlobalShifted(instructions[taken], 0, 0))
                        taken = taken + 1
                    }
                    val renumbered = bootstrapIrRenumbered(range)
                    if (renumbered.size == 0) {
                        bootstrapLlvmLiveGlobalRefusals.append(
                            "E_LIVE_GLOBAL: a variable the running program does not have (${instruction.text}): its initializer uses a value computed before it, so it can't run alone"
                        )
                    } else {
                        var topValue = -1
                        var topLabel = -1
                        for (moved in renumbered) {
                            val shifted = bootstrapLlvmLiveGlobalShifted(moved, values, labels)
                            body.append(shifted)
                            if (moved.result > topValue) topValue = moved.result
                            if (moved.opcode == "label" && moved.target > topLabel) topLabel = moved.target
                        }
                        values = values + topValue + 1
                        labels = labels + topLabel + 1
                        val newSymbol = bootstrapLlvmGlobalSymbol(instruction.text)
                        bootstrapLlvmLiveNewGlobals.set(newSymbol, 1)
                        bootstrapLlvmLiveNewGlobals.set("__abla_unit.$newSymbol", 1)
                        bootstrapLlvmLiveNewGlobalNames.append(instruction.text)
                    }
                }
                start = at + 1
            }
            at = at + 1
        }
    }
    if (bootstrapLlvmLiveNewGlobalNames.size == 0) return program
    body.append(BootstrapInstruction("const.void", values, -1, -1, "", -1, -1, [], [], -1))
    val initializer = bootstrapFinalizeIrFunction(bootstrapLlvmLiveGlobalsName, [], body, values, [], "void")
    // The reload's __bootstrap_globals calls it and the runtime's enter and leave (the entry calls those around it,
    // bootstrapLlvmLiveGlobalsEntry), so the backend emits them and what they call; the running program's
    // __bootstrap_globals is the one that exists (the reload's becomes a declaration of it), so those calls never run.
    val functions: array<BootstrapIrFunction> = []
    index = 0
    for (function in program.functions) {
        if (index != main) functions.append(function)
        else {
            var top = -1
            for (instruction in function.instructions) if (instruction.result > top) top = instruction.result
            val calling: array<BootstrapInstruction> = [
                BootstrapInstruction("call", top + 1, -1, -1, "__ablaRuntimeLiveEnter", -1, -1, [], [], -1),
                BootstrapInstruction("call", top + 2, -1, -1, bootstrapLlvmLiveGlobalsName, -1, -1, [], [], -1),
                BootstrapInstruction("call", top + 3, -1, -1, "__ablaRuntimeLiveLeave", -1, -1, [], [], -1)
            ]
            for (instruction in function.instructions) calling.append(bootstrapLlvmLiveGlobalShifted(instruction, 0, 0))
            functions.append(bootstrapFinalizeIrFunction(function.name, function.parameters, calling,
                function.result, function.parameterTypes, function.resultType))
        }
        index = index + 1
    }
    functions.append(initializer)
    BootstrapIrProgram(
        program.instructions, functions, program.classes, program.natives,
        program.globalNames, program.globalTypes, program.globalKinds, program.compileInputPaths,
        program.compileInputContents, program.errors, program.lookup, program.validationFailures,
        program.extensionFields
    )
}

// The entry the compiler calls once a reload with new globals is linked: `abla_live_globals_<generation>`.
fun bootstrapLlvmLiveGlobalsEntryName(generation: int): string = "abla_live_globals_$generation"

// A function of the program as emitted: its direct body or its uniform one, under its symbol or promoted (live.ab);
// null when it was not emitted.
trusted fun bootstrapLlvmLiveEmitted(backend: BootstrapLlvmBackend, program: BootstrapIrProgram,
    identities: BootstrapLlvmFunctionIdentities, name: string): i64* {
    var found = nativeNullPointer()
    var index = 0
    while (index < program.functions.size && index < identities.symbols.size) {
        if (program.functions[index].name == name) {
            val symbol = identities.symbols[index]
            val direct = bootstrapLlvmDirectFunctionSymbol(symbol)
            for (candidate in [direct, "__abla_unit.$direct", symbol, "__abla_unit.$symbol"]) {
                if (pointerIsNull(found)) found = LLVMGetNamedFunction(backend.module, candidate)
            }
        }
        index = index + 1
    }
    found
}

// A call of an emitted function that takes no arguments, by the form found: none, an output, or the uniform one
// (output, arguments, count).
trusted fun bootstrapLlvmLiveCallEmitted(backend: BootstrapLlvmBackend, function: i64*): bool {
    val parameters = int(LLVMCountParams(function))
    if (parameters == 0) {
        bootstrapLlvmCall(backend, function, [], "", false, [])
        return true
    }
    val output = LLVMBuildAlloca(backend.builder, backend.valueType, "live.globals.output")
    if (parameters == 1) {
        bootstrapLlvmCall(backend, function, [output], "", true, [false])
        return true
    }
    if (parameters == 3) {
        bootstrapLlvmCall(backend, function,
            [output, LLVMConstNull(backend.pointerType), LLVMConstInt(backend.i64Type, 0, 0)],
            "", true, [false, false, false])
        return true
    }
    false
}

// i64 abla_live_globals_<generation>(ptr buffer, i64 capacity): enters the runtime (__ablaRuntimeLiveEnter: the
// --watch thread is not the program's, and a program thread in liveReload is in native code), publishes the new
// variables that hold references as roots in a static frame that is never popped, and runs their initializers
// under a recovery frame (as an export's checked call does, bootstrapLlvmDefineCheckedInvoke). 0 when they ran;
// 1 when one panicked, its message at buffer + 8 and its length at buffer (the runtime copied it before it
// longjmp'd back): then the static frame comes off the chain (the compiler removes this generation) and the
// thread leaves the runtime as it entered.
trusted fun bootstrapLlvmLiveGlobalsEntry(backend: BootstrapLlvmBackend, program: BootstrapIrProgram,
    identities: BootstrapLlvmFunctionIdentities, generation: int): void {
    if (bootstrapLlvmLiveNewGlobalNames.size == 0) return
    val initializer = bootstrapLlvmLiveEmitted(backend, program, identities, bootstrapLlvmLiveGlobalsName)
    val enter = bootstrapLlvmLiveEmitted(backend, program, identities, "__ablaRuntimeLiveEnter")
    val leave = bootstrapLlvmLiveEmitted(backend, program, identities, "__ablaRuntimeLiveLeave")
    if (pointerIsNull(initializer) || pointerIsNull(enter) || pointerIsNull(leave)) {
        bootstrapLlvmLiveRefusals.append(
            "E_LIVE_GLOBAL: the new variables' initializer was not compiled (${bootstrapLlvmLiveNewGlobalNames.join(", ")})"
        )
        return
    }
    val pointer = backend.pointerType
    val name = bootstrapLlvmLiveGlobalsEntryName(generation)
    val entry = LLVMAddFunction(backend.module, name,
        bootstrapLlvmFunctionType(backend, backend.i64Type, [pointer, backend.i64Type]))
    LLVMSetLinkage(entry, llvmExternalLinkage())
    LLVMSetVisibility(entry, llvmHiddenVisibility())
    bootstrapLlvmAddFunctionAttribute(backend, entry, "noinline")
    val buffer = LLVMGetParam(entry, i32(0))
    val capacity = LLVMGetParam(entry, i32(1))
    val start = LLVMAppendBasicBlockInContext(backend.context, entry, "entry")
    val call = LLVMAppendBasicBlockInContext(backend.context, entry, "call")
    val panicked = LLVMAppendBasicBlockInContext(backend.context, entry, "panicked")
    LLVMPositionBuilderAtEnd(backend.builder, start)
    if (!bootstrapLlvmLiveCallEmitted(backend, enter)) {
        bootstrapLlvmLiveRefusals.append("E_LIVE_GLOBAL: the runtime's entry could not be called")
    }
    // The new variables that hold references are roots from before their initializers run (a collection may come
    // in the middle), in a frame never popped: at the thread's outermost leave it moves to the registry's chain.
    val roots: array<i64*> = []
    for (global in bootstrapLlvmLiveNewGlobalNames) {
        if (bootstrapLlvmGlobalScalarType(program, global) == "") {
            val emitted = bootstrapLlvmGlobalSymbol(global)
            var symbol = LLVMGetNamedGlobal(backend.module, emitted)
            if (pointerIsNull(symbol)) symbol = LLVMGetNamedGlobal(backend.module, "__abla_unit.$emitted")
            if (!pointerIsNull(symbol)) roots.append(symbol)
        }
    }
    var frame = nativeNullPointer()
    if (roots.size > 0) {
        val values = llvmPointerVector(roots.size)
        var root = 0
        while (root < roots.size) {
            values.set(root, roots[root])
            root = root + 1
        }
        val rootsType = LLVMArrayType2(pointer, roots.size)
        val rootsGlobal = LLVMAddGlobal(backend.module, rootsType, "abla.live.globals.roots.$generation")
        LLVMSetInitializer(rootsGlobal, LLVMConstArray2(pointer, values.pointer(), roots.size))
        values.drop()
        LLVMSetLinkage(rootsGlobal, llvmInternalLinkage())
        frame = LLVMAddGlobal(backend.module, backend.rootFrameType, "abla.live.globals.frame.$generation")
        LLVMSetInitializer(frame, LLVMConstNull(backend.rootFrameType))
        LLVMSetLinkage(frame, llvmInternalLinkage())
        val push = bootstrapLlvmDeclare(
            backend, "abla_runtime_roots_push", backend.voidType,
            [pointer, pointer, backend.i64Type],
            false, [false, false, false]
        )
        bootstrapLlvmCall(backend, push, [frame, rootsGlobal, LLVMConstInt(backend.i64Type, roots.size, 0)],
            "", false, [false, false, false])
    }
    // 48 bytes of recovery frame (see the runtime), then a jmp_buf (bootstrapLlvmDefineCheckedInvoke's layout).
    val setjmp = bootstrapLlvmDeclare(backend, "_setjmp", backend.i32Type, [pointer], false, [false])
    bootstrapLlvmAddFunctionAttribute(backend, setjmp, "returns_twice")
    val recovery = LLVMBuildAlloca(backend.builder, LLVMArrayType2(backend.i8Type, 560), "recovery.frame")
    LLVMSetAlignment(recovery, 16)
    val jumpOffset = llvmPointerVector(1)
    jumpOffset.set(0, LLVMConstInt(backend.i64Type, 48, 0))
    val jumpBuffer = LLVMBuildGEP2(backend.builder, backend.i8Type, recovery, jumpOffset.pointer(), 1,
        "recovery.jmp_buf")
    jumpOffset.drop()
    val resumed = bootstrapLlvmCall(backend, setjmp, [jumpBuffer], "recovery.resumed", false, [false])
    LLVMBuildCondBr(backend.builder,
        LLVMBuildICmp(backend.builder, llvmIntEqual(), resumed, LLVMConstInt(backend.i32Type, 0, 0),
            "recovery.first"),
        call, panicked)
    LLVMPositionBuilderAtEnd(backend.builder, call)
    val messageOffset = llvmPointerVector(1)
    messageOffset.set(0, LLVMConstInt(backend.i64Type, 8, 0))
    val message = LLVMBuildGEP2(backend.builder, backend.i8Type, buffer, messageOffset.pointer(), 1,
        "panic.message")
    messageOffset.drop()
    val room = LLVMBuildSub(backend.builder, capacity, LLVMConstInt(backend.i64Type, 8, 0), "panic.capacity")
    bootstrapLlvmCallNamed(backend, "abla_runtime_recovery_enter", [recovery, message, room, buffer],
        "", false, [false, false, false, false])
    if (!bootstrapLlvmLiveCallEmitted(backend, initializer)) {
        bootstrapLlvmLiveRefusals.append(
            "E_LIVE_GLOBAL: the new variables' initializer could not be called (${bootstrapLlvmLiveNewGlobalNames.join(", ")})"
        )
    }
    bootstrapLlvmCallNamed(backend, "abla_runtime_recovery_leave", [recovery], "", false, [false])
    bootstrapLlvmLiveCallEmitted(backend, leave)
    LLVMBuildRet(backend.builder, LLVMConstInt(backend.i64Type, 0, 0))
    LLVMPositionBuilderAtEnd(backend.builder, panicked)
    bootstrapLlvmCallNamed(backend, "abla_runtime_recovery_restore", [recovery], "", false, [false])
    if (!pointerIsNull(frame)) {
        bootstrapLlvmCallNamed(backend, "abla_runtime_roots_pop", [frame], "", false, [false])
    }
    bootstrapLlvmLiveCallEmitted(backend, leave)
    LLVMBuildRet(backend.builder, LLVMConstInt(backend.i64Type, 1, 0))
    return
}
