import "core.ab"

fun bootstrapLlvmDeclareRuntime(
    backend: BootstrapLlvmBackend,
    program: BootstrapIrProgram
): void {
    val pointer = backend.pointerType
    val i1 = backend.i1Type
    val i32 = backend.i32Type
    val i64 = backend.i64Type
    val value0 = [
        "abla_void", "abla_null"
    ]
    var index = 0
    while (index < value0.size) {
        bootstrapLlvmDeclareValueRuntime(backend, value0[index], 0)
        index = index + 1
    }
    val value1 = [
        "abla_negate", "abla_not", "ablaBitNot",
        "abla_cell_create", "abla_cell_get",
        "abla_shared_create", "abla_shared_clone", "abla_shared_get",
        "abla_shared_lock", "abla_shared_release", "abla_weak_create",
        "abla_weak_clone", "abla_weak_upgrade", "abla_weak_alive",
        "abla_weak_release", "abla_to_string", "abla_length",
        "abla_string_length", "abla_array_length",
        "abla_generator_next", "abla_generator_value",
        "abla_generator_yield", "abla_generator_drop",
        "abla_task_drop", "abla_thread_drop", "abla_await"
    ]
    index = 0
    while (index < value1.size) {
        if (bootstrapLlvmRuntimeBridgeUsed(program, value1[index])) {
            bootstrapLlvmDeclareValueRuntime(backend, value1[index], 1)
        }
        index = index + 1
    }
    val value2 = [
        "abla_add", "abla_subtract", "abla_multiply", "abla_divide",
        "abla_equal", "abla_not_equal", "abla_less", "abla_less_equal",
        "abla_string_equal", "abla_string_not_equal",
        "abla_greater", "abla_greater_equal", "abla_cell_set",
        "abla_string_concat", "abla_index_get", "abla_string_get",
        "abla_array_get", "abla_array_append",
        "ablaBitAnd", "ablaBitOr", "ablaBitXor", "ablaBitShiftLeft",
        "ablaBitShiftRight", "ablaBitShiftRightUnsigned"
    ]
    index = 0
    while (index < value2.size) {
        if (bootstrapLlvmRuntimeBridgeUsed(program, value2[index])) {
            bootstrapLlvmDeclareValueRuntime(backend, value2[index], 2)
        }
        index = index + 1
    }
    bootstrapLlvmDeclareValueRuntime(backend, "abla_string_slice", 3)
    val concurrentCreates = [
        "abla_generator_create", "abla_task_create"
    ]
    index = 0
    while (index < concurrentCreates.size) {
        if (bootstrapLlvmRuntimeBridgeUsed(program, concurrentCreates[index])) {
            bootstrapLlvmDeclare(
                backend, concurrentCreates[index], backend.voidType,
                [pointer, pointer, pointer, pointer, pointer], true,
                [false, true, false, false, false]
            )
        }
        index = index + 1
    }
    bootstrapLlvmDeclare(
        backend, "abla_thread_create", backend.voidType,
        [pointer, pointer, pointer, pointer, pointer, pointer], true,
        [false, true, false, false, false, false]
    )
    bootstrapLlvmDeclare(
        backend, "abla_runtime_thread_entry", pointer,
        [pointer], false, [false]
    )
    bootstrapLlvmDeclare(
        backend, "abla_i64", backend.voidType, [pointer, i64], true,
        [false, false]
    )
    bootstrapLlvmDeclare(
        backend, "abla_bool", backend.voidType, [pointer, i1], true,
        [false, false]
    )
    bootstrapLlvmDeclare(
        backend, "abla_string_static", backend.voidType,
        [pointer, pointer, i64], true, [false, false, false]
    )
    bootstrapLlvmDeclare(
        backend, "abla_function", backend.voidType, [pointer, i32], true,
        [false, false]
    )
    bootstrapLlvmDeclare(
        backend, "abla_closure", backend.voidType,
        [pointer, i32, pointer, i64], true,
        [false, false, false, false]
    )
    bootstrapLlvmDeclare(
        backend, "abla_array_create", backend.voidType,
        [pointer, pointer, i64], true, [false, false, false]
    )
    bootstrapLlvmDeclare(
        backend, "abla_object_create", backend.voidType,
        [pointer, i32, i64], true, [false, false, false]
    )
    bootstrapLlvmDeclare(
        backend, "abla_field_get", backend.voidType,
        [pointer, pointer, i32], true, [false, true, false]
    )
    bootstrapLlvmDeclare(
        backend, "abla_field_get_indexed", backend.voidType,
        [pointer, pointer, i32, i64], true,
        [false, true, false, false]
    )
    bootstrapLlvmDeclare(
        backend, "abla_field_get_indexed_i64", i64,
        [pointer, i32, i64], false, [true, false, false]
    )
    bootstrapLlvmDeclare(
        backend, "abla_field_get_indexed_bool", i1,
        [pointer, i32, i64], false, [true, false, false]
    )
    bootstrapLlvmDeclare(
        backend, "abla_field_set", backend.voidType,
        [pointer, i32, pointer], false, [true, false, true]
    )
    bootstrapLlvmDeclare(
        backend, "abla_field_set_indexed", backend.voidType,
        [pointer, i32, i64, pointer], false,
        [true, false, false, true]
    )
    bootstrapLlvmDeclare(
        backend, "abla_field_set_indexed_i64", backend.voidType,
        [pointer, i32, i64, i64], false,
        [true, false, false, false]
    )
    bootstrapLlvmDeclare(
        backend, "abla_field_set_indexed_bool", backend.voidType,
        [pointer, i32, i64, i1], false,
        [true, false, false, false]
    )
    bootstrapLlvmDeclare(
        backend, "abla_field_initialize", backend.voidType,
        [pointer, i32, pointer], false, [true, false, true]
    )
    bootstrapLlvmDeclare(
        backend, "abla_array_set", backend.voidType,
        [pointer, pointer, pointer], false, [true, true, true]
    )
    bootstrapLlvmDeclare(
        backend, "abla_as_i64", i64, [pointer], false, [true]
    )
    bootstrapLlvmDeclare(
        backend, "abla_string_length_i64", i64,
        [pointer], false, [true]
    )
    bootstrapLlvmDeclare(
        backend, "abla_string_get_i64", i64,
        [pointer, i64], false, [true, false]
    )
    bootstrapLlvmDeclare(
        backend, "abla_array_length_i64", i64,
        [pointer], false, [true]
    )
    bootstrapLlvmDeclare(
        backend, "abla_array_get_i64", i64,
        [pointer, i64], false, [true, false]
    )
    bootstrapLlvmDeclare(
        backend, "abla_array_get_bool", i1,
        [pointer, i64], false, [true, false]
    )
    bootstrapLlvmDeclare(
        backend, "abla_string_equal_bool", i1,
        [pointer, pointer], false, [true, true]
    )
    bootstrapLlvmDeclare(
        backend, "abla_string_not_equal_bool", i1,
        [pointer, pointer], false, [true, true]
    )
    bootstrapLlvmDeclare(
        backend, "abla_as_bool", i1, [pointer], false, [true]
    )
    bootstrapLlvmDeclare(
        backend, "abla_as_cstring", pointer, [pointer], false, [true]
    )
    bootstrapLlvmDeclare(
        backend, "abla_string_data", pointer, [pointer], false, [true]
    )
    bootstrapLlvmDeclare(
        backend, "abla_as_function", i32, [pointer], false, [true]
    )
    bootstrapLlvmDeclare(
        backend, "abla_function_capture_count", i64,
        [pointer], false, [true]
    )
    bootstrapLlvmDeclare(
        backend, "abla_function_capture_pointer", pointer,
        [pointer], false, [true]
    )
    bootstrapLlvmDeclare(
        backend, "abla_function_capture", backend.voidType,
        [pointer, pointer, i64], true, [false, true, false]
    )
    if (bootstrapLlvmRuntimeBridgeUsed(program, "abla_shared_unlock")) {
        bootstrapLlvmDeclare(
            backend, "abla_shared_unlock", backend.voidType,
            [pointer], false, [true]
        )
    }
    bootstrapLlvmDeclare(
        backend, "abla_closure_release", backend.voidType,
        [pointer], false, [true]
    )
    bootstrapLlvmDeclare(
        backend, "abla_owned_bytes_from_value", pointer,
        [pointer], false, [true]
    )
    bootstrapLlvmDeclare(
        backend, "abla_owned_bytes_data", pointer,
        [pointer], false, [false]
    )
    bootstrapLlvmDeclare(
        backend, "abla_owned_bytes_length", i64,
        [pointer], false, [false]
    )
    bootstrapLlvmDeclare(
        backend, "abla_owned_bytes_release", backend.voidType,
        [pointer], false, [false]
    )
    bootstrapLlvmDeclare(
        backend, "abla_checked_invoke", i32,
        [pointer, pointer, i64, pointer, pointer, i64, pointer],
        false, [false, false, false, false, false, false, false]
    )
    bootstrapLlvmDeclare(
        backend, "abla_platform_alloc_i64", pointer,
        [i64], false, [false]
    )
    bootstrapLlvmDeclare(
        backend, "abla_platform_free", backend.voidType,
        [pointer], false, [false]
    )
    bootstrapLlvmDeclare(
        backend, "abla_platform_panic", backend.voidType,
        [pointer, i64], false, [false, false]
    )
    bootstrapLlvmDeclare(
        backend, "abla_runtime_roots_push", backend.voidType,
        [pointer, pointer, i64], false, [false, false, false]
    )
    bootstrapLlvmDeclare(
        backend, "abla_runtime_roots_pop", backend.voidType,
        [pointer], false, [false]
    )
    bootstrapLlvmDeclare(
        backend, "abla_runtime_memory_pressure", backend.voidType,
        [], false, []
    )
    bootstrapLlvmDeclare(
        backend, "abla_runtime_set_arguments", backend.voidType,
        [i32, pointer], false, [false, false]
    )
    if (false) LLVMDisposeMessage(nativeNullPointer())
}

// Materialize the physical universal-value ABI for instructions whose result
// is still boxed. Runtime semantics are implemented by the Abla runtime; this
// helper only writes the backend's tagged storage representation.
fun bootstrapLlvmStoreTaggedWordValue(
    backend: BootstrapLlvmBackend,
    destination: i64*,
    tag: int,
    word0: i64*
): void {
    val tagPointer = LLVMBuildStructGEP2(
        backend.builder, backend.valueType,
        destination, 0, "primitive.tag"
    )
    val auxiliaryPointer = LLVMBuildStructGEP2(
        backend.builder, backend.valueType,
        destination, 1, "primitive.auxiliary"
    )
    val payload = LLVMBuildStructGEP2(
        backend.builder, backend.valueType,
        destination, 2, "primitive.payload"
    )
    val first = LLVMBuildStructGEP2(
        backend.builder, backend.payloadType,
        payload, 0, "primitive.word0"
    )
    val second = LLVMBuildStructGEP2(
        backend.builder, backend.payloadType,
        payload, 1, "primitive.word1"
    )
    LLVMBuildStore(
        backend.builder,
        LLVMConstInt(backend.i32Type, tag, 0),
        tagPointer
    )
    LLVMBuildStore(
        backend.builder,
        LLVMConstInt(backend.i32Type, 0, 0),
        auxiliaryPointer
    )
    LLVMBuildStore(backend.builder, word0, first)
    LLVMBuildStore(
        backend.builder, LLVMConstInt(backend.i64Type, 0, 0), second
    )
    if (false) LLVMDisposeMessage(destination)
}

fun bootstrapLlvmEmitRuntimeProcessSupport(
    backend: BootstrapLlvmBackend
): void {
    val argumentCount = LLVMAddGlobal(
        backend.module, backend.i32Type, "abla_runtime_argument_count"
    )
    LLVMSetInitializer(
        argumentCount, LLVMConstInt(backend.i32Type, 0, 0)
    )
    LLVMSetLinkage(argumentCount, llvmInternalLinkage())
    val argumentVector = LLVMAddGlobal(
        backend.module, backend.pointerType, "abla_runtime_argument_vector"
    )
    LLVMSetInitializer(argumentVector, LLVMConstNull(backend.pointerType))
    LLVMSetLinkage(argumentVector, llvmInternalLinkage())
    val environmentVector = LLVMAddGlobal(
        backend.module, backend.pointerType, "abla_runtime_environment_vector"
    )
    LLVMSetInitializer(environmentVector, LLVMConstNull(backend.pointerType))
    LLVMSetLinkage(environmentVector, llvmInternalLinkage())
    val setArguments = LLVMGetNamedFunction(
        backend.module, "abla_runtime_set_arguments"
    )
    val entry = LLVMAppendBasicBlockInContext(
        backend.context, setArguments, "entry"
    )
    LLVMPositionBuilderAtEnd(backend.builder, entry)
    LLVMBuildStore(
        backend.builder, LLVMGetParam(setArguments, 0), argumentCount
    )
    LLVMBuildStore(
        backend.builder, LLVMGetParam(setArguments, 1), argumentVector
    )
    val environmentIndex = llvmPointerVector(1)
    environmentIndex.set(
        0,
        LLVMBuildAdd(
            backend.builder,
            LLVMBuildZExt(
                backend.builder, LLVMGetParam(setArguments, 0),
                backend.i64Type, "runtime.arguments.count.i64"
            ),
            LLVMConstInt(backend.i64Type, 1, 0),
            "runtime.environment.index"
        )
    )
    val environment = LLVMBuildGEP2(
        backend.builder, backend.pointerType,
        LLVMGetParam(setArguments, 1), environmentIndex.pointer(), 1,
        "runtime.environment"
    )
    environmentIndex.drop()
    LLVMBuildStore(backend.builder, environment, environmentVector)
    LLVMBuildRetVoid(backend.builder)
    LLVMSetVisibility(setArguments, llvmHiddenVisibility())
}

fun bootstrapLlvmDeclareGeneratedFunction(
    backend: BootstrapLlvmBackend,
    name: string
): i64* {
    val function = bootstrapLlvmDeclare(
        backend, name, backend.voidType,
        [backend.pointerType, backend.pointerType, backend.i64Type],
        true, [false, false, false]
    )
    LLVMSetLinkage(function, llvmExternalLinkage())
    LLVMSetVisibility(function, llvmHiddenVisibility())
    function
}

fun bootstrapLlvmRuntimeBridgeResult(symbol: string): string {
    var result = "value"
    if (symbol == "abla_as_i64" ||
        symbol == "abla_function_capture_count" ||
        symbol == "abla_string_length_i64" ||
        symbol == "abla_string_get_i64" ||
        symbol == "abla_array_length_i64" ||
        symbol == "abla_array_get_i64" ||
        symbol == "abla_field_get_indexed_i64") result = "i64"
    if (symbol == "abla_as_function") result = "i32"
    if (symbol == "abla_as_bool" ||
        symbol == "abla_string_equal_bool" ||
        symbol == "abla_string_not_equal_bool" ||
        symbol == "abla_array_get_bool" ||
        symbol == "abla_field_get_indexed_bool") result = "i1"
    if (symbol == "abla_string_data" ||
        symbol == "abla_as_cstring" ||
        symbol == "abla_function_capture_pointer" ||
        symbol == "abla_runtime_thread_entry") result = "pointer"
    if (symbol == "abla_shared_unlock" ||
        symbol == "abla_closure_release" ||
        symbol == "abla_platform_panic" ||
        symbol == "abla_runtime_roots_push" ||
        symbol == "abla_runtime_roots_pop" ||
        symbol == "abla_runtime_memory_pressure" ||
        symbol == "abla_array_set" ||
        symbol == "abla_field_initialize" ||
        symbol == "abla_field_set" ||
        symbol == "abla_field_set_indexed" ||
        symbol == "abla_field_set_indexed_i64" ||
        symbol == "abla_field_set_indexed_bool") result = "void"
    result
}

fun bootstrapLlvmRuntimeBridgeParameter(
    symbol: string,
    parameter: int
): string {
    var result = "value"
    if (symbol == "abla_i64" && parameter == 0) result = "i64"
    if (symbol == "abla_bool" && parameter == 0) result = "i1"
    if (symbol == "abla_function" && parameter == 0) result = "i32"
    if (symbol == "abla_closure" && parameter == 0) result = "i32"
    if (symbol == "abla_closure" && parameter == 1) result = "pointer"
    if (symbol == "abla_closure" && parameter == 2) result = "i64"
    if (symbol == "abla_function_capture" && parameter == 1) result = "i64"
    if ((symbol == "abla_generator_create" ||
         symbol == "abla_task_create" ||
         symbol == "abla_thread_create") && parameter > 0) {
        result = "pointer"
    }
    if (symbol == "abla_runtime_thread_entry" && parameter == 0) {
        result = "pointer"
    }
    if (symbol == "abla_platform_panic" && parameter == 0) result = "pointer"
    if (symbol == "abla_platform_panic" && parameter == 1) result = "i64"
    if (symbol == "abla_runtime_roots_push" && parameter < 2) {
        result = "pointer"
    }
    if (symbol == "abla_runtime_roots_push" && parameter == 2) {
        result = "i64"
    }
    if (symbol == "abla_runtime_roots_pop" && parameter == 0) {
        result = "pointer"
    }
    if (symbol == "abla_string_static" && parameter == 0) result = "pointer"
    if (symbol == "abla_string_static" && parameter == 1) result = "i64"
    if (symbol == "abla_string_get_i64" && parameter == 1) result = "i64"
    if (symbol == "abla_array_create" && parameter == 0) result = "pointer"
    if (symbol == "abla_array_create" && parameter == 1) result = "i64"
    if ((symbol == "abla_array_get_i64" ||
         symbol == "abla_array_get_bool") && parameter == 1) result = "i64"
    if (symbol == "abla_object_create" && parameter == 0) result = "i32"
    if (symbol == "abla_object_create" && parameter == 1) result = "i64"
    if ((symbol == "abla_field_get" ||
         symbol == "abla_field_initialize" ||
         symbol == "abla_field_set") && parameter == 1) result = "i32"
    if ((symbol == "abla_field_get_indexed" ||
         symbol == "abla_field_get_indexed_i64" ||
         symbol == "abla_field_get_indexed_bool" ||
         symbol == "abla_field_set_indexed" ||
         symbol == "abla_field_set_indexed_i64" ||
         symbol == "abla_field_set_indexed_bool") && parameter == 1) {
        result = "i32"
    }
    if ((symbol == "abla_field_get_indexed" ||
         symbol == "abla_field_get_indexed_i64" ||
         symbol == "abla_field_get_indexed_bool" ||
         symbol == "abla_field_set_indexed" ||
         symbol == "abla_field_set_indexed_i64" ||
         symbol == "abla_field_set_indexed_bool") && parameter == 2) {
        result = "i64"
    }
    if (symbol == "abla_field_set_indexed_i64" && parameter == 3) {
        result = "i64"
    }
    if (symbol == "abla_field_set_indexed_bool" && parameter == 3) {
        result = "i1"
    }
    result
}

fun bootstrapLlvmDeclareRuntimeBridge(
    backend: BootstrapLlvmBackend,
    symbol: string,
    parameters: int
): i64* {
    val mode = bootstrapLlvmRuntimeBridgeResult(symbol)
    val types: array<i64*> = []
    val byval: array<bool> = []
    if (mode == "value") {
        types.append(backend.pointerType)
        byval.append(false)
    }
    var parameter = 0
    while (parameter < parameters) {
        val parameterMode = bootstrapLlvmRuntimeBridgeParameter(
            symbol, parameter
        )
        types.append(backend.type(parameterMode))
        byval.append(parameterMode == "value")
        parameter = parameter + 1
    }
    val resultType = if (mode == "value") backend.voidType
        else backend.type(mode)
    val bridge = bootstrapLlvmDeclare(
        backend, symbol, resultType, types,
        mode == "value", byval
    )
    bridge
}

fun bootstrapLlvmOptionalRuntimeBridge(symbol: string): bool =
    symbol == "abla_shared_create" ||
    symbol == "abla_shared_clone" ||
    symbol == "abla_shared_get" ||
    symbol == "abla_shared_lock" ||
    symbol == "abla_shared_unlock" ||
    symbol == "abla_shared_release" ||
    symbol == "abla_weak_create" ||
    symbol == "abla_weak_clone" ||
    symbol == "abla_weak_upgrade" ||
    symbol == "abla_weak_alive" ||
    symbol == "abla_weak_release" ||
    symbol == "abla_index_get"

fun bootstrapLlvmRuntimeBridgeInstructionSymbol(
    instruction: BootstrapInstruction
): string {
    var symbol = bootstrapLlvmRuntimeOperation(instruction.opcode)
    if (instruction.opcode == "shared.unlock") {
        symbol = "abla_shared_unlock"
    }
    if (instruction.opcode == "generator.create") {
        symbol = "abla_generator_create"
    }
    if (instruction.opcode == "task.create") symbol = "abla_task_create"
    if (instruction.opcode == "thread.create") symbol = "abla_thread_create"
    symbol
}

fun bootstrapLlvmRuntimeBridgeUsed(
    program: BootstrapIrProgram,
    symbol: string
): bool {
    var used = !bootstrapLlvmOptionalRuntimeBridge(symbol)
    var functionIndex = 0
    while (!used && functionIndex < program.functions.size) {
        val function = program.functions[functionIndex]
        var instructionIndex = 0
        while (!used && instructionIndex < function.instructions.size) {
            used = bootstrapLlvmRuntimeBridgeInstructionSymbol(
                function.instructions[instructionIndex]
            ) == symbol
            instructionIndex = instructionIndex + 1
        }
        functionIndex = functionIndex + 1
    }
    if (!used && symbol == "abla_runtime_thread_entry") {
        used = bootstrapLlvmRuntimeBridgeUsed(program, "abla_thread_create")
    }
    used
}

fun bootstrapLlvmEmitSelfHostedRuntimeBridges(
    backend: BootstrapLlvmBackend,
    program: BootstrapIrProgram,
    identities: BootstrapLlvmFunctionIdentities
): void {
    var index = 0
    while (index < program.functions.size) {
        val implementation = program.functions[index]
        val symbol = bootstrapLlvmSelfHostedRuntimeSymbol(
            implementation.name
        )
        if (symbol != "" && bootstrapLlvmRuntimeBridgeUsed(
            program, symbol
        )) {
            val bridge = bootstrapLlvmDeclareRuntimeBridge(
                backend, symbol, implementation.parameters.size
            )
            LLVMSetLinkage(bridge, llvmInternalLinkage())
            if (implementation.inlineHint || bootstrapLlvmMcuRuntimeInline(
                backend.targetTriple, implementation.name
            )) {
                bootstrapLlvmAddFunctionAttribute(
                    backend, bridge, "alwaysinline"
                )
            }
            val entry = LLVMAppendBasicBlockInContext(
                backend.context, bridge, "self.hosted"
            )
            LLVMPositionBuilderAtEnd(backend.builder, entry)
            val publicResult = bootstrapLlvmRuntimeBridgeResult(symbol)
            val directResult = bootstrapLlvmDirectScalarType(
                implementation.resultType
            )
            val directVoid = bootstrapLlvmDirectResultIsVoid(implementation)
            val arguments: array<i64*> = []
            if (directResult == "" && !directVoid) {
                arguments.append(LLVMGetParam(bridge, 0))
            }
            arguments.append(LLVMConstInt(
                backend.i64Type, implementation.parameters.size, 0
            ))
            var parameter = 0
            while (parameter < implementation.parameters.size) {
                val scalar = bootstrapLlvmDirectScalarType(
                    implementation.parameterTypes[parameter]
                )
                val publicParameter = bootstrapLlvmRuntimeBridgeParameter(
                    symbol, parameter
                )
                val publicOffset = if (publicResult == "value") 1 else 0
                val incoming = LLVMGetParam(
                    bridge, parameter + publicOffset
                )
                var argument = incoming
                if (publicParameter == "value" && scalar != "") {
                    argument = bootstrapLlvmCallNamed(
                        backend,
                        if (scalar == "bool") "abla_as_bool"
                        else "abla_as_i64",
                        [incoming], "self.hosted.argument", false, [true]
                    )
                }
                if (publicParameter == "pointer") argument =
                    LLVMBuildPtrToInt(
                        backend.builder, incoming, backend.i64Type,
                        "self.hosted.pointer"
                    )
                if (publicParameter == "i32") argument = LLVMBuildZExt(
                    backend.builder, incoming, backend.i64Type,
                    "self.hosted.i32"
                )
                arguments.append(argument)
                parameter = parameter + 1
            }
            val result = bootstrapLlvmCall(
                backend,
                LLVMGetNamedFunction(
                    backend.module,
                    bootstrapLlvmDirectFunctionSymbol(
                        identities.symbols[index]
                    )
                ),
                arguments,
                if (directResult == "") "" else "self.hosted.result",
                false,
                bootstrapLlvmFalseFlags(arguments.size)
            )
            if (publicResult == "value" && directResult != "") {
                bootstrapLlvmCallNamed(
                    backend,
                    if (directResult == "bool") "abla_bool" else "abla_i64",
                    [LLVMGetParam(bridge, 0), result],
                    "", true, [false, false]
                )
            }
            if (publicResult == "value" && directVoid) {
                bootstrapLlvmRuntimeCall(
                    backend, "abla_void", LLVMGetParam(bridge, 0), []
                )
            }
            if (publicResult == "pointer") {
                LLVMBuildRet(
                    backend.builder,
                    LLVMBuildIntToPtr(
                        backend.builder, result, backend.pointerType,
                        "self.hosted.result.pointer"
                    )
                )
            } else if (publicResult == "i32") {
                LLVMBuildRet(
                    backend.builder,
                    LLVMBuildTrunc(
                        backend.builder, result, backend.i32Type,
                        "self.hosted.result.i32"
                    )
                )
            } else if (publicResult == "i64" || publicResult == "i1") {
                LLVMBuildRet(backend.builder, result)
            } else LLVMBuildRetVoid(backend.builder)
        }
        index = index + 1
    }
}
