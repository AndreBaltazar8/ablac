// The ORC session and generation the compiler keeps before it has made one (or after an add failed). Both classes are made only by
// trusted code (decision #165), so these are trusted; they reach nothing in abla/llvm/orc beyond the classes themselves, so a build
// for a target without LLVM (the browser compiler) can name them.
import "abla/llvm/orc"
import "abla/unsafe/memory/raw"

/** A session holding no JIT: closed, status 128. */
trusted fun bootstrapClosedOrcSession(): LlvmOrcSession = LlvmOrcSession(nativeNullPointer(), nativeNullPointer(), 128, true)

/** A generation holding no tracker: closed, with `status`. */
trusted fun bootstrapFailedOrcGeneration(status: int): LlvmOrcGeneration = LlvmOrcGeneration(nativeNullPointer(), status, true)
