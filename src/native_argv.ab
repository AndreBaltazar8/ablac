// Native argument vectors for in-process C parsers (#829).
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"

// An argv for LLVMParseCommandLineOptions: the pointers, then each value's bytes and NUL, in one
// native buffer the caller closes. Not a table of nativeCStringAddress numbers: those copies are on
// the collected heap, held by nothing but the number, so a collection between filling the table
// and the call could free them (#829).
trusted fun bootstrapNativeArgumentVector(values: array<string>): NativeByteBuffer {
    val table = (values.size + 1) * 8
    var bytes = 0
    for (value in values) bytes = bytes + value.size + 1
    val vector = nativeByteBuffer(table + bytes)
    var offset = table
    var index = 0
    while (index < values.size) {
        val value = values[index]
        vector.storePointer(index * 8, vector.pointerAt(offset))
        var byte = 0
        while (byte < value.size) {
            vector.store(offset + byte, value[byte])
            byte = byte + 1
        }
        vector.store(offset + value.size, 0)
        offset = offset + value.size + 1
        index = index + 1
    }
    vector.storePointer(values.size * 8, nativeNullPointer())
    vector
}
