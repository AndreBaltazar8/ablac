// Structured compiler source locations, independent of any editor protocol.
// The compiler still produces textual diagnostics; this adapter preserves the
// existing analysis-service interpretation while giving clients typed records.
// Producer-side related locations/origins remain a separate diagnostic API gap.
class BootstrapFrontendDiagnostic(
    val code: string,
    val message: string,
    val sourceIdentity: string,
    val begin: int,
    val end: int
)

fun bootstrapFrontendDiagnosticCode(diagnostics: string): string {
    var code = "E_ANALYSIS"
    var begin = -1
    var end = -1
    var index = 0
    while (begin < 0 && index + 6 < diagnostics.size) {
        if (diagnostics.slice(index, index + 6) == "error[") begin = index + 6
        index = index + 1
    }
    if (begin >= 0) {
        end = begin
        while (end < diagnostics.size && diagnostics[end] != 93) end = end + 1
        if (end < diagnostics.size) code = diagnostics.slice(begin, end)
    }
    code
}

fun bootstrapFrontendAppendLocatedDiagnostics(
    diagnostics: string,
    prefix: string,
    sourceIdentity: string,
    text: string,
    var values: array<BootstrapFrontendDiagnostic>
): void {
    var lineBegin = 0
    var previousError = ""
    while (lineBegin < diagnostics.size) {
        var lineEnd = lineBegin
        while (lineEnd < diagnostics.size &&
            diagnostics[lineEnd] != 10) lineEnd = lineEnd + 1
        val line = diagnostics.slice(lineBegin, lineEnd)
        if (line.size >= 6 && line.slice(0, 6) == "error[") {
            previousError = line
        }
        if (previousError != "" && line.size > prefix.size &&
            line.slice(0, prefix.size) == prefix) {
            val location = line.slice(prefix.size, line.size)
            var separator = 0
            while (separator < location.size &&
                location[separator] != 58) separator = separator + 1
            var begin = 0
            var digit = 0
            while (digit < separator && location[digit] >= 48 &&
                location[digit] <= 57) {
                begin = begin * 10 + location[digit] - 48
                digit = digit + 1
            }
            var end = begin + 1
            digit = separator + 1
            if (digit < location.size) {
                end = 0
                while (digit < location.size && location[digit] >= 48 &&
                    location[digit] <= 57) {
                    end = end * 10 + location[digit] - 48
                    digit = digit + 1
                }
            }
            if (begin > text.size) begin = text.size
            if (end < begin) end = begin
            if (end > text.size) end = text.size
            values.append(BootstrapFrontendDiagnostic(
                bootstrapFrontendDiagnosticCode(previousError), previousError,
                sourceIdentity, begin, end
            ))
            previousError = ""
        }
        lineBegin = lineEnd + 1
    }
}
