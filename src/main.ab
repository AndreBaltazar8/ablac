import "backend/llvm/backend.ab"
import "module.ab"
import "toolchain.ab"
import "abla/sys/linux/io"
import "abla/sys/linux/process"

fun bootstrapEmitLlvm(sourcePath: string): int {
    bootstrapBeginCompileOutputs()
    val parsed = bootstrapParseHostModuleWithRuntime(sourcePath)
    var status = 1
    val compilation = bootstrapCompileLlvmParsed(parsed)
    if (compilation.errors == 0) {
        linuxPrintStandardOutput(compilation.output)
        status = 0
    } else {
        linuxPrintStandardError(compilation.diagnostics)
        linuxPrintStandardError(
            "LLVM compilation failed: ${compilation.parserErrors} parser, ${compilation.extensionErrors} extension, ${compilation.semanticErrors} semantic, ${compilation.irErrors} IR, ${compilation.errors} total error(s)\n"
        )
        status = 1
    }
    if (status == 0 && !bootstrapCommitCompileOutputs()) status = 144
    if (status != 0) bootstrapDiscardCompileOutputs()
    status
}

fun bootstrapUsage(): int {
    linuxPrintStandardError(
        "usage: ablac build <file.ab> [-o output] [--no-cache]\n       ablac run <file.ab>             # LLVM JIT\n       ablac serve <file.ab>           # watched native service\n       ablac --emit-llvm <file.ab>\n"
    )
    2
}

fun main: int {
    val argumentCount = linuxArgumentCount()
    var status = 2
    if (argumentCount == 2 && linuxArgument(0) == "--emit-llvm") {
        status = bootstrapEmitLlvm(linuxArgument(1))
    }
    if (argumentCount == 2 && linuxArgument(0) == "build") {
        val build = bootstrapNativeBuild(linuxArgument(1), "build/abla-out")
        status = build.status
    }
    if (argumentCount == 4 && linuxArgument(0) == "build" &&
        linuxArgument(2) == "-o") {
        val build = bootstrapNativeBuild(
            linuxArgument(1),
            linuxArgument(3)
        )
        status = build.status
    }
    if (argumentCount == 3 && linuxArgument(0) == "build" &&
        linuxArgument(2) == "--no-cache") {
        val build = bootstrapNativeBuildUncachedWithEmitter(
            linuxArgument(1),
            "build/abla-out",
            bootstrapExternalEmitObject,
            "external-o2"
        )
        status = build.status
    }
    if (argumentCount == 5 && linuxArgument(0) == "build" &&
        linuxArgument(2) == "-o" &&
        linuxArgument(4) == "--no-cache") {
        val build = bootstrapNativeBuildUncachedWithEmitter(
            linuxArgument(1),
            linuxArgument(3),
            bootstrapExternalEmitObject,
            "external-o2"
        )
        status = build.status
    }
    if (argumentCount == 2 && linuxArgument(0) == "run") {
        status = bootstrapRun(linuxArgument(1))
    }
    if (argumentCount == 2 && linuxArgument(0) == "serve") {
        status = bootstrapServe(linuxArgument(1))
    }
    if (status == 2) status = bootstrapUsage()
    status
}
