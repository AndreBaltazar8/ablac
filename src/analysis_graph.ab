// Compiler frontend globals are serial already. One process-local graph state
// avoids handing an immutable field view to the mutable module-state API.
// Every request replaces overlays and begins a new acquisition generation.
var bootstrapAnalysisGraphActiveEntry = ""
var bootstrapAnalysisGraphModules: BootstrapModuleState = bootstrapModuleState()

/** What the service keeps between analyses, per byte of the project's source (the module parses, symbols and snapshots: 541 MB for the
 *  compiler's own 6.8 MB, measured as the bytes a collection marks at the start of an edit). A collection marks all of it, so the
 *  fixed 256 MB step of the compiler's heap (collect when the heap has grown by that much) re-marked it four times in an edit,
 *  two thirds of the marking and a third of the CPU of the analysis. The service collects after 1.5 times as much growth as it holds
 *  (120 bytes per byte of source), between the 256 MB of a small project and 768 MB. Measured on the compiler's source (a hub module's
 *  body edited, a session of three analyses less one, over four alternating rounds, user+sys CPU of an edit and the peak resident size
 *  of the session): step 512 MB (the ceiling before): 6.8 s, 2.25-2.31 GB; 768 MB: 5.2 s (5.05-5.25), 2.45-2.65 GB; 1,024 MB: 5.5 s,
 *  3.02-3.04 GB; 2,048 MB 5.8 s, 4.5 GB; no collection at all 3.3 s, 10 GB. The knee is at 768 MB: a quarter of the CPU of an edit for
 *  0.2 GB; past it a resident MB buys nothing in these runs. */
val BOOTSTRAP_ANALYSIS_HELD_PER_SOURCE_BYTE = 120
val BOOTSTRAP_ANALYSIS_GROWTH_FLOOR = 268435456
val BOOTSTRAP_ANALYSIS_GROWTH_CEILING = 805306368

/** The collection step for a project of `sourceBytes` of source. */
fun bootstrapAnalysisCollectionGrowth(sourceBytes: int): int {
    val held = sourceBytes * BOOTSTRAP_ANALYSIS_HELD_PER_SOURCE_BYTE
    if (held < BOOTSTRAP_ANALYSIS_GROWTH_FLOOR) BOOTSTRAP_ANALYSIS_GROWTH_FLOOR
    else if (held > BOOTSTRAP_ANALYSIS_GROWTH_CEILING) BOOTSTRAP_ANALYSIS_GROWTH_CEILING
    else held
}

/** The module that declares the language's built-in types and members for the editor (stdlib/abla/builtins/declarations.ab). It is parsed for its
 *  symbols and never typed: the compiler knows the built-ins itself (sema.ab), and a program that imported this file would clash with them. */
fun bootstrapAnalysisGraphBuiltinsPath(): string =
    bootstrapNormalizeModulePath(Path(bootstrapStandardLibraryRoot()).child("abla/builtins/declarations.ab").text)

/** The ids, in the file's own coordinates, of the built-in declarations by what sema calls them: `array.append`, `Map.get`, `string.size`
 *  for the members, `array`, `Map`, `string` for the types. */
fun bootstrapAnalysisGraphBuiltinIds(declarations: array<BootstrapDeclaration>): Map<string, string> {
    val ids: Map<string, string> = Map()
    for (declaration in declarations) {
        if (declaration.kind != "class") continue
        ids.set(declaration.name, bootstrapAnalysisDeclarationId(declaration))
        for (index in 0 until declaration.parameters.size) {
            ids.set("${declaration.name}.${declaration.parameters[index]}",
                "abla:${declaration.sourceIdentity}:${declaration.begin}:field:$index:${declaration.parameters[index]}")
        }
        for (method in declaration.methods) {
            ids.set("${declaration.name}.${method.name}", bootstrapAnalysisDeclarationId(method))
        }
    }
    ids
}

/** A module's parse and symbols export, valid while its source, uri and visibility stay as they were. */
class BootstrapAnalysisGraphParsed(
    val source: string,
    val uri: string,
    val full: bool,
    val parsed: BootstrapParseResult,
    val symbols: Json,
    val rewrite: BootstrapSourceRewrite,
    // For a service with stable ids (graph-v2): each symbol's stable id by its offset-based one, and the exported symbols with them
    // (`symbols` itself is what the compiler's identities are translated to, and keeps its offset-based ids). Empty and `symbols`
    // for graph-v1.
    val stable: Map<string, string>,
    val exported: Json,
    // What a document's export depends on that a parse fixes (graph-v2's `since`): the hash of its text and exported symbols.
    val key: string,
    val pending: array<Json>,
    val hostSource: string
)

class BootstrapAnalysisGraphDocument(
    val document: BootstrapAnalysisDocument,
    val parsed: BootstrapParseResult,
    val symbols: Json,
    val rewrite: BootstrapSourceRewrite,
    val stable: Map<string, string>,
    val exported: Json,
    val key: string,
    val hostSource: string
)

/** 128 bits of a text (two hashes of different seeds) and its length, as text: a document's export is taken to be the same as an
 *  earlier one's when these are (a collision needs both 64-bit hashes to agree, by chance 2^-128 for texts that differ). */
fun bootstrapAnalysisGraphHash(text: string): string =
    "${bootstrapHashNameBytes(-3750763034362895579, text)}.${bootstrapHashNameBytes(7046029254386353131, text)}.${text.size}"

/** What each document's export was at one revision (graph-v2's `since`): by uri, a fingerprint of everything the answer says of it. */
class BootstrapAnalysisGraphGeneration(
    val revision: string,
    val fingerprints: Map<string, string>,
    val uris: array<string>
)

/** The id the answer names a symbol of `document` by, given its offset-based one. */
fun bootstrapAnalysisGraphStable(document: BootstrapAnalysisGraphDocument, id: string): string {
    val known = document.stable.get(id)
    if (known != null) known else id
}

fun bootstrapAnalysisGraphUriValid(uri: string): bool {
    if (uri.size < 8 || uri.slice(0, 8) != "file:///") return false
    var index = 8
    while (index < uri.size) {
        val byte = uri[index]
        if (byte == 0 || byte == 35 || byte == 63 || byte < 32) return false
        if (byte == 37) {
            if (index + 2 >= uri.size) return false
            val high = bootstrapAnalysisHexDigit(uri[index + 1])
            val low = bootstrapAnalysisHexDigit(uri[index + 2])
            if (high < 0 || low < 0 || high * 16 + low == 0) return false
            index = index + 2
        }
        index = index + 1
    }
    true
}

fun bootstrapAnalysisGraphPath(value: string): string =
    bootstrapAbsoluteModulePath(if (value.size >= 7 && value.slice(0, 7) == "file://")
        bootstrapAnalysisUriPath(value) else value)

fun bootstrapAnalysisGraphUri(path: string): string {
    val absolute = bootstrapAbsoluteModulePath(path)
    val hex = "0123456789ABCDEF"
    var result = "file://"
    for (index in 0 until absolute.size) {
        val byte = absolute[index]
        if ((byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) ||
            (byte >= 48 && byte <= 57) || byte == 47 || byte == 45 ||
            byte == 46 || byte == 95 || byte == 126) {
            result = "$result${absolute.slice(index, index + 1)}"
        } else result =
            "$result%${hex.slice(byte / 16, byte / 16 + 1)}${hex.slice(byte % 16, byte % 16 + 1)}"
    }
    result
}

fun bootstrapAnalysisGraphEntry(value: string): string {
    val path = bootstrapAnalysisGraphPath(value)
    if (!Path(path).info().isDirectory()) return path
    val project = bootstrapProjectDescriptor(path)
    if (project.valid) return bootstrapNormalizeModulePath(project.entry)
    ""
}

fun BootstrapAnalysisService.graphEntry(): string {
    val candidates = if (this.graphEntries.size > 0) this.graphEntries else this.roots
    if (candidates.size > 1) return ""
    if (candidates.size == 1) {
        val entry = bootstrapAnalysisGraphEntry(candidates[0])
        if (entry != "") return entry
    }
    var opened = ""
    for (document in this.overlays) {
        if (document.active) {
            if (opened != "") return ""
            opened = bootstrapAnalysisGraphPath(document.path)
        }
    }
    opened
}

private fun bootstrapAnalysisGraphDocumentJson(
    uri: string, version: int, text: string, symbols: Json, occurrences: Json, diagnostics: Json
): Json = $json {
    "uri": uri, "version": version, "text": text, "symbols": symbols,
    "occurrences": occurrences, "diagnostics": diagnostics
}

private fun bootstrapAnalysisGraphSnapshotJson(
    revision: int, documents: array<Json>, mode: string, complete: bool, pending: array<Json>, entry: string
): Json = $json {
    "revision": "$revision", "documents": documents, "analysisMode": mode,
    "complete": complete, "pending": pending, "entry": entry
}

fun bootstrapAnalysisGraphIncomplete(revision: int, message: string, mode: string): Json =
    $json {
        "revision": "$revision",
        "documents": [],
        "analysisMode": mode,
        "complete": false,
        "issues": [{"code": "E_ANALYSIS_SCOPE", "message": message}]
    }

fun BootstrapAnalysisService.graphBudgetIncomplete(): Json {
    // A request may have populated only part of a cache. Nothing from that
    // candidate generation can be used for a query or an incremental replay.
    if (bootstrapAnalysisGraphActiveEntry != "") {
        bootstrapAnalysisGraphActiveEntry = ""
        bootstrapAnalysisGraphModules = bootstrapModuleState()
        this.graphParsed = Map()
        this.graphQueryIndex = null
        this.graphIndexRevision = -1
        this.graphReplayInputs = null
        this.graphReferences = Map()
        this.graphReferencesRevision = -1
    }
    bootstrapAnalysisGraphIncomplete(this.revision,
        "analysis incomplete: request time budget exceeded", this.graphModeName())
}

/** What a snapshot looks up many times: the document of a source identity, and a document's symbols by start and kind. */
class BootstrapAnalysisGraphLookup(
    val slots: Map<string, int> = Map(),
    val symbolStarts: Map<string, Map<string, string>> = Map(),
    val containers: Map<string, Map<string, array<Json>>> = Map()
)

/** The document's symbols that a container owns, in the document's order. */
fun bootstrapAnalysisGraphOwned(document: BootstrapAnalysisGraphDocument, owner: string,
    var lookup: BootstrapAnalysisGraphLookup, var into: array<Json>): void {
    val path = document.document.path
    if (!lookup.containers.has(path)) {
        val owned: Map<string, array<Json>> = Map()
        for (symbol in document.symbols.values) {
            val container = symbol.getString("containerId")
            val previous = owned.get(container)
            if (previous != null) previous.append(symbol) else owned.set(container, [symbol])
        }
        lookup.containers.set(path, owned)
    }
    val built = lookup.containers.get(path)
    if (built != null) {
        val found = built.get(owner)
        if (found != null) for (symbol in found) into.append(symbol)
    }
    return
}

fun bootstrapAnalysisGraphDocumentIndex(
    documents: array<BootstrapAnalysisGraphDocument>, source: string,
    var lookup: BootstrapAnalysisGraphLookup
): int {
    val known = lookup.slots.get(source)
    if (known != null) return known
    val found = bootstrapAnalysisGraphDocumentSearch(documents, source)
    lookup.slots.set(source, found)
    found
}

/** The id of the symbol of `kind` starting at `begin` in the document, "" when two different symbols do, null when none. */
fun bootstrapAnalysisGraphSymbolAt(document: BootstrapAnalysisGraphDocument, begin: int,
    kind: string, var lookup: BootstrapAnalysisGraphLookup): string? {
    val path = document.document.path
    val built = lookup.symbolStarts.get(path)
    if (built == null) {
        val starts: Map<string, string> = Map()
        for (found in document.symbols.values) {
            val key = "${found.get("range").getInt("start")}:${found.getString("kind")}"
            val id = found.getString("id")
            val previous = starts.get(key)
            if (previous == null) starts.set(key, id)
            else if (previous != id) starts.set(key, "")
        }
        lookup.symbolStarts.set(path, starts)
        return starts.get("$begin:$kind")
    }
    built.get("$begin:$kind")
}

fun bootstrapAnalysisGraphDocumentSearch(
    documents: array<BootstrapAnalysisGraphDocument>, source: string
): int {
    var candidate = bootstrapGenericSourceFile(source)
    if (candidate.size >= 9 && candidate.slice(candidate.size - 9, candidate.size) == "#contract") {
        candidate = candidate.slice(0, candidate.size - 9)
    }
    for (index in 0 until documents.size) {
        if (documents[index].document.path == candidate) return index
    }
    -1
}

fun bootstrapAnalysisGraphDeclarationAliases(
    declaration: BootstrapDeclaration,
    documents: array<BootstrapAnalysisGraphDocument>,
    var aliases: Map<string, string>,
    var lookup: BootstrapAnalysisGraphLookup
): void {
    val index = bootstrapAnalysisGraphDocumentIndex(documents, declaration.sourceIdentity, lookup)
    if (index < 0) return
    val document = documents[index]
    val begin = document.rewrite.original(declaration.begin)
    val kind = bootstrapAnalysisSymbolKind(declaration.kind)
    val matchedId = bootstrapAnalysisGraphSymbolAt(document, begin, kind, lookup)
    // Two different symbols at one start and kind: the declaration is not aliased (nor are its methods).
    if (matchedId != null && matchedId == "") return
    val matched = if (matchedId != null) matchedId else ""
    if (matched != "") {
        aliases.set(bootstrapAnalysisDeclarationId(declaration),
            bootstrapAnalysisGraphStable(document, matched))
        bootstrapAnalysisGraphScopeAliases(document, matched, declaration.sourceIdentity, aliases,
            lookup)
    }
    for (method in declaration.methods) {
        bootstrapAnalysisGraphDeclarationAliases(method, documents, aliases, lookup)
    }
    return
}

// Generic instances keep their compiler source identity. Bind only symbols
// owned by the matched original declaration, using the compiler's byte mapping.
fun bootstrapAnalysisGraphScopeAliases(
    document: BootstrapAnalysisGraphDocument, owner: string, source: string,
    var aliases: Map<string, string>, var lookup: BootstrapAnalysisGraphLookup
): void {
    val prefix = "abla:${document.document.path}:"
    val owned: array<Json> = []
    bootstrapAnalysisGraphOwned(document, owner, lookup, owned)
    for (symbol in owned) {
        val id = symbol.getString("id")
        if (id.size > prefix.size && id.slice(0, prefix.size) == prefix) {
            var end = prefix.size
            var begin = 0
            while (end < id.size && id[end] >= 48 && id[end] <= 57) {
                begin = begin * 10 + id[end] - 48
                end = end + 1
            }
            val rewritten = document.rewrite.rewritten(begin)
            aliases.set("abla:$source:$rewritten${id.slice(end, id.size)}",
                bootstrapAnalysisGraphStable(document, id))
            if (symbol.getString("kind") == "property") {
                aliases.set("abla:$source:$rewritten:field:${symbol.getString("name")}",
                    bootstrapAnalysisGraphStable(document, id))
            }
        }
    }
    return
}

// Compiler identities already carry the exact lexical owner. Translate their
// byte component, never resolve a declaration by spelling in another scope.
fun bootstrapAnalysisGraphLocalAliases(
    document: BootstrapAnalysisGraphDocument,
    var aliases: Map<string, string>
): void {
    val prefix = "abla:${document.document.path}:"
    var index = 0
    while (index < document.symbols.size()) {
        val symbol = document.symbols.at(index)
        val id = symbol.getString("id")
        val stableId = bootstrapAnalysisGraphStable(document, id)
        aliases.set(id, stableId)
        if (id.size > prefix.size && id.slice(0, prefix.size) == prefix) {
            var end = prefix.size
            var begin = 0
            while (end < id.size && id[end] >= 48 && id[end] <= 57) {
                begin = begin * 10 + id[end] - 48
                end = end + 1
            }
            val rewritten = document.rewrite.rewritten(begin)
            val suffix = id.slice(end, id.size)
            aliases.set("$prefix$rewritten$suffix", stableId)
            aliases.set("abla:${document.document.path}#contract:$rewritten$suffix", stableId)
            if (symbol.getString("kind") == "property") {
                aliases.set("$prefix$rewritten:field:${symbol.getString("name")}", stableId)
                aliases
                    .set("abla:${document.document.path}#contract:$rewritten:field:${symbol.getString("name")}",
                        id)
            }
        }
        index = index + 1
    }
    return
}

/** Generated fields are navigation targets without becoming surface
 * declarations that a client can move or rename. Bind them by the same
 * compiler field id as ordinary fields, never by display name alone. */
fun bootstrapAnalysisGraphGeneratedFields(
    declaration: BootstrapDeclaration,
    documents: array<BootstrapAnalysisGraphDocument>,
    var lookup: BootstrapAnalysisGraphLookup,
    var aliases: Map<string, string>,
    var targets: Map<string, Json>
): void {
    if (!declaration.sourceIdentity.startsWith("<generated:")) return
    for (origins in declaration.annotationArguments) {
        if (origins.kind != "generated.field.origins") continue
        val documentIndex = bootstrapAnalysisGraphDocumentIndex(documents, origins.text, lookup)
        if (documentIndex < 0) continue
        val document = documents[documentIndex]
        for (index in 0 until origins.children.size) {
            val field = origins.children[index]
            val begin = document.rewrite.original(field.begin)
            val end = document.rewrite.originalEnd(field.end)
            if (begin < 0 || end <= begin || end > document.document.text.size) continue
            val owner = "abla:${declaration.sourceIdentity}:${declaration.begin}:field:"
            val id = "abla:${document.document.path}#generated:${declaration.name}/field:${field.text}"
            aliases.set("$owner$index:${field.text}", id)
            aliases.set("$owner${field.text}", id)
            targets.set(id, bootstrapAnalysisNamedSymbolJson(id, field.text, "property",
                document.document.uri, begin, end, begin, end,
                declaration.parameterTypes[index], false, ""))
        }
    }
}

fun bootstrapAnalysisGraphCallNames(
    expression: BootstrapExpression, source: string, var names: Map<string, string>
): void {
    if (expression.kind == "call" || expression.kind == "member.call") {
        names.set("$source:${expression.begin}:${expression.end}:${expression.kind}",
            expression.text)
    }
    for (child in expression.children) bootstrapAnalysisGraphCallNames(child, source, names)
    return
}

fun bootstrapAnalysisGraphDeclarationCallNames(
    declaration: BootstrapDeclaration, var names: Map<string, string>
): void {
    bootstrapAnalysisGraphCallNames(declaration.expression, declaration.sourceIdentity, names)
    for (value in declaration.parameterDefaults) bootstrapAnalysisGraphCallNames(value,
        declaration.sourceIdentity, names)
    for (method in declaration.methods) bootstrapAnalysisGraphDeclarationCallNames(method, names)
    return
}

fun bootstrapAnalysisGraphCanonical(aliases: Map<string, string>, id: string): string {
    if (id == "") return ""
    val canonical = aliases.get(id)
    if (canonical != null) canonical else ""
}

/** The id a sema row names its declaration by: a built-in's `builtin:array.append` is the built-in module's declaration. */
fun bootstrapAnalysisGraphRowId(id: string, builtins: Map<string, string>): string {
    if (id.size > 8 && id.slice(0, 8) == "builtin:") {
        val known = builtins.get(id.slice(8, id.size))
        if (known != null) known else ""
    } else id
}

fun bootstrapAnalysisGraphSemantic(
    semantic: BootstrapSemanticResult,
    documents: array<BootstrapAnalysisGraphDocument>,
    names: Map<string, string>,
    var lookup: BootstrapAnalysisGraphLookup,
    aliases: Map<string, string>,
    builtins: Map<string, string>
): BootstrapSemanticResult {
    val resolved: array<BootstrapResolvedName> = []
    for (name in semantic.resolvedNames) {
        val index = bootstrapAnalysisGraphDocumentIndex(documents, name.sourceIdentity, lookup)
        if (index >= 0) {
            val document = documents[index]
            val begin = document.rewrite.original(name.begin)
            val end = document.rewrite.originalEnd(name.end)
            if (begin >= 0 && end >= begin && end <= document.document.text.size) {
                // The span's text, as the editor sees it; the name's own string when it is the same text, so the
                // occurrences do not each keep a copy (a synthetic name, such as a named argument's temporary, is not).
                val text = document.document.text.slice(begin, end)
                val identity = bootstrapAnalysisGraphRowId(name.declarationIdentity, builtins)
                resolved.append(BootstrapResolvedName(document.document.path, begin, end,
                    (if (text == name.name) name.name else text),
                    identity, name.type,
                    name.kind, bootstrapAnalysisGraphCanonical(aliases, identity)))
            }
        }
    }
    val calls: array<BootstrapTypedCall> = []
    for (call in semantic.typedCalls) {
        val index = bootstrapAnalysisGraphDocumentIndex(documents, call.sourceIdentity, lookup)
        if (index >= 0) {
            val document = documents[index]
            val begin = document.rewrite.original(call.begin)
            val end = document.rewrite.originalEnd(call.end)
            val name = names.get("${document.document.path}:$begin:$end:${call.kind}")
            if (name != null) calls.append(BootstrapTypedCall(
                document.document.path, begin, end, call.kind, name, call.type,
                call.receiverType, call.target, call.argumentTypes, call.parameterTypes,
                call.parameterKinds, call.argumentParameters, call.argumentConversions,
                call.insertedDefaults, call.isCompileOnly, call.isTrusted, call.isContract,
                bootstrapAnalysisGraphRowId(call.targetId, builtins),
                bootstrapAnalysisGraphCanonical(aliases, bootstrapAnalysisGraphRowId(call.targetId, builtins))))
        }
    }
    BootstrapSemanticResult(semantic.symbols, semantic.errors, semantic.extensionErrors,
        bootstrapSourceRewriteDiagnostics(semantic.diagnostics), semantic.mutableReceivers,
        semantic.compileEffects, calls, resolved, semantic.managedAliasBegins,
        semantic.managedAliasEnds, semantic.managedAliasSources, semantic.managedAliasFiles)
}

fun bootstrapAnalysisGraphDiagnostics(
    document: BootstrapAnalysisGraphDocument, project: BootstrapFrontendHostProject,
    semanticDiagnostics: string,
    unusedImports: string = "", occurrences: BootstrapAnalysisOccurrenceSet? = null,
    mappedProvider: bool = false, replay: bool = false
): Json {
    val values: array<BootstrapFrontendDiagnostic> = []
    if (!replay || unusedImports != "") for (kind in ["parser", "subparser", "import", "local", "parameter", "declaration", "json-construction", "strict-import", "qualified-import", "semantic"]) {
        val text = if (kind == "semantic") semanticDiagnostics
            else if (kind == "import" || kind == "local" || kind == "parameter" || kind == "declaration" || kind == "json-construction") "${project.written.diagnostics}$unusedImports"
            else project.written.diagnostics
        bootstrapFrontendAppendLocatedDiagnostics(text,
            "source[$kind]:${document.document.path}:", document.document.path,
            document.document.text, values)
    }
    if (occurrences != null && document.hostSource == "") {
        bootstrapAnalysisIdiomHints(document.document.text, document.document.path, document.parsed,
            occurrences, mappedProvider, values)
    }
    val exported: array<Json> = []
    for (value in values) exported.append(bootstrapFrontendDiagnosticJson(value))
    jsonArray(exported)
}

// Keep dependency and standard-library suggestions out of project diagnostics.
private fun BootstrapAnalysisService.idiomSource(path: string, stdlib: string): bool {
    if (path.startsWith(stdlib) || path.contains("/.abla/packages/")) return false
    for (root in this.roots) {
        if (path.startsWith(root) && path.size > root.size &&
            (root.endsWith("/") || path[root.size] == 47)) return true
    }
    false
}

// Workspace revisions include disk and configuration inputs, not only overlay
// message counts. Keep immutable strings, and compare exact contents rather
// than treating a hash collision as permission to validate stale edits.
fun BootstrapAnalysisService.graphObserveInputs(project: BootstrapFrontendHostProject,
    entry: string): void {
    val paths: array<string> = ["entry", "errors", "diagnostics"]
    val values: array<string> = [entry, "${project.written.errors}", project.written.diagnostics]
    val observed: Map<string, bool> = Map()
    for (module in project.modules) {
        paths.append("source:${module.path}")
        values.append(bootstrapAnalysisGraphModules.acquire(module.path).source)
        val root = bootstrapModuleIdentityProjectRoot(module.path)
        for (name in ["abla.toml", "abla.lock"]) {
            val path = Path(root).child(name).text
            if (!observed.has(path)) {
                observed.set(path, true)
                paths.append("metadata:$path")
                values.append(Path(path).readText())
            }
        }
    }
    var changed = paths.size != this.graphInputPaths.size
    var index = 0
    while (!changed && index < paths.size) {
        changed = paths[index] != this.graphInputPaths[index] || values[index] !=
            this.graphInputValues[index]
        index = index + 1
    }
    if (changed && this.graphInputPaths.size > 0) this.revision = this.revision + 1
    this.graphInputPaths.truncate(0)
    this.graphInputValues.truncate(0)
    for (index in 0 until paths.size) {
        this.graphInputPaths.append(paths[index])
        this.graphInputValues.append(values[index])
    }
    return
}

fun bootstrapAnalysisGraphReuse(cached: BootstrapAnalysisGraphParsed): BootstrapAnalysisGraphParsed {
    bootstrapRecordSourceRewrite(cached.rewrite)
    cached
}

/** The editor's caches are built whole and only read afterwards (every field a `val`, nothing appends to their arrays), so
 *  each module's entry and snapshot is copied into read-only memory the collector neither marks nor sweeps
 *  (docs/design/frozen-heap.md): an edit analysis would otherwise re-mark the unchanged modules at each collection.
 *  On by default in the analysis service; ABLA_ANALYSIS_FREEZE=0 turns it off (to measure). */
fun bootstrapAnalysisFreezeEnabled(): bool {
    val configured = linuxEnvironment("ABLA_ANALYSIS_FREEZE")
    !(configured.found && configured.value == "0")
}

fun bootstrapAnalysisGraphFrozen(entry: BootstrapAnalysisGraphParsed): BootstrapAnalysisGraphParsed =
    if (entry.source.size >= BOOTSTRAP_ANALYSIS_FREEZE_MIN_BYTES && bootstrapAnalysisFreezeEnabled())
        Frozen(entry).get() else entry

fun bootstrapAnalysisGraphParse(source: string, uri: string, full: bool,
    path: string, stableIds: bool, hostSource: string = ""): BootstrapAnalysisGraphParsed {
    val raw = bootstrapParseModuleSurface(BootstrapModule(path, source, hostSource))
    // Collect compile-time sites from the original surface before projecting the exported declarations.
    val blocked: array<BootstrapExpression> = []
    val blockedSources: array<string> = []
    val visible: array<BootstrapDeclaration> = []
    for (declaration in raw.declarations) {
        bootstrapFrontendCollectDeclarationCompile(declaration, blocked, blockedSources)
        if (full || !declaration.isPrivate) visible.append(declaration)
    }
    for (action in raw.actions) bootstrapFrontendCollectCompile(action, path, blocked, blockedSources)
    val pending: array<Json> = []
    for (index in 0 until blocked.size) {
        val site = blocked[index]
        pending.append($json {
            "code": "E_ANALYSIS_CT_REQUIRED",
            "uri": bootstrapAnalysisGraphUri(blockedSources[index]),
            "range": {"start": site.begin, "end": site.end},
            "message": "compile-time evaluation was not performed; types describe the pre-evaluation source"
        })
    }
    val surface = BootstrapParseResult(visible, raw.actions, raw.errors, raw.extensionErrors,
        raw.compileInputPaths, raw.compileInputContents, raw.diagnostics)
    val contract = if (full) surface else bootstrapProjectContract(surface, path)
    val symbols = bootstrapAnalysisSymbolsJson(source, uri, contract, hostSource)
    val stable = bootstrapAnalysisStableIdsOf(path, contract, symbols, stableIds)
    val exported = if (stableIds) bootstrapAnalysisStableSymbols(symbols, stable) else symbols
    BootstrapAnalysisGraphParsed(source, uri, full, contract, symbols, bootstrapSourceRewriteOf(path),
        stable, exported, if (stableIds) bootstrapAnalysisGraphHash("${bootstrapAnalysisGraphHash(source)}${jsonStringify(exported)}") else "",
        pending, hostSource)
}

/** How many generations `since` can name (the one the client holds is the one it last analyzed: the last few cover queries and
 *  analyses in between). */
val BOOTSTRAP_ANALYSIS_GENERATIONS_KEPT = 8

fun BootstrapAnalysisService.graphRememberGeneration(generation: BootstrapAnalysisGraphGeneration): void {
    val kept: array<BootstrapAnalysisGraphGeneration> = []
    val skip = this.graphGenerations.size + 1 - BOOTSTRAP_ANALYSIS_GENERATIONS_KEPT
    for (index in 0 until this.graphGenerations.size) {
        if (index >= skip && this.graphGenerations[index].revision != generation.revision) {
            kept.append(this.graphGenerations[index])
        }
    }
    kept.append(generation)
    this.graphGenerations.truncate(0)
    for (item in kept) this.graphGenerations.append(item)
    return
}

fun BootstrapAnalysisService.graphHoldsGeneration(revision: string): bool {
    var found = false
    for (generation in this.graphGenerations) {
        if (generation.revision == revision) found = true
    }
    found
}

/** What the answer said of `uri` at `revision`, as a fingerprint: "" when the revision is not held or had no such document. */
fun BootstrapAnalysisService.graphFingerprint(revision: string, uri: string): string {
    var found = ""
    for (generation in this.graphGenerations) {
        if (generation.revision == revision) {
            val fingerprint = generation.fingerprints.get(uri)
            if (fingerprint != null) found = fingerprint
        }
    }
    found
}

/** `analyze` with `since` (graph-v2): the answer for `snapshot` says only what differs from what the client holds, the
 *  revision `since`: `documents` are those whose export changed or that are new, `unchanged` and `removed` list the uris of
 *  the others, and `full` is false. A revision the service no longer holds (or an incomplete analysis) gets the whole
 *  snapshot, `full` true. */
fun BootstrapAnalysisService.graphSince(snapshot: Json, since: string): Json {
    val keys: array<string> = []
    val values: array<Json> = []
    val revision = snapshot.getString("revision")
    if (!this.graphHoldsGeneration(since) || !this.graphHoldsGeneration(revision) ||
        !snapshot.has("entry")) {
        for (index in 0 until snapshot.keys.size) {
            keys.append(snapshot.keys[index])
            values.append(snapshot.values[index])
        }
        keys.append("since")
        values.append(jsonString(since))
        keys.append("full")
        values.append(jsonBoolean(true))
        return jsonObject(keys, values)
    }
    val changed: array<Json> = []
    val unchanged: array<Json> = []
    val present: Map<string, bool> = Map()
    for (document in snapshot.get("documents").values) {
        val uri = document.getString("uri")
        present.set(uri, true)
        val was = this.graphFingerprint(since, uri)
        if (was != "" && was == this.graphFingerprint(revision, uri)) unchanged.append(jsonString(uri))
        else changed.append(document)
    }
    val removed: array<Json> = []
    for (uri in this.graphGenerationUris(since)) {
        if (!present.has(uri)) removed.append(jsonString(uri))
    }
    for (index in 0 until snapshot.keys.size) {
        keys.append(snapshot.keys[index])
        values.append(if (snapshot.keys[index] == "documents") jsonArray(changed) else snapshot.values[index])
    }
    keys.append("unchanged")
    values.append(jsonArray(unchanged))
    keys.append("removed")
    values.append(jsonArray(removed))
    keys.append("since")
    values.append(jsonString(since))
    keys.append("full")
    values.append(jsonBoolean(false))
    jsonObject(keys, values)
}

fun BootstrapAnalysisService.graphGenerationUris(revision: string): array<string> {
    val uris: array<string> = []
    for (generation in this.graphGenerations) {
        if (generation.revision == revision) {
            for (uri in generation.uris) uris.append(uri)
        }
    }
    uris
}

fun BootstrapAnalysisService.graphModeName(): string = if (this.graphStableIds) "graph-v2" else "graph-v1"

/** ABLA_ANALYSIS_CHECK=1 (a test mode: the check holds a second analysis, so the peak is about twice an analysis's): every analysis that
 *  is not the cached one of its revision is run again with nothing kept (no cached parse, no cached compile-time sites, no module
 *  state), and the two answers are compared document by document. A difference is reported on standard error and the answer
 *  becomes an incomplete one that says so. The kept state stays the incremental run's, so the next edit is incremental too. */
fun bootstrapAnalysisCheckEnabled(): bool {
    val configured = linuxEnvironment("ABLA_ANALYSIS_CHECK")
    configured.found && (configured.value == "1" || configured.value == "2")
}

/** Each document's text digest and what the answer says besides the documents, by uri (and "" for the rest). */
/** What a document's occurrences are, as a fingerprint (two 64-bit hashes of the spans, ids and types the set holds, with their number):
 *  the answer's own text of them is not made for a document no answer carries. */
fun bootstrapAnalysisGraphSetHash(set: BootstrapAnalysisOccurrenceSet): string {
    var first = -3750763034362895579 ^ set.begins.size
    var second = 7046029254386353131 ^ set.begins.size
    for (item in 0 until set.begins.size) {
        first = (first ^ set.begins[item]) * 1099511628211
        first = (first ^ set.ends[item]) * 1099511628211
        second = (second ^ set.ends[item]) * 1099511628211
        second = (second ^ set.begins[item]) * 1099511628211
        val id = set.ids[item]
        if (id != "") {
            first = (first ^ bootstrapHashNameBytes(7046029254386353131, id)) * 1099511628211
            second = (second ^ bootstrapHashNameBytes(-3750763034362895579, id)) * 1099511628211
        }
        val type = set.types[item]
        if (type != "") {
            first = (first ^ bootstrapHashNameBytes(-3750763034362895579, type)) * 1099511628211
            second = (second ^ bootstrapHashNameBytes(7046029254386353131, type)) * 1099511628211
        }
    }
    "${first}.${second}.${set.begins.size}"
}

// Encode one symbol at a time so rendered docs do not accumulate as a second
// symbol tree alongside the cached source spans.
fun bootstrapAnalysisGraphSymbolText(symbols: Json, source: string): string {
    var text = byteBuffer()
    text.appendText("[")
    var first = true
    for (symbol in symbols.values) {
        if (!first) text.appendText(",")
        first = false
        text.appendText(jsonStringify(bootstrapAnalysisSymbolWithDocumentation(symbol, source)))
    }
    text.appendText("]")
    text.toText()
}

// Materialize only the fields a reply carries.
fun BootstrapAnalysisService.graphMaterializeDocument(document: Json): Json {
    val index = this.graphQueryIndex
    val source = document.getString("text")
    val values: array<Json> = []
    for (position in 0 until document.keys.size) {
        val key = document.keys[position]
        val value = document.values[position]
        if (key == "symbols") {
            values.append(jsonRawUnchecked(bootstrapAnalysisGraphSymbolText(value, source)))
        } else if (key == "occurrences" && value.isNull() && index != null) {
            val set = index.occurrences.get(bootstrapAnalysisGraphPath(document.getString("uri")))
            values.append(if (set != null) jsonRawUnchecked(bootstrapAnalysisOccurrenceSetText(source, set)) else value)
        } else values.append(value)
    }
    jsonObject(document.keys, values)
}

fun BootstrapAnalysisService.graphMaterialize(answer: Json): Json {
    val carried = answer.get("documents")
    if (!carried.isArray()) return answer
    val documents: array<Json> = []
    for (document in carried.values) documents.append(this.graphMaterializeDocument(document))
    val values: array<Json> = []
    for (position in 0 until answer.keys.size) {
        values.append(if (answer.keys[position] == "documents") jsonArray(documents) else answer.values[position])
    }
    jsonObject(answer.keys, values)
}

// An analyze result can be tens of megabytes. Encode one document at a time
// so neither the materialized fields nor the finished reply accumulate.
fun BootstrapAnalysisService.graphWriteAnalysis(id: int, answer: Json): void {
    if (!linuxWriteStandardOutputAll("{\"schema\":$ABLA_ANALYSIS_PROTOCOL_VERSION,\"id\":$id,\"result\":{")) return
    for (position in 0 until answer.keys.size) {
        val key = answer.keys[position]
        val value = answer.values[position]
        val delimiter = if (position == 0) "" else ","
        val quoted = jsonQuote(key)
        if (!linuxWriteStandardOutputAll("$delimiter$quoted:")) return
        if (key == "documents" && value.isArray()) {
            if (!linuxWriteStandardOutputAll("[")) return
            for (item in 0 until value.values.size) {
                if (item > 0 && !linuxWriteStandardOutputAll(",")) return
                val document = this.graphMaterializeDocument(value.values[item])
                if (!linuxWriteStandardOutputAll(jsonStringify(document))) return
            }
            if (!linuxWriteStandardOutputAll("]")) return
        } else if (!linuxWriteStandardOutputAll(jsonStringify(value))) return
    }
    linuxPrintStandardOutput("}}\n")
}

fun BootstrapAnalysisGraphQueryIndex.withDocumentation(symbol: Json): Json {
    val source = this.documents.get(bootstrapAnalysisGraphPath(symbol.getString("uri")))
    if (source == null) return symbol
    bootstrapAnalysisSymbolWithDocumentation(symbol, source.getString("text"))
}

fun bootstrapAnalysisCheckDigests(snapshot: Json): Map<string, string> {
    val digests: Map<string, string> = Map()
    val rest: array<string> = []
    for (index in 0 until snapshot.keys.size) {
        if (snapshot.keys[index] == "documents") continue
        rest.append("${snapshot.keys[index]}=${jsonStringify(snapshot.values[index])}")
    }
    var restText = ""
    for (line in rest) restText = "$restText$line\n"
    digests.set("", bootstrapAnalysisGraphHash(restText))
    for (document in snapshot.get("documents").values) {
        digests.set(document.getString("uri"), bootstrapAnalysisGraphHash(jsonStringify(document)))
    }
    digests
}

fun BootstrapAnalysisService.graphSnapshot(): Json {
    if (!bootstrapAnalysisCheckEnabled()) return this.graphSnapshotRun()
    val previousRevision = this.graphIndexRevision
    val result = this.graphSnapshotRun()
    if (bootstrapAnalysisBudgetExpired()) return this.graphBudgetIncomplete()
    if (previousRevision == this.graphIndexRevision || this.graphQueryIndex == null) return result
    val incremental = bootstrapAnalysisCheckDigests(this.graphMaterialize(result))
    // ABLA_ANALYSIS_CHECK=2 (the check's own test): the incremental answer's first document is taken to differ, and the run must say so.
    val selfTest = linuxEnvironment("ABLA_ANALYSIS_CHECK")
    if (selfTest.value == "2" && result.get("documents").values.size > 0) {
        incremental.set(result.get("documents").values[0].getString("uri"), "self-test")
    }
    val keptParsed = this.graphParsed
    val keptModules = bootstrapAnalysisGraphModules
    val keptEntry = bootstrapAnalysisGraphActiveEntry
    val keptIndex = this.graphQueryIndex
    val keptIndexRevision = this.graphIndexRevision
    val keptLoadKey = this.graphLoadKey
    val keptGenerations: array<BootstrapAnalysisGraphGeneration> = []
    for (generation in this.graphGenerations) keptGenerations.append(generation)
    // Nothing of the incremental run is reached from the cold one.
    bootstrapAnalysisGraphActiveEntry = ""
    this.graphQueryIndex = null
    this.graphIndexRevision = -1
    val cold = this.graphSnapshotRun(false)
    if (bootstrapAnalysisBudgetExpired()) return this.graphBudgetIncomplete()
    val reference = bootstrapAnalysisCheckDigests(this.graphMaterialize(cold))
    this.graphParsed = keptParsed
    bootstrapAnalysisGraphModules = keptModules
    bootstrapAnalysisGraphActiveEntry = keptEntry
    this.graphQueryIndex = keptIndex
    this.graphIndexRevision = keptIndexRevision
    this.graphLoadKey = keptLoadKey
    this.graphGenerations.truncate(0)
    for (generation in keptGenerations) this.graphGenerations.append(generation)
    val differing: array<string> = []
    for (key in reference.keys()) {
        val was = incremental.get(key)
        if (was == null || was != reference.get(key)) differing.append(if (key == "") "(answer outside the documents)" else key)
    }
    for (key in incremental.keys()) {
        if (!reference.has(key)) differing.append("$key (only in the incremental answer)")
    }
    if (differing.size == 0) {
        linuxWriteStandardError("abla-analysis-check ok revision ${this.revision} documents ${reference.size - 1}\n")
        return result
    }
    var shown = 0
    for (name in differing) {
        if (shown < 20) linuxWriteStandardError("abla-analysis-check DIFFERENT revision ${this.revision}: $name\n")
        shown = shown + 1
    }
    linuxWriteStandardError("abla-analysis-check FAILED revision ${this.revision}: ${differing.size} differences\n")
    return bootstrapAnalysisGraphIncomplete(this.revision,
        "ABLA_ANALYSIS_CHECK: the incremental analysis differs from a cold one in ${differing.size} documents", this.graphModeName())
}

/** How many times `needle` occurs in `text`. */
fun bootstrapAnalysisCount(text: string, needle: string): int {
    var count = 0
    var at = text.indexOf(needle)
    while (at >= 0) {
        count = count + 1
        at = text.indexOf(needle, at + needle.size)
    }
    count
}

class BootstrapAnalysisReplaySnapshot(
    val snapshot: Json,
    val sets: Map<string, BootstrapAnalysisOccurrenceSet>,
    val generated: Map<string, Json>,
    val fingerprints: Map<string, string>,
    val uris: array<string>,
    val checkedScalar: bool = false,
    val checkedInterface: bool = false
)

fun bootstrapAnalysisRejectReplay(reason: string): BootstrapAnalysisReplaySnapshot? {
    if (linuxEnvironment("ABLA_ANALYSIS_INCREMENTAL_TRACE").value == "1") {
        linuxPrintStandardError("abla-analysis-typing fallback: $reason\n")
    }
    null
}

// Lowered null guards name a synthetic temporary by the source offset.
// Such a temporary has no spelling with an occurrence in the source.
fun bootstrapAnalysisReplayShiftedTemporary(before: Json, after: Json,
    splice: BootstrapAnalysisBodyInsert): bool {
    val prefix = "__abla_null_default_"
    val name = before.getString("name")
    val nextName = after.getString("name")
    if (!name.startsWith(prefix) || !nextName.startsWith(prefix)) return false
    val offset = name.slice(prefix.size, name.size)
    if (offset.size == 0 || offset.size > 10) return false
    var original = 0
    for (index in 0 until offset.size) {
        val digit = offset[index] - 48
        if (digit < 0 || digit > 9) return false
        original = original * 10 + digit
    }
    val shift = splice.size - splice.removed
    if (original < splice.at + splice.removed || nextName != "$prefix${original + shift}") return false
    val id = before.getString("id")
    id.endsWith(name) && after.getString("id") == "${id.slice(0, id.size - name.size)}$nextName" &&
        before.getString("kind") == after.getString("kind") &&
        before.getString("containerId") == after.getString("containerId") &&
        before.get("selectionRange").getInt("start") + shift == after.get("selectionRange").getInt("start") &&
        before.get("selectionRange").getInt("end") + shift == after.get("selectionRange").getInt("end")
}

/** `declaration`, a scalar function, with a literal of its result type for its body: its interface alone. */
fun bootstrapAnalysisScalarPlaceholder(declaration: BootstrapDeclaration): BootstrapDeclaration {
    val type = declaration.resultType
    val kind = if (type == "bool") "false" else if (type == "f64") "float" else "integer"
    val text = if (type == "bool") "false" else if (type == "f64") "0.0" else "0"
    bootstrapDeclarationWithExpression(declaration,
        BootstrapExpression(kind, text, declaration.expression.begin, declaration.expression.end, []))
}

/** `record` as the scalar checker is given it: only the methods a checked body may call (bootstrapAnalysisScalarMethod), their bodies
 *  placeholders, and each field it never reads (not of a scalar or string type) an `int` without a default, in its place, so that the
 *  field ids (by index) and offsets are the record's own. */
fun bootstrapAnalysisScalarRecordView(record: BootstrapDeclaration): BootstrapDeclaration {
    val methods: array<BootstrapDeclaration> = []
    for (method in record.methods) {
        if (bootstrapAnalysisScalarMethod(record, method)) methods.append(bootstrapAnalysisScalarPlaceholder(method))
    }
    val types: array<string> = []
    val defaults: array<BootstrapExpression> = []
    for (index in 0 until record.parameters.size) {
        val type = record.parameterTypes[index]
        val value = record.parameterDefaults[index]
        if (bootstrapAnalysisScalarType(type) || type == "string") {
            types.append(type)
            defaults.append(value)
        } else {
            types.append("int")
            defaults.append(BootstrapExpression("missing", "", value.begin, value.begin, []))
        }
    }
    bootstrapDeclarationWithParameterDefaults(bootstrapDeclarationWithParameterTypes(bootstrapDeclarationWithMethods(record, methods), types),
        defaults)
}

fun bootstrapAnalysisCheckScalarBody(document: BootstrapAnalysisGraphDocument, edit: BootstrapAnalysisScalarEdit,
    builtins: Map<string, string> = Map(), builtinDocument: BootstrapAnalysisGraphDocument? = null,
    documents: array<BootstrapAnalysisGraphDocument> = []): BootstrapAnalysisOccurrenceSet? {
    val declaration = document.parsed.declarations[edit.declaration]
    val declarations = [declaration]
    // Publish the callees' original interfaces and check only the edited body.
    for (index in edit.callees) declarations.append(bootstrapAnalysisScalarPlaceholder(document.parsed.declarations[index]))
    // The classes whose fields it reads, with only the methods it may call, their bodies placeholders (bootstrapAnalysisScalarRecord).
    // The global values it reads, with a placeholder initializer of their written type (a literal one is their own).
    for (record in edit.records) {
        declarations.append(if (record.kind == "class") bootstrapAnalysisScalarRecordView(record)
            else if (bootstrapAnalysisScalarType(record.resultType)) bootstrapAnalysisScalarPlaceholder(record) else record)
    }
    val parsed = BootstrapParseResult(declarations, [], 0, 0, [], [], "")
    val begins: array<int> = []
    val ends: array<int> = []
    val kinds: array<string> = []
    val sources: array<string> = []
    bootstrapAnalysisCollectDeclarationRequests(declaration, begins, ends, kinds, sources)
    val semantic = bootstrapFrontendAnalyzeRequested(parsed, begins, ends, kinds, sources)
    if (semantic.errors != 0 || semantic.extensionErrors != 0 || semantic.diagnostics != "") return null
    val aliases: Map<string, string> = Map()
    bootstrapAnalysisGraphLocalAliases(document, aliases)
    // The built-in types (a written `val t: int`) are named by the built-in module's declarations, by their stable ids, as in the full
    // analysis.
    if (builtinDocument != null) bootstrapAnalysisGraphLocalAliases(builtinDocument, aliases)
    // The documents of the classes from other modules, whose ids name their fields and methods.
    val owners: Map<string, bool> = Map()
    for (record in edit.records) if (record.sourceIdentity != document.document.path) owners.set(record.sourceIdentity, true)
    for (item in documents) if (owners.has(item.document.path)) bootstrapAnalysisGraphLocalAliases(item, aliases)
    val set = bootstrapAnalysisOccurrenceSet(document.document.text, document.document.path, parsed,
        parsed.declarations, semantic, aliases, false, bootstrapAnalysisOccurrenceIndex(parsed.declarations, semantic, builtins))
    // A built-in member the checker names by its row (`builtin:string.size`) is the built-in module's declaration, by its stable id, as
    // bootstrapAnalysisGraphSemantic makes it for the full analysis.
    val ids: array<string> = []
    for (id in set.ids) {
        if (id.startsWith("builtin:")) {
            val row = bootstrapAnalysisGraphRowId(id, builtins)
            val canonical = bootstrapAnalysisGraphCanonical(aliases, row)
            ids.append(if (canonical != "") canonical else row)
        } else ids.append(id)
    }
    BootstrapAnalysisOccurrenceSet(set.begins, set.ends, ids, set.types)
}

// Inspect the prepared expressions as well as the prior resolved occurrences.
// A function value, aliased call or implicit/member lookup is unproven here.
fun bootstrapAnalysisInterfaceReads(expression: BootstrapExpression, name: string): int {
    var count = 0
    if (bootstrapCanonicalDeclarationHasSourceName(expression.text, name)) {
        if (expression.kind != "call" || expression.text != name || expression.children.size != 0) return -1
        count = 1
    }
    for (child in expression.children) {
        val nested = bootstrapAnalysisInterfaceReads(child, name)
        if (nested < 0) return -1
        count = count + nested
    }
    count
}

fun bootstrapAnalysisInterfaceHeaderReads(declaration: BootstrapDeclaration, name: string): bool {
    for (value in declaration.parameterDefaults) if (bootstrapAnalysisInterfaceReads(value, name) != 0) return true
    for (value in declaration.annotationArguments) if (bootstrapAnalysisInterfaceReads(value, name) != 0) return true
    for (method in declaration.methods) {
        if (bootstrapAnalysisInterfaceReads(method.expression, name) != 0 ||
            bootstrapAnalysisInterfaceHeaderReads(method, name)) return true
    }
    false
}

class BootstrapAnalysisInterfaceReader(val document: int, val declaration: BootstrapDeclaration, val reads: int)

// The prepared candidate bucket for the provider must have one exact entry.
// Dependent bodies must have an unchanged checking interface and no outside
// call bucket. Both conditions must hold before any prior rows are reused.
fun bootstrapAnalysisInterfaceReaders(documents: array<BootstrapAnalysisGraphDocument>,
    project: BootstrapParseResult, provider: BootstrapDeclaration): array<BootstrapAnalysisInterfaceReader>? {
    val name = provider.name
    for (action in project.actions) if (bootstrapAnalysisInterfaceReads(action, name) != 0) return null
    val readers: array<BootstrapAnalysisInterfaceReader> = []
    var providerCount = 0
    for (prepared in project.declarations) {
        if (bootstrapAnalysisBudgetExpired()) return null
        if (bootstrapIsOperatorDeclaration(prepared) || bootstrapAnalysisInterfaceHeaderReads(prepared, name)) return null
        for (method in prepared.methods) if (bootstrapIsOperatorDeclaration(method)) return null
        if (bootstrapCanonicalDeclarationHasSourceName(prepared.name, name)) {
            if (prepared.name != name || prepared.begin != provider.begin ||
                !bootstrapAnalysisScalarInterfaceMatches(provider, prepared, false)) return null
            providerCount = providerCount + 1
        }
        val reads = bootstrapAnalysisInterfaceReads(prepared.expression, name)
        if (reads == 0) continue
        if (reads < 0 || readers.size >= 16 || !bootstrapAnalysisScalarFunction(prepared, true)) return null
        val names: Map<string, int> = Map()
        bootstrapAnalysisScalarCallNames(prepared.expression, names)
        if (names.size != 1 || !names.has(name)) return null
        var found = false
        for (index in 0 until documents.size) {
            val document = documents[index]
            if (document.document.path != prepared.sourceIdentity) continue
            if (document.hostSource != "" || document.rewrite.rewrittenBegins.size != 0) return null
            for (declaration in document.parsed.declarations) {
                if (declaration.begin != prepared.begin || declaration.name != prepared.name) continue
                if (!bootstrapAnalysisScalarFunction(declaration, true) ||
                    !bootstrapAnalysisScalarInterfaceMatches(declaration, prepared, true) ||
                    bootstrapAnalysisInterfaceReads(declaration.expression, name) != reads) return null
                val writtenCalls: Map<string, int> = Map()
                bootstrapAnalysisScalarCallNames(declaration.expression, writtenCalls)
                if (writtenCalls.size != 1 || !writtenCalls.has(name)) return null
                readers.append(BootstrapAnalysisInterfaceReader(index, declaration, reads))
                found = true
                break
            }
            break
        }
        if (!found) return null
    }
    if (providerCount != 1 || readers.size == 0) return null
    readers
}

fun bootstrapAnalysisCheckInterface(previous: BootstrapAnalysisGraphQueryIndex,
    documents: array<BootstrapAnalysisGraphDocument>, project: BootstrapParseResult,
    names: Map<string, string>, builtins: Map<string, string>, changed: int,
    splice: BootstrapAnalysisBodyInsert): Map<string, BootstrapAnalysisOccurrenceSet>? {
    val edited = documents[changed]
    if (edited.rewrite.rewrittenBegins.size != 0) return null
    for (provider in edited.parsed.declarations) {
        if (provider.begin != splice.declarationBegin) continue
        val target = bootstrapAnalysisGraphStable(edited, bootstrapAnalysisDeclarationId(provider))
        val readers = bootstrapAnalysisInterfaceReaders(documents, project, provider)
        val oldTarget = previous.symbols.get(target)
        if (readers == null || oldTarget == null) return null
        val targetAt = oldTarget.get("selectionRange").getInt("start")
        var oldReads = 0
        for (index in 0 until documents.size) {
            if (bootstrapAnalysisBudgetExpired()) return null
            val document = documents[index].document
            val key = bootstrapAnalysisGraphPath(document.uri)
            val before = previous.documents.get(key)
            val set = previous.occurrences.get(key)
            if (before == null || set == null) return null
            val source = before.getString("text")
            for (item in 0 until set.ids.size) {
                val start = set.begins[item]
                val end = set.ends[item]
                if (set.ids[item] != target && (end - start != provider.name.size ||
                    !bootstrapRegionEquals(source, start, end, provider.name))) continue
                if (set.ids[item] != target) return null
                if (index == changed && start == targetAt) continue
                var known = false
                for (reader in readers) {
                    if (reader.document == index && start >= reader.declaration.expression.begin &&
                        end <= reader.declaration.expression.end) known = true
                }
                if (!known || set.types[item] == "") return null
                oldReads = oldReads + 1
            }
        }
        val declarations = [provider]
        val begins: array<int> = []
        val ends: array<int> = []
        val kinds: array<string> = []
        val sources: array<string> = []
        var reads = 0
        for (reader in readers) {
            declarations.append(reader.declaration)
            bootstrapAnalysisCollectDeclarationRequests(reader.declaration, begins, ends, kinds, sources)
            reads = reads + reader.reads
        }
        if (reads != oldReads) return null
        // An attempted check must leave the full check's import-use collector
        // alone if the result or occurrence splice is later rejected.
        val importUses = bootstrapImportUses
        bootstrapImportUses = Map()
        val semantic = bootstrapFrontendAnalyzeRequested(BootstrapParseResult(declarations, [], 0, 0, [], [], ""),
            begins, ends, kinds, sources)
        bootstrapImportUses = importUses
        if (semantic.errors != 0 || semantic.extensionErrors != 0 || semantic.diagnostics != "" ||
            semantic.typedCalls.size != reads) return null
        val aliases: Map<string, string> = Map()
        bootstrapAnalysisGraphLocalAliases(edited, aliases)
        for (reader in readers) bootstrapAnalysisGraphLocalAliases(documents[reader.document], aliases)
        val builtinPath = bootstrapAnalysisGraphBuiltinsPath()
        for (document in documents) {
            if (document.document.path == builtinPath) bootstrapAnalysisGraphLocalAliases(document, aliases)
        }
        val lookup = BootstrapAnalysisGraphLookup()
        val mapped = bootstrapAnalysisGraphSemantic(semantic, documents, names, lookup, aliases, builtins)
        if (mapped.typedCalls.size != reads) return null
        for (call in mapped.typedCalls) if (call.canonicalTargetId != target) return null
        val occurrences = bootstrapAnalysisOccurrenceIndex(declarations, mapped, builtins)
        val updates: Map<string, BootstrapAnalysisOccurrenceSet> = Map()
        for (index in 0 until documents.size) {
            val document = documents[index]
            val key = bootstrapAnalysisGraphPath(document.document.uri)
            var affected = index == changed
            for (reader in readers) if (reader.document == index) affected = true
            if (!affected) continue
            val old = previous.occurrences.get(key)
            if (old == null) return null
            var set: BootstrapAnalysisOccurrenceSet = old
            val fresh = bootstrapAnalysisOccurrenceSet(document.document.text, document.document.path,
                document.parsed, declarations, mapped, aliases, true, occurrences)
            if (index == changed) {
                val replaced = bootstrapAnalysisReplayScalarOccurrence(set, fresh, splice, false)
                if (replaced == null) return null
                set = replaced
            }
            for (reader in readers) {
                if (reader.document != index) continue
                val body = reader.declaration.expression
                val width = body.end - body.begin
                val bodySplice = BootstrapAnalysisBodyInsert(body.begin, width, body.begin, "", 0, 0, "", width)
                val replaced = bootstrapAnalysisReplayScalarOccurrence(set, fresh, bodySplice)
                if (replaced == null) return null
                set = replaced
            }
            updates.set(key, set)
        }
        return updates
    }
    null
}

// Reuse the previous checked graph for one proved splice or checked body.
fun BootstrapAnalysisService.graphReplayBody(previous: BootstrapAnalysisGraphQueryIndex,
    documents: array<BootstrapAnalysisGraphDocument>, entry: string, project: BootstrapFrontendHostProject,
    before: BootstrapAnalysisReplayInputs, after: BootstrapAnalysisReplayInputs,
    checkScalar: bool, names: Map<string, string>,
    builtins: Map<string, string>): BootstrapAnalysisReplaySnapshot? {
    if (!previous.snapshot.get("complete").asBoolean() ||
        previous.snapshot.getString("entry") != entry ||
        previous.snapshot.get("documents").values.size != documents.size) return bootstrapAnalysisRejectReplay("old snapshot")
    var changed = -1
    for (index in 0 until documents.size) {
        val document = documents[index].document
        val old = previous.snapshot.get("documents").values[index]
        if (old.getString("uri") != document.uri) return bootstrapAnalysisRejectReplay("old document")
        for (diagnostic in old.get("diagnostics").values) {
            val code = diagnostic.getString("code")
            if (code == "W_NULLABLE_EARLY_EXIT" || code == "W_ARRAY_MAPPED" || code == "W_LOGICAL_ASSIGNMENT" ||
                code == "W_COMPOUND_ASSIGNMENT" || code == "W_INDEX_LOOP") continue
            if (!this.graphUnusedImports || code != "W_UNUSED_IMPORT") {
                return bootstrapAnalysisRejectReplay("old diagnostics")
            }
        }
        if (old.getString("text") != document.text) {
            if (changed >= 0) return bootstrapAnalysisRejectReplay("multiple changed sources")
            changed = index
        } else if (old.getInt("version") != document.version) return bootstrapAnalysisRejectReplay("overlay version")
    }
    if (changed < 0) return bootstrapAnalysisRejectReplay("no changed source")
    val doc = documents[changed]
    val changedPath = doc.document.path
    val original = previous.snapshot.get("documents").values[changed]
    if (doc.hostSource != "") return bootstrapAnalysisRejectReplay("rewritten host source")
    val oldText = original.getString("text")
    val plain = bootstrapAnalysisBodyChange(oldText, doc.document.text)
    val inert = plain != null && bootstrapAnalysisPlainBodyChange(doc.parsed, plain)
    val scalar = if (!inert && checkScalar) bootstrapAnalysisScalarChange(oldText, doc.document.text,
        doc.parsed, project.written) else null
    val interfaceEdit = if (!inert && scalar == null && checkScalar)
        bootstrapAnalysisScalarResultChange(oldText, doc.document.text, doc.parsed) else null
    val splice = if (scalar != null) scalar.splice else if (interfaceEdit != null) interfaceEdit else plain
    if (splice == null || (!inert && scalar == null && interfaceEdit == null) ||
        !bootstrapAnalysisReplayInputsAgree(before, after, changedPath, splice, scalar != null || interfaceEdit != null)) {
        return bootstrapAnalysisRejectReplay("body edit or parser inputs")
    }
    val oldSymbols = original.get("symbols").values
    val growth = if (splice.name != "" && splice.removed == 0) 1 else 0
    if (doc.exported.values.size != oldSymbols.size + growth) return bootstrapAnalysisRejectReplay("symbol count")
    var added = ""
    var matched = 0
    val retired: Map<string, bool> = Map()
    for (symbol in doc.exported.values) {
        val id = symbol.getString("id")
        if (splice.name != "" && symbol.get("selectionRange").getInt("start") == splice.nameBegin &&
            symbol.getString("name") == splice.name && symbol.getString("detail") == "local.val" &&
            added == "") {
            added = id
            if (splice.removed != 0) {
                if (matched >= oldSymbols.size || oldSymbols[matched].getString("id") != id) {
                    return bootstrapAnalysisRejectReplay("replaced binding moved")
                }
                matched = matched + 1
            }
        } else {
            if (matched >= oldSymbols.size) return bootstrapAnalysisRejectReplay("symbol count")
            val old = oldSymbols[matched]
            val oldId = old.getString("id")
            if (oldId != id) {
                if (!bootstrapAnalysisReplayShiftedTemporary(old, symbol, splice)) return bootstrapAnalysisRejectReplay("symbol changed")
                retired.set(oldId, true)
            }
            matched = matched + 1
        }
    }
    if ((splice.name != "" && added == "") || matched != oldSymbols.size) return bootstrapAnalysisRejectReplay("symbol alignment")
    val path = bootstrapAnalysisGraphPath(doc.document.uri)
    val oldSet = previous.occurrences.get(path)
    if (oldSet == null) return bootstrapAnalysisRejectReplay("old occurrences missing")
    val dependentSets = if (interfaceEdit != null)
        bootstrapAnalysisCheckInterface(previous, documents, project.written, names, builtins, changed, splice) else null
    if (interfaceEdit != null && dependentSets == null) return bootstrapAnalysisRejectReplay("interface dependencies")
    val updated = if (dependentSets != null) dependentSets.get(path)
        else if (scalar == null) bootstrapAnalysisReplayOccurrence(oldSet, splice, added)
        else {
            var builtinDocument: BootstrapAnalysisGraphDocument? = null
            for (item in documents) if (item.document.path == bootstrapAnalysisGraphBuiltinsPath()) builtinDocument = item
            val checked = bootstrapAnalysisCheckScalarBody(doc, scalar, builtins, builtinDocument, documents)
            if (checked == null) return bootstrapAnalysisRejectReplay("scalar body did not check")
            bootstrapAnalysisReplayScalarOccurrence(oldSet, checked, splice)
        }
    if (updated == null) return bootstrapAnalysisRejectReplay("occurrence overlaps")
    val values: array<Json> = []
    val sets: Map<string, BootstrapAnalysisOccurrenceSet> = Map()
    val fingerprints: Map<string, string> = Map()
    val uris: array<string> = []
    val offsetIdPrefix = "abla:$changedPath:"
    val contractIdPrefix = "abla:$changedPath#contract:"
    val stdlib = bootstrapPathUnderPrefix(bootstrapStandardLibraryRoot())
    val mappedProvider = bootstrapAnalysisMappedProvider(project.written.declarations, "${stdlib}abla/array/entry.ab")
    // The syntax-side use facts have been checked above. The proof preserves
    // resolved names, so the checked use facts still describe this revision.
    // Run the same warning pass against the new source and import locations.
    val warnings = if (this.graphUnusedImports) {
        val uses: Map<string, bool> = Map()
        for (key in before.checkedImportUses) uses.set(key, true)
        bootstrapUnusedImportWarnings(uses)
    } else ""
    for (index in 0 until documents.size) {
        val document = documents[index]
        val uri = document.document.uri
        val key = bootstrapAnalysisGraphPath(uri)
        val rechecked = if (dependentSets != null) dependentSets.get(key) else null
        val set = if (rechecked != null) rechecked else if (index == changed) updated else previous.occurrences.get(key)
        if (set == null) return bootstrapAnalysisRejectReplay("set missing")
        // Graph-v2 normally exports stable IDs. Any residual offset-based
        // target into the edited module must go through full typing.
        for (id in set.ids) {
            if (id.startsWith(offsetIdPrefix) || id.startsWith(contractIdPrefix) || retired.has(id)) return bootstrapAnalysisRejectReplay("offset ID")
        }
        val old = previous.snapshot.get("documents").values[index]
        val diagnostics = bootstrapAnalysisGraphDiagnostics(document, project, "", warnings,
            if (this.idiomSource(document.document.path, stdlib)) set else null, mappedProvider, replay = true)
        val diagnosticText = jsonStringify(diagnostics)
        if (index != changed && diagnosticText != jsonStringify(old.get("diagnostics"))) {
            return bootstrapAnalysisRejectReplay("untouched diagnostics changed")
        }
        val fingerprint = if (index == changed || rechecked != null)
            "${document.document.version}|${document.key}|${bootstrapAnalysisGraphSetHash(set)}|${bootstrapAnalysisGraphHash(diagnosticText)}"
            else this.graphFingerprint("${previous.revision}", uri)
        if (fingerprint == "") return bootstrapAnalysisRejectReplay("fingerprint missing")
        fingerprints.set(uri, fingerprint)
        uris.append(uri)
        sets.set(key, set)
        values.append(if (index != changed) old else bootstrapAnalysisGraphDocumentJson(
            uri, document.document.version, document.document.text,
            bootstrapAnalysisStableSymbols(document.symbols, document.stable), jsonNull(), diagnostics
        ))
    }
    val generated: Map<string, Json> = Map()
    for (id in previous.symbols.keys()) {
        if (!id.contains("#generated:")) continue
        if (id.startsWith("abla:$changedPath#generated:")) return bootstrapAnalysisRejectReplay("generated symbol")
        val symbol = previous.symbols.get(id)
        if (symbol != null) generated.set(id, symbol)
    }
    val snapshot = bootstrapAnalysisGraphSnapshotJson(this.revision, values, this.graphModeName(), true, [], entry)
    BootstrapAnalysisReplaySnapshot(snapshot, sets, generated, fingerprints, uris, scalar != null, interfaceEdit != null)
}

fun BootstrapAnalysisService.graphSnapshotRun(reuseTyping: bool = true): Json {
    val entry = this.graphEntry()
    if (entry == "") return bootstrapAnalysisGraphIncomplete(this.revision,
        "select one project entry with entryPoints or analyze roots; no project entry was found",
        this.graphModeName())
    if (bootstrapAnalysisGraphActiveEntry != entry) {
        bootstrapAnalysisGraphActiveEntry = entry
        bootstrapAnalysisGraphModules = bootstrapModuleState()
        bootstrapModuleFreezeSnapshots = bootstrapAnalysisFreezeEnabled()
        this.graphParsed = Map()
        if (reuseTyping) this.graphReplayInputs = null
    }
    bootstrapAnalysisGraphModules.overlays = []
    for (document in this.overlays) {
        if (document.active) bootstrapAnalysisGraphModules.overlays.append(BootstrapModuleOverlay(
            bootstrapAnalysisGraphPath(document.path), document.text, document.version))
    }
    if (!bootstrapAnalysisGraphModules
        .sourceExists(entry)) return bootstrapAnalysisGraphIncomplete(this.revision,
            "project entry does not exist and has no open overlay", this.graphModeName())
    // The revision's answer is held and a reload would read what the load behind it read: the answer, before anything of the last run is
    // reset (a repeated request reloaded and re-parsed the project for an answer it then took from the cache, 120-150 ms on abla-one).
    if (reuseTyping && this.graphIndexRevision == this.revision) {
        val held = this.graphQueryIndex
        if (held != null && held.revision == this.revision && this.graphUnchangedSinceLoad(entry)) {
            if (linuxEnvironment("ABLA_ANALYSIS_INCREMENTAL_TRACE").value == "1") linuxPrintStandardError("abla-analysis-typing unchanged inputs: held answer\n")
            return held.snapshot
        }
    }
    bootstrapSourceRewrites = []
    if (this.graphJsonConstruction) {
        bootstrapJsonConstructionReset()
        bootstrapUnusedImportEntry = ""
    }
    if (bootstrapUnusedImportsWanted()) {
        // W_UNUSED_IMPORT (on by default) is made from what this one front end run recorded: nothing of an earlier run stays, with
        // the option or without it (the service runs for days).
        bootstrapImportUses = Map()
        bootstrapUnusedImportChecked = Map()
        bootstrapUnusedImportEdges = []
        bootstrapUnusedImportEntry = ""
    }
    if (this.graphUnusedDeclarations) bootstrapUnusedDeclarationList = []
    if (this.graphUnusedLocals || this.graphUnusedParameters) {
        bootstrapUnusedLocalDeclared = []
        bootstrapUnusedParameterDeclared = []
        bootstrapFunctionValueUses = Map()
        bootstrapUnusedLocalUsed = Map()
    }
    val setting = linuxEnvironment("ABLA_ANALYSIS_INCREMENTAL_TYPING")
    val replay = reuseTyping && this.graphStableIds && setting.value != "0" &&
        !this.graphUnusedLocals && !this.graphUnusedParameters &&
        !this.graphUnusedDeclarations && !this.graphJsonConstruction
    if (!replay && this.graphIndexRevision != this.revision) this.graphQueryIndex = null
    bootstrapAnalysisSampleMemory("analysis begin")
    if (replay) bootstrapAnalysisGraphModules.syntaxInputs = BootstrapModuleSyntaxInputs()
    bootstrapAnalysisGraphModules.captureSyntaxInputs = replay
    val project = bootstrapFrontendLoadHostProject(entry, bootstrapAnalysisGraphModules)
    bootstrapAnalysisGraphModules.captureSyntaxInputs = false
    if (project == null || bootstrapAnalysisBudgetExpired()) return this.graphBudgetIncomplete()
    val syntax = if (replay) bootstrapAnalysisGraphModules.syntaxInputs.copy() else null
    if (replay) bootstrapAnalysisGraphModules.syntaxInputs = BootstrapModuleSyntaxInputs()
    bootstrapAnalysisSampleMemory("project loaded")
    this.graphObserveInputs(project, entry)
    val loadKey = BootstrapAnalysisLoadKey(entry, project.loadedPaths, bootstrapModuleCopyStrings(project.written.compileInputPaths),
        bootstrapModuleCopyStrings(project.written.compileInputContents))
    if (bootstrapAnalysisBudgetExpired()) return this.graphBudgetIncomplete()
    // The slot of `cached` is only set when this returns: on the way to a new generation nothing here holds the old one.
    if (this.graphIndexRevision == this.revision) {
        val cached = this.graphQueryIndex
        if (cached != null && cached.revision == this.revision) {
            this.graphLoadKey = loadKey
            return cached.snapshot
        }
    }
    // The previous generation (its answer tree and indexes, ~2 GB on the compiler's own source) is released before the new one
    // is built, not when it is replaced: both were resident for the length of an analysis.
    if (!replay) this.graphQueryIndex = null
    val documents: array<BootstrapAnalysisGraphDocument> = []
    val names: Map<string, string> = Map()
    val pending: array<Json> = []
    var sourceBytes = 0
    // Only an analysis that follows another holds anything yet: the first has nothing to re-mark, and keeps the compiler's step.
    val holdsProject = this.graphParsed.size > 0
    for (module in project.modules) {
        if (bootstrapAnalysisBudgetExpired()) return this.graphBudgetIncomplete()
        if (module.source != "" || bootstrapAnalysisGraphModules.sourceExists(module.path)) {
            var uri = bootstrapAnalysisGraphUri(module.path)
            var version = 0
            for (overlay in this.overlays) {
                if (overlay.active && bootstrapAnalysisGraphPath(overlay.path) ==
                    bootstrapAbsoluteModulePath(module.path)) {
                    uri = overlay.uri
                    version = overlay.version
                }
            }
            val source = if (module.source !=
                "") module.source else bootstrapAnalysisGraphModules.acquire(module.path).source
            val full = project.fullModules.has(module.path)
            val cached = this.graphParsed.get(module.path)
            // The parser's only effect outside its result is recording the module's source rewrites: the cached ones are put back.
            val entryParsed = if (cached != null && cached.source == source && cached.uri == uri &&
                cached.full == full && cached.hostSource == module.hostSource) bootstrapAnalysisGraphReuse(cached)
                else bootstrapAnalysisGraphFrozen(
                    bootstrapAnalysisGraphParse(source, uri, full, module.path, this.graphStableIds, module.hostSource))
            this.graphParsed.set(module.path, entryParsed)
            // Contract-only placeholders have no implementation to evaluate.
            if (module.source != "") {
                for (site in entryParsed.pending) pending.append(site)
            }
            val parsed = entryParsed.parsed
            sourceBytes = sourceBytes + source.size
            documents.append(BootstrapAnalysisGraphDocument(
                BootstrapAnalysisDocument(uri, module.path, version, source, true), parsed,
                entryParsed.symbols, entryParsed.rewrite, entryParsed.stable, entryParsed.exported, entryParsed.key, module.hostSource))
            for (declaration in parsed
                .declarations) bootstrapAnalysisGraphDeclarationCallNames(declaration, names)
            for (action in parsed.actions) bootstrapAnalysisGraphCallNames(action, module.path,
                names)
        }
    }
    // The compiler's heap steps by a fixed 256 MB (orc_main.ab); a service that holds a big project steps by what it holds (unless
    // ABLA_COMPILER_COLLECT_GROWTH_MB says what the step is), from its second analysis on.
    val configuredGrowth = linuxEnvironment("ABLA_COMPILER_COLLECT_GROWTH_MB")
    if (holdsProject && (!configuredGrowth.found || configuredGrowth.value == "")) {
        runtimeMemorySetCollectionGrowth(bootstrapAnalysisCollectionGrowth(sourceBytes))
    }
    // The built-in types and members, as a document that is never typed.
    var builtinIds: Map<string, string> = Map()
    val builtinDeclarations: array<BootstrapDeclaration> = []
    val builtinPath = bootstrapAnalysisGraphBuiltinsPath()
    var builtinPresent = false
    for (document in documents) {
        if (document.document.path == builtinPath) builtinPresent = true
    }
    if (!builtinPresent && Path(builtinPath).info().exists()) {
        val builtinUri = bootstrapAnalysisGraphUri(builtinPath)
        val builtinSource = Path(builtinPath).readText()
        val cachedBuiltins = this.graphParsed.get(builtinPath)
        val builtinParsed = if (cachedBuiltins != null && cachedBuiltins.source == builtinSource && cachedBuiltins.uri == builtinUri)
            bootstrapAnalysisGraphReuse(cachedBuiltins)
            else bootstrapAnalysisGraphParse(builtinSource, builtinUri, true, builtinPath, this.graphStableIds)
        this.graphParsed.set(builtinPath, builtinParsed)
        documents.append(BootstrapAnalysisGraphDocument(
            BootstrapAnalysisDocument(builtinUri, builtinPath, 0, builtinSource, true), builtinParsed.parsed,
            builtinParsed.symbols, builtinParsed.rewrite, builtinParsed.stable, builtinParsed.exported, builtinParsed.key, ""))
        builtinIds = bootstrapAnalysisGraphBuiltinIds(builtinParsed.parsed.declarations)
        for (declaration in builtinParsed.parsed.declarations) builtinDeclarations.append(declaration)
    }
    val replayInputs = if (syntax != null && syntax.replayable && project.written.errors == 0 &&
        project.written.extensionErrors == 0 && project.written.diagnostics == "" &&
        pending.size == 0) {
        val metadata: array<string> = []
        for (index in 0 until this.graphInputPaths.size) {
            val observed = this.graphInputPaths[index]
            if (observed.startsWith("metadata:")) {
                metadata.append(observed)
                metadata.append(this.graphInputValues[index])
            }
        }
        val syntaxImportUses: array<string> = if (this.graphUnusedImports) bootstrapImportUses.keys() else []
        BootstrapAnalysisReplayInputs(syntax.copy(), metadata, syntaxImportUses)
    } else null
    if (replay && linuxEnvironment("ABLA_ANALYSIS_INCREMENTAL_TRACE").value == "1" && syntax != null) {
        linuxPrintStandardError("abla-analysis-typing capture ready=${replayInputs != null} valid=${syntax.replayable} bytes=${syntax.expansionBytes} errors=${project.written.errors} diagnostics=${project.written.diagnostics.size} pending=${pending.size}\n")
    }
    if (replay && replayInputs != null) {
        val prior = this.graphQueryIndex
        val before = this.graphReplayInputs
        if (prior != null && before != null) {
            val reused = this.graphReplayBody(prior, documents, entry, project, before, replayInputs,
                setting.value == "2", names, builtinIds)
            if (bootstrapAnalysisBudgetExpired()) return this.graphBudgetIncomplete()
            if (reused != null) {
                this.graphReplayInputs = BootstrapAnalysisReplayInputs(replayInputs.syntax.copy(),
                    bootstrapModuleCopyStrings(replayInputs.metadata),
                    replayInputs.syntaxImportUses, bootstrapModuleCopyStrings(before.checkedImportUses))
                this.graphQueryIndex = bootstrapAnalysisGraphQueryIndex(reused.snapshot, this.revision, reused.sets, reused.generated)
                this.graphIndexRevision = this.revision
                this.graphLoadKey = loadKey
                this.graphRememberGeneration(BootstrapAnalysisGraphGeneration(reused.snapshot.getString("revision"), reused.fingerprints, reused.uris))
                if (linuxEnvironment("ABLA_ANALYSIS_INCREMENTAL_TRACE").value == "1") {
                    linuxPrintStandardError(if (reused.checkedInterface) "abla-analysis-typing rechecked scalar interface and dependents\n"
                        else if (reused.checkedScalar) "abla-analysis-typing rechecked one scalar body\n"
                        else "abla-analysis-typing replayed a type-inert body edit\n")
                }
                bootstrapAnalysisSampleMemory("answer built")
                return reused.snapshot
            }
        }
    }
    this.graphQueryIndex = null
    val begins: array<int> = []
    val ends: array<int> = []
    val kinds: array<string> = []
    val sources: array<string> = []
    for (declaration in project.written.declarations) {
        bootstrapAnalysisCollectDeclarationRequests(declaration, begins, ends, kinds, sources)
    }
    for (action in project.written.actions) {
        bootstrapAnalysisCollectTypedRequests(action, entry, begins, ends, kinds, sources)
    }
    bootstrapAnalysisSampleMemory("documents parsed")
    val analyzed = bootstrapFrontendTypeProject(project.written, begins, ends, kinds, sources)
    if (bootstrapAnalysisBudgetExpired()) return this.graphBudgetIncomplete()
    if (replay) {
        this.graphReplayInputs = if (replayInputs != null && analyzed != null && analyzed.semantic.errors == 0 &&
            analyzed.semantic.extensionErrors == 0 && analyzed.semantic.diagnostics == "") {
            BootstrapAnalysisReplayInputs(replayInputs.syntax.copy(), bootstrapModuleCopyStrings(replayInputs.metadata),
                replayInputs.syntaxImportUses, if (this.graphUnusedImports) bootstrapImportUses.keys() else [])
        } else null
    }
    bootstrapAnalysisSampleMemory("typed")
    val aliases: Map<string, string> = Map()
    for (document in documents) bootstrapAnalysisGraphLocalAliases(document, aliases)
    val lookup = BootstrapAnalysisGraphLookup()
    val generatedFields: Map<string, Json> = Map()
    val values: array<Json> = []
    val sets: Map<string, BootstrapAnalysisOccurrenceSet> = Map()
    val fingerprints: Map<string, string> = Map()
    val fingerprintUris: array<string> = []
    var semanticDiagnostics = ""
    var unusedImports = ""
    if (analyzed != null) {
        for (declaration in analyzed.parsed.declarations) {
            bootstrapAnalysisGraphDeclarationAliases(declaration, documents, aliases, lookup)
            bootstrapAnalysisGraphGeneratedFields(declaration, documents, lookup, aliases, generatedFields)
        }
        for (declaration in builtinDeclarations) {
            bootstrapAnalysisGraphDeclarationAliases(declaration, documents, aliases, lookup)
        }
        val semantic = bootstrapAnalysisGraphSemantic(analyzed.semantic, documents, names, lookup, aliases, builtinIds)
        semanticDiagnostics = semantic.diagnostics
        // Only after a front end without errors: one that stopped early never recorded every use (orc_main.ab does the same).
        // The editor's analysis never runs compile code, so a `$json` subparser is unknown to it (subparser.unknown): that
        // error doesn't stop the uses being recorded, and the warning pass knows which imports such a module's subparsers keep.
        if (this.graphUnusedImports && !project.written.diagnostics.contains("error[") &&
            bootstrapAnalysisCount(semanticDiagnostics, "error[") ==
            bootstrapAnalysisCount(semanticDiagnostics, "error[E_SEMANTIC]: subparser.unknown:")) {
            unusedImports = bootstrapUnusedImportWarnings()
        }
        if (this.graphUnusedLocals && !project.written.diagnostics.contains("error[") &&
            bootstrapAnalysisCount(semanticDiagnostics, "error[") ==
            bootstrapAnalysisCount(semanticDiagnostics, "error[E_SEMANTIC]: subparser.unknown:")) {
            unusedImports = "$unusedImports${bootstrapUnusedLocalWarnings()}"
        }
        if (this.graphUnusedDeclarations && !project.written.diagnostics.contains("error[") &&
            bootstrapAnalysisCount(semanticDiagnostics, "error[") ==
            bootstrapAnalysisCount(semanticDiagnostics, "error[E_SEMANTIC]: subparser.unknown:")) {
            unusedImports = "$unusedImports${bootstrapUnusedDeclarationWarnings()}"
        }
        if (this.graphUnusedParameters && !project.written.diagnostics.contains("error[") &&
            bootstrapAnalysisCount(semanticDiagnostics, "error[") ==
            bootstrapAnalysisCount(semanticDiagnostics, "error[E_SEMANTIC]: subparser.unknown:")) {
            unusedImports = "$unusedImports${bootstrapUnusedParameterWarnings()}"
        }
        bootstrapAnalysisSampleMemory("semantic converted")
        if (this.graphJsonConstruction && !project.written.diagnostics.contains("error[") && semanticDiagnostics == "") {
            unusedImports = "$unusedImports${bootstrapJsonConstructionWarnings()}"
        }
        val occurrenceIndex = bootstrapAnalysisOccurrenceIndex(analyzed.parsed.declarations,
            semantic, builtinIds)
        bootstrapAnalysisSampleMemory("occurrence index")
        val stdlib = bootstrapPathUnderPrefix(bootstrapStandardLibraryRoot())
        val mappedProvider = bootstrapAnalysisMappedProvider(project.written.declarations, "${stdlib}abla/array/entry.ab")
        for (document in documents) {
            if (bootstrapAnalysisBudgetExpired()) return this.graphBudgetIncomplete()
            // Kept compact for the queries, and in the answer as the text it encodes to: not a node per occurrence.
            val set = bootstrapAnalysisOccurrenceSet(document.document.text, document.document.path,
                document.parsed, analyzed.parsed.declarations, semantic, aliases, true,
                occurrenceIndex, document.hostSource)
            sets.set(bootstrapAnalysisGraphPath(document.document.uri), set)
            val diagnostics = bootstrapAnalysisGraphDiagnostics(document, project, semanticDiagnostics, unusedImports,
                if (this.idiomSource(document.document.path, stdlib)) set else null, mappedProvider)
            if (this.graphStableIds) {
                fingerprints.set(document.document.uri,
                    "${document.document.version}|${document.key}|${bootstrapAnalysisGraphSetHash(set)}|${bootstrapAnalysisGraphHash(jsonStringify(diagnostics))}")
                fingerprintUris.append(document.document.uri)
            }
            // The occurrences are left out (null) here: the text of a document's set is made when an answer carries the document
            // (graphMaterialize), not for the documents a `since` answer leaves out.
            values.append(bootstrapAnalysisGraphDocumentJson(
                document.document.uri, document.document.version, document.document.text,
                document.exported, jsonNull(), diagnostics
            ))
        }
    } else {
        for (document in documents) {
            if (bootstrapAnalysisBudgetExpired()) return this.graphBudgetIncomplete()
            val diagnostics = bootstrapAnalysisGraphDiagnostics(document, project, "")
            if (this.graphStableIds) {
                fingerprints.set(document.document.uri,
                    "${document.document.version}|${document.key}||${bootstrapAnalysisGraphHash(jsonStringify(diagnostics))}")
                fingerprintUris.append(document.document.uri)
            }
            values.append(bootstrapAnalysisGraphDocumentJson(
                document.document.uri, document.document.version, document.document.text,
                document.exported, jsonArray([]), diagnostics
            ))
        }
    }
    val result = bootstrapAnalysisGraphSnapshotJson(
        this.revision, values, this.graphModeName(), analyzed != null && pending.size == 0, pending, entry
    )
    bootstrapAnalysisSampleMemory("answer built")
    if (bootstrapAnalysisBudgetExpired()) return this.graphBudgetIncomplete()
    this.graphQueryIndex = bootstrapAnalysisGraphQueryIndex(result, this.revision, sets, generatedFields)
    this.graphIndexRevision = this.revision
    this.graphLoadKey = loadKey
    if (this.graphStableIds) this.graphRememberGeneration(BootstrapAnalysisGraphGeneration(
        "${this.revision}", fingerprints, fingerprintUris))
    return result
}

// One immutable export/index generation per service. Replacing it releases all
// previous references; no per-edit history, AST or sema graph is retained here.
class BootstrapAnalysisGraphQueryIndex(
    val revision: int,
    val snapshot: Json,
    val documents: Map<string, Json>,
    val symbols: Map<string, Json>,
    // Each document's occurrences by its path (none for a document of an incomplete analysis).
    val occurrences: Map<string, BootstrapAnalysisOccurrenceSet>
)

fun bootstrapAnalysisGraphQueryIndex(snapshot: Json, revision: int,
    occurrences: Map<string, BootstrapAnalysisOccurrenceSet>,
    var symbols: Map<string, Json>): BootstrapAnalysisGraphQueryIndex {
    val documents: Map<string, Json> = Map()
    for (document in snapshot.get("documents").values) {
        val uri = document.getString("uri")
        documents.set(bootstrapAnalysisGraphPath(uri), document)
        for (symbol in document.get("symbols").values) symbols.set(symbol.getString("id"), symbol)
    }
    BootstrapAnalysisGraphQueryIndex(revision, snapshot, documents, symbols, occurrences)
}

/** The locations of every occurrence by the declaration it names (built once for a generation). */
fun bootstrapAnalysisGraphBuildReferences(index: BootstrapAnalysisGraphQueryIndex): Map<string, array<Json>> {
    val references: Map<string, array<Json>> = Map()
    for (document in index.snapshot.get("documents").values) {
        if (bootstrapAnalysisBudgetExpired()) return references
        val uri = document.getString("uri")
        val set = index.occurrences.get(bootstrapAnalysisGraphPath(uri))
        if (set != null) {
            for (item in 0 until set.begins.size) {
                val id = set.ids[item]
                if (id != "") {
                    val location = $json {
                        "uri": uri,
                        "range": {"start": set.begins[item], "end": set.ends[item]}
                    }
                    val previous = references.get(id)
                    if (previous != null) previous.append(location)
                    else references.set(id, [location])
                }
            }
        }
    }
    references
}

fun BootstrapAnalysisService.graphMissingImports(id: int, params: Json): string {
    val uri = params.getString("uri")
    if (!bootstrapAnalysisGraphUriValid(uri)) return bootstrapAnalysisError(id, "invalid_params",
        "missing imports requires a local absolute file URI")
    val index = this.graphQueryIndex
    if (params.getString("revision") != "${this.revision}" || index == null || index.revision != this.revision) {
        return bootstrapAnalysisError(id, "stale_revision", "analysis revision is stale")
    }
    val document = index.documents.get(bootstrapAnalysisGraphPath(uri))
    if (document == null || index.snapshot.get("pending").size() != 0) {
        return bootstrapAnalysisResponse(id, jsonNull())
    }
    var count = 0
    val wanted: array<string> = []
    val seen: Map<string, bool> = Map()
    for (diagnostic in document.get("diagnostics").values) {
        if (bootstrapAnalysisBudgetExpired()) return bootstrapAnalysisError(id, "analysis_incomplete", "request time budget exceeded")
        val code = diagnostic.getString("code")
        if (code != "E_NAME_NOT_IMPORTED" && code != "E_SEMANTIC") continue
        val fixes = diagnostic.get("fixes").values
        var line = ""
        if (fixes.size == 1 && fixes[0].getString("kind") == "import") {
            val edits = fixes[0].get("edits").values
            if (edits.size == 1) line = edits[0].getString("newText").trim()
        }
        if (line == "" && code == "E_NAME_NOT_IMPORTED") {
            for (help in diagnostic.get("help").values) {
                val sample = help.asString()
                if (sample.startsWith("add: import \"")) line = sample.slice(5, sample.size)
            }
            // The strict-import scan emits its help before the source
            // location. Recover the same spelling from its declaring module.
            val message = diagnostic.getString("message")
            val from = "` is declared in "
            val to = ", which this module doesn't import"
            val start = message.indexOf(from)
            if (line == "" && start >= 0 && message.endsWith(to)) {
                val declaring = message.slice(start + from.size, message.size - to.size)
                line = bootstrapStrictImportLine(bootstrapAnalysisGraphPath(uri), declaring)
            }
        }
        // An unambiguous stdlib import can be attached to E_SEMANTIC.
        // A name without an import choice must remain an explicit fix.
        if (!line.startsWith("import \"") || !line.endsWith("\"") ||
            line.contains("\n") || line.contains(".abla/packages/")) {
            if (code == "E_NAME_NOT_IMPORTED") return bootstrapAnalysisResponse(id, jsonNull())
            continue
        }
        count = count + 1
        if (!seen.has(line)) {
            seen.set(line, true)
            wanted.append(line)
        }
    }
    if (count < 2) return bootstrapAnalysisResponse(id, jsonNull())
    val insertion = bootstrapFixImportsInsertion(document.getString("text"), wanted)
    if (insertion.newText == "" || bootstrapAnalysisBudgetExpired()) return bootstrapAnalysisResponse(id, jsonNull())
    val validation = this.validateEdit($json {
        "baseRevision": "${this.revision}",
        "edits": [{"uri": uri, "start": insertion.at, "end": insertion.at, "newText": insertion.newText}]
    }, true)
    if (!validation.get("valid").asBoolean()) return bootstrapAnalysisResponse(id, jsonNull())
    bootstrapAnalysisResponse(id, $json {"offset": insertion.at, "newText": insertion.newText})
}

fun BootstrapAnalysisService.graphQuery(id: int, method: string, params: Json): string {
    val uri = params.getString("uri")
    if (!bootstrapAnalysisGraphUriValid(uri) || !params.get("offset").intAvailable() ||
        params.getInt("offset") < 0) return bootstrapAnalysisError(id, "invalid_params",
            "queries require a local absolute file URI and a nonnegative UTF-8 byte offset")
    val snapshot = this.graphSnapshot()
    if (bootstrapAnalysisBudgetExpired())
        return bootstrapAnalysisError(id, "analysis_incomplete", "request time budget exceeded")
    val requestedRevision = params.get("revision")
    if (!requestedRevision.isNull() && (!requestedRevision.isString() ||
        requestedRevision.asString() != snapshot.getString("revision"))) {
        return bootstrapAnalysisError(id, "stale_revision", "analysis revision is stale")
    }
    val index = this.graphQueryIndex
    if (index == null || !snapshot.has("entry") || index.revision != this.revision) {
        return bootstrapAnalysisError(id, "analysis_incomplete",
            "no project entry is available for this query")
    }
    val document = index.documents.get(bootstrapAnalysisGraphPath(uri))
    if (document == null) return bootstrapAnalysisError(id, "document_not_analyzed",
        "the document is outside the selected program graph")
    val offset = params.getInt("offset")
    if (offset > document.getString("text").size) return bootstrapAnalysisError(id,
        "invalid_params",
        "offset is outside the document")
    val known = index.occurrences.get(bootstrapAnalysisGraphPath(uri))
    val occurrences = if (known != null) known else BootstrapAnalysisOccurrenceSet([], [], [], [])
    var low = 0
    var high = occurrences.begins.size
    while (low < high) {
        val middle = low + (high - low) / 2
        if (occurrences.ends[middle] <= offset) low = middle + 1
        else high = middle
    }
    var found = -1
    if (low < occurrences.begins.size && occurrences.begins[low] <= offset) {
        found = low
    }
    val identity = if (found >= 0) occurrences.ids[found] else ""
    val symbol = index.symbols.get(identity)
    var value = jsonNull()
    if (method == "query/definition") {
        if (symbol != null) value = index.withDocumentation(symbol)
    } else if (method == "query/hover") {
        if (found >= 0) value = $json {
            "range": {"start": occurrences.begins[found], "end": occurrences.ends[found]},
            "type": occurrences.types[found],
            "symbol": if (symbol != null) index.withDocumentation(symbol) else jsonNull()
        }
    } else {
        // One location object per occurrence: only this query needs them, so they are made on its first use for a generation.
        if (this.graphReferencesRevision != this.revision) {
            this.graphReferences = bootstrapAnalysisGraphBuildReferences(index)
            if (bootstrapAnalysisBudgetExpired()) {
                val _incomplete = this.graphBudgetIncomplete()
                return bootstrapAnalysisError(id, "analysis_incomplete", "request time budget exceeded")
            }
            this.graphReferencesRevision = this.revision
        }
        val references = this.graphReferences.get(identity)
        value = if (references != null) jsonArray(references) else jsonArray([])
    }
    bootstrapAnalysisResponse(id, $json {
        "revision": snapshot.get("revision"),
        "complete": snapshot.get("complete"),
        "pending": snapshot.get("pending"),
        "value": value
    })
}

// Projection is a wire view of the existing immutable full snapshot. Keep the
// internal occurrence/query indexes warm; do not reinterpret omission as an
// empty reference set, and never change the default response shape.
fun bootstrapAnalysisGraphFieldsValid(fields: Json): bool {
    if (!fields.isArray() || fields.size() > 3) return false
    var symbols = false
    var occurrences = false
    var diagnostics = false
    for (field in fields.values) {
        if (!field.isString()) return false
        val name = field.asString()
        if (name == "symbols" && !symbols) symbols = true
        else if (name == "occurrences" && !occurrences) occurrences = true
        else if (name == "diagnostics" && !diagnostics) diagnostics = true
        else return false
    }
    true
}

fun bootstrapAnalysisGraphProjection(snapshot: Json, fields: Json): Json {
    val documents: array<Json> = []
    for (document in snapshot.get("documents").values) {
        val keys = ["uri", "version", "text"]
        val values = [document.get("uri"), document.get("version"), document.get("text")]
        for (name in ["symbols", "occurrences", "diagnostics"]) {
            var selected = false
            for (field in fields.values) {
                if (field.asString() == name) selected = true
            }
            if (selected) {
                keys.append(name)
                values.append(document.get(name))
            }
        }
        documents.append(jsonObject(keys, values))
    }
    val keys: array<string> = []
    val values: array<Json> = []
    for (index in 0 until snapshot.keys.size) {
        val key = snapshot.keys[index]
        keys.append(key)
        values.append(if (key == "documents") jsonArray(documents) else snapshot.values[index])
    }
    keys.append("fields")
    values.append(fields)
    jsonObject(keys, values)
}

/** Whether a reload of `entry` would read what the load behind the held answer read (graphLoadKey): the same entry, the manifests and
 *  compile-time inputs as they were, and a module graph that, resolved again, lists the same modules and reads none anew
 *  (bootstrapFrontendHostGraphUnchanged). Overlays are covered by the revision: a document change is a new one. */
fun BootstrapAnalysisService.graphUnchangedSinceLoad(entry: string): bool {
    val key = this.graphLoadKey ?? return false
    if (key.entry != entry || key.compilePaths.size != key.compileContents.size) return false
    for (index in 0 until this.graphInputPaths.size) {
        val observed = this.graphInputPaths[index]
        if (observed.startsWith("metadata:") && Path(observed.slice(9, observed.size)).readText() != this.graphInputValues[index]) return false
    }
    for (index in 0 until key.compilePaths.size) {
        if (bootstrapCompileInputContents(key.compilePaths[index]) != key.compileContents[index]) return false
    }
    bootstrapFrontendHostGraphUnchanged(entry, bootstrapAnalysisGraphModules, key.paths)
}
