import "generic_types.ab"
// Opt-in graph-aware analysis for compiler-protocol clients. No LSP transport.
import "analysis_service.ab"
import "frontend.ab"
import "frontend_diagnostics.ab"
import "module.ab"
import "module_paths.ab"
import "package.ab"
import "parser.ab"
import "sema.ab"
import "source_rewrite.ab"
import "staged_parser.ab"
import "abla/json"
import "abla/sys/linux/fs"
import "abla/bytes"

// Compiler frontend globals are serial already. One process-local graph state
// avoids handing an immutable field view to the mutable module-state API.
// Every request replaces overlays and begins a new acquisition generation.
var bootstrapAnalysisGraphActiveEntry = ""
var bootstrapAnalysisGraphModules: BootstrapModuleState = bootstrapModuleState()

class BootstrapAnalysisGraphDocument(
    val document: BootstrapAnalysisDocument,
    val parsed: BootstrapParseResult,
    val symbols: Json,
    val rewrite: BootstrapSourceRewrite
)

fun bootstrapAnalysisGraphUriValid(uri: string): bool {
    if (uri.size < 8 || uri.slice(0, 8) != "file:///") return false
    var index = 8
    while (index < uri.size) {
        val byte = uri[index]
        if (byte == 0 || byte == 35 || byte == 63 || byte < 32) return false
        if (byte == 37) {
            if (index + 2 >= uri.size) return false
            val high = bootstrapAnalysisHexDigit(uri[index + 1])
            val low = bootstrapAnalysisHexDigit(uri[index + 2])
            if (high < 0 || low < 0 || high * 16 + low == 0) return false
            index = index + 2
        }
        index = index + 1
    }
    true
}

fun bootstrapAnalysisGraphPath(value: string): string =
    bootstrapAbsoluteModulePath(if (value.size >= 7 && value.slice(0, 7) == "file://")
        bootstrapAnalysisUriPath(value) else value)

fun bootstrapAnalysisGraphUri(path: string): string {
    val absolute = bootstrapAbsoluteModulePath(path)
    val hex = "0123456789ABCDEF"
    var result = "file://"
    for (index in 0 until absolute.size) {
        val byte = absolute[index]
        if ((byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) ||
            (byte >= 48 && byte <= 57) || byte == 47 || byte == 45 ||
            byte == 46 || byte == 95 || byte == 126) {
            result = "$result${absolute.slice(index, index + 1)}"
        } else result = "$result%${hex.slice(byte / 16, byte / 16 + 1)}${hex.slice(byte % 16, byte % 16 + 1)}"
    }
    result
}

fun bootstrapAnalysisGraphEntry(value: string): string {
    val path = bootstrapAnalysisGraphPath(value)
    if (!Path(path).info().isDirectory()) return path
    val project = bootstrapProjectDescriptor(path)
    if (project.valid) return bootstrapNormalizeModulePath(project.entry)
    ""
}

fun BootstrapAnalysisService.graphEntry(): string {
    val candidates = if (this.graphEntries.size > 0) this.graphEntries else this.roots
    if (candidates.size > 1) return ""
    if (candidates.size == 1) {
        val entry = bootstrapAnalysisGraphEntry(candidates[0])
        if (entry != "") return entry
    }
    var opened = ""
    for (document in this.overlays) {
        if (document.active) {
            if (opened != "") return ""
            opened = bootstrapAnalysisGraphPath(document.path)
        }
    }
    opened
}

fun bootstrapAnalysisGraphIncomplete(revision: int, message: string): Json =
    jsonObject(["revision", "documents", "analysisMode", "complete", "issues"],
        [jsonString("$revision"), jsonArray([]), jsonString("graph-v1"), jsonBoolean(false),
            jsonArray([jsonObject(["code", "message"],
                [jsonString("E_ANALYSIS_SCOPE"), jsonString(message)])])])

fun bootstrapAnalysisGraphDocumentIndex(
    documents: array<BootstrapAnalysisGraphDocument>, source: string
): int {
    var candidate = bootstrapGenericSourceFile(source)
    if (candidate.size >= 9 && candidate.slice(candidate.size - 9, candidate.size) == "#contract") {
        candidate = candidate.slice(0, candidate.size - 9)
    }
    for (index in 0 until documents.size) {
        if (documents[index].document.path == candidate) return index
    }
    -1
}

fun bootstrapAnalysisGraphDeclarationAliases(
    declaration: BootstrapDeclaration,
    documents: array<BootstrapAnalysisGraphDocument>,
    var aliases: Map<string, string>
): void {
    val index = bootstrapAnalysisGraphDocumentIndex(documents, declaration.sourceIdentity)
    if (index < 0) return
    val document = documents[index]
    val begin = document.rewrite.original(declaration.begin)
    val kind = bootstrapAnalysisSymbolKind(declaration.kind)
    var symbol = 0
    var matched = ""
    while (symbol < document.symbols.size()) {
        val found = document.symbols.at(symbol)
        if (found.get("range").getInt("start") == begin && found.getString("kind") == kind) {
            if (matched != "" && matched != found.getString("id")) return
            matched = found.getString("id")
        }
        symbol = symbol + 1
    }
    if (matched != "") {
        aliases.set(bootstrapAnalysisDeclarationId(declaration), matched)
        bootstrapAnalysisGraphScopeAliases(document, matched, declaration.sourceIdentity, aliases)
    }
    for (method in declaration.methods) {
        bootstrapAnalysisGraphDeclarationAliases(method, documents, aliases)
    }
    return
}

// Generic instances keep their compiler source identity. Bind only symbols
// owned by the matched original declaration, using the compiler's byte mapping.
fun bootstrapAnalysisGraphScopeAliases(
    document: BootstrapAnalysisGraphDocument, owner: string, source: string,
    var aliases: Map<string, string>
): void {
    val prefix = "abla:${document.document.path}:"
    for (symbol in document.symbols.values) {
        val id = symbol.getString("id")
        if (symbol.getString("containerId") == owner && id.size > prefix.size &&
            id.slice(0, prefix.size) == prefix) {
            var end = prefix.size
            var begin = 0
            while (end < id.size && id[end] >= 48 && id[end] <= 57) {
                begin = begin * 10 + id[end] - 48
                end = end + 1
            }
            val rewritten = document.rewrite.rewritten(begin)
            aliases.set("abla:$source:$rewritten${id.slice(end, id.size)}", id)
            if (symbol.getString("kind") == "property") {
                aliases.set("abla:$source:$rewritten:field:${symbol.getString("name")}", id)
            }
        }
    }
    return
}

// Compiler identities already carry the exact lexical owner. Translate their
// byte component, never resolve a declaration by spelling in another scope.
fun bootstrapAnalysisGraphLocalAliases(
    document: BootstrapAnalysisGraphDocument,
    var aliases: Map<string, string>
): void {
    val prefix = "abla:${document.document.path}:"
    var index = 0
    while (index < document.symbols.size()) {
        val symbol = document.symbols.at(index)
        val id = symbol.getString("id")
        aliases.set(id, id)
        if (id.size > prefix.size && id.slice(0, prefix.size) == prefix) {
            var end = prefix.size
            var begin = 0
            while (end < id.size && id[end] >= 48 && id[end] <= 57) {
                begin = begin * 10 + id[end] - 48
                end = end + 1
            }
            val rewritten = document.rewrite.rewritten(begin)
            val suffix = id.slice(end, id.size)
            aliases.set("$prefix$rewritten$suffix", id)
            aliases.set("abla:${document.document.path}#contract:$rewritten$suffix", id)
            if (symbol.getString("kind") == "property") {
                aliases.set("$prefix$rewritten:field:${symbol.getString("name")}", id)
                aliases.set("abla:${document.document.path}#contract:$rewritten:field:${symbol.getString("name")}", id)
            }
        }
        index = index + 1
    }
    return
}

fun bootstrapAnalysisGraphCallNames(
    expression: BootstrapExpression, source: string, var names: Map<string, string>
): void {
    if (expression.kind == "call" || expression.kind == "member.call") {
        names.set("$source:${expression.begin}:${expression.end}:${expression.kind}", expression.text)
    }
    for (child in expression.children) bootstrapAnalysisGraphCallNames(child, source, names)
    return
}

fun bootstrapAnalysisGraphDeclarationCallNames(
    declaration: BootstrapDeclaration, var names: Map<string, string>
): void {
    bootstrapAnalysisGraphCallNames(declaration.expression, declaration.sourceIdentity, names)
    for (value in declaration.parameterDefaults) bootstrapAnalysisGraphCallNames(value, declaration.sourceIdentity, names)
    for (method in declaration.methods) bootstrapAnalysisGraphDeclarationCallNames(method, names)
    return
}

fun bootstrapAnalysisGraphSemantic(
    semantic: BootstrapSemanticResult,
    documents: array<BootstrapAnalysisGraphDocument>,
    names: Map<string, string>
): BootstrapSemanticResult {
    val resolved: array<BootstrapResolvedName> = []
    for (name in semantic.resolvedNames) {
        val index = bootstrapAnalysisGraphDocumentIndex(documents, name.sourceIdentity)
        if (index >= 0) {
            val document = documents[index]
            val begin = document.rewrite.original(name.begin)
            val end = document.rewrite.originalEnd(name.end)
            if (begin >= 0 && end >= begin && end <= document.document.text.size) {
                resolved.append(BootstrapResolvedName(document.document.path, begin, end,
                    document.document.text.slice(begin, end), name.declarationIdentity, name.type, name.kind))
            }
        }
    }
    val calls: array<BootstrapTypedCall> = []
    for (call in semantic.typedCalls) {
        val index = bootstrapAnalysisGraphDocumentIndex(documents, call.sourceIdentity)
        if (index >= 0) {
            val document = documents[index]
            val begin = document.rewrite.original(call.begin)
            val end = document.rewrite.originalEnd(call.end)
            val name = names.get("${document.document.path}:$begin:$end:${call.kind}")
            if (name != null) calls.append(BootstrapTypedCall(
                document.document.path, begin, end, call.kind, name, call.type,
                call.receiverType, call.target, call.argumentTypes, call.parameterTypes,
                call.parameterKinds, call.argumentParameters, call.argumentConversions,
                call.insertedDefaults, call.isCompileOnly, call.isTrusted, call.isContract))
        }
    }
    BootstrapSemanticResult(semantic.symbols, semantic.errors, semantic.extensionErrors,
        bootstrapSourceRewriteDiagnostics(semantic.diagnostics), semantic.mutableReceivers,
        semantic.compileEffects, calls, resolved, semantic.managedAliasBegins,
        semantic.managedAliasEnds, semantic.managedAliasSources, semantic.managedAliasFiles)
}

fun bootstrapAnalysisGraphDiagnostics(
    document: BootstrapAnalysisGraphDocument, project: BootstrapFrontendProject,
    semanticDiagnostics: string
): Json {
    val values: array<BootstrapFrontendDiagnostic> = []
    for (kind in ["parser", "import", "strict-import", "qualified-import", "semantic"]) {
        val text = if (kind == "semantic") semanticDiagnostics else project.written.diagnostics
        bootstrapFrontendAppendLocatedDiagnostics(text,
            "source[$kind]:${document.document.path}:", document.document.path,
            document.document.text, values)
    }
    val exported: array<Json> = []
    for (value in values) {
        exported.append(jsonObject(["code", "message", "range"],
            [jsonString(value.code), jsonString(value.message),
                jsonObject(["start", "end"], [jsonInteger(value.begin), jsonInteger(value.end)])]))
    }
    jsonArray(exported)
}

// Workspace revisions include disk and configuration inputs, not only overlay
// message counts. Keep immutable strings, and compare exact contents rather
// than treating a hash collision as permission to validate stale edits.
fun BootstrapAnalysisService.graphObserveInputs(project: BootstrapFrontendProject, entry: string): void {
    val paths: array<string> = ["entry"]
    val values: array<string> = [entry]
    val observed: Map<string, bool> = Map()
    for (module in project.modules) {
        paths.append("source:${module.path}")
        values.append(bootstrapAnalysisGraphModules.acquire(module.path).source)
        val root = bootstrapModuleIdentityProjectRoot(module.path)
        for (name in ["abla.toml", "abla.lock"]) {
            val path = Path(root).child(name).text
            if (!observed.has(path)) {
                observed.set(path, true)
                paths.append("metadata:$path")
                values.append(Path(path).readText())
            }
        }
    }
    var changed = paths.size != this.graphInputPaths.size
    var index = 0
    while (!changed && index < paths.size) {
        changed = paths[index] != this.graphInputPaths[index] || values[index] != this.graphInputValues[index]
        index = index + 1
    }
    if (changed && this.graphInputPaths.size > 0) this.revision = this.revision + 1
    this.graphInputPaths.truncate(0)
    this.graphInputValues.truncate(0)
    for (index in 0 until paths.size) {
        this.graphInputPaths.append(paths[index])
        this.graphInputValues.append(values[index])
    }
    return
}

fun BootstrapAnalysisService.graphSnapshot(): Json {
    val entry = this.graphEntry()
    if (entry == "") return bootstrapAnalysisGraphIncomplete(this.revision,
        "select one project entry with entryPoints or analyze roots; no project entry was found")
    if (bootstrapAnalysisGraphActiveEntry != entry) {
        bootstrapAnalysisGraphActiveEntry = entry
        bootstrapAnalysisGraphModules = bootstrapModuleState()
    }
    bootstrapAnalysisGraphModules.overlays = []
    for (document in this.overlays) {
        if (document.active) bootstrapAnalysisGraphModules.overlays.append(BootstrapModuleOverlay(
            bootstrapAnalysisGraphPath(document.path), document.text, document.version))
    }
    if (!bootstrapAnalysisGraphModules.sourceExists(entry)) return bootstrapAnalysisGraphIncomplete(this.revision,
        "project entry does not exist and has no open overlay")
    bootstrapSourceRewrites = []
    val project = bootstrapFrontendLoadHostProject(entry, bootstrapAnalysisGraphModules)
    this.graphObserveInputs(project, entry)
    val documents: array<BootstrapAnalysisGraphDocument> = []
    val names: Map<string, string> = Map()
    for (module in project.modules) {
        if (module.source != "" || bootstrapAnalysisGraphModules.sourceExists(module.path)) {
            var uri = bootstrapAnalysisGraphUri(module.path)
            var version = 0
            for (overlay in this.overlays) {
                if (overlay.active && bootstrapAnalysisGraphPath(overlay.path) == bootstrapAbsoluteModulePath(module.path)) {
                    uri = overlay.uri
                    version = overlay.version
                }
            }
            val source = if (module.source != "") module.source else bootstrapAnalysisGraphModules.acquire(module.path).source
            val raw = bootstrapParseWithIdentity(source, module.path)
            val visible: array<BootstrapDeclaration> = []
            for (declaration in raw.declarations) {
                if (project.fullModules.has(module.path) || !declaration.isPrivate) visible.append(declaration)
            }
            val surface = BootstrapParseResult(visible, raw.actions, raw.errors, raw.extensionErrors,
                raw.compileInputPaths, raw.compileInputContents, raw.diagnostics)
            val parsed = if (project.fullModules.has(module.path)) surface
                else bootstrapProjectContract(surface, module.path)
            documents.append(BootstrapAnalysisGraphDocument(
                BootstrapAnalysisDocument(uri, module.path, version, source, true), parsed,
                bootstrapAnalysisSymbolsJson(source, uri, parsed), bootstrapSourceRewriteOf(module.path)))
            for (declaration in parsed.declarations) bootstrapAnalysisGraphDeclarationCallNames(declaration, names)
            for (action in parsed.actions) bootstrapAnalysisGraphCallNames(action, module.path, names)
        }
    }
    val begins: array<int> = []
    val ends: array<int> = []
    val kinds: array<string> = []
    val sources: array<string> = []
    for (declaration in project.written.declarations) {
        bootstrapAnalysisCollectDeclarationRequests(declaration, begins, ends, kinds, sources)
    }
    for (action in project.written.actions) {
        bootstrapAnalysisCollectTypedRequests(action, entry, begins, ends, kinds, sources)
    }
    val analyzed = bootstrapFrontendTypeProject(project, begins, ends, kinds, sources)
    val aliases: Map<string, string> = Map()
    for (document in documents) bootstrapAnalysisGraphLocalAliases(document, aliases)
    val values: array<Json> = []
    var semanticDiagnostics = ""
    if (analyzed != null) {
        for (declaration in analyzed.parsed.declarations) {
            bootstrapAnalysisGraphDeclarationAliases(declaration, documents, aliases)
        }
        val semantic = bootstrapAnalysisGraphSemantic(analyzed.semantic, documents, names)
        semanticDiagnostics = semantic.diagnostics
        for (document in documents) {
            values.append(jsonObject(["uri", "version", "text", "symbols", "occurrences", "diagnostics"],
                [jsonString(document.document.uri), jsonInteger(document.document.version),
                    jsonString(document.document.text), document.symbols,
                    bootstrapAnalysisOccurrencesJson(document.document.text, document.document.path,
                        document.parsed, analyzed.parsed.declarations, semantic, aliases, true),
                    bootstrapAnalysisGraphDiagnostics(document, project, semanticDiagnostics)]))
        }
    } else {
        for (document in documents) {
            values.append(jsonObject(["uri", "version", "text", "symbols", "occurrences", "diagnostics"],
                [jsonString(document.document.uri), jsonInteger(document.document.version),
                    jsonString(document.document.text), document.symbols, jsonArray([]),
                    bootstrapAnalysisGraphDiagnostics(document, project, "")]))
        }
    }
    val pending: array<Json> = []
    for (index in 0 until project.blocked.size) {
        val site = project.blocked[index]
        pending.append(jsonObject(["code", "uri", "range", "message"],
            [jsonString("E_ANALYSIS_CT_REQUIRED"), jsonString(bootstrapAnalysisGraphUri(project.blockedSources[index])),
                jsonObject(["start", "end"], [jsonInteger(site.begin), jsonInteger(site.end)]),
                jsonString("compile-time evaluation was not performed; types describe the pre-evaluation source")]))
    }
    return jsonObject(["revision", "documents", "analysisMode", "complete", "pending", "entry"],
        [jsonString("${this.revision}"), jsonArray(values), jsonString("graph-v1"),
            jsonBoolean(analyzed != null && pending.size == 0), jsonArray(pending), jsonString(entry)])
}
